func _run_market_test() -> void:
	var cinder := SystemDB.port_def_by_id("cinderworks")
	var bastion := SystemDB.port_def_by_id("bastion")
	var anchor := SystemDB.port_def_by_id("anchor")

	print("[market] --- baseline unit prices (base | anchor | cinderworks | bastion) ---")
	for good_v in CommodityDB.ids():
		var g := str(good_v)
		print("[market] %-10s base %4d | anchor %5.0f | cinder %5.0f | bastion %5.0f" % [
			CommodityDB.short_name(g), CommodityDB.base_price(g),
			Market.unit_price(anchor, "anchor", g),
			Market.unit_price(cinder, "cinderworks", g),
			Market.unit_price(bastion, "bastion", g)])

	# 1. The alloys route should pay: buy where they are mined, sell where they
	#    are wanted.
	var buy_at_cinder := Market.buy_price(cinder, "cinderworks", "alloys")
	var sell_at_bastion := Market.sell_price(bastion, "bastion", "alloys")
	var margin := sell_at_bastion - buy_at_cinder
	print("[market] ROUTE alloys cinder->bastion: buy %d sell %d margin %d/unit (%.0f%%)" % [
		buy_at_cinder, sell_at_bastion, margin,
		100.0 * float(margin) / maxf(float(buy_at_cinder), 1.0)])

	var buy_iso := Market.buy_price(bastion, "bastion", "isotopes")
	var sell_iso := Market.sell_price(cinder, "cinderworks", "isotopes")
	print("[market] ROUTE isotopes bastion->cinder: buy %d sell %d margin %d/unit (%.0f%%)" % [
		buy_iso, sell_iso, sell_iso - buy_iso,
		100.0 * float(sell_iso - buy_iso) / maxf(float(buy_iso), 1.0)])

	# This harness printed five true things and asserted none of them for
	# twenty-two versions, which meant the whole price engine was policed only
	# indirectly, by STATIONTEST's guard rails and PACINGTEST's band. Both of
	# those check that the economy is not BROKEN; none of them checked that it
	# still WORKS. The two authored routes are the thing the bias tables exist
	# to create -- if either stops paying, the trade verb is dead and every
	# printed line above would have gone on looking perfectly reasonable.
	print("[market] THE AUTHORED ROUTES PAY alloys %+d/unit, isotopes %+d/unit -> %s" % [
		margin, sell_iso - buy_iso,
		"PASS" if margin > 0 and sell_iso - buy_iso > 0 else "FAIL"])

	# 2. Player pressure: dumping into a market must visibly move it and then
	#    recover, rather than being either ignored or permanent.
	var before := Market.sell_price(bastion, "bastion", "alloys")
	Market.apply_trade_pressure("bastion", "alloys", 40, true)
	var after := Market.sell_price(bastion, "bastion", "alloys")
	print("[market] PRESSURE dumped 40 alloys: %d -> %d (%.0f%% drop, expect >=15%%)" % [
		before, after, 100.0 * (1.0 - float(after) / maxf(float(before), 1.0))])
	for i in range(12):
		Market.recover_pressure(60.0)
	var recovered := Market.sell_price(bastion, "bastion", "alloys")
	print("[market] PRESSURE after 12 min recovery: %d (expect ~%d)" % [recovered, before])
	# BOTH HALVES, because either alone passes on broken code: a dent that never
	# healed and a dent that never happened both satisfy one of them. Recovery is
	# geometric (10% of the remaining gap per minute), so twelve minutes closes
	# ~72% of it and NOT all of it -- asserting "recovered == before" would be
	# asserting a bug. What must be true is that it moved back most of the way
	# and never overshot its own baseline.
	var dent := float(before - after)
	var healed := float(recovered - after)
	print("[market] PRESSURE MOVES AND HEALS dent %.0f (%.0f%% of price, need >=15%%), healed %.0f of it (%.0f%%, need >=50%%), never past baseline=%s -> %s" % [
		dent, 100.0 * dent / maxf(float(before), 1.0), healed,
		100.0 * healed / maxf(dent, 1.0), str(recovered <= before),
		"PASS" if dent >= 0.15 * float(before) and healed >= 0.5 * dent
			and recovered <= before else "FAIL"])

	# 3. Events apply and expire.
	GameState.market_events.append({
		"kind": "shortage", "port": "cinderworks", "good": "isotopes",
		"mult": 2.0, "remaining": 5.0})
	print("[market] EVENT shortage active: isotopes sell at cinder = %d (was %d)" % [
		Market.sell_price(cinder, "cinderworks", "isotopes"), sell_iso])
	var iso_under := Market.sell_price(cinder, "cinderworks", "isotopes")
	Market.tick_events(6.0)
	var iso_after := Market.sell_price(cinder, "cinderworks", "isotopes")
	print("[market] EVENT after expiry: %d, active_events=%d" % [
		iso_after, GameState.market_events.size()])
	# An event that never lapsed would be a permanent re-pricing of the world,
	# and an event that never applied would be a toast about nothing. The clock
	# has not moved between the two readings, so the price must return EXACTLY.
	print("[market] AN EVENT APPLIES AND LAPSES %d -> %d under a 2.0x shortage -> %d on expiry (was %d), none left=%s -> %s" % [
		sell_iso, iso_under, iso_after, sell_iso,
		str(GameState.market_events.is_empty()),
		"PASS" if iso_under > sell_iso and iso_after == sell_iso
			and GameState.market_events.is_empty() else "FAIL"])

	# 4. Cargo capacity and the hold-full path.
	GameState.cargo = {}
	var cap := GameState.cargo_capacity()
	var took := GameState.load_cargo("alloys", 99)
	print("[market] CARGO capacity %d, loaded %d alloys (2 space each), used %d free %d" % [
		cap, took, GameState.cargo_used(), GameState.cargo_free()])
	var overflow := GameState.load_cargo("relics", 1)
	print("[market] CARGO overflow load returned %d (expect 0 -> crate would scrap)" % overflow)
	print("[market] THE HOLD IS A WALL capacity %d, used %d, overflow load took %d -> %s" % [
		cap, GameState.cargo_used(), overflow,
		"PASS" if overflow == 0 and GameState.cargo_used() <= cap else "FAIL"])

	# 5. Drift moves prices over played time without touching wall clock.
	var t0 := Market.unit_price(cinder, "cinderworks", "volatiles")
	GameState.played_seconds += 240.0
	var t1 := Market.unit_price(cinder, "cinderworks", "volatiles")
	print("[market] DRIFT volatiles at cinder: %.1f -> %.1f after 4 played minutes" % [t0, t1])
	# The clock is PLAYED time, never wall clock, so a save reloads onto the same
	# curve -- and drift that did not move would make every price in the game a
	# constant with extra steps.
	print("[market] DRIFT IS A CLOCK 4 played minutes moved volatiles %.1f -> %.1f -> %s" % [
		t0, t1, "PASS" if not is_equal_approx(t0, t1) else "FAIL"])
	get_tree().quit()


# --- stock harness ----------------------------------------------------------

func _run_stock_test() -> void:
	# v27. THE SHELF. Everything here is pure state work on Market + GameState --
	# no world, no ports built, no frames -- so it needs no PLAYING boot.
	#
	# smuggling is pinned to 0 first: SMUGGLING_ACCESS_TIER makes every deep fence
	# take everything, which sends can_buy false and every deep cap to 0. That is
	# correct behaviour and NOT what these legs are measuring, so the confound is
	# removed rather than worked around.
	GameState.market_stock = {}
	GameState.market_events = []
	GameState.smuggling = 0
	GameState.played_seconds = 1000.0

	var cinder := SystemDB.port_def_by_id("cinderworks")
	var cap := Market.stock_cap(cinder, "alloys")

	# 1. A SHELF IS FINITE. Cinderworks smelts alloys (bias 0.68), so it stands
	#    them deep -- and taking them off it moves the number, one for one.
	var left0 := Market.stock_left(cinder, "cinderworks", "alloys")
	Market.note_bought("cinderworks", "alloys", 10)
	var left1 := Market.stock_left(cinder, "cinderworks", "alloys")
	Market.note_bought("cinderworks", "alloys", 1000)
	var left2 := Market.stock_left(cinder, "cinderworks", "alloys")
	print("[stock] A SHELF IS FINITE cinderworks stands %d alloys, %d before, %d after taking 10, %d after taking it out -> %s" % [
		cap, left0, left1, left2,
		"PASS" if cap > 0 and left0 == cap and left1 == cap - 10 and left2 == 0
			else "FAIL"])

	# 2. ONLY THE PLAYER EMPTIES A SHELF (§51, and the whole reason this store is
	#    a deficit rather than an inventory). Half an hour of played time passes
	#    with nobody trading: no counter anywhere may lose a unit, and the store
	#    must not gain a single entry. A simulation would fail this line, which is
	#    exactly what makes it worth having.
	GameState.market_stock = {}
	var rest_before := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.played_seconds += 1800.0
	var rest_after := Market.stock_left(cinder, "cinderworks", "alloys")
	print("[stock] ONLY THE PLAYER EMPTIES A SHELF 30 played minutes with no trade: %d -> %d, store holds %d entries -> %s" % [
		rest_before, rest_after, GameState.market_stock.size(),
		"PASS" if rest_before == cap and rest_after == cap
			and GameState.market_stock.is_empty() else "FAIL"])

	# 3. THE SHELF REFILLS AND STOPS. One unit per STOCK_REPLENISH_SECONDS, and
	#    it stops dead at the cap -- a counter that kept counting upward would be
	#    a warehouse with a price on it.
	GameState.market_stock = {}
	Market.note_bought("cinderworks", "alloys", cap)
	var empty := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.played_seconds += 5.0 * Market.STOCK_REPLENISH_SECONDS
	var part := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.played_seconds += 100000.0
	var full := Market.stock_left(cinder, "cinderworks", "alloys")
	print("[stock] THE SHELF REFILLS AND STOPS emptied %d, five periods later %d, a long time later %d (cap %d) -> %s" % [
		empty, part, full, cap,
		"PASS" if empty == 0 and part == 5 and full == cap else "FAIL"])

	# 4. AT REST THE LEDGER IS EMPTY. Both halves: the entry really is still
	#    sitting there after it replenished (so the sweep is not asserting
	#    nothing), and the sweep really does clear it.
	var lingered := GameState.market_stock.size()
	Market.recover_stock()
	print("[stock] AT REST THE LEDGER IS EMPTY %d replenished entr(y/ies) lingered, %d after the sweep -> %s" % [
		lingered, GameState.market_stock.size(),
		"PASS" if lingered == 1 and GameState.market_stock.is_empty() else "FAIL"])

	# 5. A SHORTAGE BARES THE SHELF, A GLUT FLOODS IT -- as a MASK. The last two
	#    readings are the ones that matter: a deficit taken before an event must
	#    still be there when the event lapses, or an event would be a way to
	#    launder a shelf you emptied.
	GameState.market_stock = {}
	GameState.market_events = [{"kind": "shortage", "port": "cinderworks",
		"good": "alloys", "mult": 2.0, "remaining": 100.0}]
	var bare := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.market_events = [{"kind": "glut", "port": "cinderworks",
		"good": "alloys", "mult": 0.55, "remaining": 100.0}]
	var flooded := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.market_events = []
	Market.note_bought("cinderworks", "alloys", 10)
	GameState.market_events = [{"kind": "shortage", "port": "cinderworks",
		"good": "alloys", "mult": 2.0, "remaining": 100.0}]
	var bare2 := Market.stock_left(cinder, "cinderworks", "alloys")
	GameState.market_events = []
	var re_emerged := Market.stock_left(cinder, "cinderworks", "alloys")
	print("[stock] A SHORTAGE BARES THE SHELF, A GLUT FLOODS IT shortage %d, glut %d (cap %d), and a 10-unit hole taken first survives the event: %d during, %d after -> %s" % [
		bare, flooded, cap, bare2, re_emerged,
		"PASS" if bare == 0 and flooded == cap * Market.STOCK_GLUT_MULT
			and bare2 == 0 and re_emerged == cap - 10 else "FAIL"])

	# 6. NO WORMHOLE FOR SHELVES. The bonded bay's rule, re-asserted for stock:
	#    port_id out past the chart is the ARCHETYPE, shared by every station of
	#    that kind everywhere, so the shelf keys on the cell. Two cells with the
	#    same coordinates in different systems is the exact collision that caught
	#    the warehouse.
	GameState.market_stock = {}
	var relay := DeepPortDB.by_id("deep_relay")
	var k1 := DeepSpace.cell_key("pyx01", 7, -3)
	var k2 := DeepSpace.cell_key("pyx02", 7, -3)
	var cap_r := Market.stock_cap(relay, "isotopes")
	Market.note_bought(k1, "isotopes", cap_r)
	var here := Market.stock_left(relay, k1, "isotopes")
	var there := Market.stock_left(relay, k2, "isotopes")
	print("[stock] NO WORMHOLE FOR SHELVES bought out %s (%d left); %s still stands %d of %d -> %s" % [
		k1, here, k2, there, cap_r,
		"PASS" if cap_r > 0 and here == 0 and there == cap_r else "FAIL"])

	# 7. A CONSUMER SELLS NOTHING, and A PRODUCER STANDS IT DEEP -- swept over the
	#    REAL defs, charted and deep, so this measures the shipped bias tables
	#    rather than a fixture. Both directions are counted and both must be
	#    non-zero: a sweep that found no consumers would be asserting nothing, and
	#    it is the pair that proves the assortment varies at all.
	GameState.market_stock = {}
	var defs := []
	for pid_v in SystemDB.port_ids():
		defs.append(SystemDB.port_def_by_id(String(pid_v)))
	for aid_v in DeepPortDB.ids():
		defs.append(DeepPortDB.by_id(String(aid_v)))
	var consumers := 0
	var producers := 0
	var wrong := ""
	for d_v in defs:
		var d: Dictionary = d_v
		for g_v in CommodityDB.ids():
			var g := String(g_v)
			if not Market.can_buy(d, g):
				continue
			# Mirror stock_cap's own second gate: a good this desk does not carry
			# has no shelf, and counting it here would report every restricted
			# good as a broken producer row.
			if not CommodityDB.trades_at(g, String(d.get("id", ""))):
				continue
			var bias := Market.port_bias(d, g)
			var c := Market.stock_cap(d, g)
			if bias >= Market.STOCK_NONE_BIAS:
				consumers += 1
				if c != 0:
					wrong = "%s stands %d %s at bias %.2f" % [
						String(d.get("id", "?")), c, g, bias]
			elif bias <= Market.STOCK_DEEP_BIAS:
				producers += 1
				var want := int(round(float(Market.STOCK_BASE_ORE if CommodityDB.is_ore(g)
					else Market.STOCK_BASE) * Market.STOCK_DEEP_MULT))
				if c != want:
					wrong = "%s stands %d %s at bias %.2f, wanted %d" % [
						String(d.get("id", "?")), c, g, bias, want]
	print("[stock] A CONSUMER SELLS NOTHING %d consumer rows stand nothing, %d producer rows stand double, offender=%s -> %s" % [
		consumers, producers, wrong if wrong != "" else "none",
		"PASS" if consumers > 0 and producers > 0 and wrong == "" else "FAIL"])

	# 8. THE RESERVE IS A GATE (§108). A desk that knows you keeps more back --
	#    and charges the same for it, to the credit. Measured against its OWN
	#    hostile reading rather than against a baseline band, so the leg does not
	#    quietly depend on what the starter attitude happens to be.
	GameState.market_stock = {}
	GameState.market_events = []
	_clear_faction_matrix()
	var cinder_owner := Market.owner_of(cinder)
	GameState.shift_faction(FactionDB.SURVEYOR, cinder_owner, 12)
	var friend_band := GameState.faction_band(FactionDB.SURVEYOR, cinder_owner)
	var friend_cap := Market.stock_cap(cinder, "alloys")
	var friend_buy := Market.buy_price(cinder, "cinderworks", "alloys", 1, "cinderworks")
	var friend_sell := Market.sell_price(cinder, "cinderworks", "alloys", 1, "cinderworks")
	GameState.shift_faction(FactionDB.SURVEYOR, cinder_owner, -24)
	var hostile_band := GameState.faction_band(FactionDB.SURVEYOR, cinder_owner)
	var hostile_cap := Market.stock_cap(cinder, "alloys")
	var hostile_buy := Market.buy_price(cinder, "cinderworks", "alloys", 1, "cinderworks")
	var hostile_sell := Market.sell_price(cinder, "cinderworks", "alloys", 1, "cinderworks")
	_clear_faction_matrix()
	# THE DIRECTION IS THE ASSERTION. x1.5 at FRIENDLY, never x0.67 unless: the
	# hostile reading must equal the number the shelf had before this feature
	# existed, which is what keeps fence_open's "no counter ever closes" true.
	var reserve_ok: bool = friend_cap == int(round(float(hostile_cap) * Market.STOCK_RESERVE_MULT)) \
		and friend_cap > hostile_cap \
		and friend_buy == hostile_buy and friend_sell == hostile_sell
	print("[stock] THE RESERVE IS A GATE %s stands %d at band %d and %d at band %d (x%.2f), and charges %d/%d either way -> %s" % [
		cinder_owner, friend_cap, friend_band, hostile_cap, hostile_band,
		Market.STOCK_RESERVE_MULT, friend_buy, friend_sell,
		"PASS" if reserve_ok else "FAIL"])

	# 9. NO WORMHOLE FOR EVENTS. The shelf keys on the cell and so must the
	#    weather over it, or a shortage at one Shoal Relay bares the shelf of
	#    every Relay in the game. Same two cells as leg 6, same collision.
	GameState.market_stock = {}
	GameState.market_events = [{"kind": "shortage", "port": k1, "good": "isotopes",
		"name": "SHOAL RELAY", "deep": true, "mult": 2.0, "remaining": 100.0}]
	var struck := Market.stock_left(relay, k1, "isotopes")
	var spared := Market.stock_left(relay, k2, "isotopes")
	GameState.market_events = []
	print("[stock] NO WORMHOLE FOR EVENTS a shortage over %s leaves it %d; %s is untouched at %d of %d -> %s" % [
		k1, struck, k2, spared, cap_r,
		"PASS" if struck == 0 and spared == cap_r else "FAIL"])

	# 10. A DEEP COUNTER HAS ITS OWN WEATHER. Three properties of the roll, and
	#     the second is the one that matters: the good is drawn from the
	#     archetype's OWN bias table, which is how a 2.2x shortage on a component
	#     at a 1.45x deep fence is kept out of the game by construction.
	GameState.market_events = []
	var synth := [{"key": k1, "id": "deep_relay", "name": "SHOAL RELAY", "def": relay}]
	var relay_bias: Array = (relay.get("bias", {}) as Dictionary).keys()
	var off_table := ""
	var over_budget := false
	for i in range(200):
		Market.try_spawn_deep_event(synth)
		if Market.deep_event_count() > Market.EVENT_MAX_DEEP:
			over_budget = true
		for e_v in GameState.market_events:
			var e: Dictionary = e_v
			if not relay_bias.has(String(e.get("good", ""))):
				off_table = String(e.get("good", ""))
		GameState.market_events = []
	var no_counters: bool = Market.try_spawn_deep_event([]).is_empty()
	GameState.market_events = []
	print("[stock] A DEEP COUNTER HAS ITS OWN WEATHER 200 rolls: budget %d never exceeded=%s, every good drawn from the archetype's own %d-row bias table (stray=%s), and no counters means no weather=%s -> %s" % [
		Market.EVENT_MAX_DEEP, str(not over_budget), relay_bias.size(),
		off_table if off_table != "" else "none", str(no_counters),
		"PASS" if not over_budget and off_table == "" and no_counters else "FAIL"])

	# 11. THE DESK NAMES A REAL PLACE. Every reader of an event used to resolve
	#     its port through SystemDB and print a literal "?" for anything the
	#     chart does not carry. Four shapes, including the v27 save written
	#     before §108 that has no name at all.
	var name_deep := Market.event_place({"port": k1, "name": "SHOAL RELAY", "deep": true})
	var name_chart := Market.event_place({"port": "cinderworks", "name": "CINDERWORKS"})
	var name_legacy := Market.event_place({"port": "cinderworks", "name": ""})
	var name_orphan := Market.event_place({"port": k2, "name": ""})
	print("[stock] THE DESK NAMES A REAL PLACE deep='%s', charted='%s', a nameless v27 event resolves to '%s', and an orphaned cell says '%s' rather than ? -> %s" % [
		name_deep, name_chart, name_legacy, name_orphan,
		"PASS" if name_deep == "SHOAL RELAY" and name_chart == "CINDERWORKS"
			and name_legacy != "" and name_legacy != "?"
			and name_orphan != "" and name_orphan != "?" else "FAIL"])

	# 12. A ROUTE THE PLAYER CAN ACTUALLY BUY. The old scan checked trades_at on
	#     both legs and nothing else, so it would sell you the word that a good
	#     moves out of a yard which has never retailed one. Both halves: the
	#     route it names must be fillable, and emptying that shelf must make it
	#     stop naming it.
	GameState.market_stock = {}
	GameState.market_events = []
	var route := Market.best_stocked_route()
	var route_ok: bool = not route.is_empty() \
		and Market.stock_left(SystemDB.port_def_by_id(String(route["a"])),
			String(route["a"]), String(route["good"])) > 0
	var named_a := String(route.get("a", "?"))
	var named_good := String(route.get("good", "?"))
	Market.note_bought(named_a, named_good, 9999)
	var moved_on := Market.best_stocked_route()
	var re_routed: bool = moved_on.is_empty() \
		or String(moved_on.get("a", "")) != named_a \
		or String(moved_on.get("good", "")) != named_good
	GameState.market_stock = {}
	print("[stock] A ROUTE THE PLAYER CAN ACTUALLY BUY best fillable run is %s out of %s (%d units standing); emptying that shelf moves the word=%s -> %s" % [
		named_good, named_a, int(route.get("units", 0)), str(re_routed),
		"PASS" if route_ok and re_routed else "FAIL"])

	# 13. THE COUNTER THAT RAN SHORT. The desk's new rung, as a rule rather than
	#     as a sentence. It must say nothing about a full shelf, name the one the
	#     player emptied, and quote a restock clock that shrinks as time passes.
	GameState.market_stock = {}
	var quiet: bool = Market.bare_shelf_report().is_empty()
	Market.note_bought("cinderworks", "alloys", cap)
	var short_now := Market.bare_shelf_report()
	var clock_now := float(short_now.get("seconds", 0.0))
	GameState.played_seconds += 10.0 * Market.STOCK_REPLENISH_SECONDS
	var clock_later := float(Market.bare_shelf_report().get("seconds", 0.0))
	GameState.market_stock = {}
	print("[stock] THE COUNTER THAT RAN SHORT a full chart says nothing=%s; emptied, it names %s at %s with %.0fs to fill, %.0fs ten periods later -> %s" % [
		str(quiet), String(short_now.get("good", "?")),
		String(short_now.get("name", "?")), clock_now, clock_later,
		"PASS" if quiet and String(short_now.get("port", "")) == "cinderworks"
			and String(short_now.get("good", "")) == "alloys"
			and clock_now > 0.0 and clock_later < clock_now else "FAIL"])

	GameState.market_stock = {}
	GameState.market_events = []
	_clear_faction_matrix()
	get_tree().quit()


# --- skill harness ----------------------------------------------------------

func _skill_snapshot() -> Dictionary:
	var out := {"archeology": GameState.archeology_xp,
		"smuggling": GameState.smuggling_xp, "mining": GameState.mining_xp,
		"persuasion": GameState.persuasion_xp}
	for id_v in GameState.skill_ids():
		out[String(id_v)] = GameState.skill_xp(String(id_v))
	return out


func _skill_moved(before: Dictionary) -> Array:
	var moved := []
	var now := _skill_snapshot()
	for k in now:
		if int(now[k]) != int(before.get(k, 0)):
			moved.append(String(k))
	return moved


func _run_skill_test() -> void:
	# §111. Pure state work on GameState plus two nodes built off-tree, so this
	# needs no PLAYING boot and no world.
	GameState.skills = {}
	GameState.archeology_xp = 0
	GameState.smuggling_xp = 0
	GameState.mining_xp = 0
	GameState.persuasion_xp = 0
	GameState.archeology = 0
	GameState.smuggling = 0
	GameState.mining = 0
	GameState.persuasion = 0
	GameState.salvage = 10000

	# 1. FEEDS COMPETE, SIX WAYS. Every ladder in the game, snapshotted; one feed
	#    fired; exactly one may have moved. This is the runtime half of §19's
	#    rule -- it catches a mutator that pays two ladders, or a shared helper
	#    that fans out. It does NOT prove the VERBS are disjoint (that is a fact
	#    about where the calls live, checked by reading them: breach, read,
	#    fence-sale, seam-cut, parley, mast, filing -- seven acts, no overlap).
	var feeds := ["archeology", "smuggling", "mining", "persuasion",
		"surveying", "filing", "hunting", "rift_work", "brokerage",
		"colonial", "wardenry"]
	var crossed := ""
	for f in feeds:
		var before := _skill_snapshot()
		match f:
			"archeology": GameState.mark_archeology(1)
			"smuggling": GameState.mark_smuggling(1)
			"mining": GameState.mark_mining(1)
			"persuasion": GameState.mark_persuasion(1)
			_: GameState.mark_skill(f, 1)
		var moved := _skill_moved(before)
		if moved.size() != 1 or String(moved[0]) != f:
			crossed = "%s moved %s" % [f, str(moved)]
	print("[skill] FEEDS COMPETE, ELEVEN WAYS one feed fired at a time across %d ladders, first crossover: %s -> %s" % [
		feeds.size(), crossed if crossed != "" else "none",
		"PASS" if crossed == "" and feeds.size() == 11 else "FAIL"])

	# 2. NO LADDER PAYS IN CREDITS. §19/§26's first law, and the one that keeps
	#    every ladder clear of PACINGTEST's band. Swept across a full climb of
	#    each new skill from zero to cap, tier landings included -- a tier that
	#    paid on arrival would slip past a single-call check.
	GameState.skills = {}
	var purse := GameState.salvage
	var paid := ""
	for id_pv in GameState.skill_ids():
		var sid_p := String(id_pv)
		for i in range(80):
			GameState.mark_skill(sid_p, 1)
			if GameState.salvage != purse and paid == "":
				paid = "%s at xp %d" % [sid_p, GameState.skill_xp(sid_p)]
	print("[skill] NO LADDER PAYS IN CREDITS %d salvage before a full climb of every ladder, %d after, first payer: %s -> %s" % [
		purse, GameState.salvage, paid if paid != "" else "none",
		"PASS" if paid == "" and GameState.salvage == purse else "FAIL"])

	# 2b. THE ELEVENTH IS DERIVED FROM BOTH FAMILIES (§119). The count has to
	#     span the four legacy vars and the seven table rows, and it has to be
	#     asked of the TABLES -- the four legacy deepenings (5c) are still
	#     deferred and each adds a rung, so a bar written as a number here would
	#     silently move the day one lands. Driven from empty to full: nothing at
	#     cap, then the seven, then all eleven.
	GameState.skills = {}
	GameState.archeology = 0
	GameState.smuggling = 0
	GameState.mining = 0
	GameState.persuasion = 0
	var total_l := GameState.ladders_total()
	var none_capped := GameState.ladders_at_cap() == 0 \
		and not GameState.every_ladder_capped()
	for id_cv in GameState.skill_ids():
		var sid_c := String(id_cv)
		GameState.skills[sid_c] = 999999
	var seven_only: bool = GameState.ladders_at_cap() == GameState.SKILL_TIERS.size() \
		and not GameState.every_ladder_capped()
	GameState.archeology = GameState.ARCHEOLOGY_TIERS.size() - 1
	GameState.smuggling = GameState.SMUGGLING_TIERS.size() - 1
	GameState.mining = GameState.MINING_TIERS.size() - 1
	GameState.persuasion = GameState.PERSUASION_TIERS.size() - 1
	var all_capped: bool = GameState.ladders_at_cap() == total_l \
		and GameState.every_ladder_capped()
	# AND THE BAR IS THE TABLES' OWN. Adding a rung to a legacy array must move
	# the bar rather than leave a capped ladder capped -- which is exactly what
	# 5c will do, and this is the clause that proves it will be noticed.
	var deeper: bool = GameState.persuasion < GameState.PERSUASION_TIERS.size()
	print("[skill] THE ELEVENTH COUNTS BOTH FAMILIES %d ladders (%d legacy + %d table); none capped=%s, seven capped is not eleven=%s, all eleven=%s, the bar reads the array not a number=%s -> %s" % [
		total_l, GameState.LEGACY_TIER_ARRAYS.size(), GameState.SKILL_TIERS.size(),
		str(none_capped), str(seven_only), str(all_capped), str(deeper),
		"PASS" if none_capped and seven_only and all_capped and deeper
			and total_l == 11 else "FAIL"])

	# 2c. AND IT PAYS NOTHING. The capstone arrives at the exact moment
	#     NO LADDER PAYS IN CREDITS is standing on, so it is measured there:
	#     the wallet, the ledger and the log across the signal itself.
	GameState.skills = {}
	GameState.archeology = 0
	GameState.smuggling = 0
	GameState.mining = 0
	GameState.persuasion = 0
	var purse_c := GameState.salvage
	var ledger_c := GameState.ledger.duplicate(true)
	# AN ARRAY, NOT AN INT, and that is required rather than stylistic: GDScript
	# lambdas capture by VALUE, so `var n := 0` followed by `n += 1` inside the
	# closure increments a copy and the outer number never moves. PLOTTEST's
	# legend_layout carries this exact defect in its own comment -- a cursor
	# advanced inside a lambda, where nothing in a diff or an assertion could
	# see it. An Array is a reference, so append() reaches the real one.
	var fired: Array = []
	var once := func() -> void: fired.append(1)
	GameState.last_rung_reached.connect(once)
	GameState._last_rung_announced = false
	for id_ev in GameState.skill_ids():
		GameState.skills[String(id_ev)] = 999999
	GameState.archeology = GameState.ARCHEOLOGY_TIERS.size() - 1
	GameState.smuggling = GameState.SMUGGLING_TIERS.size() - 1
	GameState.mining = GameState.MINING_TIERS.size() - 1
	# The LAST one lands through a real mutator, so the signal is driven by the
	# path the game actually takes rather than by calling the helper by hand.
	GameState.persuasion = GameState.PERSUASION_TIERS.size() - 2
	# int() around the lookup, not decoration: PERSUASION_TIERS is an untyped
	# const so the element is a Variant, and this feeds a typed int member.
	# Checker rule 6 is about `:=` inference and does not reach an assignment,
	# so this one is on the author -- which is the whole reason --parse exists.
	GameState.persuasion_xp = int(GameState.PERSUASION_TIERS[
		GameState.PERSUASION_TIERS.size() - 1]) - 1
	GameState.mark_persuasion(1)
	# And a second landing must not speak again.
	GameState.mark_skill("filing", 1)
	GameState.last_rung_reached.disconnect(once)
	var wallet_still := GameState.salvage == purse_c
	var ledger_still := str(ledger_c) == str(GameState.ledger)
	print("[skill] THE ELEVENTH PAYS NOTHING signal fired %d time(s) through a real mutator, wallet %d->%d=%s, ledger byte-identical=%s -> %s" % [
		fired.size(), purse_c, GameState.salvage, str(wallet_still),
		str(ledger_still),
		"PASS" if fired.size() == 1 and wallet_still and ledger_still else "FAIL"])

	# 3. THE TIER IS DERIVED, NEVER STORED. The legacy four keep a tier var
	#    beside an xp var and a loader that clamps one against the other; these
	#    keep one number. Written straight into the xp, read back as a tier.
	GameState.skills = {}
	var derive_bad := ""
	for id_dv in GameState.skill_ids():
		var sid_d := String(id_dv)
		var rungs: Array = GameState.SKILL_TIERS[sid_d]
		for want in range(rungs.size()):
			GameState.skills[sid_d] = int(rungs[want])
			if GameState.skill_tier(sid_d) != want and derive_bad == "":
				derive_bad = "%s at %d xp read tier %d, wanted %d" % [
					sid_d, int(rungs[want]), GameState.skill_tier(sid_d), want]
		# And past the last rung it pins at the cap rather than running off.
		GameState.skills[sid_d] = 999999
		if GameState.skill_tier(sid_d) != GameState.skill_cap(sid_d) and derive_bad == "":
			derive_bad = "%s ran past its cap" % sid_d
	print("[skill] THE TIER IS DERIVED, NEVER STORED every rung of every ladder written as xp and read back, first mismatch: %s -> %s" % [
		derive_bad if derive_bad != "" else "none",
		"PASS" if derive_bad == "" else "FAIL"])

	# 4. A TIER IS A GATE. The rule functions, not the rendering (§19): each
	#    grant is measured at tier 0 and at cap, off-tree so no world is needed.
	var mast := SurveyMast.new()
	var mark := SoundingMark.new()
	GameState.skills = {}
	var hold0 := mast.survey_seconds()
	var reach0 := mast.reach()
	var read0 := mark.read_seconds()
	var near0 := mark.read_range()
	var at_zero := [GameState.hunting_error_mult(), GameState.rift_read_mult(),
		GameState.rift_warn_seconds(), GameState.colonial_name_mult(),
		GameState.wardenry_breach_mult()]
	GameState.skills = {"surveying": 999, "filing": 999, "hunting": 999,
		"rift_work": 999, "brokerage": 999, "colonial": 999, "wardenry": 999}
	var hold1 := mast.survey_seconds()
	var reach1 := mast.reach()
	var read1 := mark.read_seconds()
	var near1 := mark.read_range()
	var at_cap := [GameState.hunting_error_mult(), GameState.rift_read_mult(),
		GameState.rift_warn_seconds(), GameState.colonial_name_mult(),
		GameState.wardenry_breach_mult()]
	mast.free()
	mark.free()
	# Every 5b helper must MOVE across the climb, in the direction its grant
	# claims: error down, reach up, warning up, sight up, rate up. A helper
	# that reads the same at zero and at cap is a tier granting nothing.
	var helpers_ok: bool = float(at_cap[0]) < float(at_zero[0]) \
		and float(at_cap[1]) > float(at_zero[1]) \
		and float(at_cap[2]) > float(at_zero[2]) \
		and float(at_cap[3]) > float(at_zero[3]) \
		and float(at_cap[4]) > float(at_zero[4])
	var gates_ok: bool = hold1 < hold0 and reach1 > reach0 \
		and read1 < read0 and near1 > near0 and helpers_ok
	print("[skill] A TIER IS A GATE mast hold %.2fs->%.2fs, reach %.1f->%.1f; plate read %.2fs->%.2fs, alongside %.1f->%.1f; the five 5b helpers all move (error %.2f->%.2f, shear reach %.1fx->%.1fx, warn %.0fs->%.0fs, sight %.1fx->%.1fx, breach %.2fx->%.2fx) -> %s" % [
		hold0, hold1, reach0, reach1, read0, read1, near0, near1,
		float(at_zero[0]), float(at_cap[0]), float(at_zero[1]), float(at_cap[1]),
		float(at_zero[2]), float(at_cap[2]), float(at_zero[3]), float(at_cap[3]),
		float(at_zero[4]), float(at_cap[4]),
		"PASS" if gates_ok else "FAIL"])

	# 5. EVERY RUNG SAYS WHAT IT BOUGHT. A tier with no perk string is a tier
	#    that grants nothing the player can read -- §88's "a wired verb without
	#    an affordance" wearing a table. Also pins the tier-0 line to the VERB
	#    rather than to a gate, which is §58.
	var voiceless := ""
	for id_lv in GameState.skill_ids():
		var sid_l := String(id_lv)
		var perks: Array = GameState.SKILL_PERKS.get(sid_l, [])
		var rungs2: Array = GameState.SKILL_TIERS[sid_l]
		if perks.size() != rungs2.size() and voiceless == "":
			voiceless = "%s has %d rungs and %d perks" % [
				sid_l, rungs2.size(), perks.size()]
		for t in range(1, perks.size()):
			if String(perks[t]).strip_edges() == "" and voiceless == "":
				voiceless = "%s tier %d is unnamed" % [sid_l, t]
	GameState.skills = {}
	var zero_names_verb := true
	for id_zv in GameState.skill_ids():
		var line0 := GameState.skill_line(String(id_zv))
		if not line0.contains(String(GameState.SKILL_VERBS[id_zv])):
			zero_names_verb = false
	print("[skill] EVERY RUNG SAYS WHAT IT BOUGHT %d ladders, first silent rung: %s; and tier 0 names the act rather than the gate=%s -> %s" % [
		GameState.skill_ids().size(), voiceless if voiceless != "" else "none",
		str(zero_names_verb),
		"PASS" if voiceless == "" and zero_names_verb else "FAIL"])

	GameState.skills = {}
	get_tree().quit()


# --- balance harness --------------------------------------------------------

# Sampled by the balance harness: how often the ship was shooting on its own.
var _bal_auto_frames := 0
var _bal_frames := 0

func _run_balance_test() -> void:
	# Seeded, the same way and for the same reason PYXIS_PACINGTEST is: this
	# harness asserts against a HARD threshold (no fit may burst a whole phase in
	# one window), crit rolls and price drift feed that number, and an unseeded
	# run right at the line reports a coin flip. Not bit-identical — FX and drift
	# draw from the same global RNG on a frame-count-dependent schedule — but
	# close enough that a FAIL means something changed rather than something
	# rolled.
	seed(0x42414c41)
	set_deep_generation(false)
	# The acceptance test for the encounter: no fit may dominate, and each
	# should win a different half of the fight.
	var fits := [
		{"name": "LANCE   ", "a": "lance_2", "b": "lance_2"},
		{"name": "ARC     ", "a": "arc_2", "b": "arc_2"},
		{"name": "PULSE   ", "a": "pulse_2", "b": "pulse_2"},
		{"name": "MIXED   ", "a": "lance_2", "b": "arc_2"},
		# The torpedo family, added after B3. Dual torp_2 draws 12 of an 18-point
		# Mk III, so it is a legal fit and has to be measured like any other.
		{"name": "TORP    ", "a": "torp_2", "b": "torp_2"},
		{"name": "TORP+LNC", "a": "torp_2", "b": "lance_2"},
	]
	GameState.mark_breached("pyx01")
	for id in ["lance_2", "arc_2", "pulse_2", "torp_2"]:
		if not GameState.owns(id):
			GameState.owned.append(id)
	GameState.reactor_tier = 2  # Mk III for every fit, so weapons are the only variable

	print("[balance] fit        ttk    dmg_taken  warps  max_window  seals  result")
	var worst_window := 0.0
	var worst_fit := ""
	var results: Array = []
	for fit in fits:
		var result := await _balance_run(String(fit["a"]), String(fit["b"]), String(fit["name"]))
		print(String(result["line"]))
		result["name"] = String(fit["name"]).strip_edges()
		results.append(result)
		if float(result["window"]) > worst_window:
			worst_window = float(result["window"])
			worst_fit = String(fit["name"]).strip_edges()

	# How much of the encounter the mounts resolved on their own. The bot leaves
	# gaps between probe kills, and return fire fills them — which is the feature
	# working, and also the reason peak single-window damage climbed toward the
	# phase-integrity ceiling. Printed rather than asserted: it is the number you
	# want in front of you when tuning that ceiling.
	print("[balance] RETURN FIRE resolved %d of %d sampled frames (%.1f%% of the fight)" % [
		_bal_auto_frames, _bal_frames,
		100.0 * float(_bal_auto_frames) / maxf(float(_bal_frames), 1.0)])
	# PHASE INTEGRITY: does every fit actually MEET the encounter's mechanic?
	#
	# This used to compare peak single-window damage against a phase's HP, and
	# that comparison was quietly broken: `max_window` is the HP a phase LOST in a
	# window, so it can never exceed the phase's HP. It was measuring "the phase
	# died", not "the fit could have killed it twice over". Removing the cap
	# (phase HP temporarily 6000) showed the real peak burst is ~2520 against a
	# 1700 phase — so a strong fit with Overcharge up and every plate open has
	# ALWAYS been able to delete a phase in one window. The old assertion passed
	# only because peak burst and a full window rarely coincided, and it began
	# failing when return fire made them coincide more often.
	#
	# So measure the thing the design actually cares about. From the top of
	# apex_boss.gd: a fit that bursts through "would never meet a seal, a probe,
	# or the sweep — it would skip the encounter's ENTIRE mechanic". Bursting one
	# phase is not that. Never being shut out and made to clear a pack is.
	#
	# SAMPLED, TWO-TIER — the fourth version of this assertion, and this one was
	# finally set from a distribution measured on purpose (66 samples: the 31
	# from the relocation pass, plus 33 from a dedicated five-run standalone
	# measurement; STRATEGY §41).
	#
	# v1 compared peak window damage against phase HP — a number CAPPED by phase
	# HP, so it could only ever fail on an exact tie. v2 counted seals with a bar
	# of 2, set from six runs showing 3-10 — and PULSE's true floor turned out to
	# be 1. v3 replaced the bar with a per-fit MEDIAN >= 2 — which is a different
	# way of writing the same mistake, because the measured distribution puts
	# 18-29% of the low fits' mass AT exactly 1 (PULSE 4/14, TORP 3/13, TORP+LNC
	# 2/10, LANCE 2/11): a median bar resting ON the distribution's own median
	# fails P(>=2 of 3 samples = 1) ~ 43% of sweeps, which is what "failed 3 of 5
	# runs, standalone and in-sweep alike" was. No sample count fixes that — the
	# statistic was wrong, not the sampling.
	#
	# The two claims, each matched to what 66 samples say the fight guarantees:
	#
	#   every run >= 1 seal        no fit EVER fully skips the mechanic (13's
	#                              actual catastrophe — "would never meet a
	#                              seal"). Zero violations in 66 samples.
	#   every fit lands one >= 2   no fit is CONSISTENTLY shut out of the full
	#                              shape — resample until a run engages twice, up
	#                              to 5 samples. The longest observed run of 1s
	#                              is two; five straight would be ~0.2% for the
	#                              worst fit at its measured rate. What a typical
	#                              1-2 seal fight FEELS like is the playtest's
	#                              question, not this line's.
	var samples := {}
	for r in results:
		samples[String((r as Dictionary)["name"])] = [int((r as Dictionary).get("seals", 0))]
	for fit in fits:
		var nm := String(fit["name"]).strip_edges()
		# Resample UNTIL the fit engages properly once, capped at 5 samples —
		# the early exit is what keeps the honest sample count affordable.
		while (samples[nm] as Array).size() < 5 and int((samples[nm] as Array).max()) < 2:
			var rerun := await _balance_run(String(fit["a"]), String(fit["b"]), String(fit["name"]))
			print(String(rerun["line"]) + "  (resample)")
			(samples[nm] as Array).append(int(rerun.get("seals", 0)))

	var dist_line := ""
	var floor_ok := true
	var engaged_ok := true
	for nm_v in samples:
		var arr: Array = samples[nm_v]
		arr.sort()
		if arr.size() > 1 or int(arr[arr.size() - 1]) < 2:
			dist_line += "%s %s; " % [String(nm_v), "/".join(arr.map(func(x): return str(x)))]
		if int(arr[0]) < 1:
			floor_ok = false
		if int(arr[arr.size() - 1]) < 2:
			engaged_ok = false
	print("[balance] PHASE INTEGRITY (sampled) %severy run >= 1 seal=%s, every fit lands a run >= 2=%s -> %s" % [
		dist_line if dist_line != "" else "all fits >= 2 first run; ",
		str(floor_ok), str(engaged_ok),
		"PASS" if floor_ok and engaged_ok else "FAIL"])
	print("[balance]   (peak single-window damage %.0f by %s, against %.0f phase hp — informational:" % [
		worst_window, worst_fit, float((ApexBoss.PHASES[0] as Dictionary)["hp"])])
	print("[balance]    this number is CAPPED by phase hp and so cannot be asserted against it)")
	get_tree().quit()


func _balance_run(weapon_a: String, weapon_b: String, label: String) -> Dictionary:
	GameState.equip(ModuleDB.Slot.WEAPON_A, weapon_a)
	GameState.equip(ModuleDB.Slot.WEAPON_B, weapon_b)
	# v17. UNDO THE KILL THE LAST FIT MADE. Every run here fights the same engine
	# to a conclusion, and since v17 an engine that has been put down is not
	# rebuilt -- so without this the first fit killed pyx01's and every fit after
	# it reported NO BOSS. PHASE INTEGRITY then read a row of zeros, which is a
	# suite measuring nothing rather than a balance result.
	#
	# Cleared per RUN and not once at the top, because the resample pass calls
	# this again after four more kills. Same shape as HUNTTEST restoring
	# apex_killed after it asserts on it: a harness that deliberately replays an
	# encounter the game gives once has to put the world back itself.
	GameState.apex_down = []
	_load_system("pyx01")
	await get_tree().create_timer(0.5).timeout

	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var boss := _find_apex()
	if boss == null:
		return {"line": "[balance] %s  NO BOSS" % label, "window": 0.0}
	# v15. STAGED AT THE LAIR, NOT AT SPAWN, and taken from the boss node rather
	# than recomputed: the engine hides ~300u out now and the wake is a PROXIMITY
	# poll, so a fit parked at the origin never starts a fight at all. This suite
	# would have spent three minutes per fit flying and reported six timeouts as a
	# balance result. What it measures is the ENCOUNTER, not the expedition to it.
	#
	# THE STAND-OFF IS 30u BECAUSE THE OLD ONE WAS. Spawn (0,0,6) against the
	# authored boss at (10,0,-22) is 29.7u, and every number this suite polices —
	# phase HP, the burst ceiling, the seal distribution — was tuned against a
	# fight that began from there. Parking at the hull instead changes the opening
	# beat: nothing is commanded during the 4.8s wake, so a ship dropped at 8u
	# starts the first survey window already inside CORE_RANGE and burns the phase
	# down before the boss can seal. Measured, not guessed — at 8u, LANCE's seal
	# count fell to 1/1/2 and PHASE INTEGRITY failed on a median it had always
	# cleared. The distance to the engine is not what this suite varies.
	const APPROACH := 30.0
	player.global_position = boss.global_position + Vector3(0, 0, APPROACH)
	player.shield = player.shield_max
	await get_tree().physics_frame

	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 0.6).timeout

	var elapsed := 0.0
	var damage_taken := 0.0
	var warps := 0
	var prev_shield := player.shield
	# Largest HP drop inside one uninterrupted SURVEY window — the number that
	# says whether a fit engages the encounter or skips it.
	var max_window := 0.0
	var window_start_hp := -1.0
	# How many times this fit was actually SHUT OUT and made to clear a pack. This
	# is the encounter's mechanic; everything else is decoration on it.
	var seals := 0
	var was_sealed := false
	var was_survey := false
	const STEP := 0.25
	while is_instance_valid(boss) and elapsed < 180.0:
		var in_survey: bool = boss.state == ApexBoss.State.SURVEY
		if in_survey and not was_survey:
			window_start_hp = boss.hp
		elif was_survey and not in_survey and window_start_hp >= 0.0:
			max_window = maxf(max_window, window_start_hp - boss.hp)
			window_start_hp = -1.0
		was_survey = in_survey

		if in_survey:
			_engage_core(player, boss)
		else:
			_attack_nearest_probe(player)
		var sealed_now: bool = is_instance_valid(boss) and boss.state == ApexBoss.State.SEAL
		if sealed_now and not was_sealed:
			seals += 1
		was_sealed = sealed_now
		if player.ability_ready():
			player.activate_ability()
		if player.auto_target != null:
			_bal_auto_frames += 1
		_bal_frames += 1
		await get_tree().create_timer(STEP).timeout
		elapsed += STEP
		if player.shield < prev_shield:
			damage_taken += prev_shield - player.shield
		elif player.shield >= player.shield_max and prev_shield < 5.0:
			warps += 1
		prev_shield = player.shield
		# v15. AND FLY BACK OUT AFTER DYING. The emergency warp used to be a blip:
		# the engine sat 25u from spawn, so a ship dropped at the dock was still in
		# the fight and the run carried on. From the lair it is 300u, which is past
		# the leash — so the encounter ends, the engine resets, and every second of
		# every fit's run after its first death would have been measuring a ship
		# parked at home with nothing to shoot. The trip back is instant here
		# because the trip is not what this suite measures; `warps` already carries
		# the cost, and the reset engine carries the rest.
		if is_instance_valid(boss) \
				and player.global_position.distance_to(boss.global_position) > ApexBoss.WAKE_RANGE:
			player.global_position = boss.global_position + Vector3(0, 0, APPROACH)
			if not boss_active:
				_apex_wake_timer = 0.2

	# A kill landing mid-window still counts as that window's damage.
	if was_survey and window_start_hp >= 0.0:
		var end_hp: float = boss.hp if is_instance_valid(boss) else 0.0
		max_window = maxf(max_window, window_start_hp - end_hp)

	var killed := not is_instance_valid(boss)
	# Clear the wreck and any stragglers before the next fit's run.
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is ApexWreck:
			(n as Node3D).queue_free()
	return {
		"line": "[balance] %s %6.1fs  %8.0f  %5d  %10.0f  %5d  %s" % [
			label, elapsed, damage_taken, warps, max_window, seals,
			"KILLED" if killed else "TIMEOUT"],
		"window": max_window,
		"seals": seals,
		"killed": killed,
	}


# --- boss edge-case tests ---------------------------------------------------

func _run_boss_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	set_deep_generation(false)
	GameState.mark_breached("pyx01")   # so the engine is live
	# v15. AND THE LANE HAS TO BE OPENED SEPARATELY. Breaching only CHARTS pyx02
	# now; the lane stays jammed until the engine dies (STRATEGY §38). Without
	# this, step 2's travel_to is refused and every observation after it describes
	# a ship that never left — which is exactly what it was reporting.
	GameState.open_lane("pyx01")
	_load_system("pyx01")
	await get_tree().create_timer(0.4).timeout

	# v15. OUT TO THE ENGINE FIRST: the wake is a proximity poll, so armed from
	# spawn it refuses and every check below runs against a boss that never woke.
	#
	# v15.1. AND EVERY LINE HERE IS AN ASSERTION NOW. This suite printed
	# observations — `woke: boss_active=false`, `HUB EXPLOIT took_damage=false
	# (must be true)`, `WAVES RESUMED: swarm_count=0 (must be > 0)` — and the
	# sweep counted every one of those lines as green while they described a
	# suite measuring nothing. An expectation the runner cannot see is a code
	# review comment, not a check.
	var boss := _find_apex()
	player.global_position = boss.global_position + Vector3(0, 0, 6.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.2).timeout
	print("[bosstest] WOKE boss_active=%s boss_found=%s -> %s" % [
		str(boss_active), str(boss != null),
		"PASS" if boss_active and boss != null else "FAIL"])

	# 1. Hub exploit: parking on the boss must NOT be a safe pocket.
	#
	# Two measured facts (STRATEGY §41) shape the staging:
	#
	# The ship never actually stands at the centre. SystemBuilder registers the
	# hub as an obstacle at HUB_RADIUS * 0.75 (1.65u) and PlayerShip resolves
	# out of it every physics frame, so a ship teleported to the boss's own
	# position settles at 2.60u and stays there. "Parking on the boss" means
	# parking at that floor — the closest the game lets anything get.
	#
	# The window is 18s — one full phase-0 blade revolution (22°/s, ~16.4s) plus
	# margin — because this check used to wait 3.0s and reported
	# `took_damage=false` every run: the first hit lands ~4s in (the armament's
	# first cycle), so the old window closed before the mechanism it was
	# doubting had a chance to fire. Measured over 20s the parked ship lost 58
	# shield to blades, lance fire and probes; the exploit it was written to
	# catch does not exist.
	player.global_position = boss.global_position
	player.shield = player.shield_max
	await get_tree().create_timer(PlayerShip.WARP_GRACE + 0.3).timeout
	player.global_position = boss.global_position
	var hub_taken := 0.0
	var hub_prev: float = player.shield
	for i in range(18):
		await get_tree().create_timer(1.0).timeout
		if player.shield < hub_prev:
			hub_taken += hub_prev - player.shield
		hub_prev = player.shield
		if player.shield < 40.0:
			player.shield = player.shield_max   # never trip the emergency warp
			hub_prev = player.shield
	print("[bosstest] HUB EXPLOIT parked at the hub floor took %.0f over one blade revolution -> %s" % [
		hub_taken, "PASS" if hub_taken > 0.0 else "FAIL"])

	# 2. Warping out mid-fight must clear boss state, not strand it. The guard
	# is main.gd's `_set_boss_active(false)` on the warp path — without it a
	# mid-fight warp-out permanently stalls the swarm spawner (check 3 is the
	# downstream half of the same defect).
	#
	# The engine is HALVED before leaving, for check 4's sake: the old RETURN
	# observation never damaged the boss at all, so its 1.00 read would also
	# have passed in a world where damage DID persist across a warp — the exact
	# defect the line exists to rule out. Halved HERE because this is the last
	# moment pyx01's engine exists: the warp tears it down with SystemRoot, and
	# pyx02's is never built (pyx02 is uncharted in this staging).
	boss.hp *= 0.5
	print("[bosstest] pre-warp boss_active=", boss_active,
		" hp_fraction=%.2f" % boss.hp_fraction())
	travel_to("pyx02")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	print("[bosstest] WARP-OUT system=%s boss_active=%s -> %s" % [
		system_id, str(boss_active),
		"PASS" if system_id == "pyx02" and not boss_active else "FAIL"])

	# 3. Swarm waves must resume in the new system.
	_wave_timer = 0.2
	await get_tree().create_timer(1.5).timeout
	var resumed := get_tree().get_nodes_in_group("swarm").size()
	print("[bosstest] WAVES RESUMED swarm_count=%d -> %s" % [
		resumed, "PASS" if resumed > 0 else "FAIL"])

	# 4. Returning restores a full-strength engine (fight resets, per design —
	# failure costs tempo, never salvage). The boss left pyx01 at 0.50 hp
	# (halved in check 2); a full read here proves the rebuild starts fresh.
	#
	# v17. THIS CHECK IS ABOUT A DAMAGED ENGINE AND STAYS THAT WAY. A retreat
	# resets; only a WIN sticks, and checks 5-7 below are the win. Reading them as
	# one rule -- "the apex always comes back" -- is what let the respawn bug sit
	# behind a green suite: nothing here had ever killed the thing.
	travel_to("pyx01")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	var boss2 := _find_apex()
	var frac := boss2.hp_fraction() if boss2 else -1.0
	print("[bosstest] RETURN apex_present=%s hp_fraction=%.2f -> %s" % [
		str(boss2 != null), frac,
		"PASS" if boss2 != null and frac >= 0.999 else "FAIL"])

	# 5. A KILLED engine does not come back. Driven to death through take_damage
	# at the core, never by setting a flag: the fix reads GameState.apex_down, and
	# a harness that called mark_apex_down itself would prove only that a list
	# holds what you put in it. The kill has to travel boss -> _die ->
	# _become_wreck -> on_apex_defeated for this to mean anything.
	# Woken first, and that is not ceremony: check 4 rebuilt this engine, so it is
	# DORMANT, and take_damage refuses damage in DORMANT/WAKING/DYING. Without
	# this the loop below swings 400 times into a machine that is asleep and the
	# check fails for a reason that has nothing to do with what it measures.
	player.global_position = boss2.global_position + Vector3(0, 0, 4.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.2).timeout
	var swings := 0
	while is_instance_valid(boss2) and boss2.state != ApexBoss.State.DYING and swings < 400:
		boss2.take_damage(3000.0)
		await get_tree().physics_frame
		swings += 1
	# _become_wreck is stage 4 of the death sequence, 1.5s after the hub collapses.
	await get_tree().create_timer(3.0).timeout
	var died: bool = _find_apex() == null
	var down: bool = GameState.has_apex_down("pyx01")
	var bonus_owed: bool = not GameState.has_killed_apex("pyx01")
	print("[bosstest] ENGINE DIES took %d swings, apex gone=%s, recorded down=%s, bonus still owed=%s -> %s" % [
		swings, str(died), str(down), str(bonus_owed),
		"PASS" if died and down and bonus_owed else "FAIL"])

	# 6. ...and the wreck it left is still there after a round trip, carrying the
	# bonus it was built with. Losing a 15,000-32,000 credit payout to a warp the
	# player had every reason to make is the silent punishment this half exists to
	# forbid; asserting the BONUS and not merely the node is what catches a wreck
	# rebuilt from defaults.
	var wreck_bonus_before: int = _find_apex_wreck().first_kill_bonus if _find_apex_wreck() else -1
	travel_to("pyx02")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	travel_to("pyx01")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	var wreck := _find_apex_wreck()
	var no_engine: bool = _find_apex() == null
	var authored: int = int(SystemDB.get_system("pyx01").get("apex", {}).get("bonus", -1))
	print("[bosstest] A KILLED ENGINE STAYS DEAD engine back=%s, wreck survived=%s carrying %d (was %d, authored %d) -> %s" % [
		str(not no_engine), str(wreck != null),
		wreck.first_kill_bonus if wreck else -1, wreck_bonus_before, authored,
		"PASS" if no_engine and wreck != null and wreck.first_kill_bonus == authored else "FAIL"])

	# 7. And once the wreck is cracked, the lair is empty for good. This is the
	# third state: apex_down says do not rebuild the engine, apex_killed says the
	# wreck has already paid, and together they mean there is nothing left here.
	GameState.mark_apex_killed("pyx01")
	travel_to("pyx02")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	travel_to("pyx01")
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 1.0).timeout
	print("[bosstest] A CRACKED WRECK LEAVES NOTHING engine=%s wreck=%s -> %s" % [
		str(_find_apex() != null), str(_find_apex_wreck() != null),
		"PASS" if _find_apex() == null and _find_apex_wreck() == null else "FAIL"])

	# A COLOUR SETTING MUST NOT END A FIGHT.
	#
	# rebuild_visuals routes through _load_system, which frees SystemRoot -- and
	# the engine is a SystemRoot child. Mid-encounter that meant the boss came
	# back DORMANT at full HP with every probe and weld gone and boss_active
	# cleared: a fight the player was winning, silently reset by a menu.
	#
	# Nothing gated the door. The pause menu opens during a boss fight
	# (set_panels_locked disables only refit and chart, never pause or Escape)
	# and COLOUR VISION sits on its root page, so this was two taps from inside
	# any encounter in the game.
	#
	# BOTH HALVES, because a rebuild that was merely refused would leave the
	# player's setting silently dropped -- the retint has to actually land once
	# the fight is over.
	GameState.apex_down = []
	_load_system("pyx01")
	await get_tree().create_timer(0.4).timeout
	var vis_player: PlayerShip = get_tree().get_first_node_in_group("player")
	var vis_boss := _find_apex()
	vis_player.global_position = vis_boss.global_position + Vector3(0, 0, 6.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.2).timeout
	var vis_fighting := boss_active
	rebuild_visuals()
	await get_tree().create_timer(0.3).timeout
	# The fight is untouched and the SAME node is still standing -- a rebuild
	# would have replaced it with a fresh dormant one at full strength.
	var vis_survived: bool = boss_active and is_instance_valid(vis_boss) \
		and _find_apex() == vis_boss
	var vis_deferred := _vision_rebuild_pending
	disengage_apex(false)
	await get_tree().create_timer(0.4).timeout
	var vis_spent: bool = not _vision_rebuild_pending
	print("[bosstest] A COLOUR SETTING DOES NOT END A FIGHT engaged=%s, fight survived the retint=%s, retint deferred=%s, spent once the fight ended=%s -> %s" % [
		str(vis_fighting), str(vis_survived), str(vis_deferred), str(vis_spent),
		"PASS" if vis_fighting and vis_survived and vis_deferred and vis_spent
			else "FAIL"])

	get_tree().quit()


# --- per-Pyx signature test -------------------------------------------------

func _run_sig_test() -> void:
	# Probes rather than flying: a signature sits in bands a harness would spend
	# minutes reaching, and plan_cell is pure, so the questions worth asking are
	# all answerable without building a world.
	var probes := {}
	for sid_v in SystemDB.ids():
		var sid := String(sid_v)
		var pr := DeepSpace.new()
		pr.generating = false
		add_child(pr)
		pr.configure(SystemDB.get_system(sid), sid)
		probes[sid] = pr

	# 1. A SIGNATURE BELONGS TO ITS SYSTEM. Every kind found anywhere in a
	#    system must be the kind that system authored, and in a band it
	#    authored. Cross-contamination here would mean the def is being read
	#    from the wrong place, which is the failure a shared static would cause.
	var wrong := ""
	var found_kinds := {}
	for sid_v2 in SystemDB.ids():
		var sid2 := String(sid_v2)
		var want: Dictionary = SystemDB.signature_of(sid2)
		var want_kind := String(want.get("kind", ""))
		var want_bands: Array = want.get("bands", [])
		var pr2: DeepSpace = probes[sid2]
		var seen := 0
		for cz_s in range(0, 60):
			for cx_s in range(0, 60):
				var sg: Dictionary = pr2.plan_cell(cx_s, cz_s)["signature"]
				if sg.is_empty():
					continue
				seen += 1
				if String(sg["kind"]) != want_kind:
					wrong = "%s produced %s" % [sid2, String(sg["kind"])]
				if not want_bands.has(int(sg["band"])):
					wrong = "%s produced band %d" % [sid2, int(sg["band"])]
		found_kinds[sid2] = seen
	print("[sig] A SIGNATURE BELONGS TO ITS SYSTEM counts %s, kind/band violations: %s -> %s" % [
		str(found_kinds), "none" if wrong == "" else wrong,
		"PASS" if wrong == "" and int(found_kinds["pyx01"]) > 0
			and int(found_kinds["pyx02"]) > 0 and int(found_kinds["pyx03"]) > 0
			else "FAIL"])

	# 2. THE SIGNATURE TAKES NO SHARED DRAW. The rule every appended block in
	#    plan_cell lives under, asserted the way THE DRAW COUNT DID NOT MOVE
	#    asserts it: strip the signature out of a def and every other product of
	#    the cell must be byte-identical. Red-verify by moving the srng draws
	#    below the gate — the shared stream is untouched either way, but the
	#    signature's OWN placement shears, which the third clause catches.
	var sig_def: Dictionary = SystemDB.get_system("pyx03").duplicate(true)
	(sig_def["deep"] as Dictionary).erase("signature")
	var no_sig := DeepSpace.new()
	no_sig.generating = false
	add_child(no_sig)
	no_sig.configure(sig_def, "pyx03")
	var untouched := true
	var touched_at := ""
	var pr3: DeepSpace = probes["pyx03"]
	for cz_t in range(10, 40):
		for cx_t in range(10, 40):
			var with_sig := pr3.plan_cell(cx_t, cz_t)
			var without := no_sig.plan_cell(cx_t, cz_t)
			for key_v in ["rocks", "hulk", "pack", "station", "convoy", "seams",
					"landmark", "hulk2"]:
				var key := String(key_v)
				if str(with_sig[key]) != str(without[key]):
					untouched = false
					if touched_at == "":
						touched_at = "%s @(%d,%d)" % [key, cx_t, cz_t]
	no_sig.free()
	print("[sig] THE SIGNATURE TAKES NO SHARED DRAW 900 pyx03 cells, every other key identical with and without=%s%s -> %s" % [
		str(untouched), "" if touched_at == "" else " (" + touched_at + ")",
		"PASS" if untouched else "FAIL"])

	# 3. AND IT IS STABLE. The same cell asked twice returns the same site, and
	#    a different cell returns a different one. Cheap, and it is what makes
	#    "the place you found is still there" a property rather than a hope.
	var a1 := str(pr3.plan_cell(23, 17)["signature"])
	var a2 := str(pr3.plan_cell(23, 17)["signature"])
	print("[sig] THE SAME CELL HOLDS THE SAME SITE twice-planned identical=%s -> %s" % [
		str(a1 == a2), "PASS" if a1 == a2 else "FAIL"])

	# 4. IT ANSWERS TO THE KEEP-OUTS. built_plan is the arena filter every other
	#    placed thing passes through; a signature that ignored it could stand on
	#    a dock ring or inside the apex arena.
	# THROUGH built_plan, which is the half the first draft missed: it was named
	# for the keep-outs and then only ever called plan_cell, so the "signature"
	# entries added to both of built_plan's subtraction loops were never once
	# exercised. It also could not fail -- plan_cell already refuses a site under
	# CONTENT_MIN_DEPTH, so the clause was re-checking a guard one line away.
	#
	# Three properties now, all of them things plan_cell alone cannot answer:
	# nothing inside the charted volume, nothing close enough to a station to
	# cover its dock ring, and built_plan actually removing sites in the arena.
	var inside := 0
	var too_close := 0
	var pr1: DeepSpace = probes[GameState.current_system]
	var planned := 0
	var survived := 0
	for cz_k in range(-3, 30):
		for cx_k in range(-3, 30):
			if not (pr1.plan_cell(cx_k, cz_k)["signature"] as Dictionary).is_empty():
				planned += 1
			var bp := pr1.built_plan(cx_k, cz_k)
			var sg2: Dictionary = bp["signature"]
			if sg2.is_empty():
				continue
			survived += 1
			if float(pr1.depth_at(sg2["pos"])) < DeepSpace.CONTENT_MIN_DEPTH:
				inside += 1
			var st2: Dictionary = bp["station"]
			if not st2.is_empty() and (sg2["pos"] as Vector3).distance_to(
					st2["pos"] as Vector3) < SignatureSite.SLAG_RANGE + Port.DOCK_RANGE:
				too_close += 1
	print("[sig] IT ANSWERS TO THE KEEP-OUTS %d planned, %d survive built_plan; %d inside the charted volume, %d within reach of a dock ring (want 0/0) -> %s" % [
		planned, survived, inside, too_close,
		"PASS" if inside == 0 and too_close == 0 and planned > 0 else "FAIL"])

	# 5. EVERY SYSTEM NAMES ITS OWN BANDS, and the fallback still answers for a
	#    def that authors none — which is what every harness-built system is.
	var names_ok := true
	var name_report := ""
	for sid_v3 in SystemDB.ids():
		var sid3 := String(sid_v3)
		var n1 := SystemDB.band_name_of(sid3, 2, DeepSpace.BAND_NAMES[2])
		name_report += "%s:%s " % [sid3, n1]
		if n1 == "":
			names_ok = false
	var fallback := SystemDB.band_name_of("nosuchsystem", 2, DeepSpace.BAND_NAMES[2])
	print("[sig] EVERY SYSTEM NAMES ITS OWN BANDS %s| unknown system falls back to '%s' -> %s" % [
		name_report, fallback,
		"PASS" if names_ok and fallback == DeepSpace.BAND_NAMES[2] else "FAIL"])

	# 6. THE RADAR KNOWS WHAT IT IS. A new tier is only real if TIER_NAMES grew
	#    with it — MANUALTEST sweeps that list against the manual's HUD page, so
	#    a tier without a name is a legend row nobody wrote.
	# INDEXED +1, because TIER_HOME is -1 and TIER_NAMES leads with "HOME".
	# The first draft indexed by the tier directly, so it read TIER_NAMES[8] --
	# "STORM" -- printed a false name in the log, and was fully vacuous: both
	# clauses were already true BEFORE "ODDITY" was appended, so deleting the row
	# it exists to police would not have failed it. BEACONTEST had the convention
	# right; this now matches it, checks the name by EQUALITY, and pins the
	# array's length so the next appended tier cannot leave it short.
	var sig_name := ""
	if HUD.RadarLayer.TIER_NAMES.size() > HUD.RadarLayer.TIER_SIGNATURE + 1:
		sig_name = String(HUD.RadarLayer.TIER_NAMES[HUD.RadarLayer.TIER_SIGNATURE + 1])
	var tier_named: bool = sig_name == "ODDITY" \
		and HUD.RadarLayer.TIER_NAMES.size() == HUD.RadarLayer.TIER_SIGNATURE + 2
	print("[sig] THE RADAR KNOWS WHAT IT IS tier %d named '%s', %d names for %d tiers -> %s" % [
		HUD.RadarLayer.TIER_SIGNATURE, sig_name,
		HUD.RadarLayer.TIER_NAMES.size(), HUD.RadarLayer.TIER_SIGNATURE + 2,
		"PASS" if tier_named else "FAIL"])

	# 7. IT JOINS NOTHING ELSE. The class comment claims a signature is not
	#    crackable and not mineable -- that it stays off CameraRig's four-group
	#    pick ladder so it can never win a tap the player meant for the hulk or
	#    the seam beside it. That was a comment and nothing more until here.
	#    Built rather than planned, because group membership happens in _ready
	#    and a plan cannot be asked about it.
	var probe_site := SignatureSite.new()
	probe_site.kind = "relay"
	probe_site.band = 1
	add_child(probe_site)
	var joined := ""
	for g_v in ["apex", "dockable", "crackable", "hostiles", "mineable", "beacon",
			"hyper", "storm", "player"]:
		if probe_site.is_in_group(String(g_v)):
			joined += "%s " % String(g_v)
	var own_group: bool = probe_site.is_in_group("signature")
	probe_site.free()
	print("[sig] IT JOINS NOTHING ELSE in its own group=%s, leaked into: %s -> %s" % [
		str(own_group), "none" if joined == "" else joined,
		"PASS" if own_group and joined == "" else "FAIL"])

	for pv in probes.values():
		(pv as DeepSpace).free()
	get_tree().quit()


# --- rival cartographer test -------------------------------------------------

func _run_rival_test() -> void:
	# The rival is arithmetic wearing a jacket, so what gets asserted is the
	# arithmetic's promises: purity, the stride, the depth gradient, and above
	# all that nothing the player HAS can ever be taken by it.
	var seed_r := GameState.run_seed
	var t_save := GameState.played_seconds

	# 1. A PURE FUNCTION ON A QUANTISED CLOCK. Same inputs, same answer;
	#    monotone in time (a filed cell never un-files); and stable within a
	#    stride, which is what lets the cell streamer call it from two builds
	#    seconds apart without the world disagreeing with itself.
	var pure_bad := ""
	for i in 200:
		var k := "pyx01:%d:%d" % [i, i * 3 % 17]
		var d := 100.0 + float(i) * 37.0
		var a1 := Rival.arrival_seconds(k, d, seed_r)
		var a2 := Rival.arrival_seconds(k, d, seed_r)
		if a1 != a2:
			pure_bad = "%s answered twice differently" % k
			break
		var t := float(i) * 977.0
		if Rival.filed(k, d, seed_r, t) and not Rival.filed(k, d, seed_r, t + Rival.STRIDE_S * 5.0):
			pure_bad = "%s un-filed itself" % k
			break
		var stride_base := floorf(t / Rival.STRIDE_S) * Rival.STRIDE_S
		if Rival.filed(k, d, seed_r, stride_base) != Rival.filed(k, d, seed_r,
				stride_base + Rival.STRIDE_S - 1.0):
			pure_bad = "%s moved inside a stride" % k
			break
	print("[rival] A PURE FUNCTION ON A QUANTISED CLOCK 200 cells: %s -> %s" % [
		"pure, monotone, stride-stable" if pure_bad == "" else pure_bad,
		"PASS" if pure_bad == "" else "FAIL"])

	# 2. THE SHALLOWS GO FIRST AND THE DEEP OUTRUNS THEM. Measured over the
	#    jitter, not restated from the constants: the LATEST arrival at depth
	#    200 must precede the EARLIEST at the band-4 floor, and that earliest
	#    must be past fifteen hours of play -- the deep belongs to a player who
	#    flies there, for as long as anyone plays a run.
	var max_shallow := 0.0
	var min_deep := 1.0e18
	for i in 500:
		max_shallow = maxf(max_shallow, Rival.arrival_seconds("pyx02:%d:1" % i, 200.0, seed_r))
		min_deep = minf(min_deep, Rival.arrival_seconds("pyx02:%d:2" % i, 1100.0, seed_r))
	print("[rival] THE DEEP OUTRUNS THEM latest 200u arrival %.0fs, earliest 1100u arrival %.0fs (bar 54000s = 15h) -> %s" % [
		max_shallow, min_deep,
		"PASS" if max_shallow < min_deep and min_deep >= 54000.0 else "FAIL"])

	# 3. A FRESH PILOT MEETS NOBODY. At zero played seconds the rival has filed
	#    nothing anywhere -- the first sortie is never pre-empted, which is the
	#    difference between a rival and a hazing.
	var fresh_bad := ""
	for i in 100:
		if Rival.filed("pyx01:%d:0" % i, 50.0 + float(i) * 60.0, seed_r, 0.0):
			fresh_bad = "cell %d filed at t=0" % i
			break
	print("[rival] A FRESH PILOT MEETS NOBODY 100 cells at t=0: %s -> %s" % [
		"none filed" if fresh_bad == "" else fresh_bad,
		"PASS" if fresh_bad == "" else "FAIL"])

	# 4. THE RIVAL NEVER TAKES WHAT YOU HAVE. With the clock pushed far enough
	#    that the rival has swept the shallows: a cell the player FILED stays
	#    filed and stays paid-for; a cell they surveyed but had not filed is
	#    consumed without pay at the counter -- and coverage, the thing the
	#    chart draws, never loses an entry to any of it.
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	var rk_a := DeepSpace.cell_key(system_id, 4, 0)
	var rk_b := DeepSpace.cell_key(system_id, 0, 4)
	GameState.note_survey_worked(rk_a)
	GameState.note_survey_worked(rk_b)
	GameState.note_survey_filed(rk_a)
	GameState.played_seconds = 100000.0
	var rival_took_b := Rival.filed(rk_b, cell_depth_of_key(rk_b), seed_r, 100000.0)
	var salv_r := GameState.salvage
	var paid_r := file_charts_on_sale("chart_drift", SurveyMast.YIELD_UNITS)
	print("[rival] THE RIVAL NEVER TAKES WHAT YOU HAVE player-filed cell still filed=%s; rival-reached cell (%s) paid %d and salvage moved %d; coverage still %d of 2 -> %s" % [
		str(GameState.is_survey_filed(rk_a)), str(rival_took_b), paid_r,
		GameState.salvage - salv_r, GameState.survey_coverage.size(),
		"PASS" if GameState.is_survey_filed(rk_a) and rival_took_b and paid_r == 0
			and GameState.salvage == salv_r
			and GameState.survey_coverage.size() == 2 else "FAIL"])
	GameState.played_seconds = t_save
	GameState.survey_coverage = {}
	GameState.survey_filed = {}

	# 5. EVIDENCE IS NOT AN ATTACK. A foreign beacon is furniture: it joins the
	#    beacon pick group and no combat group, it refuses the recovery hold,
	#    and neither the store nor the stock ever hears about it.
	var fb := Beacon.new()
	fb.foreign = true
	fb.system_id = system_id
	add_child(fb)
	fb.global_position = Vector3(500.0, 0.0, 0.0)
	await get_tree().process_frame
	var stock_before := GameState.beacon_stock_left()
	fb.hold_begin()
	fb.hold_tick(10.0)
	var groups_ok: bool = fb.is_in_group("beacon") \
		and not fb.is_in_group("hostiles") and not fb.is_in_group("combatants")
	print("[rival] EVIDENCE IS NOT AN ATTACK groups beacon/hostiles/combatants=%s/%s/%s, a 10s hold recovered nothing (stock %d -> %d, store %d entries) -> %s" % [
		str(fb.is_in_group("beacon")), str(fb.is_in_group("hostiles")),
		str(fb.is_in_group("combatants")), stock_before,
		GameState.beacon_stock_left(), GameState.beacons.size(),
		"PASS" if groups_ok and GameState.beacon_stock_left() == stock_before
			and GameState.beacons.is_empty() else "FAIL"])
	fb.queue_free()
	get_tree().quit()


# --- survey plot test -------------------------------------------------------

func _run_plot_test() -> void:
	# The plot answers the loudest of the five playtest notes, so what it is
	# asserted on is legibility rather than pixels: does the scale contain what
	# the player owns, is the picture there at all outside a hunt, do the rings
	# mean the depth they claim, and does a gesture leave the reader where they
	# were looking.
	var cp := chart_panel
	var sid := GameState.current_system
	var s := SystemDB.get_system(sid)
	var bounds := float(s.get("bounds", 40.0))
	var lair: Dictionary = (s.get("apex", {}) as Dictionary).get("lair", {})
	var band: Array = lair.get("depth", [200.0, 300.0])
	var old_r := bounds + float(band[1])

	# 1. THE PLOT FITS ITS CONTENT. The old scale came off the apex band's outer
	#    edge, so a beacon past it drew outside the rect and was simply missing.
	#    The far beacon is placed at TWICE that radius, and the assertion needs
	#    BOTH halves: the new fit covers it, and the old rule did not -- without
	#    the second clause this passes on a scale that never changed.
	#    THE SECOND CLAUSE WAS TAUTOLOGICAL AND IS NOW NOT. It read
	#    `old_r < far` with `far := old_r * 2.0` -- which is `old_r < 2 * old_r`,
	#    true for any positive radius, so it asserted nothing and the leg rested
	#    entirely on `covers`. What has to be shown is that THE BEACON IS WHAT
	#    MOVED THE SCALE: fit it with the beacon and without, and require the
	#    difference. A fit that ignored beacons entirely would return the same
	#    number twice and go red here, which is the bug this exists for.
	var far := old_r * 2.0
	GameState.beacons[sid] = []
	var fit_bare := cp.fit_radius_for(sid)
	GameState.beacons[sid] = [{"x": far, "z": 0.0}]
	var fit := cp.fit_radius_for(sid)
	var covers := fit >= far
	var beacon_drove := fit > fit_bare and fit_bare < far
	print("[plot] THE PLOT FITS ITS CONTENT beacon at %.0fu, fit %.0fu vs %.0fu without it (old rule %.0fu) -> %s" % [
		far, fit, fit_bare, old_r, "PASS" if covers and beacon_drove else "FAIL"])

	# 2. THE SHIP IS PART OF THE PICTURE. Same question for the other thing that
	#    can be anywhere: a ship 3x past the band must not fall off the plot.
	#    Passed as an ARGUMENT, which is the whole reason fit_radius_for takes
	#    one -- a scene lookup could not be handed this case.
	var ship_far := Vector2(0.0, old_r * 3.0)
	var fit_ship := cp.fit_radius_for(sid, ship_far)
	print("[plot] THE SHIP IS PART OF THE PICTURE ship at %.0fu -> fit %.0fu -> %s" % [
		ship_far.length(), fit_ship,
		"PASS" if fit_ship >= ship_far.length() and fit_ship > fit else "FAIL"])
	GameState.beacons[sid] = []

	# 3. THE PLOT DRAWS WITHOUT A HUNT. The reversal itself. A charted system
	#    whose engine is dead still gets a picture -- that is where most of
	#    "extremely hard to understand" came from, because the plot was absent
	#    far more often than it was confusing. Asserted in both directions so a
	#    gate that simply returns true cannot pass it.
	var was_killed := GameState.apex_killed.duplicate()
	if not GameState.apex_killed.has(sid):
		GameState.apex_killed.append(sid)
	var useful_dead := cp._plot_is_useful(sid)
	var hunt_dead := cp._hunt_is_live(sid)
	GameState.apex_killed.assign(was_killed)
	var useful_unknown := cp._plot_is_useful("pyx99")
	print("[plot] THE PLOT DRAWS WITHOUT A HUNT engine dead: drawn=%s hunt=%s; unknown system drawn=%s -> %s" % [
		useful_dead, hunt_dead, useful_unknown,
		"PASS" if useful_dead and not hunt_dead and not useful_unknown else "FAIL"])

	# 4. THE RINGS MEAN DEPTH. A ring is drawn at band_ring_radius, and the
	#    reader is told it is the start of that band. Tie that claim to the
	#    function the WORLD uses to answer the same question -- depth_at
	#    subtracts bounds, band_of maps depth to band -- so the label and the
	#    place agree by construction rather than by a matching constant.
	#    BAND_EDGES is off by one from the band number -- band_of returns i + 1 --
	#    so this walks BAND NUMBERS and asks the world, at a point just outside
	#    each ring, which band it is standing in. Just OUTSIDE rather than on:
	#    band 1's edge is depth 0 and band_of maps exactly 0 to CHARTED, so the
	#    boundary itself is the one depth that belongs to neither side.
	var ring_bad := ""
	var top := DeepSpace.BAND_NAMES.size() - 1
	for b in range(1, top + 1):
		var rr: float = ChartPanel.band_ring_radius(bounds, b)
		var just_in := rr - bounds + 0.001
		if DeepSpace.band_of(just_in) != b:
			ring_bad = "band %d ring reads as band %d" % [b, DeepSpace.band_of(just_in)]
			break
		# And THE STRING THE PLOT ACTUALLY DRAWS names that same band, glyph
		# included. Read out of ring_label rather than recomposed here, because a
		# test that built the label itself would agree with a draw that had gone
		# back to keying the glyph off the edge index -- which is the bug this
		# leg exists for, and it renders a picture that looks entirely correct.
		var drawn := cp.ring_label(sid, b)
		var want_label := "%s %s" % [Palette.band_glyph(b),
			DeepSpace.band_name_in(sid, just_in)]
		if drawn != want_label:
			ring_bad = "band %d draws '%s', depth %.0f says '%s'" % [
				b, drawn, just_in, want_label]
			break
	print("[plot] THE RINGS MEAN DEPTH %d rings, radius and name against band_of: %s -> %s" % [
		top, "agree" if ring_bad == "" else ring_bad,
		"PASS" if ring_bad == "" else "FAIL"])

	# 5. THE BAR IS A ROUND NUMBER. Swept rather than spot-checked, because the
	#    property is "for every scale", and a bar that is round at 1,000u and
	#    ragged at 1,347u is a bar nobody can read at the zoom they are at.
	#    THE LEADING DIGIT IS PEELED BY DIVISION, NOT BY A LOGARITHM. The first
	#    version of this leg used floor(log(u) / log(10.0)) to find the exponent
	#    and called 1000.0 a violation, because that expression is
	#    2.9999999999999996 in doubles at every exact power of ten. The bar was
	#    right and the test was wrong -- so it is worth being blunt that this leg
	#    must not reach for the same function the thing it is checking uses, or a
	#    shared numerical quirk becomes a shared blind spot instead of a red.
	var bar_bad := ""
	var want := 3.0
	while want < 200000.0:
		var u: float = ChartPanel.scale_bar_units(want)
		var lead := u
		while lead >= 9.999999:
			lead /= 10.0
		while lead < 0.999999:
			lead *= 10.0
		if absf(lead - 1.0) > 0.0001 and absf(lead - 2.0) > 0.0001 \
				and absf(lead - 5.0) > 0.0001:
			bar_bad = "%.1f -> %.1f leads with %.4f, not 1/2/5" % [want, u, lead]
			break
		if u > want:
			bar_bad = "%.1f -> %.1f overflows" % [want, u]
			break
		want *= 1.37
	print("[plot] THE BAR IS A ROUND NUMBER swept 3u..200000u: %s -> %s" % [
		"all 1/2/5 and none overflow" if bar_bad == "" else bar_bad,
		"PASS" if bar_bad == "" else "FAIL"])

	# 6. ZOOM HOLDS THE POINT UNDER THE FINGER. Zooming toward the centre while
	#    the reader is looking at a beacon in the corner drags that beacon away
	#    -- the gesture and the thing it is for fight each other. The invariant
	#    is that the world point under the anchor is the same point after.
	cp._plot.size = Vector2(320.0, ChartPanel.PLOT_HEIGHT)
	cp.reset_view()
	var anchor := Vector2(250.0, 40.0)
	# Through plot_home(), which is what the DRAWING uses. Recomputing the origin
	# here as `size * 0.5` would make this assertion agree with a zoom that
	# drifts, since it would be making the same mistake -- the bug this catches
	# is precisely the two disagreeing.
	var before_pt := (anchor - (cp.plot_home() + cp._pan)) / cp._zoom
	cp._zoom_about(anchor, 2.0)
	var after_pt := (anchor - (cp.plot_home() + cp._pan)) / cp._zoom
	var held := before_pt.distance_to(after_pt)
	print("[plot] ZOOM HOLDS THE POINT UNDER THE FINGER zoom %.2f, anchor drift %.4fu -> %s" % [
		cp._zoom, held, "PASS" if held < 0.001 and cp._zoom > 1.5 else "FAIL"])

	# 7. A NEW SYSTEM GETS A FRESH VIEW. pyx03's fit radius is an order of
	#    magnitude past pyx01's, so carrying a zoom across lands the reader in
	#    featureless dark with nothing on screen to explain why.
	cp._pan = Vector2(40.0, -20.0)
	# Pinned to a real system first: with _selected still "" the reset would fire
	# on the ""-to-pyx01 change and the assertion would pass without ever testing
	# a system-to-system switch, which is the case it exists for.
	cp._selected = sid
	var other := ""
	for id_v in SystemDB.ids():
		if String(id_v) != sid:
			other = String(id_v)
			break
	cp._select(other)
	print("[plot] A NEW SYSTEM GETS A FRESH VIEW %s -> zoom %.2f pan %s -> %s" % [
		other, cp._zoom, str(cp._pan),
		"PASS" if is_equal_approx(cp._zoom, 1.0) and cp._pan == Vector2.ZERO else "FAIL"])

	# 8. THE LEGEND LAYS ITSELF OUT. Written first as a closure advancing a
	#    captured `lx` cursor, which cannot work: GDScript lambdas capture locals
	#    BY VALUE, so `lx += ...` moved the lambda's own copy and every entry drew
	#    at the same x -- the legend rendered as one smear on top of itself. That
	#    is invisible in a diff and invisible to any assertion that can only watch
	#    draw calls, so the layout is a list of numbers now and this checks the
	#    numbers: strictly increasing, and each gap wide enough for the swatch.
	var words := PackedStringArray(["YOU", "BEACON", "COLONY", "ESTIMATE"])
	var xs := cp.legend_layout(words)
	var lay_bad := ""
	if xs.size() != words.size():
		lay_bad = "%d positions for %d words" % [xs.size(), words.size()]
	else:
		for i in range(1, xs.size()):
			if xs[i] - xs[i - 1] < 13.0:
				lay_bad = "'%s' advances only %.1fpx from '%s'" % [
					words[i], xs[i] - xs[i - 1], words[i - 1]]
				break
	print("[plot] THE LEGEND LAYS ITSELF OUT %d entries at %s -> %s" % [
		words.size(), str(xs), "PASS" if lay_bad == "" else "FAIL " + lay_bad])

	# 9. AND ONLY FOR LAYERS THAT ARE DRAWN. A legend entry for a layer the
	#    picture is not drawing is a promise it does not keep. The hunt entry is
	#    the one that moves, so it is the one asserted in both directions.
	# Assertion 7 left _selected on the OTHER system, and legend_words reads it.
	# Pinned back first, or this is asking about a system the fixtures below are
	# not being written to.
	cp._selected = sid
	GameState.beacons[sid] = []
	var dead_words := cp.legend_words(false, false)
	GameState.beacons[sid] = [{"x": 100.0, "z": 0.0}]
	# ESTIMATE needs a reading on file, not just a live hunt -- the ring is drawn
	# only where evidence agrees, so its legend entry follows the evidence.
	GameState.add_apex_hint(sid, {"kind": "ring", "quadrant": "EAST"})
	var live_words := cp.legend_words(true, true)
	# Named absences rather than "empty": a system with a founded colony legitimately
	# carries COLONY in both lists, and asserting emptiness would fail on a pilot
	# who had done nothing wrong. The three that must MOVE are the three under test.
	var moved := true
	for w in ["YOU", "BEACON", "ESTIMATE"]:
		if dead_words.has(w) or not live_words.has(w):
			moved = false
	print("[plot] AND ONLY FOR LAYERS THAT ARE DRAWN nothing drawn -> %s; all drawn -> %s -> %s" % [
		str(dead_words), str(live_words), "PASS" if moved else "FAIL"])
	GameState.beacons[sid] = []

	# 9b. THE CHART IS TWO DOCUMENTS (v25, §97). A surveyed cell and a held cell
	#     must be distinguishable ON THE PICTURE, and the legend must follow the
	#     layer rather than the store: HELD is a subset of SURVEYED, so it may
	#     never appear without it and must appear with it exactly when this
	#     system holds one.
	#
	#     BOTH DIRECTIONS, THE CHART REMEMBERS' own discipline -- a legend that
	#     always said HELD would satisfy a one-sided check, and so would a chart
	#     that marked every surveyed cell as held.
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	var plain_cell := DeepSpace.cell_key(sid, 5, 0)
	var held_cell := DeepSpace.cell_key(sid, 6, 0)
	GameState.note_survey_worked(plain_cell)
	GameState.note_survey_worked(held_cell)
	GameState.note_survey_filed(plain_cell)
	var words_before := cp.legend_words(false, false)
	GameState.note_survey_held(held_cell)
	var words_after := cp.legend_words(false, false)
	var marks_ok: bool = GameState.is_survey_held(held_cell) \
		and not GameState.is_survey_held(plain_cell) \
		and GameState.is_survey_filed(plain_cell)
	var legend_ok: bool = not words_before.has("HELD") \
		and words_after.has("HELD") and words_after.has("SURVEYED")
	print("[plot] THE CHART IS TWO DOCUMENTS a counter-filed cell is not held=%s, a network cell is=%s; legend before %s, after %s -> %s" % [
		str(not GameState.is_survey_held(plain_cell)),
		str(GameState.is_survey_held(held_cell)),
		str(words_before), str(words_after),
		"PASS" if marks_ok and legend_ok else "FAIL"])

	# 9b2. AND ONE OF THEM IS NOT YOURS (v28, §115). BOTH HALVES, the posture
	#      ONLY THE SHELF MOVES WITH STANDING uses: a colleague's cell must read
	#      as held (or it silently loses its anchor and its ring) AND must read
	#      as a colleague's (or the third word bought nothing). The pilot's own
	#      cell is driven in the same breath as the control, because a store
	#      that answered "another hand" for everything would satisfy either
	#      clause alone.
	var other_cell := DeepSpace.cell_key(sid, 7, 0)
	GameState.note_survey_worked(other_cell)
	GameState.note_survey_held(other_cell, true)
	var words_other := cp.legend_words(false, false)
	var other_ok: bool = GameState.is_survey_held(other_cell) \
		and GameState.is_survey_held_by_another(other_cell) \
		and GameState.is_survey_held(held_cell) \
		and not GameState.is_survey_held_by_another(held_cell) \
		and not GameState.is_survey_held_by_another(plain_cell)
	# The legend answers to its own layer, never to HELD's: COLLEAGUE was absent
	# while only a self-filed cell stood, and both words stand together now.
	var other_legend: bool = not words_after.has("COLLEAGUE") \
		and words_other.has("COLLEAGUE") and words_other.has("HELD")
	print("[plot] A COLLEAGUE'S CELL IS HELD AND SAYS SO held=%s, by another=%s; your own cell is held and NOT another's=%s; legend %s -> %s" % [
		str(GameState.is_survey_held(other_cell)),
		str(GameState.is_survey_held_by_another(other_cell)),
		str(GameState.is_survey_held(held_cell)
			and not GameState.is_survey_held_by_another(held_cell)),
		str(words_other),
		"PASS" if other_ok and other_legend else "FAIL"])

	# 9b3. AND THE ANCHOR DOES NOT CARE WHOSE IT IS. §112 made a held cell a
	#      jump anchor and this commit must not quietly take that away from the
	#      cells that come home free -- anchor_rows reads is_survey_held, which
	#      is true for both words BY DESIGN, and this is the leg that says so
	#      rather than leaving it to be rediscovered.
	var tier_was := int(GameState.skills.get("filing", 0))
	GameState.skills["filing"] = GameState.SKILL_TIERS["filing"][
		GameState.FILING_ANCHOR_TIER]
	var anchor_keys := PackedStringArray()
	for r_v in anchor_rows(sid):
		anchor_keys.append(String((r_v as Dictionary)["label"]))
	GameState.skills["filing"] = tier_was
	var both_anchored: bool = anchor_keys.size() >= 2
	print("[plot] A COLLEAGUE'S CELL IS STILL AN ANCHOR at FILING t%d the rows are %s (both held cells, whoever filed them) -> %s" % [
		GameState.FILING_ANCHOR_TIER, str(anchor_keys),
		"PASS" if both_anchored else "FAIL"])

	# 9c. AND THE RIVAL READS DIFFERENTLY TO SOMEBODY WHO FILES. Copy, not
	#     mechanics: nothing about when the rival arrives moves. Driven on the
	#     derived flag, which is the only thing the two surfaces read.
	# Cleared to nothing-held first, so the OFF state is measured rather than
	# inherited from whatever the leg above left behind.
	GameState.survey_filed = {}
	var off_when_none := not GameState.files_with_the_network()
	# A COUNTER filing must not turn it on: the register is about where returns
	# went, and a cell sold at a port went to the Authority.
	GameState.note_survey_filed(plain_cell)
	var off_when_only_counter := not GameState.files_with_the_network()
	GameState.note_survey_held(held_cell)
	var on_when_held := GameState.files_with_the_network()
	print("[plot] A COLLEAGUE, NOT A STRANGER register off with nothing held=%s, still off with a counter filing=%s, on with one held cell=%s -> %s" % [
		str(off_when_none), str(off_when_only_counter), str(on_when_held),
		"PASS" if off_when_none and off_when_only_counter and on_when_held
			else "FAIL"])
	GameState.survey_coverage = {}
	GameState.survey_filed = {}

	# 10. THE PLOT IS CONTAINED. Godot does not scissor a CanvasItem's own draw
	#     calls to its rect; clip_contents defaults to false, and nothing else in
	#     this project sets it. So the band rings -- the band-4 ring is 183px in a
	#     rect 180px tall at the design resolution -- were painting across the
	#     detail line, the title and the system map in the DEFAULT view of the
	#     starting system. Every cull in the draw is a visibility heuristic and
	#     none of them can be containment, because _pan is unbounded and _zoom
	#     reaches 8. One property, so one assertion.
	print("[plot] THE PLOT IS CONTAINED clip_contents=%s, zoom ceiling %.1fx, pan unbounded -> %s" % [
		cp._plot.clip_contents, ChartPanel.ZOOM_MAX,
		"PASS" if cp._plot.clip_contents else "FAIL"])

	# 11. THE PLOT TAKES INPUT. It was MOUSE_FILTER_IGNORE, which is why it had no
	#    gestures -- and IGNORE would also drop a drag through to the sheet
	#    behind it. Cheap to assert and the thing every gesture above depends on.
	print("[plot] THE PLOT TAKES INPUT filter=%d (STOP=%d) -> %s" % [
		cp._plot.mouse_filter, Control.MOUSE_FILTER_STOP,
		"PASS" if cp._plot.mouse_filter == Control.MOUSE_FILTER_STOP else "FAIL"])

	# 12. THE PLOT STILL FITS ITS SHEET. The plot grew by 30px to carry rings, a
	#    legend and a bar, and the sheet cannot grow -- it is 0.55 of the screen
	#    by contract. Measured at the design resolution against the column's
	#    other minimums, with room kept for two colony rows, because a founded
	#    colony must not be what pushes WARP off the bottom.
	#     BOTH OF ITS NUMBERS WERE WRONG, in the direction that made it pass.
	#     `col` holds NINE children -- header, map, title, detail, plot, note,
	#     recall, colony rows, warp -- so a VBoxContainer inserts EIGHT 8px gaps,
	#     not seven. And a colony row is a Button at custom_minimum_size 42 with
	#     the container's own separation 4 between rows, so two rows are
	#     42 + 4 + 42 = 88px, not 68. Budgeting 7 gaps and 68px understated the
	#     column by 28px, which is precisely how a check whose stated purpose is
	#     "a founded colony must not push WARP off the sheet" reported PASS on a
	#     layout where two colonies do exactly that.
	#
	#     Read off ChartPanel's own constants where they exist rather than
	#     retyped, so the next change to a button height moves this with it. The
	#     four estimated rows -- header, title, detail, note -- have no
	#     custom_minimum_size and are font-derived, so they stay estimates and
	#     this stays a MODEL of the column; it is a model that now matches the
	#     code's own numbers everywhere the code states one.
	#
	#     AND THE ROW COUNT IS NO LONGER PART OF THE SUM, which is the point of
	#     this revision. Budgeting "two colony rows" was true when colonies were
	#     the only rows; beacon navigation put up to EIGHT beacon rows in the
	#     same container, so the column could be asked for ten -- 364px of
	#     content against 90px of spare -- while this printed PASS. The same
	#     failure as before, through a different door, one commit later.
	#
	#     So the container scrolls at a fixed viewport, and this asserts the
	#     property that makes that safe: the column's minimum height does not
	#     depend on how many rows exist. Measured by ADDING ROWS and requiring
	#     the minimum not to move -- a budget that merely had a big enough
	#     number would go stale the next time somebody put a row type in there.
	var sheet_h := UILayout.BASE.y * ChartPanel.SHEET_RATIO
	var fixed := 32.0 + 30.0 + ChartPanel.MAP_MIN_H + 20.0 + 30.0 \
		+ ChartPanel.PLOT_HEIGHT + 24.0 + ChartPanel.COLONY_ROW_H \
		+ ChartPanel.COLONY_ROW_H + ChartPanel.ROWS_VIEWPORT_H \
		+ ChartPanel.COL_SEP * 8.0
	var spare := sheet_h - fixed
	var before_min: float = cp._rows_scroll.get_combined_minimum_size().y
	for i in 10:
		var filler := Button.new()
		filler.custom_minimum_size = Vector2(0, ChartPanel.COLONY_ROW_H)
		cp._colony_rows.add_child(filler)
	await get_tree().process_frame
	var after_min: float = cp._rows_scroll.get_combined_minimum_size().y
	for c in cp._colony_rows.get_children():
		cp._colony_rows.remove_child(c)
		c.queue_free()
	var pinned := absf(after_min - before_min) < 1.0
	print("[plot] THE PLOT STILL FITS ITS SHEET sheet %.0fpx, minimums %.0fpx, spare %.0fpx; rows viewport %.0f -> %.0f after 10 rows (pinned=%s) -> %s" % [
		sheet_h, fixed, spare, before_min, after_min, str(pinned),
		"PASS" if spare >= 0.0 and pinned else "FAIL"])

	# 13. AND EVERY WINDOW FITS THE SHEET (v22, 88). Leg 12 models the PORTRAIT
	#     design size, which is why a landscape overflow lived through every
	#     sweep: on a wide, short window the 0.55 sheet is smaller than the
	#     column's minimums, the VBox refuses to shrink its children, and the
	#     overflow comes out of the bottom -- which is the WARP button, so the
	#     bug reads as "cannot travel". The sheet now grows UPWARD when the
	#     window is short. Asserted in both directions: landscape pulls the top
	#     anchor up and keeps WARP on screen; portrait remains exactly the
	#     0.55 it always was.
	get_window().size = Vector2i(2000, 1090)
	await get_tree().process_frame
	await get_tree().process_frame
	cp.open()
	# PAST THE SLIDE, not past a frame: open() animates the sheet up over
	# SLIDE_TIME by offsetting its position, so a rect read mid-slide sits
	# below where the sheet will rest and fails a correct layout.
	await get_tree().create_timer(ChartPanel.SLIDE_TIME + 0.15).timeout
	var land_top := cp._sheet.anchor_top
	var land_vh := cp._sheet.get_viewport_rect().size.y
	var warp_bottom := cp._travel_button.get_global_rect().end.y
	var grew_up: bool = land_top < 1.0 - ChartPanel.SHEET_RATIO - 0.001
	var warp_on: bool = warp_bottom <= land_vh + 1.0
	cp.close_panel()
	get_window().size = Vector2i(720, 1280)
	await get_tree().process_frame
	await get_tree().process_frame
	var portrait_back: bool = absf(cp._sheet.anchor_top - (1.0 - ChartPanel.SHEET_RATIO)) < 0.001
	print("[plot] AND EVERY WINDOW FITS THE SHEET landscape: top anchor %.3f (grew up=%s), WARP bottom %.0f of %.0f on-screen=%s; portrait restored to %.2f=%s -> %s" % [
		land_top, str(grew_up), warp_bottom, land_vh, str(warp_on),
		1.0 - ChartPanel.SHEET_RATIO, str(portrait_back),
		"PASS" if grew_up and warp_on and portrait_back else "FAIL"])

	get_tree().quit()

# --- the unsounded test ------------------------------------------------------

func _run_unsounded_test() -> void:
	# THE END OF THE MAP, asserted as the four promises it makes. That it is out
	# there at all (past the last band edge, one per system, and reachable only
	# by flying); that it is not a fight (no group a weapon or a scanner reads);
	# that the record is finite and sequential; and that what it says is what the
	# world does -- the wreck's "four hundred cells" is the player's own cap, and
	# a retune of one that left the other alone would make the game's most
	# load-bearing line of fiction into a lie.
	var kinds_ok := true
	for k_v in UnsoundedSite.FRAGMENTS:
		if not GameState.DEEP_LOG_KINDS.has(String(k_v)):
			kinds_ok = false
	for k2_v in GameState.DEEP_LOG_KINDS:
		if not UnsoundedSite.FRAGMENTS.has(String(k2_v)):
			kinds_ok = false

	# 1. EVERY FRAGMENT REACHABLE, AND THE RECORD IS FINITE. Walked one stage at
	#    a time through the real accessor, so an off-by-one in note_deep_log --
	#    the shape that would strand the last fragment forever, unreadable and
	#    unfindable in play -- is caught here rather than by a player who flew
	#    six thousand units for it.
	var frag_bad := ""
	for kind_v in UnsoundedSite.FRAGMENTS:
		var kind := String(kind_v)
		var frags: Array = UnsoundedSite.FRAGMENTS[kind]
		var probe := "pyx01:%s" % kind
		GameState.deep_logs.erase(probe)
		for want in range(1, frags.size() + 1):
			var got := GameState.note_deep_log(probe, frags.size())
			if got != want:
				frag_bad = "%s stage %d answered %d" % [kind, want, got]
				break
			if String(frags[want - 1]).strip_edges() == "":
				frag_bad = "%s fragment %d is empty" % [kind, want]
				break
		if frag_bad != "":
			break
		# And one past the end, which must refuse rather than advance: the
		# record has an end, and a fourteen-second hold at a finished archive
		# pays nothing (unsounded_site._read's own branch).
		if GameState.note_deep_log(probe, frags.size()) != frags.size():
			frag_bad = "%s advanced past its last fragment" % kind
		GameState.deep_logs.erase(probe)
		if frag_bad != "":
			break
	print("[unsound] EVERY FRAGMENT REACHABLE %d records, kinds match the save's list=%s: %s -> %s" % [
		UnsoundedSite.FRAGMENTS.size(), str(kinds_ok),
		"all stages reachable, none past the end" if frag_bad == "" else frag_bad,
		"PASS" if frag_bad == "" and kinds_ok else "FAIL"])

	# 2. THE WRECK QUOTES THE REAL CAP. The rival's log says four hundred cells
	#    because SURVEY_CELL_CAP is four hundred. Pinned in BOTH directions --
	#    the number in the store and the words in the log -- so retuning the cap
	#    without rewriting the line goes red instead of quietly making the
	#    game's strongest sentence false.
	var wreck_log := String((UnsoundedSite.FRAGMENTS["wreck"] as Array)[0])
	var cap_words := {400: "FOUR HUNDRED", 300: "THREE HUNDRED", 500: "FIVE HUNDRED"}
	var want_words := String(cap_words.get(GameState.SURVEY_CELL_CAP, "%d" % GameState.SURVEY_CELL_CAP))
	var quote_ok: bool = wreck_log.contains(want_words) and GameState.SURVEY_CELL_CAP == 400
	print("[unsound] THE WRECK QUOTES THE REAL CAP log says '%s', SURVEY_CELL_CAP is %d -> %s" % [
		want_words, GameState.SURVEY_CELL_CAP, "PASS" if quote_ok else "FAIL"])

	# 3. ONLY OUT THERE. Every authored record stands past the last band edge --
	#    5,200 units, which is past the 4,200 the jump reaches (§79), so the
	#    only way to one is the fifteen-minute outbound flight. The wreck is the
	#    single exception BY DESIGN: the rival died on the way out, so their
	#    hull sits in band 5 where a player who has never seen band 6 can find
	#    it. Asserted per kind rather than as a minimum, or the exception would
	#    let a mistake through.
	var depth_bad := ""
	for kind3_v in UnsoundedSite.DEPTHS:
		var kind3 := String(kind3_v)
		var d3 := float(UnsoundedSite.DEPTHS[kind3])
		var band3 := DeepSpace.band_of(d3)
		var want_band := 5 if kind3 == "wreck" else 6
		if band3 != want_band:
			depth_bad += "%s at %.0f is band %d (want %d) " % [kind3, d3, band3, want_band]
	var jump_ceiling := SystemDB.HYPER_DEPTH_MAX
	var past_the_jump := true
	for kind4_v in UnsoundedSite.DEPTHS:
		if String(kind4_v) == "wreck":
			continue
		if float(UnsoundedSite.DEPTHS[kind4_v]) <= jump_ceiling:
			past_the_jump = false
	print("[unsound] ONLY OUT THERE bands %s, all three archives past the %.0fu jump ceiling=%s -> %s" % [
		"correct" if depth_bad == "" else depth_bad, jump_ceiling, str(past_the_jump),
		"PASS" if depth_bad == "" and past_the_jump else "FAIL"])

	# 4. ONE PER SYSTEM, AND THE WRECK IS PYX-01'S ALONE. Read off the DATA, so
	#    authoring a second kind into a system fails here instead of building
	#    two archives beside each other.
	var author_bad := ""
	var wrecks := 0
	for sid_v in SystemDB.ids():
		var sid3 := String(sid_v)
		var k3 := SystemDB.unsounded_kind_of(sid3)
		if k3 == "" or not UnsoundedSite.FRAGMENTS.has(k3):
			author_bad += "%s authors '%s' " % [sid3, k3]
		if SystemDB.rival_wreck_in(sid3):
			wrecks += 1
			if sid3 != "pyx01":
				author_bad += "%s carries the wreck " % sid3
	print("[unsound] ONE PER SYSTEM %d systems each author a record: %s; wrecks in the game: %d -> %s" % [
		SystemDB.ids().size(), "yes" if author_bad == "" else author_bad, wrecks,
		"PASS" if author_bad == "" and wrecks == 1 else "FAIL"])

	# 5. IT IS NOT A FIGHT, AND NOTHING POINTS AT IT. The emptiness assertion
	#    the instruments already carry, for the same reason: the archive joins
	#    "unsounded" and NOTHING else. Not "hyper" (the harness casts that group
	#    to HyperStructure), not "crackable" (the radar would hang a permanent
	#    arrow on a thing whose whole design is that you find the depth, not the
	#    marker), and no combat group at all.
	_load_system("pyx01")
	set_deep_generation(false)
	await get_tree().physics_frame
	var sites: Array = get_tree().get_nodes_in_group("unsounded")
	var leak := ""
	for g in ["apex", "dockable", "crackable", "hostiles", "combatants", "mineable",
			"beacon", "hyper", "signature", "storm"]:
		for n_v in get_tree().get_nodes_in_group(g):
			if n_v is UnsoundedSite:
				leak += "%s " % g
	print("[unsound] IT IS NOT A FIGHT %d built in pyx01 (want 2: the archive and the wreck), leaked into: %s -> %s" % [
		sites.size(), leak if leak != "" else "none",
		"PASS" if sites.size() == 2 and leak == "" else "FAIL"])

	# 6. CLEAR OF THE STATION, and standing at its authored depth. The placement
	#    is a rolled bearing at a fixed radius with a reject loop against the
	#    cell's planned station -- the same keep-out every other deep spawner
	#    respects, checked here against the real plan rather than against the
	#    loop's own opinion of itself.
	var deep_node := deep_space
	var place_bad := ""
	for s_v in sites:
		var site := s_v as UnsoundedSite
		var want_depth := float(UnsoundedSite.DEPTHS[site.kind])
		var got_depth := deep_node.depth_at(site.global_position) if deep_node else -1.0
		if absf(got_depth - want_depth) > 1.0:
			place_bad += "%s at depth %.0f (want %.0f) " % [site.kind, got_depth, want_depth]
		if deep_node:
			var cell := DeepSpace.cell_of(site.global_position)
			var station: Dictionary = deep_node.plan_cell(cell.x, cell.y)["station"]
			var sp: Vector3 = station.get("pos", Vector3(1e9, 0.0, 1e9))
			if site.global_position.distance_to(sp) < DeepSpace.STATION_SAFE_RADIUS:
				place_bad += "%s stands %.0fu from a station " % [
					site.kind, site.global_position.distance_to(sp)]
	print("[unsound] CLEAR OF THE STATION %d sites at their authored depth and outside %.0fu of any planned station: %s -> %s" % [
		sites.size(), DeepSpace.STATION_SAFE_RADIUS,
		"yes" if place_bad == "" else place_bad,
		"PASS" if place_bad == "" and not sites.is_empty() else "FAIL"])

	# 7. THE HOLD PAYS AND THE PLATE SPEAKS. The whole verb end to end, on the
	#    real node: fly there, hold, and the record advances by one, two units
	#    of band-6 chart data arrive, and the fragment is on the broadcast plate
	#    where the bands announce themselves. Then the same hold against a FULL
	#    hold, which must defer rather than burn the stage -- the mast's guard,
	#    and the one that costs a player a fragment forever if it is missing.
	var arch: UnsoundedSite = null
	for s2_v in sites:
		var s2 := s2_v as UnsoundedSite
		if s2.kind != "wreck":
			arch = s2
			break
	var pilot := get_tree().get_first_node_in_group("player")
	var read_ok := false
	var plate := ""
	var defer_ok := false
	if arch != null and pilot != null:
		GameState.deep_logs.erase(arch.log_key())
		GameState.cargo = {}
		pilot.teleport_to(arch.global_position + Vector3(4.0, 0.0, 0.0))
		var rig := get_tree().get_first_node_in_group("camera_rig")
		if rig:
			rig.global_position = pilot.global_position + Vector3(0, 0, 2)
		await get_tree().create_timer(0.4).timeout
		arch.hold_begin()
		arch.hold_tick(UnsoundedSite.READ_TIME + 1.0)
		await get_tree().create_timer(0.4).timeout
		plate = hud.broadcast_text()
		read_ok = arch.stages_read() == 1 \
			and int(GameState.cargo.get("chart_unsounded", 0)) == UnsoundedSite.YIELD_UNITS \
			and plate.contains("YOUR POSITION IS DEFINED")
		# NOW FILL THE HOLD. Not by editing the store -- by loading real cargo,
		# so can_load answers the way it will answer in play. A ONE-SPACE good,
		# deliberately: quiet salvage takes three, so a hold filled with it can
		# be left with two units of slack that a one-space chart fits into, and
		# the fixture would be testing nothing.
		GameState.cargo = {}
		GameState.load_cargo("volatiles", GameState.cargo_free())
		var stage_before := arch.stages_read()
		arch.hold_begin()
		arch.hold_tick(UnsoundedSite.READ_TIME + 1.0)
		defer_ok = arch.stages_read() == stage_before \
			and not GameState.can_load("chart_unsounded", UnsoundedSite.YIELD_UNITS)
		GameState.cargo = {}
		GameState.deep_logs.erase(arch.log_key())
	print("[unsound] THE HOLD PAYS AND THE PLATE SPEAKS one hold -> stage 1, %d units of chart_unsounded, plate says '%s'=%s; on a full hold the stage did not move=%s -> %s" % [
		UnsoundedSite.YIELD_UNITS, plate.substr(0, 40), str(read_ok), str(defer_ok),
		"PASS" if read_ok and defer_ok else "FAIL"])

	get_tree().quit()
# --- directive 9 test --------------------------------------------------------

func _run_directive_test() -> void:
	# THE REVEAL, asserted as the three things that make it a slow burn rather
	# than a twist dropped in the player's lap: the authority's recordings never
	# change their words, the world waits for the WHOLE record before it answers,
	# and the private beat lands exactly on the order and nowhere else. The
	# fourth clause is the cheapest to break and the easiest to miss -- this
	# horizon claims to cost zero bytes, and a claim like that wants a check.
	var sid := GameState.current_system

	# A pure fixture: the store is the only input either flag reads, so every
	# state below is built by writing deep_logs directly and then asking the
	# accessors. Saving is locked (dispatch), so none of it reaches a file.
	var set_state := func(meridian: int, glass: int, ret: int) -> void:
		GameState.deep_logs = {}
		if meridian > 0:
			GameState.deep_logs["pyx01:meridian"] = meridian
		if glass > 0:
			GameState.deep_logs["pyx02:glass"] = glass
		if ret > 0:
			GameState.deep_logs["pyx03:return"] = ret

	# 1. THE MACHINES DO NOT KNOW. Bands 1-4 are an automated beacon, a relay, a
	#    degraded relay and a dead carrier, and THE LAST RETURN's own final entry
	#    says nobody told the machines. So the authority's text must be identical
	#    under every combination of the two flags, in every system, commissioned
	#    or not -- which also means the chart-edge beacon goes on telling a
	#    commissioned pilot the bearing is theirs and written down forever. That
	#    line is the horror; a "finished" table would delete it.
	var machine_bad := ""
	for band in range(1, 5):
		for sid_v in SystemDB.ids():
			for comm in [false, true]:
				var base: Dictionary = DeepSpace.broadcast_for(band, comm, String(sid_v), false)
				var after: Dictionary = DeepSpace.broadcast_for(band, comm, String(sid_v), true)
				if String(base.get("from", "")) != String(after.get("from", "")) \
						or String(base.get("body", "")) != String(after.get("body", "")):
					machine_bad += "band %d in %s (commissioned=%s) " % [band, sid_v, str(comm)]
	print("[directive] THE MACHINES DO NOT KNOW bands 1-4 across %d systems, commissioned and not: %s -> %s" % [
		SystemDB.ids().size(),
		"every recording says exactly what it always said" if machine_bad == ""
			else "CHANGED: " + machine_bad,
		"PASS" if machine_bad == "" else "FAIL"])

	# 2. THE WORLD WAITS FOR THE WHOLE RECORD. The staged reveal, and the leg
	#    that would have caught the version of this feature that lands the twist
	#    in the first hours: two archives finished and the third HALF read -- the
	#    pilot has the order itself and knows -- must still leave every voice out
	#    here saying what it always said. Only 3/3/3 changes anything.
	var early_bad := ""
	set_state.call(3, 3, 2)
	var knows_early := GameState.knows_directive_9()
	var whole_early := GameState.holds_whole_record()
	for band in [5, 6]:
		for sid_v in SystemDB.ids():
			var shipped: Dictionary = DeepSpace.broadcast_for(band, false, String(sid_v), false)
			var live: Dictionary = DeepSpace.broadcast_for(band, false, String(sid_v),
				GameState.holds_whole_record())
			if String(live.get("body", "")) != String(shipped.get("body", "")):
				early_bad += "band %d in %s " % [band, sid_v]
	print("[directive] THE WORLD WAITS FOR THE WHOLE RECORD at 3/3/2 the pilot knows=%s but holds the record=%s; bands 5-6 unchanged in every system: %s -> %s" % [
		str(knows_early), str(whole_early),
		"yes" if early_bad == "" else "NO: " + early_bad,
		"PASS" if knows_early and not whole_early and early_bad == "" else "FAIL"])

	# 3. AND THEN IT ANSWERS, IN EVERY SYSTEM. Two of the three systems replace
	#    one of these two bands with a line of their own -- pyx01 speaks band 6
	#    as a GSA repeater, pyx03 speaks band 5 as a sounding mark -- and BOTH OF
	#    THOSE ARE MACHINES, so the override correctly wins and those rows stay
	#    put. What must hold is that no system is left without a living voice:
	#    every one of them has at least one band out here that answers a pilot
	#    holding the whole record. Asserted per system, because a future override
	#    on the last living band in a system would silently delete the payoff
	#    there and nothing else would notice.
	set_state.call(3, 3, 3)
	var answers_in := {}
	var empty_after := ""
	for sid_v in SystemDB.ids():
		var sid2 := String(sid_v)
		answers_in[sid2] = 0
		for band in [5, 6]:
			var shipped2: Dictionary = DeepSpace.broadcast_for(band, false, sid2, false)
			var after2: Dictionary = DeepSpace.broadcast_for(band, false, sid2, true)
			if String(after2.get("body", "")) != String(shipped2.get("body", "")):
				answers_in[sid2] = int(answers_in[sid2]) + 1
				if String(after2.get("body", "")).strip_edges() == "" \
						or String(after2.get("from", "")).strip_edges() == "":
					empty_after += "band %d in %s " % [band, sid2]
	var silent_systems := ""
	for k_v in answers_in:
		if int(answers_in[k_v]) < 1:
			silent_systems += String(k_v) + " "
	print("[directive] EVERY SYSTEM KEEPS ONE LIVING VOICE answering bands per system %s; systems with none: %s; empty after-lines: %s -> %s" % [
		str(answers_in), "none" if silent_systems == "" else silent_systems,
		"none" if empty_after == "" else empty_after,
		"PASS" if silent_systems == "" and empty_after == "" and GameState.holds_whole_record()
			else "FAIL"])

	# 4. THE GATE IS THE ORDER. knows_directive_9 turns on fragment 2 of the
	#    bearing-terminus record and on nothing else: not on the first fragment,
	#    not on the other two archives however completely they are read. Driven
	#    by walking the real accessor, and the archive lengths are pinned against
	#    DEEP_LOG_STAGE_MAX in the same line -- an archive that grew a fourth
	#    fragment would make holds_whole_record permanently unreachable, which is
	#    a feature that silently stops existing.
	set_state.call(0, 0, 1)
	var off_at_one := not GameState.knows_directive_9()
	set_state.call(3, 3, 0)
	var off_without_order := not GameState.knows_directive_9()
	set_state.call(0, 0, 2)
	var on_at_two := GameState.knows_directive_9()
	set_state.call(0, 0, 3)
	var on_at_three := GameState.knows_directive_9()
	var lengths_ok := true
	for kind_v in GameState.ARCHIVE_KINDS:
		if (UnsoundedSite.FRAGMENTS.get(String(kind_v), []) as Array).size() \
				!= GameState.DEEP_LOG_STAGE_MAX:
			lengths_ok = false
	print("[directive] THE GATE IS THE ORDER off at fragment 1=%s, off with both other archives complete=%s, on at 2=%s and 3=%s; every archive is %d fragments=%s -> %s" % [
		str(off_at_one), str(off_without_order), str(on_at_two), str(on_at_three),
		GameState.DEEP_LOG_STAGE_MAX, str(lengths_ok),
		"PASS" if off_at_one and off_without_order and on_at_two and on_at_three
			and lengths_ok else "FAIL"])

	# 5. THE FIELD ARRIVES WITH THE ORDER. Rendered rather than reasoned about,
	#    GSATEST's own method: queue_freed rows are skipped, because _refresh
	#    frees the old body and builds the new one in the same frame and a naive
	#    child walk would read both. Before the order the page must carry no
	#    trace of the field -- an unexplained dash from the first dock would be
	#    the teaser this page refuses to be.
	var port_node: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		port_node = n as Port
		break
	var before_page := ""
	var after_page := ""
	var after_selling := ""
	if port_node != null:
		port_node.def = SystemDB.port_def_by_id("anchor").duplicate(true)
		port_node.def["services"] = PortPanel.TAB_LABELS.keys()
		port_panel.open_for(port_node)
		await get_tree().process_frame
		var render := func() -> String:
			port_panel._tab = "commission"
			port_panel._refresh()
			var out := ""
			for c in port_panel._body.get_children():
				if not c.is_queued_for_deletion() and c is Label:
					out += String((c as Label).text) + "\n"
			return out
		set_state.call(0, 0, 1)
		before_page = await render.call()
		set_state.call(0, 0, 2)
		after_page = await render.call()
		# AND IT IS A STATEMENT, NOT A COUNTER: filing more charts must not move
		# it. Driven through the real sale path, not by editing the ledger.
		GameState.cargo = {}
		GameState.load_cargo("chart_drift", 4)
		file_charts_on_sale("chart_drift", 4)
		after_selling = await render.call()
		port_panel.close_panel()
	var field_ok: bool = not before_page.contains("RECLASSIFIED VOLUME") \
		and after_page.contains("RETURNS LOGGED FROM THE RECLASSIFIED VOLUME: —") \
		and after_page.contains("RESURVEY 44") \
		and after_selling.contains("RETURNS LOGGED FROM THE RECLASSIFIED VOLUME: —")
	print("[directive] THE FIELD ARRIVES WITH THE ORDER absent before=%s, present after=%s, unmoved by four charts filed=%s -> %s" % [
		str(not before_page.contains("RECLASSIFIED VOLUME")),
		str(after_page.contains("RETURNS LOGGED FROM THE RECLASSIFIED VOLUME: —")),
		str(after_selling.contains("RETURNS LOGGED FROM THE RECLASSIFIED VOLUME: —")),
		"PASS" if field_ok else "FAIL"])

	# 6. NOTHING NEW IS STORED. The whole claim of this commit. Both flags are
	#    derived from the v23 store, so a save written by a pilot who has read
	#    the order must differ from one written before it in the deep_logs entry
	#    and NOWHERE ELSE -- not a flag, not a copy of the register, not a
	#    "seen" set. Compared key by key over the real serializer so a new field
	#    names itself instead of being guessed at.
	set_state.call(0, 0, 1)
	var before_dict := GameState.save_dict()
	set_state.call(0, 0, 2)
	var after_dict := GameState.save_dict()
	var moved: Array = []
	for k_v in after_dict:
		var k := String(k_v)
		if k == "deep_logs":
			continue
		if JSON.stringify(after_dict[k_v]) != JSON.stringify(before_dict.get(k_v)):
			moved.append(k)
	for k2_v in before_dict:
		if not after_dict.has(k2_v):
			moved.append("MISSING " + String(k2_v))
	print("[directive] NOTHING NEW IS STORED %d save keys, moved by reading the order (deep_logs aside): %s -> %s" % [
		after_dict.size(), str(moved) if not moved.is_empty() else "none",
		"PASS" if moved.is_empty() else "FAIL"])

	# 7. EVERY PAGE IS REACHABLE, AND NONE OF IT IS BLANK. The order is six
	#    pages found in no order across a whole frontier, so the failure that
	#    matters is a page nobody can ever draw -- an off-by-one in the modulo,
	#    or a hash that clumps. Swept over two thousand deep cells rather than
	#    reasoned about, and the spread is checked too: six pages that all came
	#    back as page 4 would satisfy "no page is unreachable" on a
	#    technicality.
	var seen_pages := {}
	for i in 2000:
		var pk := DeepSpace.cell_key("pyx02", i % 47 - 23, i / 47 - 21)
		var pg := Beacon.page_for(pk, 6)
		seen_pages[pg] = int(seen_pages.get(pg, 0)) + 1
	var missing := ""
	var thin := ""
	for want in range(1, Beacon.DIRECTIVE_PAGES.size() + 1):
		if not seen_pages.has(want):
			missing += "%d " % want
		elif int(seen_pages[want]) < 100:
			thin += "%d(%d) " % [want, int(seen_pages[want])]
	var blank := ""
	for i2 in range(Beacon.DIRECTIVE_PAGES.size()):
		var row: Dictionary = Beacon.DIRECTIVE_PAGES[i2]
		if String(row.get("clause", "")).strip_edges() == "" \
				or String(row.get("margin", "")).strip_edges() == "":
			blank += "%d " % (i2 + 1)
	var out_of_range: bool = seen_pages.has(0) \
		or seen_pages.has(Beacon.DIRECTIVE_PAGES.size() + 1)
	print("[directive] EVERY PAGE IS REACHABLE %d pages over 2000 deep cells, spread %s; never drawn: %s; thin: %s; blank halves: %s; out of range: %s -> %s" % [
		Beacon.DIRECTIVE_PAGES.size(), str(seen_pages),
		"none" if missing == "" else missing, "none" if thin == "" else thin,
		"none" if blank == "" else blank, str(out_of_range),
		"PASS" if missing == "" and thin == "" and blank == "" and not out_of_range
			else "FAIL"])

	# 8. THE PAGES KEEP TO THE DEEP. The pacing gate, and the leg that would
	#    have caught the first draft of this feature: foreign beacons stand
	#    wherever the rival has filed, which starts at 24 units out, so an
	#    ungated page puts the order's own text at the chart edge in a new
	#    pilot's first hours. Every band swept, not a sample. Red-verify by
	#    dropping the band clause from Beacon.page_for.
	var shallow_leak := ""
	var deep_dry := ""
	for band in range(0, DeepSpace.BAND_NAMES.size()):
		for i3 in 300:
			var k3 := DeepSpace.cell_key("pyx01", i3 - 150, i3 * 3 % 91 - 45)
			var got3 := Beacon.page_for(k3, band)
			if band < Beacon.PAGE_MIN_BAND and got3 != 0:
				shallow_leak += "band %d " % band
				break
			if band >= Beacon.PAGE_MIN_BAND and got3 == 0:
				deep_dry += "band %d " % band
				break
	print("[directive] THE PAGES KEEP TO THE DEEP nothing at bands 0-%d: %s; a page at every band %d and deeper: %s -> %s" % [
		Beacon.PAGE_MIN_BAND - 1, "confirmed" if shallow_leak == "" else shallow_leak,
		Beacon.PAGE_MIN_BAND, "confirmed" if deep_dry == "" else deep_dry,
		"PASS" if shallow_leak == "" and deep_dry == "" else "FAIL"])

	# 9. THE PAGE LEAVES NOTHING BEHIND, AND IS STILL NOT YOURS. The covenant,
	#    end to end on a real node: reading pays nothing, stores nothing, and
	#    does not quietly become the recovery it sits beside. The mast must
	#    still be standing afterwards -- a page that vanished on reading would
	#    be a collectible rather than something somebody left for whoever came
	#    through next.
	var pb := Beacon.new()
	pb.foreign = true
	pb.system_id = system_id
	pb.page = 2
	add_child(pb)
	var pilot2 := get_tree().get_first_node_in_group("player")
	if pilot2:
		pb.global_position = pilot2.global_position + Vector3(2.0, 0.0, 0.0)
	await get_tree().process_frame
	var save_before := JSON.stringify(GameState.save_dict())
	var stock_before := GameState.beacon_stock_left()
	var cargo_before := GameState.cargo_used()
	var salvage_before := GameState.salvage
	pb.hold_begin()
	pb.hold_tick(Beacon.READ_TIME + 1.0)
	# THE AFTER-IMAGE IS TAKEN IN THE SAME FRAME AS THE READ, and the first
	# version of this leg was not -- it waited 0.4s for the plate to fade in
	# first, and came back red because `played_seconds += delta` is in the save
	# dict and four hundred milliseconds of it had gone by. The save had moved;
	# reading had not moved it. What this leg means is that the ACT stored
	# nothing, so the two images have to bracket the act and nothing else. The
	# plate wait belongs after them.
	var save_after := JSON.stringify(GameState.save_dict())
	await get_tree().create_timer(0.4).timeout
	var plate := hud.broadcast_text()
	var read_ok: bool = plate.contains("RETURNS WENT IN THE BIN") \
		and save_after == save_before \
		and GameState.beacon_stock_left() == stock_before \
		and GameState.cargo_used() == cargo_before \
		and GameState.salvage == salvage_before \
		and GameState.beacons.is_empty() \
		and is_instance_valid(pb)
	print("[directive] THE PAGE LEAVES NOTHING BEHIND plate carries page 2=%s; save/stock/cargo/salvage unmoved=%s/%s/%s/%s; store empty=%s; the mast still stands=%s -> %s" % [
		str(plate.contains("RETURNS WENT IN THE BIN")),
		str(save_after == save_before),
		str(GameState.beacon_stock_left() == stock_before),
		str(GameState.cargo_used() == cargo_before),
		str(GameState.salvage == salvage_before),
		str(GameState.beacons.is_empty()), str(is_instance_valid(pb)),
		"PASS" if read_ok else "FAIL"])
	pb.queue_free()

	GameState.deep_logs = {}
	get_tree().quit()

# --- berth test --------------------------------------------------------------

func _run_berth_test() -> void:
	# THE BERTHS, asserted as the four promises that make them a trade rather
	# than a strict upgrade: a locked slot holds nothing by any route, every
	# slot the enum knows about actually reaches the stats, the mass is real and
	# permanent, and the power arrives with the slot rather than after it.
	# 1. A LOCKED SLOT HOLDS NOTHING, BY EITHER DOOR. can_equip is the door the
	#    console uses; the LOADER is the other one, and a hand-edited save is
	#    exactly the sort of thing that walks through it. Both are checked,
	#    because a berth refused in the UI and granted by a file is not refused.
	GameState.berths = []
	GameState.owned.append("util_assay")
	var refused_ui := not GameState.can_equip(ModuleDB.Slot.UTILITY_C, "util_assay")
	GameState.fit[ModuleDB.Slot.UTILITY_C] = "util_assay"
	var forced := GameState.save_dict()
	GameState.fit.erase(ModuleDB.Slot.UTILITY_C)
	# Through the real loader, which is the thing under test.
	var probe_path := "user://berthtest_probe.json"
	var real_path := GameState.save_path
	var fp := FileAccess.open(probe_path, FileAccess.WRITE)
	fp.store_string(JSON.stringify(forced))
	fp.close()
	GameState.save_path = probe_path
	GameState.load_game()
	GameState.save_path = real_path
	var refused_file := String(GameState.fit.get(ModuleDB.Slot.UTILITY_C, "")) == ""
	DirAccess.remove_absolute(ProjectSettings.globalize_path(probe_path))
	print("[berth] A LOCKED SLOT HOLDS NOTHING refused by can_equip=%s, and a save that names it anyway loads empty=%s -> %s" % [
		str(refused_ui), str(refused_file),
		"PASS" if refused_ui and refused_file else "FAIL"])

	# 2. EVERY SLOT REACHES THE STATS. The trap this commit was written around:
	#    compute_stats carried two hand-written slot lists, so a slot added to
	#    the enum and forgotten there would be purchasable, equippable, POWERED
	#    -- and would contribute nothing at all, silently. Now derived from
	#    SLOT_CATEGORY, and proved by fitting the same module in every slot of
	#    its category and requiring the stats to move each time. Red-verify by
	#    dropping a category from slots_of.
	GameState.berths = ModuleDB.BERTHS.keys()
	GameState.owned.append("util_shield_2")
	var dead_slots := ""
	for slot_v in ModuleDB.SLOT_CATEGORY:
		var cat := String(ModuleDB.SLOT_CATEGORY[slot_v])
		if cat != "utility":
			continue
		var bare := ModuleDB.compute_stats(ModuleDB.STARTER_FIT)
		var probe := ModuleDB.STARTER_FIT.duplicate()
		probe[int(slot_v)] = "util_shield_2"
		var with_it := ModuleDB.compute_stats(probe)
		if float(with_it.get("shield_max", 0.0)) <= float(bare.get("shield_max", 0.0)):
			dead_slots += "%s " % String(ModuleDB.SLOT_NAMES[slot_v])
	print("[berth] EVERY SLOT REACHES THE STATS %d utility slots, silent ones: %s -> %s" % [
		ModuleDB.slots_of("utility").size(), dead_slots if dead_slots != "" else "none",
		"PASS" if dead_slots == "" and ModuleDB.slots_of("utility").size() >= 3 else "FAIL"])

	# 3. THE MASS IS REAL, AND IT IS NOT A MODULE. A berth is welded on: the
	#    speed it costs cannot be recovered by unfitting anything, which is the
	#    whole reason it is a trade. Measured on the same fit, berthed and not.
	var bare_speed := float(ModuleDB.compute_stats(ModuleDB.STARTER_FIT).get("max_speed", 0.0))
	var berthed_speed := float(ModuleDB.compute_stats(ModuleDB.STARTER_FIT,
		ModuleDB.BERTHS.keys()).get("max_speed", 0.0))
	var empty_fit := {}
	var stripped := float(ModuleDB.compute_stats(empty_fit,
		ModuleDB.BERTHS.keys()).get("max_speed", 0.0))
	var bare_stripped := float(ModuleDB.compute_stats(empty_fit).get("max_speed", 0.0))
	var mass_ok: bool = berthed_speed < bare_speed \
		and is_equal_approx(bare_speed - berthed_speed, ModuleDB.berth_mass(ModuleDB.BERTHS.keys())) \
		and stripped < bare_stripped
	print("[berth] THE MASS IS REAL %.2f speed bare, %.2f fully berthed (cost %.2f); still down with every module pulled=%s -> %s" % [
		bare_speed, berthed_speed, ModuleDB.berth_mass(ModuleDB.BERTHS.keys()),
		str(stripped < bare_stripped), "PASS" if mass_ok else "FAIL"])

	# 4. THE POWER ARRIVES WITH THE SLOT. The research finding this whole commit
	#    exists because of: a slot sold without power is a bay the reactor
	#    cannot feed. So each berth must bring enough to run something -- more
	#    than the cheapest module of its own category -- while still adding less
	#    than the BEST one, which is what keeps all-best out of reach (asserted
	#    in full by FRONTIERTEST).
	var cheapest := {}
	for id_v in ModuleDB.MODULES:
		var m: Dictionary = ModuleDB.get_module(String(id_v))
		var c := String(m.get("category", ""))
		var pw := int(m.get("power", 0))
		if not cheapest.has(c) or pw < int(cheapest[c]):
			cheapest[c] = pw
	var starved := ""
	var generous := ""
	for bid_v in ModuleDB.BERTHS:
		var berth: Dictionary = ModuleDB.BERTHS[bid_v]
		var cat2 := String(ModuleDB.SLOT_CATEGORY[int(berth["slot"])])
		var best := 0
		for id2_v in ModuleDB.MODULES:
			var m2: Dictionary = ModuleDB.get_module(String(id2_v))
			if String(m2.get("category", "")) == cat2:
				best = maxi(best, int(m2.get("power", 0)))
		if int(berth["power"]) < int(cheapest.get(cat2, 0)):
			starved += "%s " % String(bid_v)
		if int(berth["power"]) >= best:
			generous += "%s " % String(bid_v)
	print("[berth] THE POWER ARRIVES WITH THE SLOT %d berths, none too starved to run anything: %s; none rich enough to pay for the best in its class: %s -> %s" % [
		ModuleDB.BERTHS.size(), "confirmed" if starved == "" else starved,
		"confirmed" if generous == "" else generous,
		"PASS" if starved == "" and generous == "" else "FAIL"])

	# 5. BOUGHT ONCE, AND THE CAP MOVES WITH IT. Driven through the real verb:
	#    a pilot who cannot afford it is refused, one who can is charged exactly
	#    once, and a second purchase of the same berth is refused rather than
	#    charged again.
	GameState.berths = []
	GameState.salvage = 0
	var broke_refused := not GameState.can_buy_berth("berth_utility")
	GameState.salvage = 1000000
	var cap_before := GameState.power_cap()
	var slots_before := GameState.open_slots().size()
	var bought := GameState.buy_berth("berth_utility")
	var paid := 1000000 - GameState.salvage
	var twice := GameState.buy_berth("berth_utility")
	var cap_after := GameState.power_cap()
	print("[berth] BOUGHT ONCE broke=%s refused; bought=%s for %d (want %d); a second purchase refused=%s; slots %d -> %d, power cap %d -> %d -> %s" % [
		str(broke_refused), str(bought), paid, GameState.berth_price("berth_utility"),
		str(not twice), slots_before, GameState.open_slots().size(),
		cap_before, cap_after,
		"PASS" if broke_refused and bought and not twice
			and paid == GameState.berth_price("berth_utility")
			and GameState.open_slots().size() == slots_before + 1
			and cap_after == cap_before + int(ModuleDB.BERTHS["berth_utility"]["power"])
			else "FAIL"])

	# 6. AND THE YARD IS AT THE FAR END. A berth is bought where the Mk V is
	#    bought and nowhere else -- the deep counters that name a reactor cap --
	#    so a first windfall at the Waypoint Anchor cannot buy a third hardpoint.
	var chart_sells := ""
	for pid_v in SystemDB.port_ids():
		var pdef := SystemDB.port_def_by_id(String(pid_v))
		if int(pdef.get("reactor_cap", ModuleDB.REACTOR_CAP_DEFAULT)) >= ModuleDB.BERTH_YARD_TIER:
			chart_sells += "%s " % String(pid_v)
	var deep_sells := 0
	for i in range(DeepPortDB.count()):
		var adef: Dictionary = DeepPortDB.ARCHETYPES[i]
		if int(adef.get("reactor_cap", ModuleDB.REACTOR_CAP_DEFAULT)) >= ModuleDB.BERTH_YARD_TIER:
			deep_sells += 1
	print("[berth] THE YARD IS AT THE FAR END charted counters selling berths: %s; deep archetypes that do: %d -> %s" % [
		chart_sells if chart_sells != "" else "none", deep_sells,
		"PASS" if chart_sells == "" and deep_sells >= 1 else "FAIL"])

	GameState.berths = []
	GameState.fit = ModuleDB.STARTER_FIT.duplicate()
	get_tree().quit()


# --- the filed return test ---------------------------------------------------

func _run_return_test() -> void:
	# THE VERB THE LAST FRAGMENT ASKS FOR, asserted as the five promises it
	# makes: it is gated on hearing the ask, it pays nothing at all, the goods
	# are its limit, held survives a save, and the rival's cells come home free.
	var sid := GameState.current_system

	var arm := func(stage: int) -> void:
		GameState.deep_logs = {}
		if stage > 0:
			GameState.deep_logs["pyx03:return"] = stage

	# 1. THE ASK IS THE GATE. heard_the_request turns on the LAST fragment of
	#    the bearing-terminus record and nothing earlier -- knowing the order
	#    was given (stage 2, §92's gate) is not being asked to answer it.
	arm.call(1)
	var off_1 := not GameState.heard_the_request()
	arm.call(2)
	var off_2 := not GameState.heard_the_request() and GameState.knows_directive_9()
	arm.call(3)
	var on_3 := GameState.heard_the_request()
	# AND THE VERB IS ACTUALLY GATED ON IT. The flag's truth table is not the
	# feature: the only enforcement point is Beacon._can_file, so a leg that
	# checked the accessor alone would stay green with the gate deleted from the
	# beacon entirely. Driven on a real node.
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	GameState.cargo = {}
	var gate_cell := DeepSpace.cell_key(sid, 3, 0)
	GameState.note_survey_worked(gate_cell)
	GameState.load_cargo("chart_drift", SurveyMast.YIELD_UNITS)
	var gb := Beacon.new()
	gb.foreign = true
	gb.system_id = sid
	gb.page = 1
	add_child(gb)
	await get_tree().process_frame
	arm.call(2)
	var node_off := not gb._can_file()
	arm.call(3)
	var node_on := gb._can_file()
	gb.queue_free()
	print("[return] THE ASK IS THE GATE off at fragment 1=%s, still off at 2 while the order IS known=%s, on at 3=%s; and the mast itself refuses the verb until the ask=%s then offers it=%s -> %s" % [
		str(off_1), str(off_2), str(on_3), str(node_off), str(node_on),
		"PASS" if off_1 and off_2 and on_3 and node_off and node_on else "FAIL"])

	# 2. THE GOODS ARE THE LIMIT. A hold of two units of one band files exactly
	#    one cell of that band and nothing else, however much coverage the pilot
	#    is carrying -- unfiled_cells() spans every system and can hold a
	#    thousand keys, so without the join the two halves drift apart silently.
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	GameState.cargo = {}
	var band2 := ""
	var band3 := ""
	for cx in range(1, 400):
		var k := DeepSpace.cell_key(sid, cx, 0)
		var b := cell_band_of_key(k)
		if b == 2 and band2 == "":
			band2 = k
		elif b == 3 and band3 == "":
			band3 = k
		if band2 != "" and band3 != "":
			break
	# FOUR band-2 cells against ONE reading, so the budget is BINDING. With a
	# single candidate the `taken >= readings` guard is never reached and the leg
	# measures only the band join -- it would stay green with the whole reading
	# budget deleted, which is half the rule it is named for.
	var band2_all: Array = []
	for cx in range(1, 400):
		var k := DeepSpace.cell_key(sid, cx, 0)
		if cell_band_of_key(k) == 2:
			band2_all.append(k)
		if band2_all.size() >= 4:
			break
	for k_v in band2_all:
		GameState.note_survey_worked(String(k_v))
	GameState.note_survey_worked(band3)
	# Two units is exactly one reading, and the good IS the band.
	GameState.load_cargo("chart_drift", SurveyMast.YIELD_UNITS)
	var plan := network_filing_plan()
	var only_matching: bool = (plan["cells"] as Array).size() == 1 \
		and cell_band_of_key(String((plan["cells"] as Array)[0])) == 2
	band2 = String((plan["cells"] as Array)[0]) if only_matching else band2
	print("[return] THE GOODS ARE THE LIMIT %d band-2 cells surveyed and 1 band-3, one reading held: plan files %d (band-2 only=%s) -> %s" % [
		band2_all.size(), (plan["cells"] as Array).size(), str(only_matching),
		"PASS" if only_matching and band2_all.size() >= 4 else "FAIL"])

	# 3. IT PAYS NOTHING. The whole design in one leg, driven through the real
	#    verb: the wallet, the ledger, the Commission's own counter and GSA
	#    standing must all be byte-identical across a filing, and the goods must
	#    be gone. A single number moving here would make the network a worse
	#    counter instead of a different act.
	var salv_before := GameState.salvage
	var ledger_before := JSON.stringify(GameState.ledger)
	var gsa_before := GameState.faction_attitude(FactionDB.SURVEYOR, "gsa")
	var cargo_before := GameState.cargo_used()
	var filed := file_charts_with_network()
	var paid_nothing: bool = GameState.salvage == salv_before \
		and JSON.stringify(GameState.ledger) == ledger_before \
		and GameState.faction_attitude(FactionDB.SURVEYOR, "gsa") == gsa_before \
		and GameState.cargo_used() == cargo_before - SurveyMast.YIELD_UNITS \
		and GameState.is_survey_held(band2) \
		and not GameState.is_survey_held(band3)
	print("[return] IT PAYS NOTHING filed %d cell; salvage %d->%d, ledger unmoved=%s, GSA standing unmoved=%s, goods gone=%s; the band-3 cell is untouched=%s -> %s" % [
		filed, salv_before, GameState.salvage,
		str(JSON.stringify(GameState.ledger) == ledger_before),
		str(GameState.faction_attitude(FactionDB.SURVEYOR, "gsa") == gsa_before),
		str(GameState.cargo_used() == cargo_before - SurveyMast.YIELD_UNITS),
		str(not GameState.is_survey_held(band3)),
		"PASS" if filed == 1 and paid_nothing else "FAIL"])

	# 4. HELD SURVIVES THE FILE, and this is the one the loader would have
	#    eaten. _load_survey_filed wrote the literal `true` for two versions and
	#    discarded whatever the file held -- harmless while true was the only
	#    value that existed, and silently fatal the moment a cell can be HELD:
	#    right all session, wrong forever after, with nothing dropped and no
	#    error. Driven through the real serializer and the real loader.
	var probe := "user://returntest_probe.json"
	var real_path := GameState.save_path
	var dict := GameState.save_dict()
	var f := FileAccess.open(probe, FileAccess.WRITE)
	f.store_string(JSON.stringify(dict))
	f.close()
	GameState.save_path = probe
	GameState.load_game()
	GameState.save_path = real_path
	var survived: bool = GameState.is_survey_held(band2) \
		and GameState.is_survey_filed(band2)
	# AND A COUNTER FILING IS STILL A COUNTER FILING after the round trip: a
	# loader that promoted everything would pass the clause above.
	GameState.note_survey_filed(band3)
	var dict2 := GameState.save_dict()
	var f2 := FileAccess.open(probe, FileAccess.WRITE)
	f2.store_string(JSON.stringify(dict2))
	f2.close()
	GameState.save_path = probe
	GameState.load_game()
	GameState.save_path = real_path
	var not_promoted: bool = GameState.is_survey_filed(band3) \
		and not GameState.is_survey_held(band3)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(probe))
	print("[return] HELD SURVIVES THE FILE a network cell reloads held=%s; a counter cell reloads filed and NOT held=%s -> %s" % [
		str(survived), str(not_promoted),
		"PASS" if survived and not_promoted else "FAIL"])

	# 5. HELD IS STILL A SUBSET, AND THE CAP STILL TAKES IT. §17's bound is not
	#    suspended for a cell the network holds -- an exemption would be exactly
	#    the second unbounded store the cap exists to refuse, and it would make
	#    the wreck's four-hundred-cell log false.
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	for i in range(GameState.SURVEY_CELL_CAP + 12):
		var k2 := DeepSpace.cell_key(sid, 900 + i, 7)
		GameState.note_survey_worked(k2)
		GameState.note_survey_held(k2)
	var capped: bool = GameState.survey_coverage.size() == GameState.SURVEY_CELL_CAP
	var subset := true
	for k_v in GameState.survey_filed:
		if not GameState.survey_coverage.has(String(k_v)):
			subset = false
	# AND THE SURVIVORS ARE STILL HELD. Both original clauses were satisfied by
	# an EMPTY filed store -- the subset loop is vacuously true over nothing and
	# a size check only bounds from above -- so a cap that wiped every held mark
	# on the four-hundred-and-first cell would have printed PASS. The equality
	# is what makes the leg refuse that: every surviving coverage key was held,
	# so filed must have exactly as many entries as coverage does.
	var still_held := GameState.held_cells().size()
	print("[return] THE CAP TAKES HELD CELLS TOO %d worked and held, coverage settled at %d (cap %d)=%s, filed still a subset=%s, and %d of them are STILL HELD=%s -> %s" % [
		GameState.SURVEY_CELL_CAP + 12, GameState.survey_coverage.size(),
		GameState.SURVEY_CELL_CAP, str(capped), str(subset), still_held,
		str(still_held == GameState.SURVEY_CELL_CAP),
		"PASS" if capped and subset and still_held == GameState.SURVEY_CELL_CAP
			and GameState.survey_filed.size() == GameState.SURVEY_CELL_CAP
			else "FAIL"])

	# 6. THE MARKS ARE OUT THERE AND THEY ARE BOUNDED. The generator commit 2
	#    builds buoys from, swept here because a placement rule at nine thousand
	#    units cannot be checked by flying to it. Deterministic, capped, past
	#    every archive, and separated.
	var det := true
	var too_close := ""
	var out_of_window := ""
	var total := 0
	for sid_v in SystemDB.ids():
		var s2 := String(sid_v)
		var a := FarMarks.positions(s2, GameState.run_seed)
		var b2 := FarMarks.positions(s2, GameState.run_seed)
		if str(a) != str(b2):
			det = false
		total += a.size()
		var bounds := SystemDB.bounds_of(s2)
		for i in range(a.size()):
			var d := (a[i] as Vector3).length() - bounds
			if d < FarMarks.DEPTH_MIN - 1.0 or d > FarMarks.DEPTH_MAX + 1.0:
				out_of_window += "%s:%d " % [s2, i]
			for j in range(i + 1, a.size()):
				if (a[i] as Vector3).distance_to(a[j] as Vector3) < FarMarks.MIN_SEPARATION:
					too_close += "%s:%d/%d " % [s2, i, j]
	var deepest_archive := 0.0
	for k3_v in UnsoundedSite.DEPTHS:
		deepest_archive = maxf(deepest_archive, float(UnsoundedSite.DEPTHS[k3_v]))
	print("[return] THE MARKS ARE BOUNDED %d marks over %d systems (cap %d each), deterministic=%s, all inside [%.0f,%.0f]: %s, separated: %s; past the deepest archive (%.0f)=%s -> %s" % [
		total, SystemDB.ids().size(), FarMarks.PER_SYSTEM, str(det),
		FarMarks.DEPTH_MIN, FarMarks.DEPTH_MAX,
		"yes" if out_of_window == "" else out_of_window,
		"yes" if too_close == "" else too_close, deepest_archive,
		str(FarMarks.DEPTH_MIN > deepest_archive),
		"PASS" if det and out_of_window == "" and too_close == ""
			and total == FarMarks.PER_SYSTEM * SystemDB.ids().size()
			and FarMarks.DEPTH_MIN > deepest_archive else "FAIL"])

	# 7. A SINGULAR LEGEND IS SINGULAR. The rule that makes a legend worth
	#    telling somebody about, and the one a rejection-test implementation
	#    would fail open on. Swept over many seeds rather than one, because
	#    "at most once" is a claim about every run, not about this one.
	var dupes := ""
	var seen_kinds := {}
	for seed_i in 60:
		var plan_r := FarMarks.run_plan(seed_i * 7919 + 13, SystemDB.ids())
		var count := {}
		for k4_v in plan_r:
			var kind := String(plan_r[k4_v])
			count[kind] = int(count.get(kind, 0)) + 1
			seen_kinds[kind] = true
		for kind_v in FarMarks.SINGULAR:
			if int(count.get(String(kind_v), 0)) > 1:
				dupes += "%s x%d " % [String(kind_v), int(count[kind_v])]
	var every_kind_reachable := true
	for kind2_v in FarMarks.kinds():
		if not seen_kinds.has(String(kind2_v)):
			every_kind_reachable = false
	# AND A RUN MUST MISS SOME. This clause is the one the adversarial pass was
	# filed about, and neither of the two above could have caught what it found:
	# with fifteen slots against seven singular kinds the deal handed EVERY run
	# all seven, so "at most once per run" was trivially true and "all kinds
	# reachable" was trivially true, while the pacing rule the whole class
	# exists for -- a run that has no serpent in it is a normal run -- was false
	# on every seed. Two green assertions over a dead design.
	var carried_all := 0
	var omissions := {}
	for seed_j in 60:
		var plan_o := FarMarks.run_plan(seed_j * 7919 + 13, SystemDB.ids())
		var here := {}
		for k5_v in plan_o:
			here[String(plan_o[k5_v])] = true
		var missing := 0
		for kind3_v in FarMarks.SINGULAR:
			if not here.has(String(kind3_v)):
				missing += 1
				omissions[String(kind3_v)] = true
		if missing == 0:
			carried_all += 1
	var varies: bool = carried_all == 0 \
		and omissions.size() >= FarMarks.SINGULAR.size() - FarMarks.SINGULAR_PER_RUN
	print("[return] A SINGULAR LEGEND IS SINGULAR 60 seeds: appearing twice in one run: %s; all %d kinds reachable across seeds=%s; runs carrying ALL %d singulars: %d (want 0), distinct kinds a run can miss: %d -> %s" % [
		"none" if dupes == "" else dupes, FarMarks.kinds().size(),
		str(every_kind_reachable), FarMarks.SINGULAR.size(), carried_all,
		omissions.size(),
		"PASS" if dupes == "" and every_kind_reachable and varies else "FAIL"])

	# 8. THE RIVAL'S CELLS COME HOME FREE, and this path was DEAD to the harness
	#    until this leg: reset_to_starter leaves played_seconds at 0, the suite
	#    runs synchronously so no frame advances it, and Rival.filed is false for
	#    every cell at t=0 (arrival is never below BASE_S). So the sweep branch
	#    ran in play and never once under test -- which is exactly where the
	#    counting bug lived: a filing made up ENTIRELY of rival-reached cells
	#    moves them all to held, queues a save, and used to report zero, so the
	#    mast announced "NOTHING NEW TO FILE" for an irreversible act that had
	#    just happened. Routine, not exotic: the rival takes the shallows inside
	#    a couple of hours of play.
	var t_save := GameState.played_seconds
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	GameState.cargo = {}
	GameState.played_seconds = 400000.0
	var rival_cells: Array = []
	for cx in range(1, 400):
		var k5 := DeepSpace.cell_key(sid, cx, 0)
		if cell_band_of_key(k5) != 2:
			continue
		if not Rival.filed(k5, cell_depth_of_key(k5), GameState.run_seed,
				GameState.played_seconds):
			continue
		rival_cells.append(k5)
		if rival_cells.size() >= 3:
			break
	for k6_v in rival_cells:
		GameState.note_survey_worked(String(k6_v))
	GameState.load_cargo("chart_drift", SurveyMast.YIELD_UNITS)
	var cargo_r := GameState.cargo_used()
	var salv_r := GameState.salvage
	var reported := file_charts_with_network()
	var all_held := true
	for k7_v in rival_cells:
		if not GameState.is_survey_held(String(k7_v)):
			all_held = false
	var free_ok: bool = not rival_cells.is_empty() \
		and all_held and reported == rival_cells.size() \
		and GameState.cargo_used() == cargo_r \
		and GameState.salvage == salv_r
	GameState.played_seconds = t_save
	print("[return] THE RIVAL'S CELLS COME HOME FREE %d cells the rival reached first: all held=%s, the verb reported %d (not 0), no reading spent (cargo %d->%d) and no pay -> %s" % [
		rival_cells.size(), str(all_held), reported, cargo_r,
		GameState.cargo_used(), "PASS" if free_ok else "FAIL"])

	# 9. THE MARKS STAND WHERE THE GENERATOR SAYS. Leg 6 proves the arithmetic;
	#    this proves the WORLD agrees with it. Driven on pyx01 by name rather
	#    than on current_system, because the fingerprint clause below is compared
	#    against a constant recorded over pyx01's cells.
	_load_system("pyx01")
	set_deep_generation(false)
	await get_tree().physics_frame
	var msid := "pyx01"
	var nominal := FarMarks.positions(msid, GameState.run_seed)
	var plan_m := FarMarks.run_plan(GameState.run_seed, SystemDB.ids())
	var max_arc := 0.0
	for a_v in SystemBuilder.MARK_ARCS:
		max_arc = maxf(max_arc, absf(float(a_v)))
	var seen_idx := {}
	var kind_bad := ""
	var drift_bad := ""
	var station_bad := ""
	for n_v in get_tree().get_nodes_in_group("farmark"):
		var m := n_v as SoundingMark
		if m == null or m.system_id != msid:
			continue
		seen_idx[m.index] = true
		if m.index < 0 or m.index >= nominal.size():
			drift_bad += "%d(no such mark) " % m.index
			continue
		if m.kind != String(plan_m.get("%s:%d" % [msid, m.index], "")):
			kind_bad += "%d " % m.index
		# THE NUDGE IS BOUNDED BY THE LIST THE BUILDER READS, not by a literal
		# repeated here. The offset is an arc and this is a chord, so the chord
		# can only be shorter -- an over-budget drift means the buoy is not the
		# mark the channel quotes.
		var nom: Vector3 = nominal[m.index]
		var drift := m.global_position.distance_to(nom)
		if drift > max_arc + 1.0:
			drift_bad += "%d(%.0fu) " % [m.index, drift]
		if not SystemBuilder._clear_of_stations(deep_space, m.global_position):
			# NOT AUTOMATICALLY A DEFECT, and asserting otherwise would be a
			# flake waiting for a seed: _mark_pos is allowed to give up and stand
			# where it was told when every candidate is blocked. What must never
			# happen is giving up while a clear candidate existed, so that is
			# what this asks.
			var radius := Vector2(nom.x, nom.z).length()
			var base := atan2(nom.z, nom.x)
			var could := false
			for a2_v in SystemBuilder.MARK_ARCS:
				var ang := base + float(a2_v) / radius
				if SystemBuilder._clear_of_stations(deep_space,
						Vector3(cos(ang), 0.0, sin(ang)) * radius):
					could = true
			if could:
				station_bad += "%d " % m.index
	# NOTHING POINTS AT THEM, COLONYTEST's own clause: no radar tier and no
	# scanned group, which this far out is the difference between an expedition
	# and an arrow.
	var mark_leak := ""
	for g in ["apex", "dockable", "crackable", "hostiles", "mineable", "beacon",
			"signature", "hyper", "unsounded"]:
		for l_v in get_tree().get_nodes_in_group(g):
			if l_v is SoundingMark:
				mark_leak += "%s " % g
	# AND THE BUILD MOVED NO DRAW. _mark_pos reads plan_cell, which is pure --
	# but "pure" is a claim about a function, and this is the measurement.
	var fp_marks := _world_fingerprint()
	print("[return] THE MARKS STAND WHERE THE GENERATOR SAYS %d/%d built in %s, kinds off plan: %s, drift over %.0fu: %s, avoidably inside a station keep-out: %s, leaked into scanned groups: %s; world fingerprint %s vs %s -> %s" % [
		seen_idx.size(), FarMarks.PER_SYSTEM, msid,
		"none" if kind_bad == "" else kind_bad, max_arc,
		"none" if drift_bad == "" else drift_bad,
		"none" if station_bad == "" else station_bad,
		"none" if mark_leak == "" else mark_leak,
		fp_marks, WORLD_FINGERPRINT_BEFORE_SEAMS,
		"PASS" if seen_idx.size() == FarMarks.PER_SYSTEM and kind_bad == ""
			and drift_bad == "" and station_bad == "" and mark_leak == ""
			and fp_marks == WORLD_FINGERPRINT_BEFORE_SEAMS else "FAIL"])

	# 10. A MARK IS THE NETWORK'S TO READ. The read/unread split, driven through
	#     the REAL ladder and the REAL hold in both directions -- because the
	#     gate is not the feature, the affordance is, and 96 spent two horizons
	#     with a fully wired Beacon.on_tapped that no finger could reach.
	#
	#     On a probe rather than on one of the five built above, for PICK
	#     PRECEDENCE's own reason: _pick is screen-space with no raycast, and a
	#     camera parked six thousand units out unprojects everything behind it
	#     onto the same half of the screen. The probe is the same class running
	#     the same code, and leg 9 is what proves the real ones are in the group.
	var probe_at := Vector3(300.0, 0.0, 300.0)
	var mark_probe := SoundingMark.new()
	mark_probe.system_id = msid
	mark_probe.index = 0
	mark_probe.kind = "vein"
	system_root.add_child(mark_probe)
	mark_probe.global_position = probe_at
	var pilot_m: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig_m := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	var ladder_ok := false
	var refused := false
	var offered := false
	var read_ok := false
	var stayed_shut := false
	if pilot_m != null and rig_m != null:
		pilot_m.teleport_to(probe_at)
		rig_m.leash_enabled = false
		rig_m.global_position = probe_at + Vector3(0.0, 0.0, 2.0)
		await get_tree().process_frame
		await get_tree().process_frame
		var cam_m := get_viewport().get_camera_3d()
		var at_px := cam_m.unproject_position(mark_probe.pick_anchor())
		ladder_ok = rig_m._pick(at_px, "farmark") == mark_probe
		# --- a pilot who has never filed ---
		GameState.survey_coverage = {}
		GameState.survey_filed = {}
		GameState.marks_seen = {}
		hud.clear_prompt()
		var tapped_a := rig_m._select(at_px)
		# THE PROMPT FADES IN OVER 0.2s and prompt_text() is gated on alpha, so
		# reading it on the same frame reads an empty string -- the trap
		# COLONYTEST documents.
		await get_tree().create_timer(0.4).timeout
		refused = tapped_a and hud.prompt_text() == SoundingMark.CANNOT_READ
		# PARKED AGAIN BEFORE EACH HOLD. Four tenths of a second of physics
		# passed while the prompt faded in, and READ_RANGE is twelve units --
		# a hold that failed because the ship drifted would read exactly like a
		# hold that was refused, which is the wrong thing for this leg to be
		# measuring.
		pilot_m.teleport_to(probe_at)
		mark_probe.hold_begin()
		mark_probe.hold_tick(SoundingMark.READ_TIME * 2.0)
		stayed_shut = not mark_probe.is_read()
		# --- and the same pilot one filing later ---
		var held_cell := DeepSpace.cell_key(msid, 4, 0)
		GameState.note_survey_worked(held_cell)
		GameState.note_survey_held(held_cell)
		hud.clear_prompt()
		var tapped_b := rig_m._select(at_px)
		await get_tree().create_timer(0.4).timeout
		offered = tapped_b and hud.prompt_text().contains("HOLD TO READ")
		pilot_m.teleport_to(probe_at)
		mark_probe.hold_begin()
		mark_probe.hold_tick(SoundingMark.READ_TIME + 0.1)
		read_ok = mark_probe.is_read() \
			and String(GameState.marks_seen.get(mark_probe.mark_key(), "")) == GameState.MARK_READ
		rig_m.leash_enabled = true
	mark_probe.queue_free()
	print("[return] A MARK IS THE NETWORK'S TO READ the tap ladder reaches it=%s; unfiled: refused in its own words=%s and the hold left it unread=%s; filed: the tap offers the verb=%s and the hold resolved it=%s -> %s" % [
		str(ladder_ok), str(refused), str(stayed_shut), str(offered), str(read_ok),
		"PASS" if ladder_ok and refused and stayed_shut and offered and read_ok
			else "FAIL"])

	# 11. THE CHANNEL NAMES A MARK YOU HAVE NOT READ. The store's whole job at
	#     the far end: commit 0 shipped nearest_unseen taking an empty dictionary
	#     because nothing could be seen yet, and a wiring that passed {} forever
	#     would keep quoting the same buoy after the pilot had stood on it.
	GameState.marks_seen = {}
	var from_m := Vector3.ZERO
	var first_m := FarMarks.nearest_unseen(msid, GameState.run_seed, from_m,
		GameState.marks_read())
	var named_one := not first_m.is_empty()
	GameState.note_mark_read(GameState.mark_key(msid, int(first_m.get("index", -1))))
	var second_m := FarMarks.nearest_unseen(msid, GameState.run_seed, from_m,
		GameState.marks_read())
	var moved_on: bool = not second_m.is_empty() \
		and int(second_m["index"]) != int(first_m.get("index", -1))
	for i in range(nominal.size()):
		GameState.note_mark_read(GameState.mark_key(msid, i))
	var exhausted: bool = FarMarks.nearest_unseen(msid, GameState.run_seed, from_m,
		GameState.marks_read()).is_empty()
	# AND THE STORE SURVIVES THE FILE, with its VALUE. The rubbish pass is the
	# half that matters: this store's value is a STATE, so a loader that coerced
	# with bool() -- the correct line for its sibling one function up -- would
	# write 7 and "nonsense" back as marks in a vocabulary that has one word.
	var dirty_marks := {}
	dirty_marks[GameState.mark_key(msid, 0)] = GameState.MARK_READ    # good
	dirty_marks[GameState.mark_key(msid, 999)] = GameState.MARK_READ  # no such mark
	dirty_marks["nowhere:0"] = GameState.MARK_READ                    # no such system
	dirty_marks[GameState.mark_key(msid, 1)] = true                   # not a state
	dirty_marks[GameState.mark_key(msid, 2)] = "nonsense"             # nor is this
	GameState.marks_seen = dirty_marks
	var probe_path := "user://returntest_marks.json"
	var real_path_m := GameState.save_path
	var fm := FileAccess.open(probe_path, FileAccess.WRITE)
	fm.store_string(JSON.stringify(GameState.save_dict()))
	fm.close()
	GameState.save_path = probe_path
	GameState.load_game()
	GameState.save_path = real_path_m
	DirAccess.remove_absolute(ProjectSettings.globalize_path(probe_path))
	var kept_m: bool = GameState.marks_seen.size() == 1 \
		and GameState.is_mark_read(GameState.mark_key(msid, 0)) \
		and String(GameState.marks_seen.get(GameState.mark_key(msid, 0), "")) == GameState.MARK_READ
	print("[return] THE CHANNEL NAMES A MARK YOU HAVE NOT READ it names one=%s, reading it moves the answer on=%s, reading all %d leaves nothing to name=%s; the store reloads 1 of 5 (an index past the generator, an unknown system and two impostor values dropped, the state preserved)=%s -> %s" % [
		str(named_one), str(moved_on), nominal.size(), str(exhausted), str(kept_m),
		"PASS" if named_one and moved_on and exhausted and kept_m else "FAIL"])

	# 12. A PROTOTYPE IS NOT FOR SALE. The prototype line is the crafted block's
	#     mechanism with a different door, so it inherits the crafted block's
	#     guarantee: absence from every stock list, asserted rather than priced.
	#     A zero price is not the protection -- GameState.buy() would SUCCEED at
	#     price 0 -- which is why the racks are what this walks.
	var protos := ModuleDB.prototype_ids()
	var top_shipped := 0
	for id_v in ModuleDB.MODULES:
		var mm: Dictionary = ModuleDB.MODULES[id_v]
		if bool(mm.get("prototype", false)):
			continue
		top_shipped = maxi(top_shipped, int(mm.get("tier", 0)))
	var priced := ""
	var not_above := ""
	var free_lunch := ""
	for pid_v in protos:
		var pid := String(pid_v)
		var pm := ModuleDB.get_module(pid)
		if int(pm.get("price", 0)) != 0:
			priced += pid + " "
		if int(pm.get("tier", 0)) != ModuleDB.PROTOTYPE_TIER \
				or int(pm.get("tier", 0)) <= top_shipped:
			not_above += pid + " "
		# THE LAW, NOT THE NUMBERS. "Nothing in the catalogue is a straight
		# upgrade" is a rule the horizon document says a legendary does not get
		# an exemption from, and this is the forge's EVERY RECIPE COSTS applied
		# one tier up. The values in the table are provisional and this clause
		# does not care what they are -- only that each entry pays somewhere.
		var downs := 0
		for k_v in (pm.get("stats", {}) as Dictionary):
			if float((pm["stats"] as Dictionary)[k_v]) < 0.0:
				downs += 1
		# §100. OVERDRAW IS A COST, spelled as a positive number because it is a
		# price paid per shot rather than a stat made worse -- the weapon
		# prototype's whole mechanism. Without this clause the Overdrawn Lance
		# reads as only-upside to a loop that can only see minus signs.
		if float((pm.get("stats", {}) as Dictionary).get("overdraw", 0.0)) > 0.0:
			downs += 1
		if downs == 0:
			free_lunch += pid + " "
	var racks := 0
	var for_sale := ""
	for port_v in SystemDB.port_ids():
		racks += 1
		for sid2_v in SystemDB.port_def_by_id(String(port_v)).get("stock", []):
			if protos.has(String(sid2_v)):
				for_sale += "%s@%s " % [String(sid2_v), String(port_v)]
	for dp_v in DeepPortDB.ids():
		racks += 1
		for sid3_v in DeepPortDB.by_id(String(dp_v)).get("stock", []):
			if protos.has(String(sid3_v)):
				for_sale += "%s@%s " % [String(sid3_v), String(dp_v)]
	# AND §94'S LAW RE-DERIVED WITH THE NEW TIER IN THE CATALOGUE, which the
	# horizon document asks for by name: if a prototype closed the power margin,
	# the prototype would be wrong. Greedy best-per-slot over the shipped hull's
	# slots, measured from the live catalog exactly as FRONTIERTEST does it --
	# that leg is the enforcement, this clause is the horizon checking its own
	# work before handing it over.
	var best_by_cat := {}
	for id2_v in ModuleDB.MODULES:
		var m2: Dictionary = ModuleDB.get_module(String(id2_v))
		var cat := String(m2.get("category", ""))
		best_by_cat[cat] = maxi(int(best_by_cat.get(cat, 0)), int(m2.get("power", 0)))
	var berth_slot_ids := {}
	for b2_v in ModuleDB.BERTHS:
		berth_slot_ids[int((ModuleDB.BERTHS[b2_v] as Dictionary)["slot"])] = true
	var greedy_all := 0
	for slot2_v in ModuleDB.SLOT_CATEGORY:
		if berth_slot_ids.has(int(slot2_v)):
			continue
		greedy_all += int(best_by_cat.get(String(ModuleDB.SLOT_CATEGORY[slot2_v]), 0))
	var top_reactor := ModuleDB.reactor_power(ModuleDB.REACTOR_TIERS.size() - 1)
	print("[return] A PROTOTYPE IS NOT FOR SALE %d prototypes at tier %d (top shipped tier %d); on a rack: %s (%d racks walked), priced: %s, only-upside: %s, wrong tier: %s; all-best with the new tier draws %d against the top reactor's %d -> %s" % [
		protos.size(), ModuleDB.PROTOTYPE_TIER, top_shipped,
		"none" if for_sale == "" else for_sale, racks,
		"none" if priced == "" else priced,
		"none" if free_lunch == "" else free_lunch,
		"none" if not_above == "" else not_above,
		greedy_all, top_reactor,
		"PASS" if not protos.is_empty() and for_sale == "" and priced == ""
			and free_lunch == "" and not_above == "" and greedy_all > top_reactor
			else "FAIL"])

	# 13. THE DRIFT STANDS WHERE THE MARK IS READ. The encounter machinery all
	#     nine legends share, proved on the one that exists: reading resolves the
	#     mark AND raises what the plate describes, without waiting for a warp.
	#     Driven through the real hold on a real node, so it covers _read ->
	#     legend_arrives -> build_legend rather than the builder alone.
	GameState.marks_seen = {}
	GameState.owned.clear()
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	var cell_d := DeepSpace.cell_key(msid, 5, 0)
	GameState.note_survey_worked(cell_d)
	GameState.note_survey_held(cell_d)
	var drift_key := GameState.mark_key(msid, 0)
	var drift_at := Vector3(600.0, 0.0, 600.0)
	var dprobe := SoundingMark.new()
	dprobe.system_id = msid
	dprobe.index = 0
	dprobe.kind = "drift"
	system_root.add_child(dprobe)
	dprobe.global_position = drift_at
	await get_tree().process_frame
	# NOTHING STANDS THERE BEFORE THE READING, and this half matters as much as
	# the other: a legend that built for every mark on load would make reading
	# decorative.
	var before_read := SystemBuilder.build_legend(system_root, msid, 0, "drift", drift_at)
	if pilot_m != null:
		pilot_m.teleport_to(drift_at)
	dprobe.hold_begin()
	dprobe.hold_tick(SoundingMark.READ_TIME + 0.1)
	var workshop: Derelict = null
	for c_v in system_root.get_children():
		var dd := c_v as Derelict
		if dd != null and dd.owns_mark == drift_key:
			workshop = dd
	var stood := workshop != null
	var carried := false
	var determined := false
	if stood:
		carried = ModuleDB.exists(workshop.prototype)
		determined = workshop.prototype == FarMarks.drift_prototype(msid, 0,
			GameState.run_seed, ModuleDB.prototype_ids())
	print("[return] THE DRIFT STANDS WHERE THE MARK IS READ nothing before the reading=%s; the hold raised a workshop=%s carrying a real module=%s (%s), the same one the generator names=%s -> %s" % [
		str(before_read == null), str(stood), str(carried),
		workshop.prototype if stood else "-", str(determined),
		"PASS" if before_read == null and stood and carried and determined
			else "FAIL"])

	# 14. THE WORKSHOP PAYS ONCE. What a breach hands over, and what the SECOND
	#     drift says -- the proving drift is a COMMON kind and may repeat in a
	#     run, so two benches dealing the same pattern is routine. A hull that
	#     quietly handed over nothing would read as a bug in the one place the
	#     fiction is most specific.
	var paid := false
	var spent := false
	var still_read := false
	var stayed_down := false
	var second_refused := false
	var second_spent := false
	if stood:
		var proto_id := workshop.prototype
		workshop.force_breach()
		paid = GameState.owns(proto_id)
		spent = GameState.is_mark_spent(drift_key)
		# STILL READ, and this is the clause the state design was for: a spent
		# mark is still a mark this pilot has read, so the channel keeps skipping
		# it and the plate keeps reading.
		still_read = GameState.is_mark_read(drift_key)
		stayed_down = SystemBuilder.build_legend(system_root, msid, 0, "drift",
			drift_at) == null
		# The second bench, forced onto the same pattern rather than waited for.
		var key2 := GameState.mark_key(msid, 1)
		GameState.marks_seen[key2] = GameState.MARK_READ
		var drift2 := SystemBuilder.build_legend(system_root, msid, 1, "drift",
			drift_at + Vector3(0.0, 0.0, 120.0)) as Derelict
		if drift2 != null:
			drift2.prototype = proto_id
			drift2.force_breach()
			second_refused = GameState.owned.count(proto_id) == 1
			second_spent = GameState.is_mark_spent(key2)
			drift2.queue_free()
	dprobe.queue_free()
	if workshop != null:
		workshop.queue_free()
	print("[return] THE WORKSHOP PAYS ONCE the breach handed over the prototype=%s, the mark is spent=%s and still reads as read=%s, and it does not come back on a rebuild=%s; a second bench on the same pattern grants no duplicate=%s and still spends its own mark=%s -> %s" % [
		str(paid), str(spent), str(still_read), str(stayed_down),
		str(second_refused), str(second_spent),
		"PASS" if paid and spent and still_read and stayed_down
			and second_refused and second_spent else "FAIL"])

	# 15. THE MOUNT DRAWS THROUGH THE BUS. §100's mechanism, driven through the
	#     REAL fire loop rather than by calling a cost function -- the cost is
	#     paid in _fire at the moment the shot is committed, and a leg that
	#     invoked it directly would stay green with the payment unwired. Both
	#     halves: the shot costs exactly `overdraw`, and the floor holds -- the
	#     coil can strip the bus to zero and never past it.
	var od_stats: Dictionary = ModuleDB.get_module("proto_lance").get("stats", {})
	var od := float(od_stats.get("overdraw", 0.0))
	GameState.owned.append("proto_lance")
	var fit_was := GameState.fit.duplicate()
	# THROUGH THE REAL EQUIP, which enforces the power budget -- and the budget
	# would refuse this on the starter reactor (8 - 2 + 7 = 13 against Mk I's
	# 12), leaving the old weapon firing and the drain reading zero. The tier is
	# raised for the leg and restored after; `worn` is asserted so a future
	# budget change reads as a named failure here rather than as a zero.
	var tier_was := GameState.reactor_tier
	GameState.reactor_tier = ModuleDB.REACTOR_TIERS.size() - 1
	var worn := GameState.equip(ModuleDB.Slot.WEAPON_A, "proto_lance")
	var od_target := Hostile.new()
	od_target.difficulty = 0.5
	system_root.add_child(od_target)
	var shot_cost := 0.0
	var floored := false
	var alive_after := false
	if pilot_m != null:
		od_target.global_position = pilot_m.global_position + Vector3(6.0, 0.0, 0.0)
		pilot_m.attack_target = od_target
		for w_v in pilot_m._weapons:
			(w_v as Dictionary)["cooldown"] = 0.0
		pilot_m.shield = pilot_m.shield_max
		var shield_before: float = pilot_m.shield
		pilot_m._fire(0.016)
		# EXACTLY the overdraw, though two mounts fired: WEAPON_B carries no
		# overdraw key, so a drain that scaled with mounts rather than with the
		# key would come out double and go red here.
		shot_cost = shield_before - pilot_m.shield
		# The floor. A bus already below one shot's draw empties and stops:
		# maxf, not a subtraction the next regen tick has to rescue.
		pilot_m.shield = od * 0.4
		for w2_v in pilot_m._weapons:
			(w2_v as Dictionary)["cooldown"] = 0.0
		pilot_m._fire(0.016)
		floored = pilot_m.shield == 0.0
		alive_after = not pilot_m.is_dying() if pilot_m.has_method("is_dying") else true
		pilot_m.attack_target = null
	od_target.queue_free()
	GameState.fit = fit_was
	GameState.reactor_tier = tier_was
	GameState._recompute()
	print("[return] THE MOUNT DRAWS THROUGH THE BUS equipped through the real budget=%s; one volley through the real fire loop cost %.1f shield (want exactly %.1f, though two mounts fired); a bus below one draw floors at 0.0=%s with the ship alive=%s -> %s" % [
		str(worn), shot_cost, od, str(floored), str(alive_after),
		"PASS" if worn and od > 0.0 and absf(shot_cost - od) < 0.01 and floored
			and alive_after else "FAIL"])

	# 16. THE VEIN KEEPS ITS PROMISE. The plate says richer than anything on the
	#     charted side, and the promise is arithmetic before it is fiction: the
	#     seam must beat the deepest ROLLED seam on units, carry the RICHEST
	#     band-6 good (deterministically -- a roll that could land on the cheap
	#     entry makes the plate a liar one time in four), pay through the real
	#     cut, and then be GONE forever: a windfall that rebuilds is an income.
	var vein_key := GameState.mark_key(msid, 2)
	GameState.marks_seen = {}
	GameState.marks_seen[vein_key] = GameState.MARK_READ
	GameState.cargo = {}
	var vein_at := Vector3(700.0, 0.0, 700.0)
	var seam := SystemBuilder.build_legend(system_root, msid, 2, "vein", vein_at) as MineableSeam
	var vein_stood := seam != null
	var vein_rich := false
	var vein_good_best := false
	var vein_paid := false
	var vein_spent := false
	var vein_gone := false
	if vein_stood:
		var richest := String(CommodityDB.seam_yields(6)[0])
		for vg_v in CommodityDB.seam_yields(6):
			if CommodityDB.base_price(String(vg_v)) > CommodityDB.base_price(richest):
				richest = String(vg_v)
		vein_rich = seam.band == 6 and seam.units > int(DeepSpace.SEAM_UNITS[6])
		vein_good_best = seam.good == richest
		seam._complete()
		vein_paid = GameState.cargo_count(seam.good) == SystemBuilder.VEIN_UNITS \
			and seam.mined
		vein_spent = GameState.is_mark_spent(vein_key)
		vein_gone = SystemBuilder.build_legend(system_root, msid, 2, "vein",
			vein_at) == null
		seam.queue_free()
	print("[return] THE VEIN KEEPS ITS PROMISE stands when read=%s, band 6 and richer than any rolled seam=%s, carries the richest band-6 good=%s; the cut paid %d units=%s, spent the mark=%s, and the vein is GONE on rebuild=%s -> %s" % [
		str(vein_stood), str(vein_rich), str(vein_good_best),
		SystemBuilder.VEIN_UNITS, str(vein_paid), str(vein_spent), str(vein_gone),
		"PASS" if vein_stood and vein_rich and vein_good_best and vein_paid
			and vein_spent and vein_gone else "FAIL"])

	# 17. THE CACHE IS TWO-WAY. The layup against the drift is the asymmetry
	#     that proves the per-kind spent check: a spent drift is GONE, a spent
	#     layup is an OPEN CACHE, standing on every rebuild for the only purely
	#     expressive verb in the game. Both directions of the arrangement are
	#     driven on the real node -- the withdrawal through force_breach, the
	#     deposit through the real hold -- and the no-books rule is asserted as
	#     an equality of save images, not assumed: two deposits of different
	#     cargo must leave BYTE-IDENTICAL saves, because the only thing either
	#     one may record is the single fact the first one already wrote.
	var lay_key := GameState.mark_key(msid, 3)
	GameState.marks_seen[lay_key] = GameState.MARK_READ
	GameState.cargo = {}
	var lay_at := Vector3(800.0, 0.0, 800.0)
	var cache := SystemBuilder.build_legend(system_root, msid, 3, "layup", lay_at) as Derelict
	var lay_stood: bool = cache != null and not cache.is_cracked()
	var lay_spent := false
	var lay_stands_open := false
	var refused_empty := false
	var deposit_took := false
	var plate_clause := false
	var no_tally := false
	if cache != null:
		await get_tree().process_frame
		cache.force_breach()
		lay_spent = GameState.is_mark_spent(lay_key) \
			and GameState.is_mark_read(lay_key)
		_clear_loot_cubes()
		cache.queue_free()
		# THE ASYMMETRY: rebuilt spent, the layup still stands -- open.
		var cache2 := SystemBuilder.build_legend(system_root, msid, 3, "layup",
			lay_at) as Derelict
		if cache2 != null:
			await get_tree().process_frame
			lay_stands_open = cache2.is_cracked()
			# An empty hold is refused with words, not silence.
			cache2.hold_begin()
			refused_empty = not cache2._holding
			# The deposit, through the real hold.
			GameState.load_cargo("alloys", 5)
			if pilot_m != null:
				pilot_m.teleport_to(cache2.breach_point)
			cache2.hold_begin()
			cache2.hold_tick(Derelict.DEPOSIT_TIME + 0.1)
			deposit_took = GameState.cargo_used() == 0 \
				and GameState.is_mark_given(lay_key) \
				and String(GameState.marks_seen.get(lay_key, "")) == GameState.MARK_CLOSED
			# S1: the plate carries one clause now, and only the layup's does.
			var mark_probe2 := SoundingMark.new()
			mark_probe2.system_id = msid
			mark_probe2.index = 3
			mark_probe2.kind = "layup"
			plate_clause = mark_probe2.plate().contains("AND BY YOU")
			mark_probe2.free()
			# NO BOOKS. A second, different deposit must change NOTHING in the
			# file: same state word, same everything. Byte-equality over the
			# whole save is the strongest form of "the arrangement keeps no
			# records" this harness can ask for.
			var img_one := JSON.stringify(GameState.save_dict())
			GameState.load_cargo("chart_drift", 2)
			cache2.hold_begin()
			cache2.hold_tick(Derelict.DEPOSIT_TIME + 0.1)
			var img_two := JSON.stringify(GameState.save_dict())
			no_tally = GameState.cargo_used() == 0 and img_one == img_two
			cache2.queue_free()
	print("[return] THE CACHE IS TWO-WAY stands unopened when read=%s; the withdrawal spends the mark (still read)=%s; rebuilt SPENT it still stands, open=%s; an empty hold is refused=%s; the deposit empties the hold and closes the mark=%s; the plate gains its clause=%s; a second deposit leaves a byte-identical save (no books)=%s -> %s" % [
		str(lay_stood), str(lay_spent), str(lay_stands_open), str(refused_empty),
		str(deposit_took), str(plate_clause), str(no_tally),
		"PASS" if lay_stood and lay_spent and lay_stands_open and refused_empty
			and deposit_took and plate_clause and no_tally else "FAIL"])

	# 18. THE GROUND BECALMS, AND PAYS ONCE. The no-combat legend, all four
	#     promises: entering stops the drives (through the real becalm, with the
	#     command verb asserted refused, not just a flag read), the reading pays
	#     ONCE and defers on a full hold rather than burning, the place keeps
	#     becalming forever after it has paid, and NOTHING here is hostile --
	#     the strangest fact in the encounter, asserted as a group emptiness.
	var still_key := GameState.mark_key(msid, 4)
	GameState.marks_seen = {}
	GameState.marks_seen[still_key] = GameState.MARK_READ
	var hostiles_pre_g := get_tree().get_nodes_in_group("hostiles").size()
	var ground := SystemBuilder.build_legend(system_root, msid, 4, "stillness",
		Vector3(1200.0, 0.0, 1200.0)) as StillnessGround
	var ground_stood := ground != null
	var ground_neutral: bool = 		get_tree().get_nodes_in_group("hostiles").size() == hostiles_pre_g
	var becalmed_held := false
	var move_refused := false
	var deferred_full := false
	var released := false
	var paid_once := false
	var still_becalms := false
	var pays_never_again := false
	var ground_outlives := false
	if ground_stood and pilot_m != null:
		# Full hold first: the reading must DEFER, not burn.
		GameState.cargo = {}
		GameState.load_cargo("alloys", 9999)
		ground._begin_passage()
		becalmed_held = pilot_m.is_becalmed()
		pilot_m.command_move(Vector3(999.0, 0.0, 999.0))
		move_refused = not pilot_m.has_move_target
		ground._finish_passage()
		deferred_full = not GameState.is_mark_spent(still_key) \
			and GameState.cargo_count(StillnessGround.READING_GOOD) == 0
		released = not pilot_m.is_becalmed()
		# Room made: the next passage pays, once.
		GameState.cargo = {}
		ground._begin_passage()
		ground._finish_passage()
		paid_once = GameState.cargo_count(StillnessGround.READING_GOOD) \
			== StillnessGround.READING_UNITS and GameState.is_mark_spent(still_key)
		# And the place stays what it is: a third passage still becalms and
		# pays nothing more.
		ground._begin_passage()
		still_becalms = pilot_m.is_becalmed()
		ground._finish_passage()
		pays_never_again = GameState.cargo_count(StillnessGround.READING_GOOD) \
			== StillnessGround.READING_UNITS
		# Spent, the ground still BUILDS -- the layup's posture, not the
		# drift's: the reading is once, the becalming is forever.
		var ground2 := SystemBuilder.build_legend(system_root, msid, 4,
			"stillness", Vector3(1200.0, 0.0, 1200.0))
		ground_outlives = ground2 != null
		if ground2 != null:
			ground2.queue_free()
		pilot_m.clear_becalm()
		ground.queue_free()
	print("[return] THE GROUND BECALMS AND PAYS ONCE stands when read=%s, spawns nothing hostile=%s; the passage stops the drives=%s and refuses the move verb=%s; a full hold DEFERS the reading=%s and the drives return=%s; with room it pays %d once=%s; the third passage still becalms=%s and pays nothing=%s; spent, the ground still stands=%s -> %s" % [
		str(ground_stood), str(ground_neutral), str(becalmed_held),
		str(move_refused), str(deferred_full), str(released),
		StillnessGround.READING_UNITS, str(paid_once), str(still_becalms),
		str(pays_never_again), str(ground_outlives),
		"PASS" if ground_stood and ground_neutral and becalmed_held
			and move_refused and deferred_full and released and paid_once
			and still_becalms and pays_never_again and ground_outlives
			else "FAIL"])

	# 19. THE ORDER HAILS BEFORE IT FIRES. R4's politeness as a structural
	#     fact -- before the hails complete there is NOTHING IN THE HOSTILES
	#     GROUP to be shot by, which is the strongest form of "it does not fire
	#     first" a harness can ask -- and the arc's thesis as a faction id: the
	#     asset WEARS Authority teal and FLIES FactionDB.FERAL, so the kill
	#     pays like the windfall it is and the Authority's standing does not
	#     move one point. Nobody reports this fight.
	var ord_key := GameState.mark_key(msid, 0)
	GameState.marks_seen = {}
	GameState.marks_seen[ord_key] = GameState.MARK_READ
	var hostiles_pre_o := get_tree().get_nodes_in_group("hostiles").size()
	var order_node := SystemBuilder.build_legend(system_root, msid, 0, "order",
		Vector3(1400.0, 0.0, 1400.0)) as StandingOrder
	var order_stood := order_node != null
	var polite: bool = 		get_tree().get_nodes_in_group("hostiles").size() == hostiles_pre_o
	var armed_one := false
	var wears_paint := false
	var flies_feral := false
	var kill_would_pay := false
	var order_spent := false
	var authority_blind := false
	var order_gone := false
	if order_stood:
		var gsa_before_o := GameState.faction_attitude(FactionDB.SURVEYOR, "gsa")
		var deltas_before_o := JSON.stringify(GameState.faction_deltas)
		order_node._arm()
		var asset: Hostile = null
		for h_v in get_tree().get_nodes_in_group("hostiles"):
			if (h_v as Node).has_meta("standing_order"):
				asset = h_v as Hostile
		armed_one = asset != null \
			and get_tree().get_nodes_in_group("hostiles").size() == hostiles_pre_o + 1
		if asset != null:
			wears_paint = asset.tint == FactionDB.tint_of("gsa")
			flies_feral = String(asset.faction) == FactionDB.FERAL
			# The pays-gate is the faction BAND, so the windfall claim is the
			# band claim: feral is HOSTILE to the surveyor, always.
			kill_would_pay = GameState.faction_band(FactionDB.FERAL,
				FactionDB.SURVEYOR) == FactionDB.Band.HOSTILE
			asset.take_damage(9.9e9, pilot_m)
			order_node._check_silenced()
			order_spent = GameState.is_mark_spent(ord_key)
			authority_blind = GameState.faction_attitude(FactionDB.SURVEYOR, "gsa") \
				== gsa_before_o \
				and JSON.stringify(GameState.faction_deltas) == deltas_before_o
		order_gone = SystemBuilder.build_legend(system_root, msid, 0, "order",
			Vector3(1400.0, 0.0, 1400.0)) == null
		# THE SPILL LANDS ON A TIMER (DEATH_STAGE_3, 0.38s), so an immediate
		# sweep here cleaned up nothing and left the asset's crates to appear
		# inside a LATER leg's cube count. Nothing has gone red on it yet --
		# the suite happened to be slow enough between these two legs -- which
		# is precisely the kind of pass that stops being one on a faster
		# machine.
		await get_tree().create_timer(0.6).timeout
		_clear_loot_cubes()
		order_node.queue_free()
	print("[return] THE ORDER HAILS BEFORE IT FIRES the station stands=%s with nothing in the hostiles group=%s; arming launches exactly one asset=%s wearing Authority teal=%s while flying feral=%s (so the kill pays: band HOSTILE=%s); silencing it spends the mark=%s, moves no GSA standing and no delta=%s, and the asset does not re-post=%s -> %s" % [
		str(order_stood), str(polite), str(armed_one), str(wears_paint),
		str(flies_feral), str(kill_would_pay), str(order_spent),
		str(authority_blind), str(order_gone),
		"PASS" if order_stood and polite and armed_one and wears_paint
			and flies_feral and kill_would_pay and order_spent
			and authority_blind and order_gone else "FAIL"])

	# 20. THE SERPENT LEAVES, AND THE MARK STANDS. S2 as mechanics: silencing a
	#     majority of the body drives it off rather than killing it, the
	#     departure pays NOTHING anywhere money is kept (no loot, no salvage,
	#     no ledger, no faction delta -- it has no faction to shift), and the
	#     mark is never spent, so the fight rebuilds whole. Not a respawn
	#     exploit, because it has never once paid.
	var serp_key := GameState.mark_key(msid, 1)
	GameState.marks_seen = {}
	GameState.marks_seen[serp_key] = GameState.MARK_READ
	var hostiles_pre_s := get_tree().get_nodes_in_group("hostiles").size()
	var loot_pre_s := _count_loot_cubes()
	var salv_pre_s := GameState.salvage
	var ledger_pre_s := JSON.stringify(GameState.ledger)
	var deltas_pre_s := JSON.stringify(GameState.faction_deltas)
	var serp := SystemBuilder.build_legend(system_root, msid, 1, "serpent",
		Vector3(1600.0, 0.0, 1600.0)) as SoundingSerpent
	var serp_stood := serp != null
	var body_armed := false
	var broke_off := false
	var board_clear := false
	var paid_nothing_s := false
	var mark_stands := false
	var comes_back := false
	if serp_stood:
		body_armed = get_tree().get_nodes_in_group("hostiles").size() \
			== hostiles_pre_s + SoundingSerpent.SEGMENTS \
			and serp.answering_count() == SoundingSerpent.SEGMENTS
		for i in range(SoundingSerpent.BREAK_AT):
			var sgm := serp.segments()[i] as Node3D
			sgm.take_damage(SoundingSerpent.SEGMENT_HP + 1.0, pilot_m)
		broke_off = serp.is_leaving()
		board_clear = get_tree().get_nodes_in_group("hostiles").size() \
			== hostiles_pre_s
		paid_nothing_s = _count_loot_cubes() == loot_pre_s \
			and GameState.salvage == salv_pre_s \
			and JSON.stringify(GameState.ledger) == ledger_pre_s \
			and JSON.stringify(GameState.faction_deltas) == deltas_pre_s
		mark_stands = GameState.is_mark_read(serp_key) \
			and not GameState.is_mark_spent(serp_key)
		var serp2 := SystemBuilder.build_legend(system_root, msid, 1, "serpent",
			Vector3(1600.0, 0.0, 1600.0))
		comes_back = serp2 != null
		if serp2 != null:
			serp2.queue_free()
		serp.queue_free()
	print("[return] THE SERPENT LEAVES AND THE MARK STANDS %d segments answer=%s; silencing %d breaks it off=%s, empties the board=%s, and pays nothing anywhere money is kept=%s; the mark is read and NEVER spent=%s, so it comes back whole=%s -> %s" % [
		SoundingSerpent.SEGMENTS, str(body_armed), SoundingSerpent.BREAK_AT,
		str(broke_off), str(board_clear), str(paid_nothing_s),
		str(mark_stands), str(comes_back),
		"PASS" if serp_stood and body_armed and broke_off and board_clear
			and paid_nothing_s and mark_stands and comes_back else "FAIL"])

	# 21. THE ORRERY IS A WINDFALL. The one-time payout, its SIZE pinned where a
	#     retune has to argue with it, and the two properties that keep a
	#     windfall from becoming an income: it defers rather than spilling when
	#     the hold is full, and it never comes back.
	#
	#     THE SIZE IS THE ASSERTION. Twenty units of band-6 chart data is five
	#     standard loops of masting (PACING_LOOP takes two readings a loop at
	#     SurveyMast.YIELD_UNITS each), which is the whole claim -- "a scale a
	#     pilot cannot earn in a session" -- expressed against the rate the
	#     pacing profile itself uses rather than against a number in a comment.
	var orr_key := GameState.mark_key(msid, 2)
	GameState.marks_seen = {}
	GameState.marks_seen[orr_key] = GameState.MARK_READ
	GameState.cargo = {}
	var orr_at := Vector3(1800.0, 0.0, 1800.0)
	var orrery := SystemBuilder.build_legend(system_root, msid, 2, "orrery",
		orr_at) as Orrery
	var orr_stood := orrery != null
	var loops_worth := 0.0
	var deferred_orr := false
	var collected := false
	var orr_spent := false
	var orr_gone := false
	var band6_good := false
	if orr_stood:
		band6_good = Orrery.COLLECT_GOOD == CommodityDB.chart_for_band(
			DeepSpace.BAND_NAMES.size() - 1)
		loops_worth = float(Orrery.COLLECT_UNITS) \
			/ (float(SurveyMast.YIELD_UNITS) * float(PACING_LOOP["survey"]))
		# PARKED AT THE LEGEND, NOT AT THE MARK. build_legend stands every
		# legend LEGEND_STANDOFF off its buoy, so teleporting to `orr_at` left
		# the ship 26u from a 14u collect range and the hold never engaged --
		# and the deferral clause below then passed on NOTHING HAPPENING,
		# which is the vacuous-assertion shape this file keeps catching.
		if pilot_m != null:
			pilot_m.teleport_to(orrery.global_position)
		# FULL HOLD FIRST: an instrument that has waited forty years does not
		# spill its file on the deck because the pilot arrived full.
		GameState.load_cargo("alloys", 9999)
		orrery.hold_begin()
		# THE HOLD ACTUALLY ENGAGED, asserted before anything is concluded from
		# its outcome. Without this the deferral reads the same whether the
		# instrument refused politely or the harness never reached it.
		var began_full: bool = orrery._holding
		orrery.hold_tick(Orrery.COLLECT_TIME + 0.1)
		deferred_orr = began_full and not GameState.is_mark_spent(orr_key) \
			and GameState.cargo_count(Orrery.COLLECT_GOOD) == 0
		# With room, it pays exactly once.
		GameState.cargo = {}
		orrery.hold_begin()
		orrery.hold_tick(Orrery.COLLECT_TIME + 0.1)
		collected = GameState.cargo_count(Orrery.COLLECT_GOOD) == Orrery.COLLECT_UNITS
		orr_spent = GameState.is_mark_spent(orr_key)
		orr_gone = SystemBuilder.build_legend(system_root, msid, 2, "orrery",
			orr_at) == null
		orrery.queue_free()
	print("[return] THE ORRERY IS A WINDFALL stands when read=%s paying the band-6 chart good=%s; %d units is %.1f standard loops of masting; a full hold DEFERS it=%s; with room it pays once=%s, spends the mark=%s and never comes back=%s -> %s" % [
		str(orr_stood), str(band6_good), Orrery.COLLECT_UNITS, loops_worth,
		str(deferred_orr), str(collected), str(orr_spent), str(orr_gone),
		"PASS" if orr_stood and band6_good and loops_worth >= 4.0
			and loops_worth <= 8.0 and deferred_orr and collected and orr_spent
			and orr_gone else "FAIL"])

	# 22. THE ORRERY IS NOT A RAISE. The fourth sibling of FILING / MINING /
	#     JUMP IS NOT A RAISE: no pacing profile may ever name a legend, so a
	#     windfall cannot be smuggled into the recurring term where it would
	#     re-tune the whole economy while every leg stayed green.
	#
	#     AND THE COMMISSION HEARS ABOUT IT, DELIBERATELY. Selling these moves
	#     chart_data_sold, which is what the Grand Commission counts -- that is
	#     the arc's thesis landing, not a leak, and it is asserted so it cannot
	#     be "fixed" by accident later. What the leg polices is the RATIO: the
	#     windfall must stay a minority of the Commission's top stage, or the
	#     legend stops being a legend and becomes the pillar.
	var raise_named := ""
	for prof_v in [PACING_LOOP, PACING_PROSPECT]:
		for k6_v in (prof_v as Dictionary):
			var kk := String(k6_v)
			if kk == "orrery" or kk == "legend" or kk == "nursery" or kk == "forge":
				raise_named += kk + " "
	# READ OFF THE FLAT KEY, which is the schema STAGES actually uses -- the
	# requirement sits directly on the stage dict, not under a "requires"
	# sub-dictionary. Written the other way first, this leg read 0 from every
	# stage and would have measured a share of nothing.
	var top_stage := 0
	for st_v in CommissionDB.STAGES:
		top_stage = maxi(top_stage,
			int((st_v as Dictionary).get("chart_data_sold", 0)))
	var stage_share := float(Orrery.COLLECT_UNITS) / maxf(float(top_stage), 1.0)
	print("[return] THE ORRERY IS NOT A RAISE pacing profiles name no legend (%s); the windfall moves the Commission by %d of %d units on file (%.0f%% of the top stage, must stay a minority) -> %s" % [
		"clean" if raise_named == "" else raise_named, Orrery.COLLECT_UNITS,
		top_stage, stage_share * 100.0,
		"PASS" if raise_named == "" and top_stage > 0 and stage_share < 0.5
			else "FAIL"])

	# 23. THE FORGE COPIES WHAT DIES THERE. The verb is a journey: the bed is
	#     empty until something dies in range, and the refusal says so. Then the
	#     wing, and the four IFF properties that are the whole reason a friendly
	#     armed ship is safe to put in the sky -- each one a defect this
	#     codebase has already paid for once, asserted rather than trusted.
	var forge_key := GameState.mark_key(msid, 3)
	GameState.marks_seen = {}
	GameState.marks_seen[forge_key] = GameState.MARK_READ
	var forge_at := Vector3(2000.0, 0.0, 2000.0)
	var forge := SystemBuilder.build_legend(system_root, msid, 3, "forge",
		forge_at) as PatternForge
	var forge_stood := forge != null
	var bed_empty := false
	var refused_empty_bed := false
	var took_pattern := false
	var printed_n := 0
	var not_my_enemy := true
	var costs_no_standing := true
	var nobody_opens := true
	var can_never_finish := true
	var bed_cold := false
	var forge_stays := false
	if forge_stood:
		bed_empty = not forge.has_pattern()
		forge.hold_begin()
		refused_empty_bed = not forge._holding
		# FEED IT: a hull dies in range, and the forge takes the pattern.
		var donor := Hostile.new()
		donor.faction = FactionDB.FERAL
		system_root.add_child(donor)
		donor.global_position = forge.global_position + Vector3(10.0, 0.0, 0.0)
		await get_tree().process_frame
		# SEEN ALIVE, THEN KILLED. The forge copies from a snapshot it took
		# while the hull was flying, because a dying hull is out of the
		# `hostiles` group before any frame can see it -- so the watch has to
		# run once with the donor alive, exactly as _process would.
		forge._watch_the_bed()
		donor.take_damage(9.9e9, pilot_m)
		forge._watch_the_bed()
		took_pattern = forge.has_pattern()
		# PRINT, from the legend's own position rather than the mark's.
		if pilot_m != null:
			pilot_m.teleport_to(forge.global_position)
		# DUPLICATED, NOT JSON-ROUND-TRIPPED. faction_deltas holds ints, and
		# JSON.parse_string would hand every one of them back as a float --
		# restoring a store with the right numbers in the wrong type, which is
		# the sort of thing that goes wrong three suites later.
		var deltas_before_f: Dictionary = GameState.faction_deltas.duplicate(true)
		forge.hold_begin()
		forge.hold_tick(PatternForge.PRINT_TIME + 0.1)
		await get_tree().process_frame
		var wing: Array = []
		for h_v in get_tree().get_nodes_in_group("hostiles"):
			var hh := h_v as Hostile
			if hh != null and hh.printed:
				wing.append(hh)
		printed_n = wing.size()
		for w_v in wing:
			var w := w_v as Hostile
			# 1. The player's own guns must never pick their wing.
			if GameState.hostile_to_player(w):
				not_my_enemy = false
			# 2. Splashing it must cost nothing: an unregistered flag is in no
			#    roster, so shift_faction has no pair to move.
			if FactionDB.is_faction(w.faction):
				costs_no_standing = false
			# 3. Nothing in the world opens on it unprovoked -- it is in no
			#    faction's enemy list, because it is in no faction.
			for other_v in FactionDB.ids():
				if GameState.enemies_of(String(other_v)).has(w.faction):
					nobody_opens = false
			# 4. And it can never land a kill: in `combatants`, so the ambient
			#    floor clamps what it can take a target down to and the player
			#    keeps every attribution, every crate and every contract tick.
			if not w.is_in_group("combatants"):
				can_never_finish = false
		GameState.faction_deltas = deltas_before_f
		bed_cold = not forge.has_pattern()
		# A forge is a PLACE: it never spends its mark, so it stands again.
		var forge2 := SystemBuilder.build_legend(system_root, msid, 3, "forge",
			forge_at)
		forge_stays = forge2 != null and not GameState.is_mark_spent(forge_key)
		if forge2 != null:
			forge2.queue_free()
		# THE SUITE LEAVES NO FRIENDLY IN THE SKY. A printed hull left in the
		# `hostiles` group would be picked as live[0] by _pacing_kill_yield and
		# force-attacked for 5400 frames, corrupting the bar the whole economy
		# rests on -- so the wing is torn down here, deliberately and by name.
		for w2_v in wing:
			(w2_v as Node).free()
		donor.free()
		# THE SPILL LANDS ON A TIMER, and clearing before it fires cleans up
		# nothing. Hostile._die spawns its crates at DEATH_STAGE_3 (0.38s), so
		# an immediate sweep left the donor's loot to materialise inside the
		# NEXT leg -- where a cube count captured before and after moved for a
		# reason that leg had nothing to do with.
		await get_tree().create_timer(0.6).timeout
		_clear_loot_cubes()
		forge.queue_free()
	print("[return] THE FORGE COPIES WHAT DIES THERE the bed starts empty=%s and refuses the hold=%s; a hull dying in range arms it=%s; the hold printed %d of %d; the wing is not the player's enemy=%s, costs no standing to splash=%s, is nobody's enemy unprovoked=%s, and can never land a kill=%s; the bed goes cold=%s and the forge itself stands again=%s -> %s" % [
		str(bed_empty), str(refused_empty_bed), str(took_pattern), printed_n,
		PatternForge.PRINT_COUNT, str(not_my_enemy), str(costs_no_standing),
		str(nobody_opens), str(can_never_finish), str(bed_cold), str(forge_stays),
		"PASS" if forge_stood and bed_empty and refused_empty_bed and took_pattern
			and printed_n == PatternForge.PRINT_COUNT and not_my_enemy
			and costs_no_standing and nobody_opens and can_never_finish
			and bed_cold and forge_stays else "FAIL"])

	# 24. READ THEM SLOWLY. The formation, the attachment, and the one rule the
	#     plate states in its own copy — enforced by the interface rather than
	#     asked of the player. Also the fiction's own constraint: the rival
	#     stays anonymous, which is a claim about what is NOT in the table and
	#     therefore has to be asserted rather than assumed.
	# §117. AND ONE OF THEM PASSES A LIGHT SOMEBODY KEEPS. Driven through
	#     legend_arrives, which is the real caller, so the leg tests the wiring
	#     and not a helper nobody reaches. Both directions, because a sentence
	#     that fired for every pilot would be a sentence about nothing: silent
	#     with no colony, spoken with one, and spoken ONCE.
	#     THE PLATE IS FREED BY HAND BETWEEN CLAUSES, and that is required
	#     rather than convenient: the helper refuses while a plate is up (§96's
	#     ask-first), so a "never twice" clause run against a busy plate would
	#     pass on the BUSY guard whether the once-per-run flag worked or not --
	#     a leg that cannot fail, which is the exact defect --legs just found in
	#     TITLETEST. Reaching a private HUD field is the prompt sweep's own
	#     precedent (it reads _prompt_label.modulate.a for the same kind of
	#     reason: the public surface cannot express the state a leg must set up).
	var kept_was := _kept_light_spoken
	var colonies_was: Dictionary = GameState.colonies.duplicate(true)
	var at_proc := Vector3(2400.0, 0.0, 2400.0)

	_kept_light_spoken = false
	GameState.colonies = {}
	hud._broadcast_box.visible = false
	legend_arrives(msid, 4, "procession", at_proc)
	var silent_alone: bool = not _kept_light_spoken and not hud.broadcast_busy()

	GameState.claim_colony(msid + ":3", 1800.0, 0.0)
	legend_arrives(msid, 4, "procession", at_proc)
	var spoke_with_light: bool = _kept_light_spoken \
		and hud.broadcast_text().contains("kept by you")

	# The plate is freed, so the ONLY thing that can stop a second sentence is
	# the flag. A sentinel goes up first so "nothing new was written" is
	# measured against a known string rather than against emptiness.
	hud._broadcast_box.visible = false
	hud.show_broadcast("SENTINEL", "SENTINEL", Palette.AMBER)
	legend_arrives(msid, 4, "procession", at_proc)
	var spoke_once: bool = hud.broadcast_text() == "SENTINEL"

	hud._broadcast_box.visible = false
	GameState.colonies = colonies_was
	_kept_light_spoken = kept_was
	print("[return] THE PROCESSION PASSES A KEPT LIGHT silent with no colony=%s, spoken with one=%s, and never twice with the plate FREE=%s -> %s" % [
		str(silent_alone), str(spoke_with_light), str(spoke_once),
		"PASS" if silent_alone and spoke_with_light and spoke_once else "FAIL"])

	var proc_key := GameState.mark_key(msid, 4)
	GameState.marks_seen = {}
	GameState.marks_seen[proc_key] = GameState.MARK_READ
	var proc_at := Vector3(2400.0, 0.0, 2400.0)
	var proc := SystemBuilder.build_legend(system_root, msid, 4, "procession",
		proc_at) as Procession
	var proc_stood := proc != null
	var named_n := 0
	var lines_whole := true
	var names_unique := true
	var rival_unnamed := true
	var spaced := true
	var read_one := false
	var refused_fast := false
	if proc_stood:
		await get_tree().process_frame
		var named := proc.named_hulls()
		named_n = named.size()
		var seen_names := {}
		for h_v in named:
			var nm := String((h_v as Node).get("hull_name"))
			var ln := String((h_v as Node).get("hull_line"))
			if ln.strip_edges() == "":
				lines_whole = false
			if seen_names.has(nm):
				names_unique = false
			seen_names[nm] = true
			# THE RIVAL IS NOT ON THE LIST, and this is the clause the fiction
			# needs: two horizons kept that hull anonymous, and a caption would
			# spend it. Checked against the archive's own name for the wreck
			# rather than a literal, so renaming it there cannot un-assert this.
			if nm == String(UnsoundedSite.NAMES.get("wreck", "")):
				rival_unnamed = false
		# NO TWO HULLS ON TOP OF EACH OTHER. CameraRig._pick is screen-space
		# with no raycast, so hulls closer than a tap apart would make choosing
		# which one to read a coin flip. Asserted in world units against the
		# spacing the builder claims to use.
		for i in range(named.size()):
			for j in range(i + 1, named.size()):
				var da: Node3D = named[i]
				var db: Node3D = named[j]
				if da.global_position.distance_to(db.global_position) \
						< Procession.HULL_SPACING * 0.9:
					spaced = false
		# THROUGH THE REAL TAP, twice: the first raises the plate, the second
		# is refused while it is up. That refusal IS the mark's instruction.
		if named_n > 0:
			hud.clear_prompt()
			# THE PLATE OUTLIVES ITS LEG. show_broadcast holds for 6.2s and the
			# suite runs in milliseconds, so the serpent's break-off line from
			# leg 20 was still up when this leg tapped its first hull -- the
			# hull then correctly took its READ THEM SLOWLY branch, and the leg
			# read that correct behaviour as a failure. Cleared here, because a
			# leg about what a plate says must start from an empty plate.
			hud._broadcast_box.visible = false
			(named[0] as Node).call("on_tapped")
			read_one = hud.broadcast_busy() \
				and hud.broadcast_text() == String((named[0] as Node).get("hull_line"))
			(named[named_n - 1] as Node).call("on_tapped")
			await get_tree().create_timer(0.4).timeout
			refused_fast = hud.prompt_text() == Procession.SLOWLY \
				and hud.broadcast_text() == String((named[0] as Node).get("hull_line"))
	print("[return] READ THEM SLOWLY the formation stands=%s with %d named hulls (attachment holds %d), every entry whole=%s, names unique=%s, the rival still unnamed=%s, no two hulls inside a tap=%s; a tap raises the entry=%s and a second tap while it is up is refused in the plate's own words=%s -> %s" % [
		str(proc_stood), named_n, Procession.ATTACHMENT.size(), str(lines_whole),
		str(names_unique), str(rival_unnamed), str(spaced), str(read_one),
		str(refused_fast),
		"PASS" if proc_stood and named_n == Procession.ATTACHMENT.size()
			and lines_whole and names_unique and rival_unnamed and spaced
			and read_one and refused_fast else "FAIL"])

	# 25. THE PROCESSION ONLY ASKS. The legend that pays nothing, asserted as
	#     nothing — in a set where nine of ten give, the one that only asks is
	#     what keeps the others from reading as a loot table. And the mark is
	#     never spent, so the formation is a place rather than a prize.
	var refused_empty_p := false
	var left_it := false
	var never_spent := false
	var stands_again := false
	var paid_nothing_p := false
	var moved_what := ""
	if proc_stood and pilot_m != null:
		var first_hull := proc.hulls()[0] as Node3D
		pilot_m.teleport_to(first_hull.global_position)
		GameState.cargo = {}
		hud.clear_prompt()
		first_hull.call("hold_begin")
		await get_tree().create_timer(0.4).timeout
		# An empty hold is told the truth about the place, not just refused.
		refused_empty_p = hud.prompt_text() == Procession.NOT_SALVAGE
		GameState.load_cargo("alloys", 6)
		# BRACKET THE ACT, NOT THE LEG -- §96's DIRECTIVETEST lesson, and the
		# second time this file has paid for it. The capture used to sit at the
		# top of the leg, which put the 0.4s await above INSIDE the window this
		# clause calls "the deposit": four tenths of a second of the whole world
		# ticking, with loot still arriving in waves from breaches two legs back
		# (Derelict._spill_waves runs for VORTEX_TIME, 2.6s) and anything in
		# magnet range being collected. A pays-nothing claim measures the ACT or
		# it measures the weather.
		var salv_p := GameState.salvage
		var ledger_p := JSON.stringify(GameState.ledger)
		var loot_p := _count_loot_cubes()
		first_hull.call("hold_begin")
		first_hull.call("hold_tick", Procession.DEPOSIT_TIME + 0.1)
		left_it = GameState.cargo_used() == 0 \
			and GameState.is_mark_given(proc_key)
		never_spent = not GameState.is_mark_spent(proc_key)
		# AND IT NAMES WHAT MOVED. Three claims collapsed into one boolean
		# cannot say which of them broke, which is a round trip of the sweep
		# spent on a question the print could have answered the first time.
		if GameState.salvage != salv_p:
			moved_what += "salvage "
		if JSON.stringify(GameState.ledger) != ledger_p:
			moved_what += "ledger "
		if _count_loot_cubes() != loot_p:
			moved_what += "loot "
		paid_nothing_p = moved_what == ""
		var proc2 := SystemBuilder.build_legend(system_root, msid, 4,
			"procession", proc_at)
		stands_again = proc2 != null
		if proc2 != null:
			proc2.queue_free()
		proc.queue_free()
	print("[return] THE PROCESSION ONLY ASKS an empty hold is told what the place is=%s; leaving the hold empties it and records the one fact=%s; the mark is never spent=%s so the formation stands again=%s; and across the act itself nothing moved (%s) -> %s" % [
		str(refused_empty_p), str(left_it), str(never_spent), str(stands_again),
		"nothing" if moved_what == "" else moved_what,
		"PASS" if proc_stood and refused_empty_p and left_it and never_spent
			and stands_again and paid_nothing_p else "FAIL"])

	# 26. THE GROUND IS TAKEN, AND THEN IT IS KEPT. The nursery's own store, the
	#     keepers that gate the taking, and the clock — asserted as a DERIVATION
	#     rather than as a stored countdown, because that is the whole reason it
	#     costs one save field instead of a scheduler.
	var nur_key := GameState.mark_key(msid, 0)
	GameState.marks_seen = {}
	GameState.marks_seen[nur_key] = GameState.MARK_READ
	GameState.nursery = {}
	var nur_at := Vector3(3000.0, 0.0, 3000.0)
	var nursery := SystemBuilder.build_legend(system_root, msid, 0, "nursery",
		nur_at) as TallyNursery
	var nur_stood := nursery != null
	var keepers_up := 0
	var locked_refused := false
	var took := false
	var no_instant_wave := false
	var wave_due := false
	var wave_grows := false
	var clock_derived := false
	if nur_stood:
		await get_tree().process_frame
		nursery._wake_keepers()
		keepers_up = nursery.keepers_standing()
		# THE KEEPERS GATE THE TAKING, and the refusal names the count.
		if pilot_m != null:
			pilot_m.teleport_to(nursery.global_position)
		nursery.hold_begin()
		locked_refused = not nursery._holding
		for k_v in get_tree().get_nodes_in_group("hostiles"):
			var kk := k_v as Node3D
			if kk != null and kk.has_meta("nursery_keeper"):
				kk.free()
		nursery.hold_begin()
		nursery.hold_tick(TallyNursery.TAKE_TIME + 0.1)
		took = GameState.holds_nursery() and GameState.nursery_key() == nur_key \
			and nursery.is_held()
		# TAKING IS NOT THE FIRST ASSAULT: the ground changing hands must not
		# summon a wave on the same frame.
		nursery._tick_assault(0.016, 0.0)
		no_instant_wave = nursery._assault.is_empty()
		# THE CLOCK IS DERIVED. Winding played_seconds forward is the only input
		# the wave index has -- no timer, no stored countdown, nothing ticking.
		var t_keep := GameState.played_seconds
		GameState.played_seconds = t_keep + GameState.NURSERY_PERIOD * 2.0
		clock_derived = GameState.nursery_wave_index() == 2
		nursery._tick_assault(0.016, 0.0)
		wave_due = not nursery._assault.is_empty()
		# AND THEY COME IN INCREASING NUMBERS, sized off the RECORD rather than
		# the clock -- the clock restarts on every victory, so a size derived
		# from it would make every wave forever the first one.
		wave_grows = GameState.nursery_wave_size(4) > GameState.nursery_wave_size(0)
		GameState.played_seconds = t_keep
	print("[return] THE GROUND IS TAKEN AND THEN KEPT %d keepers stand and refuse the hold=%s; cleared, the hold takes the ground=%s; taking summons no wave on the same frame=%s; two periods on the clock alone makes the index 2=%s and forms the assault=%s; and the waves grow with what the pilot has survived=%s -> %s" % [
		keepers_up, str(locked_refused), str(took), str(no_instant_wave),
		str(clock_derived), str(wave_due), str(wave_grows),
		"PASS" if nur_stood and keepers_up == TallyNursery.KEEPER_COUNT
			and locked_refused and took and no_instant_wave and clock_derived
			and wave_due and wave_grows else "FAIL"])

	# 27. HELD, NOT OWNED. The jump anchor exists only while the ground does —
	#     which is what pays for A FOOTHOLD, NOT A FARM's widened bound. And
	#     losing it is losing a SIEGE, never a supply run: walking out with the
	#     ground quiet keeps it, walking out with them on it does not.
	var anchor_open := false
	var quiet_exit_keeps := false
	var siege_exit_loses := false
	var record_survives := false
	var anchor_closed := false
	if nur_stood and GameState.holds_nursery():
		GameState.salvage = maxi(GameState.salvage, COLONY_JUMP_FEE * 2)
		anchor_open = can_nursery_jump()
		# A quiet departure is a supply run.
		nursery._assault.clear()
		quiet_exit_keeps = not nursery.abandon_if_besieged() \
			and GameState.holds_nursery()
		# A departure mid-assault is a rout. Driven through the same entry point
		# _load_system calls, so the leg cannot pass on a path the world does
		# not take.
		GameState.note_nursery_wave_turned()
		GameState.note_nursery_wave_turned()
		nursery._form_assault(1)
		siege_exit_loses = nursery.abandon_if_besieged() \
			and not GameState.holds_nursery()
		# THE RECORD OUTLIVES THE LOSS (S5): retaking does not make a pilot who
		# held it through two assaults a novice.
		GameState.take_nursery(nur_key, nur_at.x, nur_at.z)
		record_survives = GameState.nursery_waves_turned() == 2
		GameState.release_nursery()
		anchor_closed = not can_nursery_jump()
		for a_v in get_tree().get_nodes_in_group("hostiles"):
			var aa := a_v as Node3D
			if aa != null and aa.has_meta("nursery_keeper"):
				aa.free()
		nursery.queue_free()
	print("[return] HELD, NOT OWNED the anchor opens while the ground is held=%s; leaving with it quiet keeps it=%s; leaving mid-assault loses it=%s; the count of what was turned back survives the loss=%s; and with the ground gone the anchor is gone=%s -> %s" % [
		str(anchor_open), str(quiet_exit_keeps), str(siege_exit_loses),
		str(record_survives), str(anchor_closed),
		"PASS" if anchor_open and quiet_exit_keeps and siege_exit_loses
			and record_survives and anchor_closed else "FAIL"])

	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	GameState.deep_logs = {}
	GameState.marks_seen = {}
	GameState.nursery = {}
	GameState.owned.clear()
	GameState.cargo = {}
	get_tree().quit()


# --- pilot profiles test ----------------------------------------------------

const SAVE_TEST_PREFS := "user://test_prefs.json"


func _savetest_prefs(mode: String) -> void:
	# Device preferences are OFF under a harness (GameState._ready's headless
	# clause), and SAVETEST is one of the two suites that wants them back --
	# because settings stopped being written to the save when they moved to
	# prefs.json, so "do the player's volumes survive a round trip" is now a
	# question about THAT file.
	#
	# The state is set per mode rather than inherited, which is the same rule
	# the fixtures already follow. The bare read is the ONLY leg that consumes
	# what another leg wrote -- it is the other half of `=write`, and the two
	# are kept adjacent in run_harness.sh for exactly this reason. Every other
	# mode starts from no prefs file at all, so `_prefs_loaded` is false, the
	# save is allowed to seed settings, and legs like migrate5 (which asserts
	# settings == DEFAULT_SETTINGS) and partial6 (whose whole subject is merging
	# a v6 save's settings key by key) measure what they always measured.
	GameState.prefs_path = SAVE_TEST_PREFS
	if mode != "1":
		DirAccess.remove_absolute(SAVE_TEST_PREFS)
	GameState.reload_prefs()


const PROFILE_TEST_ROOT := "user://ptest"


func _profile_test_redirect() -> void:
	# Every path this suite can reach, pointed at a scratch directory. The
	# player's registry, prefs and pilots are never opened by it, which is what
	# lets it exercise the real file layer rather than a mock.
	_rm_rf(PROFILE_TEST_ROOT)
	DirAccess.make_dir_recursive_absolute(PROFILE_TEST_ROOT)
	Profiles.registry_path = "%s/profiles.json" % PROFILE_TEST_ROOT
	Profiles.base_dir = "%s/profiles" % PROFILE_TEST_ROOT
	Profiles.legacy_path = "%s/save.json" % PROFILE_TEST_ROOT
	# Prefs back on, pointed at the scratch directory: _ready turned them off
	# because this is a headless run, and this suite is one of the two that
	# actually wants the layer. reload_prefs makes the redirect take effect for
	# READS too -- _ready has already been past.
	GameState.prefs_path = "%s/prefs.json" % PROFILE_TEST_ROOT
	GameState.reload_prefs()
	GameState.save_path = Profiles.legacy_path
	GameState.save_enabled = true


func _run_profile_test() -> void:
	var root := PROFILE_TEST_ROOT

	# 1. THE LEGACY SAVE MOVES ONCE. An upgrading player has one save and no
	#    registry; they must end up with one pilot holding exactly that run, the
	#    old file gone, and a SECOND migration doing nothing at all -- because
	#    the trigger is the registry's absence and a migration that ran twice
	#    would mean it was never really keyed on anything.
	GameState.reset_to_starter()
	GameState.add_salvage(4242)
	GameState.set_ship_name("OLD FAITHFUL")
	GameState.save_game()
	var legacy_bytes := FileAccess.get_file_as_string(Profiles.legacy_path)
	var first_id := Profiles.migrate_legacy(1000.0)
	var moved_bytes := FileAccess.get_file_as_string(Profiles.save_path_for(first_id))
	var legacy_gone: bool = not FileAccess.file_exists(Profiles.legacy_path)
	var reg_after := Profiles.load_registry()
	var named_from_ship: bool = not (reg_after["profiles"] as Array).is_empty() \
		and String((reg_after["profiles"][0] as Dictionary)["name"]) == "OLD FAITHFUL"
	var second := Profiles.migrate_legacy(2000.0)
	var idempotent: bool = second == "" and Profiles.list_profiles().size() == 1
	print("[profile] THE LEGACY SAVE MOVES ONCE id=%s, bytes carried=%s, old file gone=%s, named from the ship=%s, second run changed nothing=%s -> %s" % [
		first_id, str(moved_bytes == legacy_bytes and legacy_bytes.length() > 0),
		str(legacy_gone), str(named_from_ship), str(idempotent),
		"PASS" if first_id != "" and moved_bytes == legacy_bytes and legacy_gone
			and named_from_ship and idempotent else "FAIL"])

	# 2. NO BLEED BETWEEN PILOTS. The one that matters. Pilot A is given the
	#    three fields reset_to_starter deliberately PRESERVES -- paint, name and
	#    the commission -- because those are exactly the ones that leak, and the
	#    settled decision is that they belong to the pilot. Then a brand new
	#    pilot B is created and every serialized key is compared against a fresh
	#    starter, so a field that crosses names itself instead of being guessed.
	GameState.switch_profile(first_id)
	GameState.add_salvage(9000)
	GameState.set_ship_name("PILOT A")
	GameState.commissioned = true
	GameState.set_livery(0, 2)
	GameState.mark_breached("pyx01")
	# v21: coverage is per-pilot state too, and it is the newest field, which is
	# exactly when a leak ships -- the five below were all leaking when the leg
	# was written.
	GameState.note_survey_worked("pyx01:31:-7")
	# v22: both new stores, for the reason the coverage line above gives -- the
	# newest field is exactly when a leak ships.
	GameState.note_survey_filed("pyx01:31:-7")
	GameState.note_structure_seen(GameState.colony_key("pyx01", 0))
	# v23: same argument a third time. A deep log is the longest-lived thing a
	# pilot can own -- it is a fact about the world they learned -- which makes
	# it exactly the field a reader would expect to be shared, and it is not.
	GameState.note_deep_log("pyx01:meridian", 3)
	# 98: and a fourth time. A sounding mark read six thousand units out is the
	# single most expensive fact a pilot can own, so it is the one a shared
	# store would be most obviously wrong about.
	GameState.note_mark_read(GameState.mark_key("pyx01", 0))
	GameState.take_nursery(GameState.mark_key("pyx01", 1), 6800.0, -120.0)
	GameState.save_game()
	var b_id := Profiles.create("PILOT B", 3000.0)
	GameState.switch_profile(b_id)
	# ACCUMULATED, not first-wins: an if/elif chain names one field and hides the
	# rest, so a run that leaked three of them would be fixed one commit at a
	# time. All five were leaking when this was written.
	var leaks: Array = []
	if GameState.ship_name == "PILOT A":
		leaks.append("ship_name")
	if GameState.commissioned:
		leaks.append("commissioned")
	if int(GameState.livery.get("accent", 0)) != 0:
		leaks.append("livery")
	if GameState.salvage >= 9000:
		leaks.append("salvage")
	if GameState.breached.has("pyx01"):
		leaks.append("breached")
	if GameState.is_survey_worked("pyx01:31:-7"):
		leaks.append("survey_coverage")
	if GameState.is_survey_filed("pyx01:31:-7"):
		leaks.append("survey_filed")
	if GameState.is_structure_seen(GameState.colony_key("pyx01", 0)):
		leaks.append("structures_seen")
	if GameState.deep_log_stage("pyx01:meridian") > 0:
		leaks.append("deep_logs")
	if GameState.is_mark_read(GameState.mark_key("pyx01", 0)):
		leaks.append("marks_seen")
	# v26: and a fifth time. Ground one pilot took is not ground another holds.
	if GameState.holds_nursery():
		leaks.append("nursery")
	var bled := ", ".join(leaks)
	print("[profile] NO BLEED BETWEEN PILOTS B sees salvage=%d name='%s' commissioned=%s accent=%d; leaked=%s -> %s" % [
		GameState.salvage, GameState.ship_name, str(GameState.commissioned),
		int(GameState.livery.get("accent", 0)), "none" if bled == "" else bled,
		"PASS" if bled == "" else "FAIL"])

	# 3. AND BACK AGAIN, because "B is clean" is also satisfied by a switch that
	#    quietly discarded A. The round trip is what proves the file was written
	#    rather than merely left behind.
	GameState.switch_profile(first_id)
	var a_back: bool = GameState.salvage >= 9000 and GameState.ship_name == "PILOT A" \
		and GameState.commissioned and GameState.breached.has("pyx01")
	print("[profile] A PILOT SURVIVES THE ROUND TRIP salvage=%d name='%s' commissioned=%s -> %s" % [
		GameState.salvage, GameState.ship_name, str(GameState.commissioned),
		"PASS" if a_back else "FAIL"])

	# 4. PREFS OUTLIVE THE PILOT. The reason the split exists: a device
	#    preference set under one pilot must still be set under the next, and
	#    the bindings are the sharpest case because they are what the player
	#    would have to fix from a keyboard they can no longer use.
	GameState.rebind("move_up", KEY_Y)
	GameState.set_setting("music_vol", 0.11)
	GameState.set_audio_muted(true)
	GameState.switch_profile(b_id)
	var kept_binding: bool = _keys_for("move_up").has(KEY_Y)
	var kept_vol: bool = is_equal_approx(float(GameState.setting("music_vol")), 0.11)
	var kept_mute: bool = GameState.audio_muted
	print("[profile] PREFS OUTLIVE THE PILOT binding kept=%s, volume kept=%s, mute kept=%s -> %s" % [
		str(kept_binding), str(kept_vol), str(kept_mute),
		"PASS" if kept_binding and kept_vol and kept_mute else "FAIL"])

	# 5. THE SAVE NO LONGER CARRIES THE DEVICE. Asserted on the FILE, not on the
	#    fields: the split is only real if the keys stopped being written, and a
	#    save that still holds them would reload one pilot's keyboard onto
	#    another the moment anything read them again.
	GameState.save_game()
	var raw := FileAccess.get_file_as_string(Profiles.save_path_for(b_id))
	var no_settings: bool = not raw.contains("\"settings\"")
	var no_mute: bool = not raw.contains("\"audio_muted\"")
	print("[profile] THE SAVE NO LONGER CARRIES THE DEVICE settings absent=%s, audio_muted absent=%s -> %s" % [
		str(no_settings), str(no_mute),
		"PASS" if no_settings and no_mute else "FAIL"])

	# 6. THE REGISTRY IS INPUT, NOT TRUTH. Hand-edited rubbish: a duplicate id, a
	#    row whose folder is gone, a row that is not a dictionary, and an active
	#    id naming none of them. Exactly the valid ones survive and `active`
	#    falls back rather than pointing at nothing.
	var rubbish := {
		"schema": 1,
		"active": "p_nothing",
		"profiles": [
			{"id": b_id, "name": "REAL"},
			{"id": b_id, "name": "DUPLICATE"},
			{"id": "p_missing", "name": "NO FOLDER"},
			"not a dictionary",
		],
	}
	var rf := FileAccess.open(Profiles.registry_path, FileAccess.WRITE)
	rf.store_string(JSON.stringify(rubbish, "\t"))
	rf.close()
	var cleaned := Profiles.load_registry()
	var kept_one: bool = (cleaned["profiles"] as Array).size() == 1 \
		and String((cleaned["profiles"][0] as Dictionary)["id"]) == b_id
	var active_fell_back: bool = String(cleaned["active"]) == b_id
	print("[profile] THE REGISTRY IS INPUT, NOT TRUTH kept %d of 4 rows, active fell back=%s -> %s" % [
		(cleaned["profiles"] as Array).size(), str(active_fell_back),
		"PASS" if kept_one and active_fell_back else "FAIL"])

	# 7. A HARNESS CANNOT REACH THE REGISTRY. The guard that keeps every OTHER
	#    suite honest: they redirect save_path to a probe file and never touch
	#    the registry, so save_game must refuse to write a row for a path that
	#    is not the active pilot's. Without it, forty-odd suites would each be
	#    rewriting the player's pilot list on their way past.
	Profiles.save_registry(cleaned)
	var before_probe := FileAccess.get_file_as_string(Profiles.registry_path)
	GameState.save_path = "%s/probe.json" % root
	GameState.save_game()
	var after_probe := FileAccess.get_file_as_string(Profiles.registry_path)
	print("[profile] A HARNESS CANNOT REACH THE REGISTRY registry byte-identical after a redirected save=%s -> %s" % [
		str(before_probe == after_probe), "PASS" if before_probe == after_probe else "FAIL"])

	# 8. THE RACK HAS A FLOOR AND A CEILING. Five, refused rather than silently
	#    dropped, and a delete makes room again.
	var made := 0
	while Profiles.create("EXTRA %d" % made, 4000.0 + float(made)) != "":
		made += 1
		if made > Profiles.MAX_PROFILES + 3:
			break
	var capped: bool = Profiles.list_profiles().size() == Profiles.MAX_PROFILES
	Profiles.delete(b_id)
	var room_again: bool = Profiles.create("AFTER DELETE", 5000.0) != ""
	var gone: bool = not DirAccess.dir_exists_absolute("%s/%s" % [Profiles.base_dir, b_id])
	print("[profile] THE RACK HAS A CEILING capped at %d, folder removed on delete=%s, room after a delete=%s -> %s" % [
		Profiles.list_profiles().size(), str(gone), str(room_again),
		"PASS" if capped and gone and room_again else "FAIL"])

	# 9. A FRESH INSTALL STILL GETS A PILOT. The mirror of leg 1, and the case
	#    every new player is in: no legacy save and no registry must still end
	#    with somewhere to write, or the first NEW SURVEY runs into the old
	#    single-save path and is stranded there the moment a pilot is made.
	_rm_rf(root)
	_profile_test_redirect()
	var fresh_id := Profiles.migrate_legacy(6000.0)
	var fresh_none: bool = fresh_id == "" and Profiles.list_profiles().is_empty()
	var adopted := Profiles.create("", 6100.0)
	var fresh_has_home: bool = adopted != "" and Profiles.active_id() == adopted
	print("[profile] A FRESH INSTALL STILL GETS A PILOT nothing to migrate=%s, a pilot exists to write into=%s -> %s" % [
		str(fresh_none), str(fresh_has_home),
		"PASS" if fresh_none and fresh_has_home else "FAIL"])

	# 10. A SAVE THAT MOVED BUT WAS NEVER RECORDED IS STILL A PILOT. The window
	#     between the rename and the registry write: the folder holds a real run
	#     and nothing names it. Re-derived from disk rather than mistaken for a
	#     fresh install, because the alternative loses the run.
	_rm_rf(root)
	_profile_test_redirect()
	var orphan := "%s/profiles/p_orphan" % root
	DirAccess.make_dir_recursive_absolute(orphan)
	var of := FileAccess.open("%s/save.json" % orphan, FileAccess.WRITE)
	of.store_string(JSON.stringify({"version": GameState.SAVE_VERSION, "salvage": 777}, "\t"))
	of.close()
	Profiles.migrate_legacy(7000.0)
	var adopted_rows := Profiles.list_profiles()
	var orphan_kept: bool = adopted_rows.size() == 1 \
		and String((adopted_rows[0] as Dictionary)["id"]) == "p_orphan"
	print("[profile] AN UNRECORDED SAVE IS STILL A PILOT rebuilt %d row(s) from disk, active=%s -> %s" % [
		adopted_rows.size(), Profiles.active_id(),
		"PASS" if orphan_kept and Profiles.active_id() == "p_orphan" else "FAIL"])

	_rm_rf(root)
	get_tree().quit()


func _rm_rf(path: String) -> void:
	# Scratch only. Every caller passes a directory this harness made.
	var d := DirAccess.open(path)
	if d == null:
		return
	for f in d.get_files():
		DirAccess.remove_absolute("%s/%s" % [path, f])
	for sub in d.get_directories():
		_rm_rf("%s/%s" % [path, sub])
	DirAccess.remove_absolute(path)


# --- save round-trip test ---------------------------------------------------

func _run_save_test() -> void:
	GameState.save_path = "user://test_save.json"
	var mode := OS.get_environment("PYXIS_SAVETEST")
	_savetest_prefs(mode)

	if mode == "write":
		GameState.save_enabled = true
		GameState.reset_to_starter()
		GameState.add_salvage(9000)
		GameState.buy("arc_1")
		GameState.equip(ModuleDB.Slot.WEAPON_A, "arc_1")
		GameState.buy("util_tractor")
		GameState.equip(ModuleDB.Slot.UTILITY, "util_tractor")
		GameState.mark_breached("pyx01")
		GameState.set_current_system("pyx02")
		GameState.mark_bark("first_kill")
		GameState.mark_apex_killed("pyx01")
		GameState.load_cargo("alloys", 5)
		GameState.set_docked("cinderworks")
		GameState.played_seconds = 420.0
		Market.apply_trade_pressure("bastion", "alloys", 10, true)
		GameState.market_events.append({"kind": "glut", "port": "anchor",
			"good": "cores", "mult": 0.55, "remaining": 120.0})
		GameState.set_setting("music_vol", 0.35)
		GameState.set_setting("shake", false)
		GameState.set_setting("ui_scale", 1.25)
		GameState.set_livery(3, 5)
		# v9 bonded stores: one chart key and one deep CELL key, so the round trip
		# covers both shapes and the load-side validation of each.
		# Six DISTINCT sentinels: identical values would let a swapped key mapping
		# round-trip cleanly and pass. A 40-char name proves the 24-cap too.
		GameState.set_ship_name("ASTROLABE-SEVEN-OF-THE-LONG-WATCH-1234567")
		GameState.smuggling = 2
		GameState.smuggling_xp = 57
		# v19 PERSUASION, and BOTH numbers are distinct from smuggling's on
		# purpose — the six-distinct-sentinels rule two lines up, applied to the
		# newest pair. A fixture of 2/57 in both places would round-trip
		# perfectly through a load that had the two skills' keys crossed.
		GameState.persuasion = 1
		GameState.persuasion_xp = 3
		# v20 BEACONS. Two systems, three beacons, every coordinate distinct —
		# the six-distinct-sentinels rule again: identical values would let a
		# loader that crossed x with z, or pyx01 with pyx02, round-trip clean.
		GameState.beacons = {
			"pyx01": [{"x": 111.0, "z": 222.0}, {"x": -333.0, "z": 444.0}],
			"pyx02": [{"x": 555.0, "z": -666.0}],
		}
		# v20 COLONIES. Distinct again, and distinct from the beacon numbers —
		# a loader that crossed the two stores would round-trip clean otherwise.
		GameState.colonies = {
			"pyx01:2": {"x": 1777.0, "z": -1888.0, "founded_at": 42.0},
			"pyx03:0": {"x": -2999.0, "z": 3111.0, "founded_at": 77.0},
		}
		GameState.last_outbound_jump = 1234.5
		# v21 SURVEY COVERAGE. Two systems, three cells, every coordinate
		# distinct — the six-distinct-sentinels rule a third time: identical
		# values would let a loader that crossed cx with cz, or pyx01 with
		# pyx02, round-trip clean. Written through the accessor so the write
		# path (cap and all) is the one exercised.
		GameState.survey_coverage = {}
		GameState.note_survey_worked("pyx01:7:-3")
		GameState.note_survey_worked("pyx01:12:5")
		GameState.note_survey_worked("pyx02:-4:19")
		# v22: one of the three FILED and a structure sighted, so the round trip
		# covers both new stores and the subset invariant between them. Distinct
		# from the coverage sentinels for the six-distinct-sentinels reason.
		GameState.note_survey_filed("pyx01:12:5")
		GameState.note_structure_seen(GameState.colony_key("pyx01", 0))
		# v23 DEEP LOGS. TWO records at DIFFERENT stages, in different systems:
		# the six-distinct-sentinels rule again. One record at one stage would
		# round-trip through a loader that clamped every entry to 1, or that
		# crossed the key with its value.
		GameState.note_deep_log("pyx01:meridian", 3)
		GameState.note_deep_log("pyx01:meridian", 3)
		GameState.note_deep_log("pyx02:glass", 3)
		GameState.owned.append("mod_survey_array")
		GameState.ledger = {
			"deepest_depth": 611, "distance_flown": 4207, "hulks_cracked": 13,
			"posts_cleared": 5, "chart_data_sold": 82, "tolls_paid": 2,
		}
		GameState.warehouse = {
			"anchor": {"servo_prewar": 3, "lattice_data": 2},
			_first_bay_cell(): {"salvage_quiet": 4},
			"pyx01:99:99": {"salvage_quiet": 9},   # no station there: must be dropped
		}
		# v18 faction matrix. Two DISTINCT values on two DISTINCT pair shapes —
		# one the player is party to, one between two third parties — for the
		# same reason the ledger carries six distinct sentinels: equal values
		# would let a swapped key mapping round-trip cleanly and pass. Written
		# through shift_faction so the canonical key ordering is produced by
		# the code under test rather than by the fixture.
		#
		# BEFORE the captain's log below, and that ordering is load-bearing.
		# shift_faction NOTES A LOG LINE when the player is party to the shift
		# (finding A10: standing the player changed and cannot see is not
		# politics, it is a haunting) — so filing it after the log fill pushes
		# "THE GRIN — STANDING RISES" into the ring, evicts LOGBOOK ENTRY 02,
		# and fails an eviction-order assertion that is working perfectly.
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", 4)
		GameState.shift_faction("gsa", "bastion", -3)
		# v12 captain's log. Written through the real mutator rather than assigned:
		# that keeps truncation and eviction in the path under test, and an
		# untyped array literal cannot be assigned to an Array[String] member on
		# another object anyway. LOG_MAX + 2 entries, each DISTINCT for the same
