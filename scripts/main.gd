# --- boot states ------------------------------------------------------------

func _enter_attract() -> void:
	# The title sits over a real, running system — starfield, lattice, derelict —
	# rather than a static image. The ship is parked and inert; nothing hunts it.
	state = State.ATTRACT
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.set_input_enabled(false)
		player.visible = false
	hud.set_chrome_visible(false)
	title_screen.open(GameState.has_save())
	# The menu is scored by the ambient drone alone: arriving here should feel
	# like the music has not started yet.
	Music.stop()


func _enter_playing() -> void:
	state = State.PLAYING
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.set_input_enabled(true)
		player.visible = true
	hud.set_chrome_visible(true)
	# Idempotent, and this is the one path every harness takes — the ambient bed
	# used to be started only on the mainline boot, so the early-returning
	# harnesses ran in silence and could not check anything about audio.
	Sfx.loop_start("ambient", -16.0)
	Music.set_system_tint(SystemDB.music_lp_of(system_id))
	Music.play()


func _build_beacons() -> void:
	# v20 HUNT STAGE 5. One node per store entry, children of system_root so a
	# warp frees them with everything else and this rebuild is the whole
	# lifecycle. At most BEACON_STOCK nodes exist across the WHOLE save, so
	# there is no streaming question — a beacon is always present, like the
	# apex, and for the same reason: a thing whose job is to be found must not
	# depend on the finder's distance.
	for e_v in GameState.beacons_in(system_id):
		var e: Dictionary = e_v
		var b := Beacon.new()
		b.system_id = system_id
		system_root.add_child(b)
		b.global_position = Vector3(float(e["x"]), 0.0, float(e["z"]))


# --- first-filing settlement (v22, Horizon 7 commit 2) ------------------------

# The premium for being FIRST, as a fraction of the reading's base value. A
# band-2 cell pays 140 on top of the market sale; a band-5 cell pays more only
# because its chart good's base is higher -- one rate, depth carried by the
# existing price ladder rather than by a second table.
#
# BASE price, deliberately not the market price. The market half of a sale is
# where you sold it and what the port thinks of that good today; provenance is
# a fact about the CELL, and a fact should not pay differently at a fence.
const FIRST_FILING_RATE := 0.5


func colony_ground_sounded(colony_key: String) -> bool:
	# §112. NOBODY BUILDS ON AN UNSOUNDED BOTTOM. The colony's own cell must be
	# in coverage -- worked by a mast, or auto-sounded by a COLONIAL t2 founding.
	# Main owns this join for cell_depth_of_key's reason: GameState holds the
	# colony as opaque data and never references DeepSpace.
	var c: Dictionary = GameState.colonies.get(colony_key, {})
	if c.is_empty():
		return false
	var cell := DeepSpace.cell_of(Vector3(float(c.get("x", 0.0)), 0.0,
		float(c.get("z", 0.0))))
	var sys := colony_key.split(":")[0] if colony_key.contains(":") else system_id
	return GameState.is_survey_worked(DeepSpace.cell_key(String(sys), cell.x, cell.y))


func work_delivery_met(colony_key: String, work: String) -> bool:
	# §116. THE TRIP IS THE COST, and this is the half of it the STORE cannot
	# ask: a work with a `goods` manifest wants the ship standing at the colony
	# with the goods aboard, not a hold four thousand units away.
	#
	# THIS GATE IS THE WHOLE FEATURE. Colony works are bought from the CHART --
	# a menu openable from anywhere in the game, including while docked at the
	# counter the alloys were just bought from -- and no work has ever had a
	# position gate. Without this, "delivered" would be a word with no mechanism
	# under it, which is §110's forge hint in a new costume: copy the data does
	# not support.
	#
	# Pure and exposed so the chart row can state its own terms (§58) and an
	# assertion can ask the question without performing the purchase, which is
	# network_filing_plan's split said again.
	var want: Dictionary = (GameState.COLONY_WORKS.get(work, {}) as Dictionary) \
		.get("goods", {})
	if want.is_empty():
		return true
	var c: Dictionary = GameState.colonies.get(colony_key, {})
	if c.is_empty():
		return false
	# IN THIS SYSTEM, standing at it. dock_aura_at's walk and its range: the
	# DRY DOCK already decides "alongside this colony" and there is no second
	# opinion about what that means.
	if not colony_key.begins_with(GameState.current_system + ":"):
		return false
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return false
	var dx := float(c.get("x", 0.0)) - player.global_position.x
	var dz := float(c.get("z", 0.0)) - player.global_position.z
	if sqrt(dx * dx + dz * dz) > GameState.DOCK_AURA_RANGE:
		return false
	for g_v in want:
		if GameState.cargo_count(String(g_v)) < int(want[g_v]):
			return false
	return true


func work_manifest(work: String) -> String:
	# The manifest as one short phrase, for a refusal that names the act.
	var want: Dictionary = (GameState.COLONY_WORKS.get(work, {}) as Dictionary) \
		.get("goods", {})
	var parts := PackedStringArray()
	for g_v in want:
		parts.append("%d %s" % [int(want[g_v]),
			CommodityDB.short_name(String(g_v))])
	return ", ".join(parts)


func buy_colony_work(colony_key: String, work: String) -> bool:
	# The gates AND the purchase, in that order, with every refusal free --
	# nothing is spent before either check. The store enforces its own rules;
	# this adds the two it cannot ask.
	if not colony_ground_sounded(colony_key):
		if hud:
			hud.show_toast("SOUND THE GROUND FIRST — WORK A MAST IN ITS CELL",
				Palette.THREAT)
		return false
	if not work_delivery_met(colony_key, work):
		if hud:
			# §58: the refusal names the act and the manifest, because a pilot
			# who cannot tell whether they are missing goods or missing the
			# journey has been told nothing.
			hud.show_toast("BRING %s TO THE COLONY ITSELF" % work_manifest(work),
				Palette.THREAT)
		return false
	if not GameState.buy_colony_work(colony_key, work):
		return false
	if hud:
		hud.set_value(GameState.salvage)
		hud.show_toast("WORKS RAISED — %s" % String(
			(GameState.COLONY_WORKS[work] as Dictionary).get("name", work)),
			Palette.GOLD)
	Sfx.play("breach", -10.0, 1.1)
	return true


func anchor_rows(sys: String) -> Array:
	# §112, FILING t3. The held cells of one system as jump rows -- nearest
	# first, capped at four so a long-armed filer's chart stays a chart rather
	# than a ledger. Same row shape beacon_rows returns, labels synthesized the
	# same way, because the jump handler downstream is the same handler.
	# Gated HERE as well as at the chart -- the button is the affordance, this
	# is the rule, and a rule that lived only in a panel would hand the rows to
	# any future caller free.
	if GameState.skill_tier("filing") < GameState.FILING_ANCHOR_TIER:
		return []
	var out: Array = []
	for k_v in GameState.held_cells(sys):
		var key := String(k_v)
		var bits := key.split(":")
		if bits.size() != 3:
			continue
		var centre := DeepSpace.cell_centre(int(String(bits[1])), int(String(bits[2])))
		out.append({"x": centre.x, "z": centre.z,
			"depth": cell_depth_of_key(key),
			"label": "HELD %s:%s" % [String(bits[1]), String(bits[2])]})
	out.sort_custom(func(a, b) -> bool:
		return float((a as Dictionary)["depth"]) < float((b as Dictionary)["depth"]))
	return out.slice(0, 4)


func cell_depth_of_key(key: String) -> float:
	# "pyx01:7:-3" -> the depth of that cell's centre. Main owns this glue for
	# drop_beacon_here's reason inverted: GameState deliberately holds coverage
	# as opaque strings and never references DeepSpace (the class-name edge
	# would point back at a file that already reaches the GameState autoload),
	# so the world half of the question is answered here, where both ends are
	# safe to name. ONE source: the counter's band join, the rival check and the
	# mast's heads-up all read this, so they cannot disagree about where a cell
	# is.
	var bits := key.split(":")
	if bits.size() != 3:
		return -1.0
	var centre := DeepSpace.cell_centre(int(String(bits[1])), int(String(bits[2])))
	return maxf(Vector2(centre.x, centre.z).length()
		- SystemDB.bounds_of(String(bits[0])), 0.0)


func cell_band_of_key(key: String) -> int:
	var depth := cell_depth_of_key(key)
	return -1 if depth < 0.0 else DeepSpace.band_of(depth)


func file_charts_on_sale(good: String, units: int) -> int:
	# THE PROVENANCE HALF OF A CHART SALE, called by the port counter after the
	# market half has already settled. Selling a reading's worth of a band's
	# chart data files your oldest unfiled cells of that band -- one cell per
	# YIELD_UNITS sold, because one reading IS what a mast yields -- and pays
	# the first-filing bonus for each. Returns the bonus paid.
	#
	# THE BONUS IS A BONUS, NOT THE PRICE. This function touches no cargo and
	# no coverage: the sale already unloaded and paid market price before it was
	# called, and a player who never thinks about filing loses nothing they had
	# yesterday. What it touches is the filed set and the wallet, and both only
	# ever move forward.
	#
	# Cross-system on purpose. Chart data is data -- you carry pyx01's readings
	# to a pyx03 counter and they file just the same. The band must match the
	# good because the good IS the band; that is the only join there is.
	#
	# A HALF-READING FILES NOTHING, and the remainder does not carry. Selling
	# one unit of a two-unit reading is selling half a coordinate; the counter
	# files whole cells or none, statelessly, and the next two-unit sale starts
	# fresh. A carried remainder would be save state for a bookkeeping trick.
	var band := CommodityDB.chart_band_of(good)
	if band < 0 or units <= 0:
		return 0
	@warning_ignore("integer_division")
	var readings := units / SurveyMast.YIELD_UNITS
	if readings <= 0:
		return 0
	var per := int(round(float(CommodityDB.base_price(good))
		* float(SurveyMast.YIELD_UNITS) * FIRST_FILING_RATE))
	# v22 commit 3: THE RIVAL GETS THERE FIRST SOMETIMES, and the counter is
	# where you find out. A rival-filed cell is swept out of the unfiled ledger
	# without pay and WITHOUT consuming a reading slot -- your readings' bonus
	# slots go to cells that can still pay, which is the concrete form of THE
	# RIVAL NEVER TAKES WHAT YOU HAVE: they take the chance, never the goods,
	# and never another cell's bonus with it.
	var filed := 0
	var lost := 0
	for key_v in GameState.unfiled_cells():
		var key := String(key_v)
		if cell_band_of_key(key) != band:
			continue
		if Rival.filed(key, cell_depth_of_key(key), GameState.run_seed,
				GameState.played_seconds):
			if GameState.note_survey_filed(key):
				lost += 1
			continue
		if filed < readings and GameState.note_survey_filed(key):
			filed += 1
	if filed <= 0 and lost <= 0:
		return 0
	var bonus := per * filed
	if filed > 0:
		GameState.add_salvage(bonus)
		GameState.note_ledger("cells_filed", filed)
	if hud:
		# One toast, not two: a second show_toast in the same frame overwrites
		# the first, and the money is the headline.
		# v25 (§97). The counter's verdict re-reads too, and only the words move:
		# the cell is swept and the bonus withheld exactly as before. "Another
		# hand" is what a stranger's mark is; "a colleague" is what the same mark
		# is to somebody who has clipped their own returns to the same masts.
		var colleague := GameState.files_with_the_network()
		if filed > 0 and lost > 0:
			hud.show_toast("FILED FIRST — %d CELL%s · +%d (%d %s)" % [
				filed, "" if filed == 1 else "S", bonus, lost,
				"ALREADY HELD BY A COLLEAGUE" if colleague
				else "ALREADY FILED BY ANOTHER HAND"], Palette.GOLD)
		elif filed > 0:
			hud.show_toast("FILED FIRST — %d CELL%s ON THE RECORD · +%d" % [
				filed, "" if filed == 1 else "S", bonus], Palette.GOLD)
		else:
			hud.show_toast("%d CELL%s %s" % [lost, "" if lost == 1 else "S",
				"ALREADY HELD — A COLLEAGUE WAS HERE" if colleague
				else "ALREADY FILED — SOMEBODY IS OUT HERE"], Palette.RIVAL)
	return bonus


func network_filing_plan() -> Dictionary:
	# WHAT A FILING AT THIS MAST WOULD DO, computed and never applied. Returned
	# as {cells, goods, lost} so the beacon can decide whether to offer the verb
	# at all, and so an assertion can ask the question without performing it.
	#
	# THE GOODS ARE THE PRICE, so the goods are also the LIMIT. The counter's
	# join is "the band must match the good because the good IS the band"; this
	# is that join read the other way -- for every chart good in the hold, the
	# whole readings it holds file that many cells of the good's own band. A
	# pilot with two units of chart_drift files one band-2 cell and nothing
	# else, however many thousand cells their coverage holds.
	#
	# That bound matters twice: unfiled_cells() spans EVERY system and can carry
	# a thousand keys, while a hold caps near a hundred units -- so "file
	# everything at once" without the goods join would file cells the pilot has
	# nothing to pay with, and the two halves would drift apart silently.
	var plan := {"cells": [], "goods": {}, "lost": []}
	for good_v in GameState.cargo:
		var good := String(good_v)
		var band := CommodityDB.chart_band_of(good)
		if band < 0:
			continue
		@warning_ignore("integer_division")
		var readings := int(GameState.cargo[good_v]) / SurveyMast.YIELD_UNITS
		if readings <= 0:
			continue
		var taken := 0
		for key_v in GameState.unfiled_cells():
			var key := String(key_v)
			if cell_band_of_key(key) != band:
				continue
			# THE RIVAL'S CELLS COME HOME FREE, and this is the counter's sweep
			# with its meaning inverted. At a counter a rival-filed cell is a
			# loss: swept out of the ledger, no bonus, somebody was first. Here
			# the somebody IS the network -- their colleague already clipped
			# that mark to a mast -- so it is held without costing a reading.
			# THE RIVAL NEVER TAKES WHAT YOU HAVE still holds: they took the
			# chance, and out here the chance was never money.
			if Rival.filed(key, cell_depth_of_key(key), GameState.run_seed,
					GameState.played_seconds):
				(plan["lost"] as Array).append(key)
				continue
			if taken >= readings:
				continue
			(plan["cells"] as Array).append(key)
			taken += 1
		if taken > 0:
			(plan["goods"] as Dictionary)[good] = taken * SurveyMast.YIELD_UNITS
	return plan


func file_charts_with_network() -> int:
	# THE VERB THE LAST FRAGMENT ASKS FOR. Deliberately NOT a branch inside
	# file_charts_on_sale: that function is the counter's, it pays a bonus and
	# moves the ledger, and THE BONUS IS NOT THE PRICE asserts that it touches
	# no cargo at all. Two verbs, two functions, no flag between them.
	#
	# Returns HOW MANY CELLS THE NETWORK NOW HOLDS -- both the cells this hold
	# paid readings for and the ones a colleague had already filed. Counting only
	# the paid half would be a lie the store could contradict: a hold where every
	# matching cell was rival-reached moves N cells from unfiled to held, queues
	# a save, and would have returned zero -- so the caller would announce
	# "NOTHING NEW TO FILE" for an irreversible act that had just happened. That
	# is routine rather than exotic, since the rival takes the shallows inside a
	# couple of hours of play.
	var plan := network_filing_plan()
	var cells: Array = plan["cells"]
	var lost: Array = plan["lost"]
	if cells.is_empty() and lost.is_empty():
		return 0
	# v28 (§115). THE ONE PLACE THAT KNOWS WHOSE RETURN PAID, and therefore the
	# only place the distinction can be recorded. `cells` are the ones this
	# hold's goods bought; `lost` are the ones a colleague had already clipped
	# to a mast, which network_filing_plan sorted a few lines up by asking
	# Rival.filed AT THIS INSTANT. That instant is the whole fact: the
	# predicate is monotone, so asking it again tomorrow says "a colleague was
	# here" about both piles. Written down now or not at all.
	for key_v in cells:
		GameState.note_survey_held(String(key_v))
	for key_v in lost:
		GameState.note_survey_held(String(key_v), true)
	# §111. FILING'S FEED, and the ONE thing this verb has ever paid in besides
	# a bearing. Counted on `cells` and deliberately NOT on `lost`: those came
	# home free because a colleague had already reached them, and a ladder that
	# rose for work somebody else did would be the "pays for running" shape the
	# skill law refuses by name. Still no credits, still no Commission -- a tier
	# buys time and reach at a plate, which is what filing is for.
	if not cells.is_empty() and GameState.mark_skill("filing", cells.size()) and hud:
		hud.show_toast("FILING %d — %s" % [GameState.skill_tier("filing"),
			String((GameState.SKILL_PERKS["filing"] as Array)[
				GameState.skill_tier("filing")])], Palette.GOLD)

	# THE GOODS LEAVE LAST, after the marks are safe. No credits, no bonus, no
	# cells_filed, no chart_data_sold: the Commission cannot hear about this and
	# the wallet does not move. The whole payment is that somebody reads it --
	# and, since §111, that the hand doing it gets quicker.
	for good_v in (plan["goods"] as Dictionary):
		GameState.unload_cargo(String(good_v), int(plan["goods"][good_v]))
	if hud:
		hud.refresh_cargo()
	return cells.size() + lost.size()


# The channel never gives the same name twice, and never gives a real one.
# Every name in this arc is what somebody ELSE calls them; this is the one
# surface where they speak for themselves, so it is the one surface that must
# not settle into an identity.
const CHANNEL_SENDERS := [
	"A CHANNEL, KEPT OPEN — LISTENING",
	"A CHANNEL, KEPT OPEN — NO CALL SIGN OFFERED",
	"SOMEBODY'S RELAY — THE HANDSHAKE IS OLD",
	"A KEPT CHANNEL",
	"· · · — A CARRIER THAT ANSWERS",
]


# §96. The channel's answer, waiting its turn. The filing hold raises TWO
# plates four seconds apart -- the page at the read stop, the reply at the
# filing stop -- and show_broadcast has no queue: the second kills the first.
# So following the prompt's own instruction ("keep holding") would destroy the
# page the player had just held three seconds to earn, and page 5 is the one
# this arc calls its spine. Deferred behind broadcast_busy, _standing_pending's
# shape and _standing_pending's argument.
var _network_reply_pending := {}


func network_reply(cells: int, at: Vector3) -> void:
	# THE ANSWER, SPOKEN AT THE MAST. The draft hung this on the next outward
	# band crossing, riding the after-register's slot -- and that is unreachable
	# where it matters: _tick_broadcast fires only on band > _broadcast_band,
	# band tops out at 6, and this verb lives on band-3+ beacons. A pilot who
	# files in THE UNSOUNDED has already spent every crossing getting there, so
	# the reply would have been silent in exactly the place a filing is most
	# likely. Two per-system overrides would have eaten it in two more.
	#
	# Answering at the mast is also the better beat: an irreversible act that
	# costs cargo should be answered where it happens, not fifteen minutes later
	# somewhere else.
	if hud == null:
		return
	# THE PAGE GETS ITS FULL DWELL. Held rather than dropped: a reply that
	# simply refused to speak while the plate was busy would lose the bearing
	# entirely, which is the payload -- Barks' own rule that a once-per-act
	# payload must not be consumed by being suppressed.
	if hud.has_method("broadcast_busy") and hud.broadcast_busy():
		_network_reply_pending = {"cells": cells, "at": at}
		return
	_network_reply_pending = {}
	var sender := String(CHANNEL_SENDERS[
		absi(hash("%s|%d|%d" % [system_id, cells, int(GameState.played_seconds)]))
		% CHANNEL_SENDERS.size()])
	# §98. THE REAL STORE, which is what the empty dictionary here was a
	# placeholder for. Through marks_read() rather than handing over marks_seen:
	# the generator asks bool() of what it is given and the store holds state
	# strings, so the conversion belongs to the one function that knows what a
	# state means. The channel now names a mark this pilot has NOT read, which
	# is the whole point of it naming one — repeating a bearing to a buoy they
	# already stood at would make the reply furniture.
	var mark := FarMarks.nearest_unseen(system_id, GameState.run_seed, at,
		GameState.marks_read())
	var body := ("Your return is read. It is held, and it is true, and somebody "
		+ "knows it. ")
	if mark.is_empty():
		# A SENTENCE FOR THE EMPTY CASE, because the alternative is quoting a
		# bearing of zero. A pilot who has resolved every mark in this system
		# has earned a different answer, not a broken one.
		body += "You have read every mark we keep in this system. There is nothing here we know that you do not."
	else:
		# The DIFFERENCE, never the world position (§60): a bearing is where the
		# player must turn, and at six thousand units an origin-relative number
		# is one nobody can fly.
		var player: PlayerShip = get_tree().get_first_node_in_group("player")
		var from: Vector3 = player.global_position if player else at
		var deg := DeepSpace.compass_deg((mark["pos"] as Vector3) - from)
		body += "There is a mark at bearing %03d, %s out — it is ours, and now it is yours to read." % [
			deg, _comma_int(int(mark["range"]))]
		# 48 CHARACTERS IS THE WHOLE LINE (note_log truncates at LOG_LINE_MAX
		# with no warning), and the bearing is the payload -- so the bearing goes
		# early enough to survive. The draft's version was 63 characters and
		# would have been cut exactly where the number started.
		GameState.note_log("NETWORK HOLDS IT — A MARK AT %03d" % deg)
	hud.show_broadcast(sender, body, Palette.RIVAL)


func legend_arrives(mark_system: String, index: int, kind: String, at: Vector3) -> void:
	# §99. THE OTHER CALLER OF build_legend, and the reason there is only one
	# function to call. SystemBuilder raises a read mark's legend on every
	# rebuild; this raises it at the moment of the reading, so a pilot who has
	# just held three seconds on a buoy does not have to warp out and back to
	# see what the plate was talking about.
	#
	# Main is the one node that holds system_root and already references
	# SystemBuilder, so the world class asking for this reaches it through a
	# group lookup and a has_method -- no second class edge, and nothing in
	# SoundingMark names a builder.
	if system_root == null or mark_system != system_id:
		return
	SystemBuilder.build_legend(system_root, mark_system, index, kind, at)
	if kind == "procession":
		_procession_passes_a_kept_light()


# §117. THE UNCOUNTED HUNDREDS AND ONE LIGHT SOMEBODY KEEPS. Nothing in the
# world moves and nothing is spawned: every piece of this already exists and
# none of them were pointed at each other.
#
# BROADCASTS[5] is titled A KEPT LIGHT and says "there is a light ahead of you,
# it is kept, and by somebody"; its `body_after` closes with "it is lit for
# whoever is still out here, which by the authority's own ledger now includes
# you". COLONIAL's t3 perk is named KEPT LIGHTS -- a founded colony borrows
# TIER_HOME so its light never fades. And the Procession is seven named hulls
# that filed and were never counted, in front of four hundred more. The player's
# colony IS a kept light, in the game's own words. This is the sentence that
# says so once.
var _kept_light_spoken := false


# §119. Held rather than dropped when the plate is busy -- the signal fires once
# ever and GameState's flag is already set, so refusing here would lose the line
# for the whole run. _network_reply_pending's shape and its argument.
var _eleventh_pending := false


func _the_eleventh() -> void:
	# §119. NO PAYOUT. Not a credit, not a stat, not a tier, not a store, and
	# not a second grant of any kind -- `NO LADDER PAYS IN CREDITS` climbs every
	# ladder to its cap watching the wallet, and this arrives at exactly the
	# moment that leg is standing on. What the eleventh rung buys is a sentence.
	#
	# THE SENDER IS THE ONE THAT HAS NEVER GIVEN A NAME. `CHANNEL_SENDERS` is
	# the network's own set and every one of them is a description rather than a
	# call sign; the band-6 broadcast is three dots. This uses the same set, so
	# the voice that answers here is the voice that has answered every filing.
	#
	# It rides show_broadcast rather than the prompt line, which is a different
	# surface with a different owner -- so none of §113's collision applies and
	# commit 7's soft lock is not a dependency.
	if hud == null:
		return
	if hud.has_method("broadcast_busy") and hud.broadcast_busy():
		# UNSPOKEN RATHER THAN SPENT (§117's rule, and Barks.fire's): the flag
		# that guards this lives in GameState and is already set, so the signal
		# will not come again -- which means refusing here would lose the line
		# for the run. Deferred by one frame instead, through the same call the
		# network reply uses when the page is busy.
		_eleventh_pending = true
		return
	_eleventh_pending = false
	var sender := String(CHANNEL_SENDERS[
		absi(hash("eleventh|%d" % GameState.run_seed)) % CHANNEL_SENDERS.size()])
	hud.show_broadcast(sender,
		"There is nothing further we can teach you, and that is not a "
		+ "compliment. Every hand that reached this point is on the "
		+ "attachment. You are not being congratulated. You are being "
		+ "recognised, which is the only thing we have ever been able to do "
		+ "for anybody, and it is why we keep the lights on.", Palette.RIVAL)


func _procession_passes_a_kept_light() -> void:
	# ONE SCRIPTED INTERSECTION, ONCE PER RUN, AND IT PAYS NOTHING. §105 is
	# emphatic that the formation "never spends its mark" and that a set of ten
	# legends needs one that only asks; this must not become the thing that
	# breaks that. No credits, no standing, no ledger, no store.
	#
	# FIRED AT ARRIVAL RATHER THAN AT A HULL. The hulls answer taps on the same
	# plate and refuse each other with SLOWLY precisely because it has no queue
	# -- adding a second speaker to that moment would be the collision §113 spent
	# a red on. Arrival is the beat before any of that starts.
	#
	# THE ORDERING IS STATED RATHER THAN GUARDED. A pilot who founds their first
	# colony AFTER meeting the procession never hears this, and that is allowed:
	# the marks sit at 6,500-9,000u and hyper structures at 1,600-4,200u, so
	# anybody standing at this formation has flown past the colonies twice. A
	# second trigger on the founding verb would cover a case the geometry barely
	# permits, at the cost of a second call site that could fire it late and
	# out of any moment at all.
	if _kept_light_spoken or hud == null:
		return
	if GameState.colonies.is_empty():
		return
	# ASK FIRST, never clobber -- §96's rule for this plate, which the procession
	# itself enforces on its own hulls. Unspoken rather than spent if the plate
	# is busy: a once-per-run sentence must not be consumed by being suppressed
	# (Barks.fire's rule, honoured from the other side), so the flag is set only
	# when the plate actually carries it.
	if hud.has_method("broadcast_busy") and hud.broadcast_busy():
		return
	_kept_light_spoken = true
	hud.show_broadcast("· · ·",
		"The line is passing a light. It is kept, and it is kept by you. "
		+ "Nothing in the formation acknowledges it. They filed for eleven "
		+ "years and were received and were never read, and they are still "
		+ "pointed home; you are the first thing on this bearing in a long "
		+ "time that somebody is still keeping a light for.", Palette.RIVAL)


func drop_beacon_here() -> bool:
	# The world half of the verb: gather what GameState cannot know (where the
	# ship is, how deep that is) and hand it to the rule. §59's argument shape.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or state != State.PLAYING or warping or tutorial_active():
		return false
	var pos := player.global_position
	var depth := deep_depth()
	if not GameState.drop_beacon(system_id, pos.x, pos.z, depth):
		if hud:
			# WHICH refusal, per §58's copy rule — "it didn't work" teaches
			# nothing. Inside the chart the chart is the reason; otherwise it
			# can only have been stock.
			if depth <= 0.0:
				hud.show_toast("THE CHART ALREADY REMEMBERS THIS PLACE — BEACONS ARE FOR THE DEEP",
					Palette.AMBER_DIM)
			else:
				hud.show_toast("NO BEACONS LEFT — RECOVER ONE TO REUSE IT", Palette.THREAT)
		return false
	var b := Beacon.new()
	b.system_id = system_id
	system_root.add_child(b)
	b.global_position = Vector3(pos.x, 0.0, pos.z)
	Sfx.play("equip", -10.0, 0.9)
	if hud:
		hud.show_toast("BEACON DROPPED — %d IN STOCK" % GameState.beacon_stock_left(),
			Palette.GOLD)
	return true


# --- beacon navigation (v21) -------------------------------------------------

# THE JUMP REACHES NO FURTHER THAN THE INSTRUMENTS DO. Beacons have no depth
# bound -- the drop verb only refuses inside the chart -- and band 6 starts at
# 5200u, so an unbounded jump would be a permanent 500-credit door into the
# richest seams in the game. Capping it at HYPER_DEPTH_MAX is not a balance
# nudge: it is what keeps A FOOTHOLD, NOT A FARM's derivation exact, since that
# assertion measures the deepest REACHABLE point as
# bounds_of("pyx03") + HYPER_DEPTH_MAX and would go on passing while the real
# maximum moved out from under it.
#
# It also has an in-fiction reason, which is the test of whether a bound belongs:
# the colony network is what a jump rides, and past the deepest structure there
# is nothing to ride to. Beyond the cap the beacon still takes a COURSE. The
# refusal removes the shortcut, never the destination.
const BEACON_JUMP_MAX_DEPTH := SystemDB.HYPER_DEPTH_MAX
# Scaled by depth and capped at the colony fee, so a jump is never the cheaper
# way to reach a colony you founded -- that verb is the earned one.
const BEACON_JUMP_MIN_FEE := 120

# §109. THE TUG. Dying deep used to be FREE, and the comment two screens down
# claiming it "keeps dying the expensive exit rather than the convenient one"
# was aspirational rather than true: an emergency warp teleports you home from
# any depth at no charge, which made it strictly cheaper than the 120-500 credit
# beacon jump and therefore the best fast travel in the game.
#
# §123 RE-PRICES IT AND CUTS IT LOOSE. The original walked beacon_jump_fee's own
# ramp at twice the price, which put the deepest possible death at 1,869 --
# EIGHTY SECONDS of standard-loop income against the loop the sweep actually
# measures. The arithmetic was right and the anchor was not: the jump's own fee
# had never been anchored to anything either, so the death price was a multiple
# of a guess. That is exactly the defect §114 named, and this is its last site.
#
# ITS OWN CONSTANTS NOW, and they express loop-fraction intent rather than a
# multiple of a neighbour. ~240 just past the chart edge, ~900 at a shallow deep
# death, ~2,700 at the band-6 floor, RESCUE_FEE_FAR at the marks.
#
# AND THE FAR CONSTANT IS DERIVED FROM A MEASUREMENT RATHER THAN A FEELING,
# which the first draft of this line is the argument for. It shipped at 13,000
# against an ESTIMATED steady loop of ~32,500 -- a figure carried through four
# documents and never once measured. The sweep put the loop at 11,236, a THIRD
# of the estimate, and both new legs went red on the first run exactly as the
# band was built to. 4,500 is 0.40 of the measured loop: mid-band, and inside
# the ceiling by a factor of two and a half.
const RESCUE_FEE_EDGE := 240
const RESCUE_FEE_FAR := 4500

# AND IT CLAMPS AT THE FAR MARKS, which reverses §109's decision rather than
# forgetting it. §109 refused beacon_jump_fee's clamp because that one sits at
# BEACON_JUMP_MAX_DEPTH (4,200) while content runs out to 9,000 -- flattening
# the bill across the entire far deep, "cheapest exactly where it should cost
# the most". This clamp sits at the far marks THEMSELVES: FarMarks.DEPTH_MAX is
# the deepest authored thing in the game, so there is no content in the flat
# region at all. The ramp measures the flight home, and past the marks there is
# nothing out there the tug could have been called to.
#
# It also makes §114's ceiling law TOTAL rather than sampled. Unclamped, a fee
# rising forever crosses one measured loop somewhere past ~60,800u -- true of a
# pilot who flew into empty space, invisible to a leg that checks one depth, and
# a promise ("an involuntary charge larger than a loop deletes the session
# before it") quietly broken out where nobody looks.
#
# The numbers are provisional and they are all in this block, §99's posture --
# the LAWS are what is asserted (deeper costs more, always more than a jump,
# nothing at all inside the chart, and the band below), so a retune changes two
# constants and no assertion.
#
# THE BAND IS THE POINT OF THE RE-PRICING. A one-time raise is a nudge that
# expires: yields move, the loop grows, and the death price silently becomes
# eighty seconds again with nothing to notice. So the deepest fee is pinned
# to a FRACTION of the loop PACINGTEST measures, income's own instrument shape
# -- an authored constant, a measured ratio, and a red when they drift apart.
# THE DEATH PRICE SITS IN ITS BAND is the leg.
const RESCUE_BAND_MIN := 0.30
const RESCUE_BAND_MAX := 0.50

# THE CLAIM. A spill used to be immortal: `spill` cubes skip the 25s reaper, so
# cargo dropped at a deep death sat there for the rest of the visit and the whole
# penalty was the flight back. It now has a clock, and the clock is generous
# because the flight back is real -- three minutes plus a further second and a
# half per hundred units of depth, so ~390s at 1,400u and ~25 minutes out at the
# marks. Long enough to be fair, short enough to be a reason to hurry.
const SPILL_CLAIM_BASE := 180.0
const SPILL_CLAIM_PER_DEPTH := 0.15
const SPILL_CLAIM_WARN := 30.0


# Seconds left before somebody else takes what you dropped. 0 = nothing adrift.
var _spill_claim_left := 0.0
var _spill_warned := false
# §128. Said once per spill, cleared everywhere _spill_warned is.
var _spill_lit := false


func rescue_fee(depth: float) -> int:
	# DEPTH 0 IS FREE, and that is the tutorial's promise kept literally: inside
	# the charted system you lose position and tempo and nothing else, which is
	# what it was taught with and what CHART DEATH INTACT asserts.
	if depth <= 0.0:
		return 0
	# Its own ramp, over the FAR MARKS rather than over the jump's cap -- see the
	# constants block for why this one clamps where §109's refused to.
	var t := clampf(depth / FarMarks.DEPTH_MAX, 0.0, 1.0)
	return int(round(lerpf(float(RESCUE_FEE_EDGE), float(RESCUE_FEE_FAR), t)))


func spill_claim_seconds(depth: float) -> float:
	return SPILL_CLAIM_BASE + maxf(depth, 0.0) * SPILL_CLAIM_PER_DEPTH


func charge_rescue(at: Vector3) -> int:
	# Billed by whoever came and got you. Called from PlayerShip._emergency_warp
	# beside spill_unread, and living here for the same reason that one does: the
	# ship owns the tween, Main owns the rule (drop_beacon_here's split).
	if deep_space == null:
		return 0
	var fee := rescue_fee(deep_space.depth_at(at))
	if fee <= 0:
		return 0
	# THE TUG TAKES WHAT YOU HAVE AND NEVER REFUSES. A rescue that could fail for
	# want of credits is a soft-lock with a story attached -- there is no other
	# way out of a shield-zero ship -- and a debt is a second currency the game
	# does not have. So it bills what is in the account and writes the rest off.
	var paid := mini(fee, GameState.salvage)
	if paid > 0:
		GameState.spend_salvage(paid)
	if hud:
		hud.show_toast("TUG'S FEE — %s SALVAGE%s" % [_comma_int(paid),
			"" if paid >= fee else " (ALL YOU HAD)"], Palette.THREAT)
		hud.set_value(GameState.salvage)
	return paid


func _tick_spill_claim(delta: float) -> void:
	# Somebody else out here works the same wrecks you do. No AI and no class:
	# what a claimant IS, mechanically, is a deadline on cargo you are not
	# standing next to.
	if _spill_claim_left <= 0.0:
		return
	var adrift := _spill_cubes()
	if adrift.is_empty():
		# Recovered, or abandoned by a warp. Either way the clock is not running.
		_spill_claim_left = 0.0
		_spill_warned = false
		_spill_lit = false
		return
	# §128, THE LIGHT. The clock STOPS rather than the claim being cancelled, and
	# the difference matters: a pilot who tows a spill out from under the light
	# is back on the deadline they had, with the seconds they had left. Nothing
	# is granted permanently -- what the work buys is that this ground is watched.
	#
	# ASKED OF THE SPILL, NOT THE SHIP. The pilot is by construction somewhere
	# else while this runs (§118's whole argument), so reading the player's
	# position would make the grant fire exactly when it is not needed and never
	# when it is.
	if GameState.light_aura_at((adrift[0] as Node3D).global_position.x,
			(adrift[0] as Node3D).global_position.z):
		# AND IT SAYS SO ONCE, §88: a grant a pilot cannot perceive is one they
		# cannot decide with, and the alternative here is SILENCE -- the 30s
		# warning simply never arriving, which is indistinguishable from the
		# clock still running.
		if not _spill_lit:
			_spill_lit = true
			if hud:
				hud.show_toast("UNDER THE LIGHT — NOTHING OUT THERE TAKES IT",
					Palette.TEAL)
		return
	_spill_claim_left -= delta
	if not _spill_warned and _spill_claim_left <= SPILL_CLAIM_WARN:
		_spill_warned = true
		if hud:
			hud.show_toast("SOMEBODY IS WORKING YOUR SPILL", Palette.THREAT)
	if _spill_claim_left > 0.0:
		return
	var where: Vector3 = (adrift[0] as Node3D).global_position
	var taken := adrift.size()
	# §118. WHAT THE CLAIMANT LEFT, and until now the answer was nothing at all:
	# this function called neither note_log nor note_ledger, so the entire record
	# of a claim was a toast that scrolled away. That is the one branch of §109's
	# clock the player is BY DESIGN not standing in -- the window is 180s plus
	# 0.15s per unit of depth, far longer than the flight back, so it expires
	# only when the pilot decided not to return. A thing that happens to you
	# while you are elsewhere and leaves no trace did not happen.
	#
	# THE CLAIMANT STAYS FACELESS, and three louder versions died first. A hull
	# that arrives and works the spill needs §64's ALLIED-splash question
	# answered (shootable is a combat encounter, unshootable is a ghost) and
	# plays to an empty room by construction. A deep market event on the claimed
	# good hits EVENT_MAX_DEEP := 1 and §108's bias-table bound -- no deep
	# station's bias table holds a single salvage good, which is exactly the
	# unbounded case that comment closes. And a NAMED claimant is the first named
	# living stranger in this game, which §105 spent two horizons refusing to
	# spend "for a caption": a writing-pass decision, not a side effect of a
	# timer. What is left is the truest thing: a record.
	var band_word := DeepSpace.band_name(deep_space.depth_at(where)) \
		if deep_space != null else "THE DEEP"
	GameState.note_ledger("spills_lost", taken)
	# 48 CHARACTERS IS THE WHOLE LINE (note_log truncates at LOG_LINE_MAX with
	# no warning), so the count and the place go first and the verb is short.
	GameState.note_log("CLAIMED — %d ADRIFT IN %s" % [taken, band_word])
	for c in adrift:
		c.queue_free()
	_spill_claim_left = 0.0
	_spill_warned = false
	_spill_lit = false
	FX.flash(system_root, where, Palette.THREAT, 3.0, 0.4)
	if hud:
		# WHAT AND WHERE, not just that it happened (§58's copy rule applied to
		# a loss): a pilot who is told only "claimed" cannot tell which of two
		# deaths this was.
		hud.show_toast("CLAIMED IN %s — %d CRATE%s, SOMEBODY ELSE GOT THERE FIRST"
			% [band_word, taken, "" if taken == 1 else "S"], Palette.THREAT)


func beacon_jump_fee(depth: float) -> int:
	var t := clampf(depth / BEACON_JUMP_MAX_DEPTH, 0.0, 1.0)
	return int(round(lerpf(float(BEACON_JUMP_MIN_FEE), float(COLONY_JUMP_FEE), t)))


func can_beacon_jump(depth: float) -> bool:
	# can_colony_jump's guard set plus the depth cap. Same clock, same states.
	return state == State.PLAYING and not warping and not boss_active \
		and docked_port == null \
		and depth <= BEACON_JUMP_MAX_DEPTH \
		and GameState.salvage >= beacon_jump_fee(depth) \
		and colony_jump_ready_in() <= 0.0


func set_course_to(pos: Vector3, label: String) -> bool:
	# The free half of the pair. No fee, no clock -- it is the flight you would
	# have flown, aimed for you.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or state != State.PLAYING or warping:
		return false
	player.command_course(Vector3(pos.x, 0.0, pos.z))
	if not player.course_active():
		# command_move no-ops while docked, warping or EMP-stunned and says
		# nothing. Without this the CRS row would light for a course the ship
		# never took -- a button that appears to work is worse than one that
		# refuses, which is 58's whole argument.
		if hud:
			var why := "CANNOT SET A COURSE FROM HERE"
			if docked_port != null:
				why = "NOT WHILE DOCKED — DEPART FIRST"
			elif player.is_emp_stunned():
				why = "DRIVES ARE DOWN — NO COURSE WHILE STUNNED"
			hud.show_toast(why, Palette.THREAT)
			Sfx.play("hit", -10.0, 0.7)
		return false
	_course_label = label
	_course_was_active = true
	if hud:
		hud.set_course_name(label)
		hud.show_toast("COURSE SET — %s, %s" % [label, _course_line(pos)], Palette.TEAL)
	Sfx.play("equip", -11.0, 1.05)
	# Once ever, and it says the part the row cannot: that the ship will abandon
	# the course on its own. A player who does not know that reads the first
	# self-cancel as the autopilot breaking.
	Barks.fire("first_course")
	return true


func _course_line(pos: Vector3) -> String:
	# Through compass_deg, per 60: a bearing the player is shown is the same
	# bearing the cockpit shows, or the two instruments disagree about north.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var from := player.global_position if player != null else Vector3.ZERO
	var to_it := Vector3(pos.x - from.x, 0.0, pos.z - from.z)
	return "%03d · %dU" % [DeepSpace.compass_deg(to_it), int(round(to_it.length()))]


func beacon_jump_to(x: float, z: float, depth: float, label: String) -> void:
	var fee := beacon_jump_fee(depth)
	if not can_beacon_jump(depth):
		if hud:
			# WHICH refusal, per 58. The depth one names the alternative,
			# because there always is one: the course is free and unbounded.
			var why := "JUMP UNAVAILABLE"
			if depth > BEACON_JUMP_MAX_DEPTH:
				why = "TOO DEEP TO JUMP — SET A COURSE INSTEAD"
			elif GameState.salvage < fee:
				why = "JUMP COSTS %d — NOT ENOUGH BANKED" % fee
			elif colony_jump_ready_in() > 0.0:
				why = "DRIVES STILL COOLING — %ds" % int(ceil(colony_jump_ready_in()))
			elif boss_active:
				why = "NOT WITH AN ENGINE AWAKE"
			elif docked_port != null:
				why = "NOT WHILE DOCKED — DEPART FIRST"
			hud.prompt(why)
			Sfx.play("hit", -10.0, 0.7)
		return
	if not GameState.spend_salvage(fee):
		return
	GameState.last_outbound_jump = GameState.played_seconds
	warping = true
	clear_course("")
	_beacon_jump_sequence(Vector3(x, 0.0, z), label)


func _beacon_jump_sequence(at: Vector3, label: String) -> void:
	# _colony_jump_sequence's beats. NOT extracted into a shared helper, and the
	# reason is a four-unit difference that a naive extraction erases: recall
	# puts the rig at Vector3(0, 0, 2) while the ship goes to SPAWN_POINT
	# (0, 0, 6) -- four units IN FRONT of the ship -- whereas the colony jump
	# uses arrive + (0, 0, 2), two units behind it. A helper computing
	# `dest + (0, 0, 2)` would silently move recall's camera by six units.
	#
	# EMPHATICALLY NO _load_system, for that function's own stated reason: it
	# frees SystemRoot wholesale, which would reset the apex, respawn the
	# garrison, delete loot still drifting toward the player and reroll every
	# deep sector -- all for a move that never leaves the system.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig")

	if player:
		player.begin_warp_charge()
	Sfx.play("warp", -3.0, 0.75)
	if rig:
		rig.punch_zoom(1.6)
	await get_tree().create_timer(WARP_CHARGE).timeout

	if player:
		player.warp_streak_out()
	if rig:
		rig.shake(0.12)
	_star_streaks()
	await get_tree().create_timer(WARP_STREAK * 0.55).timeout
	FX.flash(self, Vector3(0, 0, 4), Palette.WHITE_HOT, 26.0, 0.5)
	await get_tree().create_timer(WARP_STREAK * 0.45).timeout

	# ARRIVE BESIDE IT, not on it. A beacon is a 1u mast rather than a 140u
	# silhouette, so the offset is small -- but landing exactly on the anchor
	# would put the hull inside the hold prompt's range and start a recovery the
	# player did not ask for.
	var arrive := at + Vector3(Beacon.HOLD_RANGE * 1.2, 0.0, 0.0)
	if player:
		player.teleport_to(arrive)
		player.velocity = Vector3.ZERO
		player.clear_target()
		player.warp_streak_in()
	if rig:
		rig.global_position = arrive + Vector3(0, 0, 2)

	Sfx.play("breach", -12.0, 1.3)
	FX.shockwave(self, arrive, Palette.GOLD, 9.0, 0.9)
	if hud:
		hud.show_toast("ARRIVED — %s" % label, Palette.GOLD)
	await get_tree().create_timer(WARP_ARRIVE).timeout
	warping = false


func clear_course(reason: String) -> void:
	# ONE EXIT, so every way a course can end says so exactly once. A silently
	# dropped 700-second course reads as a bug, which is why reason is required
	# rather than optional -- an empty string is the deliberate "no toast" case
	# and the caller has to type it.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player != null and player.course_active():
		player.has_move_target = false
	player_course_end(reason)


func player_course_end(reason: String) -> void:
	if not _course_was_active:
		return
	_course_was_active = false
	if hud:
		hud.set_course_name("")
		if reason != "":
			hud.show_toast(reason, Palette.AMBER_DIM)
	_course_label = ""


func _tick_course(_delta: float) -> void:
	# AN UNATTENDED COURSE IS OTHERWISE A DEATH SENTENCE. A 4,000u course is
	# ~730s of flight across ~62 cells; at band 4 roughly half of them arm a nest
	# within trigger range of a straight line, and _tick_return_fire never sets
	# attack_target -- so being shot at does not even interrupt the flight. The
	# course therefore drops itself, and says so every time.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return
	if not _course_was_active:
		return
	if not player.course_active():
		# It ended somewhere in PlayerShip -- arrival, the stick, an EMP, a dock.
		# Which one is answered by geometry rather than by a flag, because the
		# eight clear sites do not report a reason and adding one to each is the
		# drift this design exists to avoid.
		var reached := Vector2(player.global_position.x - player.course_dest.x,
			player.global_position.z - player.course_dest.z).length() <= COURSE_ARRIVE_U
		if reached:
			player_course_end("COURSE COMPLETE — %s" % _course_label)
		else:
			player_course_end("COURSE DROPPED — %s" % _course_label)
		return
	if boss_active:
		clear_course("COURSE DROPPED — AN ENGINE IS AWAKE")
		return
	# THE SAME NUMBER THE COCKPIT SHOWS. hud reads shield_fraction() for its HULL
	# readout, so the course aborts at the figure the player is looking at rather
	# than at a second one that could disagree with it.
	var frac := 1.0
	if player.has_method("shield_fraction"):
		frac = float(player.shield_fraction())
	if frac < COURSE_ABORT_HULL:
		clear_course("COURSE DROPPED — HULL AT %d%%" % int(round(frac * 100.0)))
		return
	if _threat_near(player.global_position, COURSE_THREAT_U):
		clear_course("COURSE DROPPED — CONTACT")


func _threat_near(at: Vector3, radius: float) -> bool:
	for h_v in get_tree().get_nodes_in_group("hostiles"):
		var h := h_v as Node3D
		if h == null or not is_instance_valid(h):
			continue
		if h.global_position.distance_to(at) <= radius:
			return true
	return false


func spawn_sentries() -> void:
	# Adds the system's garrison to the running scene without a rebuild. The
	# garrison is the engine's sentries AND the Cordon's pickets — one call,
	# because they are one list (SystemBuilder.build_garrison).
	SystemBuilder.build_garrison(system_def, system_root, system_id)


func start_new_game() -> void:
	GameState.reset_to_starter()
	# A real new game persists. Under a harness this is a no-op: lock_saving()
	# is one-way, precisely so PYXIS_TITLETEST pressing NEW SURVEY cannot write
	# a starter run over the player's save.
	GameState.save_enabled = true
	_enter_playing()
	tutorial.arm()          # before the build, so the garrison is left out
	_load_system(SystemDB.START_SYSTEM)
	hud.set_value(GameState.salvage)
	hud.refresh_cargo()
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.teleport_to(Vector3(0, 0, 6))
	# The rig has to come home too. Nothing moved it before because the old world
	# clamp guaranteed it was already near the origin; with space endless, a new
	# game started from 900 units out would open on empty sky.
	var rig := get_tree().get_first_node_in_group("camera_rig")
	if rig:
		rig.global_position = Vector3(0, 0, 2)
	tutorial.begin()


func continue_game() -> void:
	_enter_playing()
	if GameState.tutorial_step >= 0:
		tutorial.arm()      # resuming mid-tutorial keeps the world held back
	_load_system(GameState.current_system)
	hud.set_value(GameState.salvage)
	hud.refresh_cargo()
	hud.set_contracts(contracts.rows())
	if GameState.tutorial_step >= 0:
		tutorial.begin(GameState.tutorial_step)
	else:
		Barks.begin(self)


func tutorial_active() -> bool:
	return tutorial != null and tutorial.is_active()


# --- console doors ----------------------------------------------------------

func toggle_chart() -> void:
	# The chart hotkey's wrapper, and the reason the key does not call
	# chart_panel.open() itself. The panel lock is enforced on the BUTTON --
	# HUD.set_panels_locked flips chart_button.enabled -- so a second door that
	# skipped it would reopen the chart while docked or mid-apex fight, and
	# disengage_apex's comment says out loud that the fight is survivable
	# partly BECAUSE the chart is shut ("had to stand there").
	#
	# The lock is asked of the HUD rather than re-derived from docked_port and
	# boss_active here. Those two are what SET it today; a third place spelling
	# out the same condition is a copy that is free to drift the next time a
	# caller is added, and set_panels_locked already has three.
	if chart_panel == null:
		return
	if chart_panel.is_open:
		chart_panel.close_panel()
		return
	# The same two toggle_pause refuses on, for the same reasons: there is
	# nothing to chart from the title, and the warp sequence is a chain of
	# awaited timers a panel would open on top of.
	if state != State.PLAYING or warping:
		return
	if hud != null and hud.panels_locked:
		return
	chart_panel.open()


# --- pause ------------------------------------------------------------------

func toggle_pause() -> void:
	if pause_menu == null:
		return
	if pause_menu.is_open:
		pause_menu.resume()
		return
	# Nothing to pause behind a menu, and nothing to step out of mid-warp — the
	# warp sequence is a chain of awaited timers that would resume mid-flash.
	if state != State.PLAYING or warping:
		return
	pause_menu.open()


func abandon_to_title() -> void:
	# Back to the front door with the run intact. The world is rebuilt in attract
	# form (no garrison, ship parked) so the title sits over a live system again.
	if pause_menu and pause_menu.is_open:
		pause_menu.resume()
	if docked_port != null:
		undock()
	if port_panel and port_panel.is_open:
		port_panel.close_panel()
	if refit_panel and refit_panel.is_open:
		refit_panel.close_panel()
	if chart_panel and chart_panel.is_open:
		chart_panel.close_panel()
	_set_boss_active(false)
	_pending_dock = null
	state = State.ATTRACT
	# Same reason as start_new_game: the title sits over a live system, and
	# abandoning from deep space must not leave it sitting over nothing.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.teleport_to(PlayerShip.SPAWN_POINT)
	var rig := get_tree().get_first_node_in_group("camera_rig")
	if rig:
		rig.global_position = Vector3(0, 0, 2)
	_load_system(GameState.current_system)
	_enter_attract()


# --- system lifecycle -------------------------------------------------------

func rebuild_visuals() -> void:
	# Colour vision changed, so every baked material is now wrong. Rebuilt
	# through the EXISTING build paths -- _load_system for the charted system,
	# DeepSpace.rebuild for the expanse -- rather than through a bespoke retint
	# walk, because a second path that has to know about every material in the
	# game is a second path that will fall out of date with the first.
	#
	# Visible as a sub-second hitch on a settings change, which is honest: the
	# world really is being rebuilt, and it happens on a menu the player is
	# already stopped on.
	# NOT WHILE SOMETHING IS SHOOTING AT YOU. The engine is a SystemRoot child,
	# so _load_system frees the fight: the boss comes back DORMANT at full HP,
	# every probe and weld is gone, and boss_active is cleared -- a won fight
	# silently reset by a colour setting.
	#
	# Nothing gates the door. The pause menu opens mid-encounter
	# (set_panels_locked disables only refit and chart, never pause or Escape),
	# COLOUR VISION is on its root page, and the cycler changes value on every
	# press, so this is two taps from inside any boss fight in the game.
	#
	# Deferred rather than refused: it is a colour change, and the player asked
	# for it. _set_boss_active(false) is the one place every ending of an
	# encounter passes through -- kill, break off, death, leash -- so that is
	# where the retint is spent.
	if boss_active:
		_vision_rebuild_pending = true
		if hud:
			hud.show_toast("COLOURS APPLY WHEN THE FIGHT ENDS", Palette.AMBER)
		return
	_vision_rebuild_pending = false
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var at := player.global_position if player else PlayerShip.SPAWN_POINT
	_load_system(system_id)
	if player:
		player.teleport_to(at)
	if deep_space:
		deep_space.rebuild()
	if hud:
		hud.refresh_palette()


func _load_system(id: String) -> void:
	if not SystemDB.exists(id):
		id = SystemDB.START_SYSTEM
	system_id = id
	system_def = SystemDB.get_system(id)
	GameState.set_current_system(id)

	# A DEFERRED RETINT IS SATISFIED BY THIS, because this IS the rebuild. Cleared
	# BEFORE _set_boss_active(false) below, which is what spends the flag -- a
	# fight that ends by warping or dying already comes through here, and without
	# this the deferred call would fire a second, redundant world rebuild one
	# frame later. See rebuild_visuals.
	_vision_rebuild_pending = false
	# §109. Whatever was adrift is gone with the system that held it -- spill
	# cubes are system_root children and leaving abandons them, which WARP CLEARS
	# has asserted since §22. The clock must not survive the pile it was counting
	# down, or the next spill inherits a deadline that already half expired.
	_spill_claim_left = 0.0
	_spill_warned = false
	_spill_lit = false

	# Boss state never survives a system change: a DAMAGED engine resets to full on
	# warp or reload, because retreating costs tempo and never salvage. Clearing
	# the flag here is what stops a mid-fight warp-out from permanently stalling
	# the swarm spawner. A DESTROYED engine is a different question and is not
	# rebuilt at all — SystemBuilder._build_apex asks GameState.has_apex_down.
	_set_boss_active(false)
	_apex_wake_timer = -1.0
	# Raiders are children of SystemRoot and die with it, so the raid is over the
	# moment the world is swapped. Warping out of an interdiction IS the escape —
	# and it earns the same cooldown that fighting them off does, or the escape
	# hatch would be punished by dropping you into a fresh roll twenty seconds
	# later in the new system.
	if _raid_active:
		_raid_cooldown = RAID_COOLDOWN
	_raid_active = false
	# The rift died with system_root. Cleared explicitly rather than trusting
	# that a freed reference compares equal to null — it does, and relying on
	# that subtlety is how the next bug hides.
	# Storms die with system_root too, and are cleared for the same reason.
	live_storms.clear()
	live_rift = null
	# §106, S5. THE GROUND IS LOST BY WALKING OUT OF A SIEGE, and this is the
	# only place that can notice: every nursery node is a SystemRoot child and
	# dies in the free below, so a check made after the teardown would be made
	# on nothing. Asked of the NODE rather than of the store, because "is an
	# assault standing right now" is a fact about the world and not about the
	# save -- and leaving with the ground quiet is a supply run, not a rout.
	for n_v in get_tree().get_nodes_in_group("legend"):
		var nurse := n_v as TallyNursery
		if nurse != null and nurse.abandon_if_besieged():
			break
	# The convoy died with it too, same rule. _tick_procession will re-seat it
	# if this window's system is the one being loaded.
	_procession = null
	_raid_timer = RAID_ROLL_INTERVAL
	# AND THE MUSTER, which was the one event on this list nobody cleared. Every
	# muster ship is a SystemRoot child and dies with the free below, but the
	# EVENT did not: _muster_active stayed true, and _tick_muster_battle kept
	# running because _tick_market hosts it above the warping guard. Two ways out,
	# both bad. With the column not yet fully released, _release_muster_wave
	# spawned the rest of it into the NEW system at an origin derived from the
	# old one, with no line to oppose it. With the column released, the census
	# read zero, _close_muster(true) fired, and the player got LINE HELD, a
	# logbook line and a +1 to the Authority for leaving.
	#
	# Reset SILENTLY and on cooldown, deliberately. It is not a win — nobody held
	# anything — so it pays nothing, and it takes the same cooldown a resolved
	# muster does for the reason the raid one directly above does: warping out IS
	# the escape, and an escape that dropped the player into a fresh roll twenty
	# seconds later would punish the hatch.
	if _muster_active or _muster_warn > 0.0:
		GameState.note_log("LEFT THE CORDON TO IT")
		_muster_cooldown = MUSTER_COOLDOWN
	_muster_active = false
	_muster_warn = -1.0
	_muster_released = 0
	_muster_elapsed = 0.0
	_muster_wave_t = 0.0
	_muster_point = Vector3.ZERO
	_muster_origin = Vector3.ZERO
	# The relief clock restarts with the system, like _raid_timer above: a fresh
	# arrival gets a full interval rather than whatever was left of the last one.
	_cordon_timer = CORDON_REFORM_INTERVAL

	# AND THE BERTH IS RELEASED BEFORE THE PORT IS FREED, which is the one stale
	# reference on this path whose staleness is INVISIBLE.
	#
	# The Port is a direct child of system_root, so the loop below frees it while
	# `docked_port` still points at it. undock() opens with
	# `if docked_port == null: return`, and the comment eight lines above is
	# explicit that a freed reference compares equal to null -- so DEPART becomes
	# a silent no-op, `player.docked` never clears, and movement is gated on that
	# flag. The ship is clamped to a berth that no longer exists, with no button
	# that can release it.
	#
	# Reachable without warping anywhere: dock, open the pause menu (docking does
	# not lock it -- set_panels_locked only disables refit and chart), cycle
	# COLOUR VISION, and rebuild_visuals calls straight into here.
	#
	# Released HERE, before the free, so set_docked_visual and dock_point still
	# run against a live node. abandon_to_title already does the same thing one
	# step earlier, for the same reason.
	if docked_port != null:
		undock()

	for child in system_root.get_children():
		child.free()  # immediate: the rebuild happens this same frame
	# Nothing shoots at a menu, and nothing shoots at a player still being told
	# which key moves the ship.
	var quiet := state == State.ATTRACT or tutorial_active()
	SystemBuilder.build(system_def, system_root, {"skip_sentries": quiet, "system_id": id})
	# v20. The player's beacons, rebuilt from the save the way every persistent
	# thing is: the store is authoritative and the nodes are its projection.
	_build_beacons()
	deep_space = system_root.get_node_or_null("DeepSpace") as DeepSpace
	# DeepSpace is rebuilt with the system, so a harness that switched generation
	# off has to have that re-applied here or a mid-test _load_system would
	# quietly turn the expanse back on underneath its assertions.
	if deep_space:
		deep_space.set_generation(_deep_generation)
	# A new system is a new expanse, so its beacons are unheard again.
	_broadcast_band = 0

	var swarm: Dictionary = system_def.get("swarm", {})
	_wave_timer = float(swarm.get("first_delay", 6.0))

	# A system with a live engine polls for the hunter, breached or not.
	#
	# THE BREACH TEST USED TO LIVE HERE, and that is the defect this moved. The
	# poll is what notices the player has arrived at the lair; gating the poll on
	# the survey meant an unbreached system never noticed anything, so a pilot who
	# found the engine before filing the survey got no wake, no refusal and no
	# line -- an inert prop, three hundred units out, that the radar had just
	# spent DETECT_RANGE leading them to. Reachable from the day v18 moved the
	# survey hull past the marker: the tutorial stopped breaching it, so arriving
	# at the lair first is now an ordinary way to play rather than a perverse one.
	#
	# The gate itself is unchanged and still absolute -- _wake_apex asks the same
	# question, one step later, where there is a player standing in front of it to
	# answer. What moved is WHEN the question gets asked, not what it decides.
	if _find_apex() != null:
		_apex_wake_timer = APEX_WAKE_DELAY
	_apex_dormant_told = false
	# A new system is a new set of people to do a favour for. See credit_defence.
	_defended_flags = {}

	if hud:
		hud.set_system_tag(SystemDB.display_name(id))
	if contracts:
		contracts.on_system_changed(id)
	# Each system gets its own colour on the calm layer. Set on load rather than
	# on arrival so it is already right under the warp-in flash.
	Music.set_system_tint(SystemDB.music_lp_of(id))


func travel_to(id: String) -> void:
	if warping or id == system_id or not SystemDB.exists(id):
		return
	if not GameState.is_lane_open(id):
		return
	warping = true
	_warp_sequence(id)


func _warp_sequence(id: String) -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig")

	# 1. Charge: the ship gathers itself, camera tightens.
	if player:
		player.begin_warp_charge()
	Sfx.play("warp", -3.0, 0.75)
	if rig:
		rig.punch_zoom(1.6)
	await get_tree().create_timer(WARP_CHARGE).timeout

	# 2. Streak out: star-lines and a white flash cover the swap.
	if player:
		player.warp_streak_out()
	if rig:
		rig.shake(0.12)
	_star_streaks()
	await get_tree().create_timer(WARP_STREAK * 0.55).timeout
	FX.flash(self, Vector3(0, 0, 4), Palette.WHITE_HOT, 26.0, 0.5)
	await get_tree().create_timer(WARP_STREAK * 0.45).timeout

	# 3. Swap the world while the flash covers it.
	_load_system(id)
	if player:
		player.teleport_to(Vector3(0, 0, 6))
		player.warp_streak_in()
	if rig:
		rig.global_position = Vector3(0, 0, 2)

	# 4. Arrive.
	Sfx.play("breach", -12.0, 1.3)
	FX.shockwave(self, Vector3(0, 0, 6), Palette.AMBER, 9.0, 0.9)
	if hud:
		hud.show_arrival(SystemDB.display_name(id))
	await get_tree().create_timer(WARP_ARRIVE).timeout
	warping = false
	Barks.fire("first_warp")


func _tick_broadcast(depth: float) -> void:
	# Each band announces itself once per visit to a system. Only ever OUTWARD:
	# hearing the survey authority disown you again on the way home would turn a
	# threshold into a tollbooth.
	var band := DeepSpace.band_of(depth)
	if band <= _broadcast_band:
		return
	_broadcast_band = band
	# Read at fire time and cached nowhere, so a player who claims COMMISSIONED at
	# the Anchor hears the answer on their next trip out rather than on their next
	# launch -- which is the right beat: the beacon is where the acknowledgement
	# lands, not the dock where the paperwork was filed.
	# v22. The ship's own line rides the same crossing, once EVER rather than
	# once per visit -- Barks' persisted contract, so a returning player is not
	# re-taught. Fired before the broadcast's empty-check on purpose: a band
	# with no authored broadcast still teaches, and the two surfaces are
	# different voices (the authority on the plate, the ship in the corner).
	if band >= 3 and band <= 6:
		Barks.fire("first_band_%d" % band)
	# §92. Read at fire time like the commissioned flag beside it, and for
	# the same reason: a pilot who finished the record out at the terminus hears
	# the difference on their NEXT trip out, at the crossing, rather than on
	# their next launch. The archive is where you learn it; the deep is where it
	# answers.
	var msg := DeepSpace.broadcast_for(band, GameState.commissioned, system_id,
		GameState.holds_whole_record())
	if msg.is_empty() or hud == null:
		return
	# The glyph rides the sender line, so the band is named twice -- once in
	# colour and once in a shape -- on the one plate that announces crossing into
	# it. See Palette.BAND_GLYPHS.
	hud.show_broadcast("%s %s" % [Palette.band_glyph(band), String(msg["from"])],
		String(msg["body"]),
		DeepSpace.band_color(depth))


func can_recall() -> bool:
	# Only from outside the charted volume — inside it there is nothing to come
	# back from, and a button that does nothing is worse than no button.
	# Refused mid-fight and mid-warp for the same reason docking is: breaking off
	# an apex by tapping a console is an exit, not a decision. (The chart button
	# is already locked by set_panels_locked during both, so this is the guard
	# behind the guard — but the harness calls this directly, and so might a
	# future caller that has not read set_panels_locked.)
	return state == State.PLAYING and not warping and not boss_active \
		and docked_port == null and deep_depth() > 0.0


func recall_to_system() -> void:
	if not can_recall():
		if hud:
			hud.prompt("RECALL UNAVAILABLE")
			Sfx.play("hit", -10.0, 0.7)
		return
	warping = true
	_recall_sequence()


func _recall_sequence() -> void:
	# The warp beats WITHOUT the swap. travel_to early-returns when the
	# destination is the system you are in, which is exactly what a recall is, so
	# this needs its own entry point rather than a flag on that one.
	#
	# Emphatically no _load_system: that frees SystemRoot wholesale, which would
	# reset the apex to full, respawn the garrison, delete loot still drifting
	# toward the player and reroll every deep sector — all for a move that never
	# leaves the system. The world is untouched; only the ship moves.
	#
	# And it is FREE -- but NOT for the reason this comment used to give. It read
	# "the game does this for you involuntarily already; charging for the
	# voluntary version would only tax doing deliberately what you get for
	# nothing by being careless," and §109 made the second half false: dying past
	# the chart now bills a tug's fee scaled by depth.
	#
	# It stays free on a better argument. Recall is the DELIBERATE exit -- it has
	# a charge time, it cannot be taken mid-fight, and it costs the player the
	# position they flew out to reach. The fail state is what got priced, and
	# pricing the safe, slow, chosen version as well would be taxing the act of
	# going home rather than the act of losing. The ordering that matters is the
	# one that now holds: failing costs more than leaving.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig")

	if player:
		player.begin_warp_charge()
	Sfx.play("warp", -3.0, 0.75)
	if rig:
		rig.punch_zoom(1.6)
	await get_tree().create_timer(WARP_CHARGE).timeout

	if player:
		player.warp_streak_out()
	if rig:
		rig.shake(0.12)
	_star_streaks()
	await get_tree().create_timer(WARP_STREAK * 0.55).timeout
	FX.flash(self, Vector3(0, 0, 4), Palette.WHITE_HOT, 26.0, 0.5)
	await get_tree().create_timer(WARP_STREAK * 0.45).timeout

	if player:
		player.teleport_to(PlayerShip.SPAWN_POINT)
		player.velocity = Vector3.ZERO
		player.clear_target()
		player.warp_streak_in()
	if rig:
		rig.global_position = Vector3(0, 0, 2)

	Sfx.play("breach", -12.0, 1.3)
	FX.shockwave(self, PlayerShip.SPAWN_POINT, Palette.TEAL, 9.0, 0.9)
	if hud:
		hud.show_arrival(SystemDB.display_name(system_id))
	await get_tree().create_timer(WARP_ARRIVE).timeout
	warping = false


func colony_jump_ready_in() -> float:
	# Seconds left on the shared clock, floored at zero. Public so the chart row
	# can print it — 12's rule that a refusal states its own terms.
	return maxf(0.0, COLONY_JUMP_COOLDOWN
		- (GameState.played_seconds - GameState.last_outbound_jump))


func can_colony_jump(key: String) -> bool:
	# can_recall's guard set, plus the three this verb adds. Refused mid-fight
	# and mid-warp for recall's reason: leaving an apex by tapping a console is
	# an exit rather than a decision.
	return state == State.PLAYING and not warping and not boss_active \
		and docked_port == null \
		and GameState.is_colony_claimed(key) \
		and GameState.salvage >= COLONY_JUMP_FEE \
		and colony_jump_ready_in() <= 0.0


func colony_jump_to(key: String) -> void:
	if not can_colony_jump(key):
		if hud:
			# WHICH refusal, per §58. "Unavailable" teaches nothing, and this
			# verb has five distinct ways to be unavailable.
			var why := "COLONY JUMP UNAVAILABLE"
			if not GameState.is_colony_claimed(key):
				why = "NOT A FOUNDED COLONY"
			elif GameState.salvage < COLONY_JUMP_FEE:
				why = "JUMP COSTS %d — NOT ENOUGH BANKED" % COLONY_JUMP_FEE
			elif colony_jump_ready_in() > 0.0:
				why = "DRIVES STILL COOLING — %ds" % int(ceil(colony_jump_ready_in()))
			elif boss_active:
				why = "NOT WITH AN ENGINE AWAKE"
			hud.prompt(why)
			Sfx.play("hit", -10.0, 0.7)
		return
	var e: Dictionary = GameState.colonies.get(key, {})
	if e.is_empty():
		return
	if not GameState.spend_salvage(COLONY_JUMP_FEE):
		return
	GameState.last_outbound_jump = GameState.played_seconds
	warping = true
	_colony_jump_sequence(Vector3(float(e["x"]), 0.0, float(e["z"])), key)


# §106, S4. THE NURSERY'S ANCHOR — HELD, NOT OWNED. The deep jump the research
# pass flagged as a real reversal, taken deliberately and re-derived in the
# open rather than slipped past an assertion that could not see it.
#
# A FOOTHOLD, NOT A FARM derives "deepest reachable" from
# bounds_of("pyx03") + HYPER_DEPTH_MAX and would have gone on printing PASS
# while a nursery anchor at FarMarks depth made the true figure twice that.
# The beacon cap's own comment predicted this exact failure. So the leg is
# re-derived against max(HYPER_DEPTH_MAX, FarMarks.DEPTH_MAX) in the same
# commit, and what pays for the widened bound is the ONE thing a beacon or a
# colony cannot offer:
#
#   THE ANCHOR EXISTS ONLY WHILE THE GROUND IS HELD. A beacon jump is bought
#   once with 500 credits and is a door forever. This one is priced in fights,
#   forever, and the day the Tally take it back the door closes with it. That
#   is not a farm; it is rent.
func can_nursery_jump() -> bool:
	if not GameState.holds_nursery():
		return false
	if state != State.PLAYING or warping or boss_active or docked_port != null:
		return false
	if GameState.salvage < COLONY_JUMP_FEE:
		return false
	return colony_jump_ready_in() <= 0.0


func nursery_jump() -> bool:
	# ONE CLOCK FOR ALL OUTBOUND, the shared stamp's whole rule: founding five
	# colonies never multiplied how often a pilot can be outbound, and holding
	# the deepest ground in the game must not either.
	if not can_nursery_jump():
		if hud:
			var why := "NURSERY JUMP UNAVAILABLE"
			if not GameState.holds_nursery():
				why = "THE GROUND IS NOT YOURS"
			elif GameState.salvage < COLONY_JUMP_FEE:
				why = "JUMP COSTS %d — NOT ENOUGH BANKED" % COLONY_JUMP_FEE
			elif colony_jump_ready_in() > 0.0:
				why = "DRIVES STILL COOLING — %ds" % int(ceil(colony_jump_ready_in()))
			elif boss_active:
				why = "NOT WITH AN ENGINE AWAKE"
			hud.prompt(why)
			Sfx.play("hit", -10.0, 0.7)
		return false
	var key := GameState.nursery_key()
	var bits := key.split(":")
	if bits.size() != 2 or String(bits[0]) != system_id:
		# SAME SYSTEM ONLY, structurally: the anchor is a place in this system
		# and a jump is not a warp.
		if hud:
			hud.prompt("THE GROUND IS IN ANOTHER PYX")
		return false
	if not GameState.spend_salvage(COLONY_JUMP_FEE):
		return false
	GameState.last_outbound_jump = GameState.played_seconds
	warping = true
	_colony_jump_sequence(Vector3(float(GameState.nursery.get("x", 0.0)), 0.0,
		float(GameState.nursery.get("z", 0.0))), key)
	return true


func _colony_jump_sequence(at: Vector3, key: String) -> void:
	# _recall_sequence's beats, outbound. EMPHATICALLY NO _load_system, for that
	# function's own stated reason: it frees SystemRoot wholesale, which would
	# reset the apex, respawn the garrison, delete loot still drifting toward the
	# player and reroll every deep sector — all for a move that never leaves the
	# system. The world is untouched; only the ship moves.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig")

	if player:
		player.begin_warp_charge()
	Sfx.play("warp", -3.0, 0.75)
	if rig:
		rig.punch_zoom(1.6)
	await get_tree().create_timer(WARP_CHARGE).timeout

	if player:
		player.warp_streak_out()
	if rig:
		rig.shake(0.12)
	_star_streaks()
	await get_tree().create_timer(WARP_STREAK * 0.55).timeout
	FX.flash(self, Vector3(0, 0, 4), Palette.WHITE_HOT, 26.0, 0.5)
	await get_tree().create_timer(WARP_STREAK * 0.45).timeout

	# ARRIVE BESIDE IT, not inside it. The silhouette spans 140u; landing on the
	# centre would put the ship inside the mesh.
	var arrive := at + Vector3(HyperStructure.SILHOUETTE_SPAN * 0.55, 0.0, 0.0)
	if player:
		player.teleport_to(arrive)
		player.velocity = Vector3.ZERO
		player.clear_target()
		player.warp_streak_in()
	if rig:
		rig.global_position = arrive + Vector3(0, 0, 2)

	Sfx.play("breach", -12.0, 1.3)
	FX.shockwave(self, arrive, Palette.GOLD, 9.0, 0.9)
	if hud:
		var parts := key.split(":")
		var idx: int = int(String(parts[1])) if parts.size() == 2 else 0
		hud.show_arrival(SystemDB.hyper_designation(system_id, idx))
	await get_tree().create_timer(WARP_ARRIVE).timeout
	warping = false


func _star_streaks() -> void:
	# Radial star-lines sold from the existing beam primitive.
	for i in range(46):
		var ang := randf() * TAU
		var near := randf_range(3.0, 9.0)
		var far := near + randf_range(9.0, 22.0)
		var dir := Vector3(cos(ang), 0, sin(ang))
		var origin := Vector3(0, randf_range(-1.5, 1.5), 4)
		FX.beam(self, origin + dir * near, origin + dir * far,
			Color(0.8, 0.9, 1.0), randf_range(0.03, 0.08), randf_range(0.25, 0.5))


# --- waves & salvage --------------------------------------------------------

func _process(delta: float) -> void:
	if state == State.ATTRACT:
		# Slow drift behind the title so the menu breathes.
		var rig := get_tree().get_first_node_in_group("camera_rig")
		if rig:
			rig.global_position += Vector3(cos(GameState.played_seconds * 0.08),
				0.0, sin(GameState.played_seconds * 0.06)) * delta * 0.6
		GameState.advance_clock(delta)
		return

	_tick_market(delta)

	if warping:
		return

	# AFTER the warping guard, because a jump legitimately teleports the ship far
	# from wherever a course was aimed and the arrival must not be read as an
	# abort. beacon_jump_to clears the course before the sequence starts, so by
	# the time this runs again there is nothing to tick.
	_tick_course(delta)

	if _pending_dock != null:
		_try_complete_dock()

	if _apex_wake_timer > 0.0:
		_apex_wake_timer -= delta
		if _apex_wake_timer <= 0.0:
			_apex_wake_timer = -1.0
			_wake_apex()

	_tick_interdiction(delta)
	# AFTER the warping guard above, unlike _tick_market: a relief must not walk
	# onto a beat in a system the player is in the middle of leaving.
	_tick_cordon(delta)
	# The escort's own clock lives on the picket; this is only the gap before the
	# next one can be asked for. It runs down whether or not an escort is out, so
	# an escort cut short by the chart edge does not shorten the wait.
	if _escort_cd > 0.0:
		_escort_cd = maxf(_escort_cd - delta, 0.0)

	# Wayfinding. The bottom-left readout is the only thing out here that tells
	# you where "here" is — there is no lattice past the chart edge and no
	# landmark to navigate by, so the label stops being decoration and becomes
	# instrumentation. set_deep_tag ignores sub-unit changes, so this is a float
	# compare per frame rather than a string build.
	var depth := deep_depth()
	if hud:
		# THROTTLED, not per frame: _find_apex walks a group and allocates an
		# array to do it, and the answer cannot meaningfully change in a
		# sixtieth of a second at 9 units per second. Four polls a second is
		# well under the 8-unit hysteresis below.
		_carrier_poll -= delta
		if _carrier_poll <= 0.0:
			_carrier_poll = CARRIER_POLL_INTERVAL
			var washed := false
			if depth > 0.0:
				var engine := _find_apex()
				if engine != null:
					# Hysteresis so a ship sitting on the boundary does not
					# strobe the readout -- which would be both ugly and a
					# finer measurement than this is meant to give.
					var edge := DeepSpace.LAIR_KEEPOUT \
						+ (CARRIER_HYSTERESIS if _carrier_wash else 0.0)
					var ship: Node3D = get_tree().get_first_node_in_group("player")
					if ship != null:
						washed = ship.global_position.distance_to(
							engine.global_position) < edge
			_carrier_wash = washed
		# v21: named the way THIS Pyx names it. band_name stays the default and
		# the fallback, so a system with no authored names reads exactly as before.
		hud.set_deep_tag(DeepSpace.band_name_in(system_id, depth) if depth > 0.0 else "", depth,
			_carrier_wash, storm_has_player())
	# The score's second axis, fed from the same poll that already drives the
	# wayfinding label and the beacons. Music smooths it internally, so this is a
	# raw value every frame rather than something this function has to rate-limit.
	Music.set_depth(depth)
	# The light's two axes, from the same poll and the same anchors as the score,
	# so the sky and the mix change at the same places rather than a beat apart.
	var air := get_tree().get_first_node_in_group("atmosphere") as Atmosphere
	if air != null:
		air.set_depth(depth)
		air.set_threat(1.0 if _threat_near_player() else 0.0)
	_tick_broadcast(depth)
	# §96. The held reply, flushed the moment the page's plate lets go. Polled
	# here beside the standing volley rather than timed, so it lands exactly
	# when the surface is free instead of at a guessed delay.
	if not _network_reply_pending.is_empty() \
			and hud != null and not hud.broadcast_busy():
		var pending := _network_reply_pending
		_network_reply_pending = {}
		network_reply(int(pending["cells"]), pending["at"] as Vector3)
	# §119. The same flush for the same reason. The eleventh rung's signal fires
	# once ever and GameState has already set its flag, so a plate that happened
	# to be busy at that instant would cost the line for the whole run.
	if _eleventh_pending and hud != null and not hud.broadcast_busy():
		_the_eleventh()
	if not _standing_pending.is_empty():
		_standing_settle -= delta
		# WAITS FOR THE SURFACE, not merely for the clock. Three of the movers
		# have already narrated their cause on this exact label -- pay_toll
		# writes "TOLL TAKEN", the fence writes its own line -- and landing on
		# top of one would clip the sentence that explains WHY standing moved.
		# The waiting lives here rather than in HUD: the surface stays dumb and
		# the caller does the queueing, which is the same division show_parley
		# settled on.
		if _standing_settle <= 0.0 and hud != null and not hud.toast_busy():
			_flush_standing_toast()
	# The captain's log's one frame-adjacent source, and the only one that needs
	# an argument for why it is still discrete. It reads the RUN's high-water mark
	# rather than _broadcast_band: that field is per-system-visit and resets on
	# warp (see _tick_broadcast), so hanging a log line off it would re-log THE
	# DRIFT on every trip out. deepest_depth only ever rises, survives a load, and
	# resets with the run — so this fires exactly once per band per survey, and
	# costs no new state. Must sit BEFORE note_ledger_max, which is what moves the
	# mark past the edge.
	#
	# BOTH sides are truncated, and that is the whole correctness argument. The
	# first version compared the stored int against the LIVE float, which
	# double-logs across the one edge that is not a whole number: band_of returns
	# CHARTED only at depth <= 0, so from depth 0.1 to 0.9 the mark reads
	# CHARTED while the ship reads THE SHOALS, and the line fires every frame
	# until depth passes 1.0 — ten identical entries, and the run's log evicted
	# by its own first crossing. Comparing mark-to-mark asks the only question
	# that has a stable answer: did the number we are about to store change band?
	var was := DeepSpace.band_of(float(int(GameState.ledger.get("deepest_depth", 0))))
	var now := DeepSpace.band_of(float(int(depth)))
	if now > was:
		# The log records where the player was, so it uses that place's own name.
		GameState.note_log("CROSSED INTO %s"
			% SystemDB.band_name_of(system_id, now, DeepSpace.BAND_NAMES[now]))
	GameState.note_ledger_max("deepest_depth", int(depth))

	# LEAVING THE CHARTED VOLUME IS BREAKING OFF.
	#
	# `boss_active` locks the chart and refit buttons, refuses docking and refuses
	# recall, and nothing clears it but killing the engine, BREAK OFF, or a system
	# load. That was airtight while the camera clamp meant you could not
	# meaningfully leave the arena — phase 3 removed the clamp and left the lock,
	# so a player could fly out into the Drift and take a boss fight's console
	# lockout with them, for a fight now four hundred units behind them.
	#
	# Rather than a new rule, this reuses the one that already exists: crossing
	# the chart edge mid-encounter IS disengaging, and costs exactly what BREAK
	# OFF costs. The geometry and the rules now agree.
	# v15. THE LEASH REPLACED THE CHART EDGE. Crossing out of charted space used
	# to be the break-off, because the fight could only ever happen inside it.
	# The fight now happens out in the deep, where that line means nothing — so
	# the rule becomes what it was always standing in for: RUN FAR ENOUGH FROM
	# THE ENGINE AND THE FIGHT IS OVER.
	#
	# And breaking off no longer sends you home. You are left at depth with a
	# reset engine and a long way to go, because the trip home from a failed hunt
	# is the game. Dying still warps you out — that is what makes dying the
	# expensive exit rather than the convenient one.
	if boss_active:
		var live_boss := _find_apex()
		var player_node: Node3D = get_tree().get_first_node_in_group("player")
		if live_boss != null and player_node != null \
				and player_node.global_position.distance_to(live_boss.global_position) > ApexBoss.LEASH_RANGE:
			disengage_apex(false)
			if hud:
				hud.show_toast("BROKE OFF — LEFT THE LAIR", Palette.AMBER)

	# Swarm waves keep a live target for whatever fit the player is testing.
	# They pause during a boss fight (the engine supplies its own adds) and
	# during the guided first run (the tutorial supplies its own).
	if boss_active or tutorial_active():
		return
	# Waves are the CHARTED system's pacing and they stop at its edge. This is not
	# only a design call: `_spawn_swarm_pack` clamps the pack inside `bounds - 6`,
	# which once the player is a few hundred units out collapses onto one fixed
	# world point — every wave for the rest of the flight arriving at the same
	# spot back near the system, which the player would never even see. The
	# expanse brings its own encounters, seeded per sector.
	if depth > 0.0:
		return
	var swarm: Dictionary = system_def.get("swarm", {})
	if swarm.is_empty():
		return
	_wave_timer -= delta
	if _wave_timer <= 0.0:
		_wave_timer = float(swarm.get("interval", 22.0))
		if get_tree().get_nodes_in_group("swarm").size() < int(swarm.get("cap", 10)):
			_spawn_swarm_pack(swarm)


func _spawn_swarm_pack(swarm: Dictionary) -> void:
	var player: Node3D = get_tree().get_first_node_in_group("player")
	var origin: Vector3 = player.global_position if player else Vector3.ZERO
	var ang := randf() * TAU
	var center := origin + Vector3(cos(ang), 0, sin(ang)) * randf_range(13.0, 19.0)
	# Clamp inside the system, not to a fixed box: the systems are much larger
	# now and a hard ±20 would bunch every wave around the middle.
	var edge := SystemDB.bounds_of(system_id) - 6.0
	center.x = clampf(center.x, -edge, edge)
	center.z = clampf(center.z, -edge, edge)
	# Never spawn a pack inside a moon.
	center = Obstacles.resolve(center, 3.0)

	var count := randi_range(int(swarm.get("pack_min", 4)), int(swarm.get("pack_max", 6)))
	var mult := float(system_def.get("difficulty", 1.0))
	# v18 stage 3. The waves are the host engine's too. They were never a
	# weather system -- something keeps sending them, and now the data says who.
	var flag := SystemDB.faction_of(system_id)
	for i in range(count):
		var s := SwarmHostile.new()
		s.difficulty = mult
		s.faction = flag
		system_root.add_child(s)
		s.global_position = center + Vector3(randf_range(-1.5, 1.5), 0, randf_range(-1.5, 1.5))
	FX.ring_pulse(self, center, Palette.THREAT, 2.5, 0.8)
	Barks.fire("first_hostiles")


# --- cargo interdictions ----------------------------------------------------

func console_open() -> bool:
	# Any full-screen console the player is reading rather than flying behind.
	# damage_screen is in this list even though it PAUSES the tree, which already
	# stops the raid roll dead. Belt and braces, and cheap: the pause goes up and
	# comes down a frame either side of the sheet itself, and a rule that holds
	# only in the frames nobody was looking at is not a rule.
	for panel in [port_panel, refit_panel, chart_panel, hold_screen, damage_screen]:
		if panel != null and panel.is_open:
			return true
	return pause_menu != null and pause_menu.is_open


func console_camping() -> bool:
	# A console open while the ship is UNDER WAY is not a console being read; it
	# is a shield. interdiction_eligible() excludes open consoles (14: a raid must
	# not begin behind a sheet the player cannot see past), and nothing gates
	# movement on that — so a full hold crosses two systems raid-proof with the
	# refit sheet up, and the raid timer does not even tick.
	#
	# The exclusion is kept for a ship at REST, which is the case 14 was written
	# about. Under way, the sheet closes as the klaxon lands and the six-second
	# standoff carries the reactability the exclusion used to.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or not console_open():
		return false
	return player.velocity.length() > 0.5


func close_consoles_for_raid() -> void:
	# The hold is in this list for the same reason as the rest -- the klaxon
	# clears the desk -- but note it may be REOPENED during the standoff, and
	# must be: pay_toll's own guard exists because the manifest gives the player
	# a dump button, and jettisoning down to what a toll will accept is a play
	# the raid was designed around. _raid_active gates the ROLL, not the console.
	# damage_screen is NOT in this list, and that is deliberate. The klaxon
	# clearing the desk is about sheets the player was reading while the world
	# moved; this one stopped the world to be read. Slamming it shut would also
	# drop the pause back onto a ship that now has a pack on top of it, which is
	# the opposite of what a raid warning is for.
	for panel in [port_panel, refit_panel, chart_panel, hold_screen]:
		if panel != null and panel.is_open:
			panel.close_panel()


func _flush_standing_toast() -> void:
	# NAMES THE FACTION AND THE BAND IT LANDED IN. The band is the only thing
	# any code reads -- nine call sites, all against Band.HOSTILE -- and it is
	# the only part the player can act on: a raw delta is a number about a
	# number. Format follows the dock sheet's "%s — STANDING: %s" and the log's
	# RISES/FALLS, so this reads as the same instrument speaking rather than a
	# third one with its own opinions.
	#
	# A MOMENT, NOT A ROW: stage 5 settled that standing gets a statement of
	# record at dock and never a permanent HUD element. This is the moment; the
	# dock sheet is still the record.
	var lead := ""
	var lead_mag := -1
	var others := 0
	for id_v in _standing_pending:
		var id := String(id_v)
		var mag := absi(int(_standing_pending[id]))
		if mag > lead_mag:
			if lead != "":
				others += 1
			lead_mag = mag
			lead = id
		else:
			others += 1
	var summed := int(_standing_pending.get(lead, 0))
	var cause := String(_standing_causes.get(lead, ""))
	_standing_pending = {}
	_standing_causes = {}
	_standing_settle = 0.0
	if lead == "" or summed == 0 or hud == null:
		return
	var band := GameState.faction_band(FactionDB.SURVEYOR, lead)
	# THE CAUSE GOES FIRST WHERE THERE IS ONE. "STANDING RISES" tells a player
	# that a number moved; it does not tell them which of the last ten seconds
	# did it, and a player who cannot connect the act to the consequence cannot
	# choose to repeat it. Movers that are self-evident at the moment they fire
	# (a toll paid on a sheet the player is looking at) pass no cause and read
	# exactly as they did.
	var line := "%s — STANDING %s · %s" % [FactionDB.display_name(lead),
		"RISES" if summed > 0 else "FALLS", FactionDB.BAND_NAMES[band]]
	if cause != "":
		line = "%s — %s · NOW %s" % [cause, FactionDB.display_name(lead),
			FactionDB.BAND_NAMES[band]]
	if others > 0:
		line += "  (+%d MORE)" % others
	# Band.ALLIED is 0 and Band.HOSTILE is 4, so "friendly or better" is <=.
	var col := Palette.GOLD
	if band == FactionDB.Band.HOSTILE:
		col = Palette.THREAT
	elif band <= FactionDB.Band.FRIENDLY:
		col = Palette.TEAL
	hud.show_toast(line, col)
	Sfx.play("equip", -14.0, 1.25 if summed > 0 else 0.8)


func witness_attack(victim: Node3D, flag: String, by: Node3D) -> void:
	# SHOOTING A NEUTRAL BRINGS ITS FRIENDS DOWN ON YOU (v18, playtest round 4).
	# Both hostile classes call this from take_damage when the PLAYER damages
	# something its band does not already count as an enemy; the band test lives
	# at the call site because that is where "was this a neutral" is answerable
	# before the hit is booked.
	#
	# MEASURED FROM THE VICTIM, NOT FROM THE PLAYER, and that is the whole
	# geometry. "Its friends in the immediate area" means the neighbours of the
	# thing you hit — so a lance shot from 40u still answers to the four machines
	# standing around the one it took, which is exactly the accountability an
	# area attack is supposed to carry. Measuring from the player would let a
	# sniper pick a picket line apart one ship at a time.
	#
	# THE VICTIM IS IN ITS OWN WITNESS SET, deliberately: take_damage already set
	# its _aggro, but only provoke() starts the clock, and without the clock that
	# aggro is the unbounded latch described on Hostile._grudge.
	if victim == null or not is_instance_valid(victim) or by == null:
		return
	for node in get_tree().get_nodes_in_group("combatants"):
		var n := node as Node3D
		# UNTYPED-STYLE VALIDITY FIRST, for _targetable's reason: this group is
		# walked while machines are dying, and a freed node fails a member access
		# before any check inside it can run.
		if not is_instance_valid(n) or not ("faction" in n):
			continue
		if String(n.faction) != flag:
			continue
		if n.global_position.distance_to(victim.global_position) \
				> FactionDB.WITNESS_RANGE:
			continue
		if n.has_method("provoke"):
			n.provoke(by)


func credit_defence(saved) -> void:
	# KILLING SOMETHING THAT WAS SHOOTING AT SOMEBODY'S SHIP IS A FAVOUR, AND IS
	# REMEMBERED. Four of the seven chartfolk flags -- league, combine, bastion,
	# procession -- had no positive mover at all before this: every faction had
	# a way to lose standing and only three had a way to gain it, so the matrix
	# was a one-way ratchet for most of the roster.
	#
	# THIS USED TO BE CONVOYS ONLY, and the narrowness was the limitation rather
	# than the design. A convoy is one of half a dozen kinds of flagged ship out
	# there -- sentries hold lanes, pickets patrol the cordon, guards sit on
	# posts, the Procession moves -- and every one of them can be caught in a
	# fight it did not pick. Restricting the favour to the one kind that travels
	# in a column meant the commonest way a player actually helps somebody
	# counted for nothing. Now anything flagged and fighting counts.
	#
	# TWO BOUNDS, because a favour that pays per corpse is a standing printer:
	#
	#   * a CONVOY keeps its own per-convoy-per-session bound. It is a column of
	#     ships fighting one action, and a bound per ship would pay six times for
	#     one rescue.
	#   * anything else is bounded PER FACTION PER SYSTEM VISIT. A brawl is worth
	#     one step to the flag it was fought for, however many hulls burn in it,
	#     so parking beside a border skirmish and farming the wreckage is worth
	#     exactly as much as helping once. Warping out and back re-arms it, which
	#     is deliberate -- a second trip is a second favour -- and DELTA_SPAN
	#     still caps where the whole arc can end up.
	#
	# NOT GATED ON THE FLAG'S CURRENT BAND, and that is a design call rather than
	# an oversight. Covering the ships of a faction that despises you is the one
	# way back that does not involve a toll, and it should read as exactly that:
	# you turned up, and it counted. Their ships shooting at you meanwhile is the
	# cost of trying.
	#
	# UNTYPED, for the dispatcher's reason: what arrives is a dying ship's last
	# target, which may already be freed. The player is never in `combatants`, so
	# the ship that was shooting at YOU cannot bill itself as a rescue.
	#
	# quiet=true: the standing toast is the narration this needed, and a
	# logbook slot is for things worth reading back at a dock.
	if not is_instance_valid(saved):
		return
	var n := saved as Node
	if n == null or not n.is_in_group("combatants"):
		return
	# The muster carries nothing by design (HORIZON-4 §8) and that has to include
	# standing: it is a recurring event, and a recurring event that paid would be
	# recurring income whatever the currency.
	if bool(n.get("muster")):
		return
	var flag := String(n.get("faction"))
	if not FactionDB.is_faction(flag) or flag == FactionDB.SURVEYOR:
		return

	if n.is_in_group("deep_convoy"):
		if deep_space == null:
			return
		if not deep_space.note_convoy_defended(String(n.get_meta("convoy_id", ""))):
			return
	elif _defended_flags.has(flag):
		return
	else:
		_defended_flags[flag] = true

	# The cause, so the toast can say WHY. Standing that moves without a reason
	# on screen is the A10 complaint one layer up: the player can see the number
	# change and still not know what they did to change it.
	_standing_causes[flag] = "COVERED THEIR SHIP"
	GameState.shift_faction(FactionDB.SURVEYOR, flag, 1, true)


# --- talking to a flagged ship (the contact menu) ----------------------------
# The other half of stage 1's unfinished business. STRATEGY §47 left allies in
# the "hostiles" group and named two consequences: they would be painted red,
# and they would be blasted by the player's own area weapons. marker_color()
# answered the first. This answers a third that was never written down — that
# the ONLY thing the player could do to a flagged ship was shoot it. Fourteen
# flags, a full attitude matrix, and one verb.
#
# WHAT THE BAND BUYS IS ACCESS, NEVER A PRICE. Market's "no price function
# anywhere consults standing" is asserted (NO PRICE MOVES WITH STANDING), and
# these verbs stay on the right side of it by construction: a band decides
# whether an option is on the menu at all, and every number below is flat.

# The rate a convoy pays lives in CommodityDB, beside the base_price it
# multiplies -- see the argument there. Both this file and the HUD label that
# quotes it need it, and neither can see the other's constants.
#
# How long an ally rides along, and how long before another will. The escort is
# the one verb that puts a second gun on the board, so the duty cycle is the
# valve: a quarter of the cooldown, and never more than one at a time.
const ESCORT_COOLDOWN := 240.0

var _escort_ship: Node3D = null
var _escort_cd := 0.0


func contact_menu_eligible(ship) -> bool:
	# THE DOOR. One function, asked by the rig before opening the menu, by the HUD
	# every frame it is open, and by every verb before it acts -- so a ship that
	# stops qualifying mid-conversation cannot be acted on through a menu that has
	# not caught up yet.
	#
	# UNTYPED, for _targetable's reason: what arrives is a picked node that may
	# have been freed since, and a typed parameter fails at the call boundary
	# before is_instance_valid can run.
	if not is_instance_valid(ship) or not (ship is Node3D):
		return false
	var n := ship as Node3D
	if not n.is_inside_tree():
		return false
	# No flag, no conversation. This is also what excludes ApexBoss, which has no
	# faction property at all -- and which hostile_to_player would refuse anyway,
	# via the no-method-means-hostile rule.
	if not ("faction" in n):
		return false
	var flag := String(n.faction)
	if not FactionDB.is_faction(flag) or flag == FactionDB.FERAL:
		return false
	# The dispatcher, not the band: something that is shooting at you is not
	# taking questions, whatever its flag says. Left-click already engages it.
	if GameState.hostile_to_player(n):
		return false
	# A muster is a set piece with an announced beginning and end (HORIZON-4 §8).
	# Ships in one are scenery with guns; talking to one would be a side door into
	# an event the whole design keeps sealed. Post-muster keepers stay excluded
	# for the same reason -- the flag survives the event on purpose.
	if bool(n.get("muster")):
		return false
	# THE PARLEY IS THE PLAYER'S CONVERSATION (finding A3), and it already has a
	# surface: the plates. A second menu over a live standoff would be two
	# conversations with the same ship about the same moment.
	if n.is_in_group("raider") and float(n.get("standoff")) > 0.0:
		return false
	if n.has_method("is_dying") and n.is_dying():
		return false
	return true


func contact_menu_context(ship) -> Dictionary:
	# Everything the option ladder needs to know that is not the band, gathered
	# once. HUD.contact_options stays a pure function of (band, this) so the
	# harness can assert the ladder without a viewport, a ship or a player.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var quote: Dictionary = space_trade_quote()
	var repair := 0
	if player != null:
		repair = int(round((1.0 - player.shield_fraction()) * float(PortPanel.REPAIR_FULL_PRICE)))
	var n := ship as Node3D
	return {
		"has_target": player != null and is_instance_valid(player.attack_target),
		"is_convoy": n != null and n.is_in_group("deep_convoy"),
		# A route picket walks a beat. A station-keeper cannot escort: its
		# position is ASSIGNED from _home every frame, so one that ended an
		# escort anywhere else would teleport back -- see Hostile._process.
		"is_route_picket": n is Hostile and not (n as Hostile).patrol.is_empty() \
			and not n.is_in_group("deep_convoy") and not n.has_meta("post_key"),
		"quote": int(quote.get("total", 0)),
		"repair_price": repair,
		"escort_ready": _escort_cd <= 0.0 and not muster_active() and not boss_active,
		"in_combat": _threat_near_player(),
	}


func hail_contact(ship) -> void:
	# Says who they are and how they regard you. The same sentence the engage
	# confirm has always shown, in the same tint, because it is the same fact --
	# and it is the one option every band gets, since refusing to say your name is
	# not something even a WARY flag does.
	if not contact_menu_eligible(ship):
		return
	var flag := String((ship as Node3D).faction)
	var band: int = GameState.faction_band(flag, FactionDB.SURVEYOR)
	var line := "%s — %s" % [FactionDB.display_name(flag), FactionDB.BAND_NAMES[band]]
	# ASKED WITH `in` FIRST. `designation` is declared on Hostile and NOT on
	# SwarmHostile, and Object.get() on a property a script does not have returns
	# null -- which String() renders as "<null>" and would have hung that on the
	# end of every hail to a convoy dart.
	var desig := String((ship as Node3D).designation) \
		if "designation" in (ship as Node3D) else ""
	if desig != "":
		line += " · %s" % desig
	# §111, BROKERAGE t1. THE MANIFEST HAIL: a broker hears a hail as a quote.
	# Convoys at FRIENDLY+ only -- the same pair of gates the trade verb itself
	# stands behind, so this never names a number the menu will not honour.
	# INFORMATION: the trade, at the same rate, is one more tap either way.
	if GameState.skill_tier("brokerage") >= GameState.BROKER_HAIL_TIER \
			and (ship as Node3D).is_in_group("deep_convoy") \
			and band <= FactionDB.Band.FRIENDLY:
		var q := space_trade_quote()
		if int(q["total"]) > 0:
			line += " · THEY'D PAY %s FOR THE HOLD" % _comma_int(int(q["total"]))
	_contact_toast(line, FactionDB.tint_of(flag))


func hail_bearings(ship) -> void:
	# FRIENDLY+. Where they are headed, in the HDG figures every other bearing in
	# this game is given in. Pure read: it asks the ship the question the ship
	# already knows the answer to and puts it on screen.
	if not contact_menu_eligible(ship):
		return
	var n := ship as Node3D
	var flag := String(n.faction)
	var goal: Vector3 = n.current_goal() if n.has_method("current_goal") else Vector3.INF
	if goal == Vector3.INF or goal == Vector3.ZERO:
		_contact_toast("HOLDING STATION", FactionDB.tint_of(flag))
		return
	var to := goal - n.global_position
	# THROUGH THE SAME TWO FUNCTIONS THE HDG READOUT USES, not a private atan2.
	# compass_deg is what makes 000 mean north on this instrument, and
	# quadrant_of derives its word from the displayed number so the figures and
	# the quarter on one line cannot contradict each other. A bearing the player
	# is given has to be in the figures the compass is showing them.
	var flat := Vector3(to.x, 0.0, to.z)
	_contact_toast("BOUND %03d · %s" % [DeepSpace.compass_deg(flat),
		DeepSpace.quadrant_of(flat)], FactionDB.tint_of(flag))


func mark_target_for(ship) -> void:
	# ALLIED. The strongest thing an ally does short of riding along, and it is
	# built entirely out of machinery that already exists: provoke() is aggro with
	# a 30s expiry that never writes a band, so this cannot author a faction state
	# in the player's save and cannot outlive the fight it was asked for.
	if not contact_menu_eligible(ship):
		return
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or not is_instance_valid(player.attack_target):
		return
	if not (ship as Node3D).has_method("provoke"):
		return
	(ship as Node3D).provoke(player.attack_target)
	_contact_toast("THEY ANSWER — %d SECONDS" % int(FactionDB.GRUDGE_TIME),
		FactionDB.tint_of(String((ship as Node3D).faction)))


func engage_contact(ship) -> void:
	# THE MENU CLICK IS THE SECOND ACT. The two-tap ladder in _select exists so a
	# stray finger cannot start a war; picking ENGAGE off a labelled menu is
	# already the deliberate choice that ladder was arming, and the label carries
	# the warning the toast used to. Everything downstream is untouched: the
	# witness call in take_damage, the -1 in _die, the whole standing ramp.
	if not contact_menu_eligible(ship):
		return
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return
	var col: Color = (ship as Node3D).marker_color() \
		if (ship as Node3D).has_method("marker_color") else Palette.THREAT
	FX.ring_pulse(self, (ship as Node3D).global_position, col, 1.3)
	Sfx.play("tap", -4.0, 1.12)
	player.command_attack(ship as Node3D)


func request_escort(ship) -> void:
	# ALLIED, route pickets only. One at a time, and a long cooldown after --
	# see ESCORT_COOLDOWN. A new request ends the old escort rather than fielding
	# two, because two pickets off their beats is the Cordon thinning itself.
	if not contact_menu_eligible(ship):
		return
	var ctx := contact_menu_context(ship)
	if not bool(ctx["is_route_picket"]) or not bool(ctx["escort_ready"]):
		return
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or not (ship as Node3D).has_method("begin_escort"):
		return
	end_escort()
	_escort_ship = ship as Node3D
	_escort_cd = ESCORT_COOLDOWN
	(ship as Node3D).begin_escort(player)
	_contact_toast("ON YOUR WING — %d SECONDS" % int(Hostile.ESCORT_TIME),
		FactionDB.tint_of(String((ship as Node3D).faction)))


func end_escort() -> void:
	# ONE PLACE EVERY ENDING GOES THROUGH. A muster and a boss fight both spawn
	# their own set pieces, and an escort still walking around inside one is two
	# systems arguing over the same ship -- _tick_interdiction paid for that
	# lesson once already.
	if is_instance_valid(_escort_ship) and _escort_ship.has_method("end_escort"):
		_escort_ship.end_escort()
	_escort_ship = null


func space_trade_quote() -> Dictionary:
	# What a convoy would pay for the hold, and what it would take. Pure, so the
	# assertion can price a hold without a ship in the world.
	#
	# TWO EXCLUSIONS, both of them load-bearing rather than tidy:
	#   * trade_only_at goods. Contraband and components have a named list of
	#     buyers, and that list IS the route problem they exist to create.
	#     Selling BANNED to a passing League convoy would walk around the fence,
	#     the smuggling XP feed and the standing consequences in one button.
	#   * chart goods. Selling one runs note_ledger and the commission pipeline;
	#     keeping charts at a dock keeps that plumbing in one place.
	# Unidentified salvage sells: it sells as scrap everywhere, by design.
	var goods := {}
	var total := 0
	for id_v in GameState.cargo:
		var id := String(id_v)
		var units := int(GameState.cargo[id_v])
		if units <= 0:
			continue
		if not CommodityDB.get_good(id).get("trade_only_at", []).is_empty():
			continue
		if CommodityDB.is_chart(id):
			continue
		goods[id] = units
		total += int(round(float(CommodityDB.base_price(id)) * CommodityDB.SPACE_TRADE_RATE)) * units
	return {"total": total, "goods": goods}


func space_trade(ship) -> void:
	# FRIENDLY+, convoys only. No trade pressure (there is no port), no smuggling
	# XP (that feed is the fence's), and NO STANDING -- paying for cargo is a
	# transaction, not a favour, and a +1 per convoy would be a printer without a
	# per-convoy bound to go with it. If that is ever wanted, mirror the fence's
	# _fence_marked exactly.
	if not contact_menu_eligible(ship):
		return
	if not (ship as Node3D).is_in_group("deep_convoy"):
		return
	if GameState.faction_band(String((ship as Node3D).faction),
			FactionDB.SURVEYOR) > FactionDB.Band.FRIENDLY:
		return
	var quote := space_trade_quote()
	var total := int(quote["total"])
	if total <= 0:
		return
	var goods: Dictionary = quote["goods"]
	for id_v in goods:
		GameState.unload_cargo(String(id_v), int(goods[id_v]))
	GameState.add_salvage(total)
	# §111. BROKERAGE's second feed: a convoy dealt with, once per SALE rather
	# than once per unit -- units would make one bulk haul a whole tier, which
	# is volume wearing a verb's clothes.
	GameState.mark_skill("brokerage")
	# The dock's own sale sound, for the dock's own reason: this is the same
	# transaction happening somewhere with no counter.
	Sfx.play_streak("pickup", -8.0)
	if hud != null:
		hud.set_value(GameState.salvage)
	_contact_toast("SOLD — %s SALVAGE" % _comma_int(total),
		FactionDB.tint_of(String((ship as Node3D).faction)))


func field_repair(ship) -> void:
	# ALLIED. The dock's own formula and the dock's own const, so a field repair
	# can never drift away from the bay it is standing in for and can never
	# undercut the deep mercies whose cheaper price is authored on purpose.
	#
	# THE COMBAT GATE IS THE WHOLE BALANCE STORY. A purchasable full heal mid-fight
	# is a difficulty dial nobody asked for; out of a fight the regen is free
	# anyway, so what is sold here is exactly what the dock sells -- skipping the
	# wait. That gate is also why this needs no cooldown of its own.
	if not contact_menu_eligible(ship):
		return
	if GameState.faction_band(String((ship as Node3D).faction),
			FactionDB.SURVEYOR) != FactionDB.Band.ALLIED:
		return
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null or _threat_near_player():
		return
	var missing := 1.0 - player.shield_fraction()
	if missing <= 0.001:
		return
	var price := int(round(missing * float(PortPanel.REPAIR_FULL_PRICE)))
	if not GameState.spend_salvage(price):
		Sfx.play("hit", -12.0, 0.7)     # the sheet's own refusal note
		return
	player.repair_full()
	FX.ring_pulse(self, player.global_position, Palette.TEAL, 1.6)
	Sfx.play("equip", -6.0, 0.85)
	if hud != null:
		hud.set_value(GameState.salvage)
	_contact_toast("PATCHED — %s SALVAGE" % _comma_int(price), Palette.TEAL)


func _contact_toast(line: String, col: Color) -> void:
	var h := get_tree().get_first_node_in_group("hud")
	if h != null and h.has_method("show_toast"):
		h.show_toast(line, col)


func _raid_wants_the_player() -> bool:
	# Whether ANY raider still counts the player as prey. Asked through the one
	# dispatcher, so a raider the player has shot -- _aggro is the player --
	# still counts and a fight in progress is never cut short underneath them.
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n) and GameState.hostile_to_player(n):
			return true
	return false


func is_playing() -> bool:
	# The RULE the attract gate means, rather than a rendering of it. Chrome
	# visibility happens to track this today, but chrome is a picture and this
	# is the fact -- CameraRig's hotkeys and the harness both ask here.
	return state == State.PLAYING


func interdiction_eligible() -> bool:
	# Every exclusion here is a place where being jumped would be unfair rather
	# than tense: docked is the game's one safe state, the tutorial has not
	# taught combat yet, an apex fight is already the hardest thing on offer, and
	# a warp is a cutscene.
	#
	# AND THE BANNER HAS TO WANT YOU. Tithe standing is not decoration: enemies_of
	# has read it since stage 1, so a player who has paid their way out of
	# HOSTILE is not prey, and a pack spawned to interdict somebody it will not
	# fire on is a klaxon with nothing behind it. See faction_db's note on the
	# tithe baseline for why that band is three tolls deep rather than one.
	#
	# spawn_interdiction() stays UNGATED on purpose -- it is public so the
	# harness can force a raid without gambling on a dice roll, and two suites
	# call it directly.
	#
	# A STORM COUNTS TOO, and it is the sharpest case on this list. Inside the
	# eye the ship is EMP-stunned up to 86% of the time, which means a raid
	# landing there is 13's "an attack you cannot answer with movement" — a
	# damage tax, not a mechanic. The console exclusion below makes the same
	# argument about a player whose hands are elsewhere.
	#
	# Consoles count too. They do not pause the game, so a raid could begin while
	# the player was reading the refit list — the klaxon fires behind a sheet
	# that covers two thirds of the screen, and the first thing they see on
	# closing it is a pack already on top of them. Being ambushed should be
	# something you had a chance to react to.
	return state == State.PLAYING \
		and not warping \
		and not boss_active \
		and not tutorial_active() \
		and docked_port == null \
		and (not console_open() or console_camping()) \
		and not _raid_active \
		and not muster_active() \
		and not storm_has_player() \
		and _raid_cooldown <= 0.0 \
		and GameState.faction_band(FactionDB.SURVEYOR, "tithe") >= FactionDB.Band.WARY


func tithe_still_wants_you() -> float:
	# HOW MUCH THE BANNER STILL CARES, as a multiplier on the raid roll — and the
	# reason this is a gradient rather than the equality test it replaced.
	#
	# THE TRAP THIS CLOSES. interdiction_eligible required the Tithe to be
	# exactly HOSTILE. The baseline is -6, HOSTILE spans -6..-4, and pay_toll
	# grants +1 through the one mutator — so THREE PAID TOLLS walked the banner
	# to WARY and no raid ever spawned again, for the rest of the save. That took
	# the interdiction, the parley and (since round 4) PERSUASION's only feed with
	# it, permanently, as the consequence of the most reasonable thing a player
	# can do when a pack demands cargo. Nothing said so, and nothing could: the
	# tap closing looks exactly like a run of quiet dice.
	#
	# A banner that half-remembers you still stops you sometimes. Paying still
	# buys real peace — it is a 40% roll instead of a full one — but peace is now
	# a rate rather than a switch, and no sequence of legal play can end the
	# encounter permanently.
	#
	# ALLIED..NEUTRAL is still nothing: interdiction_eligible refuses above WARY,
	# so this is only ever asked of a banner that is at least wary of you.
	return 1.0 if GameState.faction_band(FactionDB.SURVEYOR, "tithe") \
		== FactionDB.Band.HOSTILE else TITHE_WARY_ODDS


func procession_system(window: int) -> String:
	# Which system the convoy visits in a given window. Pure — the builder, the
	# harness and any future rumour desk must all agree, and hash(window|seed)
	# draws nothing from any stream the world rolls on.
	var ids := SystemDB.ids()
	ids.sort()   # dictionary key order is not a contract; the route is
	return String(ids[hash("%d|procession|%d" % [window, GameState.run_seed]) % ids.size()])


func _tick_procession() -> void:
	var window := int(GameState.played_seconds / PROCESSION_PERIOD)
	var here: bool = procession_system(window) == system_id \
		and state == State.PLAYING and not tutorial_active()
	var live := _procession != null and is_instance_valid(_procession)

	if here and not live:
		var p := Port.new()
		p.port_id = "procession"
		p.port_name = "THE PROCESSION"
		p.kind = "convoy"
		p.def = PROCESSION_DEF.duplicate(true)
		system_root.add_child(p)
		# Parked at two-thirds bounds on a bearing the window picks — off the
		# lanes, inside the chart, nudged out of anything solid. Not a
		# collision sphere of its own: a convoy you can fly through is wrong,
		# but a convoy that blocks a lane for twenty minutes is worse, and
		# stage 5 keeps the smallest honest version.
		var ang := TAU * float(hash("%d|procession_ang" % window) % 360) / 360.0
		p.position = Obstacles.resolve(
			Vector3(cos(ang), 0.0, sin(ang)) * SystemDB.bounds_of(system_id) * 0.66,
			Port.HULL_OBSTACLE_RADIUS)
		_procession = p
		_procession_window = window
		if hud:
			hud.show_toast("THE PROCESSION IS HERE", Palette.GOLD)
		# NO LOGBOOK LINE, and that is a design call rather than a test fix.
		# The captain's log is ten slots and it is for things that happened to
		# YOU; the convoy arrives every twenty minutes whether or not you are
		# looking at it, so over an hour it would own three of those ten and
		# push out the tolls, the kills and the frontier. The toast is the
		# announcement.
		#
		# It also stopped clobbering a save fixture: note_log calls
		# _queue_save(), so the arrival line fired a debounced write that
		# overwrote SAVETEST's captain's-log fixture a second after the harness
		# had explicitly saved it. Worth remembering generally — ANY ambient
		# event that logs also SAVES.
	elif live and (not here or window != _procession_window):
		# It moves on — unless the player is docked at it, in which case it
		# waits for them to leave. A market that vanished under an open sheet
		# would strand the panel on a freed node.
		if docked_port != _procession:
			_procession.queue_free()
			_procession = null


func muster_active() -> bool:
	return _muster_active or _muster_warn > 0.0


func muster_eligible() -> bool:
	# The same posture as interdiction_eligible, for the same reason: an event
	# that begins behind a console, during a cutscene, or on top of another
	# event is not tense, it is unfair. A muster also refuses while a raid is
	# live — two klaxons and two spawn systems on one screen is noise, and the
	# rift already established that events in this game do not overlap.
	return state == State.PLAYING \
		and not warping \
		and not boss_active \
		and not tutorial_active() \
		and not _raid_active \
		and not muster_active() \
		and _muster_cooldown <= 0.0 \
		and deep_depth() <= 0.0


func cordon_routes() -> Array:
	return system_def.get("patrols", []) as Array


func unmanned_routes() -> Array[int]:
	# Which authored beats have nobody walking them. Public so the assertion can
	# ask the same question the tick asks, rather than restating it and drifting.
	var manned := {}
	for node in get_tree().get_nodes_in_group("hostiles"):
		if not (node is Hostile) or not is_instance_valid(node):
			continue
		var h := node as Hostile
		# is_dying(), not just validity: _die runs a staged explosion and does not
		# free until DEATH_STAGE_3, so a picket the player just killed would hold
		# its route for a third of a second and the relief would be one short.
		if h.is_dying() or not h.has_meta("route_i"):
			continue
		manned[int(h.get_meta("route_i"))] = true
	var out: Array[int] = []
	for i in range(cordon_routes().size()):
		if not manned.has(i):
			out.append(i)
	return out


func _tick_cordon(delta: float) -> void:
	# THE CORDON RE-FORMS (v18, playtest round 4), and the fiction was already
	# written: LINE BROKEN says "expect elevated activity until we can re-form"
	# and nothing ever re-formed. The garrison rebuilds on _load_system and never
	# in place, so a warp was the one cure and the game never said so.
	#
	# PICKETS ONLY, and that is an economic decision rather than a scoping one. A
	# sentry flies the host engine's flag, so it is HOSTILE and killing one PAYS:
	# PACING_LOOP budgets five sentry kills for a whole eight-minute loop and
	# MIDTIER sits at 2.91 against a hard 3.00, so a sentry respawn would bolt an
	# income source onto a loop already at 97% of its ceiling. A GSA picket pays
	# nothing — the was_hostile gate in Hostile._die, and since this round the
	# contract tick with it — so this cannot move the pacing band by a point.
	#
	# It is also the half that was actually asked for. A sentry stands on a post;
	# a PICKET is the thing that patrols, so "charted space should feel patrolled"
	# is a statement about the Cordon and nothing else.
	#
	# NOT during a muster: the Cordon is already standing to at the marker, and
	# quietly threading a relief onto a beat mid-event would be two spawn systems
	# arguing over the same ships.
	if state != State.PLAYING or tutorial_active() or boss_active \
			or _muster_active or deep_depth() > 0.0:
		return
	_cordon_timer -= delta
	if _cordon_timer > 0.0:
		return
	_cordon_timer = CORDON_REFORM_INTERVAL
	var free_beats := unmanned_routes()
	if free_beats.is_empty():
		return
	# ONE AT A TIME, and the cap is the authored route count — the same ceiling
	# SENTRY POSTS already states as a measurement (picket_seen == routes). A
	# Cordon that came back all at once would read as a spawn rather than as a
	# relief, and one that came back PAST its authored strength would be the
	# entity budget stage 2a set in the data being overruled at runtime.
	var route_i: int = free_beats[0]
	var route: Array = cordon_routes()[route_i]
	# ENTER FROM THE FAR END. A machine appearing in front of the player is a
	# spawn; one walking in from the other side of its beat is a patrol.
	var pilot: Node3D = get_tree().get_first_node_in_group("player")
	var enter := 0
	if pilot != null:
		var furthest := -1.0
		for i in range(route.size()):
			var d: float = (route[i] as Vector3).distance_to(pilot.global_position)
			if d > furthest:
				furthest = d
				enter = i
	var relief := SystemBuilder.build_picket(system_def, system_root, route_i, enter)
	if relief != null:
		FX.flash(self, relief.global_position, Palette.TEAL, 1.4, 0.25)


func _tick_muster(delta: float) -> void:
	if _muster_cooldown > 0.0:
		_muster_cooldown -= delta

	if _muster_warn > 0.0:
		_muster_warn -= delta
		if _muster_warn <= 0.0:
			_muster_warn = -1.0
			_open_muster()
		return

	if _muster_active:
		# NOT DURING A WARP. _tick_market runs BEFORE _process's warping guard —
		# it has to, because it is what advances the clock — so everything it
		# hosts inherits that, and this is the one thing in it that spawns.
		# _release_muster_wave would put column ships into whichever system_root
		# exists when it fires, at an origin derived from the system being left.
		if warping:
			return
		_tick_muster_battle(delta)
		return

	_muster_timer -= delta
	if _muster_timer <= 0.0:
		_muster_timer = MUSTER_ROLL_INTERVAL
		if muster_eligible() and randf() < MUSTER_CHANCE:
			_warn_muster()


func _muster_bearing() -> Vector3:
	# The survey hull's bearing — the direction that already means "outside" in
	# this system. Derived from SystemDB.derelict_pos so the column, the hull
	# and the tutorial's assignment broadcast all name one direction.
	var hull := SystemDB.derelict_pos(system_id)
	var flat := Vector3(hull.x, 0.0, hull.z)
	if flat.length() < 0.01:
		return Vector3(0, 0, -1)
	return flat.normalized()


func _warn_muster() -> void:
	var dir := _muster_bearing()
	_muster_point = dir * chart_edge()
	_muster_origin = dir * (chart_edge() + MUSTER_DEPTH)
	_muster_warn = MUSTER_WARN
	var deg := DeepSpace.compass_deg(dir)
	if hud:
		hud.show_broadcast("CORDON ADVISORY — MASS CONTACT",
			"Massed unflagged contacts forming %du beyond the marker, bearing %03d. "
				% [int(MUSTER_DEPTH), deg]
			+ "The cordon is standing to at the edge of charted space. We do not "
			+ "operate past the marker and we are not coming out. Hold the line "
			+ "with us or stay clear of it.", Palette.THREAT)
	GameState.note_log("CORDON ADVISORY — MASS CONTACT BEARING %03d" % deg)


func _open_muster() -> void:
	# The line forms first, so the player sees the Cordon standing to before
	# anything appears out in the dark.
	#
	# AND EVERY PICKET GOES BACK ON DUTY FIRST. A muster is the Cordon standing
	# to; one of its pickets off walking with the player through it would be the
	# event's own ships showing up in two places at once. See _set_boss_active
	# for the other half of the same argument.
	end_escort()
	_muster_active = true
	_muster_released = 0
	_muster_wave_t = 0.0
	_muster_elapsed = 0.0
	# ON THE ARC, NOT ON A CHORD. The marker is a CIRCLE — `chart_edge()` is a
	# radius — so a line strung straight across the bearing bulges outside it at
	# the ends. Measured: the outermost picket sat 0.4u past the marker once
	# drift was added, which is small, silent, and a direct breach of the one
	# promise the band-1 beacon has been making since v13. THE LINE IS THE EDGE
	# caught it.
	#
	# Every ship therefore sits at a fixed RADIUS and a spread of BEARINGS, and
	# the radius carries a 3u inset so Hostile's 0.4 station-keeping wander can
	# never take one over either.
	var base_ang := atan2(_muster_bearing().z, _muster_bearing().x)
	var line_r := _muster_line_radius()
	var span := 3.4 / line_r          # radians between neighbours, ~3.4u apart
	for i in range(MUSTER_LINE):
		var g := Hostile.new()
		g.faction = "gsa"
		g.muster = true
		g.difficulty = float(system_def.get("difficulty", 1.0))
		system_root.add_child(g)
		# Strung out ALONG the marker rather than clustered on the bearing: a
		# line is a line, and eight machines in a heap would read as a nest.
		var a := base_ang + (float(i) - float(MUSTER_LINE - 1) * 0.5) * span
		g.global_position = Vector3(cos(a) * line_r, 0.0, sin(a) * line_r)
		g.add_to_group("muster_line")
	if hud:
		hud.show_toast("THE CORDON IS MUSTERING — A LINE IS FORMING", Palette.TEAL)
	Sfx.play("klaxon", -10.0, 0.9)
	_release_muster_wave()


func _release_muster_wave() -> void:
	var n := mini(MUSTER_WAVE, MUSTER_COLUMN - _muster_released)
	if n <= 0:
		return
	var side := Vector3(-_muster_bearing().z, 0.0, _muster_bearing().x)
	var host := SystemDB.faction_of(system_id)
	for i in range(n):
		var c := SwarmHostile.new()
		c.faction = host
		c.muster = true
		c.tint = MUSTER_TINT
		c.difficulty = float(system_def.get("difficulty", 1.0))
		c.march_to = _muster_point
		# NO despawn_radius. A column is not a nest that followed the player out
		# and it must not evaporate because they flew home to watch from the
		# dock; the event ends when the event ends.
		system_root.add_child(c)
		c.global_position = _muster_origin \
			+ side * randf_range(-9.0, 9.0) \
			+ _muster_bearing() * randf_range(-4.0, 4.0)
		c.add_to_group("muster_column")
	_muster_released += n
	FX.ring_pulse(self, _muster_origin, MUSTER_TINT, 6.0, 1.0)


func _muster_line_radius() -> float:
	# ONE function, because _open_muster places the line at this radius and
	# _tick_muster_battle measures the breach against it. Two copies of
	# `chart_edge() - 3.0` is how the line and the test that judges it drift
	# apart, and the drift is invisible: both halves keep working, the event
	# just stops being winnable.
	return maxf(chart_edge() - MUSTER_LINE_INSET, 1.0)


func _muster_census(group: String) -> int:
	var n := 0
	for node in get_tree().get_nodes_in_group(group):
		if is_instance_valid(node):
			n += 1
	return n


func _tick_muster_battle(delta: float) -> void:
	_muster_wave_t -= delta
	if _muster_wave_t <= 0.0 and _muster_released < MUSTER_COLUMN:
		_muster_wave_t = MUSTER_WAVE_GAP
		_release_muster_wave()

	var column := _muster_census("muster_column")
	# THE LINE BREAKS when a column ship gets PAST THE LINE — not when it gets
	# inside the marker. Still measured on RADIUS rather than on distance to the
	# line point, because a ship that went round the end of the line has still
	# crossed; only the threshold changed, from "the marker" to "the line, plus
	# the width of a fight" (MUSTER_BREACH_MARGIN, which carries the whole
	# derivation and the measurement that forced it).
	var through_r := maxf(_muster_line_radius() - MUSTER_BREACH_MARGIN, 0.0)
	var breached := false
	for node in get_tree().get_nodes_in_group("muster_column"):
		var n := node as Node3D
		if is_instance_valid(n) \
				and Vector2(n.global_position.x, n.global_position.z).length() <= through_r:
			breached = true
			break
	if breached:
		_close_muster(false)
		return
	if _muster_released >= MUSTER_COLUMN and column == 0:
		_close_muster(true)
		return
	_muster_elapsed += delta
	if _muster_elapsed >= MUSTER_TIMEOUT:
		# Never expected to fire. Logged rather than silent so that if it ever
		# does, the next reader learns the fight stopped resolving instead of
		# finding an event that quietly got shorter.
		print("[muster] TIMEOUT after %.0fs with %d column ships alive — closing as held" % [
			_muster_elapsed, column])
		_close_muster(true)


func _close_muster(held: bool) -> void:
	_muster_active = false
	_muster_cooldown = MUSTER_COOLDOWN
	_muster_warn = -1.0
	# SURVIVORS OF THE LINE STAY, UP TO THE CORDON'S AUTHORED STRENGTH (v18,
	# playtest round 4). This is the finding the playtest actually reported:
	# a swarm closed in, the GSA machines killed it, and then the GSA machines
	# were not there any more. Everything about that was working as designed —
	# the line is a set-piece and set-pieces clean up after themselves — but
	# eight security ships evaporating the moment they win is the opposite of
	# the world reading as patrolled.
	#
	# BOUNDED BY THE ROUTES, not by the line, so this can never inflate the
	# Cordon past what the data authored: at full strength it retains nobody, and
	# it only has anything to do after the player has already cost the Cordon
	# ships. The line is 8 and route counts are 2/3/4, so the excess still leaves.
	var open_beats := unmanned_routes()
	var kept := 0
	for node in get_tree().get_nodes_in_group("muster_line"):
		if kept >= open_beats.size():
			break
		var keeper := node as Hostile
		if keeper == null or not is_instance_valid(keeper) or keeper.is_dying():
			continue
		keeper.remove_from_group("muster_line")
		# THE FLAG, NOT JUST THE GROUP. `muster` is what exempts a ship from the
		# ambient HP floor, so a retained survivor that kept it could be shot to
		# zero by a sentry with no player involved — AMBIENT COMBAT DEPLETES
		# NOTHING would go red for a reason nobody would connect to a muster that
		# ended minutes earlier. It also gates the payout and the reported kill
		# kind, and this ship is an ordinary picket now on all three counts.
		keeper.muster = false
		var beat_i: int = open_beats[kept]
		var pts: Array[Vector3] = []
		for p_v in (cordon_routes()[beat_i] as Array):
			pts.append(p_v as Vector3)
		keeper.patrol = pts
		keeper.set_meta("route_i", beat_i)
		keeper.enter_beat(0)
		kept += 1
	for group in ["muster_column", "muster_line"]:
		for node in get_tree().get_nodes_in_group(group):
			var n := node as Node3D
			if not is_instance_valid(n):
				continue
			# Out of the muster groups FIRST. depart() sheds the combat groups
			# and then tweens for 1.8s before freeing, so a ship that is
			# visually leaving would otherwise still be counted by
			# _muster_census for almost two seconds — and the census is what
			# decides whether the next muster's budget is clear.
			n.remove_from_group(group)
			if n.has_method("depart"):
				n.depart()          # theater, no loot, no credit — the paid exit
			else:
				n.queue_free()
	if held:
		if hud:
			hud.show_broadcast("CORDON — LINE HELD",
				"The contact is broken up. Charted space is intact. The Authority "
				+ "notes the assistance of every vessel that stood with us.",
				Palette.GOLD)
		GameState.note_log("THE LINE HELD")
		# Standing, not salvage. The muster pays nothing bankable by design —
		# HORIZON-4 §8, and PACING_LOOP is at 97% of its ceiling.
		GameState.shift_faction(FactionDB.SURVEYOR, "gsa", 1, true)
	else:
		if hud:
			hud.show_broadcast("CORDON — LINE BROKEN",
				"Contacts are through the marker and dispersing into charted "
				+ "space. Expect elevated activity until we can re-form.",
				Palette.THREAT)
		GameState.note_log("THE LINE BROKE")
		# The consequence, expressed through a knob that already exists rather
		# than through a new punishment: the survivors dissolve into ordinary
		# wave pressure that arrives faster for a while. No port lockdowns, no
		# damage states — 14's "weather, not a tax".
		_wave_timer = minf(_wave_timer, 3.0)


func interdiction_taper() -> float:
	# Raiders are a fact of the shipping lanes, and out past the chart there are
	# no lanes. They still hunt a loaded hauler anywhere — piracy does not stop
	# being profitable because nobody is watching — it is just that far fewer of
	# them are out there to do it, and the ones that are have further to come.
	#
	# This is the counterweight the whole expanse rests on: danger goes UP with
	# distance (DeepSpace.PACK_*) while interdiction goes DOWN, so going deep
	# trades a threat you can plan around for one you cannot. A hold full of
	# contraband is safest exactly where everything else will kill you.
	return DEEP_RAID_TAPER[DeepSpace.band_of(deep_depth())]


func interdiction_chance() -> float:
	var value := GameState.hold_value(true)
	if value < RAID_MIN_HOLD:
		return 0.0
	# The taper is applied AFTER the clamp, deliberately. Inside it, RAID_MIN_CHANCE
	# is a floor that would swallow the whole gradient and leave the deep exactly
	# as dangerous to a hauler as the shipping lanes are.
	return clampf(float(value) / RAID_VALUE_SCALE, RAID_MIN_CHANCE, RAID_MAX_CHANCE) \
		* interdiction_taper() * hold_signature() * tithe_still_wants_you()


# A carried thing that changes what happens to you, rather than what your ship
# can do. Deliberately not a fitted stat: cargo_after() probes compute_stats(fit)
# while cargo_capacity() reads live stats, so a good that moved a fitted number
# would make the hold guard subtract two different piles from each other.
#
# These two are a matched pair and the pair is the point. A Forged Manifest is the
# reward for reading Reaches salvage — it makes the trip home quieter. An Unstable
# Charge reads hot to anyone scanning, and it is one of the best things THE QUIET
# yields, so the most valuable haul in the game is also the loudest. Something you
# want to carry that makes the trip worse is the trade 16 asks every specialist
# to make, moved from the fitting screen into the hold.
const SIGNATURE_MANIFEST := 0.55
const SIGNATURE_CHARGE := 1.8
# The FITTED damper, deliberately weaker than the carried forgery: 0.70 against
# 0.55 is a 30% cut where the Manifest buys 45%. It also costs a utility slot,
# four power and 25 shield, where the Manifest costs two units of hold. If this
# number ever drops below SIGNATURE_MANIFEST, one craft obsoletes carrying
# contraband cover forever — FITTED WEAKER THAN CARRIED asserts the pair.
const FITTED_BAFFLE := 0.70


func hold_signature() -> float:
	var k := 1.0
	if GameState.hold_has("manifest_forged"):
		k *= SIGNATURE_MANIFEST
	if GameState.fit_has("mod_baffle"):
		k *= FITTED_BAFFLE
	if GameState.hold_has("charge_unstable"):
		k *= SIGNATURE_CHARGE
	return k


func _tick_interdiction(delta: float) -> void:
	_raid_cooldown = maxf(_raid_cooldown - delta, 0.0)

	# The raid is over once the last raider is gone; only then does the cooldown
	# start, so a fight can never be interrupted by a second wave on top of it.
	if _raid_active:
		if _parley_until > 0.0 and GameState.played_seconds > _parley_until:
			_parley_until = 0.0
			if hud:
				hud.hide_parley()
				# The sentence goes with the plates it was describing.
				hud.clear_prompt()
		# A PACK THAT HAS LOST INTEREST LEAVES, and before this it could not.
		# Paying a toll lifts Tithe standing out of HOSTILE, which is the whole
		# point of paying -- but a raider whose flag no longer counts the player
		# as prey then has no target, and carries no leash in charted space. It
		# drifted forever, _count_raiders() never reached zero, and _raid_active
		# latched for the session: no further raids, and because muster_eligible
		# reads the same flag, NO MUSTERS EITHER. A warp was the only cure, and
		# nothing told the player that.
		#
		# Routed through depart(), the exit raiders already use when paid off:
		# it sheds every group at once and pays nothing back.
		if _parley_until <= 0.0 and not _raid_wants_the_player():
			for n_lapsed in get_tree().get_nodes_in_group("raider"):
				if is_instance_valid(n_lapsed) and n_lapsed.has_method("depart"):
					n_lapsed.depart()
		if _count_raiders() == 0:
			_raid_active = false
			_raid_cooldown = RAID_COOLDOWN
			_raid_timer = RAID_ROLL_INTERVAL
		return

	if not interdiction_eligible():
		return
	_raid_timer -= delta
	if _raid_timer > 0.0:
		return
	_raid_timer = RAID_ROLL_INTERVAL
	if randf() < interdiction_chance():
		spawn_interdiction()


func pay_toll() -> void:
	# The paid exit. Cargo comes out hottest-first (the raiders take what they
	# came for), nothing is paid back, and departure sheds every group
	# IMMEDIATELY — _count_raiders() ending the raid is what starts the cooldown,
	# and a pack that merely flew away would leave _raid_active true forever.
	if not _raid_active or GameState.played_seconds > _parley_until:
		return
	# THE HOLD MUST ACTUALLY COVER THE DEMAND. The old guard was `taken <= 0`,
	# which accepted any nonzero payment as settlement — and it was safe only by
	# coincidence: a raid needs weighted >= RAID_MIN_HOLD (1500) at a maximum
	# interdiction weight of 3.5, so the unweighted hold at spawn is always at
	# least 1500/3.5 = 428.6, comfortably over the 400 floor. Three constants that
	# have never heard of each other, holding a rule up by 28 credits.
	#
	# Nothing could shrink a hold mid-standoff until the cargo manifest gave the
	# player a dump button. With it: jettison down to one alloy, pay 40, and the
	# pack leaves satisfied. Checked against the same base-price currency
	# strip_hottest counts in.
	if GameState.hold_value(false) < _parley_toll:
		if hud:
			hud.show_toast("NOT ENOUGH ABOARD — THEY WANT %s" % _comma_int(_parley_toll),
				Palette.THREAT)
		return
	var taken := GameState.strip_hottest(_parley_toll)
	if taken <= 0:
		return
	GameState.note_ledger("tolls_paid", 1)
	GameState.note_log("TOLL PAID — %s IN CARGO" % _comma_int(taken))
	# v18 stage 5. The Tithe remembers being paid. +1 per toll, through the one
	# mutator, bounded by DELTA_SPAN like everything else — and it cannot reach
	# FRIENDLY patrols or discounts because nothing reads tithe standing yet;
	# §9's raid-odds question stays deliberately open. What this buys today is
	# the LOG LINE and the arc: a player who always pays is someone the banner
	# knows, and when a later stage does read the number, the history is real.
	GameState.shift_faction(FactionDB.SURVEYOR, "tithe", 1, true)
	_parley_until = 0.0
	for node in get_tree().get_nodes_in_group("raider"):
		if node.has_method("depart"):
			node.depart()
	Sfx.play("warp", -10.0, 1.4)
	if hud:
		hud.hide_parley()
		hud.clear_prompt()
		hud.show_toast("TOLL TAKEN — %s IN CARGO" % _comma_int(taken), Palette.AMBER_DIM)
		hud.refresh_cargo()


func run_bluff() -> void:
	# The honest wager, ported from the Cantina to the parley: the odds are ON THE
	# BUTTON, and the stake is real. Without a stake a bluff would strictly
	# dominate paying, and an option that is never wrong is not a decision.
	#
	# TWO WAYS TO RAISE THE PLATE SINCE v19, and each brings its own stake. A
	# Forged Manifest is CONSUMED whether it works or not — the Cantina's rule,
	# unchanged. A bare talk-down costs nothing to attempt and costs Tithe
	# standing when it fails, which is the same shape in a different currency:
	# you cannot try this for free, you can only choose what you are risking.
	#
	# Fail either way and the standoff ends immediately with PAY withdrawn: you
	# showed your hand, and they are not going to take a toll from a liar.
	if not _raid_active or GameState.played_seconds > _parley_until:
		return
	# THE GATE IS THE ODDS, not a tier and not an item (v19). It used to be both,
	# and neither test agreed with what put the plate on screen: show_parley
	# asked bluff_odds() and a manifest, run_bluff asked the smuggling tier and a
	# manifest, and the rule "may I do this" therefore lived in three places.
	# PERSUASION gives everyone a non-zero chance, so the one honest question is
	# whether there is a chance at all.
	var odds := GameState.bluff_odds()
	if odds <= 0.0:
		return
	# THE STAKE, AND IT IS WHY THIS IS A DECISION. A manifest is consumed whether
	# it works or not — that has been the rule since the Cantina, because a bluff
	# with no cost would strictly dominate paying. A talk-down needs no manifest,
	# so it carries its own price instead: the Tithe remembers being lied to, and
	# a failed one costs the step a paid toll earns. Charged on the FAILURE below
	# rather than up front, because a lie that worked was never found out.
	var burned := GameState.hold_has("manifest_forged")
	if burned:
		GameState.unload_cargo("manifest_forged", 1)
	_parley_until = 0.0
	if hud:
		hud.hide_parley()
		hud.refresh_cargo()
	if randf() < odds:
		for node in get_tree().get_nodes_in_group("raider"):
			if node.has_method("depart"):
				node.depart()
		Sfx.play("warp", -10.0, 1.4)
		# THE ONE FEED PERSUASION HAS (v19), and it is the WIN rather than the
		# attempt. Paying moves this ladder by nothing and running moves it by
		# nothing — both were killed by arithmetic when SMUGGLING was designed
		# and neither death has been revisited. What is left is the one outcome
		# that is unambiguously a thing the pilot DID.
		if GameState.mark_persuasion(1) and hud:
			hud.show_toast(GameState.persuasion_line(), Palette.TEAL)
		if hud:
			hud.clear_prompt()
			hud.show_toast("THEY BOUGHT IT", Palette.GOLD)
		return
	for node in get_tree().get_nodes_in_group("raider"):
		if node.get("standoff") != null:
			node.set("standoff", 0.0)
	# AND A LIE THAT DID NOT WORK IS REMEMBERED. The mirror of pay_toll's +1, and
	# the stake that keeps a manifest-free talk-down from strictly dominating
	# paying — the property the Forged Manifest was carrying alone until v19.
	GameState.shift_faction(FactionDB.SURVEYOR, "tithe",
		GameState.PERSUASION_FAILURE_COST, true)
	Sfx.play("klaxon", -6.0)
	if hud:
		hud.show_toast("THEY DID NOT BUY IT", Palette.THREAT)
		hud.clear_prompt()


func parley_live() -> bool:
	# Is a demand on the screen right now. One predicate, asked by everything
	# that might otherwise talk over it — the same shape console_open() has for
	# the raid roll.
	return _raid_active and _parley_until > 0.0 \
		and GameState.played_seconds <= _parley_until


func refuse_toll() -> void:
	# THE THIRD VERB, WHICH HAD NO CONTROL (v18, playtest round 4). "PAY, RUN, OR
	# FIGHT" has been on the demand since the parley shipped, and fighting was
	# only expressible by landing a shot on a raider and discovering that
	# break_parley existed. A playtester reported the whole feature missing on
	# the strength of it: the prompt named three answers and the screen offered
	# one plate.
	#
	# ROUTED THROUGH break_parley rather than reimplementing it, so refusing by
	# button and refusing by torpedo are the same event by construction and
	# cannot drift on what they clear.
	#
	# It says the consequence on the plate ("REFUSE — THEY OPEN FIRE") rather
	# than asking for a confirmation, because the standoff is six seconds long
	# and a modal inside it would spend the whole window. Mis-tapping it starts
	# the fight the window was counting down to anyway.
	if not _raid_active or GameState.played_seconds > _parley_until:
		return
	GameState.note_log("REFUSED THE TOLL")
	break_parley()
	if hud:
		hud.clear_prompt()
		hud.show_toast("REFUSED — THEY OPEN FIRE", Palette.THREAT)


func break_parley() -> void:
	# Shooting a raider is also an answer. The whole pack opens up together.
	if _parley_until <= 0.0:
		return
	_parley_until = 0.0
	for node in get_tree().get_nodes_in_group("raider"):
		if node.get("standoff") != null:
			node.set("standoff", 0.0)
	if hud:
		hud.hide_parley()


func lair_def(def: Dictionary) -> Dictionary:
	# "This system has no apex" and "its lair block is empty" are one question,
	# asked by spawn_rift and its assertion — through one door so they cannot
	# drift on what an authored lair IS.
	return ((def.get("apex", {}) as Dictionary).get("lair", {}) as Dictionary)


func spawn_storm() -> Storm:
	# PUBLIC so the harness forces one instead of gambling on a 30% roll — the
	# shape spawn_rift already uses for exactly that reason.
	#
	# THE DEPTH GATE IS THE FEATURE, not an optimisation: weather exists where
	# somebody is standing in it. Read against Storm's own band floor rather than
	# a literal, so a seventh band moves the weather with it.
	if live_storms.size() >= STORM_MAX:
		return null
	if state != State.PLAYING or warping or tutorial_active():
		return null
	if deep_space == null:
		return null
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return null
	if deep_depth() < Storm.band_floor() - STORM_LEAD:
		return null

	var lo := Storm.band_floor() + Storm.PULL_RADIUS
	var hi := Storm.band_floor() + Storm.DRIFT_DEPTH_SPAN * 0.8
	var bounds := SystemDB.bounds_of(system_id)
	var at := Vector3.ZERO
	var placed := false
	# Bounded rejection, the shear's 24 attempts. Two rules, and only one of them
	# is about safety: a storm may never appear inside the ring where it would
	# already be announcing itself (14 — being jumped must be something you could
	# have reacted to), and two storms stay legibly apart.
	for attempt in range(24):
		var bearing := randf() * TAU
		var radius := bounds + randf_range(lo, hi)
		at = Vector3(cos(bearing) * radius, 0.0, sin(bearing) * radius)
		if at.distance_to(player.global_position) < Storm.WARN_RADIUS * 1.5:
			continue
		var clear := true
		for other_v in live_storms:
			var other: Storm = other_v
			if is_instance_valid(other) and at.distance_to(other.global_position) < MIN_STORM_SEPARATION:
				clear = false
				break
		if clear:
			placed = true
			break
	if not placed:
		# The shear's constructive antipode. Distance is then r_storm + r_player,
		# which past the band floor is over ten thousand units — guaranteed by
		# arithmetic rather than by a twenty-fifth hope.
		var away := -player.global_position
		away.y = 0.0
		if away.length() < 0.001:
			away = Vector3.RIGHT
		at = away.normalized() * (bounds + lo)

	var storm := Storm.new()
	system_root.add_child(storm)
	storm.global_position = at
	live_storms.append(storm)
	return storm


func forget_storm(storm: Storm) -> void:
	live_storms.erase(storm)


func storm_has_player() -> bool:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return false
	for s_v in live_storms:
		var s: Storm = s_v
		if is_instance_valid(s) and s.has_player(player):
			return true
	return false


func _tick_storm_teardown() -> void:
	# The spawn gate read the other way round. By the time this fires the player
	# is at least 400u inside the band edge and every storm is past the floor, so
	# nothing is ever seen vanishing.
	if live_storms.is_empty():
		return
	if deep_space != null and deep_depth() >= Storm.band_floor() - STORM_LEAD:
		return
	for s_v in live_storms.duplicate():
		var s: Storm = s_v
		if is_instance_valid(s):
			s.queue_free()
	live_storms.clear()


func spawn_rift() -> Rift:
	# Public so the harness forces one instead of gambling on the roll. Session
	# weather: a system_root child at a random bearing, at a depth the ship can
	# reach within the rift's life, announced on the comms plate rather than the
	# toast strip because a thing with a fuse deserves the weightier surface.
	if live_rift != null or state != State.PLAYING or warping or tutorial_active():
		return null
	# v19 HUNT STAGE 4. The weather reaches as deep as the SYSTEM says it does —
	# 260 was a global cap, and it meant the Reaches and the Quiet had no
	# weather at all in the two systems whose expanse is mostly made of them.
	# The fallback is the shipped constant, passed in so 260.0 is authored once.
	var depth_max := SystemDB.rift_depth_max(system_id, RIFT_DEPTH_MAX)
	var bearing := randf() * TAU
	var depth := randf_range(RIFT_DEPTH_MIN, depth_max)
	# AND THE SHEAR CLEARS THE LAIR, constructively. pyx02's rift window [90,700]
	# overlaps its lair band [620,780] by design — a ceiling at 619 would author
	# the lair's position into the weather table — so overlap is resolved by
	# REJECTION here instead: re-roll until the shear stands clear, bounded, and
	# on the last attempt fall back to the shallow half of the window, which can
	# never reach any lair (every lair floor is >= 620 where a deep window
	# exists). Sampled assertions pass ~94% of the time on a build with this
	# loop deleted, which is why THE SHEAR CLEARS THE LAIR sweeps all 360
	# bearings at the worst depth instead of forcing spawns.
	var lair := SystemDB.lair_pos(system_id, GameState.run_seed)
	var has_lair: bool = not lair_def(system_def).is_empty()
	var radius := chart_edge() + depth
	var pos := Vector3(cos(bearing) * radius, 0.0, sin(bearing) * radius)
	for attempt in range(24):
		if not has_lair or pos.distance_to(lair) >= DeepSpace.LAIR_KEEPOUT:
			break
		bearing = randf() * TAU
		depth = randf_range(RIFT_DEPTH_MIN, depth_max)
		radius = chart_edge() + depth
		pos = Vector3(cos(bearing) * radius, 0.0, sin(bearing) * radius)
	if has_lair and pos.distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
		# The CONSTRUCTIVE guarantee, not a 25th hope. The antipode of a
		# colliding roll sits 2*radius from it, and radius >= chart_edge +
		# RIFT_DEPTH_MIN >= 130, so antipode-to-lair >= 2*130 - LAIR_KEEPOUT
		# = 140 > 120 for every authored system. The loop above exists so this
		# line is almost never the answer; this line exists so "almost" is not
		# the guarantee. And this was reachable in pyx01 all along: its lair
		# floor is 260 and its rift cap is 260, unasserted since rifts shipped.
		bearing += PI
		pos = Vector3(cos(bearing) * radius, 0.0, sin(bearing) * radius)

	var rift := Rift.new()
	rift.band = DeepSpace.band_of(depth)
	rift.rich_mult = SystemDB.rift_rich_mult(system_id)
	system_root.add_child(rift)
	rift.global_position = pos
	live_rift = rift

	if hud:
		# THROUGH THE GLASS, like every other quoted bearing since §60. This
		# line used rad_to_deg on the world-convention angle, so the advisory
		# and rift_rumor (which already used compass_deg) quoted two different
		# bearings for the same shear.
		hud.show_broadcast("SUBSPACE ADVISORY — AUTOMATED",
			"SHEAR DETECTED · BEARING %03d · %du OUT · IT WILL NOT HOLD" % [
				DeepSpace.compass_deg(pos), int(depth)],
			Palette.band_color(rift.band))
	return rift


func rift_rumor() -> String:
	# What the Cantina knows about the weather. Empty when there is nothing to
	# know — the rumor ladder skips an empty line.
	if live_rift == null or not is_instance_valid(live_rift):
		return ""
	var p := live_rift.global_position
	var bearing := DeepSpace.compass_deg(p)
	return "A shear is standing open — bearing %03d, %du out. It will not hold, and neither will the price of what falls out of it." % [
		bearing, int(deep_space.depth_at(p)) if deep_space else 0]


func _count_raiders() -> int:
	var n := 0
	for node in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(node):
			n += 1
	return n


func spawn_interdiction() -> void:
	# Public so the harness can force one without gambling on a dice roll.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return
	# THE THIRD SET PIECE THAT OWNS THE SHIPS AROUND THE PLAYER. A muster and a
	# boss fight both release an escort already; a raid is the one that actually
	# NEEDS to, because the parley is a conversation held at knifepoint four
	# units from where an escort stations itself, and the whole point of the
	# demand is that answering it is the player's decision. An escorting picket
	# standing in the middle of it is a third party to a two-party negotiation.
	end_escort()
	_raid_active = true

	var value := GameState.hold_value(true)
	# One bearing for the whole pack: raiders arrive as an intercept, from a
	# direction, not as a ring closing in. A ring has no side to run from.
	var bearing := randf() * TAU
	var origin := player.global_position + Vector3(cos(bearing), 0, sin(bearing)) * RAID_SPAWN_DIST
	# That clamp is the CHARTED system's, and it only makes sense inside one.
	# Applied out in the expanse it collapses every intercept onto the same fixed
	# point back at the system edge — a pack spawning hundreds of units from the
	# player, off screen, off radar, flying in from nowhere for a minute.
	var deep := deep_depth() > 0.0
	if not deep:
		var edge := SystemDB.bounds_of(system_id) - 4.0
		origin.x = clampf(origin.x, -edge, edge)
		origin.z = clampf(origin.z, -edge, edge)
	origin = Obstacles.resolve(origin, 4.0)
	# And out there they can be outrun. Inside a system a raid has edges and a
	# station to run to, so a raider that never gives up is correct; in open space
	# with nothing to reach, it is a sentence.
	var leash := DeepSpace.HOSTILE_LEASH if deep else 0.0

	# The demand. Priced off the UNWEIGHTED hold — the old prompt printed the
	# weighted value labelled "HOLD VALUE", which was a cosmetic lie the parley
	# would have turned into a real one.
	# A sheet held open while flying is not a sheet being read — it closes as the
	# klaxon lands, and the standoff below is what makes the raid reactable.
	close_consoles_for_raid()
	_parley_toll = maxi(TOLL_FLOOR, int(float(GameState.hold_value(false)) * TOLL_FRACTION))
	# t1 buys TIME to read the demand, not money off it.
	var window := PARLEY_WINDOW + (GameState.SMUGGLING_STANDOFF_BONUS \
		if GameState.smuggling >= 1 else 0.0)
	_parley_until = GameState.played_seconds + window

	Sfx.play("klaxon", -6.0)
	if hud:
		hud.show_toast("RAIDERS ON INTERCEPT", Palette.THREAT)
		# NAMES WHAT IS ON THE SCREEN. The old line promised PAY, RUN OR FIGHT: of
		# the three, one had a control, one was an undocumented side effect of
		# landing a shot, and RUN is not implemented in a charted system at all —
		# raiders spawned inside the marker carry no leash (see `leash` above), so
		# flying away never ends a raid. A prompt that advertises an option the
		# world does not have is worse than one that lists two.
		hud.hold_prompt("RAIDERS DEMAND %s SALVAGE IN CARGO — PAY OR REFUSE" % _comma_int(_parley_toll))
		hud.show_parley(_parley_toll, GameState.bluff_odds(),
			GameState.hold_has("manifest_forged"))
	var rig := get_tree().get_first_node_in_group("camera_rig")
	if rig:
		rig.shake(0.18)
	FX.shockwave(self, origin, Palette.THREAT, 6.0, 0.7)

	var count := randi_range(3, 6)
	var difficulty := float(system_def.get("difficulty", 1.0))
	for i in range(count):
		var r := SwarmHostile.new()
		r.difficulty = difficulty
		# v18 stage 3. THE BANNER GETS ITS NAME. Interdiction raiders are THE
		# TITHE -- crimson paint, a demand, a toll, a parley -- all of which
		# shipped long before the faction layer and none of which had an owner.
		# Pulled forward from stage 5 because it is one line and because stage
		# 2a's picket parley exemption currently guards a case that cannot
		# occur: raiders were FERAL, and the Cordon is neutral to FERAL. This
		# makes THE PARLEY IS IMMUNE a live assertion instead of a defensive one.
		#
		# The tint stays set by hand and therefore WINS over faction paint --
		# FactionDB.tint_of is only applied when the spawner left tint clear --
		# which is correct: RAID_TINT is the Tithe's colour, and the crimson a
		# player has been taught to read must not shift under them.
		r.faction = "tithe"
		r.tint = RAID_TINT
		r.despawn_radius = leash
		# What they are carrying is what they took off the last hauler.
		r.drop_good = "stolen" if i < 2 else ""
		r.standoff = window
		r.add_to_group("raider")
		system_root.add_child(r)
		r.global_position = origin + Vector3(randf_range(-2.0, 2.0), 0, randf_range(-2.0, 2.0))
		FX.flash(self, r.global_position, Palette.THREAT, 1.4, 0.25)

	# A hold worth this much brings something that does not die to one Arc hop.
	if value >= RAID_CORSAIR_HOLD:
		var corsair := Hostile.new()
		corsair.standoff = window
		corsair.difficulty = difficulty
		corsair.faction = "tithe"
		corsair.despawn_radius = leash
		corsair.add_to_group("raider")
		system_root.add_child(corsair)
		corsair.global_position = origin
		FX.flash(self, origin, Palette.THREAT, 2.4, 0.35)

	# THE SENTENCE OUTLIVES NOTHING, and it used to outlive 3.2 seconds of a six
	# second window. The prompt is the only thing on screen that explains what the
	# plates are for, and it deleted itself at the halfway mark: for the back half
	# of every standoff the player was looking at unlabelled boxes while a pack
	# closed. Cleared by whatever ENDS the parley instead — pay, bluff, refuse or
	# lapse — so the explanation and the choice have the same lifetime.


func spring_trap(origin: Vector3, cfg: Dictionary) -> void:
	# A rigged hulk just went off. Two beats, in this order: the EMP lands first
	# so the player feels the trap before they see who set it, and the pack
	# arrives a moment later out of the dark.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return

	if player.has_method("emp_stun"):
		player.emp_stun(float(cfg.get("emp", 1.8)))
	FX.shockwave(self, origin, Palette.TEAL, 16.0, 1.1)
	FX.ring_pulse(self, origin, Color(0.55, 0.85, 1.0), 6.0, 0.9)
	Sfx.play("alarm", -6.0, 0.8)
	if hud:
		hud.show_toast("EMP — DRIVES OFFLINE", Color(0.55, 0.85, 1.0))
		hud.prompt("THE WRECK WAS BAIT")
		get_tree().create_timer(3.4).timeout.connect(func() -> void:
			if hud:
				hud.clear_prompt())

	await get_tree().create_timer(0.55).timeout
	if not is_instance_valid(player):
		return

	# One bearing, like an interdiction: an ambush still has a side it comes from,
	# and a ring closing in is a shape with nowhere to run.
	var bearing := randf() * TAU
	var from := origin + Vector3(cos(bearing), 0, sin(bearing)) * 15.0
	var count := int(cfg.get("count", 4))
	# The band the trap was rigged in, which is what decides how far it follows.
	# Flag is deliberately left empty rather than derived: a trap pack has never
	# flown a faction, and giving it one here would be a second change hiding
	# inside a leash change. leash_for("" ) returns HOSTILE_LEASH for every band
	# the game already shipped, so this line moves nothing under the Fathoms.
	var trap_leash := DeepSpace.leash_for(int(cfg.get("band", 0)), "")
	for i in range(count):
		var s := SwarmHostile.new()
		s.difficulty = float(cfg.get("difficulty", 1.0))
		s.hp_scale = float(cfg.get("hp_scale", 1.0))
		s.tint = cfg.get("tint", Palette.THREAT)
		s.drop_good = String(cfg.get("drop", "")) if i == 0 else ""
		s.despawn_radius = trap_leash
		# system_root, never the cell that owns the hulk: this fight will move,
		# and a pack that belonged to a cell would evaporate mid-chase.
		system_root.add_child(s)
		s.global_position = from + Vector3(randf_range(-2.5, 2.5), 0, randf_range(-2.5, 2.5))
		FX.flash(self, s.global_position, cfg.get("tint", Palette.THREAT), 1.4, 0.25)

	var heavies := int(cfg.get("escort_count", 1 if bool(cfg.get("escort", false)) else 0))
	for i in range(heavies):
		var heavy := Hostile.new()
		heavy.difficulty = float(cfg.get("difficulty", 1.0))
		heavy.despawn_radius = trap_leash
		system_root.add_child(heavy)
		var ha := TAU * float(i) / float(maxi(heavies, 1))
		heavy.global_position = from + (Vector3.ZERO if heavies <= 1
			else Vector3(cos(ha) * 3.4, 0.0, sin(ha) * 3.4))
		FX.flash(self, heavy.global_position, Palette.THREAT, 2.4, 0.35)

	Sfx.play("klaxon", -8.0)
	if hud:
		hud.show_toast("SALVAGE CREW INBOUND — %d CONTACTS" % count, Palette.THREAT)
	var rig := get_tree().get_first_node_in_group("camera_rig")
	if rig:
		rig.shake(0.16)


func _comma_int(n: int) -> String:
	var s := str(n)
	var out := ""
	var count := 0
	for i in range(s.length() - 1, -1, -1):
		out = s[i] + out
		count += 1
		if count % 3 == 0 and i > 0:
			out = "," + out
	return out


# --- market & ports ---------------------------------------------------------

func _tick_market(delta: float) -> void:
	GameState.advance_clock(delta)
	Market.recover_pressure(delta)
	Market.recover_stock()
	_tick_spill_claim(delta)

	for ev in Market.tick_events(delta):
		if hud:
			hud.show_toast("%s ENDS — %s" % [
				Market.event_label(ev), CommodityDB.short_name(String(ev["good"]))],
				Palette.AMBER_DIM)

	# Storms roll beside the shear, the established home for ambient weather.
	# spawn_storm refuses on its own terms, including the depth gate, so this
	# stays three lines.
	_storm_timer -= delta
	if _storm_timer <= 0.0:
		_storm_timer = STORM_ROLL_INTERVAL
		if randf() < STORM_CHANCE:
			spawn_storm()
	_tick_storm_teardown()

	_rift_timer -= delta
	if _rift_timer <= 0.0:
		_rift_timer = RIFT_ROLL_INTERVAL
		if randf() < RIFT_CHANCE:
			spawn_rift()

	_tick_muster(delta)
	_tick_procession()

	_event_roll_timer -= delta
	if _event_roll_timer <= 0.0:
		_event_roll_timer = Market.EVENT_ROLL_INTERVAL
		var ev := Market.try_spawn_event(SystemDB.port_ids())
		if not ev.is_empty() and hud:
			hud.show_toast("%s %s — %s" % [
				Market.event_place(ev),
				Market.event_label(ev),
				CommodityDB.short_name(String(ev["good"]))],
				Market.event_color(ev))
		# §108. The deep gets its own weather, on the same clock and its own
		# budget. Rolled second so a charted event still has first call on the
		# player's attention.
		var dev := Market.try_spawn_deep_event(_live_deep_counters())
		if not dev.is_empty() and hud:
			hud.show_toast("%s %s — %s" % [
				Market.event_place(dev),
				Market.event_label(dev),
				CommodityDB.short_name(String(dev["good"]))],
				Market.event_color(dev))


func _live_deep_counters() -> Array:
	# §108. The deep stations streamed in right now, as
	# [{key, id, name, def}] for Market.try_spawn_deep_event.
	#
	# FILTERED ON bay_key, NOT ON def. `def` non-empty is find_port's tell for
	# "not the charted port", and it has a live false positive: THE PROCESSION
	# carries a duplicated def of its own, and main.gd's own note says the
	# market-event roll must never learn it exists -- THE CONVOY KEEPS ITS
	# SCHEDULE asserts it is absent from SystemDB for exactly that reason. A
	# convoy that vanishes every twenty minutes would leave weather behind it
	# over a cell that has no counter in it. Only DeepSpace ever sets bay_key.
	var out := []
	for n in get_tree().get_nodes_in_group("dockable"):
		if not (n is Port):
			continue
		var p := n as Port
		if p.bay_key == "" or p.def.is_empty():
			continue
		out.append({"key": p.bay_key, "id": p.port_id,
			"name": p.port_name, "def": p.def})
	return out


func find_port() -> Port:
	# "The port of this system" — what the tutorial, the chart and the delivery
	# contracts all mean. A streamed deep station is dockable and is in the same
	# group, but it is emphatically not this: it is somewhere the player found,
	# and it can be 600 units away or gone entirely a minute later. Charted ports
	# carry no `def` of their own, which is exactly the tell.
	var nodes := get_tree().get_nodes_in_group("dockable")
	for n in nodes:
		if n is Port and (n as Port).def.is_empty():
			return n
	return null


func request_dock(port: Port) -> void:
	if docked_port != null or warping:
		return
	if boss_active:
		# No parking mid-encounter: breaking off a boss by docking is an exit,
		# not a decision.
		if hud:
			hud.prompt("DOCKING CLAMPS LOCKED — ENGINE ACTIVE")
		Sfx.play("hit", -10.0, 0.7)
		return
	FX.ring_pulse(self, port.dock_point, Palette.AMBER, 1.6)
	Sfx.play("tap", -5.0, 0.95)
	if port.player_in_range():
		_complete_dock(port)
	else:
		_pending_dock = port
		port.approach()
		if hud:
			hud.prompt("APPROACHING %s" % port.port_name)


func _try_complete_dock() -> void:
	if _pending_dock == null or not is_instance_valid(_pending_dock):
		_pending_dock = null
		return
	if boss_active:
		_pending_dock = null
		return
	if _pending_dock.player_in_range():
		var p := _pending_dock
		_pending_dock = null
		_complete_dock(p)


func _complete_dock(port: Port) -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player == null:
		return
	docked_port = port
	port.set_docked_visual(true)
	player.dock_to(port.dock_point)
	GameState.set_docked(port.port_id)

	# A BERTH IS WHERE BURNED SECTIONS COME BACK. This is the entire cost side of
	# the diversion mechanic: power traded away in a fight stays traded until the
	# ship is somewhere with a crew and a gantry. Announced rather than silent --
	# the trade was narrated when it was made, so its reversal has to be too, or
	# a player cannot tell whether their guns are back.
	if GameState.clear_diverts() and hud:
		hud.show_toast("SECTIONS RESTORED — ALL POWER BACK ONLINE", Palette.TEAL)

	# Docking a deep station IS surveying it: you demonstrably hold its
	# coordinates. Granted here rather than via a mast because a mast within
	# PICK_PX of a station would intercept docking taps — CameraRig checks
	# `crackable` before `dockable`. Keyed on the cell like every other reading
	# — and v21 made coverage persistent (80), so this berth grant is ONCE EVER
	# per station, not once per session. A berth you charted last week stays
	# charted, which is the same statement the chart itself now makes.
	if DeepPortDB.is_deep_port(port.port_id) and deep_space != null:
		var cell := DeepSpace.cell_of(port.global_position)
		if not deep_space.is_surveyed(cell):
			var band := DeepSpace.band_of(deep_space.depth_at(port.global_position))
			var good := CommodityDB.chart_for_band(band)
			if good != "" and GameState.load_cargo(good, SurveyMast.YIELD_UNITS) > 0:
				deep_space.note_surveyed(cell)
				if hud:
					hud.show_toast("NEW BERTH CHARTED — %s x%d" % [
						CommodityDB.short_name(good), SurveyMast.YIELD_UNITS],
						CommodityDB.color_of(good))
					hud.refresh_cargo()

	Sfx.play("dock", -3.0)
	Sfx.haptic("medium")
	FX.ring_pulse(self, port.dock_point, Palette.TEAL, 2.2, 0.7)
	var rig := get_tree().get_first_node_in_group("camera_rig")
	if rig:
		rig.punch_zoom(-1.2)
	if hud:
		hud.clear_prompt()
		hud.set_panels_locked(true)
	Music.set_docked(true)
	Barks.fire("first_docked")

	if contracts:
		contracts.on_docked(port.port_id)
	if port_panel:
		port_panel.open_for(port)


func undock() -> void:
	if docked_port == null:
		return
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var port := docked_port
	docked_port = null
	port.set_docked_visual(false)
	GameState.set_docked("")
	if player:
		player.undock()
	Sfx.play("dock", -9.0, 1.25)
	FX.ring_pulse(self, port.dock_point, Palette.AMBER, 2.0, 0.6)
	Music.set_docked(false)
	if hud:
		hud.set_panels_locked(false)


# --- apex encounter ---------------------------------------------------------

func _lair_band_name(sys_id: String) -> String:
	# Which band the engine hides in, named the way the beacons name it.
	var depth := SystemDB.lair_depth(sys_id, GameState.run_seed)
	return DeepSpace.BAND_NAMES[DeepSpace.band_of(depth)]


var _hunt_cache := {}


func hunt_estimate(sys_id := "") -> Dictionary:
	# Hunt.estimate is pure and cheap-ish, but the radar asks for it every frame
	# and 2,880 grid samples per frame is a real cost for an answer that only
	# changes when the dossier does. Cached against the things that can move it —
	# the system, the run's salt, and GameState.intel_version, which is bumped by
	# every add/clear.
	#
	# A single entry, not a growing map: the only estimate anyone asks for is the
	# one for the system they are standing in, and an unbounded cache keyed by a
	# monotonically increasing version is a leak with extra steps.
	if sys_id == "":
		sys_id = system_id
	var key := "%s|%d|%d" % [sys_id, GameState.run_seed, GameState.intel_version]
	if _hunt_cache.has(key):
		return _hunt_cache[key]
	var est := Hunt.estimate(sys_id)
	_hunt_cache = {key: est}
	return est


func file_apex_intel(kind: String, from: Vector3, err_deg: float) -> bool:
	# THE ONE DOOR EVERY INTEL CHANNEL GOES THROUGH. Six things can teach you
	# where the engine hides — a mast, a read relic, two different rumour desks,
	# a cleared guard post and a rift — and every one of them files through here
	# so that "what does a hint cost, what does it promise, and what does the
	# player see when it lands" is answered once.
	#
	# The target is ALWAYS the current system's own engine. That is not a
	# simplification: under §38's two-tier gate the engine that jams your way
	# onward is the one in the system you are standing in, so intel about
	# anywhere else is intel about a hunt you are not on.
	#
	# `err_deg <= 0` means the ring tier: a band and a quadrant, no bearing.
	# Returns whether the dossier actually took it, so a desk that charges for a
	# reading can refuse to charge for one that would have been a duplicate.
	if not SystemDB.exists(system_id):
		return false
	# §111, HUNTING t1. THE COLD TRAIL: a practiced hand files every channel's
	# reading a little truer. At the intake, so the mast, the relic, both desks,
	# the post and the shear all benefit equally -- and only the bearing tier,
	# because the ring tier has no error to narrow.
	if err_deg > 0.0:
		err_deg *= GameState.hunting_error_mult()
	var before_est: Dictionary = Hunt.estimate(system_id)
	var hint: Dictionary = Hunt.ring_hint(system_id, GameState.run_seed) if err_deg <= 0.0 \
		else Hunt.bearing_hint(system_id, from, kind, err_deg, GameState.run_seed)
	if not GameState.add_apex_hint(system_id, hint):
		return false

	# What the player is told is the ESTIMATE, never the reading in isolation —
	# a bearing on its own means nothing, and "the circle got smaller" is the
	# only feedback that makes buying the next one legible.
	var est: Dictionary = Hunt.estimate(system_id)
	var engine := String((SystemDB.get_system(system_id).get("apex", {}) as Dictionary)
		.get("name", "THE ENGINE"))
	# §111, HUNTING t2. THE CIRCLE READ: what this reading was WORTH, said in
	# the same breath. "The circle got smaller" was always the only legible
	# feedback; a practiced hunter reads it in units. INFORMATION about your own
	# dossier, never about the engine.
	var shrink_note := ""
	if GameState.skill_tier("hunting") >= GameState.HUNTING_CIRCLE_TIER \
			and not before_est.is_empty() and not est.is_empty():
		var r0 := float(before_est.get("radius", 0.0))
		var r1 := float(est.get("radius", 0.0))
		if r0 > r1:
			shrink_note = " · CIRCLE %du -> %du" % [int(r0), int(r1)]
	var line := ""
	if err_deg <= 0.0:
		line = "INTEL — %s IN %s, %s" % [engine,
			DeepSpace.BAND_NAMES[int(hint["band"])], String(hint["quadrant"])]
	else:
		# The hint's stored bearing is in the world convention (and is in players'
		# saves that way); it is turned into a compass number here, at the glass.
		line = "INTEL — %s · BEARING %03d ±%d° · SEARCH ±%du%s" % [engine,
			DeepSpace.to_compass(float(hint["bearing"])), int(round(err_deg)),
			int(round(float(est["radius"]))), shrink_note]
	if hud:
		hud.show_toast(line, Palette.GOLD)
	GameState.note_log(line)
	return true


func _lair_depth_range(sys_id: String) -> Vector2:
	# The AUTHORED annulus, not the band it happens to fall in. THE DRIFT spans
	# 280 units; pyx01's lair band spans 80. Quoting the band for the truth was
	# a coarser answer than the data had to give.
	var lair: Dictionary = (SystemDB.get_system(sys_id).get("apex", {}) as Dictionary) \
		.get("lair", {})
	var d: Array = lair.get("depth", [200.0, 300.0])
	return Vector2(float(d[0]), float(d[1]))


func _lair_quadrant(sys_id: String) -> String:
	# Delegates to DeepSpace.quadrant_of -- the sector maths is shared with the
	# dossier's validator and Hunt's estimator, and a second copy here would be a
	# boundary disagreement waiting to happen.
	return DeepSpace.quadrant_of(SystemDB.lair_pos(sys_id, GameState.run_seed))


func _find_apex() -> ApexBoss:
	var nodes := get_tree().get_nodes_in_group("apex")
	if nodes.is_empty():
		return null
	return nodes[0] as ApexBoss


func _panel_text_contains(root: Node, needle: String) -> bool:
	# Walks a built panel looking for a Label carrying this text. Asserting on the
	# RENDERED tree rather than on the function that feeds it is the whole point:
	# preview_stats returned correct numbers for as long as it has existed and not
	# one of them ever reached a screen.
	if root == null:
		return false
	if root is Label and String((root as Label).text).findn(needle) >= 0:
		return true
	# AND BUTTONS, which this walk ignored for its whole existence. Half of what
	# a port sheet SAYS is written on its controls -- "BUY THE WORD", "DEPART",
	# every market row's action -- so a helper that read only Labels could not
	# see them, and an assertion asking whether a button was on screen got the
	# same answer whether it was there or not. THE WORD IS SOLD ONCE failed in
	# BOTH directions on that, which is the tell: a measurement that cannot
	# distinguish its two outcomes is not measuring.
	if root is Button and String((root as Button).text).findn(needle) >= 0:
		return true
	for child in root.get_children():
		if _panel_text_contains(child, needle):
			return true
	return false


func _find_apex_wreck() -> ApexWreck:
	# By type rather than by group: the wreck shares "crackable" with every
	# derelict in the system, so the group alone would answer a different question.
	for node in get_tree().get_nodes_in_group("crackable"):
		if node is ApexWreck:
			return node as ApexWreck
	return null


func arm_apex_wake() -> void:
	# Called when this system's derelict is breached — the aftershock.
	if _find_apex() != null:
		_apex_wake_timer = APEX_BREACH_DELAY


func _wake_apex() -> void:
	var boss := _find_apex()
	if boss == null or boss_active:
		return
	# v15. WAKE FOR WHOEVER IS ACTUALLY THERE.
	#
	# This used to refuse while the player was outside the charted volume, and
	# the reasoning was sound for the world it was written in: the engine sat at
	# an authored point near the origin, so waking it from four hundred units out
	# locked every console for a fight that was not visible, not reachable and
	# not started. With the leave-the-volume rule below, it would wake and
	# disengage on a loop.
	#
	# The engine is now IN the deep, so depth is exactly the wrong question — the
	# old rule would refuse to wake it anywhere it can now be found. The question
	# that always meant something is proximity: is the hunter here yet. The timer
	# keeps its shape and becomes that poll.
	var hunter: Node3D = get_tree().get_first_node_in_group("player")
	if hunter == null \
			or hunter.global_position.distance_to(boss.global_position) > ApexBoss.WAKE_RANGE:
		_apex_wake_timer = 1.0     # check again shortly
		return

	# AND THE ENGINE ANSWERS A FILED SURVEY, WHICH IT NOW SAYS OUT LOUD.
	#
	# Breaching this system's hull is what arms the engine (Derelict._breach ->
	# arm_apex_wake), and that gate is load-bearing: the kill opens the lane to
	# the next system, charting it is the breach's job, and travel_to asks only
	# about the lane -- so an engine that woke for anyone who found it could be
	# killed into a lane leading somewhere the player had never charted.
	#
	# What was missing was any way to LEARN that. The refusal was silent and
	# invisible: no wake, no line, and an engine that sits there being scenery.
	# So the poll keeps running and the engine states its terms once per visit,
	# on the channel that gave the assignment in the first place -- and the
	# bearing comes back with it, because the player is three hundred units out
	# and the thing they need is behind them.
	#
	# Told ONCE per system load rather than once ever: it is a redirection, and a
	# pilot who comes back out here a week later needs it as much as they did the
	# first time. The poll stays armed either way, so breaching the hull and
	# returning wakes the engine with no further ceremony.
	if not GameState.breached.has(system_id):
		_apex_wake_timer = 1.0
		if not _apex_dormant_told:
			_apex_dormant_told = true
			_announce_dormant_apex(boss)
		return

	_set_boss_active(true)
	boss.wake()


func _announce_dormant_apex(boss: ApexBoss) -> void:
	Sfx.play("alarm", -12.0, 0.7)
	if hud == null:
		return
	hud.prompt("%s — DORMANT" % boss.boss_name)
	var deg := SystemDB.derelict_bearing_deg(system_id)
	var hull_depth := int(round(SystemDB.derelict_depth(system_id)))
	if hull_depth > 0:
		hud.show_broadcast("GSA RELAY — SURVEY OUTSTANDING",
			"You have found it. It will not answer you — %s wakes when a survey "
				% boss.boss_name
			+ "is filed on this system, and ours is still outstanding. The hull "
			+ "is %du out on bearing %03d. Breach it, then come back here."
				% [hull_depth, deg], Palette.GOLD)
	else:
		hud.show_toast("DORMANT — NO SURVEY FILED", Palette.AMBER)
	GameState.note_log("FOUND %s — DORMANT" % boss.boss_name)


func _set_boss_active(v: bool) -> void:
	boss_active = v
	# An escort walking around inside an apex fight is two spawn systems arguing
	# over one ship. Released HERE because this is the one place every beginning
	# and ending of a boss fight passes through -- the comment below says so, and
	# a teardown hung off the four call sites instead would be four places to
	# remember it.
	if v:
		end_escort()
	if hud:
		hud.set_panels_locked(v)
		if not v:
			hud.set_boss_status({"active": false})
	# THE ONE PLACE EVERY ENDING PASSES THROUGH -- kill, break off, death, leash
	# and the system load itself -- so a retint deferred by rebuild_visuals is
	# spent here rather than at four call sites that would each have to remember.
	# call_deferred because this runs from inside _load_system on some paths, and
	# rebuild_visuals calls _load_system.
	if not v and _vision_rebuild_pending:
		_vision_rebuild_pending = false
		call_deferred("rebuild_visuals")
	if not v and refit_panel and refit_panel.is_open:
		pass  # panels already open stay open; they simply can't be reopened


func disengage_apex(return_home := true) -> bool:
	# A voluntary way out of a boss fight.
	#
	# Until now the ONLY exit was to be destroyed: docking is refused during an
	# encounter, and the chart button is locked by set_panels_locked, so a player
	# who had bitten off more than they could chew had to stand there and let it
	# happen. That is a fail state masquerading as a mechanic. Breaking off costs
	# the same as dying — the engine resets to full and the run continues — so
	# this takes nothing away from the fight; it just lets you leave on your feet.
	if not boss_active:
		return false
	var boss := _find_apex()
	if boss:
		boss.reset_fight()
	_set_boss_active(false)
	_apex_wake_timer = APEX_WAKE_DELAY

	# v15. BREAKING OFF NO LONGER TELEPORTS YOU HOME, and removing that is an
	# anti-exploit fix rather than a difficulty preference.
	#
	# The old behaviour was right for a fight that happened near the origin: BREAK
	# OFF pulled you out to safety, which was the whole point of the button. But
	# the engine now hides out in the Quiet, and a free instant trip home from
	# fourteen hundred units out — with a full hold, on a button, ignoring the
	# raid taper and every band between you and the chart — would be the single
	# best way to move cargo in the game. Fly out heavy, tap the boss, break off,
	# arrive home. The whole "survive the trip back" loop this horizon is built to
	# centre would have had a bypass shipped alongside it.
	#
	# So breaking off ends the FIGHT and nothing else: the engine resets, you keep
	# your position and your problem. Recall is still the way home (free, and
	# refused mid-fight — so break off first, then recall), and dying still warps
	# you out, which is what keeps dying the expensive exit rather than the
	# convenient one.
	#
	# `return_home` is kept in the signature and honoured only in CHARTED space,
	# which post-v15 no live fight can be in. It exists for the harnesses that
	# stage a fight at the origin, and for any future encounter that is genuinely
	# a home-system affair.
	if return_home and deep_depth() <= 0.0:
		var player: PlayerShip = get_tree().get_first_node_in_group("player")
		if player:
			player.teleport_to(PlayerShip.SPAWN_POINT)
			player.velocity = Vector3.ZERO
			player.warp_streak_in()
		var rig := get_tree().get_first_node_in_group("camera_rig")
		if rig:
			rig.global_position = Vector3(0, 0, 2)
		Sfx.play("warp", -4.0)
		FX.shockwave(self, PlayerShip.SPAWN_POINT, Palette.TEAL, 7.0, 0.8)
	if hud:
		hud.show_toast("BROKE OFF — THE ENGINE RESETS", Palette.TEAL)
	return true


func spill_unread(at: Vector3) -> int:
	# Dying out here costs you what you could not read.
	#
	# UNREAD SALVAGE ONLY, and that scope is the design. Identified components
	# stay aboard, so reading a thing is also STOWING it — which hands ARCHEOLOGY
	# a third job beside compressing a hold and unlocking the deeper grades, and
	# makes field-reading a survival act rather than only an economic one. The
	# fiction writes itself: components are stowed, unidentified pallets are deck
	# cargo. Spilling the WHOLE hold was considered and cut: it would make deep
	# death lethal to the contraband trade the expanse rests on, and it would
	# retroactively break a promise the tutorial already made.
	#
	# CHART SIDE SPILLS NOTHING. 'You lose position and tempo, never salvage'
	# stays literally true everywhere it was taught.
	if deep_space == null or deep_space.depth_at(at) <= 0.0:
		return 0

	# NOT through spawn_loot. That path re-rolls 22% of goods into band salvage
	# by the position it is called at, so a salvage_quiet spilled at depth 80
	# would come back as salvage_drift — cargo quietly re-graded by where it was
	# dropped rather than where it was found.
	var script := load("res://scripts/loot_cube.gd") as GDScript
	var spilled := 0
	for gid in CommodityDB.ids():
		var good := String(gid)
		if not CommodityDB.is_salvage(good):
			continue
		var held := GameState.cargo_count(good)
		if held <= 0:
			continue
		# Out of the hold FIRST, so the cubes are the only copy and a second death
		# inside the grace window finds nothing left to duplicate.
		GameState.unload_cargo(good, held)
		for i in range(held):
			var cube: Node3D = script.new()
			cube.commodity = good
			cube.spill = true
			# system_root, NOT the player's parent. The player hangs off Main, so
			# get_parent() here would outlive a warp — and a spill that survived
			# leaving the system would be salvage stored in a place the save knows
			# nothing about.
			system_root.add_child(cube)
			cube.place_at(at + Vector3(randf_range(-1.6, 1.6), 0.0,
				randf_range(-1.6, 1.6)))
			spilled += 1

	if spilled > 0:
		# §109. The clock starts the moment it hits the vacuum, and it is scaled
		# by the depth it was dropped at because that is what the flight back
		# costs. A second death before the first spill is recovered RESTARTS it
		# rather than stacking a second deadline -- there is only ever one pile.
		_spill_claim_left = spill_claim_seconds(deep_space.depth_at(at))
		_spill_warned = false
		_spill_lit = false
		if hud:
			hud.show_toast("HOLD BREACHED — %d UNREAD ADRIFT, %d MIN" % [
				spilled, maxi(1, int(round(_spill_claim_left / 60.0)))],
				Palette.THREAT)
		FX.burst(system_root, at, Palette.AMBER, 40, 6.0, 0.3, 1.0)
	return spilled


func on_player_downed() -> void:
	# An emergency warp clears the ship's move order, so a docking approach that
	# gets shot down is over — but `_pending_dock` used to survive it, leaving
	# main polling a port the player was no longer flying to. The next time they
	# happened to drift near it, they would clamp on unasked.
	if _pending_dock != null:
		_pending_dock = null
		if hud:
			hud.prompt("APPROACH ABORTED — DOCKING ORDER CLEARED")

	# Emergency warp during an apex fight breaks off the encounter. The engine
	# resets to full and can be re-engaged; nothing earned is lost.
	if not boss_active:
		return
	var boss := _find_apex()
	if boss:
		boss.reset_fight()
	_set_boss_active(false)
	if hud:
		hud.show_toast("ENGINE DISENGAGED — IT WILL RESET", Palette.TEAL)
	_apex_wake_timer = APEX_WAKE_DELAY


func on_apex_defeated(_boss: Node3D) -> void:
	_set_boss_active(false)
	report_kill("apex")
	# v17. The kill is recorded HERE, where the engine actually dies, and not in
	# open_lane — which is also called to grant passage in stagings where nothing
	# has died, and would then bury a living engine.
	GameState.mark_apex_down(system_id)
	# The lane opens the moment the engine stops transmitting — not when its
	# wreck is cracked. Breaching the wreck is a second trip, for the bonus and
	# the spill, and a player who dies on the way back should still have earned
	# the frontier they just paid for.
	for opened in GameState.open_lane(system_id):
		var opened_name := String(SystemDB.get_system(String(opened)).get("name", opened))
		if hud:
			hud.show_broadcast("GSA RELAY — LANE CLEARED",
				"The interference has stopped. %s is open." % opened_name, Palette.GOLD)
			hud.show_toast("LANE OPEN — %s" % opened_name, Palette.GOLD)
		GameState.note_log("LANE OPEN — %s" % opened_name)


func award_apex_bonus(sys_id: String, bonus: int) -> void:
	# One-time bonus the first time a given system's engine is put down.
	if sys_id == "" or GameState.has_killed_apex(sys_id):
		return
	GameState.mark_apex_killed(sys_id)
	# §111. HUNTING's first feed: an engine down, first kill per system only --
	# this function's own guard is the anti-farm, and a repeat kill pays the
	# ladder the same nothing it pays the bonus.
	GameState.mark_skill("hunting")
	add_salvage(bonus)
	if hud:
		hud.show_toast("FIRST KILL BONUS  +%d" % bonus, Palette.GOLD)


func add_salvage(v: int) -> void:
	GameState.add_salvage(v)
	hud.set_value(GameState.salvage)
	hud.gain(v)
	if contracts:
		contracts.on_salvage(v)
	if GameState.salvage >= 1500:
		Barks.fire("refit_available")


func report_kill(kind: String) -> void:
	hostile_killed.emit(kind)
	if contracts:
		contracts.on_kill(kind)
	Barks.fire("first_kill")


func spawn_loot(parent: Node3D, pos: Vector3, good := "", value_mult := 1.0) -> Node3D:
	# One place that knows how to make a loot cube, so every spawner types its
	# drops identically.
	# PROVENANCE. A crate that would have held a good sometimes holds unidentified
	# salvage instead, graded by the band you were standing in when you found it.
	# Done here because spawn_loot is the single point every drop in the game
	# passes through — derelicts, apex wrecks, sentries, swarms, deep nests and
	# rigged hulks all inherit it without one edit between them.
	if good != "" and randf() < CommodityDB.SALVAGE_CHANCE:
		var band := 0
		if deep_space != null:
			band = DeepSpace.band_of(deep_space.depth_at(pos))
		var graded := CommodityDB.salvage_for_band(band)
		if graded != "":
			good = graded

	var script := load("res://scripts/loot_cube.gd") as GDScript
	var cube: Node3D = script.new()
	cube.commodity = good
	cube.repeat_mult = value_mult
	parent.add_child(cube)
	cube.place_at(pos)
	return cube


# --- the expanse ------------------------------------------------------------

func chart_edge() -> float:
	# The radius of the surveyed volume. Still `bounds`, still per-system data —
	# it just stops being a wall and becomes a landmark.
	return SystemDB.bounds_of(system_id)


func deep_radius() -> float:
	var p: Node3D = get_tree().get_first_node_in_group("player")
	if p == null:
		return 0.0
	return Vector2(p.global_position.x, p.global_position.z).length()


func _threat_near_player() -> bool:
	# The same question Music asks, asked once here and handed to both -- the
	# lighting and the score must never disagree about whether you are in a
	# fight, and two independent scans would eventually drift apart.
	if boss_active:
		return true
	var player: Node3D = get_tree().get_first_node_in_group("player")
	if player == null or bool(player.get("docked")):
		return false
	var r2: float = Music.THREAT_RADIUS * Music.THREAT_RADIUS
	for n in get_tree().get_nodes_in_group("hostiles"):
		var h := n as Node3D
		# AND THE TWO SCANS HAD ALREADY DRIFTED, which is what the comment above
		# says must never happen. Music's copy of this loop gained the IFF filter
		# when a neutral convoy was found raising the combat layer; this one did
		# not, so the lighting has been calling a GSA picket a fight ever since —
		# the same "friendly forces read as hostile" defect the radar had, one
		# instrument over. Same dispatcher, same answer, no third opinion.
		if is_instance_valid(h) and GameState.hostile_to_player(h) \
				and h.global_position.distance_squared_to(player.global_position) <= r2:
			return true
	return false


func deep_depth() -> float:
	# How far past the chart edge. Zero everywhere inside the system, which is
	# what makes every gradient built on it a no-op for existing content.
	return maxf(deep_radius() - chart_edge(), 0.0)


func loot_mult() -> float:
	return float(system_def.get("loot_mult", 1.0))


func hit_stop(duration: float, scale: float) -> void:
	# Brief time dilation on heavy impacts. The timer ignores time_scale so the
	# freeze lasts a fixed wall-clock moment.
	if _hitstop:
		return
	_hitstop = true
	Engine.time_scale = scale
	await get_tree().create_timer(duration, true, false, true).timeout
	Engine.time_scale = 1.0
	_hitstop = false


# --- scripted demo (headless verification / capture) ------------------------

func _run_demo() -> void:
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")

	print("[demo] contracts at startup: ", contracts.debug_state())
	# Enough to actually buy the endgame fit this demo equips below. Sized off
	# the catalog rather than hard-coded, so an economy rebalance can never
	# silently leave the boss fight being fought with starter mounts again.
