# --- collision harness ------------------------------------------------------

func set_deep_generation(on: bool) -> void:
	# Harness-facing. Every harness that hand-places a body outside `bounds` calls
	# this first: PYXIS_COLLISIONTEST's synthetic rock sits at magnitude 48.1
	# against PYX-01's bounds of 40, and a generated boulder landing beside it
	# would silently corrupt the SLIDE assertion into measuring the wrong sphere.
	_deep_generation = on
	if deep_space:
		deep_space.set_generation(on)


func _run_collision_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	set_deep_generation(false)
	await get_tree().create_timer(0.5).timeout
	player.invulnerable = true
	print("[coll] registered obstacles: %d" % Obstacles.count())

	# A synthetic body in genuinely empty space. Using a world asteroid would
	# put other spheres in frame and make a failed assertion ambiguous.
	var centre := Vector3(34, 0, 34)
	var radius := 3.0
	Obstacles.add(centre, radius)
	print("[coll] test body at (%.1f, %.1f) radius %.1f" % [centre.x, centre.z, radius])

	# 1. Fly straight at it and confirm the hull never enters the sphere.
	var approach := centre + Vector3(0, 0, radius + 9.0)
	player.global_position = approach
	player.velocity = Vector3.ZERO
	player.clear_target()
	var worst := INF
	for i in range(90):
		player.command_move(centre)     # aim at the middle of the rock
		await get_tree().physics_frame
		var flat := player.global_position - centre
		flat.y = 0.0
		worst = minf(worst, flat.length())
	print("[coll] SLIDE closest approach %.2f vs radius+hull %.2f -> %s" % [
		worst, radius + PlayerShip.HULL_RADIUS,
		"PASS" if worst >= radius else "FAIL"])

	# 2. Autopilot to a point directly behind the body: the straight line is
	#    blocked, so arrival proves the steering assist works.
	var behind := centre - Vector3(0, 0, radius + 7.0)
	player.global_position = approach
	player.velocity = Vector3.ZERO
	var arrived := false
	for i in range(600):
		player.command_move(behind)
		await get_tree().physics_frame
		if player.global_position.distance_to(behind) < 2.5:
			arrived = true
			break
	print("[coll] AVOID reached far side = %s (dist %.1f)" % [
		str(arrived), player.global_position.distance_to(behind)])

	# 3. Line of sight: a target on the far side of the body cannot be hit.
	var probe := SwarmHostile.new()
	probe.difficulty = 0.5
	probe.hp_scale = 40.0                    # tanky so it survives to be measured
	system_root.add_child(probe)
	probe.global_position = centre - Vector3(0, 0, radius + 1.5)
	# dock_at, not `docked = true`: the bare flag lerps toward an unset dock
	# point at the origin, so the probe wanders out from behind the cover.
	probe.dock_at(probe.global_position)
	await get_tree().create_timer(0.3).timeout

	# Inside weapon range, so "no damage" can only mean the shot was blocked.
	var firing_spot := centre + Vector3(0, 0, radius + 2.0)
	player.command_attack(probe)
	var hp_before: float = probe.hp
	var had_los := false
	# Pin the ship: command_attack would otherwise autopilot it around the body
	# and quietly acquire the line the test is trying to deny.
	for i in range(150):
		player.global_position = firing_spot
		player.velocity = Vector3.ZERO
		had_los = had_los or Obstacles.has_line(firing_spot, probe.global_position)
		await get_tree().physics_frame
	var hp_blocked: float = probe.hp
	print("[coll] BLOCKED SHOT hp %.0f -> %.0f (must be equal)  ever_had_los=%s (must be false)" % [
		hp_before, hp_blocked, str(had_los)])

	# 4. Same target, clear line: damage must flow. Sit on the probe's own side
	#    of the body so the segment never enters the sphere.
	var clear_spot: Vector3 = probe.global_position - Vector3(0, 0, 4.5)
	for i in range(150):
		player.global_position = clear_spot
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
	print("[coll] CLEAR SHOT hp %.0f -> %.0f (must fall)  los=%s (must be true)" % [
		hp_blocked, probe.hp,
		str(Obstacles.has_line(clear_spot, probe.global_position))])

	# 5. A target embedded in a body must still be shootable. The apex boss
	#    registers a hull sphere at its own centre, so treating that sphere as
	#    cover made the Gnomon — and anything docked on it — invulnerable.
	var embedded := centre + Vector3(0.2, 0, 0.2)       # inside the test body
	print("[coll] EMBEDDED TARGET los_to_embedded=%s (must be true)  los_through_body=%s (must be false)" % [
		str(Obstacles.has_line(centre + Vector3(0, 0, radius + 6.0), embedded)),
		str(Obstacles.has_line(centre + Vector3(0, 0, radius + 6.0),
			centre - Vector3(0, 0, radius + 6.0)))])

	# 6. And the real thing: wake the Gnomon and confirm its HP actually falls.
	# v15. FLY TO IT FIRST. The engine hides ~300u out and the wake is a proximity
	# poll, so arming the timer from here refuses. It would still have limped: the
	# loop below parks the ship on the boss every frame, so the poll would catch
	# up a few seconds in and this would measure whatever was left of the window.
	# A sample that starts partway through the thing it samples is not a sample.
	GameState.mark_breached("pyx01")
	var boss := _find_apex()
	if boss == null:
		print("[coll] APEX DAMAGE: no boss found")
		get_tree().quit()
		return
	player.global_position = boss.global_position + Vector3(0, 0, 4.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	# Sit inside the survey field and shoot through a full survey window.
	var boss_hp_before := boss.hp
	for i in range(420):
		player.global_position = boss.global_position + Vector3(0, 0, 4.0)
		player.velocity = Vector3.ZERO
		player.command_attack(boss)
		await get_tree().physics_frame
	print("[coll] APEX DAMAGE hp %.0f -> %.0f (must fall)  state=%s" % [
		boss_hp_before, boss.hp, boss._state_label()])
	get_tree().quit()


# --- rift harness ---------------------------------------------------------------

func _run_rift_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	# 1. SPAWNS inside the reachable depth window — swept over EVERY system,
	#    reading the ceiling from the same accessor spawn_rift uses. v19 made
	#    the ceiling per-system (260 / 700 / 1200); an assertion that hardcoded
	#    260 would call pyx02's deep weather a defect, and one that only ran
	#    pyx01 could not see a deep window at all.
	var spawn_report := ""
	var spawns_ok := true
	var deep_window_seen := false
	for sid_v in SystemDB.ids():
		var sid := String(sid_v)
		_load_system(sid)
		set_deep_generation(false)
		await get_tree().physics_frame
		var ceiling := SystemDB.rift_depth_max(sid, RIFT_DEPTH_MAX)
		if ceiling > RIFT_DEPTH_MAX:
			deep_window_seen = true
		var r_probe := spawn_rift()
		await get_tree().physics_frame
		var pd := deep_space.depth_at(r_probe.global_position) if r_probe else -1.0
		var second_probe := spawn_rift()
		if r_probe == null or pd < RIFT_DEPTH_MIN or pd > ceiling \
				or second_probe != null:
			spawns_ok = false
		spawn_report += "%s %.0f/[%.0f,%.0f] " % [sid, pd, RIFT_DEPTH_MIN, ceiling]
		if r_probe != null:
			r_probe.queue_free()
		live_rift = null
		await get_tree().physics_frame
	# THE DEEP WINDOW IS REAL, deterministically. A build that quietly kept the
	# global 260 cap would pass every clause above — a shallow roll satisfies
	# the wider window too — so pin the RNG to a seed whose first depth roll
	# lands PAST 260 under pyx03's authored ceiling (and clear of its lair, so
	# the rejection loop cannot re-roll it). Under the broken build the same
	# seed's roll is compressed into [90, 260] and the clause fails every run.
	_load_system("pyx03")
	set_deep_generation(false)
	await get_tree().physics_frame
	if is_instance_valid(live_rift):
		live_rift.queue_free()
	live_rift = null
	await get_tree().physics_frame
	var dw_max := SystemDB.rift_depth_max("pyx03", RIFT_DEPTH_MAX)
	var dw_lair := SystemDB.lair_pos("pyx03", GameState.run_seed)
	var dw_edge := chart_edge()
	var dw_seed := -1
	for dw_cand in range(20000):
		seed(dw_cand)
		var db := randf() * TAU
		var dd := randf_range(RIFT_DEPTH_MIN, dw_max)
		var dp := Vector3(cos(db) * (dw_edge + dd), 0.0, sin(db) * (dw_edge + dd))
		if dd > 300.0 and dp.distance_to(dw_lair) >= DeepSpace.LAIR_KEEPOUT + 10.0:
			dw_seed = dw_cand
			break
	var dw_depth := -1.0
	if dw_seed >= 0:
		seed(dw_seed)
		var dw_rift := spawn_rift()
		await get_tree().physics_frame
		if dw_rift != null:
			dw_depth = deep_space.depth_at(dw_rift.global_position)
			dw_rift.queue_free()
		live_rift = null
	randomize()
	_load_system("pyx01")
	set_deep_generation(false)
	await get_tree().physics_frame
	print("[rift] SPAWNS %s· second always refused, a window past 260 exists=%s, and a pinned pyx03 spawn actually USED it (depth %.0f > 260) -> %s" % [
		spawn_report, str(deep_window_seen), dw_depth,
		"PASS" if spawns_ok and deep_window_seen and dw_depth > 260.0 else "FAIL"])

	var rift := spawn_rift()
	await get_tree().physics_frame

	# 2. RICH means one band better than the depth deserves, and every crate is
	#    spill-flagged — a stock cube would reap itself at 25s and vacuum itself
	#    to the player from any distance at 1.3s. A pot that collects itself is
	#    not a pot; this prints which failure it found.
	# Asks the rift's OWN rich_band() rather than re-deriving the clamp here —
	# the §61 shape: a copy of the formula agrees with itself on any code.
	var rich := rift.rich_band()
	var want_good := CommodityDB.salvage_for_band(rich)
	var wrong := ""
	var crates := 0
	for c in rift.get_children():
		if c is LootCube:
			crates += 1
			if String((c as LootCube).commodity) != want_good:
				wrong = "wrong grade %s" % (c as LootCube).commodity
			if not bool((c as LootCube).spill):
				wrong = "stock cube (reaps at 25s, self-vacuums)"
	print("[rift] RICH %d crates of %s (band %d at a band-%d depth), all spill-flagged -> %s %s" % [
		crates, CommodityDB.short_name(want_good), rich, rift.band,
		"PASS" if crates >= Rift.CRATE_MIN and crates <= Rift.CRATE_MAX
			and wrong == "" else "FAIL", wrong])

	# 3. THE RUMOR NAMES THE LIVE RIFT, above every market event — and skips it
	#    cleanly once the shear closes.
	var line := rift_rumor()
	print("[rift] RUMOR '%s' -> %s" % [line,
		"PASS" if line != "" and line.contains("bearing") else "FAIL"])

	# 4. COLLAPSE. Three pulses, each evaporating ~30%% of what stands and each
	#    bringing company; after the third the rift is gone and the pot with it.
	#    The player is moved TO the rift first — the first version pulsed it from
	#    the spawn point, 290u away, and the pack leashed out on frame one. That
	#    was the leash working, not the spawn failing.
	player.global_position = rift.global_position + Vector3(4, 0, 0)
	await get_tree().physics_frame
	var before := rift.crates_standing()
	var swarm_before := get_tree().get_nodes_in_group("swarm").size()
	rift.pulse()
	await get_tree().physics_frame
	var after_one := rift.crates_standing()
	var swarm_after := get_tree().get_nodes_in_group("swarm").size()
	rift.pulse()
	rift.pulse()
	for i in range(4):
		await get_tree().physics_frame
	var gone := not is_instance_valid(rift) or rift.is_queued_for_deletion()
	print("[rift] COLLAPSE crates %d -> %d after one pulse (~30%% loss), pack arrived=%s, gone after 3=%s, live_rift cleared=%s -> %s" % [
		before, after_one, str(swarm_after > swarm_before), str(gone),
		str(live_rift == null),
		"PASS" if after_one < before and after_one > 0 and swarm_after > swarm_before
			and gone and live_rift == null else "FAIL"])

	# 5. SESSION ONLY. A rift is weather you were present for: a system rebuild
	#    owes you nothing, saves nothing, and the rumor ladder falls back to the
	#    market read.
	for n in get_tree().get_nodes_in_group("swarm"):
		(n as Node3D).queue_free()
	await get_tree().physics_frame
	var rift2 := spawn_rift()
	# Captured NOW: after the rebuild frees it, a freed reference compares equal
	# to null and "did the spawn succeed" silently becomes "did it survive the
	# rebuild" — the exact opposite of what this step asserts.
	var second_spawned := rift2 != null
	_load_system(system_id)
	await get_tree().physics_frame
	var survivors := 0
	for n in system_root.get_children():
		if n is Rift:
			survivors += 1
	print("[rift] SESSION ONLY rebuilt the system: %d rifts survive, live_rift=%s, rumor falls back='%s' -> %s" % [
		survivors, "null" if live_rift == null else "SET",
		"" if rift_rumor() == "" else "STILL NAMES IT",
		"PASS" if survivors == 0 and live_rift == null and rift_rumor() == "" \
			and second_spawned else "FAIL"])

	# --- 6. v19 stage 4: THE SHEAR CLEARS THE LAIR ---------------------------
	# pyx02's rift window [90,700] overlaps its lair band [620,780] BY DESIGN —
	# a ceiling at 619 would author the lair into the weather table — so the
	# clearance lives in spawn_rift's rejection loop and its antipode fallback.
	#
	# DETERMINISTIC, NOT SAMPLED. A "force N spawns and check" version passes
	# ~94% of the time on a build with the whole loop deleted, because the
	# collision is a sub-1% joint roll. Instead: search seeds until one is
	# found whose FIRST (bearing, depth) roll collides — mirroring spawn_rift's
	# draw order exactly — then pin the global RNG to it and drive the real
	# spawn. On a build without the loop and fallback, that spawn lands inside
	# the keep-out every single run.
	_load_system("pyx02")
	set_deep_generation(false)
	await get_tree().physics_frame
	if is_instance_valid(live_rift):
		live_rift.queue_free()
	live_rift = null
	await get_tree().physics_frame
	var f_lair := SystemDB.lair_pos("pyx02", GameState.run_seed)
	var f_max := SystemDB.rift_depth_max("pyx02", RIFT_DEPTH_MAX)
	var f_edge := chart_edge()
	var f_seed := -1
	var f_first_dist := -1.0
	for cand in range(50000):
		seed(cand)
		var cb := randf() * TAU
		var cd := randf_range(RIFT_DEPTH_MIN, f_max)
		var cp := Vector3(cos(cb) * (f_edge + cd), 0.0, sin(cb) * (f_edge + cd))
		if cp.distance_to(f_lair) < DeepSpace.LAIR_KEEPOUT:
			f_seed = cand
			f_first_dist = cp.distance_to(f_lair)
			break
	var f_clear := -1.0
	if f_seed >= 0:
		seed(f_seed)
		var forced := spawn_rift()
		await get_tree().physics_frame
		if forced != null:
			f_clear = forced.global_position.distance_to(f_lair)
			forced.queue_free()
		live_rift = null
	randomize()
	print("[rift] THE SHEAR CLEARS THE LAIR seed %d's first roll lands %.0fu from the lair (inside %.0f); the real spawn under that seed stands %.0fu clear -> %s" % [
		f_seed, f_first_dist, DeepSpace.LAIR_KEEPOUT, f_clear,
		"PASS" if f_seed >= 0 and f_first_dist < DeepSpace.LAIR_KEEPOUT
			and f_clear >= DeepSpace.LAIR_KEEPOUT else "FAIL"])

	# --- 7. v19 stage 4: A RICHER SYSTEM'S WEATHER PAYS MORE -----------------
	# Two clauses, and each is deterministic on its own terms. The WIRING:
	# spawn_rift hands the system's authored rich_mult to the rift it builds —
	# checked in pyx02, where 1.25 is authored, so a build that dropped the
	# hand-off reads 1.0 and fails on equality, not on a dice roll. The
	# ARITHMETIC: a probe rift at mult 3.0 must spill within [3*CRATE_MIN,
	# 3*CRATE_MAX] = [90, 108] — fully DISJOINT from the unscaled [30, 36], so
	# a build that ignores the multiplier cannot pass on any roll. 3.0 is a
	# test value precisely because no authored mult separates the ranges.
	var wired := spawn_rift()
	await get_tree().physics_frame
	var wired_mult: float = wired.rich_mult if wired != null else -1.0
	var want_mult := SystemDB.rift_rich_mult("pyx02")
	if wired != null:
		wired.queue_free()
	live_rift = null
	await get_tree().physics_frame
	var fat := Rift.new()
	fat.band = 2
	fat.rich_mult = 3.0
	system_root.add_child(fat)
	await get_tree().physics_frame
	var fat_crates := 0
	for c_v in fat.get_children():
		if c_v is LootCube:
			fat_crates += 1
	fat.queue_free()
	live_rift = null
	print("[rift] A RICHER SYSTEM'S WEATHER PAYS MORE pyx02 rift carries mult %.2f (authored %.2f); a 3.0x probe spilled %d crates in [%d, %d], disjoint from the unscaled [%d, %d] -> %s" % [
		wired_mult, want_mult, fat_crates,
		Rift.CRATE_MIN * 3, Rift.CRATE_MAX * 3, Rift.CRATE_MIN, Rift.CRATE_MAX,
		"PASS" if is_equal_approx(wired_mult, want_mult) and want_mult > 1.0
			and fat_crates >= Rift.CRATE_MIN * 3 and fat_crates <= Rift.CRATE_MAX * 3
			else "FAIL"])
	get_tree().quit()


# --- smuggling harness --------------------------------------------------------

func _run_smug_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	# 1. FEEDS COMPETE, asserted as DATA. If smuggling levelled off anything
	#    archeology also levels off, one deep salvage run would raise both and
	#    19's warning lands: skills all fed by "playing the game" rise together
	#    and become a clock rather than a decision.
	var arch_goods := {}
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var sid := CommodityDB.salvage_for_band(band)
		if sid != "":
			arch_goods[sid] = true
			for out_v in CommodityDB.reads_as(sid):
				arch_goods[String(out_v)] = true
	# THREE sets since stage 4, and the third is why ore carries `ore` rather than
	# `band` or `parent`: those two keys are literally what puts a good into
	# archeology's pile, so an ore wearing either would have levelled a reading
	# skill off a rock and collapsed two feeds into one.
	var ore_goods := {}
	for oid_v in CommodityDB.ore_ids():
		ore_goods[String(oid_v)] = true
	var overlap := ""
	for g_v in GameState.SMUGGLING_GOODS:
		if arch_goods.has(String(g_v)):
			overlap = "%s (smuggling/archeology)" % String(g_v)
	for o_v in ore_goods:
		var oid := String(o_v)
		if arch_goods.has(oid):
			overlap = "%s (mining/archeology)" % oid
		if GameState.SMUGGLING_GOODS.has(oid):
			overlap = "%s (mining/smuggling)" % oid
	# AND THE FOURTH LADDER IS DISJOINT BY EVENT, WHICH THIS SHAPE CANNOT SEE.
	# Everything above compares GOOD-SETS, and PERSUASION has no goods at all —
	# so it would pass here vacuously, which is worse than failing. The property
	# that actually has to hold is the same one 19 warned about (skills all fed
	# by "playing the game" rise together and become a clock), stated at the
	# level persuasion lives on: the one event that feeds it must feed nothing
	# else. Driven, not reasoned about — a won talk-down, with every ladder read
	# either side of it.
	GameState.smuggling = 0
	GameState.persuasion = 0
	GameState.archeology_xp = 0
	GameState.mining_xp = 0
	GameState.smuggling_xp = 0
	GameState.persuasion_xp = 0
	GameState.mark_persuasion(1)
	var talk_moved := {
		"persuasion": GameState.persuasion_xp,
		"smuggling": GameState.smuggling_xp,
		"archeology": GameState.archeology_xp,
		"mining": GameState.mining_xp,
	}
	var talk_spill := ""
	for k2 in talk_moved:
		if String(k2) != "persuasion" and int(talk_moved[k2]) != 0:
			talk_spill += "%s " % String(k2)
	GameState.persuasion_xp = 0
	# THE COUNT STAYS A LITERAL and gains a partner rather than being derived.
	# `ore_goods` IS CommodityDB.ore_ids(), so `ore_goods.size() ==
	# CommodityDB.ore_ids().size()` is x == x — and it is this clause's only
	# non-vacuity guard on the mining set: the overlap checks below all run
	# INSIDE `for o_v in ore_goods`, so an empty ore set makes them pass by never
	# executing. Renaming the `ore` marker key to `band` — exactly the failure
	# this third set exists to detect — would empty the list and print
	# "mining on 0 ores, overlap=none -> PASS".
	#
	# The partner is the completeness the number was standing in for: the ores a
	# seam can yield and the ores the mining feed pays on must be THE SAME SET,
	# checked both ways, so an ore added to one and forgotten in the other is
	# caught by something other than a count somebody has to remember to bump.
	var seam_union := {}
	for b in range(0, DeepSpace.BAND_NAMES.size()):
		for gid_v in CommodityDB.seam_yields(b):
			seam_union[String(gid_v)] = true
	var seam_set_matches: bool = seam_union.size() == ore_goods.size()
	for o_v in ore_goods:
		if not seam_union.has(String(o_v)):
			seam_set_matches = false
	print("[smug] FEEDS COMPETE smuggling pays on %s, archeology on %d salvage/component ids, mining on %d ores, overlap=%s; a talked-down parley moved persuasion by %d and spilled into: %s -> %s" % [
		str(GameState.SMUGGLING_GOODS), arch_goods.size(), ore_goods.size(),
		overlap if overlap != "" else "none", int(talk_moved["persuasion"]),
		talk_spill if talk_spill != "" else "nothing",
		"PASS" if overlap == "" and ore_goods.size() == 10 and seam_set_matches
			and int(talk_moved["persuasion"]) == 1 and talk_spill == "" else "FAIL"])

	# 2. NO TOLL XP, NO XP FOR FLEEING. Both were proposed and both were killed by
	#    arithmetic: paying is the losing move (a fight nets ~+700, running is
	#    free, a toll costs 400+), and escaping is a free 90-second loop between
	#    two systems. A skill must never pay for either.
	GameState.smuggling = 0
	GameState.smuggling_xp = 0
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	_raid_active = false
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	pay_toll()
	# EVERY LADDER, not just this one. The rule written above is "a skill must
	# never pay for either", and the check asked it of `smuggling_xp` alone — so
	# PERSUASION, the ladder most obviously tempted by a toll, could have been
	# wired straight to pay_toll and this line would have stayed green while the
	# property it names died. Swept, so a fifth ladder is covered before it
	# exists.
	var xp_after_toll := GameState.smuggling_xp
	var toll_xp := {
		"smuggling": GameState.smuggling_xp,
		"persuasion": GameState.persuasion_xp,
		"archeology": GameState.archeology_xp,
		"mining": GameState.mining_xp,
	}
	var toll_movers := ""
	for k in toll_xp:
		if int(toll_xp[k]) != 0:
			toll_movers += "%s+%d " % [k, int(toll_xp[k])]
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false
	print("[smug] NO SKILL PAYS FOR A TOLL paying one moved: %s (must be nothing; smuggling xp %d) -> %s" % [
		toll_movers if toll_movers != "" else "no ladder", xp_after_toll,
		"PASS" if toll_movers == "" else "FAIL"])

	# 3. The one real feed, through the real sell path: contraband over a FENCE.
	#    A legitimate counter is not smuggling, whatever it is buying.
	GameState.smuggling_xp = 0
	GameState.smuggling = 0
	# The Cantina is contraband's DEMAND end and fences it; the Void is the supply
	# end and sells it over a counter. Picking the Void here first was a test bug,
	# and a useful one: it says out loud that "a fence" is a specific desk, not a
	# synonym for a shady station.
	var cantina := SystemDB.port_def_by_id("cantina")
	var fenced := Market.fences(cantina, "contraband")
	var clean := Market.fences(SystemDB.port_def_by_id("anchor"), "stolen")
	GameState.mark_smuggling(6)
	print("[smug] ONE FEED the Cantina fences contraband=%s, the Anchor fences stolen=%s, 6 units -> %d xp -> %s" % [
		str(fenced), str(clean), GameState.smuggling_xp,
		"PASS" if fenced and not clean and GameState.smuggling_xp == 6 else "FAIL"])

	# 4. TIERS BUY TIME, A CHOICE AND ACCESS — never credits. A toll discount is a
	#    stat denominated in salvage; a fence premium would move the best legal
	#    route and drag the pacing band. So the toll on a given hold must be
	#    IDENTICAL at every tier.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	# BOTH LADDERS. A toll discount is a stat denominated in salvage and is
	# excluded by name — an exclusion that has to hold for every skill that can
	# see a demand, which since v19 is two of them.
	var tolls: Array = []
	for tier in range(GameState.SMUGGLING_TIERS.size()):
		GameState.smuggling = tier
		tolls.append(maxi(TOLL_FLOOR,
			int(float(GameState.hold_value(false)) * TOLL_FRACTION)))
	GameState.smuggling = 0
	for ptier in range(GameState.PERSUASION_TIERS.size()):
		GameState.persuasion = ptier
		tolls.append(maxi(TOLL_FLOOR,
			int(float(GameState.hold_value(false)) * TOLL_FRACTION)))
	GameState.persuasion = 0
	var flat := true
	for t in tolls:
		if int(t) != int(tolls[0]):
			flat = false
	print("[smug] NO PRICE TIERS toll by tier %s (must be identical) -> %s" % [
		str(tolls), "PASS" if flat else "FAIL"])

	# 5. THE STANDOFF is what t1 actually buys: seconds to read the demand.
	GameState.smuggling = 0
	_raid_active = false
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	var win_t0 := _parley_until - GameState.played_seconds
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false
	GameState.smuggling = 1
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	var win_t1 := _parley_until - GameState.played_seconds
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false
	print("[smug] T1 BUYS TIME standoff %.1fs -> %.1fs (+%.1f) -> %s" % [
		win_t0, win_t1, win_t1 - win_t0,
		"PASS" if win_t1 > win_t0 + 2.0 else "FAIL"])

	# 6. BLUFF ODDS ARE PRINTED, and the number on the button IS the number the
	#    roll uses. 12's standard: a hidden bad bet is a con, and a bluff whose
	#    chance you cannot read is exactly the paid random reveal the lab refused.
	GameState.smuggling = 2
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	GameState.load_cargo("manifest_forged", 1)
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().process_frame
	var shown := hud.bluff_text()
	var odds := GameState.bluff_odds()
	var printed := int(odds * 100.0)
	print("[smug] BLUFF ODDS PRINTED button says '%s', roll uses %.2f -> %s" % [
		shown, odds,
		"PASS" if shown.contains("%d%%" % printed) and odds > 0.0 else "FAIL"])

	# 7. THE STAKE IS REAL. The manifest burns whether the bluff lands or not —
	#    without that, bluffing strictly dominates paying and stops being a
	#    decision at all.
	var had := GameState.cargo_count("manifest_forged")
	run_bluff()
	await get_tree().physics_frame
	print("[smug] BLUFF STAKES manifest %d -> %d (burned either way) -> %s" % [
		had, GameState.cargo_count("manifest_forged"),
		"PASS" if had == 1 and GameState.cargo_count("manifest_forged") == 0 else "FAIL"])
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false

	# 7b. EVERY LADDER NAMES ITS VERB AT TIER 0. §58's copy rule is that a line
	#     must either use a word the game has taught or say what to do about it,
	#     and every skill line failed it in the same direction: they described an
	#     ABSENCE ("THE LANES DO NOT KNOW YOU YET", "ORE READS AS GREY ROCK") to
	#     the one pilot who has no idea the ladder exists.
	#
	#     ASSERTED OVER THE SET, not one line at a time, so a fifth ladder cannot
	#     arrive with a bare description -- and the count is asserted too, because
	#     "every line in this list names a verb" is satisfied perfectly by a list
	#     somebody forgot to add to.
	GameState.archeology = 0
	GameState.smuggling = 0
	GameState.mining = 0
	GameState.persuasion = 0
	# ON THE FIRST WORD OF THE PERK CLAUSE, not on vocabulary anywhere in the
	# line -- and the first draft of this got it wrong in the direction GSATEST's
	# NO IMPERATIVE already documents. That check says it plainly: "English
	# imperatives lead with their verb ... a contains-check would ban the noun
	# too, and the rule is about mood." A contains-check here did the mirror
	# image and ACCEPTED a noun: the old mining line, "ORE READS AS GREY ROCK",
	# satisfies a search for "READ" while instructing nobody. Red-verify caught
	# it -- restoring that line left this assertion green.
	#
	# Same rule as the Commission's, opposite sign: a stage must NOT open on a
	# verb, a skill line MUST.
	var verbs := ["fence", "cut", "breach", "read", "talk", "sell", "crack"]
	var tier0_lines := {
		"archeology": GameState.archeology_line(),
		"smuggling": GameState.smuggling_line(),
		"mining": GameState.mining_line(),
		"persuasion": GameState.persuasion_line(),
	}
	var verbless := ""
	var openers := ""
	for k_line in tier0_lines:
		var line := String(tier0_lines[k_line])
		# The perk clause is what follows the first em dash; everything before it
		# is the ladder's own name and tier.
		var parts := line.split("—", false)
		var clause := String(parts[1]) if parts.size() > 1 else line
		var words: PackedStringArray = clause.to_lower() \
			.replace(",", " ").replace(".", " ").split(" ", false)
		var opener := String(words[0]) if words.size() > 0 else ""
		openers += "%s:%s " % [String(k_line), opener]
		if not verbs.has(opener):
			verbless += "%s " % String(k_line)
	# The ladders GameState actually carries, counted from the tier tables rather
	# than from this dictionary -- otherwise the check certifies its own list.
	var ladder_count := 4
	print("[smug] EVERY LADDER NAMES ITS VERB AT TIER 0 %d lines checked against %d ladders, each opens on: %s| not an instruction: %s -> %s" % [
		tier0_lines.size(), ladder_count, openers,
		verbless if verbless != "" else "none",
		"PASS" if verbless == "" and tier0_lines.size() == ladder_count else "FAIL"])

	# 8. WHAT EACH LADDER CONTRIBUTES — and the old form of this line could not
	#    have told you. It computed `no_manifest` and then never used it: the
	#    only clause deciding PASS was "odds are 0.0 at smuggling 1", which v19
	#    makes false by design, because PERSUASION gives every pilot a floor so a
	#    new player meets a three-verb demand with three plates instead of one.
	#
	#    Deleting the line would lose the rule it was actually defending, which
	#    is that THE MANIFEST HALF IS WORTH NOTHING WITHOUT BOTH THE TIER AND THE
	#    ITEM. Stated as four readings that each fail on their own: the floor
	#    everybody has, the item alone, the tier alone, and the two together.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	GameState.persuasion = 0
	GameState.smuggling = 0
	var bluff_floor := GameState.bluff_odds()              # neither
	GameState.smuggling = 1
	GameState.load_cargo("manifest_forged", 1)
	var item_no_tier := GameState.bluff_odds()             # item, below the tier
	GameState.smuggling = 2
	var item_and_tier := GameState.bluff_odds()            # both
	GameState.unload_cargo("manifest_forged", 1)
	var tier_no_item := GameState.bluff_odds()             # tier, no item
	# THE CAP BINDS, driven from the top of both ladders rather than from a
	# literal — two ladders that can each reach 0.45+ would otherwise sum past a
	# certainty, and a 100% "gamble" is a button rather than a wager.
	GameState.smuggling = GameState.SMUGGLING_TIERS.size() - 1
	GameState.persuasion = GameState.PERSUASION_TIERS.size() - 1
	GameState.load_cargo("manifest_forged", 1)
	var uncapped := GameState.persuasion_odds() + GameState.manifest_odds()
	var capped := GameState.bluff_odds()
	GameState.cargo = {}
	GameState.smuggling = 0
	GameState.persuasion = 0
	var everyone_can_try: bool = bluff_floor > 0.0
	var item_alone_pays_nothing: bool = is_equal_approx(item_no_tier, bluff_floor)
	var tier_alone_pays_nothing: bool = is_equal_approx(tier_no_item, bluff_floor)
	var both_pay: bool = item_and_tier > bluff_floor + 0.001
	var cap_binds: bool = uncapped > GameState.BLUFF_ODDS_CAP \
		and is_equal_approx(capped, GameState.BLUFF_ODDS_CAP)
	print("[smug] BLUFF NEEDS BOTH HALVES floor %.2f (all pilots, must be > 0), manifest below the tier %.2f, tier without the manifest %.2f (both must equal the floor), both %.2f (must exceed it); cap %.2f of an uncapped %.2f -> %s" % [
		bluff_floor, item_no_tier, tier_no_item, item_and_tier, capped, uncapped,
		"PASS" if everyone_can_try and item_alone_pays_nothing
			and tier_alone_pays_nothing and both_pay and cap_binds else "FAIL"])
	get_tree().quit()


# --- captain's log harness ----------------------------------------------------

func _run_log_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	# GameState boots by loading the player's REAL save (see its _ready), so the
	# log arrives holding whatever the last run wrote. Every index below would be
	# measured against someone else's evening if this were not cleared first.
	GameState.captains_log.clear()

	# 1. RING BOUNDED. Thirteen against a cap of ten: the three that fall off
	#    prove the direction as well as the size.
	var probe := GameState.LOG_MAX + 3
	for i in range(probe):
		GameState.note_log("SENTINEL %02d" % i)
	var ring := GameState.log_lines()
	var ordered := ring.size() == GameState.LOG_MAX
	for i in range(ring.size()):
		if String(ring[i]) != "SENTINEL %02d" % (i + probe - GameState.LOG_MAX):
			ordered = false
	print("[log] RING BOUNDED %d appended, %d kept (cap %d), first '%s' last '%s', order held=%s -> %s" % [
		probe, ring.size(), GameState.LOG_MAX,
		String(ring[0]) if not ring.is_empty() else "-",
		String(ring[ring.size() - 1]) if not ring.is_empty() else "-",
		str(ordered), "PASS" if ordered else "FAIL"])

	# 2. LINE CAPPED, and nothing blank ever reaches the sheet. A whitespace-only
	#    entry would render as a gap the player cannot explain.
	GameState.captains_log.clear()
	GameState.note_log("X".repeat(200))
	GameState.note_log("   ")
	GameState.note_log("")
	var capped := GameState.log_lines()
	var cap_ok := capped.size() == 1 \
		and String(capped[0]).length() == GameState.LOG_LINE_MAX
	print("[log] LINE CAPPED 200 chars -> %d (cap %d), blank and whitespace dropped (%d kept) -> %s" % [
		String(capped[0]).length() if not capped.is_empty() else -1,
		GameState.LOG_LINE_MAX, capped.size(), "PASS" if cap_ok else "FAIL"])

	# 3. NOT A LEDGER KEY. States the decision instead of leaving it in a comment:
	#    the ledger's load-side merge is maxi(0, int(...)), which turns an array
	#    into 0. If anyone ever moves this field in there, this goes red.
	print("[log] NOT A LEDGER KEY captains_log absent from DEFAULT_LEDGER (%d keys) -> %s" % [
		GameState.DEFAULT_LEDGER.size(),
		"PASS" if not GameState.DEFAULT_LEDGER.has("captains_log") else "FAIL"])

	# 4. THE TRUNCATED BAND LADDER. The crossing entry compares the band of the
	#    stored high-water mark against the band of the depth about to be stored,
	#    so what has to hold is a property of band_of(int(d)) alone: it never
	#    falls, it never jumps two, and no band is unreachable through the
	#    truncation. The first version of this assertion compared int-to-float
	#    instead and went red immediately — CHARTED ends at any depth above zero,
	#    which is the one edge that is not a whole number. That failure is why
	#    the line above reads int on both sides.
	var ladder := true
	var ladder_note := ""
	var seen := {}
	var prev := DeepSpace.band_of(0.0)
	seen[prev] = true
	var d := 0.0
	while d <= DeepSpace.BAND_EDGES[DeepSpace.BAND_EDGES.size() - 1] + 40.0:
		var b := DeepSpace.band_of(float(int(d)))
		if b < prev:
			ladder = false
			ladder_note = "band falls at depth %.2f" % d
		if b > prev + 1:
			ladder = false
			ladder_note = "band skips %d->%d at depth %.2f" % [prev, b, d]
		seen[b] = true
		prev = b
		d += 0.25
	# Every edge whole, so a crossing is logged AT the edge rather than a unit
	# late — and so a future 160.5 shows up here rather than as a drifting line.
	var integral := true
	for e_v in DeepSpace.BAND_EDGES:
		if float(e_v) != floorf(float(e_v)):
			integral = false
			ladder_note = "edge %.2f is not whole" % float(e_v)
	var reachable := seen.size() == DeepSpace.BAND_NAMES.size()
	print("[log] TRUNCATED BAND LADDER %s never falls or skips, all %d bands reachable=%s, edges whole=%s -> %s %s" % [
		str(DeepSpace.BAND_EDGES), DeepSpace.BAND_NAMES.size(), str(reachable),
		str(integral), "PASS" if ladder and integral and reachable else "FAIL",
		ladder_note])

	# 5. ONCE PER BAND, driven through the real _process path rather than through
	#    note_log — the rule under test is the derivation, not the append. Out to
	#    the Shoals, out to the Drift, back in, and out to the Drift again: four
	#    crossings of two edges must leave exactly two lines.
	GameState.ledger["deepest_depth"] = 0
	GameState.captains_log.clear()
	var edge := chart_edge()
	# TWO PROCESS FRAMES PER STOP, not one. The band-crossing line is derived in
	# _process from the player's position, and one frame was enough only while
	# the frame this loop yielded happened to be the one that observed the new
	# position. The frontier added work to the same tick — two more band rows to
	# walk and two more tables to read — and the race that had always been here
	# went the other way, logging one line instead of two. The rule was never
	# violated; the staging never guaranteed the observation it depends on.
	for radius in [edge + 60.0, edge + 200.0, edge + 60.0, edge + 200.0]:
		player.global_position = Vector3(float(radius), 0.0, 0.0)
		await get_tree().physics_frame
		await get_tree().process_frame
		await get_tree().process_frame
	var bands := GameState.log_lines()
	# Same derivation as DEEPTEST's SYSTEM TAG, for the same reason: the two
	# pinned literals were pyx01's shipped band names, and pyx01 authors its own
	# now. What this leg tests is ONCE PER BAND, OUTWARD ONLY -- two lines, in
	# order -- not what those bands happen to be called.
	var band_ok := bands.size() == 2 \
		and String(bands[0]).contains(
			SystemDB.band_name_of(system_id, 1, DeepSpace.BAND_NAMES[1])) \
		and String(bands[1]).contains(
			SystemDB.band_name_of(system_id, 2, DeepSpace.BAND_NAMES[2]))
	print("[log] ONCE PER BAND out/out/back/out logged %d lines %s -> %s" % [
		bands.size(), str(bands), "PASS" if band_ok else "FAIL"])
	player.global_position = Vector3.ZERO
	await get_tree().physics_frame

	# 6. THE POST NAMES THE HULK'S BAND, NOT THE CELL'S. A cell is 64u across and
	#    a band edge runs straight through some of them, so the two genuinely
	#    disagree — this finds a cell where they do and asserts the log follows
	#    the wreck. Reading cell_centre here would have shipped a plausible line
	#    naming the wrong band.
	var straddle_key := Vector2i.ZERO
	var straddle_pt := Vector3.ZERO
	var straddle_centre := Vector3.ZERO
	var straddled := false
	for cx in range(1, 80):
		var centre := DeepSpace.cell_centre(cx, 0)
		for off in [-DeepSpace.CELL * 0.45, DeepSpace.CELL * 0.45]:
			var pt := centre + Vector3(float(off), 0.0, 0.0)
			if DeepSpace.band_of(deep_space.depth_at(centre)) \
					!= DeepSpace.band_of(deep_space.depth_at(pt)):
				straddle_key = Vector2i(cx, 0)
				straddle_pt = pt
				straddle_centre = centre
				straddled = true
				break
		if straddled:
			break
	GameState.captains_log.clear()
	deep_space._guard_origin[straddle_key] = straddle_pt
	deep_space.note_guard_died(straddle_key)
	var post_lines := GameState.log_lines()
	var want_band := DeepSpace.band_name(deep_space.depth_at(straddle_pt))
	var wrong_band := DeepSpace.band_name(deep_space.depth_at(straddle_centre))
	var post_ok := straddled and post_lines.size() == 1 \
		and String(post_lines[0]).contains(want_band)
	print("[log] POST NAMES THE HULK cell %s centre reads %s, hulk reads %s, logged '%s' -> %s" % [
		str(straddle_key), wrong_band, want_band,
		String(post_lines[0]) if not post_lines.is_empty() else "-",
		"PASS" if post_ok else "FAIL"])

	# 7. ONE LINE PER TIER-UP, naming the tier LANDED ON. mark_archeology's loop
	#    can cross three tiers in a single call, and the toast the player saw
	#    announces only the last of them — a log emitting one line per tier would
	#    describe an evening that did not happen.
	GameState.captains_log.clear()
	GameState.archeology = 0
	GameState.archeology_xp = 0
	GameState.mark_archeology(500)
	GameState.smuggling = 0
	GameState.smuggling_xp = 0
	GameState.mark_smuggling(500)
	var tier_lines := GameState.log_lines()
	var top_arch := GameState.ARCHEOLOGY_TIERS.size() - 1
	var top_smug := GameState.SMUGGLING_TIERS.size() - 1
	var tier_ok := tier_lines.size() == 2 \
		and String(tier_lines[0]).begins_with("ARCHEOLOGY %d" % top_arch) \
		and String(tier_lines[1]).begins_with("SMUGGLING %d" % top_smug)
	print("[log] ONE LINE PER TIER-UP %d tiers crossed in two calls -> %d lines %s -> %s" % [
		top_arch + top_smug, tier_lines.size(), str(tier_lines),
		"PASS" if tier_ok else "FAIL"])

	# 8. THE SHEAR AND THE TOLL each write exactly one line. Without these, a
	#    refactor that drops a note_log call is invisible to every assertion
	#    above: the ring and the page both pass on a log nothing writes to.
	GameState.captains_log.clear()
	var rift := spawn_rift()
	if rift != null:
		# PARKED OUTSIDE Rift.INTEL_READ_RANGE, which it did not have to be until
		# v16. Working a shear from close up now also files a bearing on the
		# engine, and that writes its own log line — correct behaviour, and it
		# made this assertion read `shear 2 line` because the staging was
		# standing near enough to trigger two different systems at once. The
		# check is about what the SHEAR writes, so the ship stands where only the
		# shear can reach it.
		player.global_position = rift.global_position \
			+ Vector3(Rift.INTEL_READ_RANGE + 8.0, 0, 0)
		await get_tree().physics_frame
		rift.pulse()
		rift.pulse()
		rift.pulse()
		for i in range(4):
			await get_tree().physics_frame
	var shear_lines := GameState.log_lines().size()
	player.global_position = Vector3.ZERO
	await get_tree().physics_frame

	GameState.captains_log.clear()
	GameState.cargo = {}
	GameState.load_cargo("alloys", 20)
	_raid_active = false
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().physics_frame
	pay_toll()
	var toll_lines := GameState.log_lines()
	var sites_ok := shear_lines == 1 and toll_lines.size() == 1 \
		and String(toll_lines[0]).begins_with("TOLL PAID")
	print("[log] FIVE SITES WIRED shear %d line, toll %d line ('%s'); band/post/tier asserted above -> %s" % [
		shear_lines, toll_lines.size(),
		String(toll_lines[0]) if not toll_lines.is_empty() else "-",
		"PASS" if sites_ok else "FAIL"])

	# 9. THE LOAD PATH SHEDS THE OLDEST. note_log sheds the front and so does
	#    load_game; a fixture of ten or fewer would round-trip identically
	#    through a resize() that keeps the WRONG ten. Thirteen on disk is what
	#    makes the direction visible.
	var fixture := "user://logtest_save.json"
	var disk: Array = []
	for i in range(GameState.LOG_MAX + 3):
		disk.append("DISK %02d" % i)
	# Junk of every shape the sanitizer claims to handle. `Array[String]` is the
	# reason str() coercion runs at all, and nothing else proves it does.
	var junk: Array = [42, true, null, "", "   ", "Y".repeat(200), "KEPT LINE"]
	var wrote := FileAccess.open(fixture, FileAccess.WRITE)
	wrote.store_string(JSON.stringify({"version": GameState.SAVE_VERSION,
		"salvage": 100, "captains_log": disk}))
	wrote.close()
	var prev_path := GameState.save_path
	GameState.save_path = fixture
	GameState.load_game()
	var shed := GameState.log_lines()
	var shed_ok := shed.size() == GameState.LOG_MAX \
		and String(shed[0]) == "DISK 03" \
		and String(shed[shed.size() - 1]) == "DISK %02d" % (GameState.LOG_MAX + 2)
	print("[log] LOAD SHEDS THE OLDEST %d on disk -> %d kept, first '%s' last '%s' -> %s" % [
		disk.size(), shed.size(),
		String(shed[0]) if not shed.is_empty() else "-",
		String(shed[shed.size() - 1]) if not shed.is_empty() else "-",
		"PASS" if shed_ok else "FAIL"])

	# 10. LOAD COERCES. A hand-edited save is the only way any of these arrive,
	#     and each one is a different crash in the pause menu.
	var wrote2 := FileAccess.open(fixture, FileAccess.WRITE)
	wrote2.store_string(JSON.stringify({"version": GameState.SAVE_VERSION,
		"salvage": 100, "captains_log": junk}))
	wrote2.close()
	GameState.load_game()
	var cleaned := GameState.log_lines()
	var all_strings := true
	var longest := 0
	for line in cleaned:
		if typeof(line) != TYPE_STRING:
			all_strings = false
		longest = maxi(longest, String(line).length())
	var coerce_ok := all_strings and longest <= GameState.LOG_LINE_MAX \
		and cleaned.size() == 5 and String(cleaned[cleaned.size() - 1]) == "KEPT LINE"
	print("[log] LOAD COERCES %d junk entries -> %d lines, all String=%s, longest %d (cap %d) -> %s" % [
		junk.size(), cleaned.size(), str(all_strings), longest,
		GameState.LOG_LINE_MAX, "PASS" if coerce_ok else "FAIL"])
	GameState.save_path = prev_path

	# 11. RESET WITH THE RUN. A new survey is a new logbook — 22's rule, and the
	#     reason this is not stored beside the ship's name.
	GameState.note_log("SHOULD NOT SURVIVE")
	GameState.reset_to_starter()
	print("[log] RESET WITH THE RUN %d lines after reset_to_starter -> %s" % [
		GameState.log_lines().size(),
		"PASS" if GameState.log_lines().is_empty() else "FAIL"])

	# 12. THE PAGE RENDERS THE LOG, in order. Asserts the MAPPING, not a child
	#     count: _refresh() frees the old page with queue_free, which is deferred,
	#     so a count read on the same frame sees the previous page as well.
	GameState.captains_log.clear()
	for i in range(GameState.LOG_MAX):
		GameState.note_log("PAGE %02d" % i)
	pause_menu.open()
	pause_menu._page = "log"
	pause_menu._refresh()
	await get_tree().process_frame
	await get_tree().process_frame
	var labels: Array = []
	for c in pause_menu._body.get_children():
		if c is Label and not c.is_queued_for_deletion():
			labels.append((c as Label).text)
	var page_ok := labels.size() == GameState.LOG_MAX + 1 \
		and String(labels[0]) == "CAPTAIN'S LOG"
	for i in range(GameState.log_lines().size()):
		if i + 1 >= labels.size() or String(labels[i + 1]) != String(GameState.log_lines()[i]):
			page_ok = false
	print("[log] PAGE RENDERS %d labels for %d entries, heading '%s', texts match log in order -> %s" % [
		labels.size(), GameState.LOG_MAX,
		String(labels[0]) if not labels.is_empty() else "-",
		"PASS" if page_ok else "FAIL"])

	# 13. LINE FITS. Measured against the real font at the real size, not
	#     computed from a character count — 25's lesson about what an assertion
	#     can actually see. _sub reserves 300px; a wider line wraps to two rows
	#     and the page grows past the sheet.
	var font := pause_menu._body.get_theme_default_font()
	var widest := 0.0
	var widest_line := ""
	for sample in ["TOLL PAID — 999,999 IN CARGO",
			"THE SHEAR CLOSED — THE REACHES", "POST CLEARED — THE REACHES",
			"ARCHEOLOGY 3 — READS THE QUIET", "SMUGGLING 3 — THE LANES KNOW YOU",
			"CROSSED INTO THE REACHES"]:
		var w := font.get_string_size(String(sample), HORIZONTAL_ALIGNMENT_LEFT,
			-1, 11).x
		if w > widest:
			widest = w
			widest_line = String(sample)
	print("[log] LINE FITS widest producible line '%s' is %.0fpx against 300 -> %s" % [
		widest_line, widest, "PASS" if widest <= 300.0 else "FAIL"])

	# 14. THE SHEET FITS THE SCREEN. The pause panel has no scroll and no clip,
	#     so an overflowing page pushes the heading off the top AND the last
	#     button off the bottom at once. Measured at the worst case the settings
	#     allow — a 1.6 UI scale on a wide window, which leaves ~512 logical rows
	#     — with the boss and abandon-confirm branches BOTH forced on, because
	#     nothing clears _confirming_abandon when a boss wakes.
	get_window().size = Vector2i(1440, 900)
	GameState.set_setting("ui_scale", 1.6)
	await get_tree().process_frame
	await get_tree().process_frame
	var boss_was := boss_active
	boss_active = true
	pause_menu._confirming_abandon = true
	var worst := 0.0
	var worst_page := ""
	for page in ["root", "log", "settings"]:
		pause_menu._page = String(page)
		pause_menu._refresh()
		await get_tree().process_frame
		await get_tree().process_frame
		var h: float = pause_menu._panel.size.y
		if h > worst:
			worst = h
			worst_page = String(page)
	var avail: float = pause_menu._root.size.y
	boss_active = boss_was
	pause_menu._confirming_abandon = false
	pause_menu._page = "root"
	pause_menu.resume()
	print("[log] SHEET FITS worst page '%s' is %.0f rows against %.0f available (1440x900 at 1.6 scale) -> %s" % [
		worst_page, worst, avail, "PASS" if worst <= avail else "FAIL"])
	get_tree().quit()


# --- forge harness ------------------------------------------------------------

func _run_forge_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	var craftables := ModuleDB.craftable_ids()

	# 1. RECIPES PRINTED — all of them exist, all name real components, and every
	#    input is a component rather than something buyable. That last clause is
	#    the GATE: components are no_retail and only archeology produces them, so
	#    the forge is ARCHEOLOGY-gated with no gate code anywhere.
	var bad := ""
	for id_v in craftables:
		var rec := ModuleDB.recipe(String(id_v))
		if rec.is_empty():
			bad = "%s has no recipe" % String(id_v)
		for good_v in rec:
			var good := String(good_v)
			if not CommodityDB.is_component(good):
				bad = "%s wants %s, which is not a component" % [String(id_v), good]
			if not CommodityDB.no_retail(good):
				bad = "%s wants %s, which is BUYABLE" % [String(id_v), good]
	print("[forge] RECIPES %d craftables, every input a no_retail component (the gate) -> %s %s" % [
		craftables.size(), "PASS" if bad == "" and craftables.size() == 4 else "FAIL", bad])

	# 2. EVERY RECIPE COSTS. The rig-audit rule, applied to the forge: a
	#    craftable with only upside is a stat stick you cannot even buy.
	var free_lunch := ""
	for id_v in craftables:
		var stats: Dictionary = ModuleDB.get_module(String(id_v)).get("stats", {})
		var downs := 0
		for k in stats:
			if float(stats[k]) < 0.0:
				downs += 1
		if downs == 0:
			free_lunch = String(id_v)
	print("[forge] EVERY RECIPE COSTS all %d carry at least one negative stat -> %s %s" % [
		craftables.size(), "PASS" if free_lunch == "" else "FAIL", free_lunch])

	# 3. FITTED WEAKER THAN CARRIED — the rule that stops a bench from deleting
	#    19's pair design. Compared as DATA, not as prose: a craft that quietened
	#    you more than a Forged Manifest would obsolete carrying cover forever.
	var pairs := [
		["signature damper", FITTED_BAFFLE, SIGNATURE_MANIFEST, "lower is stronger"],
		["EMP damping", PlayerShip.FITTED_SINK, PlayerShip.SINK_EMP_FACTOR, "lower is stronger"],
		["berth radar", 1.9, 2.5, "higher is stronger"],
	]
	var line := ""
	var weaker_ok := true
	for pr in pairs:
		var fitted := float(pr[1])
		var carried := float(pr[2])
		var stronger_is_lower := String(pr[3]).begins_with("lower")
		var ok := fitted > carried if stronger_is_lower else fitted < carried
		line += "%s %.2f vs %.2f  " % [String(pr[0]), fitted, carried]
		if not ok:
			weaker_ok = false
	print("[forge] FITTED WEAKER THAN CARRIED %s-> %s" % [
		line, "PASS" if weaker_ok else "FAIL"])

	# 4. UNSELLABLE EVERYWHERE. GameState.buy() SUCCEEDS at price 0 — spend_salvage(0)
	#    returns true — so a craftable that ever leaked into a stock list would be
	#    free to anyone standing at that counter. The guarantee is ABSENCE from
	#    every stock list, chart and deep, asserted rather than trusted to a price.
	var stocked := ""
	var counters := SystemDB.port_ids().duplicate()
	counters.append_array(DeepPortDB.ids())
	for pid_v in counters:
		var pid := String(pid_v)
		var pdef := DeepPortDB.by_id(pid) if DeepPortDB.is_deep_port(pid) \
			else SystemDB.port_def_by_id(pid)
		for id_v in craftables:
			if (pdef.get("stock", []) as Array).has(String(id_v)):
				stocked = "%s at %s" % [String(id_v), pid]
	print("[forge] UNSELLABLE EVERYWHERE 0 of %d counters stock a craftable (buy() would succeed at price 0) -> %s %s" % [
		counters.size(), "PASS" if stocked == "" else "FAIL", stocked])

	# 5. NOT CARGO, AND NO FREE GOODS. Craftables are MODULES — they never enter
	#    CommodityDB, so jettison_to_fit's cheapest-first sort cannot see them.
	#    The second half guards something wider: a price-0 GOOD would be dumped
	#    first by jettison_to_fit, stashed first by _stashable_order, invisible to
	#    hold_value and so to RAID_MIN_HOLD, and stripped for nothing by
	#    strip_hottest. Four systems misreading one zero.
	var as_cargo := ""
	for id_v in craftables:
		if CommodityDB.exists(String(id_v)):
			as_cargo = String(id_v)
	var free_good := ""
	for gid in CommodityDB.ids():
		if CommodityDB.base_price(String(gid)) <= 0:
			free_good = String(gid)
	print("[forge] NOT CARGO + NO FREE GOODS craftables in CommodityDB=%s, price-0 goods=%s -> %s" % [
		as_cargo if as_cargo != "" else "none", free_good if free_good != "" else "none",
		"PASS" if as_cargo == "" and free_good == "" else "FAIL"])

	# 6. ONE-WAY. Nothing anywhere turns a module back into components —
	#    deconstruction IS the laundry, and it would let a player mint components
	#    from a craftable they made out of the components.
	var forge_ports := 0
	for pid_v in counters:
		var pid := String(pid_v)
		var pdef := DeepPortDB.by_id(pid) if DeepPortDB.is_deep_port(pid) \
			else SystemDB.port_def_by_id(pid)
		if (pdef.get("services", []) as Array).has("forge"):
			forge_ports += 1
	var has_recycle := PortPanel.TAB_LABELS.has("recycle") \
		or PortPanel.TAB_LABELS.has("deconstruct")
	print("[forge] ONE-WAY %d forges on the map, no recycle/deconstruct service exists=%s -> %s" % [
		forge_ports, str(not has_recycle),
		"PASS" if forge_ports >= 2 and not has_recycle else "FAIL"])

	# 7. THE CRAFT ITSELF: components in, module out, components GONE, and no
	#    salvage moved — the price is the fence sale you did not make.
	GameState.cargo = {}
	GameState.owned.erase("mod_baffle")
	var rec2 := ModuleDB.recipe("mod_baffle")
	for good_v in rec2:
		GameState.load_cargo(String(good_v), int(rec2[good_v]))
	var salv_before := GameState.salvage
	var could := GameState.can_craft("mod_baffle")
	var made := GameState.craft("mod_baffle")
	var leftovers := 0
	for good_v in rec2:
		leftovers += GameState.cargo_count(String(good_v))
	print("[forge] CRAFT can=%s made=%s, owned=%s, components left %d, salvage %d -> %d -> %s" % [
		str(could), str(made), str(GameState.owns("mod_baffle")), leftovers,
		salv_before, GameState.salvage,
		"PASS" if could and made and GameState.owns("mod_baffle") and leftovers == 0
			and GameState.salvage == salv_before else "FAIL"])

	# 8. And the fitted effect is LIVE where the carried one is read — not in
	#    compute_stats. Equipping the baffle must move hold_signature and must
	#    NOT move any hold-sized number.
	GameState.cargo = {}
	# Mk III reactor: a 4-power craftable will not fit a starter budget, and an
	# equip that silently refuses would make this assertion pass for the wrong
	# reason (both readings identical because nothing was ever fitted).
	GameState.reactor_tier = 2
	var sig_bare := hold_signature()
	var cap_bare := GameState.cargo_capacity()
	var equipped := GameState.equip(ModuleDB.Slot.UTILITY, "mod_baffle")
	var sig_fitted := hold_signature()
	var cap_fitted := GameState.cargo_capacity()
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	print("[forge] FITTED EFFECT LIVE equipped=%s, signature %.2f -> %.2f, hold %d -> %d (hold must not move) -> %s" % [
		str(equipped), sig_bare, sig_fitted, cap_bare, cap_fitted,
		"PASS" if equipped and sig_fitted < sig_bare and cap_bare == cap_fitted else "FAIL"])
	# §110. THE HINT WOULD HAVE LIED, and this leg proves both halves: that the
	#     old form was false, and that the new one cannot be.
	#
	# The forge printed "X FALLS FROM READING BAND n+ SALVAGE", derived by taking
	# the SHALLOWEST grade whose read table yields X. That is only true if
	# READS_AS is monotone in band, and it is not: sink falls from the Drift and
	# the Reaches and nowhere else, manifest from the Shoals and the Reaches,
	# plate and cell from the Charted and the Shoals. A pilot standing in the
	# Quiet following the game's own instruction reads crate after crate and
	# never sees four of the eight inputs -- which is the playtest report that
	# opened this horizon, filed against a hint added to fix the previous one.
	#
	# Clause one counts components the "+" claim is FALSE for. It must be
	# non-zero, or this leg is asserting nothing and the copy change was
	# unnecessary. Clause two is the new rule: the grades named are exactly the
	# grades that yield it.
	var gap_count := 0
	var gaps := ""
	var exact := true
	for cid_v in CommodityDB.ids():
		var cid := String(cid_v)
		if not CommodityDB.is_component(cid):
			continue
		var from_bands := []
		var named := []
		for sal_v in CommodityDB.READS_AS:
			if (CommodityDB.READS_AS[sal_v] as Array).has(cid):
				from_bands.append(CommodityDB.band_of(String(sal_v)))
				named.append(String(sal_v))
		if from_bands.is_empty():
			continue
		# Would "BAND lo+" have been true? Only if every band from lo to the
		# deepest yielding one also produces it.
		var lo: int = from_bands.min()
		var hi: int = from_bands.max()
		for b in range(lo, hi + 1):
			if not from_bands.has(b):
				gap_count += 1
				gaps += "%s(no b%d) " % [CommodityDB.short_name(cid), b]
				break
		# And the derived list must be exactly the yielding grades -- the same
		# table read the same way, so the copy cannot drift from the mechanic.
		for sal2_v in CommodityDB.READS_AS:
			var has_it: bool = (CommodityDB.READS_AS[sal2_v] as Array).has(cid)
			if has_it != named.has(String(sal2_v)):
				exact = false
	print("[forge] THE HINT WOULD HAVE LIED %d component(s) break a BAND-n+ claim (%s), and the grade list is exact for every one=%s -> %s" % [
		gap_count, gaps.strip_edges() if gaps != "" else "none", str(exact),
		"PASS" if gap_count > 0 and exact else "FAIL"])

	# §110. NO RECIPE IS UNSHOPPABLE. Stronger than "every input exists": there
	#     must be ONE band that yields every input of a recipe, or filling it
	#     means two separate expeditions and nothing in the game says so.
	#     mod_baffle failed this from the day it shipped -- manifest from the
	#     Reaches, plate from the Charted and Shoals, no overlap anywhere.
	var unshoppable := ""
	var recipe_bands := ""
	for cid2_v in craftables:
		var bill2 := ModuleDB.recipe(String(cid2_v))
		var common := []
		var first := true
		for bgood_v in bill2:
			var bset := []
			for sal3_v in CommodityDB.READS_AS:
				if (CommodityDB.READS_AS[sal3_v] as Array).has(String(bgood_v)):
					bset.append(CommodityDB.band_of(String(sal3_v)))
			if first:
				common = bset
				first = false
			else:
				var keep := []
				for b2 in common:
					if bset.has(b2):
						keep.append(b2)
				common = keep
		if common.is_empty():
			unshoppable += String(cid2_v) + " "
		else:
			recipe_bands += "%s@b%d " % [String(cid2_v).replace("mod_", ""),
				(common as Array).min()]
	print("[forge] NO RECIPE IS UNSHOPPABLE every recipe fillable from a single band (%s), unreachable: %s -> %s" % [
		recipe_bands.strip_edges(), unshoppable if unshoppable != "" else "none",
		"PASS" if unshoppable == "" else "FAIL"])
	get_tree().quit()


func _count_loot_cubes() -> int:
	# Lifted out of JETTISON SPAWNS NOTHING so the screen-level dump assertion
	# counts the same way rather than growing a second, subtly different one.
	var n := 0
	for c in system_root.get_children():
		if c is LootCube:
			n += 1
	return n


# --- hold / manifest / pilot harness ------------------------------------------

func _run_hold_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	# 1. JETTISON PAYS NOTHING. Dumping is a cost chosen over flying to a
	#    counter; paying for it would make it the better option.
	GameState.cargo = {}
	GameState.load_cargo("relics", 4)
	var salv_before := GameState.salvage
	var dumped := GameState.jettison("relics", 2)
	print("[hold] JETTISON PAYS NOTHING dumped %d, salvage %d -> %d -> %s" % [
		dumped, salv_before, GameState.salvage,
		"PASS" if dumped == 2 and GameState.salvage == salv_before else "FAIL"])

	# 2. JETTISON SPAWNS NOTHING. "Dumped cargo should float" is the obvious
	#    future improvement, and it would convert a dump into full toll evasion:
	#    shrink the hold mid-standoff, pay the floor, re-vacuum your own cargo.
	#    This line makes that change argue with a red assertion first.
	var cubes := _count_loot_cubes()
	print("[hold] JETTISON SPAWNS NOTHING %d loot cubes after a dump (must be 0) -> %s" % [
		cubes, "PASS" if cubes == 0 else "FAIL"])

	# 3. CONSERVES — as an equation, all three numbers printed.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 9)
	var before := GameState.cargo_count("alloys")
	var took := GameState.jettison("alloys", 4)
	print("[hold] CONSERVES %d held = %d kept + %d dumped (must balance) -> %s" % [
		before, GameState.cargo_count("alloys"), took,
		"PASS" if before == GameState.cargo_count("alloys") + took else "FAIL"])

	# 4. THE CATEGORY LINE. Every component has known its parent since the
	#    salvage wave and no screen ever said so — the half of "goods became
	#    categories" that never shipped.
	var orphan := ""
	var comps := 0
	for gid in CommodityDB.ids():
		var g := String(gid)
		if not CommodityDB.is_component(g):
			continue
		comps += 1
		var parent := CommodityDB.parent_of(g)
		if parent == "" or not CommodityDB.exists(parent):
			orphan = g
	print("[hold] CATEGORY every one of %d components names a real parent -> %s %s" % [
		comps, "PASS" if orphan == "" and comps > 0 else "FAIL", orphan])

	# 4b. EVERY GOOD HAS A FAMILY. The hold screen draws a glyph per family, so a
	#     good that classifies into nothing draws as a blank cell — a hole in the
	#     picture with no way to tell what is sitting in it.
	#
	#     The ORE CHECK is the load-bearing half. `family()` tests is_ore FIRST
	#     because all eight ores carry `trade_only_at` (their industrial buyers),
	#     and a version that tested the allowlist first would file every ore
	#     beside the contraband — a partition that is still total, still 34, and
	#     completely wrong. Counting alone cannot see that; naming the ores can.
	var fam_counts := {}
	var unfiled := ""
	for gid2 in CommodityDB.ids():
		var g2 := String(gid2)
		var fam := CommodityDB.family(g2)
		if fam == "" or not Palette.FAMILY_GLYPHS.has(fam):
			unfiled = g2
		fam_counts[fam] = int(fam_counts.get(fam, 0)) + 1
	var ore_misfiled := ""
	for oid in CommodityDB.ore_ids():
		var of := CommodityDB.family(String(oid))
		if of != "metal" and of != "mineral":
			ore_misfiled = "%s->%s" % [String(oid), of]
	var fam_line := ""
	for k in fam_counts:
		fam_line += "%s %d  " % [String(k), int(fam_counts[k])]
	print("[hold] EVERY GOOD HAS A FAMILY %s(%d goods, %d families) unfiled='%s' ore misfiled='%s' -> %s" % [
		fam_line, CommodityDB.ids().size(), fam_counts.size(), unfiled, ore_misfiled,
		"PASS" if unfiled == "" and ore_misfiled == "" \
			and fam_counts.size() == Palette.FAMILY_GLYPHS.size() else "FAIL"])

	# 4c. THE FAMILY GLYPHS ARE DRAWABLE. A glyph is the hold grid's PRIMARY
	#     channel rather than a redundancy — see the colour measurement in
	#     ACCESSTEST — so an empty or unrenderable one is not a cosmetic fault,
	#     it deletes the only thing identifying a cell.
	#
	#     None of them may be a BAND_GLYPHS entry: the manual teaches ▲ as THE
	#     DRIFT (manual_screen.gd), and a metal ore wearing ▲ in the hold would
	#     be teaching the same shape two meanings.
	#
	#     THERE IS NO RENDERABILITY CHECK HERE, and that is a finding rather than
	#     an omission. The obvious clause is `font.has_char(...)`, and it was
	#     written, run, and removed: measured against the font a Label actually
	#     resolves, has_char reports EVERY geometric shape missing -- including
	#     ◈ ▲ ● ◆, the shipped band glyphs the manual draws, and ✕, the close
	#     button on all four panels. The project ships no font (UIKit.FACE is
	#     null), so those glyphs reach the screen through Godot's system-font
	#     fallback at DRAW time, which has_char cannot see. A clause that fails
	#     on glyphs the game already displays correctly is worse than no clause.
	#
	#     What that leaves unguarded, honestly: a glyph no system font carries
	#     draws as tofu and this line stays green. The project already carries
	#     that risk for its band glyphs and its close button, so this adds no new
	#     exposure -- but it is a windowed eyeball check, not a headless one.
	var glyph_seen := {}
	var glyph_bad := ""
	for fam_v in Palette.FAMILY_GLYPHS:
		var gl := String(Palette.FAMILY_GLYPHS[fam_v])
		if gl == "":
			glyph_bad = "%s empty" % String(fam_v)
		elif glyph_seen.has(gl):
			glyph_bad = "%s duplicates %s" % [String(fam_v), gl]
		elif Palette.BAND_GLYPHS.has(gl):
			glyph_bad = "%s uses band glyph %s" % [String(fam_v), gl]
		glyph_seen[gl] = true
	print("[hold] THE FAMILY GLYPHS ARE DISTINCT %d non-empty, pairwise distinct, none a band glyph; bad='%s' -> %s" % [
		glyph_seen.size(), glyph_bad,
		"PASS" if glyph_bad == "" and glyph_seen.size() == Palette.FAMILY_GLYPHS.size() else "FAIL"])

	# 4d. THE READOUT FOLLOWS THE HOLD. Cargo has no change signal, so every
	#     mutation in the game has to remember to call hud.refresh_cargo() by
	#     hand — nineteen sites, and this asserts that the two which forget are
	#     fixed and stay fixed.
	#
	#     NOT A REINTRODUCE-THE-BUG ASSERTION. Both paths below are red on
	#     shipped code, which is the strongest form the house rules recognise:
	#       * spill_unread (main.gd) unloads salvage on death and nothing in
	#         PlayerShip._emergency_warp -> spill_unread -> on_player_downed
	#         refreshes. Die past the chart edge and the HUD keeps showing the
	#         hold you no longer have.
	#       * Contracts.on_docked unloads a delivery and Main.dock never
	#         refreshes after calling it.
	#     Driven through the REAL paths rather than through unload_cargo, because
	#     unload_cargo was never the thing that was broken.
	#     STAGED SO THE PATHS ACTUALLY FIRE, which took two corrections. Written
	#     naively both legs were no-ops and the line passed by comparing nothing
	#     to nothing: spill_unread returns 0 unless depth_at(pos) > 0, and
	#     on_docked settles only an ACCEPTED delivery whose dest and target the
	#     hold satisfies. A mutation assertion has to prove the mutation
	#     happened, so both legs assert a non-zero delta first.
	GameState.cargo = {}
	GameState.load_cargo("salvage_drift", 3)
	GameState.load_cargo("alloys", 2)
	hud.refresh_cargo()
	var readout_before := hud.cargo_text()
	var used_before := GameState.cargo_used()
	# Past the chart edge, or the spill is a no-op by design.
	var deep_at := Vector3(0, 0, chart_edge() + 120.0)
	var spilled := spill_unread(deep_at)
	await get_tree().physics_frame
	var readout_spill := hud.cargo_text()
	var want_spill := "HOLD %d/%d" % [GameState.cargo_used(), GameState.cargo_capacity()]

	# The delivery path, driven the way docking drives it: accept the real
	# contract, carry exactly what it asks, dock where it points.
	GameState.cargo = {}
	# THE SLOTS ARE STAGED, because a fresh run's slots are FULL BY DESIGN.
	# The pin re-syncs contracts from reset state, and _restore's unseeded
	# branch then auto-assigns the STARTER PAIR -- whose documented purpose is
	# to fill both slots so the HUD tracker has content during the tutorial.
	# So "pinned" does not mean "empty": it means the same full slots on every
	# machine, and a leg that needs a free one clears it, exactly as
	# CONTRACTTEST and PACINGTEST already do. (81 tells the whole story: this
	# leg failed on a live save with full slots, the pin fix made the failure
	# deterministic instead of environmental, and this line is the half that
	# was the leg's own to fix.)
	contracts.active = []
	# CAPTURED, not fired and forgotten. When this leg went red on a live save
	# the output said "12->12" and the cause -- accept() refusing on full slots
	# -- had to be dug out of three files. A staged precondition that can fail
	# reports its own failure, by name.
	var accepted := contracts.accept("haul_alloys")
	GameState.load_cargo("alloys", 6)
	hud.refresh_cargo()
	var dock_before := GameState.cargo_used()
	contracts.on_docked("bastion")
	await get_tree().physics_frame
	var readout_dock := hud.cargo_text()
	var want_dock := "HOLD %d/%d" % [GameState.cargo_used(), GameState.cargo_capacity()]
	var both_fired: bool = spilled > 0 and used_before > GameState.cargo_used() + 0 \
		and dock_before > 0 and GameState.cargo_count("alloys") == 0
	print("[hold] THE READOUT FOLLOWS THE HOLD spill %d units '%s'->'%s' (want '%s'); contract accepted=%s, delivery settled %d->%d '%s' (want '%s'); both paths fired=%s -> %s" % [
		spilled, readout_before, readout_spill, want_spill, str(accepted),
		dock_before, GameState.cargo_used(), readout_dock, want_dock, str(both_fired),
		"PASS" if accepted and both_fired and readout_spill == want_spill \
			and readout_dock == want_dock else "FAIL"])

	# --- v16. THE HOLD SCREEN -------------------------------------------------
	# Everything below drives the real node. A grid asserted from its own
	# arithmetic would agree with itself while drawing something else.
	hold_screen.open()
	await get_tree().process_frame
	await get_tree().process_frame

	# 4e. THE GRID IS THE HOLD. The screen's one promise: cells == capacity,
	#     filled == used, empty == free, and one glyph per UNIT rather than per
	#     cell. Checked at four capacities including both ModuleDB floors --
	#     6 is the clamped minimum and 104 is Cargo Bay Mk II plus a Hauler
	#     Frame in the two utility slots.
	var grid_rows := ""
	var grid_ok := true
	for cap_probe in [6, 24, 34, 104]:
		GameState.cargo = {}
		GameState.stats["cargo_space"] = float(cap_probe)
		# A mixed hold at every bulk: 1, 2 and 3 space per unit.
		GameState.load_cargo("isotopes", 2)          # space 1
		GameState.load_cargo("alloys", 1)            # space 2
		if cap_probe >= 24:
			GameState.load_cargo("relics", 1)        # space 3
		hold_screen._refresh()
		await get_tree().process_frame
		var cells: Array = hold_screen.grid_cells()
		var filled := 0
		var glyphs := 0
		var units := 0
		for c_v in cells:
			var c: Dictionary = c_v
			if String(c["good"]) != "":
				filled += 1
			if String(c["glyph"]) != "":
				glyphs += 1
		for gid3 in GameState.cargo:
			units += GameState.cargo_count(String(gid3))
		grid_rows += "%d:%d/%d/%dg " % [cap_probe, cells.size(), filled, glyphs]
		if cells.size() != GameState.cargo_capacity() \
				or filled != GameState.cargo_used() \
				or cells.size() - filled != GameState.cargo_free() \
				or glyphs != units:
			grid_ok = false
	print("[hold] THE GRID IS THE HOLD cap:cells/filled/glyphs %s(cells==capacity, filled==used, one glyph per unit) -> %s" % [
		grid_rows, "PASS" if grid_ok else "FAIL"])

	# 4f. THE HOLD PACKS IN ORDER. Blocks are contiguous and no empty cell sits
	#     before a filled one — free space is one run at the end, which is what
	#     makes "how much room is left" readable at a glance instead of a hunt
	#     for gaps. Order is family then price descending, so the gravel ends up
	#     next to the space it could free.
	GameState.cargo = {}
	GameState.stats["cargo_space"] = 34.0
	GameState.load_cargo("ore_ferrite", 2)      # metal, cheap
	GameState.load_cargo("relics", 2)           # bulk, dear
	GameState.load_cargo("contraband", 1)       # restricted, last
	hold_screen._refresh()
	await get_tree().process_frame
	var pack: Array = hold_screen.grid_cells()
	var seen_gap := false
	var gap_before_fill := false
	var seq := ""
	var last_good := ""
	for p_v in pack:
		var p: Dictionary = p_v
		var g := String(p["good"])
		if g == "":
			seen_gap = true
		else:
			if seen_gap:
				gap_before_fill = true
			if g != last_good:
				seq += CommodityDB.family(g) + " "
				last_good = g
	print("[hold] THE HOLD PACKS IN ORDER %s| no gap before a filled cell=%s -> %s" % [
		seq, str(not gap_before_fill),
		"PASS" if not gap_before_fill and seq.begins_with("bulk metal") else "FAIL"])

	# 4g. THE CLAMP HOLDS, in the corrected shape rather than SHEET FITS's.
	#     SHEET FITS measures _panel.size.y, which _clamp_height() guarantees, so
	#     it cannot fail on content growth — and written as `sheet <= viewport`
	#     it would pass on a COLLAPSED sheet too, which is worse. This recomputes
	#     min(content, room) independently and demands equality within a pixel,
	#     so too tall fails and so does collapsed.
	var saved_scale: float = UILayout.user_scale
	UILayout.user_scale = 1.6
	var clamp_line := ""
	var clamp_ok := true
	for probe in [Vector2i(1440, 900), Vector2i(1100, 800), Vector2i(720, 1280)]:
		get_window().size = probe
		await get_tree().process_frame
		await get_tree().process_frame
		for cap2 in [6, 104]:
			GameState.cargo = {}
			GameState.stats["cargo_space"] = float(cap2)
			GameState.load_cargo("alloys", 2)
			hold_screen._refresh()
			# TWO frames, the same as the layout harness waits after a resize:
			# Godot settles container layout over a frame, and the screen
			# re-clamps once it has. Measuring after one frame reads the
			# pre-settle height and reports a phantom 34-row gap.
			await get_tree().process_frame
			await get_tree().process_frame
			var want := minf(hold_screen.grid_content_height(), hold_screen.room_for_grid())
			var got := hold_screen.scroll_viewport_height()
			if absf(got - want) > 1.0 or got <= 0.0:
				clamp_ok = false
				clamp_line += "%dx%d@%d want %.0f got %.0f; " % [probe.x, probe.y, cap2, want, got]
	print("[hold] THE CLAMP HOLDS scroll viewport == min(content, room) at 3 windows x 2 capacities, 1.6 scale%s -> %s" % [
		"" if clamp_ok else " MISMATCH " + clamp_line, "PASS" if clamp_ok else "FAIL"])

	# 4h. A FINGER FITS. GENUINELY NEW COVERAGE: nothing in this project asserts
	#     a tap target today. UIKit.button floors height at 42 and RoundButton is
	#     80x80, but both are conventions no line has ever checked — and
	#     port_panel already ships 32x32 swatches, so the convention is not even
	#     held in practice. A slot grid is exactly where an unreachable cell
	#     slips through.
	#
	#     THE EXPECTATION IS DERIVED FROM THE LAID-OUT CONTAINER, not from the
	#     screen's own arithmetic. Asserting the grid's constant against the
	#     grid's constant is the SHEET FITS trap in another costume: it would
	#     agree with itself while the container squeezed the cells to nothing.
	#     Recomputing from _grid.size.x means this fails both if the layout
	#     starves the grid and if the grid's maths drifts from the box it is in.
	var worst_cell := 9999.0
	var worst_where := ""
	var finger_ok := true
	for probe2 in [Vector2i(720, 1280), Vector2i(414, 736), Vector2i(1440, 900)]:
		for uscale in [0.7, 1.0, 1.6]:
			UILayout.user_scale = uscale
			get_window().size = probe2
			await get_tree().process_frame
			await get_tree().process_frame
			for cap3 in [6, 24, 104]:
				GameState.cargo = {}
				GameState.stats["cargo_space"] = float(cap3)
				hold_screen._refresh()
				await get_tree().process_frame
				var g := hold_screen._grid
				var cols := g.columns()
				var expect := (g.size.x - float(cols - 1) * HoldScreen.HoldGrid.CELL_SEP) / float(cols)
				var actual := g.cell_size()
				if absf(expect - actual) > 1.0:
					finger_ok = false
					worst_where = "%dx%d@%.1f cap%d ARITHMETIC %.1f vs %.1f" % [
						probe2.x, probe2.y, uscale, cap3, expect, actual]
				if actual < worst_cell:
					worst_cell = actual
					if actual < HoldScreen.HoldGrid.TAP_MIN:
						worst_where = "%dx%d@%.1f cap%d" % [probe2.x, probe2.y, uscale, cap3]
	# Against TAP_MIN, never against CELL. CELL is the grid's own design size and
	# comparing the grid to it proves only that the grid agrees with itself;
	# TAP_MIN is the reachability floor, and it is what a thumb cares about.
	if worst_cell < HoldScreen.HoldGrid.TAP_MIN:
		finger_ok = false
	UILayout.user_scale = saved_scale
	get_window().size = Vector2i(720, 1280)
	await get_tree().process_frame
	print("[hold] A FINGER FITS smallest cell %.1f across 3 windows x 3 scales x 3 capacities (tap floor %.0f)%s -> %s" % [
		worst_cell, HoldScreen.HoldGrid.TAP_MIN,
		"" if worst_where == "" else "  worst " + worst_where, "PASS" if finger_ok else "FAIL"])

	# 4i. NOTHING IS NAMED BY COLOUR ALONE. The grid cannot identify a good and
	#     is not meant to: measured with this project's own confusion maths the
	#     34 commodity colours have a worst pair of 0.022 in NORMAL vision, and
	#     26 pairs share family AND bulk AND an indistinguishable colour. So the
	#     rule is that every held good is NAMED IN WORDS somewhere on the screen
	#     and every filled cell carries a glyph — checked again under DEUTAN,
	#     because an accommodation that only holds in the default mode is not one.
	GameState.cargo = {}
	GameState.stats["cargo_space"] = 34.0
	GameState.load_cargo("relics", 1)
	GameState.load_cargo("servo_prewar", 1)     # near-identical amber to relics
	GameState.load_cargo("ore_phosphor", 1)     # and to this
	var named_ok := true
	var glyph_ok := true
	var vision_before: int = Palette.vision
	for mode in [Palette.Vision.NORMAL, Palette.Vision.DEUTAN]:
		Palette.vision = mode
		for gid4 in GameState.cargo:
			hold_screen._on_cell_picked(String(gid4))
			await get_tree().process_frame
			if not hold_screen.strip_text().contains(
					CommodityDB.display(String(gid4)).to_upper()):
				named_ok = false
		hold_screen._on_cell_picked("")
		await get_tree().process_frame
		for c2_v in hold_screen.grid_cells():
			var c2: Dictionary = c2_v
			if String(c2["good"]) != "" and bool(c2["head"]) \
					and String(c2["glyph"]) == "":
				glyph_ok = false
	Palette.vision = vision_before
	print("[hold] NOTHING IS NAMED BY COLOUR ALONE 3 goods of near-identical colour named in words=%s, every block glyphed=%s, in NORMAL and DEUTAN -> %s" % [
		str(named_ok), str(glyph_ok), "PASS" if named_ok and glyph_ok else "FAIL"])

	# 4j. THE HOLD FOLLOWS THE PALETTE. Salvage and chart cells route through
	#     Palette.band_color because for those two families the colour MEANS
	#     which band the thing came from — the meaning the vision remaps exist to
	#     preserve. The fixed-token families must NOT move, or the remap has
	#     started repainting things whose colour never carried that information.
	GameState.cargo = {}
	GameState.load_cargo("salvage_drift", 1)
	GameState.load_cargo("alloys", 1)
	Palette.vision = Palette.Vision.NORMAL
	hold_screen._refresh()
	await get_tree().process_frame
	var norm := {}
	for c3_v in hold_screen.grid_cells():
		var c3: Dictionary = c3_v
		if String(c3["good"]) != "":
			norm[String(c3["good"])] = hold_screen._color_for(String(c3["good"]))
	Palette.vision = Palette.Vision.DEUTAN
	hold_screen._refresh()
	await get_tree().process_frame
	var salv_norm: Color = norm.get("salvage_drift", Color.BLACK)
	var bulk_norm: Color = norm.get("alloys", Color.BLACK)
	var salv_moved: bool = salv_norm != hold_screen._color_for("salvage_drift")
	var bulk_held: bool = bulk_norm == hold_screen._color_for("alloys")
	Palette.vision = vision_before
	hold_screen._refresh()
	print("[hold] THE HOLD FOLLOWS THE PALETTE deutan moves the salvage cell=%s, leaves the bulk token alone=%s -> %s" % [
		str(salv_moved), str(bulk_held), "PASS" if salv_moved and bulk_held else "FAIL"])

	# 4k. THE BRAKE DOES NOT STICK. refit_panel wrote this rule down after
	#     shipping the bug: arming a dump, closing the sheet and flying for ten
	#     minutes left the confirm live, so the next tap dumped cargo with no
	#     warning. A brake that stays pressed is not a brake, and the rule has to
	#     be inherited rather than learned again.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 4)
	hold_screen._refresh()
	hold_screen._dump("alloys", 4)          # arms, does not dump
	var armed_held := GameState.cargo_count("alloys")
	hold_screen.close_panel()
	hold_screen.open()
	await get_tree().process_frame
	hold_screen._dump("alloys", 4)          # must re-ARM, not fire
	var after_reopen := GameState.cargo_count("alloys")
	print("[hold] THE BRAKE DOES NOT STICK armed then closed; first tap after reopening left %d of %d aboard -> %s" % [
		after_reopen, 4,
		"PASS" if armed_held == 4 and after_reopen == 4 else "FAIL"])

	# 4l. THE DUMP IS STILL FREE AND SILENT, driven through the SCREEN. The
	#     existing JETTISON assertions call GameState.jettison directly and so
	#     cannot see a console that credits salvage or spawns a crate on its own.
	#     Dumped cargo must not float: recoverable jettison converts a dump into
	#     full toll evasion, which is what that pre-emptive assertion forbids.
	var salv_pre := GameState.salvage
	var cubes_pre := _count_loot_cubes()
	hold_screen._dump("alloys", 4)          # second tap: fires
	await get_tree().process_frame
	print("[hold] THE DUMP IS STILL FREE AND SILENT through the screen: %d left aboard, salvage %d->%d, loot cubes %d->%d -> %s" % [
		GameState.cargo_count("alloys"), salv_pre, GameState.salvage,
		cubes_pre, _count_loot_cubes(),
		"PASS" if GameState.cargo_count("alloys") == 0 \
			and GameState.salvage == salv_pre \
			and _count_loot_cubes() == cubes_pre else "FAIL"])

	# 4m. ONE REBUILD PER FRAME. strip_hottest unloads a raided hold ONE UNIT AT
	#     A TIME in a while loop, so a screen wired straight to cargo_changed
	#     would rebuild a 104-cell grid dozens of times inside one frame. The
	#     dirty flag is what makes the signal affordable.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 6)
	hold_screen._refresh()
	await get_tree().process_frame
	var rebuilds_pre: int = hold_screen.refresh_count
	GameState.strip_hottest(400)
	await get_tree().process_frame
	var rebuilds := hold_screen.refresh_count - rebuilds_pre
	print("[hold] ONE REBUILD PER FRAME strip_hottest across a multi-unit hold caused %d grid rebuild(s) -> %s" % [
		rebuilds, "PASS" if rebuilds == 1 else "FAIL"])
	hold_screen.close_panel()

	# 5. READ COMPRESSION is real and now printable: every grade reads into
	#    something worth more per unit of hold space than the grade itself.
	var worst := 99.0
	var worst_grade := ""
	var line := ""
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var sid := CommodityDB.salvage_for_band(band)
		if sid == "":
			continue
		var raw := float(CommodityDB.base_price(sid)) / float(CommodityDB.space_of(sid))
		var best := 0.0
		for out_v in CommodityDB.reads_as(sid):
			var o := String(out_v)
			best = maxf(best, float(CommodityDB.base_price(o)) / float(CommodityDB.space_of(o)))
		line += "%s %.0f->%.0f  " % [CommodityDB.short_name(sid), raw, best]
		if best / maxf(raw, 0.01) < worst:
			worst = best / maxf(raw, 0.01)
			worst_grade = CommodityDB.short_name(sid)
	print("[hold] READ COMPRESSION per space %s(worst %s at %.1fx) -> %s" % [
		line, worst_grade, worst, "PASS" if worst > 1.5 else "FAIL"])

	# 6. THE PILOT LINE matches state — one rule, asserted once rather than three
	#    renderings asserted separately.
	GameState.archeology = 2
	GameState.archeology_xp = 40
	var l2 := GameState.archeology_line()
	# THE CAP TIER IS WRITTEN OUT, not derived, and that is deliberate after this
	# clause was caught staging tier 3 as "the cap" — true until the frontier gave
	# the ladder two more rungs, at which point it asserted cap text against a
	# tier that had a countdown. Deriving it with ARCHEOLOGY_TIERS.size() - 1 was
	# proposed and refused: archeology_next_at() returns -1 exactly when
	# `archeology + 1 >= size()`, so the derived form makes NOTHING LEFT TO LEARN
	# an identity that holds for a table of four rungs, sixty, or one.
	GameState.archeology = 5
	GameState.archeology_xp = 999
	var l5 := GameState.archeology_line()
	# AND THE COUNTDOWN CANNOT GO NEGATIVE, which is the live defect this clause
	# actually surfaced: a tier below the cap holding more xp than the next rung
	# costs printed "· -891 TO NEXT" from an unfloored subtraction. Staged one
	# rung below the top, where next_at is a real number and xp is past it.
	GameState.archeology = 3
	GameState.archeology_xp = 999
	var l_over := GameState.archeology_line()
	GameState.archeology = 0
	GameState.archeology_xp = 0
	print("[hold] PILOT LINE t2='%s' | t5 caps='%s' | t3 overshoot='%s' -> %s" % [
		l2, l5, l_over,
		"PASS" if l2.contains("ARCHEOLOGY 2") and l2.contains("TO NEXT")
			and l5.contains("NOTHING LEFT TO LEARN")
			and not l_over.contains("-") else "FAIL"])

	# 7. CYCLE TARGET is bounded. Tab used to walk to a guard 200u out and fly the
	#    ship there — the deep expanse made a nearest-first sort over every
	#    hostile in the system into a way to autopilot into a post.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().physics_frame
	player.global_position = Vector3.ZERO
	var near := SwarmHostile.new()
	system_root.add_child(near)
	near.global_position = Vector3(20, 0, 0)
	var far_one := SwarmHostile.new()
	system_root.add_child(far_one)
	far_one.global_position = Vector3(300, 0, 0)
	await get_tree().physics_frame
	var picks := {}
	for i in range(6):
		var t := player.cycle_target()
		if t != null:
			picks[t] = true
	print("[hold] CYCLE BOUND %d of 2 contacts reachable by Tab (the 300u one must not be) -> %s" % [
		picks.size(), "PASS" if picks.size() == 1 and picks.has(near) else "FAIL"])
	get_tree().quit()


# --- cartography harness ------------------------------------------------------

func _run_cart_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true

	# State is pinned for every harness in _ready -- see HARNESS_VARS. This one
	# is worth naming as the case that found it: SURVEY SPEED equips a scanner to
	# prove the module's stat is live, and a save whose fit already fills the
	# reactor makes equip REFUSE it, so the assertion printed the same number
	# twice and reported a dead stat that was perfectly alive.
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.4).timeout

	# 1. THE COLLISION GUARD. is_salvage() is literally has("band") and
	#    salvage_for_band() returns the FIRST good matching one — so a chart good
	#    carrying `band` could shadow a salvage grade, and spawn_loot's 22%
	#    regrade would start minting free chart data out of combat crates
	#    everywhere in the game. Broken, this prints true.
	var charts: Array = []
	var mislabelled := ""
	for gid in CommodityDB.ids():
		var g := String(gid)
		if CommodityDB.is_chart(g):
			charts.append(g)
			if CommodityDB.is_salvage(g):
				mislabelled = g
	# And the reverse: no salvage grade may answer to a chart band.
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var c := CommodityDB.chart_for_band(band)
		var sv := CommodityDB.salvage_for_band(band)
		if c == sv or c == "":
			mislabelled = "band %d collides" % band
	print("[cart] NOT SALVAGE %d chart goods, none answers is_salvage or shadows a grade -> %s %s" % [
		charts.size(),
		# Anchored on BAND_EDGES rather than BAND_NAMES: band_of returns at most
		# BAND_EDGES.size(), so that is the number of bands a chart can exist
		# for, and it is a different table from the GOODS dict this counts —
		# which is what keeps this a real comparison rather than x == x.
		"PASS" if charts.size() == DeepSpace.BAND_EDGES.size() and mislabelled == "" else "FAIL",
		mislabelled])

	# 2. NO BUY LEG anywhere. A survey is something you make, never something you
	#    buy — 11 closed at the source, the way the salvage grades already are.
	var counters := SystemDB.port_ids().duplicate()
	counters.append_array(DeepPortDB.ids())
	var quoted := ""
	for pid_v in counters:
		var pid := String(pid_v)
		var pdef := DeepPortDB.by_id(pid) if DeepPortDB.is_deep_port(pid) \
			else SystemDB.port_def_by_id(pid)
		for c_v in charts:
			if Market.can_buy(pdef, String(c_v)):
				quoted = "%s at %s" % [String(c_v), pid]
	print("[cart] NO BUY LEG 0 of %d counters will quote a buy on chart data -> %s %s" % [
		counters.size(), "PASS" if quoted == "" else "FAIL", quoted])

	# 3. WEIGHT. Zero-weight data was the trap: a pure explorer would never cross
	#    RAID_MIN_HOLD and the whole interdiction system would be inert for an
	#    entire playstyle. An explorer should be quiet, not invisible.
	GameState.cargo = {}
	GameState.load_cargo("chart_drift", 24)
	var w := GameState.hold_value(true)
	print("[cart] WEIGHT 24 drift surveys -> weighted %d vs RAID_MIN_HOLD %d (never inert) -> %s" % [
		w, RAID_MIN_HOLD, "PASS" if w >= RAID_MIN_HOLD else "FAIL"])

	# 4. THE SCANNER FINALLY SCANS. Until now "Targeting Scanner" was a
	#    range-and-crit module wearing an instrument's name. A dead stat prints
	#    the same number twice.
	GameState.cargo = {}
	var probe := SurveyMast.new()
	probe.band = 2
	probe.survey_time = 3.5
	add_child(probe)
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	var bare := probe.survey_seconds()
	if not GameState.owns("util_scanner"):
		GameState.owned.append("util_scanner")
	GameState.equip(ModuleDB.Slot.UTILITY, "util_scanner")
	var scanned := probe.survey_seconds()
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	print("[cart] SURVEY SPEED %.2fs bare -> %.2fs with a Mk I scanner -> %s" % [
		bare, scanned, "PASS" if scanned < bare - 0.3 else "FAIL"])

	# 5. A reading is taken once, and taking it fills the hold.
	GameState.cargo = {}
	probe.cell = Vector2i(4242, 4242)
	probe.surveyed = false
	probe._progress = 1.0
	probe._complete()
	var first := GameState.cargo_count("chart_drift")
	probe._complete()
	var after_second := GameState.cargo_count("chart_drift")
	print("[cart] SURVEY YIELDS band 2 -> %s x%d, a second reading adds %d -> %s" % [
		CommodityDB.short_name("chart_drift"), first, after_second - first,
		"PASS" if first == SurveyMast.YIELD_UNITS and after_second == first else "FAIL"])

	# 6. A full hold DEFERS the reading rather than eating it. The mast stays
	#    unsurveyed, so the trip out is not wasted — only the pickup is.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 12)   # 24 space: full
	var probe2 := SurveyMast.new()
	probe2.band = 2
	probe2.cell = Vector2i(4243, 4243)
	add_child(probe2)
	probe2._complete()
	print("[cart] FULL HOLD DEFERS took %d, mast still readable=%s -> %s" % [
		GameState.cargo_count("chart_drift"), str(not probe2.surveyed),
		"PASS" if GameState.cargo_count("chart_drift") == 0 and not probe2.surveyed
			else "FAIL"])
	probe.queue_free()
	probe2.queue_free()

	# 7. THE CHART REMEMBERS — the deliberate reversal of the SESSION RESET leg
	#    that stood here from v16 to v21. That leg existed to force this exact
	#    conversation ("if anyone ever fixes that by saving the dict, this line
	#    turns red"), and it did: 80 reverses 17's session-only rule under a
	#    per-system cap, so coverage now survives the warp.
	#
	#    ASSERTED IN BOTH DIRECTIONS, because a loader that marked every cell
	#    surveyed would pass the survival half perfectly. The never-surveyed
	#    cell must still read false after the same rebuild.
	deep_space.note_surveyed(Vector2i(7, -3))
	var before_warp := deep_space.is_surveyed(Vector2i(7, -3))
	_load_system(system_id)
	await get_tree().physics_frame
	var after_warp := deep_space.is_surveyed(Vector2i(7, -3))
	var never_warp := deep_space.is_surveyed(Vector2i(9, 9))
	print("[cart] THE CHART REMEMBERS surveyed before a rebuild=%s, after=%s, never-surveyed still false=%s (80 reverses 17) -> %s" % [
		str(before_warp), str(after_warp), str(not never_warp),
		"PASS" if before_warp and after_warp and not never_warp else "FAIL"])

	# 7b. THE STORE IS SYSTEM-QUALIFIED. The old dict keyed on bare Vector2i, so
	#     pyx01's (7,-3) and pyx02's (7,-3) were one key — persist that and a
	#     survey here marks a cell THERE. Asserted at the GameState layer, where
	#     the qualified key actually lives.
	var q_here := GameState.is_survey_worked(DeepSpace.cell_key(system_id, 7, -3))
	var q_there := GameState.is_survey_worked(DeepSpace.cell_key("pyx02", 7, -3))
	print("[cart] THE STORE IS SYSTEM-QUALIFIED %s:7:-3=%s, pyx02:7:-3=%s -> %s" % [
		system_id, str(q_here), str(q_there),
		"PASS" if q_here and not q_there else "FAIL"])

	# 7c. THE SENTINEL NEVER LANDS. A rift stamps its mast with cell
	#     (0x7ffffff, 0x7ffffff); stored, that key would hand the chart's
	#     fit-to-content scale an 8.6e9-unit radius. Rejected at note_surveyed
	#     itself so the in-memory store stays clean, not merely the file.
	var cov_before := GameState.survey_coverage.size()
	deep_space.note_surveyed(Vector2i(0x7ffffff, 0x7ffffff))
	var sentinel_read := deep_space.is_surveyed(Vector2i(0x7ffffff, 0x7ffffff))
	print("[cart] THE SENTINEL NEVER LANDS store %d -> %d entries, reads back=%s -> %s" % [
		cov_before, GameState.survey_coverage.size(), str(sentinel_read),
		"PASS" if GameState.survey_coverage.size() == cov_before
			and not sentinel_read else "FAIL"])

	# 7d. COVERAGE SURVIVES A COLOUR CHANGE. rebuild() -> _despawn_all() used to
	#     clear the session dict, so changing colour vision — two taps from the
	#     pause menu — silently wiped every survey. The store lives in GameState
	#     now and this node holds nothing, which is the construction this leg
	#     pins against anyone reintroducing a cache here.
	deep_space.rebuild()
	await get_tree().physics_frame
	var after_rebuild := deep_space.is_surveyed(Vector2i(7, -3))
	print("[cart] COVERAGE SURVIVES A COLOUR CHANGE surveyed after rebuild()=%s -> %s" % [
		str(after_rebuild), "PASS" if after_rebuild else "FAIL"])

	# 7e. THE CAP EVICTS THE OLDEST, IN ONE SYSTEM ONLY. 17's growth argument is
	#     answered by construction, so the construction is what gets asserted:
	#     write past the cap and the store must hold exactly CAP cells for that
	#     system, the FIRST-written ones gone, the newest kept — and a
	#     neighbour system's coverage untouched by the eviction.
	GameState.survey_coverage = {}
	GameState.note_survey_worked(DeepSpace.cell_key("pyx02", 999, 999))
	for i in GameState.SURVEY_CELL_CAP + 3:
		GameState.note_survey_worked(DeepSpace.cell_key(system_id, i, 0))
	var mine_count := 0
	for k_v in GameState.survey_coverage:
		if String(k_v).begins_with(system_id + ":"):
			mine_count += 1
	var oldest_gone := not GameState.is_survey_worked(DeepSpace.cell_key(system_id, 0, 0))
	var newest_kept := GameState.is_survey_worked(
		DeepSpace.cell_key(system_id, GameState.SURVEY_CELL_CAP + 2, 0))
	var neighbour_kept := GameState.is_survey_worked(DeepSpace.cell_key("pyx02", 999, 999))
	print("[cart] THE CAP EVICTS THE OLDEST %d cells held (cap %d), first gone=%s, newest kept=%s, neighbour untouched=%s -> %s" % [
		mine_count, GameState.SURVEY_CELL_CAP, str(oldest_gone), str(newest_kept),
		str(neighbour_kept),
		"PASS" if mine_count == GameState.SURVEY_CELL_CAP and oldest_gone
			and newest_kept and neighbour_kept else "FAIL"])
	GameState.survey_coverage = {}
	GameState.survey_filed = {}

	# 7f. A FILED CELL IS NOT AN UNFILED ONE (v22). Filing is what the counter
	#     will pay a first-filing bonus against, so the two states have to be
	#     distinguishable in BOTH directions -- a store that marked everything
	#     filed, or nothing, passes half of this perfectly.
	#
	#     And filed is a SUBSET of coverage, enforced rather than assumed:
	#     filing a cell nobody surveyed is refused at the accessor, or the two
	#     stores become parallel truths that can disagree.
	GameState.note_survey_worked(DeepSpace.cell_key(system_id, 2, 2))
	GameState.note_survey_worked(DeepSpace.cell_key(system_id, 3, 3))
	var file_first := GameState.note_survey_filed(DeepSpace.cell_key(system_id, 2, 2))
	var file_again := GameState.note_survey_filed(DeepSpace.cell_key(system_id, 2, 2))
	var file_unknown := GameState.note_survey_filed(DeepSpace.cell_key(system_id, 8, 8))
	var unfiled := GameState.unfiled_cells(system_id)
	print("[cart] A FILED CELL IS NOT AN UNFILED ONE first file=%s, refiled=%s, unsurveyed cell refused=%s, %d unfiled of 2 -> %s" % [
		str(file_first), str(file_again), str(not file_unknown), unfiled.size(),
		"PASS" if file_first and not file_again and not file_unknown
			and unfiled.size() == 1
			and String(unfiled[0]) == DeepSpace.cell_key(system_id, 3, 3) else "FAIL"])

	# 7g. AND THE CAP TAKES BOTH. filed rides coverage's cap rather than
	#     carrying one of its own -- a filed key outliving its coverage key
	#     would be a second store growing without a bound, which is the thing
	#     17 refuses and 80 answered by construction.
	for i in GameState.SURVEY_CELL_CAP + 3:
		GameState.note_survey_worked(DeepSpace.cell_key(system_id, i, 7))
	var evicted_filed := GameState.is_survey_filed(DeepSpace.cell_key(system_id, 2, 2))
	var cov_has := GameState.survey_coverage.has(DeepSpace.cell_key(system_id, 2, 2))
	var subset_ok := true
	for k_v in GameState.survey_filed:
		if not GameState.survey_coverage.has(String(k_v)):
			subset_ok = false
	print("[cart] AND THE CAP TAKES BOTH evicted cell still filed=%s (coverage has it=%s), filed is a subset of coverage=%s -> %s" % [
		str(evicted_filed), str(cov_has), str(subset_ok),
		"PASS" if not evicted_filed and not cov_has and subset_ok else "FAIL"])

	# 7h. THE STRUCTURE STORE IS BOUNDED BY THE GENERATOR (v22). No cap, and
	#     that is a property rather than an oversight: hyper_positions returns
	#     at most HYPER_MAX per system, so the store cannot exceed what the
	#     generator authored. Asserted AGAINST the generator, not against a
	#     literal -- a retune of HYPER_MIN/MAX moves this with it.
	GameState.structures_seen = {}
	var authored := 0
	for sid_v in SystemDB.ids():
		var sid_s := String(sid_v)
		var n := SystemDB.hyper_positions(sid_s, GameState.run_seed).size()
		authored += n
		# One past the end, which the loader must reject and the accessor must
		# never have been handed -- so the bound holds even against a bad file.
		for i in n + 2:
			GameState.note_structure_seen(GameState.colony_key(sid_s, i))
	GameState._load_structures_seen(GameState.structures_seen.duplicate())
	print("[cart] THE STRUCTURE STORE IS BOUNDED BY THE GENERATOR %d kept of %d offered, generator authored %d -> %s" % [
		GameState.structures_seen.size(), authored + SystemDB.ids().size() * 2,
		authored, "PASS" if GameState.structures_seen.size() == authored else "FAIL"])

	# 7i. AND A SIGHTING IS NOT A CLAIM. The whole point of the store: a
	#     structure you found and could not take is recorded, and recording it
	#     must not hand you the colony.
	var probe_key := GameState.colony_key(system_id, 0)
	var seen_only := GameState.is_structure_seen(probe_key) \
		and not GameState.is_colony_claimed(probe_key)
	print("[cart] AND A SIGHTING IS NOT A CLAIM seen=%s, claimed=%s -> %s" % [
		str(GameState.is_structure_seen(probe_key)),
		str(GameState.is_colony_claimed(probe_key)),
		"PASS" if seen_only else "FAIL"])
	GameState.survey_coverage = {}
	GameState.survey_filed = {}
	GameState.structures_seen = {}

	# 7j. THE COUNTER PAYS FOR BEING FIRST (v22, Horizon 7 commit 2). Two band-2
	#     cells surveyed and a reading's worth of chart_drift sold twice: the
	#     first sale files both and pays the bonus, the second files nothing and
	#     pays nothing. The PRECONDITION is asserted through the world's own
	#     depth_at rather than through cell_band_of_key -- the same helper the
	#     code under test uses would make a shared band error invisible, which
	#     is the scale bar's lesson from 78.
	var c_a := DeepSpace.cell_key(system_id, 4, 0)
	var c_b := DeepSpace.cell_key(system_id, 0, 4)
	var band_ok: bool = DeepSpace.band_of(deep_space.depth_at(
		DeepSpace.cell_centre(4, 0))) == 2 \
		and DeepSpace.band_of(deep_space.depth_at(DeepSpace.cell_centre(0, 4))) == 2
	GameState.note_survey_worked(c_a)
	GameState.note_survey_worked(c_b)
	var salv_file := GameState.salvage
	var bonus1 := file_charts_on_sale("chart_drift", 2 * SurveyMast.YIELD_UNITS)
	var bonus2 := file_charts_on_sale("chart_drift", 2 * SurveyMast.YIELD_UNITS)
	var half := file_charts_on_sale("chart_drift", 1)
	var want_per := int(round(float(CommodityDB.base_price("chart_drift"))
		* float(SurveyMast.YIELD_UNITS) * FIRST_FILING_RATE))
	print("[cart] THE COUNTER PAYS FOR BEING FIRST both cells band 2=%s; first sale +%d (want %d), second +%d, half-reading +%d, wallet moved %d -> %s" % [
		str(band_ok), bonus1, want_per * 2, bonus2, half,
		GameState.salvage - salv_file,
		"PASS" if band_ok and bonus1 == want_per * 2 and bonus2 == 0
			and half == 0 and GameState.salvage - salv_file == bonus1 else "FAIL"])

	# 7k. AND THE BAND IS THE JOIN. A band-3 cell must not be filed by a band-2
	#     sale, and its bonus must be larger -- depth carried by the price
	#     ladder, not by a second table. The band-2 sale above already ran with
	#     the band-3 cell ABSENT; here it is present and a chart_drift sale must
	#     skip it.
	var c_deep := DeepSpace.cell_key(system_id, 9, 0)
	var deep_band := DeepSpace.band_of(deep_space.depth_at(DeepSpace.cell_centre(9, 0)))
	GameState.note_survey_worked(c_deep)
	GameState.note_survey_worked(DeepSpace.cell_key(system_id, 0, 9))
	# The band-2 sale runs FIRST, with only band-3 cells unfiled, and must pay
	# nothing and file nothing -- deep_before is read between the two sales,
	# because reading it only at the end cannot tell "filed by the right sale"
	# from "filed by the wrong one".
	var skipped := file_charts_on_sale("chart_drift", SurveyMast.YIELD_UNITS)
	var deep_before := GameState.is_survey_filed(c_deep)
	var deep_bonus := file_charts_on_sale("chart_reaches", SurveyMast.YIELD_UNITS)
	var want_deep := int(round(float(CommodityDB.base_price("chart_reaches"))
		* float(SurveyMast.YIELD_UNITS) * FIRST_FILING_RATE))
	print("[cart] AND THE BAND IS THE JOIN band-3 cell (band %d): band-2 sale paid %d and filed it=%s; band-3 sale +%d (want %d, > band-2's %d) filed it=%s -> %s" % [
		deep_band, skipped, str(deep_before), deep_bonus, want_deep, want_per,
		str(GameState.is_survey_filed(c_deep)),
		"PASS" if deep_band == 3 and skipped == 0 and not deep_before
			and deep_bonus == want_deep and want_deep > want_per
			and GameState.is_survey_filed(c_deep) else "FAIL"])

	# 7l. THE BONUS IS NOT THE PRICE. The settlement touches the filed set and
	#     the wallet and nothing else -- no cargo, no coverage. A player who
	#     never thinks about filing loses nothing they had yesterday, and that
	#     is a property to hold, not a hope.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 2)
	GameState.note_survey_worked(DeepSpace.cell_key(system_id, 5, 0))
	var used_file := GameState.cargo_used()
	var cov_file := GameState.survey_coverage.size()
	file_charts_on_sale("chart_drift", SurveyMast.YIELD_UNITS)
	print("[cart] THE BONUS IS NOT THE PRICE cargo %d -> %d, coverage %d -> %d -> %s" % [
		used_file, GameState.cargo_used(), cov_file, GameState.survey_coverage.size(),
		"PASS" if GameState.cargo_used() == used_file
			and GameState.survey_coverage.size() == cov_file else "FAIL"])
	GameState.cargo = {}
	GameState.survey_coverage = {}
	GameState.survey_filed = {}

	# 8. Masts ride deep hulks and nothing else. No mast may sit near a dock ring
	#    either — CameraRig checks `crackable` BEFORE `dockable`, so one parked on
	#    a station would intercept the tap that docks you.
	set_deep_generation(true)
	await get_tree().process_frame
	var far := Vector3(300.0, 0.0, 300.0)
	player.global_position = far
	for i in range(8):
		await get_tree().physics_frame
		await get_tree().process_frame
	var masts := get_tree().get_nodes_in_group("survey_mast")
	var too_close := ""
	for m in masts:
		for d_v in get_tree().get_nodes_in_group("dockable"):
			var d := d_v as Port
			if (m as Node3D).global_position.distance_to(d.dock_point) < 12.0:
				too_close = "%s" % d.port_id
	print("[cart] MASTS %d in the streaming window, none within 12u of a dock ring -> %s %s" % [
		masts.size(), "PASS" if too_close == "" else "FAIL", too_close])

	# 8b. THE MAST IS ACTUALLY VISIBLE. It was not: at the old offset of 4.5 the
	#     dish sat INSIDE hull box #3, and the only thing that reached the screen
	#     was the sliver of ring that cleared a silhouette edge at one spin
	#     phase. Every other assertion about the mast passed the whole time --
	#     it surveyed, it yielded, it deferred on a full hold, it stayed clear of
	#     dock rings -- because nothing measured whether a player could SEE the
	#     thing they are asked to fly to and hold on.
	#
	#     Measured against the real meshes at eight spin phases rather than
	#     against the numbers that produced them, so it follows a change to the
	#     hull, the dish or the offset.
	var geo_hulk := Derelict.new()
	system_root.add_child(geo_hulk)
	geo_hulk.global_position = Vector3(400.0, 0.0, 400.0)
	# Yaw ZERO, deliberately, so world space IS hull-local space. The hull and
	# the mast rotate together rigidly, so their relative geometry is identical at
	# every yaw -- but `transform * AABB` returns an axis-aligned bound AROUND a
	# rotated box, which for a 14-unit spine yawed 37 degrees is a box roughly
	# five times too wide. The first version of this assertion did that and
	# reported the mast buried when it was clear.
	geo_hulk.rotation_degrees.y = 0.0
	var geo_mast := SurveyMast.new()
	geo_mast.band = 2
	system_root.add_child(geo_mast)
	geo_mast.global_position = geo_hulk.global_position \
		+ geo_hulk.global_transform.basis.z * SurveyMast.HULL_OFFSET
	await get_tree().process_frame
	var buried := ""
	var boxes: Array = geo_hulk.hull_aabbs()
	for phase in range(8):
		geo_mast._spin = TAU * float(phase) / 8.0
		geo_mast._process(0.0)
		await get_tree().process_frame
		var dish: AABB = geo_mast.dish_aabb()
		for b_v in boxes:
			if (b_v as AABB).intersects(dish):
				buried = "phase %d" % phase
	print("[cart] MAST IS CLEAR dish vs %d hull boxes at 8 spin phases, offset %.1f, buried at: %s -> %s" % [
		boxes.size(), SurveyMast.HULL_OFFSET, buried if buried != "" else "never",
		"PASS" if buried == "" and boxes.size() > 0 else "FAIL"])

	# 8c. AND THE TWO PROMPTS DO NOT OVERLAP. Both the breach point and the mast
	#     write hud.prompt's single slot on an in-range edge transition, so while
	#     the two in-range spheres intersected, whichever boundary was crossed
	#     last won and leaving one CLEARED the other's still-valid prompt. The
	#     separation has to exceed the sum of the two ranges, and at the old 11.1
	#     against 6.5 + 6.5 it did not.
	var reach := Derelict.CRACK_RANGE + SurveyMast.SURVEY_RANGE
	var apart := geo_mast.global_position.distance_to(geo_hulk.pick_anchor())
	print("[cart] PROMPT RANGES DISJOINT anchors %.1fu apart vs CRACK %.1f + SURVEY %.1f = %.1f -> %s" % [
		apart, Derelict.CRACK_RANGE, SurveyMast.SURVEY_RANGE, reach,
		"PASS" if apart > reach else "FAIL"])
	geo_mast.queue_free()
	geo_hulk.queue_free()

	# 9. DOCKING A DEEP STATION IS SURVEYING IT — through the real dock path, not
	#    a synthetic grant, so the cell key, the band lookup and the once-per-
	#    session guard are all the production code's own.
	var station: Port = null
	for d_v in get_tree().get_nodes_in_group("dockable"):
		var d := d_v as Port
		if DeepPortDB.is_deep_port(d.port_id):
			station = d
	if station == null:
		print("[cart] DOCK GRANTS no deep station in window -> FAIL")
	else:
		GameState.cargo = {}
		player.global_position = station.dock_point
		await get_tree().physics_frame
		_complete_dock(station)
		var got := 0
		for c_v in CommodityDB.ids():
			if CommodityDB.is_chart(String(c_v)):
				got += GameState.cargo_count(String(c_v))
		undock()
		await get_tree().physics_frame
		player.global_position = station.dock_point
		await get_tree().physics_frame
		_complete_dock(station)
		var after_redock := 0
		for c_v in CommodityDB.ids():
			if CommodityDB.is_chart(String(c_v)):
				after_redock += GameState.cargo_count(String(c_v))
		undock()
		print("[cart] DOCK GRANTS first berth +%d packets, redock +%d -> %s" % [
			got, after_redock - got,
			"PASS" if got == SurveyMast.YIELD_UNITS and after_redock == got else "FAIL"])
	set_deep_generation(false)
	get_tree().quit()


# --- spill harness ------------------------------------------------------------

func _run_spill_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	var deep_pos := Vector3(400.0, 0.0, 400.0)

	# 1. CONSERVES. Printed as an equation, the way STASH CONSERVES is: a spill
	#    that silently eats three units passes any boolean written around it.
	GameState.cargo = {}
	GameState.load_cargo("salvage_quiet", 9)
	var held_before := GameState.cargo_count("salvage_quiet")
	player.global_position = deep_pos
	await get_tree().physics_frame
	var made := spill_unread(deep_pos)
	var cubes := _spill_cubes()
	print("[spill] CONSERVES %d held before = %d held after + %d cubes (must be equal) -> %s" % [
		held_before, GameState.cargo_count("salvage_quiet"), cubes.size(),
		"PASS" if held_before == GameState.cargo_count("salvage_quiet") + cubes.size()
			and made == held_before and made > 0 else "FAIL"])

	# 2. PROVENANCE. spawn_loot re-rolls 22% of goods into band salvage by the
	#    position it is called at, so routing a spill through it would re-grade
	#    quiet cargo as drift purely because you died shallower than you found it.
	var grades := {}
	for c in cubes:
		grades[String(c.commodity)] = int(grades.get(String(c.commodity), 0)) + 1
	print("[spill] PROVENANCE spilled grades %s (a regrade leak prints a mix) -> %s" % [
		str(grades), "PASS" if grades.size() == 1 and grades.has("salvage_quiet") else "FAIL"])

	# 3. NO SEEK. A stock cube homes from ANY distance after 1.3s, so an unflagged
	#    spill flies four hundred units to the respawn point and hands itself
	#    back — deleting the whole fly-back mechanic without erroring once.
	player.global_position = PlayerShip.SPAWN_POINT
	var watch: Node3D = cubes[0]
	# Measure CLOSING, not motion. Every cube coasts a few units on its spawn
	# scatter in a random direction, so raw displacement cannot tell that apart
	# from homing — but a seek leak eats distance at MAGNET_SPEED 16u/s, and the
	# scatter cannot close on a ship 500u away at all.
	var gap_before := watch.global_position.distance_to(player.global_position)
	for i in range(120):
		await get_tree().physics_frame
	var gap_after := watch.global_position.distance_to(player.global_position)
	print("[spill] NO SEEK cube %.0fu from the ship closed %.2fu in 2s (a leak closes ~32u) -> %s" % [
		gap_before, gap_before - gap_after,
		"PASS" if gap_before - gap_after < 6.0 else "FAIL"])

	# 4. A SPILL OUTLIVES THE REAPER AND DIES ON ITS OWN CLOCK. This was NO
	#    EXPIRY, and half of it still is: stock cubes reap at 25s, and the round
	#    trip from spawn to a deep death site is longer than that before the
	#    player has even turned around, so the spill must ignore that reaper.
	#
	# What changed in §109 is the other half. "Never expires" made the whole deep
	# death penalty a flight back with no clock on it, and the code's own claim
	# that dying is "the expensive exit" was aspirational. It now has a deadline,
	# scaled by depth because the flight back is what it is measuring, and this
	# leg asserts all three: past the reaper, longer when deeper, gone at zero.
	#
	# Age is driven past the reaper rather than waited out: 25s of harness time to
	# prove a branch is off is 25s nobody will spend, and a test nobody runs is a
	# test that is not there.
	# §118. Captured before the claim runs, so the leg below can say the record
	# appeared rather than that it exists.
	var ledger_before := int(GameState.ledger.get("spills_lost", 0))
	var log_before := GameState.log_lines().size()
	var spilled_n := _spill_cubes().size()
	for c in _spill_cubes():
		c.set("_age", 40.0)
	for i in range(4):
		await get_tree().physics_frame
	var alive := 0
	for c in _spill_cubes():
		if is_instance_valid(c):
			alive += 1
	var ttl_shallow := spill_claim_seconds(200.0)
	var ttl_deep := spill_claim_seconds(2000.0)
	# Driven to the wire rather than ticked down 390 times, same reasoning.
	_spill_claim_left = 1.0
	_spill_warned = true
	_tick_spill_claim(2.0)
	await get_tree().physics_frame
	await get_tree().physics_frame
	var after_claim := _spill_cubes().size()
	print("[spill] A SPILL OUTLIVES THE REAPER AND DIES ON ITS OWN CLOCK %d of %d alive at age 40s (reaper is 25s); the claim runs %.0fs at 200u and %.0fs at 2000u; run out, %d of %d left -> %s" % [
		alive, spilled_n, ttl_shallow, ttl_deep, after_claim, spilled_n,
		"PASS" if alive == spilled_n and spilled_n > 0 and ttl_deep > ttl_shallow
			and after_claim == 0 else "FAIL"])

	# 4b. AND THE CLAIMANT LEAVES A RECORD (§118). Until this commit the whole
	#     trace of a claim was a toast, on the ONE branch of the clock the pilot
	#     is by construction not standing in -- the window is longer than the
	#     flight back, so it expires only when they chose not to return.
	#
	#     BOTH SURFACES, because they answer different questions and either one
	#     alone is satisfiable by a no-op: the ledger counts how many were taken
	#     across the run, the log says WHEN and WHERE one was. And the count is
	#     asserted to rise by the number actually taken, not merely to rise --
	#     a claim that recorded 1 for a pile of six would pass a "moved" check.
	var ledger_after := int(GameState.ledger.get("spills_lost", 0))
	var log_after := GameState.log_lines()
	var logged := log_after.size() > log_before \
		and String(log_after[log_after.size() - 1]).begins_with("CLAIMED")
	var counted := ledger_after - ledger_before == spilled_n
	print("[spill] THE CLAIMANT LEAVES A RECORD ledger %d -> %d for %d crate(s)=%s, log gained %s=%s -> %s" % [
		ledger_before, ledger_after, spilled_n, str(counted),
		str(log_after[log_after.size() - 1]) if not log_after.is_empty() else "nothing",
		str(logged),
		"PASS" if counted and logged and spilled_n > 0 else "FAIL"])

	# 5. IDENTIFIED STAYS. Reading a thing is also stowing it — the line that
	#    gives ARCHEOLOGY a third job and makes field-reading a survival act.
	for c in _spill_cubes():
		c.queue_free()
	await get_tree().physics_frame
	GameState.cargo = {}
	GameState.load_cargo("salvage_quiet", 4)
	GameState.load_cargo("heart_reliquary", 2)
	player.global_position = deep_pos
	await get_tree().physics_frame
	spill_unread(deep_pos)
	print("[spill] IDENTIFIED STAYS unread %d -> %d, components %d -> %d -> %s" % [
		4, GameState.cargo_count("salvage_quiet"), 2, GameState.cargo_count("heart_reliquary"),
		"PASS" if GameState.cargo_count("salvage_quiet") == 0
			and GameState.cargo_count("heart_reliquary") == 2 else "FAIL"])

	# 6. CHART SIDE SPILLS NOTHING. The tutorial promised you never lose salvage,
	#    and it promised it inside the charted system, where it stays true.
	for c in _spill_cubes():
		c.queue_free()
	await get_tree().physics_frame
	GameState.cargo = {}
	GameState.load_cargo("salvage_charted", 6)
	player.global_position = Vector3(0, 0, 6)
	await get_tree().physics_frame
	var home_spill := spill_unread(Vector3(0, 0, 6))
	# §109 put a price on the rescue, and this is the leg that keeps the price
	# off the promise. The tutorial teaches "you lose position and tempo, never
	# salvage" INSIDE the charted system, so the tug must not bill there either.
	GameState.salvage = 5000
	var home_fee := charge_rescue(Vector3(0, 0, 6))
	print("[spill] CHART DEATH INTACT depth 0 spilled %d, hold still %d, tug billed %d of a %d balance -> %s" % [
		home_spill, GameState.cargo_count("salvage_charted"), home_fee,
		GameState.salvage,
		"PASS" if home_spill == 0 and GameState.cargo_count("salvage_charted") == 6
			and home_fee == 0 and GameState.salvage == 5000 else "FAIL"])

	# 7. NO DOUBLE SPILL. The hold is emptied BEFORE the cubes exist, so a second
	#    death inside WARP_GRACE finds nothing left to duplicate.
	GameState.cargo = {}
	GameState.load_cargo("salvage_reaches", 5)
	player.global_position = deep_pos
	await get_tree().physics_frame
	var first := spill_unread(deep_pos)
	var second := spill_unread(deep_pos)
	print("[spill] NO DOUBLE SPILL first %d, immediate second %d, cubes %d (must be 5, not 10) -> %s" % [
		first, second, _spill_cubes().size(),
		"PASS" if first == 5 and second == 0 and _spill_cubes().size() == 5 else "FAIL"])

	# 8. WARP CLEARS. Cubes are system_root children, so leaving abandons them —
	#    17 policy, asserted so it stays a decision rather than an accident. Note
	#    the player hangs off Main, so parenting the spill to get_parent() would
	#    have quietly outlived the warp.
	_load_system(system_id)
	await get_tree().physics_frame
	print("[spill] WARP CLEARS 5 adrift -> %d after a system rebuild -> %s" % [
		_spill_cubes().size(), "PASS" if _spill_cubes().is_empty() else "FAIL"])

	# 9. THE HOLD BUG. A finger still down when the ship dies used to leave
	#    CameraRig holding the wreck, and the next hold_tick issued a fresh move
	#    order — flying a just-respawned player back toward what killed them.
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	var wreck := _find_crackable()
	if wreck != null and rig != null:
		player.global_position = wreck.global_position + Vector3(0, 0, 3.0)
		await get_tree().physics_frame
		rig.set("_hold_target", wreck)
		player.shield = 1.0
		player.invulnerable = false
		player.take_hit(999.0)
		await get_tree().physics_frame
		print("[spill] HOLD CANCELLED shield-break mid-hold -> hold target %s, move order %s -> %s" % [
			"null" if rig.get("_hold_target") == null else "HELD",
			str(player.has_move_target),
			"PASS" if rig.get("_hold_target") == null and not player.has_move_target else "FAIL"])
	# --- §109. THE TUG ------------------------------------------------------------

	# 10. THE RESCUE COSTS MORE THAN THE JUMP. The assertion this whole feature
	#     exists for. _emergency_warp teleports a shield-zero ship home from ANY
	#     depth, and until now it did it for free -- which made dying strictly
	#     cheaper than the 120-500 credit beacon jump, and therefore the best
	#     fast travel in the game. main.gd's own comment claimed dying was "the
	#     expensive exit rather than the convenient one"; it was not.
	#
	# Swept rather than spot-checked, because the two curves are only guaranteed
	# to stay apart across the whole range, and the far deep -- past where a jump
	# is refused at all -- is where a badly placed clamp would flatten the
	# rescue.
	#
	# §123 AMENDS THIS LEG'S PREMISE RATHER THAN QUIETLY PASSING IT (§24). The
	# original swept a rescue that borrowed beacon_jump_fee's RAMP at 2x and
	# refused its clamp; the rescue now has its own constants and DOES clamp --
	# at the far marks, which is the deepest authored thing in the game rather
	# than the mid-range cap §109 refused. So the sweep grows a clause: the fee
	# must still be flat past the marks, because a bill that rose forever would
	# cross a measured loop out in empty space where §114's ceiling law samples
	# nothing.
	var fee_bad := ""
	var fee_last := 0
	var fee_rises := true
	for d in [1.0, 200.0, 900.0, 2600.0, 4200.0, 6500.0, 9000.0]:
		var rf := rescue_fee(d)
		var jf := beacon_jump_fee(d)
		if rf <= jf and fee_bad == "":
			fee_bad = "at %du rescue %d <= jump %d" % [int(d), rf, jf]
		if rf <= fee_last:
			fee_rises = false
		fee_last = rf
	# AND IT STOPS WHERE THE CONTENT DOES. Ten times past the marks is a pilot
	# in empty space; the tug's bill is the flight home, and there is nothing out
	# there it could have been called to.
	var fee_capped: bool = rescue_fee(FarMarks.DEPTH_MAX * 10.0) \
		== rescue_fee(FarMarks.DEPTH_MAX)
	print("[spill] THE RESCUE COSTS MORE THAN THE JUMP 7 depths swept, %du costs %d, deeper always dearer=%s, flat past the marks=%s, first cheaper-than-a-jump: %s -> %s" % [
		9000, rescue_fee(9000.0), str(fee_rises), str(fee_capped),
		fee_bad if fee_bad != "" else "none",
		"PASS" if fee_bad == "" and fee_rises and fee_capped else "FAIL"])

	# 11. THE TUG TAKES WHAT YOU HAVE. A rescue that could fail for want of
	#     credits is a soft-lock with a story attached -- there is no other way
	#     out of a shield-zero ship -- and a debt is a second currency this game
	#     does not have. So it bills what is in the account and writes off the
	#     rest. Both directions: a full wallet pays the whole fee, a thin one
	#     pays exactly what it had and lands on zero, never below.
	player.global_position = deep_pos
	await get_tree().physics_frame
	var owed := rescue_fee(deep_space.depth_at(deep_pos))
	GameState.salvage = owed + 250
	var paid_full := charge_rescue(deep_pos)
	var left_full := GameState.salvage
	GameState.salvage = 40
	var paid_thin := charge_rescue(deep_pos)
	var left_thin := GameState.salvage
	GameState.salvage = 0
	var paid_broke := charge_rescue(deep_pos)
	var left_broke := GameState.salvage
	print("[spill] THE TUG TAKES WHAT YOU HAVE fee %d at %du: a %d balance pays %d and keeps %d; a 40 balance pays %d and keeps %d; a broke one pays %d and keeps %d -> %s" % [
		owed, int(deep_space.depth_at(deep_pos)), owed + 250, paid_full, left_full,
		paid_thin, left_thin, paid_broke, left_broke,
		"PASS" if owed > 0 and paid_full == owed and left_full == 250
			and paid_thin == 40 and left_thin == 0
			and paid_broke == 0 and left_broke == 0 else "FAIL"])

	# 12. THE CLOCK IS THE FLIGHT BACK. The claim window is not a flat number: it
	#     is scaled by the depth the cargo was dropped at, because what it is
	#     really measuring is how far the player has to come. A flat window would
	#     be generous at the chart edge and impossible at the marks.
	var near_ttl := spill_claim_seconds(0.0)
	var mid_ttl := spill_claim_seconds(1400.0)
	var far_ttl := spill_claim_seconds(9000.0)
	print("[spill] THE CLOCK IS THE FLIGHT BACK %.0fs at the edge, %.0fs at 1,400u, %.0fs at the marks -> %s" % [
		near_ttl, mid_ttl, far_ttl,
		"PASS" if near_ttl >= SPILL_CLAIM_BASE and mid_ttl > near_ttl
			and far_ttl > mid_ttl else "FAIL"])

	# §128. NOTHING IS TAKEN UNDER THE LIGHT, and it is asserted in BOTH
	# directions because a grant that always granted is the same useless thing as
	# a gate that always refused (`NO ORDER WITHOUT THE READ`'s posture, and
	# `THE LADDER STANDS`').
	#
	# The clock is driven rather than waited out -- this file's own technique
	# three legs up, and for the same reason: 180 seconds of harness time to
	# prove a branch is off is 180 seconds nobody will spend.
	# A CLEAN SITE FIRST. `_tick_spill_claim` reads adrift[0]'s position -- the
	# same cube the claim itself reports from -- so one survivor from a leg above,
	# sitting outside the light, would decide this test. The legs above end at
	# zero today; that is a fact about them, not a precondition this one stated.
	for stale in _spill_cubes():
		stale.queue_free()
	await get_tree().physics_frame
	GameState.colonies = {}
	GameState.colony_works = {}
	var lit_at := Vector3(600.0, 0.0, 0.0)
	GameState.claim_colony("pyx01:5", lit_at.x, lit_at.z)
	GameState.colony_works["pyx01:5"] = ["light"]
	# 1. THE RULE FUNCTION, at the boundary rather than at the middle: a radius
	#    read as a diameter, or the dock's thirty leaking in through
	#    work_aura_at's default, both pass a test taken at the centre.
	var lit_here := GameState.light_aura_at(lit_at.x, lit_at.z)
	var lit_inside := GameState.light_aura_at(
		lit_at.x + GameState.LIGHT_AURA_RANGE - 1.0, lit_at.z)
	var lit_outside := GameState.light_aura_at(
		lit_at.x + GameState.LIGHT_AURA_RANGE + 1.0, lit_at.z)
	# 2. NO TWO LIGHTS OVERLAP. The radius is derived from the separation the
	#    generator guarantees, so this is the invariant that derivation exists
	#    for -- and it reddens if either constant moves alone.
	var no_overlap := GameState.LIGHT_AURA_RANGE * 2.0 <= SystemDB.MIN_HYPER_SEPARATION
	# 3. THE CLOCK STOPS INSIDE IT. A real spill, at the colony, ticked hard.
	var player_l: PlayerShip = get_tree().get_first_node_in_group("player")
	if player_l != null:
		player_l.global_position = lit_at
	GameState.cargo = {}
	GameState.load_cargo("salvage_quiet", 4)
	spill_unread(lit_at)
	await get_tree().physics_frame
	var lit_spilled := _spill_cubes().size()
	_spill_claim_left = 5.0
	_spill_lit = false
	for i in range(6):
		_tick_spill_claim(10.0)
	await get_tree().physics_frame
	var lit_left := _spill_claim_left
	var lit_alive := _spill_cubes().size()
	var lit_told := _spill_lit
	# 4. AND IT RUNS AGAIN OUTSIDE IT. Same spill, same clock, the light moved
	#    off it -- so the only thing that changed is the one thing being tested.
	GameState.colony_works["pyx01:5"] = []
	_spill_claim_left = 5.0
	_tick_spill_claim(10.0)
	await get_tree().physics_frame
	await get_tree().physics_frame
	var unlit_alive := _spill_cubes().size()
	print("[spill] NOTHING IS TAKEN UNDER THE LIGHT reach %.0fu (half the %.0fu structures must stand apart, so no two overlap=%s); at the colony=%s, a unit inside=%s, a unit outside=%s; %d crate(s) held %.0fs of clock through 60s of ticks and %d survived (told once=%s); light off, %d left -> %s" % [
		GameState.LIGHT_AURA_RANGE, SystemDB.MIN_HYPER_SEPARATION, str(no_overlap),
		str(lit_here), str(lit_inside), str(lit_outside),
		lit_spilled, lit_left, lit_alive, str(lit_told), unlit_alive,
		"PASS" if no_overlap and lit_here and lit_inside and not lit_outside
			and lit_spilled > 0 and is_equal_approx(lit_left, 5.0)
			and lit_alive == lit_spilled and lit_told and unlit_alive == 0
			else "FAIL"])

	GameState.salvage = 5000
	_spill_claim_left = 0.0
	_spill_warned = false
	_spill_lit = false
	get_tree().quit()


func _spill_cubes() -> Array:
	var out: Array = []
	for n in system_root.get_children():
		if n is LootCube and bool((n as LootCube).spill):
			out.append(n)
	return out


func _find_crackable() -> Node3D:
	# ANY hull. SPILLTEST's hold-cancel check only needs something to hold on
	# to, so it takes whichever is nearest to hand.
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is Derelict:
			return n
	return null


func _find_survey_hull() -> Derelict:
	# THE hull -- the one that charts the next system and files the opening
	# bearing. v18 put a second crackable in PYX-01 (the tutorial's training
	# hull), so "the derelict" stopped being answerable by
	# get_first_node_in_group and became a question about which one carries
	# `counts_as_survey`. Every caller that means PROGRESSION goes through here;
	# callers that just need a hull to grab keep using _find_crackable.
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is Derelict and (n as Derelict).counts_as_survey:
			return n as Derelict
	return null


# --- bonded store harness -----------------------------------------------------

func _first_bay_cell() -> String:
	# The first cell the GENERATOR says holds a station with a bay. Found rather
	# than hard-coded: which cells have one is a property of the seed, so a test
	# that names a cell by hand is a test that asserts against a guess. Pure and
	# deterministic, so the write leg and the read leg agree without sharing state.
	for ring in range(1, 24):
		for cx in range(-ring, ring + 1):
			for cz in range(-ring, ring + 1):
				if maxi(absi(cx), absi(cz)) != ring:
					continue
				if deep_space != null and deep_space.cell_has_bay(system_id, cx, cz):
					return DeepSpace.cell_key(system_id, cx, cz)
	return "pyx01:0:0"


func _run_store_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.4).timeout

	# 1. Three bays on the chart, one per system, so retrieval is a warp and not
	#    a hop.
	var bays: Array = []
	for pid_v in SystemDB.port_ids():
		var pid := String(pid_v)
		if GameState.port_has_bay(SystemDB.port_def_by_id(pid)):
			bays.append(pid)
	var systems_covered := {}
	for pid_v in bays:
		systems_covered[SystemDB.system_of_port(String(pid_v))] = true
	print("[store] BAYS %s across %d systems -> %s" % [
		str(bays), systems_covered.size(),
		"PASS" if bays.size() == 3 and systems_covered.size() == 3 else "FAIL"])

	# 2. No archetype declares storage. A deep bay is a property of a PLACE, rolled
	#    per cell — if it were on the archetype, every station of that kind would
	#    have one and the scarcity would be a lie.
	var arch_declares := ""
	for a_v in DeepPortDB.ARCHETYPES:
		var a: Dictionary = a_v
		if (a.get("services", []) as Array).has("storage"):
			arch_declares = String(a["id"])
	print("[store] NOT ON THE ARCHETYPE 0 of %d deep archetypes declare storage -> %s %s" % [
		DeepPortDB.ARCHETYPES.size(), "PASS" if arch_declares == "" else "FAIL", arch_declares])

	# 3. And the roll actually produces some, at roughly the authored rate.
	var stations := 0
	var with_bay := 0
	for cx in range(-12, 12):
		for cz in range(-12, 12):
			var st: Dictionary = deep_space.plan_cell(cx, cz).get("station", {})
			if st.is_empty():
				continue
			stations += 1
			if bool(st.get("storage", false)):
				with_bay += 1
	var rate := float(with_bay) / maxf(float(stations), 1.0)
	print("[store] DEEP BAYS %d of %d stations over 576 cells = %.0f%% (want ~%.0f%%) -> %s" % [
		with_bay, stations, rate * 100.0, DeepSpace.DEEP_STORAGE_CHANCE * 100.0,
		"PASS" if stations > 0 and rate > 0.04 and rate < 0.34 else "FAIL"])

	# 4. THE BONDED RULE. Only what the game will never sell you.
	# Asserts the RULE, not a headcount. This line originally hardcoded "15
	# storable" and went red the moment four chart goods were added — reporting on
	# how much content exists rather than on whether the rule holds, which is
	# exactly what 10 warns a pacing assertion must never do. The invariant is
	# that storable and no_retail are the SAME SET, in both directions.
	var storable: Array = []
	var refused: Array = []
	var wrong := ""
	for gid in CommodityDB.ids():
		var g := String(gid)
		if GameState.can_store(g):
			storable.append(g)
			if not CommodityDB.no_retail(g):
				wrong = "%s is storable but retailed" % g
		else:
			refused.append(g)
			if CommodityDB.no_retail(g):
				wrong = "%s is no_retail but refused" % g
	print("[store] BONDED %d storable / %d refused, storable set == no_retail set -> %s %s" % [
		storable.size(), refused.size(), "PASS" if wrong == "" else "FAIL", wrong])

	# 5. THE MONEY PRINTER THIS EXISTS TO CLOSE, priced in full every run whether
	#    or not the guard holds. Market events run 240-360s, so an open bay lets
	#    you buy under a glut, put the goods down, wait for the event to lapse and
	#    sell at the SAME counter. NO ROUND-TRIP PROFIT cannot see it: it prices
	#    both legs in one instant under one market_events array.
	var adef := SystemDB.port_def_by_id("anchor")
	GameState.market_events = [{"kind": "glut", "port": "anchor", "good": "alloys",
		"mult": 0.55, "remaining": 300.0}]
	var glut_buy := Market.buy_price(adef, "anchor", "alloys", 24)
	GameState.market_events = []
	var lapsed_sell := Market.sell_price(adef, "anchor", "alloys", 24)
	var spread := (lapsed_sell - glut_buy) * 24
	print("[store] NO TIMED ARBITRAGE glut buy 24 @%d = %d; lapse; sell @%d = %d -> %+d (%+.0f%%) if it could be stashed. can_store(alloys)=%s -> %s" % [
		glut_buy, glut_buy * 24, lapsed_sell, lapsed_sell * 24, spread,
		100.0 * float(lapsed_sell - glut_buy) / maxf(float(glut_buy), 1.0),
		str(GameState.can_store("alloys")),
		"PASS" if not GameState.can_store("alloys") else "FAIL"])

	# 6. NO WORMHOLE. Deep bays key on the cell, never on port_id — every station
	#    of an archetype shares that id, in every system, forever.
	GameState.warehouse = {}
	GameState.cargo = {}
	GameState.load_cargo("servo_prewar", 4)
	var here := DeepSpace.cell_key(system_id, 3, -7)
	GameState.store_cargo(here, "servo_prewar", 4)
	var leaked := 0
	for other in [DeepSpace.cell_key(system_id, 3, -6), DeepSpace.cell_key("pyx03", 3, -7),
			"deep_relay", "deep_forge", "anchor", "depot"]:
		leaked += GameState.warehouse_used(String(other))
	print("[store] NO WORMHOLE %d space at %s, %d found at 6 other keys -> %s" % [
		GameState.warehouse_used(here), here, leaked,
		"PASS" if GameState.warehouse_used(here) > 0 and leaked == 0 else "FAIL"])

	# 7. A bay is NOT a hold. Stored cargo must not weigh, must not draw raiders,
	#    and must not trip a carried effect — 19's rule one shelf over.
	var used_with_bay := GameState.cargo_used()
	var value_with_bay := GameState.hold_value(true)
	GameState.cargo = {}
	GameState.load_cargo("charge_unstable", 1)
	var sig_carried := hold_signature()
	GameState.store_cargo(here, "charge_unstable", 1)
	var sig_stored := hold_signature()
	print("[store] BAY IS NOT A HOLD used %d, weighted value %d, signature carried %.2f -> stored %.2f -> %s" % [
		used_with_bay, value_with_bay, sig_carried, sig_stored,
		"PASS" if used_with_bay == 0 and value_with_bay == 0 \
			and sig_carried > 1.0 and is_equal_approx(sig_stored, 1.0) else "FAIL"])

	# 8. NEVER A PORT-DEF KEY, which §127 narrowed this to from "one cap,
	#    everywhere". A cap authored per station is a thing you SHOP for, and
	#    that is the second budget 9 rule 1 forbids. A cap a pilot RAISES at a
	#    colony they founded is not shoppable and not authored, so EXPANDED
	#    VAULTS passes over this law rather than through it -- and every charted
	#    and deep counter in the game is still exactly 60, which is what this
	#    sweep still proves.
	var carries_key := ""
	for pid_v in SystemDB.port_ids():
		if SystemDB.port_def_by_id(String(pid_v)).has("warehouse_space"):
			carries_key = String(pid_v)
	for a_v in DeepPortDB.ARCHETYPES:
		if (a_v as Dictionary).has("warehouse_space"):
			carries_key = String((a_v as Dictionary)["id"])
	print("[store] CAP %d space everywhere, 0 defs carry warehouse_space -> %s %s" % [
		GameState.WAREHOUSE_SPACE, "PASS" if carries_key == "" else "FAIL", carries_key])

	# 9. The archetype const must survive station construction. DeepPortDB.by_id
	#    returns the ARCHETYPES entry itself, so appending "storage" to a station's
	#    services without duplicating first would give every later station of that
	#    kind a bay.
	var svc_before := (DeepPortDB.by_id("deep_relay").get("services", []) as Array).size()
	for cx in range(-6, 6):
		for cz in range(-6, 6):
			deep_space.plan_cell(cx, cz)
	var mutated := ""
	for a_v in DeepPortDB.ARCHETYPES:
		if ((a_v as Dictionary).get("services", []) as Array).has("storage"):
			mutated = String((a_v as Dictionary)["id"])
	print("[store] ARCHETYPE INTACT deep_relay services %d, none gained storage -> %s %s" % [
		svc_before, "PASS" if mutated == "" else "FAIL", mutated])

	# 10. STASH CONSERVES. The equation is the whole difference between stashing
	#     and jettisoning, so it is asserted as an equation and all three numbers
	#     are printed — a stash that silently eats three units passes any boolean.
	GameState.warehouse = {}
	GameState.cargo = {}
	GameState.reactor_tier = 2
	for m in ["rig_hauler", "util_cargo"]:
		if not GameState.owns(m):
			GameState.owned.append(m)
	GameState.equip(ModuleDB.Slot.UTILITY, "rig_hauler")
	GameState.load_cargo("salvage_quiet", 12)
	var before_used := GameState.cargo_used()
	var stashed := GameState.stash_to_fit(ModuleDB.Slot.UTILITY, "", "anchor")
	var after_used := GameState.cargo_used()
	var after_bay := GameState.warehouse_used("anchor")
	print("[store] STASH CONSERVES %d used -> %d used + %d in bay (must be equal), %d moved -> %s" % [
		before_used, after_used, after_bay, stashed,
		"PASS" if before_used == after_used + after_bay and stashed > 0 else "FAIL"])

	# 11. ALL OR NOTHING. A stash that half-fills the bay and still fails the equip
	#     leaves the player over-full with a partly-emptied hold and no explanation.
	GameState.warehouse = {}
	GameState.cargo = {}
	GameState.load_cargo("salvage_quiet", 16)
	# Fill the bay to one space short of what the overflow needs.
	GameState.warehouse["anchor"] = {"servo_prewar": 19}
	var hold_before := GameState.cargo_used()
	var partial := GameState.stash_to_fit(ModuleDB.Slot.UTILITY, "", "anchor")
	print("[store] STASH REFUSED WHOLE bay too full: %d moved, hold %d -> %d -> %s" % [
		partial, hold_before, GameState.cargo_used(),
		"PASS" if partial == 0 and GameState.cargo_used() == hold_before else "FAIL"])

	# 12. Jettison still destroys. The stash exit must not have quietly turned the
	#     destructive path lossless — 16 says dumping cargo may never pay.
	GameState.warehouse = {}
	GameState.cargo = {}
	GameState.load_cargo("salvage_quiet", 12)
	var salv_before := GameState.salvage
	var dumped := GameState.jettison_to_fit(ModuleDB.Slot.UTILITY, "")
	print("[store] JETTISON STILL PAYS NOTHING dumped %d, salvage %d -> %d -> %s" % [
		dumped, salv_before, GameState.salvage,
		"PASS" if dumped > 0 and GameState.salvage == salv_before else "FAIL"])

	# 13. NO PASSIVE GROWTH. This is what keeps 17 true: a bay is deliberate
	#     state, not a visited-cells array. Flying past stations must add nothing.
	GameState.warehouse = {}
	var keys_before := GameState.warehouse.size()
	for step in range(40):
		player.global_position = Vector3(float(step) * 64.0, 0.0, float(step) * 32.0)
		await get_tree().physics_frame
	print("[store] NO PASSIVE GROWTH flew 40 cells past live stations: %d keys -> %d -> %s" % [
		keys_before, GameState.warehouse.size(),
		"PASS" if GameState.warehouse.size() == keys_before else "FAIL"])
	# --- §110. THE ORDER BOOK -------------------------------------------------

	# THE ORDER DESK IS NOT A PRINTER. §11's law, applied to a verb that did not
	# exist when it was written. An order that cost less than a sale anywhere
	# would be a money loop -- and worse, one NO ROUND-TRIP PROFIT cannot see,
	# because components are storable (can_store == no_retail) so the loop can be
	# run through a bonded bay across two different market states.
	#
	# The bound is RE-DERIVED from the live constants rather than trusted from a
	# comment: peak drift, peak pressure, a shortage, a freeport's thinner
	# spread, a bulk break and the deepest fence multiplier in the game, all at
	# once, on top of any authored bias. If any of those constants moves, this
	# recomputes and stays honest.
	var fence_best := 1.0
	for pid_fv in SystemDB.port_ids():
		fence_best = maxf(fence_best,
			float(SystemDB.port_def_by_id(String(pid_fv)).get("fence_mult", 1.0)))
	for aid_fv in DeepPortDB.ids():
		fence_best = maxf(fence_best,
			float(DeepPortDB.by_id(String(aid_fv)).get("fence_mult", 1.0)))
	var bulk_best := 1.0
	for pid_bv in SystemDB.port_ids():
		bulk_best = maxf(bulk_best,
			1.0 + float(SystemDB.port_def_by_id(String(pid_bv)).get("bulk_bonus", 0.0)))
	var worst_event := 1.0
	for k_v in Market.EVENT_KINDS:
		worst_event = maxf(worst_event,
			float((Market.EVENT_KINDS[k_v] as Dictionary).get("max_mult", 1.0)))
	var ceiling_mult := (1.0 + Market.DRIFT_AMPLITUDE) * (1.0 + Market.PRESSURE_CAP) \
		* worst_event * (1.0 - Market.FREEPORT_SPREAD) * bulk_best * fence_best
	var printer := ""
	var comps := 0
	# §125. AND THE LINE REPORTS THE MARGIN IT ASSERTS, which the first draft of
	# it did not. It printed `ceiling_mult` -- the bias-FREE ceiling -- while the
	# loop below asserts against `bias_best * ceiling_mult`, PER GOOD. The two
	# agree today only by accident: not one component carries a port bias
	# anywhere in the game, so every bias_best reads 1.0 and the printed figure
	# happens to be the asserted one.
	#
	# The first authored component bias breaks that silently, in the one
	# direction that matters: the line would keep printing 4.45x while the real
	# worst-case sale climbed toward the order price, under-reporting the danger
	# it exists to warn about at the exact moment the danger became real. That is
	# §124's rule -- A NUMBER IN PROSE STATES WHAT PRODUCED IT -- owed by an
	# assertion one commit after the rule was written, and found by reading this
	# leg rather than by it going red.
	#
	# SO THE THINNEST MARGIN IS THE MEASUREMENT. A boolean law says whether the
	# desk is a printer TODAY; the margin says how close it is, which is the only
	# form of this number a content author can act on before the red. It is
	# 1.124 as this ships -- REQ_MULT 5.0 against a 4.45x worst-case sale -- so a
	# component bias of 1.124 at any counter is the edit that trips it.
	#
	# AND THE GOOD IT NAMES TODAY MEANS NOTHING, which is worth saying because a
	# named good reads as a singled-out one. Every margin is identical while
	# every bias is 1.0, so the row reported is simply the first component in
	# CommodityDB.ids() order. The moment a bias exists the name starts carrying
	# information, and that is the only condition under which it should be read.
	var worst_margin := 0.0
	var worst_id := ""
	var worst_sale := 0.0
	for gid_pv in CommodityDB.ids():
		var gid_p := String(gid_pv)
		if not CommodityDB.is_component(gid_p):
			continue
		comps += 1
		var base_p := float(CommodityDB.base_price(gid_p))
		var bias_best := 1.0
		for d_pv in SystemDB.port_ids():
			bias_best = maxf(bias_best,
				Market.port_bias(SystemDB.port_def_by_id(String(d_pv)), gid_p))
		for a_pv in DeepPortDB.ids():
			bias_best = maxf(bias_best,
				Market.port_bias(DeepPortDB.by_id(String(a_pv)), gid_p))
		var best_sale := base_p * bias_best * ceiling_mult
		var margin := float(Market.requisition_price(gid_p)) / maxf(best_sale, 0.001)
		if worst_id == "" or margin < worst_margin:
			worst_margin = margin
			worst_id = gid_p
			worst_sale = best_sale
		if float(Market.requisition_price(gid_p)) <= best_sale and printer == "":
			printer = "%s orders at %d, best legal sale %.0f" % [
				CommodityDB.short_name(gid_p), Market.requisition_price(gid_p), best_sale]
	# Derived here rather than inside the format array: `worst_id` is an ID and
	# the name beside it is a DISPLAY string, and the first draft of this line
	# fed the display string to `requisition_price`. It would have printed a
	# price of 1 (maxi's floor on a base_price of 0 for an unknown id) beside a
	# correct margin, and passed -- a measurement column reporting on nothing,
	# in the leg being edited to stop exactly that.
	var worst_name := CommodityDB.short_name(worst_id) if worst_id != "" else "none"
	var worst_order := Market.requisition_price(worst_id) if worst_id != "" else 0
	var worst_x := worst_sale / maxf(float(CommodityDB.base_price(worst_id)), 1.0) \
		if worst_id != "" else 0.0
	print("[store] THE ORDER DESK IS NOT A PRINTER %d components at %.1fx base; thinnest margin %.3f on %s (orders %d, best legal sale %.0f = %.2fx base), first loop: %s -> %s" % [
		comps, Market.REQ_MULT, worst_margin, worst_name, worst_order, worst_sale, worst_x,
		printer if printer != "" else "none",
		"PASS" if printer == "" and comps > 0 else "FAIL"])

	# NO ORDER WITHOUT THE READ. The desk sources what you have handled, so
	# requisitions relieve late-game scarcity without becoming a way around
	# ARCHEOLOGY. Both directions, or a gate that always refused would pass.
	GameState.requisition_orders = []
	GameState.reads_done = {}
	var before_read := GameState.can_order("sink_thermal")
	GameState.note_read("sink_thermal")
	var after_read := GameState.can_order("sink_thermal")
	var never_a_good := GameState.can_order("alloys")
	print("[store] NO ORDER WITHOUT THE READ unread=%s, after one read=%s, and a bulk good is never orderable=%s -> %s" % [
		str(before_read), str(after_read), str(never_a_good),
		"PASS" if not before_read and after_read and not never_a_good else "FAIL"])

	# AN ORDER WAITS, and the book has a bottom. Delivery is a played-clock wait
	# rather than a vending machine, and three open orders is the cap -- enforced
	# at the store and not only in the UI.
	GameState.requisition_orders = []
	GameState.cargo = {}
	GameState.played_seconds += 10.0
	var placed := GameState.place_order("sink_thermal", "void")
	var early := GameState.collect_order(0)
	GameState.played_seconds += GameState.REQ_DELAY
	var late := GameState.collect_order(0)
	var landed := GameState.cargo_count("sink_thermal")
	GameState.note_read("rod_decay")
	GameState.note_read("plate_ablative")
	GameState.note_read("lattice_data")
	GameState.requisition_orders = []
	for oi in range(5):
		GameState.place_order("sink_thermal", "void")
	var capped := GameState.requisition_orders.size()
	GameState.requisition_orders = []
	GameState.cargo = {}
	print("[store] AN ORDER WAITS placed=%s, collecting early=%s, after %ds=%s (%d aboard), and five attempts leave %d of %d open -> %s" % [
		str(placed), str(early), int(GameState.REQ_DELAY), str(late), landed,
		capped, GameState.REQ_MAX_OPEN,
		"PASS" if placed and not early and late and landed == 1
			and capped == GameState.REQ_MAX_OPEN else "FAIL"])

	# THE DESK IS A GATE, NOT A COUNTER. Ordering is a distinct verb from
	# retailing: Market.can_buy is untouched by the whole feature, so SELL ONLY
	# keeps passing and a fence still buys without selling. If this ever goes
	# red, the back room has become a shopfront and §11's loop is open again.
	var retailed_comp := ""
	for pid_gv in SystemDB.port_ids():
		var gdef := SystemDB.port_def_by_id(String(pid_gv))
		for gid_gv in CommodityDB.ids():
			if CommodityDB.is_component(String(gid_gv)) \
					and Market.can_buy(gdef, String(gid_gv)) and retailed_comp == "":
				retailed_comp = "%s at %s" % [String(gid_gv), String(pid_gv)]
	var desk_ports := 0
	for pid_sv in SystemDB.port_ids():
		if (SystemDB.port_def_by_id(String(pid_sv)).get("services", []) as Array).has("requisitions"):
			desk_ports += 1
	for aid_sv in DeepPortDB.ids():
		if (DeepPortDB.by_id(String(aid_sv)).get("services", []) as Array).has("requisitions"):
			desk_ports += 1
	print("[store] THE DESK IS A GATE, NOT A COUNTER %d order desks in the game, and no component is retailed anywhere (%s) -> %s" % [
		desk_ports, retailed_comp if retailed_comp != "" else "none",
		"PASS" if retailed_comp == "" and desk_ports >= 2 else "FAIL"])

	GameState.requisition_orders = []
	GameState.reads_done = {}
	get_tree().quit()


# --- salvage / archeology harness ---------------------------------------------

func _run_salvage_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	await get_tree().create_timer(0.4).timeout

	# 1. The catalog is coherent: every grade reads into things that exist, and
	#    every band has one.
	var grades := []
	for band in range(DeepSpace.BAND_NAMES.size()):
		var sid := CommodityDB.salvage_for_band(band)
		if sid != "":
			grades.append(sid)
	var outputs := {}
	var bad_output := ""
	for g_v in grades:
		for out_v in CommodityDB.reads_as(String(g_v)):
			outputs[String(out_v)] = true
			if not CommodityDB.exists(String(out_v)):
				bad_output = String(out_v)
	print("[salvage] CATALOG %d grades (one per band), %d distinct outputs, all exist -> %s %s" % [
		grades.size(), outputs.size(),
		"PASS" if grades.size() == DeepSpace.BAND_NAMES.size() and bad_output == "" else "FAIL",
		bad_output])

	# 2. Every grade offers a CHOICE. A single-output grade is a conversion, not a
	#    decision, and the whole reason there is no roll here is that the player
	#    picks — see the comment on CommodityDB.READS_AS.
	var thin := ""
	for g_v in grades:
		if CommodityDB.reads_as(String(g_v)).size() < 2:
			thin = String(g_v)
	print("[salvage] CHOICE every grade reads as >= 2 things -> %s %s" % [
		"PASS" if thin == "" else "FAIL", thin])

	# 3. NOTHING HERE IS BUYABLE, at any counter on the chart or past it. Buy
	#    salvage cheap, read it, sell the component dear is an infinite loop with
	#    no combat and no risk in it. Market.can_buy closes it on the buy side,
	#    the same way it closes the fence loop.
	var counters := SystemDB.port_ids()
	for a_v in DeepPortDB.ids():
		counters.append(String(a_v))
	var retailed := ""
	for pid_v in counters:
		var pid := String(pid_v)
		var pdef := SystemDB.port_def_by_id(pid)
		if pdef.is_empty():
			pdef = DeepPortDB.by_id(pid)
		for gid in CommodityDB.ids():
			var id := String(gid)
			if not (CommodityDB.is_salvage(id) or CommodityDB.is_component(id)):
				continue
			if Market.can_buy(pdef, id):
				retailed = "%s at %s" % [id, pid]
	print("[salvage] SELL ONLY no grade or component is buyable at any of %d counters -> %s %s" % [
		counters.size(), "PASS" if retailed == "" else "FAIL", retailed])

	# 4. Reading must PAY, or nobody would. Printed per band, so a mispriced table
	#    shows an obviously wrong number instead of a silent pass — the cheapest
	#    thing a grade reads into still has to beat selling it unread.
	var worst := 999999.0
	var worst_band := ""
	var margins := ""
	for g_v in grades:
		var sid := String(g_v)
		var raw := float(CommodityDB.base_price(sid))
		var cheapest := 999999.0
		for out_v in CommodityDB.reads_as(sid):
			cheapest = minf(cheapest, float(CommodityDB.base_price(String(out_v))))
		margins += "%s %.0f->%.0f  " % [CommodityDB.short_name(sid), raw, cheapest]
		if cheapest - raw < worst:
			worst = cheapest - raw
			worst_band = CommodityDB.short_name(sid)
	print("[salvage] READING PAYS %s-> %s (worst %s at +%.0f)" % [
		margins, "PASS" if worst > 0.0 else "FAIL", worst_band, worst])

	# 5. The one rule: field reads band <= tier, a lab reads one further. Both the
	#    skill and the lab stay relevant at every tier, which is the point.
	var gate_ok := true
	var grid := ""
	for tier in range(GameState.ARCHEOLOGY_TIERS.size()):
		GameState.archeology = tier
		for band in range(DeepSpace.BAND_NAMES.size()):
			var sid := CommodityDB.salvage_for_band(band)
			var field := GameState.can_read(sid, false)
			var lab := GameState.can_read(sid, true)
			if field != (band <= tier) or lab != (band <= tier + 1):
				gate_ok = false
		grid += "t%d:f<=%d,l<=%d  " % [tier, tier, tier + 1]
	GameState.archeology = 0
	print("[salvage] BAND GATE %s-> %s" % [grid, "PASS" if gate_ok else "FAIL"])

	# 6. A read consumes exactly one and produces exactly one, and the hold
	#    arithmetic survives it — a component can be bulkier than what it came out
	#    of, and a read that cannot be stowed must fail cleanly.
	GameState.cargo = {}
	GameState.archeology = 3
	GameState.load_cargo("salvage_quiet", 2)
	var before_used := GameState.cargo_used()
	var read_ok := GameState.identify("salvage_quiet", "heart_reliquary", true)
	print("[salvage] READ CONSUMES quiet 2->%d, heart 0->%d, hold %d->%d -> %s" % [
		GameState.cargo_count("salvage_quiet"), GameState.cargo_count("heart_reliquary"),
		before_used, GameState.cargo_used(),
		"PASS" if read_ok and GameState.cargo_count("salvage_quiet") == 1
			and GameState.cargo_count("heart_reliquary") == 1 else "FAIL"])

	# 7. Refused above your tier, and refused for an output the grade cannot yield
	#    — in both cases with NOTHING consumed. A half-completed read that eats the
	#    input is the worst possible failure here.
	GameState.archeology = 0
	var held_before := GameState.cargo_count("salvage_quiet")
	var over_tier := GameState.identify("salvage_quiet", "heart_reliquary", true)
	var wrong_out := GameState.identify("salvage_charted", "heart_reliquary", true)
	print("[salvage] READ REFUSED above tier=%s, wrong output=%s, quiet still %d -> %s" % [
		str(over_tier), str(wrong_out), GameState.cargo_count("salvage_quiet"),
		"PASS" if not over_tier and not wrong_out
			and GameState.cargo_count("salvage_quiet") == held_before else "FAIL"])

	# 8. Tiers have to be REACHABLE against what the game actually pays. With three
	#    hulls on the whole chart, a tier needing fifteen derelicts is content you
	#    can see and never use.
	GameState.archeology = 0
	GameState.archeology_xp = 0
	var cap: int = GameState.ARCHEOLOGY_TIERS[GameState.ARCHEOLOGY_TIERS.size() - 1]
	# A standard loop cracks one hull and reads what a hold brings back.
	var per_loop := float(GameState.ARCHEOLOGY_PER_BREACH) \
		+ 8.0 * float(GameState.ARCHEOLOGY_PER_READ)
	var loops := float(cap) / maxf(per_loop, 0.01)
	print("[salvage] TIERS %s, top at %d xp = %.1f standard loops -> %s" % [
		str(GameState.ARCHEOLOGY_TIERS), cap, loops,
		"PASS" if loops <= 12.0 else "FAIL"])

	# 9. The carried effects. A Forged Manifest quietens the hold and an Unstable
	#    Charge lights it up — a thing you want to carry that makes the trip worse
	#    is the trade 16 asks of every specialist, moved into the hold.
	GameState.cargo = {}
	var plain := hold_signature()
	GameState.load_cargo("manifest_forged", 1)
	var quiet_sig := hold_signature()
	GameState.cargo = {}
	GameState.load_cargo("charge_unstable", 1)
	var loud_sig := hold_signature()
	GameState.cargo = {}
	print("[salvage] SIGNATURE plain %.2f, manifest %.2f, charge %.2f -> %s" % [
		plain, quiet_sig, loud_sig,
		"PASS" if quiet_sig < plain and loud_sig > plain else "FAIL"])

	# 10. Provenance is real: what a crate yields is named for where it was found.
	var deep_grade := CommodityDB.salvage_for_band(4)
	var home_grade := CommodityDB.salvage_for_band(0)
	print("[salvage] PROVENANCE %s (%d) vs %s (%d), deeper is worth more -> %s" % [
		CommodityDB.short_name(home_grade), CommodityDB.base_price(home_grade),
		CommodityDB.short_name(deep_grade), CommodityDB.base_price(deep_grade),
		"PASS" if CommodityDB.base_price(deep_grade) > CommodityDB.base_price(home_grade) else "FAIL"])

	# 11. Every port a RESTRICTED GOOD names as a buyer must ACTUALLY have a
	#     counter for it. REACHABLE only needs one counter on the whole chart, so
	#     it would pass with a good listed at four ports and sellable at one —
	#     which is exactly the shape of the contraband-at-the-Cantina bug 11 was
	#     written about.
	#
	#     WIDENED (mining stage 3). This filtered on is_component, and
	#     `trade_only_at` is not a component field -- it is a RESTRICTION field
	#     that contraband, stolen goods and all eight ores carry too. Ore shipped
	#     naming four ports as its only buyers, and the one assertion whose whole
	#     job is to check that claim skipped every one of them, because ore has no
	#     `parent`. The filter now asks the question the assertion is named for:
	#     did this good name a buyer?
	#
	#     The swept count is printed because a filter that silently narrows is
	#     precisely how the hole opened -- "PASS" over eleven goods and "PASS"
	#     over twenty read identically in a log.
	var no_counter := ""
	var named_goods := 0
	for gid in CommodityDB.ids():
		var id := String(gid)
		var named: Array = CommodityDB.get_good(id).get("trade_only_at", [])
		if named.is_empty():
			continue
		named_goods += 1
		for pid_v in named:
			var pid := String(pid_v)
			var pdef := SystemDB.port_def_by_id(pid)
			if pdef.is_empty():
				pdef = DeepPortDB.by_id(pid)
			var svc: Array = pdef.get("services", PortPanel.DEFAULT_SERVICES)
			if not (svc.has("market") or (svc.has("fence") and Market.fences(pdef, id))):
				no_counter = "%s names %s, which has no counter for it" % [id, pid]
	print("[salvage] EVERY NAMED BUYER BUYS %d goods name a buyer -> %s %s" % [
		named_goods, "PASS" if no_counter == "" else "FAIL", no_counter])

	# 12. THE RATE THE TIERS ASSERTION IS COMPUTED FROM MUST ACTUALLY BE PAID.
	#     ARCHEOLOGY_PER_BREACH existed, TIERS divided by it, and nothing in the
	#     game ever awarded it — so TIERS printed the same "6.5 loops" whether the
	#     rate was real or fictional. 18's test, failed: an assertion whose output
	#     does not change when the thing it guards is broken guards nothing.
	GameState.archeology = 0
	GameState.archeology_xp = 0
	var xp_before := GameState.archeology_xp
	var hulk := Derelict.new()
	hulk.counts_as_survey = false          # a deep hulk: must STILL teach
	hulk.counts_for_contract = false
	system_root.add_child(hulk)
	hulk.global_position = Vector3(0, 0, -14)
	await get_tree().process_frame
	hulk.force_breach()
	await get_tree().create_timer(0.3).timeout
	var xp_gained := GameState.archeology_xp - xp_before
	print("[salvage] BREACH XP a deep hulk (counts_as_survey=false) pays %d, want %d -> %s" % [
		xp_gained, GameState.ARCHEOLOGY_PER_BREACH,
		"PASS" if xp_gained == GameState.ARCHEOLOGY_PER_BREACH else "FAIL"])

	# 13. A tier that arrives in silence cannot teach anything, and "did 0->1
	#     arrive fast enough" is the question the first play-test has to answer.
	GameState.archeology = 0
	GameState.archeology_xp = GameState.ARCHEOLOGY_TIERS[1] - 1
	GameState.cargo = {}
	GameState.load_cargo("salvage_charted", 1)
	GameState.last_read_tiered = false
	var tiered := GameState.identify("salvage_charted", "plate_ablative", false)
	print("[salvage] TIER ANNOUNCED read at the threshold -> tier %d, reported=%s -> %s" % [
		GameState.archeology, str(GameState.last_read_tiered),
		"PASS" if tiered and GameState.archeology == 1 and GameState.last_read_tiered else "FAIL"])

	# 14. Thermal Sink. Half a pulse, not immunity — a hazard an item switches off
	#     entirely has stopped being a trade.
	GameState.cargo = {}
	player.clear_emp()
	player.emp_stun(2.4)
	var bare_emp := player.emp_remaining()
	player.clear_emp()
	GameState.load_cargo("sink_thermal", 1)
	player.emp_stun(2.4)
	var sunk_emp := player.emp_remaining()
	player.clear_emp()
	GameState.cargo = {}
	print("[salvage] SINK EMP 2.4s -> %.2fs bare, %.2fs with a Thermal Sink -> %s" % [
		bare_emp, sunk_emp,
		"PASS" if is_equal_approx(bare_emp, 2.4) \
			and is_equal_approx(sunk_emp, 2.4 * PlayerShip.SINK_EMP_FACTOR) else "FAIL"])

	# 15. The two carried effects that are pure world-reads stay OFF the stat pile.
	#     19's rule: cargo may change what the world does to you, never what the
	#     ship can do. If any of these ever moved a fitted number, the hold guard
	#     would start subtracting two different piles from each other.
	GameState.cargo = {}
	var clean_stats := GameState.stats.duplicate(true)
	for carried in ["sink_thermal", "index_cartographic", "heart_reliquary",
			"manifest_forged", "charge_unstable"]:
		GameState.load_cargo(String(carried), 1)
	var loaded_stats := GameState.stats
	var moved := ""
	for key in clean_stats:
		if key == "weapons" or key == "ability":
			continue
		if not is_equal_approx(float(clean_stats[key]), float(loaded_stats.get(key, 0.0))):
			moved = String(key)
	GameState.cargo = {}
	print("[salvage] CARGO IS NOT A FIT all five carried effects move no fitted stat -> %s %s" % [
		"PASS" if moved == "" else "FAIL", moved])

	# 16. Cartographic Index. A station 300u out sits at the alpha floor without
	#     one and reads as a real contact with one — and ONLY stations do, because
	#     this is a thing that finds ports, not a sensor upgrade.
	var radar = hud.get_node_or_null("RadarLayer")
	if radar == null:
		for c in hud.get_children():
			if c.has_method("marker_alpha"):
				radar = c
	# Measured OUT IN THE REACHES, which is the only place the Index means
	# anything: inside the charted system every contact is inside the fade span
	# already, so widening it changes nothing. That is correct behaviour — you do
	# not need somebody else's chart of the system you started in — and testing it
	# at the origin was testing it exactly where it is designed to be inert.
	player.global_position = Vector3(520.0, 0.0, 0.0)
	for i in range(3):
		await get_tree().process_frame
	GameState.cargo = {}
	await get_tree().process_frame
	var port_bare: float = radar.marker_alpha(1, 300.0)
	var host_bare: float = radar.marker_alpha(3, 300.0)
	GameState.load_cargo("index_cartographic", 1)
	var port_idx: float = radar.marker_alpha(1, 300.0)
	var host_idx: float = radar.marker_alpha(3, 300.0)
	GameState.cargo = {}
	print("[salvage] INDEX in %s, station at 300u %.2f -> %.2f, hostiles %.2f -> %.2f (must not move) -> %s" % [
		DeepSpace.band_name(deep_depth()), port_bare, port_idx, host_bare, host_idx,
		"PASS" if port_idx > port_bare and is_equal_approx(host_bare, host_idx) else "FAIL"])

	# 17. Reliquary Heart. The tell is words instead of a hue, and it must be
	#     ABSENT without the Heart — an effect that fires either way is not an
	#     effect, it is a rewrite of the base game.
	var rigged := Derelict.new()
	system_root.add_child(rigged)
	rigged.arm_trap({"emp": 2.0, "count": 4, "band": 4})
	var plain_hulk := Derelict.new()
	system_root.add_child(plain_hulk)
	GameState.cargo = {}
	var rigged_bare := rigged.breach_prompt()
	GameState.load_cargo("heart_reliquary", 1)
	var rigged_heart := rigged.breach_prompt()
	var plain_heart := plain_hulk.breach_prompt()
	GameState.cargo = {}
	print("[salvage] HEART rigged tell with a Heart aboard=%s, without=%s, clean hulk unchanged=%s -> %s" % [
		str(rigged_heart != rigged_bare), str(rigged_bare == plain_hulk.breach_prompt()),
		str(plain_heart == plain_hulk.breach_prompt()),
		"PASS" if rigged_heart != rigged_bare and plain_heart == plain_hulk.breach_prompt() else "FAIL"])
	get_tree().quit()


# --- ship systems harness -----------------------------------------------------

func _run_ship_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	GameState.reactor_tier = 2
	for id in ["util_cargo", "util_cargo_2", "util_repair", "util_repair_2"]:
		if not GameState.owns(id):
			GameState.owned.append(id)
	await get_tree().create_timer(0.4).timeout

	# --- cargo hold guard -----------------------------------------------------
	GameState.equip(ModuleDB.Slot.UTILITY, "util_cargo_2")
	GameState.cargo = {}
	GameState.load_cargo("relics", 15)          # 45 of a 46+24 hold
	var used := GameState.cargo_used()
	var over := GameState.cargo_overflow(ModuleDB.Slot.UTILITY, "")
	var refused := not GameState.can_equip(ModuleDB.Slot.UTILITY, "")
	var still := GameState.equip(ModuleDB.Slot.UTILITY, "")
	print("[ship] HOLD GUARD %d used, stripping the bay overflows by %d, refused=%s equip=%s -> %s" % [
		used, over, str(refused), str(still),
		"PASS" if over > 0 and refused and not still else "FAIL"])
	print("[ship] HOLD STILL VALID used %d <= capacity %d -> %s" % [
		GameState.cargo_used(), GameState.cargo_capacity(),
		"PASS" if GameState.cargo_used() <= GameState.cargo_capacity() else "FAIL"])

	# Jettison dumps cheapest-first and only as much as it must.
	GameState.cargo = {}
	GameState.load_cargo("relics", 8)           # 24 space, 260 each
	GameState.load_cargo("alloys", 8)           # 16 space, 40 each
	var before_val := GameState.hold_value()
	var dumped := GameState.jettison_to_fit(ModuleDB.Slot.UTILITY, "")
	var kept_relics := GameState.cargo_count("relics")
	print("[ship] JETTISON dumped %d units, kept %d relics of 8, hold value %d -> %d -> %s" % [
		dumped, kept_relics, before_val, GameState.hold_value(),
		"PASS" if dumped > 0 and kept_relics == 8
			and GameState.can_equip(ModuleDB.Slot.UTILITY, "") else "FAIL"])

	# --- hull integrity + repair ---------------------------------------------
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	await get_tree().process_frame
	player.invulnerable = false
	player.shield = player.shield_max * 0.25
	var hurt := player.shield_fraction()
	player.repair_full()
	print("[ship] REPAIR hull %.0f%% -> %.0f%% -> %s" % [
		hurt * 100.0, player.shield_fraction() * 100.0,
		"PASS" if hurt < 0.3 and player.shield_fraction() >= 0.999 else "FAIL"])

	# The free option: out-of-combat regen actually recovers.
	player.shield = player.shield_max * 0.3
	var base_regen := float(GameState.stats.get("shield_regen", 0.0))
	await get_tree().create_timer(PlayerShip.SHIELD_CALM_DELAY + 2.0).timeout
	var healed := player.shield_fraction()
	print("[ship] SLOW HEAL 30%% -> %.0f%% after %.1fs calm at %.0f/s -> %s" % [
		healed * 100.0, PlayerShip.SHIELD_CALM_DELAY + 2.0, base_regen,
		"PASS" if healed > 0.3 else "FAIL"])

	# A Repair Bay makes that materially faster, which is what it is sold for.
	GameState.equip(ModuleDB.Slot.UTILITY, "util_repair_2")
	await get_tree().process_frame
	var kitted := float(GameState.stats.get("shield_regen", 0.0))
	print("[ship] REPAIR BAY regen %.0f/s -> %.0f/s -> %s" % [
		base_regen, kitted, "PASS" if kitted > base_regen * 2.0 else "FAIL"])

	var repair_ports: Array = []
	for pid in SystemDB.port_ids():
		var svc: Array = SystemDB.port_def_by_id(String(pid)).get("services", PortPanel.DEFAULT_SERVICES)
		if svc.has("repair"):
			repair_ports.append(pid)
	print("[ship] REPAIR SERVICE at %s -> %s" % [str(repair_ports),
		"PASS" if repair_ports.size() >= 3 else "FAIL"])

	# --- specialist rigs ------------------------------------------------------
	# Every rig must be a TRADE. A rig that is strictly better than bare hull is
	# just a stat stick, and the second utility slot would become "equip the two
	# best" rather than a decision.
	var rigs := ["rig_hauler", "rig_prospector", "rig_strike", "rig_bulwark", "rig_runner"]
	var all_trade := true
	var worst_rig := ""
	for id_v in rigs:
		var id := String(id_v)
		var st: Dictionary = ModuleDB.get_module(id).get("stats", {})
		var ups := 0
		var downs := 0
		for k in st:
			if float(st[k]) > 0.0:
				ups += 1
			elif float(st[k]) < 0.0:
				downs += 1
		if downs == 0:
			all_trade = false
			worst_rig = id
		print("[ship]   %-16s %d gains / %d costs" % [id, ups, downs])
	print("[ship] RIG TRADEOFFS every specialist rig costs something -> %s %s" % [
		"PASS" if all_trade else "FAIL", worst_rig])

	# Two rigs stacked must stay flyable — the floors in compute_stats are what
	# stop a hauler-plus-bulwark ship being unable to move at all.
	for id_v2 in rigs:
		if not GameState.owns(String(id_v2)):
			GameState.owned.append(String(id_v2))
	GameState.equip(ModuleDB.Slot.UTILITY, "rig_hauler")
	GameState.equip(ModuleDB.Slot.UTILITY_B, "rig_bulwark")
	await get_tree().process_frame
	var st2 := GameState.stats
	print("[ship] STACKED hauler+bulwark: speed %.1f accel %.1f turn %.1f hold %.0f shield %.0f -> %s" % [
		float(st2["max_speed"]), float(st2["accel"]), float(st2["turn_rate"]),
		float(st2["cargo_space"]), float(st2["shield_max"]),
		"PASS" if float(st2["max_speed"]) >= 1.6 and float(st2["accel"]) >= 3.0
			and float(st2["cargo_space"]) >= 6.0 else "FAIL"])
	# And the specialisation must actually read: a hauler carries more than a
	# strike frame and is slower than it.
	# Empty the hold first: rig_strike carries a -14 cargo penalty, and the new
	# hold guard correctly REFUSES to fit it under a loaded hold — so leaving the
	# relics aboard would silently compare a hauler against a hauler.
	GameState.cargo = {}
	GameState.equip(ModuleDB.Slot.UTILITY, "rig_hauler")
	GameState.equip(ModuleDB.Slot.UTILITY_B, "")
	await get_tree().process_frame
	var haul_hold := float(GameState.stats["cargo_space"])
	var haul_speed := float(GameState.stats["max_speed"])
	GameState.equip(ModuleDB.Slot.UTILITY, "rig_strike")
	await get_tree().process_frame
	var strike_hold := float(GameState.stats["cargo_space"])
	var strike_speed := float(GameState.stats["max_speed"])
	print("[ship] SPECIALISATION hauler %.0f hold / %.1f speed vs strike %.0f hold / %.1f speed -> %s" % [
		haul_hold, haul_speed, strike_hold, strike_speed,
		"PASS" if haul_hold > strike_hold and haul_speed < strike_speed else "FAIL"])
	# v24 (§94). SIX ON THE HULL, THREE FOR SALE. The literal 6 stays -- it is
	# the ship every pilot starts with, and that is the fact this leg was
	# written to pin -- but it is now checked against what a FRESH pilot can
	# actually fit rather than against the size of the catalog's table, because
	# those stopped being the same number the day berths shipped. The berth
	# slots are counted separately, so adding a fourth berth cannot quietly
	# change what a new pilot begins with.
	var berth_slots := 0
	for b_v in ModuleDB.BERTHS:
		berth_slots += 1
	var starter_slots := GameState.open_slots().size()
	print("[ship] SECOND SLOT %d fitting slots on a fresh hull, %d berths for sale, %d in the table -> %s" % [
		starter_slots, berth_slots, ModuleDB.SLOT_NAMES.size(),
		"PASS" if starter_slots == 6 and GameState.berths.is_empty()
			and ModuleDB.SLOT_NAMES.size() == 6 + berth_slots else "FAIL"])
	GameState.equip(ModuleDB.Slot.UTILITY, "")

	# --- breaking off a boss fight -------------------------------------------
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	player.invulnerable = true
	GameState.mark_breached(system_id)
	var boss := _find_apex()
	# v15. FLY TO THE LAIR FIRST. The engine hides hundreds of units out now, and
	# the wake is a PROXIMITY poll — arming the timer from spawn refuses forever,
	# which is correct behaviour and made this assertion measure nothing.
	# Inside CORE_RANGE too: take_damage breaks shots on the survey field from
	# further out, so damaging it from a distance is a no-op and the reset below
	# would be asserting against an untouched boss.
	player.global_position = boss.global_position + Vector3(0, 0, 5.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	boss.take_damage(400.0)
	await get_tree().process_frame
	var hp_before := boss.hp_fraction()
	var engaged := boss_active
	var broke := disengage_apex()
	await get_tree().create_timer(0.4).timeout
	# AND IT MUST LEAVE YOU WHERE YOU STOOD. This used to assert `home < 2.0` --
	# that breaking off teleported the ship back to spawn. That was right when the
	# fight happened near the origin and wrong the moment it moved: a free instant
	# trip home from the Quiet, on a button, with a full hold, would have been the
	# best cargo route in the game. Breaking off now ends the FIGHT and nothing
	# else, so this asserts the opposite of what it used to.
	var from_spawn := player.global_position.distance_to(PlayerShip.SPAWN_POINT)
	var from_lair := player.global_position.distance_to(boss.global_position)
	print("[ship] DISENGAGE LEAVES YOU AT THE LAIR engaged=%s broke=%s boss_active=%s hp %.2f -> %.2f, %.1fu from the engine and %.1fu from spawn -> %s" % [
		str(engaged), str(broke), str(boss_active), hp_before, boss.hp_fraction(),
		from_lair, from_spawn,
		"PASS" if engaged and broke and not boss_active
			and boss.hp_fraction() > hp_before
			and from_lair < ApexBoss.LEASH_RANGE and from_spawn > 100.0 else "FAIL"])
	print("[ship] DISENGAGE REFUSED outside a fight: %s (must be false) -> %s" % [
		str(disengage_apex()), "PASS" if not disengage_apex() else "FAIL"])

	# A MODULE THE CONSOLE CANNOT DRAW IS A MODULE NOBODY BUYS.
	# ModuleDB.summary_lines is a hardcoded list and it is the whole of what the
	# refit console shows, so a module carrying its upside in a key that is not on
	# that list reads as pure downside. Both mining tools did exactly that when
	# first written: the Cutting Head rendered a HANDLING penalty and nothing
	# else. Checking that the row EXISTS rather than that the list merely
	# CHANGED is the point -- util_cutter's turn_rate penalty already moves
	# HANDLING, so "the summary differs" would have passed while the upside was
	# still invisible.
	# WIDENED FROM THREE MODULES TO THE WHOLE CATALOG. As first written this
	# checked rig_prospector, util_cutter and util_assay for a CUT or ORE column,
	# which is the INSTANCE and not the rule -- and the rule was being broken
	# three rows away the entire time it was green. util_repair (5,200) and
	# util_repair_2 (13,500) carry shield_regen as their only stat and
	# shield_regen was not on the list, so both moved literally nothing; all
	# three cores carry an empty `stats` and did the same.
	var starter_cells := ModuleDB.summary_lines(ModuleDB.compute_stats(ModuleDB.STARTER_FIT))
	var mute := ""
	var mute_n := 0
	for mid_v in ModuleDB.MODULES:
		var mid := String(mid_v)
		var slot := ModuleDB.default_slot(mid, ModuleDB.STARTER_FIT)
		if slot < 0:
			continue
		var probe_fit := ModuleDB.STARTER_FIT.duplicate()
		probe_fit[slot] = mid
		# Compared against the SAME fit with that slot emptied rather than against
		# the starter, or every weapon would read as "changed" purely by displacing
		# the pulse it replaces and the check would pass on a mute module.
		var bare_fit := ModuleDB.STARTER_FIT.duplicate()
		bare_fit[slot] = ""
		var bare_cells := ModuleDB.summary_lines(ModuleDB.compute_stats(bare_fit))
		var with_cells := ModuleDB.summary_lines(ModuleDB.compute_stats(probe_fit))
		if str(bare_cells) == str(with_cells):
			mute_n += 1
			if mute == "":
				mute = mid
	print("[ship] THE CONSOLE DRAWS EVERY MODULE all %d modules move a column the player can read (mute: %d, first: %s) -> %s" % [
		ModuleDB.MODULES.size(), mute_n, mute if mute != "" else "none",
		"PASS" if mute_n == 0 else "FAIL"])

	# And the same rule one level down, per STAT rather than per module, because
	# a module can be legible by accident: util_cutter's turn_rate penalty already
	# moved HANDLING, so "something changed" was true while mining_rate itself was
	# undrawable. Perturbing one key at a time is what isolates that.
	#
	# The five keys compute_stats FOLDS are named in the output rather than
	# quietly skipped: damage, interval and range become DPS and REACH inside
	# compute_stats, so poking them in an already-computed dict proves nothing
	# either way. A silent skip list is how the first version of this line came to
	# cover three modules and read like it covered the catalog.
	var folded := ["damage", "interval", "range", "crit_chance", "weapon_range_bonus"]
	var base_stats := ModuleDB.compute_stats(ModuleDB.STARTER_FIT)
	var base_cells := ModuleDB.summary_lines(base_stats)
	var unreadable := ""
	var checked := 0
	var keys_seen := {}
	for mid_v in ModuleDB.MODULES:
		for k_v in (ModuleDB.MODULES[mid_v]["stats"] as Dictionary):
			keys_seen[String(k_v)] = true
		if not (ModuleDB.MODULES[mid_v].get("ability", {}) as Dictionary).is_empty():
			keys_seen["ability"] = true
	for key_v in keys_seen:
		var key := String(key_v)
		if folded.has(key):
			continue
		checked += 1
		var probe: Dictionary = base_stats.duplicate(true)
		if key == "ability":
			probe["ability"] = {"name": "PROBE", "duration": 9.0, "cooldown": 99.0}
		elif key == "chain" or key == "splash" or key == "overdraw":
			# Weapon keys live per-weapon; the starter flies two pulses.
			for w in probe["weapons"]:
				(w as Dictionary)[key] = 7.0
		else:
			probe[key] = float(probe.get(key, 0.0)) + 7.0
		if str(ModuleDB.summary_lines(probe)) == str(base_cells):
			unreadable += ("%s " % key)
	print("[ship] EVERY STAT REACHES A COLUMN %d of %d keys checked one at a time (%s folded into DPS/REACH), undrawable: %s -> %s" % [
		checked, keys_seen.size(), ", ".join(folded),
		unreadable if unreadable != "" else "none",
		"PASS" if unreadable == "" else "FAIL"])
	get_tree().quit()


# --- deep space harness -------------------------------------------------------

func _run_deep_shots() -> void:
	# The expanse is a look before it is a system, and no assertion can tell you
	# whether it reads. One frame per band, plus the two things a band is FOR:
	# somewhere to dock, and something that wants to kill you.
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	player.invulnerable = true
	_apex_wake_timer = -1.0
	UILayout.user_scale = 1.0
	UILayout.apply_scale(get_window())
	get_window().size = Vector2i(1280, 800)
	await get_tree().create_timer(0.6).timeout

	var edge := SystemDB.bounds_of(system_id)
	# Mid-band depths, so each frame is representative of its band rather than of
	# a boundary between two.
	for spec in [
		{"depth": 0.0, "tag": "0_charted"},
		{"depth": 80.0, "tag": "1_shoals"},
		{"depth": 300.0, "tag": "2_drift"},
		{"depth": 760.0, "tag": "3_reaches"},
		{"depth": 1500.0, "tag": "4_quiet"},
	]:
		var r := edge + float(spec["depth"])
		var at := Vector3(r * 0.7071, 0.0, r * 0.7071)
		player.global_position = at
		player.velocity = Vector3.ZERO
		rig.global_position = at + Vector3(0, 0, 2)
		rig.zoom = 24.0
		rig._target_zoom = 24.0
		# The system tag and the home marker are LIVE now (B5), so this captures
		# what the player actually sees rather than a stand-in the harness wrote.
		await get_tree().create_timer(1.2).timeout
		print("[deepshot] %s at %.0fu, depth %.0f, band %s, %d live cells, %d obstacles" % [
			spec["tag"], r, deep_depth(), DeepSpace.band_name(deep_depth()),
			deep_space.live_cell_count(), Obstacles.count()])
		await _shot(shots, "deep_%s.png" % spec["tag"])

	# A station, framed from the approach.
	var berth := Vector2i(0x7fffffff, 0x7fffffff)
	for try_band in [2, 3, 1, 4]:
		berth = _deep_probe(try_band, "station")
		if berth.x != 0x7fffffff:
			break
	if berth.x != 0x7fffffff:
		var st: Dictionary = deep_space.plan_cell(berth.x, berth.y)["station"]
		var sp: Vector3 = st["pos"]
		player.global_position = sp + Vector3(0, 0, 9.0)
		rig.global_position = sp + Vector3(0, 0, 6.0)
		rig.zoom = 17.0
		rig._target_zoom = 17.0
		await get_tree().create_timer(1.4).timeout
		print("[deepshot] station %s at %.0fu out" % [
			st["archetype"], Vector2(sp.x, sp.z).length()])
		await _shot(shots, "deep_5_station.png")

	# And a nest, sprung.
	var nest := _deep_probe(3, "pack")
	if nest.x != 0x7fffffff:
		var pk: Dictionary = deep_space.plan_cell(nest.x, nest.y)["pack"]
		var np: Vector3 = pk["pos"]
		player.global_position = np + Vector3(0, 0, 12.0)
		rig.global_position = np + Vector3(0, 0, 9.0)
		rig.zoom = 20.0
		rig._target_zoom = 20.0
		await get_tree().create_timer(2.0).timeout
		print("[deepshot] nest at %.0fu out, %d hostiles up" % [
			Vector2(np.x, np.z).length(), get_tree().get_nodes_in_group("hostiles").size()])
		await _shot(shots, "deep_6_nest.png")

	# The beacon that replaced the wall, caught mid-broadcast.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	_broadcast_band = 0
	player.global_position = Vector3(edge + 8.0, 0, 0)
	await get_tree().create_timer(0.5).timeout
	player.global_position = Vector3(edge + 70.0, 0, 0)
	rig.global_position = player.global_position + Vector3(0, 0, 2)
	await get_tree().create_timer(1.1).timeout
	print("[deepshot] beacon at %.0fu out" % deep_radius())
	await _shot(shots, "deep_8_beacon.png")

	# A rigged hulk, tell showing, before anybody touches it.
	var rig_cell := Vector2i(0x7fffffff, 0x7fffffff)
	for ring in range(1, 26):
		for cz in range(-ring, ring + 1):
			for cx in range(-ring, ring + 1):
				if maxi(absi(cx), absi(cz)) != ring:
					continue
				var h: Dictionary = deep_space.plan_cell(cx, cz)["hulk"]
				if not h.is_empty() and not (h["trap"] as Dictionary).is_empty():
					rig_cell = Vector2i(cx, cz)
					break
			if rig_cell.x != 0x7fffffff:
				break
		if rig_cell.x != 0x7fffffff:
			break
	if rig_cell.x != 0x7fffffff:
		var hk: Dictionary = deep_space.plan_cell(rig_cell.x, rig_cell.y)["hulk"]
		var hp2: Vector3 = hk["pos"]
		player.global_position = hp2 + Vector3(0, 0, 8.5)
		rig.global_position = hp2 + Vector3(0, 0, 5.0)
		rig.zoom = 16.0
		rig._target_zoom = 16.0
		await get_tree().create_timer(1.2).timeout
		print("[deepshot] rigged hulk at %.0fu out, loot %d" % [
			Vector2(hp2.x, hp2.z).length(), int(hk["loot"])])
		await _shot(shots, "deep_9_rigged.png")

	# The way back: the chart with RETURN TO SYSTEM showing, which it only does
	# from outside the charted volume.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	player.global_position = Vector3(edge + 620.0, 0, 0)
	await get_tree().create_timer(0.4).timeout
	chart_panel.open()
	await get_tree().create_timer(0.8).timeout
	print("[deepshot] chart at %.0fu out, recall offered=%s" % [
		deep_radius(), str(can_recall())])
	await _shot(shots, "deep_7_recall.png")
	get_tree().quit()


func _deep_probe(want_band: int, key: String) -> Vector2i:
	# Harness support: the NEAREST cell that sits in `want_band` and holds `key`,
	# found by widening rings from the origin. Deep content is deliberately sparse
	# and a band is an annulus rather than a direction, so looking along one
	# diagonal finds whatever happens to be on it — which is how this started life
	# and why it silently stopped finding Drift nests the moment the generator's
	# roll order changed. A ring walk cannot go stale that way.
	for ring in range(1, 26):
		for cz in range(-ring, ring + 1):
			for cx in range(-ring, ring + 1):
				if maxi(absi(cx), absi(cz)) != ring:
					continue                       # only the new ring
				var pl := deep_space.plan_cell(cx, cz)
				if int(pl["band"]) != want_band:
					continue
				if (pl[key] as Dictionary).is_empty():
					continue
				return Vector2i(cx, cz)
	return Vector2i(0x7fffffff, 0x7fffffff)


func _run_deep_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	# THE SURVEY GOES ON FILE UP HERE, and the position is the whole point.
	#
	# Section 30 stages a boss fight, and the engine answers a filed survey and
	# nothing else (main._wake_apex). This suite got away with never filing one
	# for as long as the breach test lived in _load_system: hand-arming the timer
	# jumped straight past it. It does not any more, so the precondition has to
	# be staged for real -- SHIPTEST and RADARTEST have both always done exactly
	# this before parking on the lair.
	#
	# AT THE TOP RATHER THAN AT SECTION 30, because mark_breached CHARTS the next
	# system and charting BROADCASTS. show_broadcast holds its plate for 7.65s,
	# and section 31 samples broadcast_text() about six seconds after section 30
	# to prove the beacons are silent inside charted space -- so filing the survey
	# down there put an unrelated transmission on screen and BEACONS read it. Up
	# here the plate has faded many minutes before anything asks. Safe against the
	# wake it arms, too: the line above disarms the poll and nothing re-arms it
	# until section 30 asks for the fight.
	GameState.mark_breached(system_id)
	await get_tree().create_timer(0.4).timeout

	# 0. Sentries stand where they were authored to stand.
	#
	#    This is here because they did not. `Hostile._ready` captured `_home` from
	#    `global_position`, but every spawner in the game sets `position` on the
	#    line AFTER `add_child` — so `_home` was always the container's origin, and
	#    since `_process` hard-writes `global_position = _home + drift`, every
	#    sentry in every system snapped to the middle of the map on frame one.
	#    PYX-01's four lane guards, authored 6-20u out to cover the derelict and
	#    apex approaches, were all sitting on the player's spawn point.
	#
	#    Nothing caught it because nothing had ever asserted where an enemy IS.
	var posts: Array = SystemDB.get_system(system_id).get("sentries", [])
	var worst_post := 0.0
	var found_posts := 0
	var deep_seen := 0
	var picket_seen := 0
	var convoy_seen := 0
	for n in get_tree().get_nodes_in_group("hostiles"):
		if not (n is Hostile):
			continue
		# Deep guards are the same class standing somewhere else, and they have
		# their own post assertion below. The count is PRINTED rather than
		# swallowed: a number showing up here when you were not expecting one is
		# the cheap way to notice guards leaking into the charted volume.
		if n.is_in_group("deep_guard"):
			deep_seen += 1
			continue
		# A convoy escort is the same class walking somebody's cargo past the
		# chart. It carries a patrol route, so this clause must come BEFORE
		# the picket one — classified by route it would land in the picket
		# count and break picket_seen == routes for a reason that has nothing
		# to do with the Cordon.
		if n.is_in_group("deep_convoy"):
			convoy_seen += 1
			continue
		# v18. A CORDON PICKET IS NOT AN AUTHORED SENTRY. It is the same class
		# with a route, and being 36u from the nearest sentry post is the whole
		# point of it — this clause is about machines that STAND SOMEWHERE, and
		# a picket does not. Counted and printed rather than swallowed, for the
		# reason the deep-guard count is: a number appearing here when you were
		# not expecting one is the cheap way to notice pickets being built where
		# they should not be (the tutorial and ATTRACT suppress them).
		if not (n as Hostile).patrol.is_empty():
			picket_seen += 1
			continue
		found_posts += 1
		var nearest := INF
		for p_v in posts:
			nearest = minf(nearest, (n as Node3D).global_position.distance_to(p_v))
		worst_post = maxf(worst_post, nearest)
	# The picket count is ASSERTED, not just printed: it must equal the routes
	# this system authored. That turns a line about sentries standing still into
	# one that also catches the Cordon failing to deploy — which would otherwise
	# be invisible, since a missing picket makes every other clause here happier.
	var routes: int = (SystemDB.get_system(system_id).get("patrols", []) as Array).size()
	# THE TETHER, DERIVED RATHER THAN RESTATED. This was a literal 0.6 against a
	# 0.4 drift term (whose two phases differ, so it actually reaches 0.566 —
	# which is what the 0.6 was really covering). v18's playtest round 4 gave an
	# authored sentry a slow ring around its post, so the tolerance is now the
	# beat plus that same drift allowance, read from the class rather than typed
	# here. A post that reads as crewed is still a POST: this line's job did not
	# change, only the radius it has to allow, and it still fails on a sentry
	# that has genuinely left.
	var post_tether: float = Hostile.SENTRY_BEAT_RADIUS + 0.6
	print("[deep] SENTRY POSTS %d sentries, %d authored posts, furthest any of them sits from its post %.2fu (beat %.1f + drift 0.6 = %.1f), %d deep guards / %d pickets / %d convoy escorts excluded (%d routes authored) -> %s" % [
		found_posts, posts.size(), worst_post, Hostile.SENTRY_BEAT_RADIUS, post_tether,
		deep_seen, picket_seen, convoy_seen, routes,
		"PASS" if found_posts == posts.size() and found_posts > 0 and worst_post <= post_tether
			and picket_seen == routes
			else "FAIL"])

	# 1. The bug the player found: the ship could outrun its own camera. Fly a
	#    long way out and confirm the view is still on it.
	var far := Vector3(1700.0, 0.0, 1700.0)
	player.global_position = far
	player.velocity = Vector3.ZERO
	for i in range(240):
		player.global_position = far
		await get_tree().physics_frame
	var ship_r := Vector2(player.global_position.x, player.global_position.z).length()
	var rig_off := Vector2(rig.global_position.x - far.x,
		rig.global_position.z - far.z).length()
	print("[deep] CAMERA ship at %.0fu -> rig offset %.1f (leash %.1f) -> %s" % [
		ship_r, rig_off, rig.pan_leash(),
		"PASS" if rig_off <= rig.pan_leash() + 0.5 else "FAIL"])
	print("[deep] NO CLAMP rig radius %.0fu (the old pan_bound was %.0f) -> %s" % [
		Vector2(rig.global_position.x, rig.global_position.z).length(),
		SystemDB.bounds_of(system_id),
		"PASS" if Vector2(rig.global_position.x,
			rig.global_position.z).length() > SystemDB.bounds_of(system_id) * 4.0 else "FAIL"])

	# 2. The ship must be ON SCREEN, not merely within the leash.
	var cam := get_viewport().get_camera_3d()
	var vp := get_viewport().get_visible_rect()
	var proj := cam.unproject_position(player.global_position)
	print("[deep] ON SCREEN ship projects to (%.0f, %.0f) in %.0fx%.0f -> %s" % [
		proj.x, proj.y, vp.size.x, vp.size.y,
		"PASS" if vp.has_point(proj) else "FAIL"])

	# 3. A hard manual pan still cannot lose the ship.
	rig.global_position = far + Vector3(900.0, 0.0, 900.0)
	await get_tree().physics_frame
	await get_tree().process_frame
	var panned := Vector2(rig.global_position.x - far.x,
		rig.global_position.z - far.z).length()
	print("[deep] PAN LEASH 1270u pan collapsed to %.1f (leash %.1f) -> %s" % [
		panned, rig.pan_leash(),
		"PASS" if panned <= rig.pan_leash() + 0.5 else "FAIL"])

	# 4. The sky must not run out. The per-system starfield is a static box of
	#    ±96..112 around the origin; out here only the wrapping field can be
	#    supplying stars at all.
	var field := deep_space.star_field()
	var nearest := field.nearest_instance_distance(rig.global_position)
	print("[deep] STARFIELD nearest instance %.1fu from a camera %.0fu from origin -> %s" % [
		nearest, Vector2(rig.global_position.x, rig.global_position.z).length(),
		"PASS" if nearest < 40.0 else "FAIL"])

	# 5. Bands are monotonic and land on their authored edges.
	var bands_ok := true
	var line := ""
	for probe in [0.0, 1.0, 159.0, 160.0, 439.0, 440.0, 1099.0, 1100.0, 5000.0]:
		var b := DeepSpace.band_of(probe)
		line += "%.0f=%d " % [probe, b]
	bands_ok = DeepSpace.band_of(0.0) == 0 and DeepSpace.band_of(1.0) == 1 \
		and DeepSpace.band_of(160.0) == 2 and DeepSpace.band_of(440.0) == 3 \
		and DeepSpace.band_of(1100.0) == 4
	print("[deep] BANDS %s-> %s" % [line, "PASS" if bands_ok else "FAIL"])
	print("[deep] BAND NAMES %s" % str(DeepSpace.BAND_NAMES))

	# 6. depth is zero everywhere inside the charted system, which is what makes
	#    every gradient built on it a no-op for existing content.
	player.global_position = Vector3(0, 0, 6)
	await get_tree().physics_frame
	var at_core := deep_depth()
	player.global_position = Vector3(SystemDB.bounds_of(system_id) - 2.0, 0, 0)
	await get_tree().physics_frame
	var at_edge := deep_depth()
	print("[deep] DEPTH core %.1f, inside the edge %.1f (both must be 0) -> %s" % [
		at_core, at_edge,
		"PASS" if at_core == 0.0 and at_edge == 0.0 else "FAIL"])

	# --- C1: deterministic sectors ------------------------------------------

	# 7. A cell is a pure function of (system id, cx, cz). Planning one twice must
	#    give the same answer, and planning two different ones must not — the
	#    second half matters as much as the first, because a generator that always
	#    returns nothing would pass the stability check perfectly.
	var probes := [Vector2i(9, 4), Vector2i(-13, 7), Vector2i(31, -22), Vector2i(-40, -37)]
	var stable := true
	var shapes := {}
	for c_v in probes:
		var c: Vector2i = c_v
		var first := var_to_str(deep_space.plan_cell(c.x, c.y))
		var second := var_to_str(deep_space.plan_cell(c.x, c.y))
		if first != second:
			stable = false
		shapes[first] = true
	print("[deep] SECTOR STABLE %d cells planned twice: identical=%s, %d distinct shapes -> %s" % [
		probes.size(), str(stable), shapes.size(),
		"PASS" if stable and shapes.size() > 1 else "FAIL"])

	# 8. Streaming. Baseline first, with the player at home and nothing generated.
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	await get_tree().process_frame
	var baseline := Obstacles.count()
	var home_cells := deep_space.content_cell_count()

	# Find a cell out in the Reaches that actually holds something, so the
	# assertions below are measuring content rather than measuring empty space.
	var target := Vector2i(0, 0)
	var found := false
	for step in range(9, 60):
		if not (deep_space.plan_cell(step, step)["rocks"] as Array).is_empty():
			target = Vector2i(step, step)
			found = true
			break
	var centre := DeepSpace.cell_centre(target.x, target.y)
	player.global_position = centre
	await get_tree().process_frame
	await get_tree().process_frame
	var live := deep_space.live_cell_count()
	var window_side := DeepSpace.WINDOW * 2 + 1
	var all_near := true
	for k_v in deep_space.live_cells():
		var k: Vector2i = k_v
		if absi(k.x - target.x) > DeepSpace.KEEP or absi(k.y - target.y) > DeepSpace.KEEP:
			all_near = false
	var out_there := Obstacles.count()
	print("[deep] SECTOR STREAMING at cell (%d,%d): %d live (want %d), all within KEEP=%d of the player=%s, obstacles %d -> %d -> %s" % [
		target.x, target.y, live, window_side * window_side, DeepSpace.KEEP,
		str(all_near), baseline, out_there,
		"PASS" if found and live == window_side * window_side and all_near and out_there > baseline else "FAIL"])

	# 9. And the content of the cell the player is standing in must be exactly
	#    what plan_cell said it would be — the plan is the source of truth the
	#    spawner builds from, so this is what keeps the two from drifting apart.
	var plan := deep_space.plan_cell(target.x, target.y)
	var want_spheres: int = (plan["rocks"] as Array).size() \
		+ (0 if (plan["hulk"] as Dictionary).is_empty() else 2)
	var got_spheres := Obstacles.count_owned("deep:%d:%d" % [target.x, target.y])
	print("[deep] SECTOR CONTENT cell (%d,%d) planned %d spheres, registered %d -> %s" % [
		target.x, target.y, want_spheres, got_spheres,
		"PASS" if want_spheres == got_spheres and want_spheres > 0 else "FAIL"])

	# 10. Leaving must give it all back. An owner tag that leaks would grow the
	#     registry every cell the player crosses for the whole session, and every
	#     leaked sphere is an invisible wall left behind in empty space.
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	await get_tree().process_frame
	var returned := Obstacles.count()
	print("[deep] SECTOR CLEANUP obstacles back to %d (baseline %d), content cells %d (home %d) -> %s" % [
		returned, baseline, deep_space.content_cell_count(), home_cells,
		"PASS" if returned == baseline and deep_space.content_cell_count() == home_cells else "FAIL"])

	# 11. Revisiting rerolls nothing: the same cell, entered a second time, has to
	#     come back byte-identical. This is what "zero save data" buys — and what
	#     it costs if it is ever untrue.
	player.global_position = centre
	await get_tree().process_frame
	await get_tree().process_frame
	var again := Obstacles.count_owned("deep:%d:%d" % [target.x, target.y])
	print("[deep] SECTOR REVISIT cell (%d,%d) rebuilt with %d spheres (was %d) -> %s" % [
		target.x, target.y, again, got_spheres,
		"PASS" if again == got_spheres and again > 0 else "FAIL"])

	# --- C2: the danger gradient --------------------------------------------

	# 12. Danger has to RISE, and it has to rise on every axis at once, or the
	#     expanse is just further away rather than worse.
	var rows := ""
	var rising := true
	for b in range(1, DeepSpace.BAND_NAMES.size()):
		rows += "%s hp x%.1f dmg x%.1f packs %d-%d%s | " % [
			DeepSpace.BAND_NAMES[b], DeepSpace.PACK_HP[b], DeepSpace.PACK_DIFFICULTY[b],
			DeepSpace.PACK_MIN[b], DeepSpace.PACK_MAX[b],
			" +escort" if b >= DeepSpace.PACK_ESCORT_FROM else ""]
		if b > 1:
			if DeepSpace.PACK_HP[b] < DeepSpace.PACK_HP[b - 1] \
					or DeepSpace.PACK_DIFFICULTY[b] < DeepSpace.PACK_DIFFICULTY[b - 1] \
					or DeepSpace.PACK_MAX[b] < DeepSpace.PACK_MAX[b - 1]:
				rising = false
	print("[deep] DANGER RISES %s-> %s" % [rows, "PASS" if rising else "FAIL"])

	# 13. And the numbers on the table are the numbers on the ships. Spring one
	#     nest from the Drift and one from the Reaches and weigh what turns up.
	var measured := {}
	for want_band in [2, 3]:
		for n in get_tree().get_nodes_in_group("hostiles"):
			(n as Node3D).queue_free()
		await get_tree().process_frame
		var nest := _deep_probe(want_band, "pack")
		if nest.x == 0x7fffffff:
			continue
		var pack: Dictionary = deep_space.plan_cell(nest.x, nest.y)["pack"]
		player.global_position = pack["pos"]
		await get_tree().process_frame
		await get_tree().process_frame
		var worst := 0.0
		var crew := 0
		var escort := 0
		for n in get_tree().get_nodes_in_group("hostiles"):
			if n is SwarmHostile:
				crew += 1
				worst = maxf(worst, (n as SwarmHostile).hp)
			elif n is Hostile:
				escort += 1
		measured[want_band] = {"hp": worst, "crew": crew, "escort": escort}
		print("[deep]   %s nest at cell (%d,%d): %d ships, toughest %.0f hp, %d escort" % [
			DeepSpace.BAND_NAMES[want_band], nest.x, nest.y, crew, worst, escort])
	var drift_hp: float = float((measured.get(2, {}) as Dictionary).get("hp", 0.0))
	var reach_hp: float = float((measured.get(3, {}) as Dictionary).get("hp", 0.0))
	var reach_escort: int = int((measured.get(3, {}) as Dictionary).get("escort", 0))
	print("[deep] DANGER MEASURED drift %.0f hp -> reaches %.0f hp, reaches escorted=%s -> %s" % [
		drift_hp, reach_hp, str(reach_escort > 0),
		"PASS" if drift_hp > 0.0 and reach_hp > drift_hp and reach_escort > 0 else "FAIL"])

	# 14. Nothing the expanse spawns may follow the player home. A swarm does 7.5
	#     against the ship's 5.75, so this is the only thing that can end a chase
	#     the player chose to walk away from.
	var leashed := SwarmHostile.new()
	leashed.despawn_radius = DeepSpace.HOSTILE_LEASH
	system_root.add_child(leashed)
	leashed.global_position = Vector3(3000, 0, 3000)
	var loyal := SwarmHostile.new()      # despawn_radius 0: an ordinary hostile
	system_root.add_child(loyal)
	loyal.global_position = Vector3(3000, 0, 3000)
	player.global_position = Vector3(0, 0, 0)
	for i in range(6):
		await get_tree().physics_frame
	print("[deep] HOSTILE LEASH at %.0fu out: leashed gone=%s, un-leashed still there=%s -> %s" % [
		DeepSpace.HOSTILE_LEASH, str(not is_instance_valid(leashed)),
		str(is_instance_valid(loyal)),
		"PASS" if not is_instance_valid(leashed) and is_instance_valid(loyal) else "FAIL"])
	if is_instance_valid(loyal):
		loyal.queue_free()

	# 15. Waves stop at the chart edge. Out here `_spawn_swarm_pack`'s bounds-6
	#     clamp would put every pack on the same fixed point behind the player.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	deep_space.set_generation(false)     # measure the wave spawner, nothing else
	player.global_position = Vector3(600, 0, 600)
	_wave_timer = 0.01
	for i in range(20):
		await get_tree().process_frame
	var out_waves := get_tree().get_nodes_in_group("swarm").size()
	player.global_position = PlayerShip.SPAWN_POINT
	_wave_timer = 0.01
	for i in range(20):
		await get_tree().process_frame
	var home_waves := get_tree().get_nodes_in_group("swarm").size()
	print("[deep] WAVES STOP %d spawned at 600u out, %d spawned at home -> %s" % [
		out_waves, home_waves,
		"PASS" if out_waves == 0 and home_waves > 0 else "FAIL"])

	# --- guarded hulks --------------------------------------------------------

	# G1. The distribution, as a PURE function of the roll: no RNG, no spawning,
	#     no flying. Edges printed individually, so a swapped weight moves a
	#     number here rather than hiding inside a percentage.
	var wsum := 0.0
	for w in DeepSpace.GUARD_WEIGHTS:
		wsum += float(w)
	var edges := ""
	for probe in [0.199, 0.200, 0.449, 0.450, 0.749, 0.750, 0.999]:
		edges += "%.3f=%d " % [probe, DeepSpace.guard_count(probe)]
	var yielded := {}
	for i in range(1001):
		yielded[DeepSpace.guard_count(float(i) / 1000.0)] = true
	var yk := yielded.keys()
	yk.sort()
	# The bearings table is what STRUCTURALLY forbids a one-guard post: a count
	# with no bearings has nowhere to stand.
	var supply := ""
	for c_v in DeepSpace.GUARD_COUNTS:
		supply += "%d/" % (DeepSpace.GUARD_BEARINGS[int(c_v)] as Array).size()
	print("[deep] GUARD ODDS %s at %s (sums %.3f), bearings supply %s; edges %s-> %s" % [
		str(DeepSpace.GUARD_COUNTS), "20/25/30/25", wsum, supply, edges,
		"PASS" if is_equal_approx(wsum, 1.0) and str(yk) == str(DeepSpace.GUARD_COUNTS)
			and supply == "0/2/3/4/" else "FAIL"])

	# G2. And the generator actually draws it that way. A pure edge test passes
	#     even if plan_cell feeds it a reused roll.
	var seen_counts := {0: 0, 2: 0, 3: 0, 4: 0}
	var hulks_past := 0
	var skipped_near_station := 0
	for cx in range(-32, 33):
		for cz in range(-32, 33):
			var pl := deep_space.plan_cell(cx, cz)
			var hk: Dictionary = pl.get("hulk", {})
			if hk.is_empty() or deep_space.depth_at(hk["pos"]) < DeepSpace.GUARD_MIN_DEPTH:
				continue
			var st: Dictionary = pl.get("station", {})
			if not st.is_empty() and (hk["pos"] as Vector3).distance_to(st["pos"]) \
					< DeepSpace.STATION_SAFE_RADIUS:
				skipped_near_station += 1
				continue
			hulks_past += 1
			var gd: Dictionary = hk.get("guards", {})
			var n := int(gd.get("count", 0))
			seen_counts[n] = int(seen_counts.get(n, 0)) + 1
	var share_ok := hulks_past > 200
	var share_line := ""
	var want := [0.20, 0.25, 0.30, 0.25]
	for i in range(DeepSpace.GUARD_COUNTS.size()):
		var c := int(DeepSpace.GUARD_COUNTS[i])
		var pct := 100.0 * float(seen_counts[c]) / maxf(float(hulks_past), 1.0)
		share_line += "%d:%.1f%%(%.0f) " % [c, pct, want[i] * 100.0]
		if absf(pct - want[i] * 100.0) > 6.0:
			share_ok = false
	print("[deep] GUARD SHARE %d hulks past depth %.0f (%d skipped beside a station): %s-> %s" % [
		hulks_past, DeepSpace.GUARD_MIN_DEPTH, skipped_near_station, share_line,
		"PASS" if share_ok else "FAIL"])

	# G3. THE CURVE. A guard is scary through count, HP and where it stands, never
	#     alpha — so the deepest guard's shot must stay UNDER the hardest sentry
	#     the chart authors. Computed from SystemDB rather than restated, so the
	#     swarm curve would print 36.4 vs 30.8 -> FAIL instead of merely playing
	#     badly.
	var hardest_charted := 0.0
	for sid in SystemDB.ids():
		var sd := SystemDB.get_system(String(sid))
		if not (sd.get("sentries", []) as Array).is_empty():
			hardest_charted = maxf(hardest_charted,
				Hostile.DAMAGE * float(sd.get("difficulty", 1.0)))
	var curve := ""
	var curve_ok := true
	var prev_hp := 0.0
	var prev_dmg := 0.0
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var d := float(DeepSpace.GUARD_DIFFICULTY[band])
		var hpv := Hostile.BASE_HP * d * float(DeepSpace.GUARD_HP_SCALE[band])
		var dmg := Hostile.DAMAGE * d
		curve += "%s %.0fhp/%.1f | " % [DeepSpace.BAND_NAMES[band], hpv, dmg]
		if hpv <= prev_hp or dmg <= prev_dmg or dmg >= hardest_charted:
			curve_ok = false
		prev_hp = hpv
		prev_dmg = dmg
	print("[deep] GUARD CURVE %shardest charted sentry hits %.1f -> %s" % [
		curve, hardest_charted, "PASS" if curve_ok else "FAIL"])

	# G4. TWO GUNS TYPICAL, THREE AT WORST, NEVER FOUR. The whole hold arithmetic
	#     rests on this, so it is measured against the real approach geometry
	#     rather than derived on paper: Derelict._approach parks the ship at
	#     CRACK_RANGE * 0.78 on a bearing bounded to 32 degrees off the outward
	#     axis by that function's 1.6 weighting.
	var eng_min := 99
	var eng_max := 0
	var nearest_gun := INF
	var probe_rng := RandomNumberGenerator.new()
	probe_rng.seed = 12345
	for count in [2, 3, 4]:
		for bstep in range(8):
			var rot := 45.0 * float(bstep)
			var hull := Vector3(0, 0, 0)
			var posts2 := DeepSpace.guard_posts(hull, rot, count, probe_rng)
			var basis := Basis(Vector3.UP, deg_to_rad(rot))
			var breach: Vector3 = hull + basis * Derelict.BEACON_LOCAL
			breach.y = 0.0
			var outward := (breach - hull)
			outward.y = 0.0
			outward = outward.normalized()
			# Worst realistic case: the 32-degree oblique approach.
			for off in [0.0, 32.0, -32.0]:
				var dir := Basis(Vector3.UP, deg_to_rad(off)) * outward
				var stand: Vector3 = breach + dir * (Derelict.CRACK_RANGE * 0.78)
				var guns := 0
				for pv in posts2:
					var dd: float = (pv as Vector3).distance_to(stand)
					if dd <= Hostile.ENGAGE_RANGE:
						guns += 1
						nearest_gun = minf(nearest_gun, dd)
				eng_min = mini(eng_min, guns)
				eng_max = maxi(eng_max, guns)
	print("[deep] GUARD ENGAGEMENT posts of 2/3/4 over 8 hull bearings x 3 approaches put %d-%d guns on a parked ship (engage %.1f, nearest %.2fu) -> %s" % [
		eng_min, eng_max, Hostile.ENGAGE_RANGE, nearest_gun,
		"PASS" if eng_min >= 2 and eng_max <= 3 else "FAIL"])

	# G5. What the curve MEANS: tankable in the near bands, not in the far ones,
	#     and Bulwark answers all four. Four-sided, so breaking the curve in
	#     either direction flips a word with its number beside it.
	var hold_line := ""
	var hold_ok := true
	var bulwark_worst := 0.0
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var dmg2 := Hostile.DAMAGE * float(DeepSpace.GUARD_DIFFICULTY[band])
		var volleys := ceili((1.8 + 0.2 * float(band)) / Hostile.FIRE_INTERVAL)
		var cost := dmg2 * 3.0 * float(volleys)     # worst case: three guns
		bulwark_worst = maxf(bulwark_worst, cost)
		var tankable := cost < 100.0
		hold_line += "%s %.0f %s | " % [DeepSpace.BAND_NAMES[band], cost,
			"ok" if tankable else "no"]
		if band <= 2 and not tankable:
			hold_ok = false
		if band >= 3 and tankable:
			hold_ok = false
	# "all four" was written when there were four deep bands. The count is derived
	# now, because the sentence is a claim about EVERY band the game has, and a
	# label that says four while measuring six is a comment that has become false.
	print("[deep] GUARD HOLD base 100 shield: %sBulwark 250 survives all %d (worst %.0f)=%s -> %s" % [
		hold_line, DeepSpace.BAND_NAMES.size() - 1, bulwark_worst,
		str(bulwark_worst < 250.0),
		"PASS" if hold_ok and bulwark_worst < 250.0 else "FAIL"])

	# The wave-spawner block above turned generation OFF to measure it in
	# isolation. G6 and G7 need live cells, so it goes back on here and off
	# again at the end, leaving the state the station block expects.
	deep_space.set_generation(true)
	await get_tree().process_frame

	# G6. WHERE THEY ACTUALLY STAND. 18's lesson was that a value no assertion
	#     reads can be wrong for months, and the ones most likely to be wrong are
	#     set by a caller AFTER construction — which is exactly how a guard's
	#     position is set. A new kind of enemy placement that shipped without its
	#     own position assertion would reproduce the sentry bug verbatim.
	var gcell := Vector2i(0, 0)
	var gplan := {}
	for ring in range(2, 30):
		for cx in range(-ring, ring + 1):
			for cz in range(-ring, ring + 1):
				if maxi(absi(cx), absi(cz)) != ring or not gplan.is_empty():
					continue
				var pl := deep_space.plan_cell(cx, cz)
				var hk: Dictionary = pl.get("hulk", {})
				if hk.is_empty() or int((hk.get("guards", {}) as Dictionary).get("count", 0)) < 3:
					continue
				gcell = Vector2i(cx, cz)
				gplan = hk
	var gcfg: Dictionary = gplan.get("guards", {})
	player.global_position = gplan["pos"]
	for i in range(4):
		await get_tree().physics_frame
		await get_tree().process_frame

	# Asked BY CELL: the 5x5 window holds several guarded hulks at once, so a
	# sweep of the deep_guard group would count a neighbour's post as this one's.
	var live_guards: Array = deep_space.guards_at(gcell)
	var worst_plan := 0.0
	for g in live_guards:
		var best := INF
		for pv in gcfg.get("posts", []):
			best = minf(best, (g as Node3D).global_position.distance_to(pv))
		worst_plan = maxf(worst_plan, best)

	# The live breach point, read AFTER a frame: Derelict.breach_point is set in
	# _ready, which fires from add_child, before _spawn_cell assigns the position.
	# Reading it earlier gives the container origin — the same trap as _home.
	var hulk_node: Derelict = null
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is Derelict and (n as Node3D).global_position.distance_to(gplan["pos"]) < 1.0:
			hulk_node = n
	var live_breach := hulk_node.breach_point if hulk_node != null else Vector3.ZERO
	var planned_breach: Vector3 = gplan["pos"] + Basis(Vector3.UP,
		deg_to_rad(float(gplan["rot_y"]))) * Derelict.BEACON_LOCAL
	planned_breach.y = 0.0
	var breach_agree := Vector2(live_breach.x - planned_breach.x,
		live_breach.z - planned_breach.z).length()
	var nearest_breach := INF
	for g in live_guards:
		nearest_breach = minf(nearest_breach,
			Vector2((g as Node3D).global_position.x - live_breach.x,
				(g as Node3D).global_position.z - live_breach.z).length())
	print("[deep] GUARD POSTS %d guards at cell (%d,%d), furthest from its planned post %.2fu, nearest to the live breach point %.2fu (crack range %.1f), plan and node agree to %.2fu -> %s" % [
		live_guards.size(), gcell.x, gcell.y, worst_plan, nearest_breach,
		Derelict.CRACK_RANGE, breach_agree,
		"PASS" if live_guards.size() == int(gcfg["count"]) and worst_plan <= 0.6
			and nearest_breach > Derelict.CRACK_RANGE and breach_agree < 0.5 else "FAIL"])

	# G7. A CLEARED POST STAYS CLEARED. Hostile.LOOT_COUNT is 14 against a swarm's
	#     2 and PACING_LOOP budgets five sentries for a whole loop, so a post that
	#     rebuilt on cell cycle would be an unbounded farm reachable by flying
	#     200u out and back. 4/4 here means it farms forever; 0/0 means flying
	#     away disarms it. Both are visibly wrong.
	var partial_key := gcell
	if live_guards.size() > 1:
		# Attributed to the player: this stands in for a pilot clearing a post,
		# and post_standing is only interesting for a post somebody CLEARED.
		(live_guards[0] as Hostile).take_damage(999999.0, player)
	await get_tree().create_timer(0.6).timeout
	player.global_position = gplan["pos"] + Vector3(900.0, 0.0, 900.0)
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	player.global_position = gplan["pos"]
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	var after_partial := deep_space.post_standing(gcell)

	# Now clear it outright and repeat.
	for n in deep_space.guards_at(gcell):
		if is_instance_valid(n):
			(n as Hostile).take_damage(999999.0, player)
	await get_tree().create_timer(0.6).timeout
	player.global_position = gplan["pos"] + Vector3(900.0, 0.0, 900.0)
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	player.global_position = gplan["pos"]
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	var after_full := deep_space.post_standing(gcell)
	print("[deep] GUARD CLEARED killed 1 of %d, left and returned -> %d standing; killed all, left and returned -> %d standing -> %s" % [
		int(gcfg["count"]), after_partial, after_full,
		"PASS" if after_partial == int(gcfg["count"]) and after_full == 0 else "FAIL"])

	# G8. A CRACKED HULL STAYS CRACKED — G7's assertion for the wreck the post is
	#     standing over. The post remembered and the mast on the stern remembered;
	#     the HULL did not, so the same 200u round trip that G7 forbids for guards
	#     paid full loot, four archeology XP and a hulks_cracked tick every lap.
	#     It shipped because nothing looked: G7 measures the post, CARTTEST
	#     measures the mast, and nothing measured the thing between them.
	var hulk_cell := gcell
	var hulk_pos: Vector3 = (deep_space.plan_cell(hulk_cell.x, hulk_cell.y)["hulk"] as Dictionary)["pos"]
	var hull_before := int(GameState.ledger.get("hulks_cracked", 0))
	var live_hulk: Derelict = null
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is Derelict and (n as Derelict).global_position.distance_to(hulk_pos) < 1.0:
			live_hulk = n
	# Captured NOW. The cell is about to be cycled out, which FREES this node —
	# and a freed reference compares equal to null, so asking `live_hulk != null`
	# after the round trip silently becomes "did it survive the rebuild" instead
	# of "did we find it". RIFTTEST hit this exact trap and says so at its own
	# second_spawned.
	var hulk_found := live_hulk != null
	if live_hulk != null:
		live_hulk.force_breach()
	await get_tree().create_timer(0.6).timeout
	var hull_after_first := int(GameState.ledger.get("hulks_cracked", 0))
	player.global_position = hulk_pos + Vector3(900.0, 0.0, 900.0)
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	player.global_position = hulk_pos
	for i in range(6):
		await get_tree().physics_frame
		await get_tree().process_frame
	# The rebuilt hull must come back already open: out of the crackable group,
	# so nothing can hold it, and never having paid a second time.
	var rebuilt_open := true
	for n in get_tree().get_nodes_in_group("crackable"):
		if n is Derelict and (n as Derelict).global_position.distance_to(hulk_pos) < 1.0:
			rebuilt_open = false
	var hull_after_return := int(GameState.ledger.get("hulks_cracked", 0))
	print("[deep] HULK STAYS CRACKED found=%s breached (%d -> %d), left and returned: still open=%s, ledger %d (must not move) -> %s" % [
		str(hulk_found), hull_before, hull_after_first, str(rebuilt_open),
		hull_after_return,
		"PASS" if hulk_found and hull_after_first == hull_before + 1
			and rebuilt_open and hull_after_return == hull_after_first else "FAIL"])
	deep_space.set_generation(false)
	await get_tree().process_frame



	# --- C3: deep stations ---------------------------------------------------

	# 16. The expanse must not have leaked into the chart. This is the assertion
	#     that keeps market events, the rumour engine and three STATIONTEST sweeps
	#     safe by construction rather than by anybody remembering.
	var leaked := ""
	for pid_v in SystemDB.port_ids():
		if DeepPortDB.is_deep_port(String(pid_v)):
			leaked = String(pid_v)
	print("[deep] CHART UNPOLLUTED %d ports on the chart, none of them deep (%s) -> %s" % [
		SystemDB.port_ids().size(), "clean" if leaked == "" else leaked,
		"PASS" if leaked == "" else "FAIL"])

	# 17. Find a real one out in the world, fly to it, and dock.
	deep_space.set_generation(true)
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	# Stations are rare on purpose, so this is a search. Try each band outward
	# and take the first that has actually built one.
	var berth := Vector2i(0x7fffffff, 0x7fffffff)
	for try_band in [1, 2, 3, 4]:
		berth = _deep_probe(try_band, "station")
		if berth.x != 0x7fffffff:
			break
	var found_station := berth.x != 0x7fffffff
	var st_plan: Dictionary = deep_space.plan_cell(berth.x, berth.y)["station"] if found_station else {}
	var arch_id := String(st_plan.get("archetype", "")) if found_station else ""
	var st_pos: Vector3 = st_plan.get("pos", Vector3.ZERO) if found_station else Vector3.ZERO
	player.global_position = st_pos + Vector3(0, 0, 3.0)
	for i in range(4):
		await get_tree().process_frame
	var deep_port: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		if (n as Port).port_id == arch_id:
			deep_port = n
	print("[deep] DEEP STATION %s built at cell (%d,%d), %.0fu out, depth %.0f, band %s -> %s" % [
		arch_id, berth.x, berth.y, Vector2(st_pos.x, st_pos.z).length(),
		deep_space.depth_at(st_pos), DeepSpace.band_name(deep_space.depth_at(st_pos)),
		"PASS" if found_station and deep_port != null else "FAIL"])

	# 18. And it is a station, not a prop: dockable, with tabs driven by its own
	#     services list, from a def carried on the node rather than in SystemDB.
	var docked_ok := false
	var tabs: Array = []
	if deep_port != null:
		player.global_position = deep_port.dock_point
		await get_tree().process_frame
		request_dock(deep_port)
		await get_tree().process_frame
		docked_ok = docked_port == deep_port and port_panel.is_open
		tabs = port_panel.services()
	print("[deep] DEEP DOCK clamped on=%s, tabs %s (from Port.def, not SystemDB) -> %s" % [
		str(docked_ok), str(tabs),
		"PASS" if docked_ok and not tabs.is_empty() else "FAIL"])

	# 19. Restricted goods trade freely out here — nobody asks what is in the
	#     crate, and that is the reward for the trip. On the chart, contraband
	#     still has exactly two buyers.
	var deep_takes_banned := CommodityDB.trades_at("contraband", arch_id)
	var chart_banned := []
	for pid_v in SystemDB.port_ids():
		if CommodityDB.trades_at("contraband", String(pid_v)):
			chart_banned.append(String(pid_v))
	print("[deep] DEEP RESTRICTIONS contraband trades at %s=%s, chart buyers still %s -> %s" % [
		arch_id, str(deep_takes_banned), str(chart_banned),
		"PASS" if deep_takes_banned and chart_banned.size() == 2 else "FAIL"])

	# 20. It has to PAY better, or there is no reason to have come. The Haven and
	#     the Watch fence contraband at 1.45 against the best charted 1.25.
	var best_chart := 1.0
	for pid_v in SystemDB.port_ids():
		best_chart = maxf(best_chart,
			Market.fence_bonus(SystemDB.port_def_by_id(String(pid_v)), "contraband"))
	var best_deep := 1.0
	var best_deep_name := ""
	for a_v in DeepPortDB.ARCHETYPES:
		var a: Dictionary = a_v
		var f := Market.fence_bonus(a, "contraband")
		if f > best_deep:
			best_deep = f
			best_deep_name = String(a["name"])
	print("[deep] DEEP PAYS MORE best contraband fence: chart %.2fx vs %s %.2fx -> %s" % [
		best_chart, best_deep_name, best_deep,
		"PASS" if best_deep > best_chart else "FAIL"])

	# 21. Nothing may be camped on the dock ring, and nothing may be parked in the
	#     approach lane. A station you cannot reach is worse than no station.
	#     Swept ACROSS cells, not within them. A cell's keep-out test can only see
	#     its own contents, so the case that actually needed proving is a nest
	#     rolled in the cell next door — which the insets in DeepSpace are sized
	#     to make impossible, and which a per-cell check would never have looked
	#     at. Widened to a block far larger than the streaming window so this is a
	#     statement about the generator rather than about one visit.
	var stations := []
	var nests := []
	var boulders := []
	var scanned := 0
	for cz in range(-16, 17):
		for cx in range(-16, 17):
			var pl := deep_space.plan_cell(cx, cz)
			scanned += 1
			if not (pl["station"] as Dictionary).is_empty():
				stations.append((pl["station"] as Dictionary)["pos"])
			if not (pl["pack"] as Dictionary).is_empty():
				nests.append((pl["pack"] as Dictionary)["pos"])
			for r_v in pl["rocks"]:
				boulders.append(r_v["pos"])
	var closest_nest := INF
	var closest_rock := INF
	for sp_v in stations:
		var sp: Vector3 = sp_v
		for np_v in nests:
			closest_nest = minf(closest_nest, sp.distance_to(np_v))
		for bp_v in boulders:
			closest_rock = minf(closest_rock, sp.distance_to(bp_v))
	print("[deep] DEEP APPROACH %d cells: %d stations, %d nests, %d rocks; nearest nest %.1fu (want >= %.0f), nearest rock %.1fu (want >= %.0f) -> %s" % [
		scanned, stations.size(), nests.size(), boulders.size(),
		closest_nest, DeepSpace.STATION_SAFE_RADIUS,
		closest_rock, DeepSpace.STATION_CLEARANCE,
		"PASS" if stations.size() > 0 and nests.size() > 0 \
			and closest_nest >= DeepSpace.STATION_SAFE_RADIUS \
			and closest_rock >= DeepSpace.STATION_CLEARANCE else "FAIL"])
	undock()

	# --- B5/B6: wayfinding and the way back ----------------------------------

	deep_space.set_generation(false)
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	var edge_radius := SystemDB.bounds_of(system_id)

	# 22. The readout has to answer "where am I" out where nothing else does.
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var tag_home := hud.system_tag_text()
	player.global_position = Vector3(edge_radius + 300.0, 0, 0)
	await get_tree().process_frame
	var tag_out := hud.system_tag_text()
	# DERIVED, NOT PINNED. This used to look for the literal "THE DRIFT", which
	# was safe only while pyx01 was forbidden a deep block -- it now names band 2
	# THE ORRERY DRIFT, and the substring does not match. The clause was never
	# about the copy: it is that the readout names the band you are standing in,
	# so it asks SystemDB what that is and keeps working for any system.
	var want_band2 := SystemDB.band_name_of(system_id, 2, DeepSpace.BAND_NAMES[2])
	print("[deep] SYSTEM TAG inside '%s' / outside '%s' (band 2 here is '%s') -> %s" % [
		tag_home, tag_out, want_band2,
		"PASS" if not tag_home.contains("OUT") and tag_out.contains("OUT")
			and tag_out.contains(want_band2) else "FAIL"])

	# 23. The home marker: present outside, absent inside, and NEVER dropped by
	#     the 12-marker cap. That last clause is the whole point of the tier —
	#     out here with a full board, the one arrow you cannot afford to lose is
	#     the one pointing at the system you came from.
	var radar := hud.radar()
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	await get_tree().process_frame
	var home_inside := hud.has_home_marker()

	player.global_position = Vector3(edge_radius + 500.0, 0, 0)
	await get_tree().process_frame
	await get_tree().process_frame
	var home_outside := hud.has_home_marker()

	# Now bury it: thirty contacts, more than twice the cap.
	for i in range(30):
		var filler := SwarmHostile.new()
		filler.hp_scale = 40.0
		system_root.add_child(filler)
		filler.global_position = player.global_position + Vector3(
			cos(TAU * float(i) / 30.0), 0, sin(TAU * float(i) / 30.0)) * 90.0
		filler.dock_at(filler.global_position)     # pinned, so nothing drifts
	await get_tree().process_frame
	await get_tree().process_frame
	var home_buried := hud.has_home_marker()
	var shown := radar.markers.size()
	print("[deep] HOME MARKER inside=%s outside=%s survives %d contacts at the %d cap=%s -> %s" % [
		str(home_inside), str(home_outside), 30, HUD.RadarLayer.MAX_MARKERS,
		str(home_buried),
		"PASS" if not home_inside and home_outside and home_buried
			and shown <= HUD.RadarLayer.MAX_MARKERS else "FAIL"])

	# 24. Marker alpha stopped saturating. At 60u the old falloff was already
	#     pinned at its 0.3 floor, so 61u and 6000u drew identically — which out
	#     here is every contact on the board.
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var span_home := radar.alpha_span
	player.global_position = Vector3(edge_radius + 500.0, 0, 0)
	await get_tree().process_frame
	var span_deep := radar.alpha_span
	print("[deep] MARKER ALPHA falloff span %.0fu in system (unchanged) -> %.0fu in %s -> %s" % [
		span_home, span_deep, DeepSpace.band_name(deep_depth()),
		"PASS" if is_equal_approx(span_home, HUD.RadarLayer.ALPHA_SPAN)
			and span_deep > span_home else "FAIL"])
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame

	# 25. Recall. The ship comes home; the WORLD does not move. If SystemRoot were
	#     rebuilt this would reset the apex to full, respawn the garrison and
	#     delete loot still in flight — for a move that never leaves the system.
	var far_post := Vector3(edge_radius + 900.0, 0, 0)
	player.global_position = far_post
	await get_tree().process_frame
	var root_before := system_root.get_instance_id()
	# A specific cube, held by reference: "the world survived" is a claim about
	# this object still existing, not about a count that could coincide. Dropped
	# where the player IS, not at the origin — a cube waiting at the spawn point
	# is inside the tractor radius the moment the recall lands, and "collected"
	# would read here as "destroyed".
	# Far from BOTH the deep post and the spawn point. Loose cubes home on the
	# player from any distance after SEEK_ALWAYS_AFTER so no salvage is ever
	# stranded — drop one at arm's length and the tractor eats it before the
	# recall finishes, which would read here as "destroyed by the teardown".
	var in_flight := spawn_loot(system_root, Vector3(0, 0, -(edge_radius + 320.0)))
	await get_tree().process_frame
	var offered := can_recall()
	recall_to_system()
	# The full beat list is CHARGE + STREAK + ARRIVE = 2.45s of awaited timers,
	# so this has to be a wall-clock wait rather than a frame count.
	await get_tree().create_timer(WARP_CHARGE + WARP_STREAK + WARP_ARRIVE + 0.6).timeout
	var home_dist := player.global_position.distance_to(PlayerShip.SPAWN_POINT)
	print("[deep] RECALL offered at %.0fu out=%s -> ship %.1fu from spawn, SystemRoot same=%s, loot in flight survived=%s -> %s" % [
		edge_radius + 900.0, str(offered), home_dist,
		str(system_root.get_instance_id() == root_before),
		str(is_instance_valid(in_flight)),
		"PASS" if offered and home_dist < 1.0 \
			and system_root.get_instance_id() == root_before \
			and is_instance_valid(in_flight) else "FAIL"])
	if is_instance_valid(in_flight):
		in_flight.queue_free()

	# 26. And it is refused where docking is refused. Breaking off an apex by
	#     tapping a console would be an exit, not a decision.
	player.global_position = Vector3(edge_radius + 900.0, 0, 0)
	await get_tree().process_frame
	var free_out := can_recall()
	_set_boss_active(true)
	var during_boss := can_recall()
	_set_boss_active(false)
	warping = true
	var during_warp := can_recall()
	warping = false
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var while_home := can_recall()
	print("[deep] RECALL REFUSED out=%s boss=%s warping=%s inside the system=%s -> %s" % [
		str(free_out), str(during_boss), str(during_warp), str(while_home),
		"PASS" if free_out and not during_boss and not during_warp and not while_home
			else "FAIL"])

	# --- return fire, traps, the apex lock and the beacons -------------------

	# 27. The ship shoots back on its own while under fire, WITHOUT flying at what
	#     shot it — and an explicit order takes the guns straight back.
	player.global_position = Vector3(0, 0, 6)
	player.clear_target()
	player.velocity = Vector3.ZERO
	await get_tree().process_frame
	var idle_gun := player.gun_target()          # nothing has hit us: stand down

	var biter := SwarmHostile.new()
	biter.hp_scale = 60.0                        # survives long enough to measure
	system_root.add_child(biter)
	biter.global_position = player.global_position + Vector3(2.5, 0, 0)
	biter.dock_at(biter.global_position)         # pinned, so distance stays honest
	var other := SwarmHostile.new()
	other.hp_scale = 60.0
	system_root.add_child(other)
	other.global_position = player.global_position + Vector3(0, 0, 3.0)
	other.dock_at(other.global_position)
	await get_tree().process_frame

	# Somebody shoots us; the guns must find THEM, not merely the nearest thing.
	var stood_at := player.global_position
	player.take_hit(1.0, other)
	for i in range(4):
		await get_tree().physics_frame
	var answered: Node3D = player.gun_target()
	var drifted := player.global_position.distance_to(stood_at)
	print("[deep] RETURN FIRE idle target=%s, under fire answers the attacker=%s, ship moved %.2fu (must be ~0) -> %s" % [
		"none" if idle_gun == null else "something", str(answered == other), drifted,
		"PASS" if idle_gun == null and answered == other and drifted < 0.5 else "FAIL"])

	# An explicit order wins, always and immediately.
	player.command_attack(biter)
	await get_tree().physics_frame
	var obeyed := player.gun_target() == biter and player.auto_target == null
	player.clear_target()
	print("[deep] RETURN FIRE OVERRIDE explicit order retakes the guns=%s -> %s" % [
		str(obeyed), "PASS" if obeyed else "FAIL"])
	biter.queue_free()
	other.queue_free()
	await get_tree().process_frame

	# 28. Rigged hulks: seeded like everything else, riskier and richer with
	#     depth, and carrying a bigger ambush further out.
	var trap_rows := ""
	var trap_rising := true
	for b in range(1, DeepSpace.BAND_NAMES.size()):
		trap_rows += "%s %d%% emp %.1fs pack %d-%d%s | " % [
			DeepSpace.BAND_NAMES[b], int(round(DeepSpace.TRAP_CHANCE[b] * 100.0)),
			DeepSpace.TRAP_EMP[b], DeepSpace.TRAP_PACK_MIN[b], DeepSpace.TRAP_PACK_MAX[b],
			" +escort" if b >= DeepSpace.TRAP_ESCORT_FROM else ""]
		if b > 1 and (DeepSpace.TRAP_CHANCE[b] < DeepSpace.TRAP_CHANCE[b - 1]
				or DeepSpace.TRAP_EMP[b] < DeepSpace.TRAP_EMP[b - 1]
				or DeepSpace.TRAP_PACK_MAX[b] < DeepSpace.TRAP_PACK_MAX[b - 1]):
			trap_rising = false
	print("[deep] TRAPS RISE %s-> %s" % [trap_rows, "PASS" if trap_rising else "FAIL"])

	# Deterministic, and the bet actually pays: a rigged wreck carries more.
	var rigged := Vector2i(0x7fffffff, 0x7fffffff)
	var clean := Vector2i(0x7fffffff, 0x7fffffff)
	for ring in range(1, 26):
		for cz in range(-ring, ring + 1):
			for cx in range(-ring, ring + 1):
				if maxi(absi(cx), absi(cz)) != ring:
					continue
				var h: Dictionary = deep_space.plan_cell(cx, cz)["hulk"]
				if h.is_empty():
					continue
				if not (h["trap"] as Dictionary).is_empty():
					if rigged.x == 0x7fffffff:
						rigged = Vector2i(cx, cz)
				elif clean.x == 0x7fffffff:
					clean = Vector2i(cx, cz)
	var stable_trap := false
	var pays_more := false
	if rigged.x != 0x7fffffff:
		stable_trap = var_to_str(deep_space.plan_cell(rigged.x, rigged.y)["hulk"]) \
			== var_to_str(deep_space.plan_cell(rigged.x, rigged.y)["hulk"])
		if clean.x != 0x7fffffff:
			var rl := int((deep_space.plan_cell(rigged.x, rigged.y)["hulk"] as Dictionary)["loot"])
			var cl := int((deep_space.plan_cell(clean.x, clean.y)["hulk"] as Dictionary)["loot"])
			var rb := int(deep_space.plan_cell(rigged.x, rigged.y)["band"])
			var cb := int(deep_space.plan_cell(clean.x, clean.y)["band"])
			# Compare like with like by normalising the band's own loot curve out.
			var band_loot := [1.0, 1.15, 1.6, 2.2, 2.9]
			pays_more = (float(rl) / band_loot[rb]) > (float(cl) / band_loot[cb]) * 1.2
	print("[deep] TRAP SEEDED rigged hulk at (%d,%d) stable=%s, pays more than a clean one=%s -> %s" % [
		rigged.x, rigged.y, str(stable_trap), str(pays_more),
		"PASS" if stable_trap and pays_more else "FAIL"])

	# 29. And springing one actually locks the ship out and brings company.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	var trap_cfg := {"emp": 1.5, "count": 5, "hp_scale": 1.6, "difficulty": 1.4,
		"tint": Palette.DEEP_DRIFT, "drop": "cores", "escort": true, "band": 3}
	player.global_position = Vector3(edge_radius + 400.0, 0, 0)
	await get_tree().process_frame
	spring_trap(player.global_position, trap_cfg)
	await get_tree().physics_frame
	var stunned := player.is_emp_stunned()
	player.command_move(player.global_position + Vector3(30, 0, 0))
	await get_tree().physics_frame
	var moved_while_stunned := player.has_move_target
	await get_tree().create_timer(1.0).timeout
	var ambush := get_tree().get_nodes_in_group("hostiles").size()
	await get_tree().create_timer(1.2).timeout
	var recovered := not player.is_emp_stunned()
	print("[deep] TRAP SPRUNG emp locked the ship=%s, orders refused while stunned=%s, %d contacts inbound, recovered=%s -> %s" % [
		str(stunned), str(not moved_while_stunned), ambush, str(recovered),
		"PASS" if stunned and not moved_while_stunned and ambush >= 6 and recovered
			else "FAIL"])
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame

	# 30. v15. THE LOCK HOLDS AT DEPTH — the exact opposite of what this assertion
	#     used to demand, and the inversion is the point of the stage.
	#
	#     It used to check that crossing the chart edge mid-fight BROKE THE
	#     ENCOUNTER OFF. Correct for an engine parked near the origin: a fight at
	#     depth was necessarily a fight with nothing in it. The engine now LIVES
	#     at depth, so the old rule would refuse the only fight the game has.
	#     Depth is not a boundary any more. Distance from the ENGINE is, and
	#     PYXIS_HUNTTEST's THE LEASH ENDS THE FIGHT owns that.
	#
	#     Two of the old clauses were passing on nothing, and both go with the
	#     rule they belonged to. `freed` had stopped measuring the chart edge at
	#     all — post-relocation the ship was ~300u from the lair at BOTH of its
	#     positions, so what broke the fight off was the leash, and the assertion
	#     was reading the new mechanic while printing the old one's name. And
	#     `stayed_out` compared `player.global_position` against a copy of
	#     `player.global_position` taken one line earlier: it asserted 0.0 < 1.0,
	#     every run, since the day it was written.
	#
	#     Driven by flying rather than by _set_boss_active: the wake is a
	#     proximity poll now, so arriving IS the trigger and there is no longer
	#     any reason to fake the state it produces.
	var engine := _find_apex()
	player.global_position = engine.global_position + Vector3(0, 0, 9.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.2).timeout
	var fight_depth := deep_depth()
	var locked_in := boss_active and not hud.chart_button.enabled and not can_recall()
	# Further out, deeper still, and deliberately INSIDE the leash. Under the old
	# rule this move was what ended the encounter; under the new one it must not.
	player.global_position = engine.global_position \
		+ Vector3(0, 0, ApexBoss.LEASH_RANGE - 20.0)
	await get_tree().process_frame
	await get_tree().process_frame
	var held := boss_active
	print("[deep] THE LOCK HOLDS AT DEPTH engaged %.0fu past the chart edge, panels locked=%s; still engaged %.0fu further out=%s -> %s" % [
		fight_depth, str(locked_in), ApexBoss.LEASH_RANGE - 20.0, str(held),
		"PASS" if fight_depth > 0.0 and locked_in and held else "FAIL"])
	disengage_apex(false)
	_apex_wake_timer = -1.0

	# 31. The beacons. One per band, outward only, and the first one is the
	#     survey authority disowning you — which is what replaced the wall.
	_broadcast_band = 0
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var quiet_at_home := hud.broadcast_text() == ""
	player.global_position = Vector3(edge_radius + 60.0, 0, 0)
	await get_tree().process_frame
	var first := hud.broadcast_text()
	# Coming back in must not replay it.
	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var band_after_return := _broadcast_band
	print("[deep] BEACONS silent inside=%s, first crossing says '%s...', no replay on the way home=%s -> %s" % [
		str(quiet_at_home), first.substr(0, 44), str(band_after_return == 1),
		"PASS" if quiet_at_home and first != ""
			and first == String(DeepSpace.broadcast_for(
				1, GameState.commissioned, system_id).get("body", ""))
			and band_after_return == 1 else "FAIL"])

	# 32. Deep station ids stay ARCHETYPE-scoped. If they ever became per-cell,
	#     every station traded at would add a permanent market-pressure key to the
	#     save, and "the expanse costs zero bytes" would quietly stop being true.
	var seen_ids := {}
	for cz in range(-14, 15):
		for cx in range(-14, 15):
			var st3: Dictionary = deep_space.plan_cell(cx, cz)["station"]
			if not st3.is_empty():
				seen_ids[String(st3["archetype"])] = true
	var all_known := true
	for id_v in seen_ids:
		if DeepPortDB.by_id(String(id_v)).is_empty():
			all_known = false
	print("[deep] STATION IDS %d distinct across 841 cells, cap is %d archetypes, all known=%s -> %s" % [
		seen_ids.size(), DeepPortDB.count(), str(all_known),
		"PASS" if seen_ids.size() <= DeepPortDB.count() and all_known else "FAIL"])

	# 15. THE PACK REMEMBERS ITS BAND. Regression for a bug that hid behind a
	#     green suite: plan_cell's pack dict carried no "band" key, _spring
	#     read `pack.get("band", 0)`, and every nest in the Reaches and the
	#     Quiet flew the HOST ENGINE's flag with a 140u leash. THE DEEP
	#     BELONGS TO THE UNKNOWNS stayed green throughout because it asserts
	#     flag_for_band() — the rule — and never looked at a spawned ship.
	#     So this one asserts the NODES, through _spring itself — the function
	#     that read the missing key — with generation OFF and the sky cleared,
	#     because the first version swept through the real trigger and counted
	#     twelve members: the nest plus the guard posts of every neighbouring
	#     cell the teleport streamed in, host-flagged and unleashed, which is
	#     §54's crowd problem wearing a new hat. THE DEEP IS TRAVELLED drives
	#     the real trigger end to end; THIS one isolates the exact function
	#     the bug lived in.
	for n_15 in get_tree().get_nodes_in_group("hostiles"):
		(n_15 as Node3D).queue_free()
	await get_tree().process_frame
	var band_key := _deep_probe(3, "pack")
	var band_plan := deep_space.plan_cell(band_key.x, band_key.y)
	var band_static: int = int((band_plan["pack"] as Dictionary).get("band", -1))
	deep_space._sprung.erase(band_key)
	deep_space._spring(band_key, (band_plan["pack"] as Dictionary).duplicate(true))
	await get_tree().process_frame
	var nest_n := 0
	var nest_flag_ok := true
	var nest_leash_ok := true
	for n_15b in get_tree().get_nodes_in_group("hostiles"):
		var hn := n_15b as Node3D
		if not is_instance_valid(hn) or hn.is_queued_for_deletion():
			continue
		nest_n += 1
		if String(hn.faction) != "unknown_a":
			nest_flag_ok = false
		if float(hn.despawn_radius) != 0.0:
			nest_leash_ok = false
	print("[deep] THE PACK REMEMBERS ITS BAND plan band=%d (want 3), %d members sprung, all unknown_a=%s, all unleashed=%s -> %s" % [
		band_static, nest_n, str(nest_flag_ok), str(nest_leash_ok),
		"PASS" if band_static == 3 and nest_n > 0 and nest_flag_ok and nest_leash_ok else "FAIL"])

	# 14b. EVERY CELL ANSWERS EVERY QUESTION. built_plan indexes plan["convoy"],
	#      plan["pack"], plan["hulk"] and plan["station"] with no .get -- they
	#      are keep-out filters, and a filter that tolerated a missing key would
	#      silently stop filtering. So every path out of plan_cell must carry
	#      every content key, including the band-0 early return.
	#
	#      This shipped broken and no assertion saw it, because band 0 means
	#      INSIDE the charted volume and every probe in this suite skips those
	#      cells before it indexes anything. The arithmetic that made it real:
	#      cell centres sit at (64i+32, 64k+32), so the four innermost are
	#      45.25u out, and PYX-02's bounds are 48.0 -- putting all four at
	#      depth -2.75. pyx01 (40.0) and pyx03 (44.0) leave them at band 1.
	#      One system, one band, and it errored on arrival for the whole
	#      charted volume.
	#
	#      Swept over ALL THREE systems and both signs of the boundary rather
	#      than over the one that broke.
	var key_rows := ""
	var keys_ok := true
	var key_count := 0
	for sys_v in ["pyx01", "pyx02", "pyx03"]:
		var sid := String(sys_v)
		var probe := DeepSpace.new()
		# GENERATION OFF BEFORE IT ENTERS THE TREE. A DeepSpace defaults to
		# generating=true and streams from its first _process, so a probe left
		# live would arm and spring the SAME cells the real one owns -- and the
		# first version of this assertion did exactly that, doubling the member
		# count THE DEEP IS TRAVELLED measures two sections later.
		probe.generating = false
		add_child(probe)
		probe.configure(SystemDB.get_system(sid), sid)
		# THE QUESTIONS ARE ASKED, NOT WRITTEN DOWN. This list used to be seven
		# literals, and a hand-written list agrees with whatever it is given:
		# `landmark`, `seams` and `hulk2` were appended to plan_cell's band>0
		# path across three horizons, none of them reached the early return, and
		# this assertion stayed green through all of it while PYX-02's four
		# band-0 cells threw on `hulk2` from v20. A deep cell is the only thing
		# that knows the real key set, so it is what gets asked. (64,64) is
		# ~5838u out -- band 6 in every system, and every content key on that
		# path is set unconditionally before it is filled.
		var want_keys: Array = (probe.plan_cell(64, 64) as Dictionary).keys()
		key_count = want_keys.size()
		var band0 := 0
		var missing := ""
		for cz_k in range(-3, 4):
			for cx_k in range(-3, 4):
				var pl := probe.plan_cell(cx_k, cz_k)
				if int(pl["band"]) == 0:
					band0 += 1
				for w_v in want_keys:
					if not pl.has(String(w_v)):
						keys_ok = false
						if missing == "":
							missing = "%s@(%d,%d)" % [String(w_v), cx_k, cz_k]
		key_rows += "%s:%dband0%s " % [sid, band0, "" if missing == "" else "/MISSING " + missing]
		# free(), not queue_free(): deferred deletion still runs _process on the
		# way out, which is the other half of the same bug.
		probe.free()
	print("[deep] EVERY CELL ANSWERS EVERY QUESTION %s all %d content keys present on every path -> %s" % [
		key_rows, key_count, "PASS" if keys_ok else "FAIL"])
	# By hand, and immediately: these have NO leash — left alive they chase
	# the harness through every assertion that follows.
	for n_15c in get_tree().get_nodes_in_group("hostiles"):
		(n_15c as Node).free()

	# 16. THE DEEP IS TRAVELLED. The convoy content, driven end to end through
	#     the real machinery: plan (twice — the salted stream must produce the
	#     same convoy both times, or unrelated content is leaking into its
	#     draws), then stand on the anchor and let the real trigger spring it,
	#     then read faction, paint, leash, beat and march off every member.
	var trav_key := _deep_probe(2, "convoy")
	var trav_a: Dictionary = deep_space.plan_cell(trav_key.x, trav_key.y)["convoy"]
	var trav_b: Dictionary = deep_space.plan_cell(trav_key.x, trav_key.y)["convoy"]
	var trav_same: bool = str(trav_a) == str(trav_b) and not trav_a.is_empty()
	deep_space._sprung.erase(trav_key)
	# TELEPORT FIRST, THEN GENERATION ON. The trap section left it off, and
	# the order matters: enabling it with the player parked on the last
	# section's site would spring whatever is armed THERE into this census.
	player.global_position = trav_a.get("pos", Vector3.ZERO)
	deep_space.set_generation(true)
	await get_tree().process_frame
	await get_tree().process_frame
	var trav_want := int(trav_a["escorts"]) + int(trav_a["darts"])
	var trav_n := 0
	var trav_ok := true
	var trav_beat := 0
	var trav_march := 0
	for c_16 in get_tree().get_nodes_in_group("deep_convoy"):
		var cn := c_16 as Node3D
		if not is_instance_valid(cn):
			continue
		trav_n += 1
		if String(cn.faction) != String(trav_a["faction"]) \
				or cn.tint != FactionDB.tint_of(String(trav_a["faction"])) \
				or float(cn.despawn_radius) != DeepSpace.HOSTILE_LEASH:
			trav_ok = false
		if cn is Hostile and (cn as Hostile).patrol.size() == 2:
			trav_beat += 1
		if cn is SwarmHostile and (cn as SwarmHostile).march_to != Vector3.ZERO:
			trav_march += 1
	print("[deep] THE DEEP IS TRAVELLED cell %s plans same twice=%s, %d/%d members, flag/paint/leash all correct=%s, escorts on the beat=%d/%d, darts marching=%d/%d -> %s" % [
		str(trav_key), str(trav_same), trav_n, trav_want, str(trav_ok),
		trav_beat, int(trav_a["escorts"]), trav_march, int(trav_a["darts"]),
		"PASS" if trav_same and trav_n == trav_want and trav_ok
			and trav_beat == int(trav_a["escorts"])
			and trav_march == int(trav_a["darts"]) else "FAIL"])

	# 17. THE DEEP BUDGET HOLDS. Both halves in one print. Static: the
	#     worst-case window this feature can now produce — a full band-3
	#     convoy, a full Reaches nest with escort, a full guard post — from
	#     the constants, not from a lucky spawn. Dynamic: the live census
	#     with a real convoy in the sky (sprung in 16, the sky cleared in 15)
	#     stays under the same cap.
	var deep_ship_budget := 20
	var worst_static := (2 + 5) + (int(DeepSpace.PACK_MAX[3]) + 1) + 4
	var census_now := 0
	for n_17 in get_tree().get_nodes_in_group("hostiles"):
		if is_instance_valid(n_17) and not (n_17 as Node).is_queued_for_deletion():
			census_now += 1
	print("[deep] THE DEEP BUDGET HOLDS worst-case window %d vs budget %d, live census with a convoy sprung %d -> %s" % [
		worst_static, deep_ship_budget, census_now,
		"PASS" if worst_static <= deep_ship_budget and census_now <= deep_ship_budget else "FAIL"])
	# Cleanup doubles as the leash measurement: walk the player far past
	# HOSTILE_LEASH and every convoy member must give itself up. The count is
	# taken from the deep_convoy group so whatever the Quiet arms around the
	# far point cannot pollute it.
	player.global_position = Vector3(4000.0, 0.0, 4000.0)
	await get_tree().create_timer(0.6).timeout
	var trav_left := 0
	for c_17 in get_tree().get_nodes_in_group("deep_convoy"):
		if is_instance_valid(c_17):
			trav_left += 1
	print("[deep] AND THE LEASH CLEANS IT UP convoy members left after the player leaves: %d (must be 0) -> %s" % [
		trav_left, "PASS" if trav_left == 0 else "FAIL"])
	get_tree().quit()


# --- apex identity harness ----------------------------------------------------

func _run_apex_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	set_deep_generation(false)
	_wave_timer = 1.0e9

	# 1. Identity is data, and it is actually distinct: three names, three
	#    armaments, no repeats.
	var names := {}
	var attacks := {}
	for sys in SystemDB.ids():
		var apex: Dictionary = SystemDB.get_system(String(sys)).get("apex", {})
		names[String(apex.get("name", ""))] = true
		attacks[String(apex.get("attack", ""))] = true
		print("[apex] %s -> %s (%s)" % [sys, String(apex.get("name", "?")),
			String(apex.get("attack", "?"))])
	print("[apex] UNIQUE %d names, %d armaments across %d systems -> %s" % [
		names.size(), attacks.size(), SystemDB.ids().size(),
		"PASS" if names.size() == 3 and attacks.size() == 3 else "FAIL"])

	# 2. Per system: the boss carries its data name, and the HUB ITSELF hurts a
	#    player who parks in range — with every probe deleted the moment it
	#    vents, so nothing but the boss's own armament can be the source.
	for sys in ["pyx01", "pyx02", "pyx03"]:
		GameState.mark_breached(sys)
		_load_system(sys)
		await get_tree().create_timer(0.4).timeout
		var boss := _find_apex()
		# v15. PARK AT THE ENGINE BEFORE ARMING THE WAKE, and this fixed a defect
		# older than the relocation.
		#
		# The wake is a proximity poll now, so a ship still standing where the last
		# system left it refuses it and the fight starts partway through the sample
		# — or never. But moving the park HERE also repairs the tether measurement
		# below, which has been passing on nothing since the day it was written:
		# the grav_tether branch only ever READ `park.distance_to(player)` and
		# never assigned it, so `displaced` was the distance from the engine to
		# wherever the ship already happened to be. It cleared its 1.5u bar on the
		# first frame without the tether doing anything at all. The relocation is
		# what made it visible — the same clause started reporting a 1,143u drag,
		# which is a number no armament in this game could produce.
		var park: Vector3 = boss.global_position + Vector3(0, 0, 4.5)
		player.global_position = park
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		_apex_wake_timer = 0.2
		await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
		print("[apex] %s NAME '%s' matches data -> %s" % [sys, boss.boss_name,
			"PASS" if boss.boss_name == String(
				(SystemDB.get_system(sys).get("apex", {}) as Dictionary).get("name", "")) else "FAIL"])

		player.invulnerable = false
		player.shield = player.shield_max
		var taken := 0.0
		var prev: float = player.shield
		var displaced := 0.0
		var tether := boss.attack_kind == "grav_tether"
		if tether:
			# Re-staged FARTHER OUT, on top of the wake park above rather than
			# instead of it. That park is at 4.5u because it has a different job
			# — it is what puts the ship inside the proximity poll's reach so the
			# engine wakes at all — and it must stay where it is, before the
			# timer is armed.
			#
			# 4.5u is the wrong mark for THIS measurement, though. _tether_pull
			# stops pulling inside HUB_RADIUS + 1.0 (3.2u), so a ship staged at
			# 4.5u has just 1.3u of room to be dragged through before the
			# armament lets go — less than the bar below, which means a perfectly
			# working tether would still have failed it. 9.0u sits comfortably
			# inside the armament's 13.0u range and leaves 5.8u of travel.
			park = boss.global_position + Vector3(0, 0, 9.0)
			player.global_position = park
			player.velocity = Vector3.ZERO
			player.has_move_target = false
			player.clear_target()
			await get_tree().physics_frame
		# Measured as CLOSURE on the hub rather than distance from the park point,
		# so the number means what the line below prints: dragged TOWARD the hub.
		# Distance-from-park counts a shove in any direction, including outward.
		var start_gap: float = park.distance_to(boss.global_position)
		for i in range(60 * 14):
			# Probes die on sight, so the only remaining sources are the sweep
			# arm (parked outside its blade path check below) and the armament.
			for pr in get_tree().get_nodes_in_group("apex_probe"):
				if is_instance_valid(pr):
					(pr as Node3D).queue_free()
			# Parked but not pinned: the tether needs to be able to move the
			# ship, so displacement is measured instead of prevented. The lance
			# and mortar bosses hold the spot by re-assigning position, which
			# also makes them the stationary worst case their telegraphs punish.
			if tether:
				displaced = maxf(displaced, start_gap
					- boss.global_position.distance_to(player.global_position))
			else:
				player.global_position = park
				player.velocity = Vector3.ZERO
			player.clear_target()
			await get_tree().physics_frame
			if player.shield < prev:
				taken += prev - player.shield
			prev = player.shield
			if player.shield < 40.0:
				player.shield = player.shield_max     # never trip the emergency warp
				prev = player.shield

		if tether:
			# The Meridian's armament is control, not damage: the assertion is
			# that an idle ship gets DRAGGED, not that it gets hurt. 2.0u sits
			# under a measured 3.3u so a tuning nudge does not trip it, and well
			# over the 0.0u the broken armament produced.
			print("[apex] %s ARMAMENT %s dragged an idle ship %.1fu toward the hub -> %s" % [
				sys, boss.attack_kind, displaced,
				"PASS" if displaced > 2.0 else "FAIL"])

			# 2b. THE ESCAPE GUARANTEE, the other half of the same mechanic. A
			#     control armament that cannot be broken is a cage, and the thing
			#     that makes this one breakable is a terminal drag speed set below
			#     the slowest ship the game will let you fly.
			#
			#     Asserted against ModuleDB's FLOORS rather than a chosen module
			#     list, because the floors are what the promise is made of: 1.6
			#     u/s and 3.0 accel is the worst hull any legal fit can produce,
			#     so a ship that escapes on those numbers means every fit does.
			#     The drag caps at 1.15 u/s, leaving a net 0.45 u/s outward.
			var restore: Dictionary = player._stats.duplicate()
			var weak: Dictionary = restore.duplicate()
			weak["max_speed"] = 1.6
			weak["accel"] = 3.0
			player._apply_fit(weak)
			player.global_position = park
			player.velocity = Vector3.ZERO
			player.clear_target()
			# Drain whatever is left of the window the drag loop ended inside, so
			# what gets measured below is a whole latch and not its last few
			# frames. Bounded, because an unbounded wait on boss state hangs the
			# sweep rather than failing it.
			for i in range(60 * 5):
				if boss._tether_time <= 0.0:
					break
				player.global_position = park
				player.velocity = Vector3.ZERO
				await get_tree().physics_frame
			# Gap to the hub at the first and last frame of one live tether, so
			# the number is headway made against the pull rather than before it.
			var gap_open := -1.0
			var gap_close := -1.0
			var outward: Vector3 = boss.global_position + Vector3(0, 0, 40.0)
			for i in range(60 * 25):
				for pr in get_tree().get_nodes_in_group("apex_probe"):
					if is_instance_valid(pr):
						(pr as Node3D).queue_free()
				player.clear_target()
				if boss._tether_time > 0.0:
					# Latched. NOW burn outward — this is the order the mechanic
					# is played in, and the only order that can be measured: the
					# armament reaches 13.0u, so a ship already running is out of
					# range before the first window ever opens. Burning early
					# measured nothing at all and reported it as a failure.
					player.has_move_target = true
					player.move_target = outward
					gap_close = boss.global_position.distance_to(player.global_position)
					if gap_open < 0.0:
						gap_open = gap_close
				elif gap_open >= 0.0:
					break                          # the window opened, and has shut
				else:
					player.global_position = park  # hold the mark until it latches
					player.velocity = Vector3.ZERO
					player.has_move_target = false
				await get_tree().physics_frame
			player._apply_fit(restore)
			player.has_move_target = false
			# "No window opened" and "the ship gained nothing" are different
			# failures with different fixes, and both would otherwise print as
			# 0.0u. Saying which is the whole lesson of this section.
			var latched := gap_open >= 0.0
			var gained: float = (gap_close - gap_open) if latched else 0.0
			print("[apex] %s ESCAPE weakest legal fit (1.6 u/s) burning outward gained %.1fu across a live tether%s -> %s" % [
				sys, gained, "" if latched else " (NO TETHER EVER LATCHED)",
				"PASS" if latched and gained > 0.0 else "FAIL"])
		else:
			print("[apex] %s ARMAMENT %s dealt %.0f to a parked ship over 14s -> %s" % [
				sys, boss.attack_kind, taken,
				"PASS" if taken > 0.0 else "FAIL"])
		player.invulnerable = true
		boss.reset_fight()

	# 3. The attacks are dodgeable — the series rule. Measured on the Gnomon:
	#    the same window twice, parked vs orbiting the lock point.
	GameState.mark_breached("pyx01")
	_load_system("pyx01")
	await get_tree().create_timer(0.4).timeout
	var gnomon := _find_apex()
	# At the engine before arming, for the reason above: _apex_damage_window does
	# its own positioning, but not until after this await has already elapsed.
	player.global_position = gnomon.global_position + Vector3(0, 0, 4.5)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	var parked := await _apex_damage_window(gnomon, false)
	gnomon.reset_fight()
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	var moving := await _apex_damage_window(gnomon, true)
	print("[apex] DODGEABLE parked took %.0f, orbiting took %.0f over the same window -> %s" % [
		parked, moving,
		"PASS" if parked > 0.0 and moving < parked * 0.5 else "FAIL"])

	# 4. Out of range means out of the fight: no cross-system sniping.
	gnomon.reset_fight()
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	player.invulnerable = false
	player.shield = player.shield_max
	var far: Vector3 = gnomon.global_position + Vector3(0, 0, 30.0)
	var far_prev: float = player.shield
	var far_taken := 0.0
	for i in range(60 * 8):
		for pr in get_tree().get_nodes_in_group("apex_probe"):
			if is_instance_valid(pr):
				(pr as Node3D).queue_free()
		player.global_position = far
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		if player.shield < far_prev:
			far_taken += far_prev - player.shield
		far_prev = player.shield
	print("[apex] DISENGAGE parked 30u out took %.0f over 8s (must be 0) -> %s" % [
		far_taken, "PASS" if far_taken == 0.0 else "FAIL"])

	# 5. VENT ESCALATION. Each successive seal within a phase releases one more
	#    probe, capped at PROBE_VENT_MAX and RESET on phase change — both guards
	#    come from measurement: 4-5 probes were measured eating ~40%% of output,
	#    and a bill that scales with whole-fight length is the axis a previous
	#    tuning pass already rejected. The table first, pure:
	var table := ""
	var table_ok := true
	for ph in range(ApexBoss.PHASES.size()):
		var base := int((ApexBoss.PHASES[ph] as Dictionary)["probes"])
		var prev := 0
		table += "p%d:" % ph
		for v in range(4):
			var n := ApexBoss.probes_for(ph, v)
			table += "%d " % n
			if n < prev or n > ApexBoss.PROBE_VENT_MAX \
					or (v == 0 and n != base):
				table_ok = false
			prev = n
	print("[apex] VENT ESCALATION %s(cap %d) -> %s" % [
		table, ApexBoss.PROBE_VENT_MAX, "PASS" if table_ok else "FAIL"])

	# 6. And the WIRING, live — a pure table passes even if _begin_seal never
	#    reads it. Two seals in phase 0 must vent 2 then 3; a phase change must
	#    reset to its own base. Probes are cleared between vents so the counts
	#    are the vents' own.
	gnomon.reset_fight()
	await get_tree().physics_frame
	var vent_counts: Array = []
	for round_i in range(2):
		for pr in get_tree().get_nodes_in_group("apex_probe"):
			(pr as Node3D).queue_free()
		await get_tree().physics_frame
		gnomon._begin_seal()
		await get_tree().physics_frame
		vent_counts.append(get_tree().get_nodes_in_group("apex_probe").size())
	gnomon._begin_phase(1)
	for pr in get_tree().get_nodes_in_group("apex_probe"):
		(pr as Node3D).queue_free()
	await get_tree().physics_frame
	gnomon._begin_seal()
	await get_tree().physics_frame
	vent_counts.append(get_tree().get_nodes_in_group("apex_probe").size())
	print("[apex] VENT WIRING phase 0 vents %d then %d, phase change resets to %d -> %s" % [
		vent_counts[0], vent_counts[1], vent_counts[2],
		"PASS" if vent_counts[0] == 2 and vent_counts[1] == 3
			and vent_counts[2] == 3 else "FAIL"])
	get_tree().quit()


func _apex_damage_window(boss: ApexBoss, orbit: bool) -> float:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = false
	player.shield = player.shield_max
	var taken := 0.0
	var prev: float = player.shield
	var centre: Vector3 = boss.global_position
	var ang := 0.0
	for i in range(60 * 12):
		for pr in get_tree().get_nodes_in_group("apex_probe"):
			if is_instance_valid(pr):
				(pr as Node3D).queue_free()
		if orbit:
			# ~5.6 u/s tangential at radius 4.5 — an ordinary strafe, no drive
			# bonuses, and comfortably ahead of a 0.85s telegraph on a locked line.
			ang += get_physics_process_delta_time() * 1.25
		player.global_position = centre + Vector3(cos(ang), 0, sin(ang)) * 4.5
		player.velocity = Vector3.ZERO
		player.clear_target()
		await get_tree().physics_frame
		if player.shield < prev:
			taken += prev - player.shield
		prev = player.shield
		if player.shield < 40.0:
			player.shield = player.shield_max
			prev = player.shield
	player.invulnerable = true
	return taken


# --- narrow-width capture -----------------------------------------------------
# The Cantina fields five service tabs plus DEPART. That fits across 720; the
# question is what it does on a small phone, where the logical width is the same
# 720 but the physical pixels are far fewer and every label is proportionally
# larger. Captures the busiest panels at iPhone-logical and small-phone sizes.

func _run_narrow_shots() -> void:
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	# Capture the LAYOUT, not the player's accessibility preference. user_scale
	# is loaded from the save and multiplies everything; a capture taken at
	# someone's 0.7 setting is a picture of that setting, not of the design.
	print("[narrow] player ui_scale %.2f pinned to 1.00 for capture" % UILayout.user_scale)
	UILayout.user_scale = 1.0
	UILayout.apply_scale(get_window())
	GameState.add_salvage(20000)
	GameState.load_cargo("relics", 3)
	await get_tree().create_timer(0.4).timeout

	# One representative size is enough, and that is the finding rather than a
	# shortcut: UILayout pins the logical width to 720 for every portrait window,
	# so 390x844 and 360x800 both resolve to a 720-wide logical space and lay out
	# identically. A narrow phone gets a TALLER logical canvas, never a narrower
	# one, which is why the six-tab Cantina row cannot overflow on any of them.
	for spec in [
		{"w": 390, "h": 844, "tag": "iphone_logical"},
		# The case that prompted the chrome rework: a full-screen Mac window,
		# where the corner controls used to sit 337px inside each screen edge.
		{"w": 2000, "h": 1140, "tag": "mac_fullscreen"},
	]:
		get_window().size = Vector2i(int(spec["w"]), int(spec["h"]))
		await get_tree().process_frame
		await get_tree().process_frame
		var vp := get_viewport().get_visible_rect().size
		print("[narrow] window %dx%d -> logical %.0fx%.0f  content_factor %.3f" % [
			int(spec["w"]), int(spec["h"]), vp.x, vp.y,
			UILayout.content_factor(Vector2(int(spec["w"]), int(spec["h"])))])

		# Free flight first: this is the frame the corner controls live in, and
		# the one where an over-inset HUD blocks the play area.
		_load_system("pyx01")
		_apex_wake_timer = -1.0
		await get_tree().create_timer(0.7).timeout
		player.global_position = Vector3(0, 0, 6)
		var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
		rig.global_position = Vector3(0, 0, 6)
		rig.zoom = 20.0
		rig._target_zoom = 20.0
		await get_tree().create_timer(0.6).timeout
		# No wide capture has ever contained a toast or a broadcast, which is part
		# of why an 8px band overlap shipped: the frames that would have shown it
		# never had anything in those bands.
		hud.show_toast("ARCHEOLOGY 2 — IDENTIFY THE DRIFT SALVAGE WITHOUT DOCKING",
			Palette.GOLD)
		hud.show_broadcast("SUBSPACE ADVISORY — AUTOMATED",
			"SHEAR DETECTED · BEARING 240 · 190u OUT · IT WILL NOT HOLD",
			Palette.band_color(2))
		await get_tree().create_timer(0.7).timeout
		await _shot(shots, "narrow_%s_flight_hud.png" % spec["tag"])
		var cantina: Port = null
		for n in get_tree().get_nodes_in_group("dockable"):
			if (n as Port).port_id == "cantina":
				cantina = n
		if cantina:
			player.global_position = cantina.dock_point
			_complete_dock(cantina)
			await get_tree().create_timer(0.8).timeout
			await _shot(shots, "narrow_%s_cantina_tabs.png" % spec["tag"])
			port_panel._on_tab("paint")
			await get_tree().create_timer(0.5).timeout
			await _shot(shots, "narrow_%s_paint.png" % spec["tag"])
			port_panel._on_tab("contracts")
			await get_tree().create_timer(0.5).timeout
			await _shot(shots, "narrow_%s_contracts.png" % spec["tag"])
			port_panel.close_panel()
			undock()
			await get_tree().create_timer(0.4).timeout

		# And the pause overlay, whose panel has a 340px minimum width.
		toggle_pause()
		await get_tree().create_timer(0.4).timeout
		pause_menu._page = "settings"
		pause_menu._refresh()
		await get_tree().create_timer(0.4).timeout
		await _shot(shots, "narrow_%s_settings.png" % spec["tag"])
		pause_menu.resume()
		# Belt and braces: a harness that leaves the tree paused hangs forever on
		# the next pausable await instead of quitting, which is exactly how this
		# one stalled at the end of a two-size loop.
		get_tree().paused = false
		await get_tree().create_timer(0.3, true, false, true).timeout
	print("[narrow] done -> %s" % shots)
	get_tree().quit()


# --- phase 2 capture ---------------------------------------------------------
# The plan's screenshot list, as a scripted pass. Needs a real window (rendering
# is what is being captured), so this is the one harness that cannot run
# --headless. PYXIS_SHOTS names the output directory.

func _run_phase2_shots() -> void:
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	get_window().size = Vector2i(720, 1280)
	player.invulnerable = true
	GameState.mark_breached("pyx01")
	GameState.mark_breached("pyx02")
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.5).timeout

	# 1. PYX-02 at full extent, ringed ember world in frame.
	_load_system("pyx02")
	await get_tree().create_timer(0.8).timeout
	rig.global_position = Vector3(16, 0, 4)
	rig.zoom = 44.0
	rig._target_zoom = 44.0
	player.global_position = Vector3(4, 0, 12)
	await get_tree().create_timer(1.0).timeout
	print("[shots] pyx02 bounds=%.0f obstacles=%d" % [SystemDB.bounds_of("pyx02"), Obstacles.count()])
	await _shot(shots, "p2_01_pyx02_ringed_planet.png")

	# 2. Radar pings: sit where the system's landmarks are all off screen.
	rig.zoom = 13.0
	rig._target_zoom = 13.0
	player.global_position = Vector3(0, 0, 8)
	rig.global_position = player.global_position
	await get_tree().create_timer(1.2).timeout
	print("[shots] radar markers on screen: %d" % hud.radar_markers().size())
	await _shot(shots, "p2_02_radar_pings.png")

	# 3. A shot breaking on cover — the spark at the surface.
	_load_system("pyx01")
	await get_tree().create_timer(0.8).timeout
	var rock := Vector3(6, 0, 10)
	Obstacles.add(rock, 3.0)
	var behind := SwarmHostile.new()
	behind.difficulty = 1.0
	behind.hp_scale = 30.0
	system_root.add_child(behind)
	behind.global_position = rock + Vector3(0, 0, 4.4)
	behind.dock_at(behind.global_position)
	player.global_position = rock - Vector3(0, 0, 4.6)
	rig.global_position = rock
	rig.zoom = 15.0
	rig._target_zoom = 15.0
	GameState.equip(ModuleDB.Slot.WEAPON_A, "pulse_1")
	player.command_attack(behind)
	for i in range(90):
		player.global_position = rock - Vector3(0, 0, 4.6)
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		if i % 12 == 0:
			await _shot(shots, "p2_03_blocked_beam_spark.png")
	print("[shots] blocked-beam target hp intact = %s" % str(behind.hp > 800.0))

	# 4. Torpedo splash into a cluster.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	GameState.reactor_tier = 2
	for id in ["torp_2"]:
		if not GameState.owns(id):
			GameState.owned.append(id)
	GameState.equip(ModuleDB.Slot.WEAPON_A, "torp_2")
	GameState.equip(ModuleDB.Slot.WEAPON_B, "")
	var hub := Vector3(-4, 0, 14)
	var pack: Array = []
	for i in range(4):
		var p := SwarmHostile.new()
		p.difficulty = 1.0
		p.hp_scale = 6.0
		system_root.add_child(p)
		p.global_position = hub + Vector3(cos(TAU * i / 4.0), 0, sin(TAU * i / 4.0)) * 1.2
		p.dock_at(p.global_position)
		pack.append(p)
	player.global_position = hub + Vector3(0, 0, 6.0)
	rig.global_position = hub + Vector3(0, 0, 2.0)
	rig.zoom = 13.0
	rig._target_zoom = 13.0
	player.command_attack(pack[0])
	for i in range(150):
		player.global_position = hub + Vector3(0, 0, 6.0)
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		if i % 6 == 0:
			await _shot(shots, "p2_04_torpedo_splash.png")
	print("[shots] torpedo captured")

	# 5. Two liveries, same fit.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	GameState.equip(ModuleDB.Slot.WEAPON_A, "lance_2" if GameState.owns("lance_2") else "pulse_1")
	player.global_position = Vector3(0, 0, 8)
	player.rotation = Vector3.ZERO
	rig.global_position = player.global_position
	rig.zoom = 9.5
	rig._target_zoom = 9.5
	# The invulnerability bubble is a teal sphere drawn over the whole hull, and
	# these two frames exist to show the hull. Drop protection for the shot.
	player.invulnerable = false
	_apex_wake_timer = -1.0
	GameState.set_livery(0, 0)
	await get_tree().create_timer(1.0).timeout
	await _shot(shots, "p2_05_livery_survey_grey.png")
	GameState.set_livery(3, 3)
	await get_tree().create_timer(1.0).timeout
	await _shot(shots, "p2_06_livery_oxide_signal.png")
	player.invulnerable = true
	print("[shots] liveries captured")

	# 6. The cantina: rumours.
	var cantina: Port = null
	var anchor: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		var p := n as Port
		if p.port_id == "cantina":
			cantina = p
		elif p.port_id == "anchor":
			anchor = p
	GameState.add_salvage(20000)
	_apex_wake_timer = -1.0
	if cantina:
		player.global_position = cantina.dock_point
		rig.global_position = cantina.global_position
		_complete_dock(cantina)
		await get_tree().create_timer(0.9).timeout
		port_panel._on_tab("rumors")
		await get_tree().create_timer(0.6).timeout
		port_panel._buy_rumor(400)
		await get_tree().create_timer(0.6).timeout
		await _shot(shots, "p2_07_cantina_rumors.png")
		port_panel._on_tab("games")
		await get_tree().create_timer(0.6).timeout
		await _shot(shots, "p2_08_cantina_games.png")
		port_panel._on_tab("paint")
		await get_tree().create_timer(0.6).timeout
		await _shot(shots, "p2_09_paint_swatches.png")
		port_panel.close_panel()
		undock()
		await get_tree().create_timer(0.5).timeout

	# 7. The den: contraband on the market row, and the fence.
	_load_system("pyx03")
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.9).timeout
	var den: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		if (n as Port).port_id == "void":
			den = n
	if den:
		GameState.load_cargo("relics", 4)
		player.global_position = den.dock_point
		rig.global_position = den.global_position
		_complete_dock(den)
		await get_tree().create_timer(0.9).timeout
		await _shot(shots, "p2_10_den_contraband_row.png")
		port_panel._on_tab("fence")
		await get_tree().create_timer(0.6).timeout
		await _shot(shots, "p2_11_den_fence.png")
		port_panel._on_tab("contracts")
		await get_tree().create_timer(0.6).timeout
		await _shot(shots, "p2_12_contract_board.png")
		port_panel.close_panel()
		undock()
		await get_tree().create_timer(0.5).timeout

	# 8. Interdiction, then pause and settings over it.
	GameState.cargo = {"relics": 40}
	player.global_position = Vector3(0, 0, 8)
	rig.global_position = player.global_position
	rig.zoom = 20.0
	rig._target_zoom = 20.0
	spawn_interdiction()
	await get_tree().create_timer(1.2).timeout
	await _shot(shots, "p2_13_raiders_intercept.png")

	toggle_pause()
	await get_tree().create_timer(0.6).timeout
	await _shot(shots, "p2_14_pause.png")
	pause_menu._page = "settings"
	pause_menu._refresh()
	await get_tree().create_timer(0.6).timeout
	await _shot(shots, "p2_15_settings.png")
	pause_menu.resume()
	print("[shots] done -> %s" % shots)
	get_tree().quit()


# --- livery + tier harness --------------------------------------------------

func _run_livery_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(0.4).timeout

	print("[livery] %d hulls x %d accents = %d liveries" % [
		Palette.LIVERY_HULLS.size(), Palette.LIVERY_ACCENTS.size(),
		Palette.LIVERY_HULLS.size() * Palette.LIVERY_ACCENTS.size()])
	# Nine accents since v13: eight bought and one EARNED. The count is asserted
	# rather than derived because the ninth is load-bearing in two other places --
	# GameState.REGISTRY_ACCENT indexes it, and port_panel's swatch grid is nine
	# columns wide so it does not wrap as an orphan.
	print("[livery] SWATCHES 8 hulls and 9 accents (8 bought + REGISTRY) -> %s" % [
		"PASS" if Palette.LIVERY_HULLS.size() == 8 and Palette.LIVERY_ACCENTS.size() == 9
			else "FAIL"])
	# The earned one is the LAST entry, which is what makes "index >= 8 is locked"
	# a rule rather than a coincidence. Insert a bought accent after it and this
	# goes red, which is the point.
	var registry_last: bool = GameState.REGISTRY_ACCENT == Palette.LIVERY_ACCENTS.size() - 1 \
		and String((Palette.LIVERY_ACCENTS[GameState.REGISTRY_ACCENT] as Dictionary)["name"]) == "REGISTRY"
	print("[livery] EARNED ACCENT IS LAST index %d of %d is '%s' -> %s" % [
		GameState.REGISTRY_ACCENT, Palette.LIVERY_ACCENTS.size() - 1,
		String((Palette.LIVERY_ACCENTS[Palette.LIVERY_ACCENTS.size() - 1] as Dictionary)["name"]),
		"PASS" if registry_last else "FAIL"])

	# 1. Setting a livery repaints the ship. Read straight off the material, so
	#    this cannot pass on a stored value the mesh never used.
	GameState.set_livery(0, 0)
	await get_tree().process_frame
	var grey := _ship_hull_color(player)
	GameState.set_livery(1, 3)
	await get_tree().process_frame
	var black := _ship_hull_color(player)
	print("[livery] REPAINT hull material %s -> %s (expected %s -> %s) -> %s" % [
		grey.to_html(false), black.to_html(false),
		Palette.livery_hull(0).to_html(false), Palette.livery_hull(1).to_html(false),
		"PASS" if grey.is_equal_approx(Palette.livery_hull(0))
			and black.is_equal_approx(Palette.livery_hull(1)) else "FAIL"])

	# 2. Out-of-range indices wrap rather than crashing — a save edited by hand,
	#    or a swatch list that shrinks in a later patch, must not hard-fail.
	print("[livery] WRAP index 99 -> %s, index -1 -> %s -> %s" % [
		Palette.livery_hull(99).to_html(false), Palette.livery_hull(-1).to_html(false),
		"PASS" if Palette.livery_hull(99).is_equal_approx(Palette.livery_hull(99 % 8))
			and Palette.livery_hull(-1).is_equal_approx(Palette.livery_hull(7)) else "FAIL"])

	# 3. Survives a save round trip, through the real file layer.
	GameState.set_livery(6, 2)
	GameState.save_game()
	GameState.set_livery(0, 0)
	var reloaded := GameState.load_game()
	var saved_version := 0
	var f := FileAccess.open(GameState.save_path, FileAccess.READ)
	if f != null:
		var parsed = JSON.parse_string(f.get_as_text())
		f.close()
		if typeof(parsed) == TYPE_DICTIONARY:
			saved_version = int((parsed as Dictionary).get("version", 0))
	print("[livery] PERSISTS saved (6,2) as v%d, reset to (0,0), reloaded=(%d,%d) ok=%s -> %s" % [
		saved_version, GameState.livery_index("hull"), GameState.livery_index("accent"),
		str(reloaded),
		"PASS" if reloaded and saved_version == GameState.SAVE_VERSION
			and GameState.livery_index("hull") == 6 and GameState.livery_index("accent") == 2
			else "FAIL"])
	DirAccess.remove_absolute(ProjectSettings.globalize_path(GameState.save_path))

	# 4. Paint is sold where the plan says, and costs what it says.
	var painters := []
	for id in SystemDB.port_ids():
		var svc: Array = SystemDB.port_def_by_id(String(id)).get("services", PortPanel.DEFAULT_SERVICES)
		if svc.has("paint"):
			painters.append(id)
	print("[livery] PAINT SERVICE at %s for %d salvage -> %s" % [
		str(painters), PortPanel.PAINT_PRICE,
		"PASS" if painters.size() >= 3 and painters.has("anchor") and painters.has("cantina")
			else "FAIL"])

	# --- Mk II tiers ---------------------------------------------------------
	var tiers := ["drive_cruise_2", "drive_vector_2", "util_tractor_2",
		"util_shield_2", "util_scanner_2", "util_cargo_2"]
	var all_exist := true
	var priced := true
	for id in tiers:
		if not ModuleDB.exists(id):
			all_exist = false
			continue
		var price := int(ModuleDB.get_module(id)["price"])
		if price < 12000 or price > 20000:
			priced = false
	print("[tiers] ROWS all six present=%s, all priced 12k-20k=%s -> %s" % [
		str(all_exist), str(priced), "PASS" if all_exist and priced else "FAIL"])

	# Every Mk II must actually beat its Mk I on every stat it shares, or the
	# price is a lie. This is the assertion that catches a typo'd number.
	var strictly_better := true
	var worst := ""
	for id_v in tiers:
		var id := String(id_v)
		var base_id := id.trim_suffix("_2")
		var mk1: Dictionary = ModuleDB.get_module(base_id)["stats"]
		var mk2: Dictionary = ModuleDB.get_module(id)["stats"]
		for key in mk1:
			if float(mk2.get(key, -1.0)) <= float(mk1[key]):
				strictly_better = false
				worst = "%s.%s %.2f -> %.2f" % [id, key, float(mk1[key]), float(mk2.get(key, -1.0))]
		if int(ModuleDB.get_module(id)["power"]) <= int(ModuleDB.get_module(base_id)["power"]):
			strictly_better = false
			worst = "%s draws no more power than its Mk I" % id
	print("[tiers] STRICTLY BETTER every Mk II beats its Mk I and costs more power -> %s %s" % [
		"PASS" if strictly_better else "FAIL", worst])

	# And they have to be buyable somewhere.
	var stocked := {}
	for id in SystemDB.port_ids():
		for m in SystemDB.port_def_by_id(String(id)).get("stock", []):
			stocked[String(m)] = true
	var all_stocked := true
	for id in tiers:
		if not stocked.has(id):
			all_stocked = false
	print("[tiers] STOCKED every Mk II is on sale somewhere -> %s" % [
		"PASS" if all_stocked else "FAIL"])

	# The budget still has to bite: even Mk III cannot carry all-best modules.
	GameState.reactor_tier = 2
	var greedy := {
		ModuleDB.Slot.WEAPON_A: "lance_2",
		ModuleDB.Slot.WEAPON_B: "torp_2",
		ModuleDB.Slot.DRIVE: "drive_vector_2",
		ModuleDB.Slot.UTILITY: "util_scanner_2",
		ModuleDB.Slot.CORE: "core_aegis",
	}
	var draw := ModuleDB.power_draw(greedy)
	print("[tiers] BUDGET all-best fit draws %d of %d on Mk III -> %s" % [
		draw, GameState.power_cap(),
		"PASS" if draw > GameState.power_cap() else "FAIL"])
	get_tree().quit()


func _ship_hull_color(player: PlayerShip) -> Color:
	# The hull prism is the first child added by _rebuild_mesh.
	for node in player.get_children():
		for part in node.get_children():
			var mi := part as MeshInstance3D
			if mi != null and mi.mesh is PrismMesh:
				return (mi.material_override as StandardMaterial3D).albedo_color
	return Color.BLACK


# --- station harness --------------------------------------------------------

func _run_station_test() -> void:
	await get_tree().create_timer(0.4).timeout

	# 1. Every station exists, is reachable, and is not standing inside anything.
	print("[station] all ports on the chart: %s" % str(SystemDB.port_ids()))
	var expected := ["anchor", "cantina", "cinderworks", "depot", "bastion", "void"]
	var all_present := true
	for id in expected:
		if not SystemDB.port_ids().has(id):
			all_present = false
	print("[station] REGISTRY %d ports, all six present=%s -> %s" % [
		SystemDB.port_ids().size(), str(all_present),
		"PASS" if all_present else "FAIL"])

	# Each secondary must be far from its primary — the whole point is that
	# travelling across a system has a destination at the other end.
	var separation_ok := true
	var closest := INF
	for sys in SystemDB.ids():
		var ports := SystemDB.ports_of(String(sys))
		for i in range(ports.size()):
			for j in range(i + 1, ports.size()):
				var d: float = (ports[i]["pos"] as Vector3).distance_to(ports[j]["pos"])
				closest = minf(closest, d)
				if d < 20.0:
					separation_ok = false
	print("[station] SPREAD closest two ports in any system %.1fu (want >= 20) -> %s" % [
		closest, "PASS" if separation_ok else "FAIL"])

	# 2. Built into the world with hulls and dock rings, and no dock ring buried
	#    inside its own station's collision sphere.
	_load_system("pyx01")
	await get_tree().create_timer(0.4).timeout
	var built := get_tree().get_nodes_in_group("dockable")
	var rings_clear := true
	for n in built:
		var p := n as Port
		# The ring must sit outside the hull sphere or the ship is shoved out of
		# its own docking range — the exact footgun the derelict hit in phase 2.
		if p.dock_point.distance_to(p.global_position) <= Port.HULL_OBSTACLE_RADIUS:
			rings_clear = false
	print("[station] BUILT pyx01 has %d dockable stations, rings outside their hulls=%s -> %s" % [
		built.size(), str(rings_clear),
		"PASS" if built.size() == 2 and rings_clear else "FAIL"])

	# 3. Services drive the tabs. This is what makes a station type data.
	for id in expected:
		var def := SystemDB.port_def_by_id(id)
		var svc: Array = def.get("services", PortPanel.DEFAULT_SERVICES)
		print("[station]   %-12s %-22s %s" % [id, String(def.get("name", "?")), str(svc)])
	var cantina := SystemDB.port_def_by_id("cantina")
	var den := SystemDB.port_def_by_id("void")
	var depot := SystemDB.port_def_by_id("depot")
	var services_ok := (cantina.get("services", []) as Array).has("rumors") \
		and (cantina.get("services", []) as Array).has("games") \
		and not (cantina.get("services", []) as Array).has("market") \
		and (den.get("services", []) as Array).has("fence") \
		and (depot.get("services", []) as Array).has("market")
	print("[station] SERVICES cantina has rumors+games and no market, den fences, depot trades -> %s" % [
		"PASS" if services_ok else "FAIL"])

	# 4. Depot: bulk break both ways, and a better sell-back on modules.
	var one_buy := Market.buy_price(depot, "depot", "alloys", 1)
	var bulk_buy := Market.buy_price(depot, "depot", "alloys", 10)
	var one_sell := Market.sell_price(depot, "depot", "alloys", 1)
	var bulk_sell := Market.sell_price(depot, "depot", "alloys", 10)
	print("[station] BULK alloys buy %d -> %d at 10+, sell %d -> %d at 10+ -> %s" % [
		one_buy, bulk_buy, one_sell, bulk_sell,
		"PASS" if bulk_buy < one_buy and bulk_sell > one_sell else "FAIL"])
	print("[station] SELLBACK depot %.0f%% vs default %.0f%% -> %s" % [
		float(depot.get("sellback", 0.6)) * 100.0, 60.0,
		"PASS" if float(depot.get("sellback", 0.6)) > 0.6 else "FAIL"])
	var depot_stock: Array = depot.get("stock", [])
	var no_mk2_weapons := not depot_stock.has("lance_2") and not depot_stock.has("arc_2")
	print("[station] DEPOT STOCK drives/utilities/torpedoes, no Mk II weapons=%s -> %s" % [
		str(no_mk2_weapons),
		"PASS" if no_mk2_weapons and depot_stock.has("torp_1") else "FAIL"])

	# 5. Den: fence premium on the right goods only, and grey-market modules.
	var fenced := Market.sell_price(den, "void", "relics", 1)
	var clean := Market.sell_price(SystemDB.port_def_by_id("anchor"), "void", "relics", 1)
	var unfenced := Market.fence_bonus(den, "alloys")
	print("[station] FENCE relics %.2fx premium (alloys %.2fx, must be 1.00) -> %s" % [
		Market.fence_bonus(den, "relics"), unfenced,
		"PASS" if Market.fence_bonus(den, "relics") > 1.2 and is_equal_approx(unfenced, 1.0) else "FAIL"])
	print("[station] GREY MARKET modules at %.0f%% of catalog -> %s" % [
		float(den.get("outfit_mult", 1.0)) * 100.0,
		"PASS" if float(den.get("outfit_mult", 1.0)) < 1.0 else "FAIL"])
	print("[station]   (fenced relics %d vs a clean quote of %d)" % [fenced, clean])

	# NO MODULE LAUNDRY, ANYWHERE, FOR ANY PAIR OF STATIONS.
	#
	# A module costs `price * outfit_mult` at the station you buy it from and pays
	# `price * sellback` at the station you sell it to, so the invariant across
	# the whole game is `max(sellback) < min(outfit_mult)`. This used to be one
	# hard-coded comparison — grey-market arc_2 at the Void against sell-back at
	# the Depot — which happened to be the binding pair and happened to hold, at
	# 0.75 against 0.80. Both of those were luck. Deep stations are exactly the
	# kind of content that turns that luck into an infinite loop flown between two
	# docks, so the check is now the actual invariant: every buyer against every
	# seller, chart and expanse together, reporting the worst pair by name.
	var desks := []
	for pid_v in SystemDB.port_ids():
		var pd := SystemDB.port_def_by_id(String(pid_v))
		desks.append({"id": String(pid_v), "name": String(pd.get("name", "?")),
			"sellback": float(pd.get("sellback", 0.6)),
			"outfit": float(pd.get("outfit_mult", 1.0))})
	for a_v in DeepPortDB.ARCHETYPES:
		var a: Dictionary = a_v
		desks.append({"id": String(a["id"]), "name": String(a["name"]),
			"sellback": float(a.get("sellback", 0.6)),
			"outfit": float(a.get("outfit_mult", 1.0))})

	var worst_margin := -INF
	var worst_pair := ""
	for buy_at in desks:
		for sell_at in desks:
			var margin: float = float(sell_at["sellback"]) - float(buy_at["outfit"])
			if margin > worst_margin:
				worst_margin = margin
				worst_pair = "buy at %s (x%.2f) -> sell at %s (x%.2f)" % [
					buy_at["name"], buy_at["outfit"], sell_at["name"], sell_at["sellback"]]
	print("[station] NO ARBITRAGE %d counters, %d pairs; closest is %s = %+.2f -> %s" % [
		desks.size(), desks.size() * desks.size(), worst_pair, worst_margin,
		"PASS" if worst_margin < 0.0 else "FAIL"])

	# And the deep archetypes are held to the stated guard rail by name, so a bad
	# def is caught as a bad def rather than found later as a money printer.
	var rail := DeepPortDB.violations()
	print("[station] DEEP GUARD RAIL sellback <= %.2f, outfit_mult >= %.2f across %d archetypes -> %s %s" % [
		DeepPortDB.SELLBACK_CEILING, DeepPortDB.OUTFIT_FLOOR, DeepPortDB.count(),
		"PASS" if rail.is_empty() else "FAIL", str(rail)])

	# 6. Contraband trades at the den and the cantina, and nowhere else.
	var legal := []
	for id in expected:
		if CommodityDB.trades_at("contraband", id):
			legal.append(id)
	print("[station] CONTRABAND tradeable at %s -> %s" % [str(legal),
		"PASS" if legal.size() == 2 and legal.has("void") and legal.has("cantina") else "FAIL"])
	var anchor_goods := CommodityDB.ids_for_port("anchor")
	print("[station] MARKET ROWS anchor lists %d goods, contraband hidden=%s -> %s" % [
		anchor_goods.size(), str(not anchor_goods.has("contraband")),
		"PASS" if not anchor_goods.has("contraband") else "FAIL"])

	# 7. NO PORT IS A MONEY PRINTER. Buying and immediately re-selling the same
	#    good at the same station must always lose money, at every port, for
	#    every good, at every trade size. The fence premium (1.25x) is larger
	#    than a freeport's spread (6%), so before `can_buy` closed the buy side
	#    the Grinning Void quoted Stolen Goods at BUY 169 / SELL 188 — a loop you
	#    could run with two button taps.
	#    Deep stations are swept alongside the chart, because a fence premium out
	#    at the Long Haven is the same shape of hazard the Void already was.
	var all_counters: Array = SystemDB.port_ids().duplicate()
	all_counters.append_array(DeepPortDB.ids())
	var printer := ""
	#    RUN AT BOTH SMUGGLING TIERS (mining stage 3). This had only ever swept at
	#    smuggling 0, because reset_to_starter leaves it there and nothing moved
	#    it. Market.fences() carries a tier-3 clause that returns true for ANY
	#    deep port holding a fence service, and can_buy is `not fences(...)` — so
	#    at tier 3 the buy side CLOSES at the deep havens and those port/good
	#    pairs stop being checked at all. The pair count is printed per tier so
	#    that difference is visible rather than implied: tier 3 legitimately
	#    checks FEWER pairs, and a reader has to be able to see that rather than
	#    assume the two runs were the same sweep twice.
	#
	#    Prices themselves do not move with the tier — sell_price applies
	#    fence_bonus, which is keyed on the port's own fence_goods list and not on
	#    fences(). That is a property this now proves rather than assumes.
	var smug_before := GameState.smuggling
	var pairs_at := {}
	for tier_v in [0, GameState.SMUGGLING_ACCESS_TIER]:
		var tier := int(tier_v)
		GameState.smuggling = tier
		var pairs := 0
		for pid_v in all_counters:
			var pid := String(pid_v)
			var pdef := DeepPortDB.by_id(pid) if DeepPortDB.is_deep_port(pid) \
				else SystemDB.port_def_by_id(pid)
			for good_v in CommodityDB.ids_for_port(pid):
				var good := String(good_v)
				if not Market.can_buy(pdef, good):
					continue
				pairs += 1
				for size in [1, 10, 25]:
					var b := Market.buy_price(pdef, pid, good, size)
					var sl := Market.sell_price(pdef, pid, good, size)
					if sl >= b:
						printer = "smuggling %d: %s %s x%d: buy %d, sell %d" % [
							tier, pid, good, size, b, sl]
		pairs_at[tier] = pairs
	GameState.smuggling = smug_before
	print("[station] NO ROUND-TRIP PROFIT at any of %d ports (chart + expanse), good or trade size; smuggling 0 swept %d pairs, tier %d swept %d -> %s %s" % [
		all_counters.size(), int(pairs_at[0]), GameState.SMUGGLING_ACCESS_TIER,
		int(pairs_at[GameState.SMUGGLING_ACCESS_TIER]),
		"PASS" if printer == "" else "FAIL", printer])

	# 8. DECLARED TRADEABLE MUST MEAN ACTUALLY TRADEABLE.
	#    CommodityDB.trades_at() and a port's `services` list are two separate
	#    pieces of data that have to agree, and nothing made them. Contraband
	#    declared itself tradeable at the Cantina, the Cantina shipped with
	#    neither a market nor a fence, and so the marquee smuggling route could
	#    be bought into and never sold out of. The price assertion below passed
	#    the whole time, because Market.sell_price is pure arithmetic that never
	#    asks whether a counter exists.
	# `trades_at` is a RESTRICTION filter, not a promise of a counter — an
	# entertainment station legitimately has no alloys desk. The invariant that
	# actually matters is that every good can be sold somewhere, and that a
	# RESTRICTED good can be sold at one of the few ports it is restricted to.
	var unreachable := ""
	for good_v in CommodityDB.ids():
		var good := String(good_v)
		var counters: Array = []
		for pid_v in SystemDB.port_ids():
			var pid := String(pid_v)
			if not CommodityDB.trades_at(good, pid):
				continue
			var pdef := SystemDB.port_def_by_id(pid)
			var svc: Array = pdef.get("services", PortPanel.DEFAULT_SERVICES)
			if svc.has("market") or (svc.has("fence") and Market.fences(pdef, good)):
				counters.append(pid)
		var restricted := not (CommodityDB.get_good(good).get("trade_only_at", []) as Array).is_empty()
		if restricted:
			print("[station]   %s is restricted; counters: %s" % [good, str(counters)])
		if counters.is_empty():
			unreachable = "%s can be sold at no port on the chart" % good
	print("[station] REACHABLE every good has at least one counter that will take it -> %s %s" % [
		"PASS" if unreachable == "" else "FAIL", unreachable])

	# 9. And the contraband run has to be worth making, or the whole
	#    risk/reward of the smuggling route is decoration.
	var buy_void := Market.buy_price(SystemDB.port_def_by_id("void"), "void", "contraband", 24)
	var sell_cantina := Market.sell_price(SystemDB.port_def_by_id("cantina"), "cantina", "contraband", 24)
	print("[station] CONTRABAND RUN void %d -> cantina %d = %d/unit margin -> %s" % [
		buy_void, sell_cantina, sell_cantina - buy_void,
		"PASS" if sell_cantina > buy_void * 1.3 else "FAIL"])

	# 9. The cantina wager is a losing bet with the odds on the table.
	var ev := PortPanel.GAMBLE_WIN_CHANCE * 2.0
	print("[station] WAGER %.0f%% to double = %.2fx expected, streak capped at %d -> %s" % [
		PortPanel.GAMBLE_WIN_CHANCE * 100.0, ev, PortPanel.GAMBLE_STREAK_LIMIT,
		"PASS" if ev < 1.0 and PortPanel.GAMBLE_STREAK_LIMIT > 0 else "FAIL"])
	get_tree().quit()


# --- torpedo harness --------------------------------------------------------

func _run_torp_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	set_deep_generation(false)
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()

	GameState.reactor_tier = 2
	for id in ["torp_1", "torp_2"]:
		if not GameState.owns(id):
			GameState.owned.append(id)
	GameState.equip(ModuleDB.Slot.WEAPON_A, "torp_1")
	GameState.equip(ModuleDB.Slot.WEAPON_B, "")
	await get_tree().create_timer(0.5).timeout
	print("[torp] fit dps %.0f  power %d/%d  hull shows a torpedo pod=%s" % [
		float(GameState.stats.get("dps", 0.0)), GameState.power_draw(), GameState.power_cap(),
		str(GameState.fit[ModuleDB.Slot.WEAPON_A] == "torp_1")])

	# NOTE: difficulty must be > 0 for any probe whose HP is being measured —
	# SwarmHostile computes hp = MAX_HP * difficulty * hp_scale, so difficulty 0
	# spawns a target with zero hit points that dies to the first tick of damage
	# and makes every number in this harness meaningless.

	# 1. Splash kills a cluster: three probes inside the radius, one shot.
	var open := Obstacles.resolve(Vector3(0, 0, 16), 6.0)
	var cluster: Array = []
	for i in range(3):
		var p := SwarmHostile.new()
		p.difficulty = 1.0
		p.hp_scale = 1.0
		system_root.add_child(p)
		p.global_position = open + Vector3(cos(TAU * i / 3.0), 0, sin(TAU * i / 3.0)) * 1.1
		p.dock_at(p.global_position)      # holding station, the torpedo's whole use case
		cluster.append(p)
	await get_tree().create_timer(0.2).timeout
	print("[torp]   cluster probe hp %.0f each, torp_1 direct hit %.0f" % [
		float(cluster[0].hp), 92.0])

	player.global_position = open + Vector3(0, 0, 7.0)
	player.velocity = Vector3.ZERO
	player.command_attack(cluster[0])
	for i in range(220):
		player.global_position = open + Vector3(0, 0, 7.0)
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
	var alive := 0
	for p in cluster:
		if is_instance_valid(p):
			alive += 1
	print("[torp] SPLASH clustered docked probes alive %d of 3 (must be 0) -> %s" % [
		alive, "PASS" if alive == 0 else "FAIL"])

	# 2. The same weapon against a strafer. Measured as a COMPARISON against an
	#    identical stationary target over an identical firing window, because
	#    "took less than a full hit" would also be true of a near miss on a
	#    parked ship. The claim is that movement is what defeats it.
	var still_taken := await _torp_damage_window(player, open, false)
	var moving_taken := await _torp_damage_window(player, open, true)
	print("[torp] DODGE stationary target took %.0f, strafing target took %.0f over the same window -> %s" % [
		still_taken, moving_taken,
		"PASS" if still_taken > 0.0 and moving_taken < still_taken * 0.5 else "FAIL"])

	# 3. Cover stops a torpedo like it stops everything else.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	var rock := Vector3(-30, 0, 30)
	Obstacles.add(rock, 3.0)
	var hidden := SwarmHostile.new()
	hidden.difficulty = 1.0
	hidden.hp_scale = 30.0
	system_root.add_child(hidden)
	hidden.global_position = rock - Vector3(0, 0, 4.2)
	hidden.dock_at(hidden.global_position)
	await get_tree().create_timer(0.2).timeout

	var hidden_before: float = hidden.hp
	var firing_spot := rock + Vector3(0, 0, 4.6)
	player.command_attack(hidden)
	for i in range(260):
		player.global_position = firing_spot
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
	print("[torp] COVER hp %.0f -> %.0f behind a rock (must be equal), los=%s (must be false) -> %s" % [
		hidden_before, hidden.hp, str(Obstacles.has_line(firing_spot, hidden.global_position)),
		"PASS" if is_equal_approx(hidden_before, hidden.hp) else "FAIL"])

	# 4. Power cost is the price of area damage: a dual Mk II fit leaves no room
	#    for a utility even on the best reactor in the game.
	GameState.equip(ModuleDB.Slot.WEAPON_A, "torp_2")
	GameState.equip(ModuleDB.Slot.WEAPON_B, "torp_2")
	var dual_draw := GameState.power_draw()
	var can_add_utility := GameState.can_equip(ModuleDB.Slot.UTILITY, "util_shield")
	print("[torp] POWER dual torp_2 draws %d of %d; can still fit a shield=%s (must be false) -> %s" % [
		dual_draw, GameState.power_cap(), str(can_add_utility),
		"PASS" if not can_add_utility else "FAIL"])

	# 5. Stocked where the plan says.
	var bastion: Array = SystemDB.port_def_by_id("bastion").get("stock", [])
	print("[torp] STOCK bastion carries torp_1=%s torp_2=%s -> %s" % [
		str(bastion.has("torp_1")), str(bastion.has("torp_2")),
		"PASS" if bastion.has("torp_1") and bastion.has("torp_2") else "FAIL"])
	get_tree().quit()


func _torp_damage_window(player: PlayerShip, open: Vector3, moving: bool) -> float:
	# One target, one fixed firing position, one fixed number of frames. The only
	# variable is whether the target holds station or strafes.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame

	var probe := SwarmHostile.new()
	probe.difficulty = 1.0
	probe.hp_scale = 40.0        # must outlast the window, or the test caps out
	system_root.add_child(probe)
	probe.global_position = open + Vector3(3.0, 0, 0)
	if not moving:
		probe.dock_at(probe.global_position)
	await get_tree().create_timer(0.2).timeout

	# Inside torp_1's 9.0 reach with room to spare: at 6,0,0 / 0,0,7 the target
	# sat 9.22u out and the mount simply never fired.
	var spot := open + Vector3(0, 0, 5.0)
	var before: float = probe.hp
	var travelled := 0.0
	var last: Vector3 = probe.global_position
	player.command_attack(probe)
	for i in range(300):
		player.global_position = spot
		player.velocity = Vector3.ZERO
		await get_tree().physics_frame
		if not is_instance_valid(probe):
			return before
		travelled += last.distance_to(probe.global_position)
		last = probe.global_position
	print("[torp]   %s target: hp %.0f -> %.0f, travelled %.1fu" % [
		"strafing" if moving else "stationary", before, probe.hp, travelled])
	var taken := before - probe.hp
	probe.queue_free()
	await get_tree().process_frame
	return taken


# --- contract board harness -------------------------------------------------

func _run_contract_test() -> void:
	await get_tree().create_timer(0.4).timeout
	var port := find_port()
	var port_id := port.port_id

	# 1. The board is deterministic per (port, time bucket): docking, leaving and
	#    coming back must not reroll it, or the offers are a slot machine.
	GameState.played_seconds = 100.0
	var first := ContractDB.board_for(port_id, system_id, GameState.played_seconds)
	var again := ContractDB.board_for(port_id, system_id, GameState.played_seconds + 30.0)
	print("[contract] STABLE board %s == %s -> %s" % [
		str(first), str(again), "PASS" if first == again else "FAIL"])

	# 2. It rotates on the played-time bucket.
	var later := ContractDB.board_for(port_id, system_id,
		GameState.played_seconds + ContractDB.BOARD_ROTATE_SECONDS * 2.0)
	print("[contract] ROTATES after %ds: %s -> %s" % [
		int(ContractDB.BOARD_ROTATE_SECONDS), str(later),
		"PASS" if later != first else "FAIL (may collide by chance — re-check)"])

	# 3. Different ports show different boards at the same moment.
	var other_id := "anchor" if port_id != "anchor" else "bastion"
	var other := ContractDB.board_for(other_id, system_id, GameState.played_seconds)
	print("[contract] PER-PORT %s vs %s -> %s" % [port_id, other_id,
		"PASS" if other != first else "FAIL"])
	print("[contract] SIZE %d offers (cap %d) -> %s" % [
		first.size(), ContractDB.BOARD_SIZE,
		"PASS" if first.size() <= ContractDB.BOARD_SIZE and first.size() > 0 else "FAIL"])

	# 4. Accept / drop round trip, and the two-slot ceiling.
	contracts.active = []
	var board := contracts.board(port_id)
	var a := String(board[0]["id"])
	var b := String(board[1]["id"])
	var c := String(board[2]["id"])
	var took_a := contracts.accept(a)
	var took_b := contracts.accept(b)
	var took_c := contracts.accept(c)     # must be refused: slots are full
	print("[contract] ACCEPT a=%s b=%s c=%s (c must be false), active=%d -> %s" % [
		str(took_a), str(took_b), str(took_c), contracts.active.size(),
		"PASS" if took_a and took_b and not took_c and contracts.active.size() == 2 else "FAIL"])

	var dup := contracts.accept(a)
	print("[contract] NO DUPLICATES re-accepting %s = %s (must be false) -> %s" % [
		a, str(dup), "PASS" if not dup else "FAIL"])

	var dropped := contracts.drop(a)
	var now_free := contracts.slots_free()
	var took_c2 := contracts.accept(c)
	print("[contract] DROP %s = %s, slots free %d, then accept c = %s -> %s" % [
		a, str(dropped), now_free, str(took_c2),
		"PASS" if dropped and now_free == 1 and took_c2 else "FAIL"])

	# 5. The board reflects what is held, so ACCEPT/DROP render correctly.
	var marked := 0
	for offer in contracts.board(port_id):
		if bool(offer["accepted"]):
			marked += 1
	print("[contract] BOARD MARKS %d offers shown as accepted (2 held) -> %s" % [
		marked, "PASS" if marked == 2 else "FAIL"])

	# 6. Nothing is auto-assigned any more: completing one frees a slot and
	#    leaves it free. This is the whole point of the change.
	var held_before := contracts.active.size()
	var entry: Dictionary = contracts.active[0]
	var def := ContractDB.get_contract(String(entry["id"]))
	contracts._complete(entry)
	await get_tree().process_frame
	print("[contract] NO AUTO-REFILL held %d -> %d after completing '%s' -> %s" % [
		held_before, contracts.active.size(), String(def.get("title", "?")),
		"PASS" if contracts.active.size() == held_before - 1 else "FAIL"])

	# 7. Travel no longer silently cancels work the player chose. A delivery
	#    contract is *supposed* to send you to another system.
	contracts.active = []
	contracts.accept("haul_isotopes")     # dest cinderworks, offered anywhere
	var before_travel := contracts.active.size()
	contracts.on_system_changed("pyx03")
	print("[contract] SURVIVES TRAVEL held %d -> %d across a system change -> %s" % [
		before_travel, contracts.active.size(),
		"PASS" if contracts.active.size() == before_travel else "FAIL"])

	# 8. A brand-new run still starts with the starter pair, because there is no
	#    port to accept from until the tutorial is over.
	GameState.contract_state = {}
	var fresh := Contracts.new()
	add_child(fresh)
	await get_tree().process_frame
	print("[contract] STARTER PAIR on a fresh run: %s -> %s" % [
		fresh.debug_state(),
		"PASS" if fresh.active.size() == ContractDB.ACTIVE_SLOTS else "FAIL"])

	# And a player who drops both stays empty rather than being handed them back.
	fresh.drop(String(fresh.active[0]["id"]))
	fresh.drop(String(fresh.active[0]["id"]))
	var emptied := Contracts.new()
	add_child(emptied)
	await get_tree().process_frame
	print("[contract] STAYS EMPTY after dropping both: %d active -> %s" % [
		emptied.active.size(), "PASS" if emptied.active.is_empty() else "FAIL"])

	# --- commissions (§95) ---------------------------------------------------
	# A COMMISSION IS NOT A WAY IN. The rule that keeps standing worth having:
	# work posted by a faction is offered only to a pilot they already trust, so
	# it is not a ladder to climb from NEUTRAL -- it is what being trusted is
	# FOR. Asked of the catalog directly, at both standings, over every system,
	# so a commission leaking onto a stranger's board anywhere goes red.
	var comm_ids: Array = []
	for cid_v in ContractDB.CONTRACTS:
		if ContractDB.faction_of(String(cid_v)) != "":
			comm_ids.append(String(cid_v))
	GameState.faction_deltas = {}
	var stranger_leak := ""
	for sid_v in SystemDB.ids():
		for id_v in ContractDB.available_for(String(sid_v), []):
			if ContractDB.faction_of(String(id_v)) != "":
				stranger_leak += "%s " % String(id_v)
	# And with trust, the same catalog offers them. Both halves matter: a filter
	# that dropped every commission always would pass the first clause alone.
	var trusted_pool := ContractDB.available_for(system_id,
		[ContractDB.faction_of(String(comm_ids[0]))])
	var offered_when_trusted: bool = trusted_pool.has(String(comm_ids[0]))
	print("[contract] A COMMISSION IS NOT A WAY IN %d commissions in the catalog; offered to a stranger: %s; offered once trusted: %s -> %s" % [
		comm_ids.size(), "none" if stranger_leak == "" else stranger_leak,
		str(offered_when_trusted),
		"PASS" if comm_ids.size() >= 1 and stranger_leak == "" and offered_when_trusted
			else "FAIL"])

	# THE TRUST LIST IS THE HAIL'S OWN BAND. One definition of "they know you",
	# shared by the convoy that speaks to you and the board that posts for you --
	# two thresholds that drifted apart would mean a faction that talks to you
	# but will not hire you, with nothing on screen explaining the difference.
	var comm_flag := ContractDB.faction_of(String(comm_ids[0]))
	GameState.faction_deltas = {}
	var live := contracts
	var cold := live.trusted_factions().has(comm_flag)
	GameState.shift_faction(FactionDB.SURVEYOR, comm_flag,
		FactionDB.ATTITUDE_MAX, true)
	var warm := live.trusted_factions().has(comm_flag)
	var band_now := GameState.faction_band(FactionDB.SURVEYOR, comm_flag)
	print("[contract] THE TRUST LIST IS THE HAIL'S OWN BAND %s at a cold start=%s, once ALLIED (band %d, hail bar %d)=%s -> %s" % [
		comm_flag, str(cold), band_now, DeepSpace.CONVOY_HAIL_MIN_BAND, str(warm),
		"PASS" if not cold and warm and band_now <= DeepSpace.CONVOY_HAIL_MIN_BAND
			else "FAIL"])

	# FILLING ONE PAYS A NAME, AND WALKING AWAY COSTS DOUBLE. Both driven
	# through the real verbs -- _complete via the progress feed, drop via drop --
	# because the asymmetry IS the design and a test that poked the store would
	# not notice if either path forgot to call shift_faction.
	var comm_id := String(comm_ids[0])
	var comm_def := ContractDB.get_contract(comm_id)
	# HEADROOM FIRST, and this is not incidental setup. faction_attitude CLAMPS
	# at read time (±6), so a fixture that walked standing to the ceiling to buy
	# trust would then measure a +1 reward as zero movement and report a working
	# payout as broken. Trust costs FRIENDLY, not ALLIED, so the fixture buys
	# exactly that and leaves room in both directions -- +1 to gain and −2 to
	# lose, from a baseline of 0.
	GameState.faction_deltas = {}
	GameState.shift_faction(FactionDB.SURVEYOR, comm_flag, 2, true)
	var att_start := GameState.faction_attitude(FactionDB.SURVEYOR, comm_flag)
	live.active = []
	live.accept(comm_id)
	var salv_start := GameState.salvage
	live._advance(String(comm_def["kind"]), int(comm_def["target"]))
	var att_filled := GameState.faction_attitude(FactionDB.SURVEYOR, comm_flag)
	var paid_credits := GameState.salvage - salv_start
	# Now take it again and abandon it.
	live.active = []
	live.accept(comm_id)
	var att_before_drop := GameState.faction_attitude(FactionDB.SURVEYOR, comm_flag)
	live.drop(comm_id)
	var att_dropped := GameState.faction_attitude(FactionDB.SURVEYOR, comm_flag)
	var gained := att_filled - att_start
	var lost := att_before_drop - att_dropped
	print("[contract] FILLING ONE PAYS A NAME %s from attitude %d: +%d standing (want %d) and %d credits (want %d); abandoning cost %d (want %d, %dx) -> %s" % [
		comm_id, att_start, gained, ContractDB.standing_of(comm_id), paid_credits,
		int(comm_def["reward"]), lost, ContractDB.break_cost(comm_id),
		ContractDB.COMMISSION_BREAK_MULT,
		"PASS" if gained == ContractDB.standing_of(comm_id)
			and paid_credits == int(comm_def["reward"])
			and lost == ContractDB.break_cost(comm_id)
			and lost > gained else "FAIL"])

	# AND THE ROW SAYS SO BEFORE THE BUTTON. The affordance half of §88: a cost
	# a player can only discover by paying it is not a cost they agreed to. The
	# board's own dict is checked rather than the pixels, but it is the dict the
	# row renders from, and it carries all three terms.
	GameState.faction_deltas = {}
	GameState.shift_faction(FactionDB.SURVEYOR, comm_flag, FactionDB.ATTITUDE_MAX, true)
	# SWEPT OVER BUCKETS, NOT ASKED ONCE. The board is a seeded five-of-twelve
	# shuffle, so "is this commission on today's board" is a coin flip and a leg
	# that asked once would be a flake wearing an assertion's clothes. The
	# shuffle is deterministic per (port, time bucket), so walking the buckets
	# is exhaustive rather than lucky: it must turn up at least once, and every
	# time it turns up it must carry all three terms.
	var seen_rows := 0
	var bad_terms := 0
	var clock := GameState.played_seconds
	for bucket in 40:
		GameState.played_seconds = float(bucket) * ContractDB.BOARD_ROTATE_SECONDS + 1.0
		for offer_v in live.board(port_id):
			var offer: Dictionary = offer_v
			if String(offer["id"]) != comm_id:
				continue
			seen_rows += 1
			if String(offer.get("faction", "")) != comm_flag \
					or int(offer.get("standing", 0)) != ContractDB.standing_of(comm_id):
				bad_terms += 1
	GameState.played_seconds = clock
	print("[contract] THE ROW STATES ITS TERMS %s appeared on %d of 40 boards, rows missing their terms: %d (faction, +%d standing, abandon −%d) -> %s" % [
		comm_id, seen_rows, bad_terms, ContractDB.standing_of(comm_id),
		ContractDB.break_cost(comm_id),
		"PASS" if seen_rows > 0 and bad_terms == 0 else "FAIL"])

	live.active = []
	GameState.faction_deltas = {}
	get_tree().quit()


# --- interdiction harness ---------------------------------------------------

func _pin_raid_idle() -> void:
	# THE PRECONDITIONS OF A CONSOLE-CAMPING CHECK, PINNED WHERE THEY ARE READ.
	#
	# P10 and P11 both ask one question — with a sheet up, is a parked ship
	# sheltered and a moving one not — and both used to set up the world several
	# statements and an `await` before the answer. That window is long enough for
	# `_tick_interdiction` to roll a raid on its own: P9 and P10 leave `_raid_timer`
	# at exactly 0.0, so the first frame in which the tick finds nothing blocking
	# it decrements past zero and SPAWNS. `_raid_active` then latches true, and
	# BOTH reads come back ineligible — which renders as "parked correctly
	# refused, moving wrongly refused", the failure looking like a bug in the rule
	# rather than in the staging.
	#
	# It survived because it needs the roll to land inside one specific frame, and
	# what decides that is how much other work `_process` is doing — so it sat
	# dormant until an unrelated change moved the frame budget and then failed
	# about half the time. A measurement an unrelated dice roll can poison is not
	# measuring the thing it names.
	#
	# `_raid_timer` is the one that matters: zeroing the other two without it
	# leaves the roll armed and merely moves which frame it fires in.
	_raid_active = false
	_raid_cooldown = 0.0
	_raid_timer = RAID_ROLL_INTERVAL


func _run_raid_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	GameState.cargo = {}
	await get_tree().create_timer(0.4).timeout

	# 1. An empty hold, and a modest one, are never worth stopping.
	var empty_chance := interdiction_chance()
	GameState.cargo = {"alloys": 5}                       # 200 -> under the floor
	var small_chance := interdiction_chance()
	GameState.cargo = {"relics": 12}                      # 3120 -> over the floor
	var rich_chance := interdiction_chance()
	print("[raid] CHANCE empty %.2f, hold 200 %.2f, hold 3120 %.2f -> %s" % [
		empty_chance, small_chance, rich_chance,
		"PASS" if empty_chance == 0.0 and small_chance == 0.0 and rich_chance > 0.0 else "FAIL"])

	# 2. Contraband weighs triple, so the same sticker value is three times the
	#    heat. This is the whole reason the smuggling route is a decision.
	GameState.cargo = {"relics": 10}                      # 2600 sticker, 2600 weighted
	var plain := GameState.hold_value(true)
	GameState.cargo = {"contraband": 8}                   # 2720 sticker, 8160 weighted
	var hot := GameState.hold_value(true)
	print("[raid] CONTRABAND WEIGHT relics(10)=%d vs contraband(8)=%d weighted, sticker %d vs %d -> %s" % [
		plain, hot, 2600, 2720,
		"PASS" if hot > plain * 2.5 else "FAIL"])

	# 3. Never during the states where being jumped would be unfair.
	GameState.cargo = {"relics": 40}
	var while_flying := interdiction_eligible()
	_set_boss_active(true)
	var during_boss := interdiction_eligible()
	_set_boss_active(false)
	tutorial.arm()
	var during_tutorial := interdiction_eligible()
	tutorial.skip()
	warping = true
	var during_warp := interdiction_eligible()
	warping = false
	print("[raid] EXCLUSIONS flying=%s boss=%s tutorial=%s warping=%s -> %s" % [
		str(while_flying), str(during_boss), str(during_tutorial), str(during_warp),
		"PASS" if while_flying and not during_boss and not during_tutorial and not during_warp
			else "FAIL"])

	# A console covers two thirds of the screen and does not pause the game, so a
	# raid starting behind one is an ambush the player never got to see coming.
	refit_panel.open()
	await get_tree().process_frame
	var during_refit := interdiction_eligible()
	refit_panel.close_panel()
	chart_panel.open()
	await get_tree().process_frame
	var during_chart := interdiction_eligible()
	chart_panel.close_panel()
	toggle_pause()
	var during_pause := interdiction_eligible()
	toggle_pause()
	await get_tree().create_timer(0.4).timeout
	var after_close := interdiction_eligible()
	print("[raid] CONSOLE SAFE refit=%s chart=%s paused=%s (all false), reopens after=%s -> %s" % [
		str(during_refit), str(during_chart), str(during_pause), str(after_close),
		"PASS" if not during_refit and not during_chart and not during_pause and after_close
			else "FAIL"])

	# 4. A forced raid arrives as a pack from one bearing, tinted, and carrying
	#    somebody else's cargo.
	GameState.cargo = {"relics": 60}                      # rich enough for a corsair
	spawn_interdiction()
	# Measured synchronously, before anyone has flown anywhere: raiders top out
	# at 7.5u/s and separate on contact, so even half a second of drift makes a
	# spawn-formation assertion meaningless.
	var raiders := get_tree().get_nodes_in_group("raider")
	var spread := 0.0
	var centroid := Vector3.ZERO
	for n in raiders:
		centroid += (n as Node3D).global_position
	if raiders.size() > 0:
		centroid /= float(raiders.size())
	for n in raiders:
		spread = maxf(spread, (n as Node3D).global_position.distance_to(centroid))
	var intercept_dist := centroid.distance_to(player.global_position)

	await get_tree().create_timer(0.5).timeout
	var tinted := 0
	var stolen_carriers := 0
	for n in raiders:
		if n is SwarmHostile:
			if (n as SwarmHostile).tint.a > 0.0:
				tinted += 1
			if (n as SwarmHostile).drop_good == "stolen":
				stolen_carriers += 1
	print("[raid] SPAWNED %d raiders (%d tinted, %d carrying stolen), spawn spread %.1fu -> %s" % [
		raiders.size(), tinted, stolen_carriers, spread,
		"PASS" if raiders.size() >= 3 and tinted >= 3 and stolen_carriers == 2 and spread < 4.0
			else "FAIL"])
	# One bearing, at range: an intercept you can see coming and turn away from,
	# not a ring that has already closed.
	print("[raid] INTERCEPT pack arrives %.1fu out on a single bearing (spawn dist %.1f) -> %s" % [
		intercept_dist, RAID_SPAWN_DIST,
		"PASS" if intercept_dist > 8.0 else "FAIL"])
	print("[raid] CORSAIR present=%s at hold value %d (>= %d) -> %s" % [
		str(raiders.size() > tinted), GameState.hold_value(true), RAID_CORSAIR_HOLD,
		"PASS" if raiders.size() > tinted else "FAIL"])

	# 5. A raid never stacks on top of a raid.
	var before_second := get_tree().get_nodes_in_group("raider").size()
	_raid_timer = 0.0
	_tick_interdiction(0.1)
	await get_tree().process_frame
	print("[raid] NO STACK %d -> %d raiders while one is live -> %s" % [
		before_second, get_tree().get_nodes_in_group("raider").size(),
		"PASS" if get_tree().get_nodes_in_group("raider").size() == before_second else "FAIL"])

	# 6. Clearing the pack starts the cooldown rather than immediately re-rolling.
	for n in get_tree().get_nodes_in_group("raider"):
		(n as Node3D).queue_free()
	await get_tree().process_frame
	_tick_interdiction(0.1)
	print("[raid] COOLDOWN active=%s cooldown %.0fs eligible=%s (must be false) -> %s" % [
		str(_raid_active), _raid_cooldown, str(interdiction_eligible()),
		"PASS" if not _raid_active and _raid_cooldown > 80.0 and not interdiction_eligible()
			else "FAIL"])

	# 7. Warping out is the escape hatch: the raid does not follow.
	spawn_interdiction()
	await get_tree().create_timer(0.3).timeout
	var before_warp := get_tree().get_nodes_in_group("raider").size()
	_load_system("pyx01")
	await get_tree().process_frame
	print("[raid] WARP ESCAPE %d raiders -> %d after system change, active=%s -> %s" % [
		before_warp, get_tree().get_nodes_in_group("raider").size(), str(_raid_active),
		"PASS" if before_warp > 0 and get_tree().get_nodes_in_group("raider").is_empty()
			and not _raid_active else "FAIL"])

	# 8. Docking is safe, so an interdiction can never begin while clamped on.
	GameState.cargo = {"relics": 40}
	_raid_cooldown = 0.0
	var port := find_port()
	docked_port = port
	var while_docked := interdiction_eligible()
	docked_port = null
	print("[raid] DOCKED SAFE eligible while clamped on=%s (must be false) -> %s" % [
		str(while_docked), "PASS" if not while_docked else "FAIL"])

	# --- C4: the taper --------------------------------------------------------

	# 9. Interdiction falls off with distance while the expanse's own danger
	#    climbs, which is the trade the whole thing rests on. It must never reach
	#    zero: there is no range at which a full hold is safe, only ranges at
	#    which it is unlikely to be noticed.
	set_deep_generation(false)
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	_raid_active = false
	_raid_cooldown = 0.0
	GameState.cargo = {"relics": 60}
	var edge_r := SystemDB.bounds_of(system_id)
	var probe_at := [4.0, edge_r + 60.0, edge_r + 260.0, edge_r + 700.0, edge_r + 1400.0]
	var chances := []
	var line2 := ""
	for i in range(probe_at.size()):
		player.global_position = Vector3(probe_at[i], 0, 0)
		await get_tree().physics_frame
		var c := interdiction_chance()
		chances.append(c)
		line2 += "%s %.3f  " % [DeepSpace.BAND_NAMES[i], c]
	var falls := true
	for i in range(1, chances.size()):
		if float(chances[i]) >= float(chances[i - 1]):
			falls = false
	var never_zero := true
	for c in chances:
		if float(c) <= 0.0:
			never_zero = false
	print("[raid] TAPER %s-> %s" % [line2,
		"PASS" if falls and never_zero else "FAIL"])
	print("[raid] TAPER FLOOR loaded hold is still hunted in every band (min %.4f > 0) -> %s" % [
		chances.min(), "PASS" if never_zero else "FAIL"])

	# 10. A raid that fires out in the expanse must actually be a raid. The
	#     charted spawn clamp would put the pack back at the system edge — often
	#     hundreds of units behind the player, arriving off radar a minute later.
	player.global_position = Vector3(edge_r + 700.0, 0, 0)
	await get_tree().physics_frame
	_raid_active = false
	_raid_cooldown = 0.0
	spawn_interdiction()
	var far_raiders := get_tree().get_nodes_in_group("raider")
	var worst_dist := 0.0
	var leashed_all := true
	for n in far_raiders:
		worst_dist = maxf(worst_dist, (n as Node3D).global_position.distance_to(player.global_position))
		if n is SwarmHostile and (n as SwarmHostile).despawn_radius <= 0.0:
			leashed_all = false
		if n is Hostile and (n as Hostile).despawn_radius <= 0.0:
			leashed_all = false
	print("[raid] DEEP INTERCEPT %d raiders, furthest %.1fu from the ship (spawn dist %.1f), all leashed=%s -> %s" % [
		far_raiders.size(), worst_dist, RAID_SPAWN_DIST, str(leashed_all),
		"PASS" if far_raiders.size() > 0 and worst_dist < RAID_SPAWN_DIST + 8.0
			and leashed_all else "FAIL"])
	for n in far_raiders:
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false
	_parley_until = 0.0

	# --- the parley -----------------------------------------------------------

	# P1. TOLL BASE, unweighted, with the weighted figure printed beside it. The
	#     manifest halves raid ODDS via hold_signature and contraband triples the
	#     raider roll's read of you — neither may touch the PRICE, or the manifest
	#     double-dips and a chart-data hold tolls toward zero. Wiring the toll to
	#     the weighted value flips this line.
	player.global_position = Vector3(0, 0, 6)
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)     # 3,400 base, weighted x3
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	spawn_interdiction()
	var expect_toll := maxi(TOLL_FLOOR, int(float(GameState.hold_value(false)) * TOLL_FRACTION))
	print("[raid] TOLL BASE unweighted %d -> toll %d (weighted reads %d; pricing off THAT flips this) -> %s" % [
		GameState.hold_value(false), _parley_toll, GameState.hold_value(true),
		"PASS" if _parley_toll == expect_toll and _parley_toll < int(
			float(GameState.hold_value(true)) * TOLL_FRACTION) else "FAIL"])

	# P2. STANDOFF. Six seconds of demand window in which nothing lands — 14's
	#     rule that being jumped must be reactable, applied to the demand itself.
	var shield_at_demand := player.shield
	player.invulnerable = false
	for i in range(90):
		await get_tree().physics_frame
	var standoff_damage := shield_at_demand - player.shield
	player.invulnerable = true
	print("[raid] STANDOFF %.1f damage in the first 1.5s of the demand window (must be 0) -> %s" % [
		standoff_damage, "PASS" if standoff_damage <= 0.0 else "FAIL"])

	# P3. PAY ENDS — the deadlock this feature was almost shipped with. A paid
	#     pack that merely flew away would leave _raid_active true forever:
	#     cooldown never starts, eligibility never recovers, and interdictions
	#     silently stop for the session. depart() sheds groups immediately.
	var toll_before_cargo := GameState.hold_value(false)
	pay_toll()
	var paid_value := toll_before_cargo - GameState.hold_value(false)
	for i in range(30):
		await get_tree().physics_frame
	_tick_interdiction(0.01)
	print("[raid] PAY ENDS raiders %d, _raid_active=%s, cooldown %.0f (deadlock prints 5/true/0) -> %s" % [
		_count_raiders(), str(_raid_active), _raid_cooldown,
		"PASS" if _count_raiders() == 0 and not _raid_active
			and _raid_cooldown > 0.0 else "FAIL"])

	# P3b. A LAPSED RAID CLEANS ITSELF UP — the sibling deadlock, found by
	#      reading rather than by playing, because it takes a session to see.
	#      PAY ENDS covers the pack that was PAID. This covers the pack that
	#      simply stopped caring: paying a toll lifts Tithe standing out of
	#      HOSTILE, and a raider that no longer counts the player as prey has
	#      no target and no leash in charted space. It drifted forever,
	#      _count_raiders() never reached zero, and _raid_active latched for
	#      the session — taking every future raid AND every muster with it.
	#
	#      Both directions in one measurement, because "the pack leaves" alone
	#      is satisfied by a cleanup that ends every raid the instant it begins.
	_clear_faction_matrix()
	GameState.shift_faction(FactionDB.SURVEYOR, "tithe", 3)   # -6 -> -3, WARY
	spawn_interdiction()
	_parley_until = 0.0
	for i_lapse in range(30):
		await get_tree().physics_frame
	_tick_interdiction(0.01)
	var lapsed_left := _count_raiders()
	var lapsed_clear := not _raid_active
	var muster_back := muster_eligible() or not _raid_active
	# The other direction: a banner that DOES want the player keeps its pack.
	_clear_faction_matrix()
	spawn_interdiction()
	_parley_until = 0.0
	for i_hot in range(30):
		await get_tree().physics_frame
	_tick_interdiction(0.01)
	var hostile_stays := _count_raiders() > 0
	for n_cleanup in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n_cleanup) and n_cleanup.has_method("depart"):
			n_cleanup.depart()
	_raid_active = false
	_clear_faction_matrix()
	print("[raid] A LAPSED RAID CLEANS ITSELF UP at WARY: %d raiders left (want 0), _raid_active cleared=%s, eligibility recovered=%s; at HOSTILE the pack stays=%s -> %s" % [
		lapsed_left, str(lapsed_clear), str(muster_back), str(hostile_stays),
		"PASS" if lapsed_left == 0 and lapsed_clear and muster_back
			and hostile_stays else "FAIL"])

	# P4. THE TOLL TAKES HOT CARGO, and pays nothing back. Contraband went first
	#     (weight x value), the removed value covers the toll, and no loot exists
	#     anywhere a departing raider stood.
	var loot_after := 0
	for n in system_root.get_children():
		if n is LootCube:
			loot_after += 1
	print("[raid] TOLL TAKES HOT CARGO removed %d >= toll %d, contraband first, %d cubes dropped by departing raiders -> %s" % [
		paid_value, expect_toll, loot_after,
		"PASS" if paid_value >= expect_toll and loot_after == 0 else "FAIL"])

	# P5. MANIFEST NO DOUBLE DIP. Same hold plus a Forged Manifest: raid odds may
	#     fall (that is the item), the toll may not.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	var toll_plain := maxi(TOLL_FLOOR, int(float(GameState.hold_value(false)) * TOLL_FRACTION))
	GameState.load_cargo("manifest_forged", 1)
	var with_manifest := GameState.hold_value(false)
	var toll_manifest := maxi(TOLL_FLOOR, int(float(with_manifest) * TOLL_FRACTION))
	var manifest_share := int(float(CommodityDB.base_price("manifest_forged")) * TOLL_FRACTION)
	print("[raid] MANIFEST NO DOUBLE DIP toll %d -> %d (+%d is the manifest's own sticker, not a discount) -> %s" % [
		toll_plain, toll_manifest, manifest_share,
		"PASS" if toll_manifest == toll_plain + manifest_share else "FAIL"])

	# P6. TOLL FLOOR. A 1,500 hold demands 400, not 225 — a demand beneath
	#     dignity is a demand nobody reads.
	GameState.cargo = {}
	GameState.load_cargo("alloys", 37)         # 1,480 base
	var floor_toll := maxi(TOLL_FLOOR, int(float(GameState.hold_value(false)) * TOLL_FRACTION))
	print("[raid] TOLL FLOOR %d on a %d hold (15%% alone is %d) -> %s" % [
		floor_toll, GameState.hold_value(false),
		int(float(GameState.hold_value(false)) * TOLL_FRACTION),
		"PASS" if floor_toll == TOLL_FLOOR else "FAIL"])

	# P7. The decision math, printed rather than asserted — the harness bot is
	#     not a pilot, and whether these numbers make paying FEEL right is the
	#     playtest's question, not this line's.
	print("[raid] DECISION fight pays ~+700 in drops / toll costs %d / deep death spills the unread hold" % expect_toll)

	# P8. TOLL MARGIN — printed every run, whether or not it binds. The floor is
	#     safe today only because the cheapest raidable hold (RAID_MIN_HOLD at the
	#     heaviest interdiction weight) still clears it; that is three unrelated
	#     constants holding a rule up between them, so the number gets said out
	#     loud rather than rediscovered.
	var lightest := float(RAID_MIN_HOLD) / CommodityDB.interdiction_weight("charge_unstable")
	print("[raid] TOLL MARGIN cheapest raidable hold is %.1f unweighted vs a %d floor (margin %.1f) -> %s" % [
		lightest, TOLL_FLOOR, lightest - float(TOLL_FLOOR),
		"PASS" if lightest > float(TOLL_FLOOR) else "FAIL"])

	# P9. PARTIAL PAY REFUSED. The manifest's dump button is the first thing that
	#     can shrink a hold mid-standoff; without this guard, one 40-credit alloy
	#     buys a clean exit and credits a toll to the logbook.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	_raid_cooldown = 0.0
	_raid_timer = 0.0
	_raid_active = false
	spawn_interdiction()
	var demanded := _parley_toll
	GameState.cargo = {}
	GameState.load_cargo("alloys", 1)          # 40 base, far under any toll
	var salv_before := GameState.salvage
	pay_toll()
	print("[raid] PARTIAL PAY REFUSED demand %d vs a %d hold: raid still live=%s, cargo kept=%d, salvage unmoved=%s -> %s" % [
		demanded, GameState.hold_value(false), str(_raid_active),
		GameState.cargo_count("alloys"), str(GameState.salvage == salv_before),
		"PASS" if _raid_active and GameState.cargo_count("alloys") == 1 else "FAIL"])
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false

	# P10. CONSOLE CAMPING, both branches. Parked behind a sheet is still shelter
	#      (14's actual claim); flying behind one is not, and the sheet closes as
	#      the klaxon lands so the standoff carries the reactability.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	_raid_cooldown = 0.0
	player.velocity = Vector3.ZERO
	refit_panel.open()
	await get_tree().process_frame
	_pin_raid_idle()
	var parked_ok := not interdiction_eligible()
	player.velocity = Vector3(6.0, 0.0, 0.0)
	var moving_ok := interdiction_eligible()
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().process_frame
	var sheet_closed := not refit_panel.is_open
	player.velocity = Vector3.ZERO
	refit_panel.close_panel()
	print("[raid] CONSOLE CAMPING parked+open ineligible=%s, moving+open eligible=%s, sheet closed by the klaxon=%s -> %s" % [
		str(parked_ok), str(moving_ok), str(sheet_closed),
		"PASS" if parked_ok and moving_ok and sheet_closed else "FAIL"])

	# P11. THE HOLD IS NOT A SHIELD. Same shape as P10, for the new console. A
	#      screen holding the player's whole manifest is exactly the sheet a
	#      pilot would park behind, so it has to sit in console_open() and in
	#      close_consoles_for_raid() like the rest.
	_raid_active = false
	for r0 in get_tree().get_nodes_in_group("raider"):
		(r0 as Node3D).queue_free()
	await get_tree().process_frame
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	_raid_cooldown = 0.0
	player.velocity = Vector3.ZERO
	hold_screen.open()
	await get_tree().process_frame
	_pin_raid_idle()
	var h_parked := not interdiction_eligible()
	player.velocity = Vector3(6.0, 0.0, 0.0)
	var h_moving := interdiction_eligible()
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().process_frame
	var h_closed := not hold_screen.is_open
	print("[raid] THE HOLD IS NOT A SHIELD parked+open ineligible=%s, moving+open eligible=%s, closed by the klaxon=%s -> %s" % [
		str(h_parked), str(h_moving), str(h_closed),
		"PASS" if h_parked and h_moving and h_closed else "FAIL"])

	# P12. AND IT REOPENS UNDER THE KLAXON. The other half, and the one a
	#      "be consistent with the other consoles" change would break: pay_toll's
	#      own guard exists BECAUSE the manifest gives the player a dump button,
	#      and jettisoning down to what the pack will accept is a play the raid
	#      was designed around. _raid_active gates the ROLL, never the console.
	player.velocity = Vector3.ZERO
	hold_screen.open()
	await get_tree().process_frame
	var reopened := hold_screen.is_open
	var toll_before := GameState.cargo_used()
	pay_toll()
	await get_tree().process_frame
	var settled: bool = GameState.cargo_used() < toll_before
	print("[raid] THE HOLD REOPENS UNDER THE KLAXON raid live=%s, reopened=%s, toll settled with it open (%d->%d) -> %s" % [
		str(_raid_active or true), str(reopened), toll_before, GameState.cargo_used(),
		"PASS" if reopened and settled else "FAIL"])
	hold_screen.close_panel()

	# A PAID TOLL DOES NOT END THE RAIDS. interdiction_eligible used to require
	# the Tithe to be exactly HOSTILE. Baseline is -6, HOSTILE spans -6..-4, and
	# pay_toll grants +1 through the one mutator -- so THREE PAID TOLLS walked the
	# banner to WARY and no raid ever spawned again for the rest of the save,
	# taking the interdiction, the parley and PERSUASION's only feed with it. The
	# most reasonable answer to a demand permanently deleted the encounter, and
	# the tap closing is indistinguishable from a run of quiet dice.
	#
	# THREE CLAUSES, and the third is the one that stops this passing on a build
	# that simply deleted the standing test: paying has to still BUY something.
	# Peace is a rate now, not a switch.
	_clear_faction_matrix()
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	var hostile_chance := interdiction_chance()
	var hostile_band := GameState.faction_band(FactionDB.SURVEYOR, "tithe")
	# Walk it out of HOSTILE the way a player does -- through the real mutator,
	# once per toll, not by assigning the delta.
	for toll_i in range(3):
		GameState.shift_faction(FactionDB.SURVEYOR, "tithe", 1, true)
	var wary_band := GameState.faction_band(FactionDB.SURVEYOR, "tithe")
	_pin_raid_idle()
	var still_eligible := interdiction_eligible()
	var wary_chance := interdiction_chance()
	_clear_faction_matrix()
	GameState.cargo = {}
	print("[raid] A PAID TOLL DOES NOT END THE RAIDS %s -> three tolls -> %s; still eligible=%s, odds %.3f -> %.3f (must be lower, and must not be zero) -> %s" % [
		FactionDB.BAND_NAMES[hostile_band], FactionDB.BAND_NAMES[wary_band],
		str(still_eligible), hostile_chance, wary_chance,
		"PASS" if hostile_band == FactionDB.Band.HOSTILE
			and wary_band == FactionDB.Band.WARY and still_eligible
			and wary_chance > 0.0 and wary_chance < hostile_chance else "FAIL"])

	# --- playtest round 4: the demand's options and their controls -----------

	# EVERY OPTION THE DEMAND NAMES HAS A CONTROL, and this is the assertion
	# whose absence let round 4 happen. Twelve checks above call pay_toll() as a
	# FUNCTION; not one of them ever asked whether a player could reach it. So
	# the parley shipped with a prompt naming three answers, one plate on the
	# screen, and every line in this file green.
	#
	# THE RULE, not the rendering: for each verb the prompt names, there is a
	# control that is VISIBLE, ENABLED and at least the project's own tap floor,
	# and pressing it resolves the standoff. Driven off the prompt text itself,
	# so the two cannot drift — change the copy to promise a fourth thing and
	# this goes red rather than the player finding out.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	GameState.smuggling = 0
	GameState.persuasion = 0
	_pin_raid_idle()
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().process_frame
	await get_tree().process_frame
	var demand_line := hud.prompt_text()
	var plates := {"PAY": "parley", "REFUSE": "refuse", "TALK": "bluff"}
	var rects := hud.band_rects()
	var controls := hud.band_controls()
	var missing := ""
	var worst_plate := 9999.0
	for verb in plates:
		if not demand_line.contains(String(verb)):
			continue
		var c: Control = controls.get(String(plates[verb])) as Control
		if c == null or not c.visible or c.disabled:
			missing += "%s " % String(verb)
			continue
		var h: float = maxf(c.get_combined_minimum_size().y, c.size.y)
		worst_plate = minf(worst_plate, h)
	# THE THIRD PLATE, which the prompt does NOT name and which must be there
	# anyway on a pilot who has never smuggled anything: PERSUASION's floor is
	# what stops a new player meeting a demand with one button, and a build that
	# regressed it would still satisfy the loop above (the prompt says PAY and
	# REFUSE, and both would be present).
	var talk_offered: bool = (controls.get("bluff") as Control).visible
	var tap_ok: bool = worst_plate >= HoldScreen.HoldGrid.TAP_MIN
	print("[raid] EVERY OPTION THE DEMAND NAMES HAS A CONTROL '%s' -> unreachable: %s; smallest plate %.0fpx against a %.0f floor; a pilot at smuggling 0 is still offered the talk-down=%s -> %s" % [
		demand_line, missing if missing != "" else "none", worst_plate,
		HoldScreen.HoldGrid.TAP_MIN, str(talk_offered),
		"PASS" if missing == "" and tap_ok and talk_offered
			and demand_line != "" else "FAIL"])

	# REFUSING ENDS THE STANDOFF, driven THROUGH THE BUTTON rather than by
	# calling break_parley — the exact gap that let the missing affordance ship.
	# Both halves: the pack stops holding fire, and the sheet comes down with it.
	var refuse_plate := controls.get("refuse") as Button
	var held_before := 0
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n) and float(n.get("standoff")) > 0.0:
			held_before += 1
	refuse_plate.emit_signal("pressed")
	await get_tree().process_frame
	var held_after := 0
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n) and float(n.get("standoff")) > 0.0:
			held_after += 1
	var plates_down: bool = not (controls.get("parley") as Control).visible \
		and not refuse_plate.visible
	print("[raid] REFUSING ENDS THE STANDOFF %d raiders holding fire -> %d after the button, plates withdrawn=%s -> %s" % [
		held_before, held_after, str(plates_down),
		"PASS" if held_before > 0 and held_after == 0 and plates_down
			and _parley_until <= 0.0 else "FAIL"])
	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false

	# THE SENTENCE SURVIVES THE DEMAND. The prompt is the only thing on screen
	# that says what the plates do, and it had three separate ways to vanish
	# while they were still up — which is a player looking straight at a PAY
	# button and reporting that there was no way to accept.
	#
	# NO SLEEP AND NO TIMER. The first draft waited four seconds past the old
	# 3.2s self-destruct, and spent its evening measuring whichever of this
	# suite's shared raid timers happened to fire — §49's lesson that a check
	# whose setup is elaborate is measuring a world, not a rule. Every clobberer
	# is driven explicitly instead, so each clause names the defect it catches.
	GameState.cargo = {}
	GameState.load_cargo("contraband", 10)
	_pin_raid_idle()
	_raid_timer = 0.0
	spawn_interdiction()
	await get_tree().process_frame
	var demand_up := hud.prompt_text()
	# a. A BARK. Barks write the same label unconditionally, and `first_hostiles`
	#    is by definition unfired the first time a player is ever interdicted.
	Barks.fire("first_hostiles")
	# b. A PROXIMITY PROMPT. derelict, seam, port and mast all call prompt() and
	#    clear_prompt() raw as the ship drifts in and out of range.
	hud.prompt("A DERELICT IS WITHIN RANGE")
	hud.clear_prompt()
	await get_tree().process_frame
	var demand_held := hud.prompt_text()
	# c. AND THE BARK WAS ONLY DEFERRED, not spent. A line that fires once ever
	#    must not be consumed by being suppressed — the reason the guard sits
	#    above mark_bark rather than below it.
	var bark_kept: bool = not GameState.has_seen_bark("first_hostiles")
	# d. THE LOCK DOES NOT OUTLIVE THE PLATES. Every path that ends a parley goes
	#    through hide_parley, which is where the line is handed back.
	refuse_toll()
	await get_tree().process_frame
	hud.prompt("THE WORLD GETS ITS LINE BACK")
	await get_tree().create_timer(0.4).timeout
	var released := hud.prompt_text()
	print("[raid] THE SENTENCE SURVIVES THE DEMAND raised as '%s'; after a bark, a proximity prompt and a raw clear it reads '%s'; the bark was deferred not spent=%s; after refusing, the world gets the line back as '%s' -> %s" % [
		demand_up, demand_held, str(bark_kept), released,
		"PASS" if demand_up.contains("RAIDERS") and demand_held == demand_up
			and bark_kept and released == "THE WORLD GETS ITS LINE BACK"
			else "FAIL"])

	# AND A PROMPT RAISED INTO A CLEAR IS ACTUALLY VISIBLE. The defect under all
	# of the above, and the one that best explains the report: prompt() faded IN
	# over 0.2s and clear_prompt() faded OUT over 0.25s, neither killing the
	# other's tween, so the older fade-out finished last and won. Correct text,
	# correct visibility, alpha 0.00 — and spawn_interdiction calls
	# close_consoles_for_raid, which clears the prompt, one line before raising
	# the demand. The demand could extinguish its own explanation on arrival.
	hud.clear_prompt()
	hud.prompt("THIS MUST BE LEGIBLE")
	await get_tree().create_timer(0.5).timeout
	var raced := hud.prompt_text()
	var raced_alpha: float = hud._prompt_label.modulate.a
	hud.clear_prompt()
	print("[raid] A PROMPT RAISED INTO A CLEAR IS VISIBLE text '%s' at alpha %.2f (the racing tweens landed the right words at 0.00) -> %s" % [
		raced, raced_alpha,
		"PASS" if raced == "THIS MUST BE LEGIBLE" and raced_alpha > 0.9
			else "FAIL"])

	# §121. A REFUSAL OWNS THE LINE FOR A MOMENT. The defect §113 spent a red on
	# was narrower than "the prompt is crowded": a NUDGE replaced a REFUSAL on
	# the first-ever tap, for the pilot least able to guess. Four clauses, and
	# the ordering they establish is
	#     the parley's hard lock  >  a live refusal  >  everything else.
	#
	# Driven rather than waited out -- the hold is two seconds of wall clock and
	# the harness sets the deadline directly, `_spill_claim_left`'s own posture:
	# "25s of harness time to prove a branch is off is 25s nobody will spend".
	hud._prompt_held = false
	hud._prompt_soft_until = 0.0
	hud.clear_prompt()
	hud.prompt_refusal("THE NOTATION IS NOT YOURS")
	hud.clear_prompt()
	await get_tree().create_timer(0.3).timeout
	var refusal_kept := hud.prompt_text()
	# b. AND A ONCE-EVER BARK IS DEFERRED, NOT SPENT. The regression this lock
	#    would otherwise have introduced, and the reason prompt_busy() exists:
	#    Barks.fire guards on the HARD lock before mark_bark ("a bark that fires
	#    once ever must not be consumed by being suppressed") and then writes --
	#    so a soft lock with no ask-first accessor would have gone on marking
	#    barks seen while the write was quietly declined. `first_hostiles` is
	#    still unfired here: the leg above deferred it under the demand and
	#    asserted so.
	Barks.fire("first_hostiles")
	await get_tree().process_frame
	var bark_deferred: bool = not GameState.has_seen_bark("first_hostiles") \
		and hud.prompt_text() == "THE NOTATION IS NOT YOURS"
	# c. AND AN ACT IS ALWAYS ANSWERED. The clause this leg's own red earned.
	#    The first draft of the lock blocked WRITES as well as clears, so a live
	#    refusal swallowed the next thing the player tapped -- `THE MONUMENT
	#    ANSWERS A TAP` went red with a warden refusal standing in for both a
	#    locked monument's answer and a claimed one's. A deadline is a statement
	#    about the line on screen, never a mute on the world.
	hud.prompt("THE CHART CARRIES ITS JUMP")
	await get_tree().process_frame
	var act_answered := hud.prompt_text()
	# d. A REFUSAL REPLACES A REFUSAL. The newest one is the one the player just
	#    earned, so this must NOT be a first-writer-wins lock.
	hud.prompt_refusal("THE GROUND IS NOT SOUNDED")
	await get_tree().process_frame
	var refusal_replaced := hud.prompt_text()
	# e. AND THE DEMAND OUTRANKS IT. hold_prompt clears the soft deadline before
	#    it writes; without that line a refusal would refuse the one sentence in
	#    this game that gets six seconds while something closes on the player.
	hud.hold_prompt("RAIDERS DEMAND 400 SALVAGE — PAY OR REFUSE")
	await get_tree().process_frame
	var demand_wins := hud.prompt_text()
	hud.hide_parley()
	# f. AND IT LAPSES. Not a lock the world never gets back -- with the deadline
	#    passed, the next ambient line lands normally.
	hud._prompt_soft_until = 0.0
	hud.prompt("THE WORLD GETS IT BACK AGAIN")
	await get_tree().process_frame
	var lapsed := hud.prompt_text()
	print("[raid] A REFUSAL SURVIVES A CLEAR held through a raw clear_prompt ('%s'); a once-ever bark deferred not spent=%s; but an ACT is always answered ('%s'); a second refusal replaces it ('%s'); the demand outranks both ('%s'); and it lapses ('%s') -> %s" % [
		refusal_kept, str(bark_deferred), act_answered, refusal_replaced,
		demand_wins, lapsed,
		"PASS" if refusal_kept == "THE NOTATION IS NOT YOURS" and bark_deferred
			and act_answered == "THE CHART CARRIES ITS JUMP"
			and refusal_replaced == "THE GROUND IS NOT SOUNDED"
			and demand_wins.contains("RAIDERS")
			and lapsed == "THE WORLD GETS IT BACK AGAIN" else "FAIL"])

	# §121. AND THE LINE WRAPS. §105 asked for "a device rather than a guess",
	# and this asserts the DEVICE rather than any sentence's length: a copy edit
	# must not redden it, and turning the wrap off must. The box is also checked
	# to be narrower than the design space, since a width that silently grew past
	# 720 would stop wrapping while still looking configured.
	var wrap_on: bool = hud._prompt_label.autowrap_mode \
		== TextServer.AUTOWRAP_WORD_SMART
	var box_w: float = hud._prompt_label.custom_minimum_size.x
	var boxed: bool = box_w > 0.0 and box_w < 720.0
	# Reported, not asserted: which prompt is the longest and whether it needs
	# the box at all. CANNOT_READ is 124 characters against a next-longest of 83,
	# so this is one outlier and not a policy -- and if a later edit makes every
	# prompt short, that is worth SEEING rather than going red over.
	var font := ThemeDB.fallback_font
	var widest := 0.0
	if font != null:
		widest = font.get_string_size(SoundingMark.CANNOT_READ,
			HORIZONTAL_ALIGNMENT_LEFT, -1, 16).x
	print("[raid] THE PROMPT LINE WRAPS autowrap on=%s, box %.0fpx inside a 720 design space=%s (the longest prompt measures %.0fpx, %s the box) -> %s" % [
		str(wrap_on), box_w, str(boxed), widest,
		"over" if widest > box_w else "inside",
		"PASS" if wrap_on and boxed else "FAIL"])

	for n in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(n):
			(n as Node3D).queue_free()
	await get_tree().physics_frame
	_raid_active = false
	_parley_until = 0.0
	if hud:
		hud.hide_parley()
		hud.clear_prompt()
	get_tree().quit()


# --- pause harness ----------------------------------------------------------

func _run_pause_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_apex_wake_timer = -1.0
	_wave_timer = 1.0e9
	await get_tree().create_timer(0.4).timeout

	# A live scene: moving hostiles, drifting loot, a ship under orders.
	for i in range(5):
		var s := SwarmHostile.new()
		s.difficulty = 1.0
		system_root.add_child(s)
		s.global_position = player.global_position + Vector3(randf_range(-8, 8), 0, randf_range(-8, 8))
	spawn_loot(system_root, player.global_position + Vector3(9, 0, 9))
	player.command_move(player.global_position + Vector3(20, 0, 0))
	await get_tree().create_timer(1.0).timeout

	toggle_pause()
	print("[pause] OPEN menu=%s tree.paused=%s (both must be true)" % [
		str(pause_menu.is_open), str(get_tree().paused)])

	# Snapshot everything that moves, wait two real seconds, and compare. Timers
	# created with ignore_time_scale still fire while paused, which is what lets
	# this measure a genuinely frozen world rather than a slow one.
	var before := _pause_world_snapshot(player)
	await get_tree().create_timer(2.0, true, false, true).timeout
	var after := _pause_world_snapshot(player)
	var drift := 0.0
	for key in before:
		if after.has(key):
			drift = maxf(drift, (before[key] as Vector3).distance_to(after[key]))
	print("[pause] FROZEN %d bodies, max drift over 2s = %.4f (must be 0) -> %s" % [
		before.size(), drift, "PASS" if drift < 0.0001 and before.size() >= 6 else "FAIL"])

	# Music and settings must stay live behind the scrim, or the sliders are
	# decoration. Both run PROCESS_MODE_ALWAYS for exactly this reason.
	var music_alive := Music.is_playing()
	GameState.set_setting("music_vol", 0.25)
	var music_bus := AudioServer.get_bus_index(Sfx.BUS_MUSIC)
	var quiet_db := AudioServer.get_bus_volume_db(music_bus)
	GameState.set_setting("music_vol", 1.0)
	var loud_db := AudioServer.get_bus_volume_db(music_bus)
	print("[pause] SETTINGS LIVE music playing=%s  vol 0.25 -> %.1fdB, 1.0 -> %.1fdB -> %s" % [
		str(music_alive), quiet_db, loud_db,
		"PASS" if music_alive and quiet_db < loud_db - 6.0 else "FAIL"])

	# Screen shake is a setting the camera has to actually respect.
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	# Zeroed before each probe. `_shake_amp` is a shared accumulator that ANYTHING
	# can write — a swarm fighter dying nearby adds 0.03 — so reading it straight
	# after rig.shake() only measures the setting if nothing else got there first.
	# This harness stands up a deliberately live scene, and once the ship started
	# returning fire on its own it began killing that scene mid-measurement.
	GameState.set_setting("shake", false)
	rig.set("_shake_amp", 0.0)
	rig.shake(0.5)
	var shake_off: float = rig.get("_shake_amp")
	GameState.set_setting("shake", true)
	rig.set("_shake_amp", 0.0)
	rig.shake(0.5)
	var shake_on: float = rig.get("_shake_amp")
	print("[pause] SHAKE SETTING off -> %.2f, on -> %.2f -> %s" % [
		shake_off, shake_on, "PASS" if shake_off == 0.0 and shake_on > 0.0 else "FAIL"])

	# UI scale composes with the automatic rule rather than replacing it.
	var desktop := Vector2(1440, 900)
	var phone := Vector2(1170, 2532)
	UILayout.user_scale = 1.0
	var auto_desktop := UILayout.content_factor(desktop)
	var auto_phone := UILayout.content_factor(phone)
	UILayout.user_scale = 1.25
	var scaled_desktop := UILayout.content_factor(desktop)
	var scaled_phone := UILayout.content_factor(phone)
	UILayout.user_scale = 1.0
	print("[pause] UI SCALE desktop %.3f -> %.3f (x1.25), phone %.3f -> %.3f -> %s" % [
		auto_desktop, scaled_desktop, auto_phone, scaled_phone,
		"PASS" if is_equal_approx(scaled_desktop, auto_desktop * 1.25)
			and is_equal_approx(scaled_phone, auto_phone * 1.25) else "FAIL"])

	# Resuming puts the world back in motion.
	toggle_pause()
	var resumed_before := _pause_world_snapshot(player)
	await get_tree().create_timer(1.0).timeout
	var resumed_after := _pause_world_snapshot(player)
	var moved := 0.0
	for key in resumed_before:
		if resumed_after.has(key):
			moved = maxf(moved, (resumed_before[key] as Vector3).distance_to(resumed_after[key]))
	print("[pause] RESUMED menu=%s tree.paused=%s max motion %.2f -> %s" % [
		str(pause_menu.is_open), str(get_tree().paused), moved,
		"PASS" if not pause_menu.is_open and not get_tree().paused and moved > 0.05 else "FAIL"])

	# ABANDON TO TITLE is only reachable from the pause menu, so nothing else
	# exercises it — and it unwinds a lot at once: closes consoles, undocks,
	# clears boss state, drops the pending dock, rebuilds the world in attract
	# form. A failure here strands the player at a half-torn-down session.
	_enter_playing()
	var port := find_port()
	if port != null:
		player.global_position = port.dock_point
		_complete_dock(port)
		await get_tree().create_timer(0.4).timeout
	_set_boss_active(true)
	toggle_pause()
	await get_tree().create_timer(0.3).timeout
	# Granted, then compared against itself. This used to assert `salvage > 0`
	# without ever paying the player any, so what it really asked was "did a wave
	# happen to spawn and a kill happen to land in the preceding half second" --
	# it read 90 on one run and 0 on the next with no code change between them.
	# It only ever looked stable because it was reading the developer's save.
	# §8: when a value holds by luck, assert the invariant, not the instance. The
	# invariant is that abandoning PRESERVES the run, and that needs a known
	# number on both sides of the call.
	GameState.add_salvage(4242)
	var keep_salvage := GameState.salvage
	var keep_system := GameState.current_system
	abandon_to_title()
	await get_tree().create_timer(0.5).timeout
	var clean := state == State.ATTRACT \
		and not get_tree().paused \
		and not pause_menu.is_open \
		and docked_port == null \
		and not boss_active \
		and not port_panel.is_open \
		and title_screen.visible
	print("[pause] ABANDON state=%s paused=%s docked=%s boss=%s panel=%s title=%s -> %s" % [
		"ATTRACT" if state == State.ATTRACT else "PLAYING", str(get_tree().paused),
		str(docked_port != null), str(boss_active), str(port_panel.is_open),
		str(title_screen.visible), "PASS" if clean else "FAIL"])
	# The run itself is untouched: abandoning is leaving the cockpit, not
	# discarding progress.
	# Both halves, and the first half matters: `before == after` alone is vacuous
	# when both are zero, which is exactly the state a pinned harness starts in.
	# Requiring something to have been there is what makes this measure
	# preservation rather than absence.
	print("[pause] ABANDON KEEPS RUN salvage %d -> %d (had some=%s), system '%s' -> '%s' -> %s" % [
		keep_salvage, GameState.salvage, str(keep_salvage > 0),
		keep_system, GameState.current_system,
		"PASS" if keep_salvage > 0 and GameState.salvage == keep_salvage \
			and GameState.current_system == keep_system else "FAIL"])

	# Pausing behind the title screen is meaningless and must be refused.
	toggle_pause()
	print("[pause] ATTRACT REFUSED menu=%s tree.paused=%s (both must be false) -> %s" % [
		str(pause_menu.is_open), str(get_tree().paused),
		"PASS" if not pause_menu.is_open and not get_tree().paused else "FAIL"])
	get_tree().quit()


func _pause_world_snapshot(player: Node3D) -> Dictionary:
	var out := {}
	out[player.get_instance_id()] = player.global_position
	for group in ["hostiles", "apex_probe"]:
		for n in get_tree().get_nodes_in_group(group):
			var node := n as Node3D
			if is_instance_valid(node):
				out[node.get_instance_id()] = node.global_position
	# Loot cubes are in no group; they are children of the system root.
	for child in system_root.get_children():
		if child is LootCube:
			out[child.get_instance_id()] = (child as Node3D).global_position
	return out


# --- radar harness ----------------------------------------------------------

func _run_radar_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	set_deep_generation(false)
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().create_timer(0.5).timeout

	# Headless defaults to a 160x160 viewport, which is smaller than the marker
	# geometry itself — every assertion below is about screen position, so give
	# it the real design resolution to measure against.
	get_window().size = Vector2i(720, 1280)
	await get_tree().process_frame
	await get_tree().process_frame
	var rect := get_viewport().get_visible_rect()
	var centre := rect.size * 0.5
	print("[radar] viewport %.0fx%.0f" % [rect.size.x, rect.size.y])

	player.global_position = Vector3(0, 0, 6)
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	rig.global_position = Vector3(0, 0, 6)

	var bogey := SwarmHostile.new()
	bogey.difficulty = 0.0
	bogey.hp_scale = 40.0
	system_root.add_child(bogey)

	# 1. A contact the player can already see must NOT ping. Checked per-contact
	#    rather than by counting: the system's own port and derelict are legitimately
	#    off screen from the spawn point, and they should ping.
	bogey.global_position = player.global_position + Vector3(2.0, 0, 0)
	bogey.dock_at(bogey.global_position)
	await get_tree().create_timer(0.4).timeout
	var near_ping := _radar_marker_for(bogey)
	print("[radar] ON-SCREEN contact 2u away pings=%s (must be false) — %d other markers" % [
		str(not near_ping.is_empty()), hud.radar_markers().size()])

	# 2. The same contact well off screen on +X must ping on the RIGHT border.
	bogey.global_position = player.global_position + Vector3(34, 0, 0)
	bogey.dock_at(bogey.global_position)
	await get_tree().create_timer(0.4).timeout
	var far_ping := _radar_marker_for(bogey)
	var right_edge := not far_ping.is_empty() \
		and (far_ping["pos"] as Vector2).x > centre.x + rect.size.x * 0.25
	print("[radar] BEARING +X contact -> marker at (%.0f, %.0f), right of centre=%s -> %s" % [
		(far_ping["pos"] as Vector2).x if not far_ping.is_empty() else -1.0,
		(far_ping["pos"] as Vector2).y if not far_ping.is_empty() else -1.0,
		str(right_edge), "PASS" if near_ping.is_empty() and right_edge else "FAIL"])

	# 3. Every marker must land inside the viewport, whatever the bearing. This
	#    is the assertion that catches the behind-the-camera projection case,
	#    where unproject_position mirrors the point and the arrow would fly off.
	var inside := true
	var worst := ""
	for ang in range(0, 360, 15):
		var r := deg_to_rad(float(ang))
		bogey.global_position = player.global_position + Vector3(cos(r), 0, sin(r)) * 34.0
		bogey.dock_at(bogey.global_position)
		await get_tree().create_timer(0.12).timeout
		for marker in hud.radar_markers():
			var p: Vector2 = marker["pos"]
			if p.x < 0.0 or p.y < 0.0 or p.x > rect.size.x or p.y > rect.size.y:
				inside = false
				worst = "bearing %d -> (%.0f, %.0f)" % [ang, p.x, p.y]
	print("[radar] ON SCREEN every marker inside the viewport at all 24 bearings -> %s %s" % [
		"PASS" if inside else "FAIL", worst])

	# 3b. THE READOUT FOLLOWS THE HEADING. The cockpit's answer to the six
	#     channels that hand out bearings. Driven by turning the real ship and
	#     reading the RENDERED label -- an assertion that recomputed the bearing
	#     would agree with itself while the label showed a heading from ten
	#     seconds ago, which is what cargo_text() and _chrome_height() were both
	#     added to stop.
	#
	#     Parked deliberately: with no speed and no target PlayerShip leaves
	#     rotation.y alone, so this measures the readout rather than the
	#     autopilot, and it exercises the "a parked ship holds its heading"
	#     property at the same time.
	player.velocity = Vector3.ZERO
	player.has_move_target = false
	if player.has_method("clear_target"):
		player.clear_target()
	var hdg_rows := ""
	var hdg_ok := true
	var hdg_last := ""
	# THE CARDINALS ARE WRITTEN OUT, NOT DERIVED, and that is the whole point of
	# this check now. The old version staged a yaw from a number and expected the
	# same number back, which is true of ANY convention -- it would have passed
	# just as happily on the one that printed `HDG 270 · NORTH`. Naming the four
	# directions and the digits a player expects beside them is the only form
	# that can fail when the compass is wrong.
	for spec_v in [
		{"dir": Vector3(0, 0, -1), "deg": 0, "word": "NORTH"},
		{"dir": Vector3(1, 0, 0), "deg": 90, "word": "EAST"},
		{"dir": Vector3(0, 0, 1), "deg": 180, "word": "SOUTH"},
		{"dir": Vector3(-1, 0, 0), "deg": 270, "word": "WEST"},
	]:
		var spec: Dictionary = spec_v
		var d: Vector3 = spec["dir"]
		# The inverse of hud's -basis.z read: yaw whose forward vector IS d.
		player.rotation.y = atan2(-d.x, -d.z)
		await get_tree().process_frame
		await get_tree().process_frame
		var want := "HDG %03d · %s" % [int(spec["deg"]), String(spec["word"])]
		var got := hud.heading_text()
		hdg_rows += "%s|" % got
		if got != want:
			hdg_ok = false
			hdg_rows += "(want %s)" % want
		hdg_last = got
	# And it must still be MOVING at the end -- a label latched by a broken
	# rate-limit would have matched every row above if the first one happened
	# to be right and nothing ever rebuilt it.
	player.rotation.y = atan2(-cos(0.0), -sin(0.0))
	await get_tree().process_frame
	await get_tree().process_frame
	var hdg_moves: bool = hud.heading_text() != hdg_last
	print("[radar] THE READOUT FOLLOWS THE HEADING %s all four cardinals=%s, still updating after the last=%s -> %s" % [
		hdg_rows, str(hdg_ok), str(hdg_moves),
		"PASS" if hdg_ok and hdg_moves else "FAIL"])

	# 4. v15. THE ENGINE IS NOT ON THE MAP UNTIL YOU ARE ON TOP OF IT.
	#
	#    The apex marker used to render at ANY distance: top tier, never dropped
	#    by the twelve-slot cap, alpha floored at 0.3 so distance could not fade
	#    it out. Harmless while the engine sat in plain sight inside the charted
	#    volume — and fatal once it hides, because a permanent red arrow pointing
	#    at the lair answers the whole hunt before the first hint is ever bought.
	#
	#    BOTH DIRECTIONS, because a radar that never drew the engine at all would
	#    satisfy the first half and lose the encounter's only close-range tell.
	#    Identified by INSTANCE ID rather than by marker size: the deep compass
	#    that appears past the chart edge also draws at SIZE_APEX, and matching on
	#    size would call that home arrow a boss and pass on the wrong marker.
	bogey.queue_free()
	GameState.mark_breached(system_id)
	_apex_wake_timer = -1.0
	var boss := _find_apex()
	await get_tree().create_timer(0.4).timeout
	var out_at := player.global_position.distance_to(boss.global_position)
	var marked_far := not _radar_marker_for(boss).is_empty()
	# Between WAKE_RANGE (60) and DETECT_RANGE (90) on purpose: close enough that
	# the instruments admit the engine is there, not so close that arriving starts
	# the fight and turns this into a boss harness.
	var close_at := ApexBoss.DETECT_RANGE * 0.8
	player.global_position = boss.global_position + Vector3(0, 0, close_at)
	rig.global_position = player.global_position
	await get_tree().create_timer(0.4).timeout
	var marked_near := not _radar_marker_for(boss).is_empty()
	print("[radar] THE ENGINE IS NOT ON THE MAP marker at %.0fu=%s (must be false), at %.0fu=%s (must be true), cutoff %.0f -> %s" % [
		out_at, str(marked_far), close_at, str(marked_near), ApexBoss.DETECT_RANGE,
		"PASS" if not marked_far and marked_near else "FAIL"])

	# 5. The cap holds, and the apex survives it: 30 contacts is more than the
	#    twelve slots, and the boss is the one that must never be dropped.
	#
	#    RUN FROM WHERE THE ENGINE IS DETECTABLE, which it was not before v15
	#    moved the lair. Staged at the origin the boss is 300u away and no longer
	#    on the board at all, so "apex_kept" would have been reporting the cutoff
	#    working rather than the cap sparing the boss — and it was only printed,
	#    never asserted, so it would have said false forever without failing.
	for i in range(30):
		var s := SwarmHostile.new()
		s.difficulty = 0.0
		s.hp_scale = 40.0
		system_root.add_child(s)
		var a := TAU * float(i) / 30.0
		s.global_position = player.global_position + Vector3(cos(a), 0, sin(a)) * 30.0
		s.dock_at(s.global_position)
	await get_tree().create_timer(0.6).timeout
	var all := hud.radar_markers()
	var apex_marker := not _radar_marker_for(boss).is_empty()
	print("[radar] CAP %d markers with %d contacts + apex, <= %d, apex kept=%s -> %s" % [
		all.size(), 30, HUD.RadarLayer.MAX_MARKERS, str(apex_marker),
		"PASS" if all.size() <= HUD.RadarLayer.MAX_MARKERS and apex_marker else "FAIL"])

	# 6. Attract mode is the system, not the cockpit — no arrows over the title.
	hud.set_chrome_visible(false)
	await get_tree().create_timer(0.3).timeout
	print("[radar] HIDDEN with chrome off: %d markers (must be 0) -> %s" % [
		hud.radar_markers().size(),
		"PASS" if hud.radar_markers().is_empty() else "FAIL"])
	get_tree().quit()


func _radar_marker_for(node: Node3D) -> Dictionary:
	for m in hud.radar_markers():
		if int(m["id"]) == node.get_instance_id():
			return m
	return {}


# --- music harness ----------------------------------------------------------

func _run_music_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	_wave_timer = 1.0e9
	# Arriving in an already-breached system arms the apex, and a live engine is
	# a threat by definition — which is correct, and which would otherwise pin
	# the mix to combat for the whole harness. The boss path gets its own
	# assertion at the end instead.
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.4).timeout

	print("[music] layers loaded=%s  playing=%s (both must be true)" % [
		str(Music.available()), str(Music.is_playing())])

	# The whole design rests on the two layers being the same length, so that a
	# crossfade never moves the harmony. Assert it rather than trusting the
	# generator.
	var calm := load("res://audio/music_calm.wav") as AudioStreamWAV
	var combat := load("res://audio/music_combat.wav") as AudioStreamWAV
	# All FOUR stems, in frames rather than in bytes. The old version compared
	# two byte counts to each other, which is why it stayed green while both
	# loop points were computed from compressed QOA bytes as if they were PCM
	# frames -- see PYXIS_FEELTEST's COMPRESSED STREAM.
	var deep := load("res://audio/music_deep.wav") as AudioStreamWAV
	var quiet := load("res://audio/music_quiet.wav") as AudioStreamWAV
	var frames: Array = []
	for st in [calm, combat, deep, quiet]:
		frames.append(Sfx.frame_count(st) if st != null else -1)
	var same: bool = frames.size() == 4 and frames.count(frames[0]) == 4 and int(frames[0]) > 0
	print("[music] LOOP ALIGN calm/combat/deep/quiet frames %s -> %s" % [
		str(frames), "PASS" if same else "FAIL"])

	# Calm with nothing around.
	await get_tree().create_timer(Music.FADE_OUT + 0.6).timeout
	var calm_blend := Music.blend()
	print("[music] CALM blend %.2f (must be ~0)" % calm_blend)

	# A contact inside the threat radius must pull the mix over.
	var bogey := SwarmHostile.new()
	bogey.difficulty = 0.0
	bogey.hp_scale = 40.0
	system_root.add_child(bogey)
	bogey.global_position = player.global_position + Vector3(0, 0, Music.THREAT_RADIUS * 0.4)
	bogey.dock_at(bogey.global_position)
	await get_tree().create_timer(Music.FADE_IN + 0.8).timeout
	var hot_blend := Music.blend()
	print("[music] THREAT blend %.2f (must be ~1)" % hot_blend)

	# And releasing it must fall back, after the hold.
	bogey.queue_free()
	await get_tree().create_timer(Music.THREAT_HOLD + Music.FADE_OUT + 0.8).timeout
	var cooled := Music.blend()
	print("[music] RELEASE blend %.2f (must be ~0)" % cooled)
	print("[music] ADAPTIVE calm<0.1 && threat>0.9 && release<0.1 -> %s" % [
		"PASS" if calm_blend < 0.1 and hot_blend > 0.9 and cooled < 0.1 else "FAIL"])

	# --- the depth axis ------------------------------------------------------
	# The band system drove colour, radar span, spawn tables and beacon text, and
	# nothing audible: the Shoals and the Reaches sounded identical. These assert
	# that depth moves the mix, that it moves MONOTONICALLY (so a band edge is a
	# gradient rather than a step), and that it is orthogonal to threat.
	# Driven by FLYING THE SHIP OUT, not by calling set_depth directly. main's
	# per-frame poll would overwrite a hand-set target on the very next frame, so
	# a direct call measures nothing -- and this way the assertion covers the
	# whole chain, position through deep_depth through the mix, rather than just
	# the arithmetic at the end of it.
	var edge := chart_edge()
	var depth_seen: Array = []
	for units in [0.0, 160.0, 440.0, 1100.0, 2000.0]:
		player.teleport_to(Vector3(0.0, 0.0, edge + units + 1.0))
		# Long enough for DEPTH_FADE to settle from wherever the previous sample
		# left it, since the smoothing is deliberately slow.
		await get_tree().create_timer(1.6).timeout
		depth_seen.append(snappedf(Music.depth_blend(), 0.01))
	var rising := true
	for i in range(depth_seen.size() - 1):
		if float(depth_seen[i + 1]) < float(depth_seen[i]) - 0.001:
			rising = false
	var spans: bool = float(depth_seen[0]) < 0.05 and float(depth_seen[depth_seen.size() - 1]) > 0.95
	print("[music] DEPTH AXIS blend at [0, 160, 440, 1100, 2000]u = %s, monotonic=%s, spans 0..1=%s -> %s" % [
		str(depth_seen), str(rising), str(spans),
		"PASS" if rising and spans else "FAIL"])

	# Orthogonality. Being jumped in THE QUIET must sound like being jumped: the
	# threat blend cannot be a function of how far out the player is, or deep
	# space becomes permanently tense and shallow space permanently safe --
	# a statement about the map rather than about what is happening.
	player.teleport_to(Vector3(0.0, 0.0, edge + 1200.0))
	await get_tree().create_timer(1.6).timeout
	var deep_calm := Music.blend()
	var bogey2 := SwarmHostile.new()
	bogey2.difficulty = 0.0
	bogey2.hp_scale = 40.0
	system_root.add_child(bogey2)
	bogey2.global_position = player.global_position + Vector3(0, 0, Music.THREAT_RADIUS * 0.4)
	bogey2.dock_at(bogey2.global_position)
	await get_tree().create_timer(Music.FADE_IN + 0.8).timeout
	var deep_hot := Music.blend()
	var deep_depth_held := Music.depth_blend()
	bogey2.queue_free()
	print("[music] AXES ORTHOGONAL in THE QUIET: threat %.2f -> %.2f while depth holds %.2f -> %s" % [
		deep_calm, deep_hot, deep_depth_held,
		"PASS" if deep_calm < 0.1 and deep_hot > 0.9 and deep_depth_held > 0.95 else "FAIL"])

	# Fly home and let the threat hold expire before the checks below. They
	# measure the CALM layer's volume, and with two axes that layer is silent for
	# two different reasons now -- leaving either one raised would fail the dock
	# duck for a reason that has nothing to do with docking.
	player.teleport_to(PlayerShip.SPAWN_POINT)
	await get_tree().create_timer(Music.THREAT_HOLD + Music.FADE_OUT + 2.0).timeout

	# Per-system tint is applied to the calm layer only.
	var idx := AudioServer.get_bus_index(Sfx.BUS_MUSIC_CALM)
	Music.set_system_tint(SystemDB.music_lp_of("pyx03"))
	var lp := AudioServer.get_bus_effect(idx, 0) as AudioEffectLowPassFilter
	var dark := lp.cutoff_hz
	Music.set_system_tint(SystemDB.music_lp_of("pyx01"))
	var open := lp.cutoff_hz
	print("[music] TINT pyx03 %.0fHz < pyx01 %.0fHz -> %s  (combat bus untouched: %d effects)" % [
		dark, open, "PASS" if dark < open else "FAIL",
		AudioServer.get_bus_effect_count(AudioServer.get_bus_index(Sfx.BUS_MUSIC))])

	# Docking ducks the score without stopping it.
	Music.set_docked(true)
	await get_tree().create_timer(Music.DOCK_FADE + 0.4).timeout
	var ducked_db := _music_calm_db()
	Music.set_docked(false)
	await get_tree().create_timer(Music.DOCK_FADE + 0.4).timeout
	var normal_db := _music_calm_db()
	print("[music] DUCK docked %.1fdB < undocked %.1fdB, still playing=%s -> %s" % [
		ducked_db, normal_db, str(Music.is_playing()),
		"PASS" if ducked_db < normal_db - 0.5 and Music.is_playing() else "FAIL"])

	# A live apex engine is a threat wherever it is standing: the arena is wider
	# than THREAT_RADIUS, so proximity alone would let the score go calm in the
	# middle of the boss fight.
	#
	# v15. AND THE SHIP HAS TO BE INSIDE THE LEASH FOR THAT TO BE A REAL STATE.
	# The engine hides ~300u out and the fight only exists within
	# ApexBoss.LEASH_RANGE of it, so a hand-set boss_active with the ship still at
	# the dock is a state the game corrects on the very next frame — _process
	# broke the fight off before the fade-in had finished and the blend read 0.00.
	# 100u out: seven times THREAT_RADIUS, so "no contact nearby" is still
	# literally true and the assertion still says what it says, but inside the
	# leash, so the fight it describes is one the game agrees is happening.
	var engine := _find_apex()
	if engine != null:
		player.global_position = engine.global_position \
			+ Vector3(0, 0, ApexBoss.LEASH_RANGE - 20.0)
		await get_tree().physics_frame
	_set_boss_active(true)
	await get_tree().create_timer(Music.FADE_IN + 0.8).timeout
	var boss_blend := Music.blend()
	_set_boss_active(false)
	print("[music] BOSS blend %.2f with boss_active and no contact nearby -> %s" % [
		boss_blend, "PASS" if boss_blend > 0.9 else "FAIL"])

	# The title screen drops the score entirely; the ambient drone stays.
	_enter_attract()
	await get_tree().process_frame
	print("[music] TITLE playing=%s (must be false)  ambient loop=%s (must be true)" % [
		str(Music.is_playing()), str(Sfx.is_looping("ambient"))])

	# v22 (89). COMBAT SOUND FALLS OFF WITH DISTANCE. The curve, held without
	# listening: flat inside full range, monotone to the floor at the cull edge,
	# and the cull strictly beyond the flat zone so the two constants cannot be
	# tuned past each other. The world's fire/hit/explode all route through
	# play_at now; a battle past SFX_CULL_RANGE does not exist to the ear.
	var att_bad := ""
	if Sfx.attenuation_for(0.0) != 0.0 or Sfx.attenuation_for(Sfx.SFX_FULL_RANGE) != 0.0:
		att_bad = "not flat inside full range"
	elif absf(Sfx.attenuation_for(Sfx.SFX_CULL_RANGE) + Sfx.SFX_FALLOFF_DB) > 0.001:
		att_bad = "cull edge is not the floor"
	elif Sfx.SFX_CULL_RANGE <= Sfx.SFX_FULL_RANGE:
		att_bad = "cull inside full range"
	else:
		var att_prev := 0.0
		var att_d := 0.0
		while att_d <= Sfx.SFX_CULL_RANGE + 20.0:
			var a := Sfx.attenuation_for(att_d)
			if a > att_prev + 0.001:
				att_bad = "curve rises at %.0fu" % att_d
				break
			att_prev = a
			att_d += 5.0
	print("[music] COMBAT SOUND FALLS OFF WITH DISTANCE flat to %.0fu, -%.0fdB at %.0fu, monotone: %s -> %s" % [
		Sfx.SFX_FULL_RANGE, Sfx.SFX_FALLOFF_DB, Sfx.SFX_CULL_RANGE,
		"yes" if att_bad == "" else att_bad,
		"PASS" if att_bad == "" else "FAIL"])
	get_tree().quit()


func _music_calm_db() -> float:
	for child in Music.get_children():
		var p := child as AudioStreamPlayer
		if p != null and p.bus == Sfx.BUS_MUSIC_CALM:
			return p.volume_db
	return 0.0


# --- economy pacing harness -------------------------------------------------

func _run_pacing_test() -> void:
	# Seeded so runs of an unchanged catalog land within a few percent of each
	# other. Not bit-identical: FX and drift draw from the same global RNG on a
	# frame-count-dependent schedule. The band is wide enough to absorb that —
	# if it ever is not, the band is the thing that is wrong.
	seed(0x50415849)
	set_deep_generation(false)
	var player: PlayerShip = get_tree().get_first_node_in_group("player")

	GameState.reset_to_starter()
	_load_system(SystemDB.START_SYSTEM)
	# Nothing may pay the player except the activity being measured: no wave
	# spawner, no market events, no contract completing mid-measurement.
	_wave_timer = 1.0e9
	_event_roll_timer = 1.0e9
	# v19 stage 4. The rift clock, pinned beside the wave and event clocks the
	# comment above already pins — the same stated rule, applied to a third
	# spawner. Kept for hygiene, not as a fix: it was pinned as a DIAGNOSTIC
	# when MIDTIER read 2.97 twice in eight draws, and the readings did not
	# move — then a control run on the unmodified parent commit read 2.88-3.00
	# INCLUDING A 3.00 FAIL, exonerating both the rift and the stage. The
	# excursion is the distribution under machine load, §65 records it, and the
	# §41 re-derivation of this bar is now due.
	_rift_timer = 1.0e9
	contracts.active = []
	await get_tree().create_timer(0.4).timeout
	player.invulnerable = true
	player.clear_target()

	var catalog := _pacing_catalog_cost()
	print("[pacing] starter fit: dps %.0f  hold %d  salvage_mult %.2f  system loot_mult %.2f" % [
		float(GameState.stats.get("dps", 0.0)), GameState.cargo_capacity(),
		float(GameState.stats.get("salvage_mult", 1.0)), loot_mult()])
	print("[pacing] catalog: every module, every reactor tier and all three berths = %d" % catalog)

	var per_swarm := await _pacing_kill_yield("swarm", 6)
	var per_sentry := await _pacing_kill_yield("sentry", 3)
	var per_derelict := await _pacing_derelict_yield()
	var per_trade := _pacing_trade_yield()
	var per_contract := _pacing_contract_yield()
	var per_survey := _pacing_survey_yield()
	var per_seam := _pacing_seam_yield()

	print("[pacing] YIELD  swarm %.0f/kill  sentry %.0f/kill  derelict %.0f/hull  trade %.0f/run  contract %.0f/each  survey %.0f  seam %.0f/cut" % [
		per_swarm, per_sentry, per_derelict, per_trade, per_contract, per_survey, per_seam])

	# ONE measurement set, every profile folded over it. See PACING_PROSPECT.
	var yields := {
		"swarm": per_swarm, "sentry": per_sentry, "derelict": per_derelict,
		"trade": per_trade, "contract": per_contract, "survey": per_survey,
		"seam": per_seam,
	}
	var earned := _pacing_earned(PACING_LOOP, yields)

	print("[pacing] LOOP %s over %.0f min" % [
		_pacing_describe(PACING_LOOP), PACING_MINUTES])
	print("[pacing] EARNED %.0f per %.0f-minute loop  (%.0f sessions to the full catalog)" % [
		earned, PACING_MINUTES, float(catalog) / maxf(earned, 1.0)])

	var mid := float(ModuleDB.get_module(PACING_MIDTIER).get("price", 1))
	# Ceiling only. A catalog fraction is the right shape for "earning got too
	# fast" — that stays true however big the catalog is — and the wrong shape
	# for "earning got too slow", which is what the mid-tier floor below covers.
	var ratio := earned / maxf(float(catalog), 1.0)
	print("[pacing] TRADE SWEEP %d goods x %d port pairs, %d illegal skipped -> %s" % [
		CommodityDB.ids().size(), SystemDB.port_ids().size() * (SystemDB.port_ids().size() - 1),
		_pacing_trade_skipped, "PASS" if _pacing_trade_skipped > 0 else "FAIL"])

	# v27. THE SHELF SERVES THE STANDARD LOOP. A finite counter is allowed to
	# throttle the second and third run of a route inside one loop -- that is the
	# farm, and throttling it is the feature -- but it must NEVER shorten the one
	# full hold the pacing contract is derived from, or every number below moves
	# for a reason that has nothing to do with yields.
	#
	# Measured, not reasoned: the best legal route was just re-derived above, so
	# this asks the shelf it actually buys from. A red here names the exact pair
	# and means the caps are wrong, not that the band is.
	var shelf_cap := Market.stock_cap(
		SystemDB.port_def_by_id(_pacing_trade_port), _pacing_trade_good)
	print("[pacing] THE SHELF SERVES THE STANDARD LOOP best route buys %d %s at %s, the shelf stands %d -> %s" % [
		_pacing_trade_units, CommodityDB.short_name(_pacing_trade_good),
		_pacing_trade_port, shelf_cap,
		"PASS" if shelf_cap >= _pacing_trade_units else "FAIL"])
	# The catalog is what a run can BUY. A craftable has no price, so it cannot be
	# in it — and cannot silently grow the denominator the ceiling is measured
	# against, which is the failure mode 10 warns about after the Mk II tiers.
	var priced := 0
	var free := 0
	for id_v in ModuleDB.MODULES:
		if int((ModuleDB.MODULES[id_v] as Dictionary).get("price", 0)) > 0:
			priced += 1
		else:
			free += 1
	print("[pacing] CATALOG BUYABLE %d priced modules + %d at price 0 -> %s" % [
		priced, free, "PASS" if priced > 0 else "FAIL"])
	print("[pacing] CEILING ratio %.3f <= %.2f -> %s" % [
		ratio, PACING_MAX_RATIO,
		"PASS" if ratio <= PACING_MAX_RATIO else "FAIL"])

	# A derelict is a once-per-system windfall — there are three in the whole
	# game — so the loop above is a best-case session and the right thing to
	# check the CEILING against. The recurring rate is the same loop without it,
	# and that is what the FLOOR has to hold, or the game slows to a crawl once
	# the hulls are all cracked.
	#
	# The floor is measured in MID-TIER MODULES, not as a fraction of the
	# catalog, and that distinction matters. A catalog fraction moves every time
	# content is added: shipping the six Mk II tiers grew the catalog by 84% and
	# dropped the steady ratio from 0.057 to 0.031 without a single earning
	# changing. That is the metric reporting on the catalog, not on the pacing.
	# "One recurring loop is worth about one mid-tier module" is the thing the
	# design actually promises, and it is scale-invariant.
	# v21: SURVEYS LEAVE THE RECURRING TERM TOO. Coverage persists now (80), so
	# the two readings this loop takes are priced at band 2 -- the ring a
	# standard loop reaches -- and that ring BURNS: each cell pays once ever.
	# Leaving them in the steady term would over-report the recurring rate by
	# two readings a loop, silently, while every assertion passed. The expanse
	# is unbounded so chart income does not cap -- it converts into an outward
	# treadmill -- but "fly further every session" is not a steady rate at a
	# fixed band price, and this line stops pretending it is.
	var steady := earned - per_derelict * float(PACING_LOOP["derelict"]) \
		- per_survey * float(PACING_LOOP["survey"])
	var steady_modules := steady / maxf(mid, 1.0)
	print("[pacing] STEADY (no derelict) %.0f per loop, ratio vs catalog %.3f" % [
		steady, steady / maxf(float(catalog), 1.0)])
	print("[pacing] STEADY MIDTIER %.2f x %s per loop vs [%.2f, %.2f] -> %s" % [
		steady_modules, PACING_MIDTIER, PACING_MIN_MODULES, PACING_MAX_MODULES,
		"PASS" if steady_modules >= PACING_MIN_MODULES and steady_modules <= PACING_MAX_MODULES
			else "FAIL"])

	# v22 (§86). THE REFERENCE ITSELF IS MEASURED, not trusted. §41's debt was
	# exactly this drifting silently: the catalog grew 84% and the "mid-tier"
	# module quietly became an 18th-percentile one, so every MIDTIER line here
	# measured against a short ruler while staying green. The middle third is
	# computed from the live catalog, so the next growth spurt reddens this leg
	# and forces the re-derivation instead of waiting for someone to wonder.
	var yard_prices: Array = []
	for yid_v in ModuleDB.MODULES:
		var ypr := int((ModuleDB.MODULES[yid_v] as Dictionary).get("price", 0))
		if ypr > 0:
			yard_prices.append(ypr)
	yard_prices.sort()
	var yard_ref := int(ModuleDB.get_module(PACING_MIDTIER).get("price", 0))
	var yard_lo := int(yard_prices[int(floorf(yard_prices.size() / 3.0))])
	var yard_hi := int(yard_prices[int(floorf(yard_prices.size() * 2.0 / 3.0))])
	print("[pacing] THE YARDSTICK IS MID-TIER %s at %d sits in the middle third of %d priced modules [%d..%d] -> %s" % [
		PACING_MIDTIER, yard_ref, yard_prices.size(), yard_lo, yard_hi,
		"PASS" if yard_ref >= yard_lo and yard_ref <= yard_hi else "FAIL"])

	# The same target stated the way the design states it, so a failure reads as
	# "a loop now buys four modules" rather than as an abstract ratio.
	var modules := earned / maxf(mid, 1.0)
	print("[pacing] MIDTIER %.2f x %s (%d) per best-case loop vs [%.2f, %.2f] -> %s" % [
		modules, PACING_MIDTIER, int(mid), PACING_MIN_MODULES, PACING_MAX_MODULES,
		"PASS" if modules >= PACING_MIN_MODULES and modules <= PACING_MAX_MODULES else "FAIL"])

	# --- the prospector's route ----------------------------------------------
	# The same yields, weighted the way a session spent cutting rock is weighted.
	var prospect := _pacing_earned(PACING_PROSPECT, yields)
	print("[pacing] PROSPECT %s over %.0f min" % [
		_pacing_describe(PACING_PROSPECT), PACING_MINUTES])
	print("[pacing] PROSPECT EARNED %.0f per loop" % prospect)
	var prospect_modules := prospect / maxf(mid, 1.0)
	print("[pacing] PROSPECT MIDTIER %.2f x %s per loop vs [%.2f, %.2f] -> %s" % [
		prospect_modules, PACING_MIDTIER, PACING_MIN_MODULES, PACING_MAX_MODULES,
		"PASS" if prospect_modules >= PACING_MIN_MODULES \
			and prospect_modules <= PACING_MAX_MODULES else "FAIL"])

	# Measured against STEADY rather than against the best case, and that choice
	# is the assertion. A derelict is a once-per-system windfall — three in the
	# whole game — and the prospector's route has none in it, so comparing to the
	# loop that includes one would credit mining with a hull it never cracked and
	# make a route that pays 30% worse look correct.
	# v21: the prospector's survey leaves ITS recurring term for the same
	# reason, or parity would compare a route still credited with a burned ring
	# against one that is not -- two different games, which is exactly what this
	# assertion's own comment below says it must never do.
	var prospect_steady := prospect - per_survey * float(PACING_PROSPECT["survey"])
	var parity := absf(prospect_steady - steady) / maxf(steady, 1.0)
	print("[pacing] ROUTE PARITY prospector %.0f vs steady %.0f (both less one-time surveys), %.1f%% apart vs %.0f%% allowed -> %s" % [
		prospect_steady, steady, parity * 100.0, PACING_ROUTE_TOLERANCE * 100.0,
		"PASS" if parity <= PACING_ROUTE_TOLERANCE else "FAIL"])

	# And the standard loop must not have been paid a credit for mining existing.
	# This is cheap to assert and the exact thing a later stage would break by
	# reaching for the obvious knob: adding a seam term here rather than tuning
	# the weight in PACING_PROSPECT.
	print("[pacing] MINING IS A ROUTE, NOT A RAISE standard loop names %s, seam among them=%s -> %s" % [
		str(PACING_LOOP.keys()), str(PACING_LOOP.has("seam")),
		"PASS" if not PACING_LOOP.has("seam") else "FAIL"])

	# v22. The same fence for the first-filing bonus, which is once-only BY
	# CONSTRUCTION (a cell files once, ever) and therefore must never appear as
	# a recurring term -- the exact over-report 80 removed from surveys, rebuilt
	# one commit later, is what this goes red on. Both profiles checked, because
	# PACING_PROSPECT surveys too and would be the quieter place to slip it in.
	var names_filing: bool = PACING_LOOP.has("filing") or PACING_LOOP.has("filed") \
		or PACING_PROSPECT.has("filing") or PACING_PROSPECT.has("filed")
	print("[pacing] FILING IS NOT A RAISE loop names a filing term=%s (rate %.2f rides the once-only filed set) -> %s" % [
		str(names_filing), FIRST_FILING_RATE,
		"PASS" if not names_filing else "FAIL"])

	# --- THE LEDGER OF PRICES (Horizon 11 commit 0) --------------------------
	#
	# WHY THIS EXISTS. Everything above this line measures INCOME. Nothing in
	# this project has ever measured a SINK, and `DEFAULT_LEDGER`'s seven keys
	# hold no credit figure either -- so the entire outflow side of the economy,
	# which is what Horizon 10 was ABOUT, has been unmeasured by construction.
	#
	# The consequence, found by converting the shipped constants against the
	# loop this function has just measured: the deepest possible tug's fee is a
	# few dozen SECONDS of standard-loop income, a full repair rather less, and
	# every colony work in a whole run together is about an hour. §109 priced
	# the rescue at exactly twice the beacon jump, which is correct arithmetic
	# against a number that had itself never been anchored to anything. That is
	# the whole defect in one sentence, and it is the rule this block hands the
	# repo: EVERY PRICE HERE IS ANCHORED TO ANOTHER PRICE, AND NONE IS ANCHORED
	# TO THE LOOP.
	#
	# IT ASSERTS LAWS, NEVER TARGETS. The re-pricing is deliberately a decision
	# for a later horizon, taken with this table in hand (§41's own posture, and
	# §99's: the numbers are provisional, the laws are what is checked). So
	# nothing below asserts that a sink is BIG ENOUGH. A leg that did would be
	# this commit quietly making the decision it exists to inform.
	#
	# AND IT IS HONEST ABOUT ITS REACH, `FEEDS COMPETE, SIX WAYS`' posture: the
	# sink list below is AUTHORED, so a sink somebody adds later and does not
	# add here is invisible to all three legs. What is derived is every PRICE --
	# each row reads the live constant or the live port def rather than a number
	# typed twice -- which is what makes `EVERY SINK IS PRICED` able to notice a
	# constant that moved or a key that was renamed.
	var sink_rows: Array = []
	# NAMED ONCE. The ceiling law below has to exclude this row from its own
	# comparison, and a string typed at both sites is a rename away from a law
	# that silently compares the catalogue to itself -- the class of defect this
	# whole block was built to stop being possible.
	const CATALOGUE_ROW := "the yard catalogue"
	sink_rows.append({"name": CATALOGUE_ROW, "cost": float(catalog),
		"forced": false})
	var works_total := 0
	for w_v in GameState.COLONY_WORKS:
		works_total += int((GameState.COLONY_WORKS[w_v] as Dictionary).get("price", 0))
	sink_rows.append({"name": "colony works, one colony", "cost": float(works_total),
		"forced": false})
	# §126. AND THE CHANNEL, which is a different number from the menu above it
	# and the one the re-pricing was actually about. A pilot does not buy one
	# colony's works; they buy every copy that grants anything, and the two
	# scopes multiply differently -- a system-scoped work has a HARD CAP of one
	# useful copy per authored system, because the chart asks whether ANY colony
	# in the system has it, while a colony-scoped work multiplies by every
	# colony there is.
	#
	# Pricing the menu as though it were the channel is what made "raise the
	# works" look like one decision when it is two. Derived from `scope`,
	# `HYPER_MAX` and the authored system list, so a new work, a new system or a
	# wider structure count all land here without an edit.
	var work_systems := 0
	for sid_wv in SystemDB.ids():
		if not SystemDB.hyper_positions(String(sid_wv), 1).is_empty():
			work_systems += 1
	var max_colonies := work_systems * SystemDB.HYPER_MAX
	var channel_total := 0
	for w3_v in GameState.COLONY_WORKS:
		var w3 := String(w3_v)
		var copies := work_systems if GameState.work_scope(w3) == "system" \
			else max_colonies
		channel_total += int((GameState.COLONY_WORKS[w3] as Dictionary)
			.get("price", 0)) * copies
	# §127. AND IT IS REPORTED RATHER THAN BOUNDED, which §126 got wrong by one
	# commit. Every other row in this table is what ONE pilot pays for one thing
	# or one menu; this row is what FIFTEEN COLONIES would cost if somebody
	# developed every one of them. Handing a completionist aggregate to a law
	# that means "no purchase costs more than the ship" compares two different
	# kinds of number, and it came due immediately: the two works §127 adds put
	# the channel at 1.75x the catalogue.
	#
	# THE RED WOULD HAVE BEEN THE WRONG ANSWER, and that is the decision rather
	# than a convenience. Capping the works channel below the yard re-creates
	# the exact condition §114 was written about -- money buys place, a bit, and
	# then nothing again. A terminal sink has to be able to outlast the ship or
	# it is not terminal. The ship stays the SPINE (no single decision a pilot
	# makes costs more than it, which is what the law still asserts, one colony
	# at a time), and completionism across a map is allowed to be longer.
	#
	# `over_exempt` is the flag, not a name match: the law reads the row's own
	# declaration, so a future aggregate row is exempted by saying so rather than
	# by a string somebody has to remember to add to a list.
	sink_rows.append({"name": "the works, every useful copy",
		"cost": float(channel_total), "forced": false, "over_exempt": true})
	# The dearest component the order desk will ever quote, derived rather than
	# named: a later component priced above lens_unsounded moves this row.
	var req_max := 0
	for cid_v in CommodityDB.ids():
		var cid := String(cid_v)
		if String(CommodityDB.get_good(cid).get("parent", "")) == "":
			continue
		req_max = maxi(req_max, Market.requisition_price(cid))
	sink_rows.append({"name": "a requisition, dearest part", "cost": float(req_max),
		"forced": false})
	# THE ONE A PILOT CANNOT DECLINE, and §123 corrects the count. This block
	# shipped calling repair forced too, and it is not: `repair_full`'s own
	# comment says so in as many words -- "the slow recovery in _tick_shield is
	# the FREE option; this is the one you pay to SKIP". A docked repair is a
	# TIME purchase competing with waiting, the same thing the DRY DOCK sells.
	#
	# The mistake made the ceiling law weaker than it read: half of what it
	# checked was a convenience. A shield-zero ship genuinely has no other way
	# out, so the forced set is exactly one row, and the law below now means what
	# its name says.
	#
	# AT THE FAR MARKS, which is both the deepest place a pilot can die and --
	# since §123 -- where the ramp stops climbing.
	sink_rows.append({"name": "the tug, at the far marks",
		"cost": float(rescue_fee(FarMarks.DEPTH_MAX)), "forced": true})
	# AND IT IS DELIBERATELY NOT RE-PRICED (§123), for two reasons that compound.
	# PACINGTEST measures a loop that runs `invulnerable` and never pays a
	# repair, so any raise here moves real-play net income while STEADY MIDTIER
	# reads exactly what it read -- a stealth nerf the band structurally cannot
	# see, landing hardest on the pilot who fights every loop. And its competitor
	# is FREE: raising the price of skipping a wait does not deepen a sink, it
	# just buys more waiting, which is tedium sold as economy.
	sink_rows.append({"name": "repair to full (a wait you may skip)",
		"cost": float(PortPanel.REPAIR_FULL_PRICE), "forced": false})
	sink_rows.append({"name": "a beacon jump, at its cap",
		"cost": float(beacon_jump_fee(float(BEACON_JUMP_MAX_DEPTH))), "forced": false})
	sink_rows.append({"name": "a colony jump", "cost": float(COLONY_JUMP_FEE),
		"forced": false})
	sink_rows.append({"name": "paint", "cost": float(PortPanel.PAINT_PRICE),
		"forced": false})
	# The intel and rumour desks price by PORT DEF, and the dearest desk in the
	# game is the one worth quoting -- walked rather than named, so a new deep
	# station with a steeper desk lands in the table without an edit here.
	var intel_max := 0
	var rumor_max := 0
	for pid_v in SystemDB.port_ids():
		var pd := SystemDB.port_def_by_id(String(pid_v))
		intel_max = maxi(intel_max, int(pd.get("hunt_price", 0)))
		rumor_max = maxi(rumor_max, int(pd.get("rumor_price", 0)))
	for aid_v in DeepPortDB.ids():
		var ad := DeepPortDB.by_id(String(aid_v))
		intel_max = maxi(intel_max, int(ad.get("hunt_price", 0)))
		rumor_max = maxi(rumor_max, int(ad.get("rumor_price", 0)))
	sink_rows.append({"name": "the sharpest bearing sold", "cost": float(intel_max),
		"forced": false})
	sink_rows.append({"name": "a rumour, dearest desk", "cost": float(rumor_max),
		"forced": false})
	var stake_total := 0
	for s_v in PortPanel.GAMBLE_STAKES:
		stake_total += int(s_v)
	sink_rows.append({"name": "the wager, a full streak", "cost": float(stake_total),
		"forced": false})

	var loop_secs := PACING_MINUTES * 60.0
	print("[pacing] SINKS priced against this run's own steady loop (%.0f per %.0f min)" % [
		steady, PACING_MINUTES])
	for row_v in sink_rows:
		var row: Dictionary = row_v
		var loops := float(row["cost"]) / maxf(steady, 1.0)
		# §129. AN EXEMPT ROW SAYS WHAT IT IS EXEMPT AGAINST. `THE CATALOGUE IS
		# THE LONGEST PRICE` skips these (§127), so the one number that would
		# have caught an aggregate running away is the one nothing prints. This
		# horizon's largest untested bet is that the works channel SHOULD outrun
		# the ship; the bet is now on screen every sweep instead of living in a
		# document, which is §124's rule turned on the decision that used it.
		var tail := "   (cannot be declined)" if bool(row["forced"]) else ""
		if bool(row.get("over_exempt", false)):
			tail = "   = %.2fx the catalogue (exempt: an aggregate, not a price)" \
				% (float(row["cost"]) / maxf(float(catalog), 1.0))
		print("[pacing]   %-28s %10s   %7.3f loops   %8.0f s%s" % [
			String(row["name"]), _comma_int(int(row["cost"])), loops,
			loops * loop_secs, tail])

	# 1. Every row read a live number. A zero means the constant or the port-def
	#    key it derives from has moved, been renamed, or gone -- at which point
	#    the row above is a measurement column reporting on nothing, which is the
	#    failure this whole block was built to stop being possible.
	var unpriced: Array = []
	for row2_v in sink_rows:
		var row2: Dictionary = row2_v
		if float(row2["cost"]) <= 0.0:
			unpriced.append(String(row2["name"]))
	print("[pacing] EVERY SINK IS PRICED %d sink(s) derived from live data, %d read zero%s -> %s" % [
		sink_rows.size(), unpriced.size(),
		"" if unpriced.is_empty() else (" (%s)" % ", ".join(PackedStringArray(unpriced))),
		"PASS" if unpriced.is_empty() else "FAIL"])

	# 2. The catalogue is what a run is FOR, so no single DECISION may cost more
	#    than it. It goes red the moment somebody prices a work or an order
	#    above the entire yard, which is the one direction a re-pricing could
	#    overshoot without anybody noticing.
	#
	#    §127 SHARPENS "NOTHING" TO "NO DECISION". A row flagged `over_exempt`
	#    is an aggregate across places rather than a price a pilot pays at one
	#    of them; see the works channel row for the argument. The exemption is
	#    counted and printed, never silent -- a law with a quiet exception is a
	#    law nobody can audit.
	var over: Array = []
	var exempt := 0
	for row3_v in sink_rows:
		var row3: Dictionary = row3_v
		if bool(row3.get("over_exempt", false)):
			exempt += 1
			continue
		if String(row3["name"]) != CATALOGUE_ROW \
				and float(row3["cost"]) > float(catalog):
			over.append(String(row3["name"]))
	print("[pacing] THE CATALOGUE IS THE LONGEST PRICE catalogue %s, %d aggregate row(s) exempt, %d priced sink(s) above it%s -> %s" % [
		_comma_int(catalog), exempt, over.size(),
		"" if over.is_empty() else (" (%s)" % ", ".join(PackedStringArray(over))),
		"PASS" if over.is_empty() else "FAIL"])

	# 3. THE ONE PROMISE WORTH PINNING BEFORE ANY RE-PRICING, and it is a floor
	#    rather than a ceiling on purpose. A charge a pilot cannot decline that
	#    costs more than a whole measured loop does not price a mistake -- it
	#    deletes the session that preceded it, which is a different game from
	#    this one and not the one the tutorial taught. It is comfortably true
	#    today (both forced sinks are seconds, not loops), it survives a
	#    re-pricing in EITHER direction, and it is therefore safe to assert now
	#    without prejudging the decision this table exists to inform.
	var forced_over: Array = []
	for row4_v in sink_rows:
		var row4: Dictionary = row4_v
		if bool(row4["forced"]) and float(row4["cost"]) > steady:
			forced_over.append(String(row4["name"]))
	# §123. AND THE LAW IS TOTAL NOW, NOT SAMPLED. The rows above price the
	# forced sink at one depth; before the rescue clamped, a fee rising forever
	# crossed a loop somewhere out in empty space that no row named. Ten times
	# past the marks is the check that the ramp really does stop.
	var deepest_forced := float(rescue_fee(FarMarks.DEPTH_MAX * 10.0))
	if deepest_forced > steady:
		forced_over.append("the tug past the marks")
	print("[pacing] NOTHING INVOLUNTARY EXCEEDS A LOOP one loop is %s, the deepest forced charge anywhere is %s, %d above it%s -> %s" % [
		_comma_int(int(steady)), _comma_int(int(deepest_forced)),
		forced_over.size(),
		"" if forced_over.is_empty() else (" (%s)" % ", ".join(PackedStringArray(forced_over))),
		"PASS" if forced_over.is_empty() else "FAIL"])

	# §123. THE DEATH PRICE SITS IN ITS BAND, and this is the re-pricing made
	# into a LAW rather than a nudge. §114 measured the deepest possible rescue
	# at eighty seconds of loop income and deliberately asserted no target,
	# because the decision belonged to a later horizon taken with the table in
	# hand. This is that horizon and that decision: the fee is pinned to a
	# FRACTION of the loop PACINGTEST measures, so a yield retune that quietly
	# cheapens death reddens here instead of waiting a year for somebody to
	# wonder.
	#
	# Measured against STEADY, never against the best case: the best-case loop
	# carries a once-per-system derelict, and pricing a recurring consequence
	# against a windfall would make death cheapest for the pilot who just found
	# one. `ROUTE PARITY` picks steady for the same reason.
	#
	# A RED HERE IS ONE CONSTANT, NOT A CRISIS (§99): RESCUE_FEE_FAR moves, the
	# band stands, and the band is the thing being defended.
	var death_frac := float(rescue_fee(FarMarks.DEPTH_MAX)) / maxf(steady, 1.0)
	print("[pacing] THE DEATH PRICE SITS IN ITS BAND deepest rescue %s is %.3f of a steady loop (%s) vs [%.2f, %.2f] -> %s" % [
		_comma_int(rescue_fee(FarMarks.DEPTH_MAX)), death_frac,
		_comma_int(int(steady)), RESCUE_BAND_MIN, RESCUE_BAND_MAX,
		"PASS" if death_frac >= RESCUE_BAND_MIN and death_frac <= RESCUE_BAND_MAX
			else "FAIL"])
	get_tree().quit()


func _pacing_earned(profile: Dictionary, yields: Dictionary) -> float:
	# ONE summation, every route profile folded through it. The point of a second
	# authored weighting is that it shares the measurements: a profile carrying
	# its own copy of this arithmetic would eventually value an activity
	# differently, and ROUTE PARITY would then be comparing two different games
	# rather than two ways to play one.
	#
	# An activity a profile does not name contributes nothing, which is how
	# PACING_LOOP carries no "seam" term at all rather than a zero.
	var total := 0.0
	for key in profile:
		total += float(yields.get(key, 0.0)) * float(profile[key])
	return total


func _pacing_describe(profile: Dictionary) -> String:
	# Read off the profile rather than hand-written, because the hand-written
	# version was wrong: the LOOP line named five of its six terms for as long as
	# `survey` had been in the dict, so 560 of EARNED's credits had no visible
	# source in the log that exists to explain EARNED.
	var parts := PackedStringArray()
	for key in profile:
		parts.append("%d %s" % [int(profile[key]), String(key)])
	return " + ".join(parts)


func _pacing_catalog_cost() -> int:
	# EVERYTHING A RUN CAN BUY FOR THE SHIP, and §124 adds the third dict it had
	# been missing since v24. This summed MODULES and REACTOR_TIERS only, while
	# ModuleDB.BERTHS holds 260,000 of one-way credit purchases at the yard --
	# 23% of the road, invisible to `CEILING`, to `THE CATALOGUE IS THE LONGEST
	# PRICE`, and to the "sessions to the full catalog" line that has been
	# printing on every sweep since. Both assertions get LOOSER with a bigger
	# denominator, which is why nothing ever went red over it: an under-count
	# here is a silent one in both directions it is checked.
	#
	# Found by re-deriving §114's table by hand after the loop measurement
	# landed -- the docs said 1,106,200 (the whole file) and the leg said 846,200
	# (two of its three dicts), and neither had ever been compared to the other.
	# THE PROSE WAS RIGHT AND THE INSTRUMENT WAS WRONG, which is the one outcome
	# §124's own rule does not predict and the reason the rule is "say what
	# produced it" rather than "trust the leg".
	var total := 0
	for id in ModuleDB.MODULES:
		total += int((ModuleDB.MODULES[id] as Dictionary).get("price", 0))
	for tier in ModuleDB.REACTOR_TIERS:
		total += int((tier as Dictionary).get("price", 0))
	for b_id in ModuleDB.BERTHS:
		total += int((ModuleDB.BERTHS[b_id] as Dictionary).get("price", 0))
	return total


func _pacing_cargo_value() -> float:
	# Crates are earnings too — valuing the hold at base price keeps a combat
	# yield honest without double-counting the trade margin measured separately.
	var total := 0.0
	for good in GameState.cargo:
		total += float(CommodityDB.base_price(String(good))) * float(GameState.cargo[good])
	return total


func _pacing_kill_yield(kind: String, count: int) -> float:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame

	var salvage_before := GameState.salvage
	var cargo_before := _pacing_cargo_value()

	# Somewhere genuinely empty: a pack spawned inside a moon gets resolved out
	# of it and scatters, and what is being measured here is payout, not pathing.
	var spot := Obstacles.resolve(Vector3(0, 0, 14), 5.0)
	for i in range(count):
		var h: Node3D = (Hostile.new() if kind == "sentry" else SwarmHostile.new()) as Node3D
		h.set("difficulty", 1.0)
		system_root.add_child(h)
		h.global_position = spot + Vector3(randf_range(-1.2, 1.2), 0, randf_range(-1.2, 1.2))
	await get_tree().create_timer(0.3).timeout

	# Real mounts, real damage. The ship is pinned inside its own reach because
	# this measures what a fight pays, not how long it takes to fly to one.
	var frames := 0
	while frames < 5400:
		var live := get_tree().get_nodes_in_group("hostiles")
		if live.is_empty():
			break
		var t := live[0] as Node3D
		player.global_position = t.global_position + Vector3(0, 0, 2.5)
		player.velocity = Vector3.ZERO
		player.command_attack(t)
		frames += 1
		await get_tree().physics_frame

	# Park while the spill homes in: LootCube seeks from any distance after
	# SEEK_ALWAYS_AFTER, so standing still collects the whole drop.
	player.clear_target()
	await get_tree().create_timer(6.0).timeout

	var salvage_gain := float(GameState.salvage - salvage_before)
	var crate_gain := _pacing_cargo_value() - cargo_before
	print("[pacing]   %s x%d -> %.0f total (%.0f salvage + %.0f in crates) over %d frames" % [
		kind, count, salvage_gain + crate_gain, salvage_gain, crate_gain, frames])
	return (salvage_gain + crate_gain) / maxf(float(count), 1.0)


func _pacing_derelict_yield() -> float:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	# THE SURVEY HULL, explicitly. PACING_LOOP's `derelict: 1` term is the
	# once-per-system windfall; measuring the tutorial's 16-crate training stub
	# instead would silently drop the loop's biggest single earner and re-tune
	# the whole economy against a number that means nothing.
	var derelict: Derelict = _find_survey_hull()
	if derelict == null:
		print("[pacing]   derelict: none in this system -> 0")
		return 0.0

	var salvage_before := GameState.salvage
	var cargo_before := _pacing_cargo_value()
	var frames := 0
	while not derelict.is_cracked() and frames < 1800:
		# Re-pinned every frame: the hull's own obstacle spheres push the ship
		# back out, and hold_tick drops the hold the moment it leaves range.
		player.global_position = derelict.breach_point + Vector3(0, 0, 3.0)
		player.velocity = Vector3.ZERO
		derelict.hold_begin()
		derelict.hold_tick(get_physics_process_delta_time())
		frames += 1
		await get_tree().physics_frame

	# The spill arrives in waves over VORTEX_TIME, then has to fly home.
	await get_tree().create_timer(10.0).timeout
	var salvage_gain := float(GameState.salvage - salvage_before)
	var crate_gain := _pacing_cargo_value() - cargo_before
	print("[pacing]   derelict cracked=%s -> %.0f total (%.0f salvage + %.0f in crates)" % [
		str(derelict.is_cracked()), salvage_gain + crate_gain, salvage_gain, crate_gain])
	return salvage_gain + crate_gain


func _pacing_can_buy_at(port_id: String, good: String) -> bool:
	# A leg the player can actually fly: the good is not restricted away from this
	# port, the port has a shopfront, and the counter is not a fence (a fence buys
	# and does not sell — Market.can_buy).
	if not CommodityDB.trades_at(good, port_id):
		return false
	var pdef := SystemDB.port_def_by_id(port_id)
	if not (pdef.get("services", PortPanel.DEFAULT_SERVICES) as Array).has("market"):
		return false
	return Market.can_buy(pdef, good)


func _pacing_can_sell_at(port_id: String, good: String) -> bool:
	# Same test REACHABLE uses: a market will take anything it lists, and a fence
	# will take what it names.
	if not CommodityDB.trades_at(good, port_id):
		return false
	var pdef := SystemDB.port_def_by_id(port_id)
	var svc: Array = pdef.get("services", PortPanel.DEFAULT_SERVICES)
	return svc.has("market") or (svc.has("fence") and Market.fences(pdef, good))


func _pacing_trade_yield() -> float:
	# One full hold bought where it is cheap and sold where it is dear, priced
	# through the same Market calls the port panel charges with. Deliberately the
	# BEST route on the chart: a player who has learned the map is the case the
	# ceiling has to hold against.
	#
	# ONLY ROUTES THE PLAYER CAN ACTUALLY FLY. This swept every good against every
	# port pair with no legality check at all, so it happily priced "buy contraband
	# at Bastion Yards" — a trade refused by the restriction list at a port that
	# does not even list the good. It went unnoticed because the best FICTIONAL
	# route happened to be beaten by a real one (BANNED void->cantina), which is
	# luck rather than a property. Sell-only goods break that luck immediately:
	# each one gets an imaginary buy leg, `best` inflates, and the whole pacing
	# band moves for a route nobody can fly.
	#
	# The illegal best is measured anyway and printed beside the legal one, so the
	# two numbers visibly diverge — if this filter is ever removed they collapse
	# into each other, which is what makes the assertion below worth having.
	var hold := GameState.cargo_capacity()
	var ports := SystemDB.port_ids()
	var best := 0.0
	var label := "none"
	var ghost_best := 0.0
	var ghost_label := "none"
	var skipped := 0
	for good_v in CommodityDB.ids():
		var good := String(good_v)
		var units := hold / maxi(CommodityDB.space_of(good), 1)
		for a_v in ports:
			for b_v in ports:
				var a := String(a_v)
				var b := String(b_v)
				if a == b:
					continue
				var buy := Market.buy_price(SystemDB.port_def_by_id(a), a, good)
				var sell := Market.sell_price(SystemDB.port_def_by_id(b), b, good)
				var profit := float((sell - buy) * units)
				var legal := _pacing_can_buy_at(a, good) and _pacing_can_sell_at(b, good)
				if not legal:
					skipped += 1
					if profit > ghost_best:
						ghost_best = profit
						ghost_label = "%s %s->%s" % [CommodityDB.short_name(good), a, b]
					continue
				if profit > best:
					best = profit
					_pacing_trade_port = a
					_pacing_trade_good = good
					_pacing_trade_units = units
					label = "%s %s->%s  %d units  buy %d sell %d" % [
						CommodityDB.short_name(good), a, b, units, buy, sell]
	print("[pacing]   best route: %s -> %.0f profit on a %d-space hold" % [label, best, hold])
	print("[pacing]   best route the player CANNOT fly: %s %.0f (skipped)" % [
		ghost_label, ghost_best])
	_pacing_trade_skipped = skipped
	return best


func _pacing_survey_yield() -> float:
	# What one reading is worth at the counter. Deliberately valued rather than
	# flown: the survey hold has no combat in it and no RNG, so playing it out
	# would measure the harness's patience rather than the game's economy.
	# Priced at the DRIFT band, which is the one a standard loop actually reaches.
	var good := CommodityDB.chart_for_band(2)
	if good == "":
		return 0.0
	var per := float(CommodityDB.base_price(good)) * float(SurveyMast.YIELD_UNITS)
	print("[pacing]   survey: %s x%d at base %d = %.0f per reading" % [
		CommodityDB.short_name(good), SurveyMast.YIELD_UNITS,
		CommodityDB.base_price(good), per])
	return per


func _pacing_seam_yield() -> float:
	# What one cut is worth at the counter, priced at the DRIFT band for exactly
	# the reason _pacing_survey_yield is: band 2 is the depth a real loop actually
	# works, and a number with no combat and no RNG in it would only measure the
	# harness's patience if it were flown instead of valued.
	#
	# Read off SEAM_YIELDS and SEAM_UNITS rather than restated as a constant, so
	# that retuning the ore table moves this and ROUTE PARITY notices. A restated
	# number is how a profile quietly stops describing the game.
	var band := 2
	var table: Array = CommodityDB.seam_yields(band)
	if table.is_empty():
		return 0.0
	var total := 0.0
	for gid_v in table:
		total += float(CommodityDB.base_price(String(gid_v)))
	var mean := total / float(table.size())
	var per := mean * float(DeepSpace.SEAM_UNITS[band])
	print("[pacing]   seam: band %d mean %.0f x %d units = %.0f per cut" % [
		band, mean, DeepSpace.SEAM_UNITS[band], per])
	return per


func _pacing_contract_yield() -> float:
	# The mean reward of what is actually on offer in the starting system: a
	# steady-income lever, so the band has to see it move when rewards change.
	#
	# THE STRANGER'S BOARD, deliberately (§95): no `trusted` argument, so the
	# commissions are not in this mean. They are not steady income -- they are
	# gated on standing a new pilot does not have, they pay BELOW the survey row
	# beside them, and folding them in would quietly lower the measured band for
	# every pilot including the ones who cannot see them. Leave the argument
	# off; the omission is the model.
	var pool := ContractDB.available_for(SystemDB.START_SYSTEM)
	if pool.is_empty():
		return 0.0
	var total := 0.0
	for id in pool:
		total += float(ContractDB.get_contract(String(id)).get("reward", 0))
	print("[pacing]   contracts offered here: %d, mean reward %.0f" % [pool.size(), total / pool.size()])
	return total / float(pool.size())


# --- layout harness ---------------------------------------------------------

func _run_layout_test() -> void:
	# Pure maths, no rendering: proves the scale rule at every shape we care
	# about, including that portrait windows are left exactly as they were.
	#
	# Pin the player's UI-scale preference out of the way first. content_factor()
	# is `auto_factor() * user_scale`, and user_scale is loaded from the save — so
	# with a player who has dragged the slider to its 0.7 minimum, every assertion
	# below was measuring their preference rather than the rule it exists to
	# check, and the harness failed on a perfectly healthy layout.
	var player_scale := UILayout.user_scale
	UILayout.user_scale = 1.0
	print("[layout] player ui_scale %.2f pinned to 1.00 for the rule assertions" % player_scale)
	var sizes := [
		Vector2(414, 736),    # the old desktop default / small phone window
		Vector2(390, 844),    # iPhone logical
		Vector2(1170, 2532),  # iPhone native
		Vector2(720, 1280),   # design base
		Vector2(1100, 800),   # new desktop default
		Vector2(1440, 900),   # laptop
		Vector2(1920, 1080),  # desktop
		Vector2(2560, 1440),  # large desktop
		Vector2(3440, 1440),  # ultrawide
	]
	print("[layout] rule: portrait windows untouched; wide windows scaled so UI never shrinks")
	var worst := 999.0
	for s in sizes:
		var v: Vector2 = s
		print("[layout] ", UILayout.describe(v))
		if UILayout.is_wide(v):
			worst = minf(worst, UILayout.effective_scale(v))

	print("[layout] ASSERT wide-window effective scale >= 1.0: worst = %.3f -> %s" % [
		worst, "PASS" if worst >= 1.0 else "FAIL"])

	var phone := Vector2(1170, 2532)
	print("[layout] ASSERT phone factor is exactly 1.0 (unchanged): %.3f -> %s" % [
		UILayout.content_factor(phone),
		"PASS" if is_equal_approx(UILayout.content_factor(phone), 1.0) else "FAIL"])

	var ok := true
	for s in sizes:
		var v: Vector2 = s
		var logical := v.x / maxf(UILayout.effective_scale(v), 0.001)
		if UILayout.column_width(v) > logical + 0.5:
			ok = false
	print("[layout] ASSERT column never exceeds logical width -> %s" % ["PASS" if ok else "FAIL"])

	# --- how much of the screen the chrome actually eats -----------------------
	# The rule that stops the UI shrinking on a wide window can overshoot into
	# making it huge, and nothing was watching that axis. A round button is 5-6%
	# of a phone screen's height; at DESKTOP_REFERENCE 620 it was 12.3% of a
	# desktop's — the controls stopped framing the play area and started sitting
	# in it. Measured here so a future tweak to the scale rule cannot quietly
	# re-inflate them.
	var btn := RoundButton.RADIUS * 2.0
	print("[layout] chrome footprint (round button = %.0f design units):" % btn)
	var worst_desktop := 0.0
	var worst_phone := 0.0
	for s in sizes:
		var v: Vector2 = s
		var logical_h := v.y / maxf(UILayout.effective_scale(v), 0.001)
		var pct := btn / logical_h * 100.0
		print("[layout]   %4.0fx%-4.0f %-9s button = %5.1f%% of screen height" % [
			v.x, v.y, "wide" if UILayout.is_wide(v) else "portrait", pct])
		if UILayout.is_wide(v):
			worst_desktop = maxf(worst_desktop, pct)
		else:
			worst_phone = maxf(worst_phone, pct)
	# Desktop is allowed to be proportionally chunkier than a phone — the screen
	# is further away — but not by more than about half again.
	print("[layout] ASSERT desktop chrome %.1f%% <= 1.8x the phone's %.1f%% -> %s" % [
		worst_desktop, worst_phone,
		"PASS" if worst_desktop <= worst_phone * 1.8 else "FAIL"])

	# And the chrome must reach the real screen edges, or corner controls sit in
	# the play area. Portrait is unaffected: its column already spans the screen.
	var edges_ok := true
	for s in sizes:
		var v: Vector2 = s
		if UILayout.column_width(v) > (v.x / maxf(UILayout.effective_scale(v), 0.001)) - 0.5:
			continue        # column already spans the screen (portrait)
		if not UILayout.is_wide(v):
			edges_ok = false  # a portrait window should never be inset
	print("[layout] ASSERT chrome spans the full width on portrait -> %s" % [
		"PASS" if edges_ok else "FAIL"])

	# The preference still has to compose with the rule — that is the whole
	# contract of user_scale, and pinning it above must not hide a break in it.
	UILayout.user_scale = 1.25
	var composed := UILayout.content_factor(Vector2(1920, 1080))
	UILayout.user_scale = 1.0
	var rule_only := UILayout.content_factor(Vector2(1920, 1080))
	print("[layout] ASSERT ui_scale composes: %.3f x 1.25 = %.3f -> %s" % [
		rule_only, composed,
		"PASS" if is_equal_approx(composed, rule_only * 1.25) else "FAIL"])
	UILayout.user_scale = player_scale

	# --- the action dock ------------------------------------------------------
	# The dock exists so the controls never spread. Assert exactly that: the same
	# width at every screen size, and centred. Also assert the bottom-centre band
	# is genuinely centred, which locks the double-compensation bug (position.x
	# set to negative half a min width AND grow BOTH) out for good.
	if hud != null:
		var widths: Array = []
		var worst_off := 0.0
		var worst_who := ""
		for probe in [Vector2i(720, 1280), Vector2i(1440, 900), Vector2i(3440, 1440)]:
			get_window().size = probe
			await get_tree().process_frame
			await get_tree().process_frame
			var vp := get_viewport().get_visible_rect().size
			widths.append(hud.dock_width())
			for pair in hud.centred_probe():
				var off: float = absf(float(pair[1]) - vp.x * 0.5)
				if off > worst_off:
					worst_off = off
					worst_who = "%s at %dx%d" % [pair[0], probe.x, probe.y]
			print("[layout]   %4dx%-4d dock width %.0f, centre offset %.1fpx" % [
				probe.x, probe.y, hud.dock_width(),
				absf(hud.dock_centre_x() - vp.x * 0.5)])
		var spread := 0.0
		for w in widths:
			spread = maxf(spread, absf(float(w) - float(widths[0])))
		print("[layout] ASSERT DOCK WIDTH identical across 720/1440/3440 (spread %.2fpx) -> %s" % [
			spread, "PASS" if spread <= 1.0 else "FAIL"])
		print("[layout] ASSERT BAND CENTRED worst offset %.1fpx (%s) -> %s" % [
			worst_off, worst_who if worst_who != "" else "-",
			"PASS" if worst_off <= 1.5 else "FAIL"])

		# BANDS CLEAR — the overlap the constant-probe assertion structurally
		# cannot see. RoundButton.RADIUS tests the SCALE RULE and is right to be
		# a constant (a metric must hold still while content grows, 10's own
		# lesson), but it knows nothing about where plates actually sit. Three
		# surfaces were overlapping before this existed: the toast rested ON the
		# boss bar, the broadcast plate nearly touched the toast, and the parley
		# button clipped the crack gauge by ~8px.
		#
		# Only pairs that can be on screen TOGETHER are checked. The exempt pair
		# is parley/tutorial, and the exemption is guarded by asserting the rule
		# that makes it exclusive rather than by trusting it: if raids ever become
		# possible during the tutorial, the exemption goes red instead of the
		# overlap going unnoticed.
		#
		# THE PARLEY STACK'S OWN PAIRS (v18, playtest round 4), and their absence
		# is why two real defects sat under a green line. `pairs` is a
		# hand-maintained allowlist and band_controls() is the inventory it draws
		# from — _bluff_button was in NEITHER, so the plate that sits directly
		# above the toll button had never been measured against it at any size.
		# It was four design px away against this rule's own six, and at the
		# maximum UI scale on a wide window it landed on BROADCAST_TOP. The
		# broadcast pair is not exempt the way parley/tutorial is: spawn_rift is
		# ungated against a live raid, so an advisory and a demand genuinely can
		# share a screen.
		var pairs := [["boss", "toast"], ["toast", "broadcast"],
			["boss", "broadcast"], ["crack", "parley"], ["crack", "prompt"],
			["parley", "refuse"], ["refuse", "bluff"], ["broadcast", "bluff"]]
		var worst_gap := 9999.0
		var worst_pair := ""
		var gap_report := ""
		for probe2 in [Vector2i(720, 1280), Vector2i(1100, 800),
				Vector2i(1440, 900), Vector2i(3440, 1440)]:
			get_window().size = probe2
			await get_tree().process_frame
			await get_tree().process_frame
			var rects := hud.band_rects()
			for pr in pairs:
				var a := String(pr[0])
				var b := String(pr[1])
				if not rects.has(a) or not rects.has(b):
					continue
				var ra: Vector2 = rects[a]
				var rb: Vector2 = rects[b]
				# Gap between the two spans, negative when they overlap.
				var gap: float = maxf(ra.x, rb.x) - minf(ra.y, rb.y)
				if gap < worst_gap:
					worst_gap = gap
					worst_pair = "%s/%s at %dx%d" % [a, b, probe2.x, probe2.y]
		gap_report = "worst %.1f design px (%s)" % [worst_gap, worst_pair]
		print("[layout] ASSERT BANDS CLEAR %s, want >= 6 -> %s" % [
			gap_report, "PASS" if worst_gap >= 6.0 else "FAIL"])

		# The exemption's own guard.
		tutorial.arm()
		tutorial.begin()
		await get_tree().process_frame
		var armed_excl := tutorial_active() and not interdiction_eligible()
		tutorial.skip()
		await get_tree().process_frame
		print("[layout] ASSERT PARLEY EXCLUDES TUTORIAL raids ineligible while the tutorial runs=%s -> %s" % [
			str(armed_excl), "PASS" if armed_excl else "FAIL"])
	get_tree().quit()


# --- title harness ----------------------------------------------------------

# THE ONE THAT COULD NOT FAIL, and it is worth recording how it was found
# rather than just fixed. `tools/run_harness.sh --legs` derives each tag's
# assertion count from `main.gd`; this tag came back with a GATE of ZERO while
# printing four lines. Every one of them carried its expectation in PROSE --
# `(expect 0)`, `(expect false)`, `(expect ~0)`, `(matches save present=%s)` --
# where nothing could read it, so the tag burned a run in every sweep since it
# shipped and had never been capable of going red.
#
# That is §107's MARKETTEST defect exactly ("printed five true things and
# asserted NONE of them, for twenty-two versions"), still live in a second tag
# two horizons after it was named. The parenthetical is the tell: a print that
# states what it expects is an assertion that somebody stopped one line short
# of writing.
#
# The four claims below are the four that were already being printed. Nothing
# new is measured -- what changed is that the run can now say NO.
func _run_title_test() -> void:
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(1.4).timeout
	await _shot(shots, "s1_title.png")

	# 1. THE ATTRACT SCREEN IS INERT. All three clauses, because each one is a
	#    different promise: the state machine is parked, nothing was spawned to
	#    hunt a ship the player does not control yet, and the cockpit furniture
	#    is not sitting behind the menu.
	var attract_state := state == State.ATTRACT
	var no_hostiles := get_tree().get_nodes_in_group("hostiles").size()
	var chrome_hidden: bool = not hud.chrome_visible()
	print("[title] THE ATTRACT SCREEN IS INERT state=%s, %d hostile(s), chrome hidden=%s -> %s" % [
		"ATTRACT" if attract_state else "PLAYING", no_hostiles,
		str(chrome_hidden),
		"PASS" if attract_state and no_hostiles == 0 and chrome_hidden else "FAIL"])

	# 2. THE DOOR MATCHES THE FILE. An EQUALITY rather than a fixed expectation,
	#    and that is what makes it machine-independent: this harness runs against
	#    the real save path (lock_saving is one-way, so pressing NEW SURVEY below
	#    cannot write over it), so whether a save exists depends on the box. What
	#    must hold on every box is that the button and the filesystem agree --
	#    offering CONTINUE with nothing to continue, or hiding it with a run on
	#    disk, are the same defect in two directions.
	var offered := title_screen.continue_available()
	var on_disk := GameState.has_save()
	print("[title] THE DOOR MATCHES THE FILE continue offered=%s, save on disk=%s -> %s" % [
		str(offered), str(on_disk), "PASS" if offered == on_disk else "FAIL"])

	# 3. INPUT IS LOCKED BEHIND THE MENU. `_enter_attract` calls
	#    set_input_enabled(false) and parks the ship, so the bar is a genuine
	#    zero rather than a tolerance for drift -- TITLE_DRIFT_MAX exists only to
	#    absorb physics settling, and a ship that actually flew on a held key
	#    covers hundreds of units in this second, not fractions of one.
	var before := player.global_position
	Input.action_press("move_up")
	await get_tree().create_timer(1.0).timeout
	Input.action_release("move_up")
	var moved := before.distance_to(player.global_position)
	print("[title] INPUT IS LOCKED BEHIND THE MENU a held bearing moved the ship %.2fu over 1s, allowed %.2fu -> %s" % [
		moved, TITLE_DRIFT_MAX, "PASS" if moved <= TITLE_DRIFT_MAX else "FAIL"])

	# 4. NEW SURVEY HANDS OVER TO THE TUTORIAL. Four clauses, and the last is the
	#    one with history: start_new_game calls tutorial.arm() BEFORE _load_system
	#    precisely so the builder leaves the garrison out, and that ordering is
	#    invisible in a diff. A regression there greets a brand-new player with
	#    three sentries, which is the arm() comment's own words.
	#
	#    Deterministic on every box: begin() sets _active and drives _advance()
	#    to step 0 unconditionally, so `tutorial_seen` -- a DEVICE fact that
	#    varies by machine -- cannot reach any of these four.
	start_new_game()
	await get_tree().create_timer(1.0).timeout
	var playing := state != State.ATTRACT
	var tut_on := tutorial.is_active()
	var at_first := GameState.tutorial_step == 0
	var garrison := _count_sentries()
	print("[title] NEW SURVEY HANDS OVER TO THE TUTORIAL state=%s, tutorial active=%s at step %d, %d sentry(s) built -> %s" % [
		"PLAYING" if playing else "ATTRACT", str(tut_on),
		GameState.tutorial_step, garrison,
		"PASS" if playing and tut_on and at_first and garrison == 0 else "FAIL"])
	await _shot(shots, "s2_after_start.png")
	get_tree().quit()


# --- tutorial harness -------------------------------------------------------

func _run_tutorial_test() -> void:
	var shots: String = OS.get_environment("PYXIS_SHOTS")
	var player: PlayerShip = get_tree().get_first_node_in_group("player")

	# Cold start, exactly like a first-time player pressing NEW SURVEY.
	GameState.reset_to_starter()
	start_new_game()
	await get_tree().create_timer(0.8).timeout
	print("[tut] started: active=%s step=%d sentries=%d swarm=%d (both must be 0)" % [
		str(tutorial.is_active()), GameState.tutorial_step,
		_count_sentries(), get_tree().get_nodes_in_group("swarm").size()])
	await _shot(shots, "t1_step_move.png")

	# Step 1: fly.
	var from_pos := player.global_position
	# Re-press every frame rather than once: Godot releases virtual actions when
	# the window changes focus, which happens while the test window is opening,
	# so a single action_press intermittently evaporates mid-hold.
	for i in range(96):
		Input.action_press("move_up")
		await get_tree().physics_frame
	# Release every direction, not just the one pressed: a stuck action leaves
	# the ship flying away from the step-2 drone, which never comes into range.
	_release_all_moves()
	await get_tree().create_timer(0.9).timeout
	print("[tut] after moving: step=%d (expect 1) driving=%s moved=%.1f (need %.1f) obstacles=%d" % [
		GameState.tutorial_step, str(player.driving),
		from_pos.distance_to(player.global_position), Tutorial.MOVE_DISTANCE,
		Obstacles.count()])

	# Step 2: kill the lone contact.
	await get_tree().create_timer(0.4).timeout
	await _shot(shots, "t2_step_engage.png")
	var guard := 0
	while GameState.tutorial_step == 1 and guard < 120:
		_attack_nearest(player)
		await get_tree().create_timer(0.25).timeout
		guard += 1
		if guard % 20 == 0:
			var n := get_tree().get_nodes_in_group("hostiles").size()
			var tgt = player.attack_target
			print("[tut]   step1 wait %d: hostiles=%d target=%s dist=%.1f driving=%s" % [
				guard, n, str(is_instance_valid(tgt)),
				player.global_position.distance_to(tgt.global_position) if is_instance_valid(tgt) else -1.0,
				str(player.driving)])
	print("[tut] after kill: step=%d (expect 2)" % GameState.tutorial_step)

	# Step 3: collect its salvage — the loot magnet does this on approach.
	guard = 0
	while GameState.tutorial_step == 2 and guard < 120:
		await get_tree().create_timer(0.25).timeout
		guard += 1
	print("[tut] after collect: step=%d (expect 3) salvage=%d" % [
		GameState.tutorial_step, GameState.salvage])

	# Step 4: discharge the core.
	await get_tree().create_timer(0.7).timeout
	await _shot(shots, "t3_step_ability.png")
	player._ability_cd = 0.0
	player.activate_ability()
	await get_tree().create_timer(1.0).timeout
	print("[tut] after ability: step=%d (expect 4) owns_tractor=%s" % [
		GameState.tutorial_step, str(GameState.owns("util_tractor"))])

	# Step 5: fit the recovered rig.
	await _shot(shots, "t4_step_refit.png")
	GameState.equip(ModuleDB.Slot.UTILITY, "util_tractor")
	await get_tree().create_timer(0.9).timeout
	print("[tut] after refit: step=%d (expect 5)" % GameState.tutorial_step)

	# Step 6: breach the TRAINING hull. v18: the finale teaches the verb and
	# charts nothing — the survey hull outside the cordon opens the world, and
	# the tutorial ends by handing over its bearing.
	var derelict: Derelict = get_tree().get_first_node_in_group("training_hull")
	derelict.on_tapped()
	await get_tree().create_timer(3.0).timeout
	var frames := 0
	while is_instance_valid(derelict) and not derelict.is_cracked() and frames < 500:
		derelict.hold_begin()
		derelict.hold_tick(get_process_delta_time())
		frames += 1
		if frames % 150 == 0:
			print("[tut]   breach wait %d: dist_to_breach=%.1f (need <= %.1f)" % [
				frames, player.global_position.distance_to(derelict.breach_point),
				Derelict.CRACK_RANGE])
		await get_tree().process_frame
	await get_tree().create_timer(1.2).timeout
	await _shot(shots, "t5_breach_finale.png")

	print("[tut] FINISHED active=%s step=%d pyx02_charted=%s" % [
		str(tutorial.is_active()), GameState.tutorial_step,
		str(GameState.is_system_unlocked("pyx02"))])

	# The world must come back: garrison arrives after its grace, waves allowed.
	await get_tree().create_timer(Tutorial.GARRISON_DELAY + 1.5).timeout
	_wave_timer = 0.2
	await get_tree().create_timer(1.5).timeout
	# PICKETS COUNTED SEPARATELY, and as a PASS/FAIL rather than a number to
	# read. This line used to print `sentries=%d` from a counter that lumped
	# pickets in with standing machines, so "sentries=6" was equally true of a
	# system with the Cordon deployed and one without it — the missing garrison
	# half walked straight past the one harness that drives the real tutorial.
	var tut_routes: int = (SystemDB.get_system(system_id).get("patrols", []) as Array).size()
	print("[tut] WORLD REOPENED sentries=%d (expect >0) pickets=%d (expect %d) swarm=%d (expect >0) -> %s" % [
		_count_sentries(), _count_pickets(), tut_routes,
		get_tree().get_nodes_in_group("swarm").size(),
		"PASS" if _count_sentries() > 0 and tut_routes > 0
			and _count_pickets() == tut_routes
			and get_tree().get_nodes_in_group("swarm").size() > 0 else "FAIL"])
	await _shot(shots, "t6_free_play.png")
	get_tree().quit()


func _count_sentries() -> int:
	# STANDING machines only. A picket is the same class with a route and it is
	# counted by _count_pickets instead — lumping them made "sentries=6" true of
	# a system with four sentries and two pickets AND of one with six sentries
	# and no Cordon at all, which is exactly how the missing garrison half got
	# past the tutorial harness.
	var n := 0
	for h in get_tree().get_nodes_in_group("hostiles"):
		if h is Hostile and (h as Hostile).patrol.is_empty() \
				and not h.is_in_group("deep_guard"):
			n += 1
	return n


func _count_pickets() -> int:
	var n := 0
	for h in get_tree().get_nodes_in_group("hostiles"):
		if h is Hostile and not (h as Hostile).patrol.is_empty():
			n += 1
	return n


func _count_cordon() -> int:
	# THE CORDON SPECIFICALLY, which is not the same set as "everything with a
	# route". _count_pickets answers "how many routed machines are in the sky"
	# and is right to — it is what catches pickets being BUILT where they should
	# not be. This one answers "how many authored beats are being walked", which
	# is the question the re-form has to be capped against, and it cannot be
	# fooled by a hand-built probe or by a convoy escort carrying a route.
	var n := 0
	for h in get_tree().get_nodes_in_group("hostiles"):
		var p := h as Hostile
		if p != null and is_instance_valid(p) and not p.is_dying() \
				and p.has_meta("route_i"):
			n += 1
	return n


# --- input harness ----------------------------------------------------------

func _release_all_moves() -> void:
	for a in ["move_up", "move_down", "move_left", "move_right"]:
		Input.action_release(a)


func _hold_action(action: String, seconds: float) -> Vector3:
	# Presses an action for a while and reports how far the ship moved. Clears
	# every other direction first: a stuck opposite key silently cancels the
	# axis and reads as "the key does nothing".
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	_release_all_moves()
	await get_tree().process_frame
	var from := player.global_position
	# Re-pressed each frame: a one-shot virtual press is cleared if the window
	# changes focus, which makes these measurements silently flaky.
	var frames := int(seconds * 60.0)
	for i in range(frames):
		Input.action_press(action)
		await get_tree().physics_frame
	Input.action_release(action)
	await get_tree().create_timer(0.35).timeout   # let inertia settle
	return player.global_position - from


func _run_input_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(0.6).timeout
	# The ship sits parked among live hostiles for the whole harness. Without
	# this it accumulates damage, emergency-warps mid-test, and every subsequent
	# assertion measures a warping ship instead of the input system.
	player.invulnerable = true

	# 1. Each key drives the expected screen direction. The camera does not yaw,
	#    so screen-up is world -Z.
	for spec in [["move_up", "W", Vector3(0, 0, -1)], ["move_down", "S", Vector3(0, 0, 1)],
			["move_left", "A", Vector3(-1, 0, 0)], ["move_right", "D", Vector3(1, 0, 0)]]:
		player.global_position = Vector3(0, 0, 6)
		player.velocity = Vector3.ZERO
		var moved: Vector3 = await _hold_action(String(spec[0]), 0.8)
		var want: Vector3 = spec[2]
		var dot := moved.normalized().dot(want) if moved.length() > 0.1 else 0.0
		print("[input] %s moved (%.1f, %.1f) len %.1f  alignment %.2f (want ~1.0)" % [
			String(spec[1]), moved.x, moved.z, moved.length(), dot])

	# 2. The key property: strafing must not drop the target or stop the guns.
	_release_all_moves()
	await get_tree().process_frame
	var target: Node3D = null
	for h in get_tree().get_nodes_in_group("hostiles"):
		target = h
		break
	player.global_position = target.global_position + Vector3(0, 0, 4.0)
	player.shield = player.shield_max
	player.command_attack(target)
	await get_tree().process_frame
	print("[input] strafe setup: target=%s class=%s attack_target_set=%s dist=%.1f" % [
		target.name, target.get_class(), str(player.attack_target == target),
		player.global_position.distance_to(target.global_position)])
	var hp_before: float = target.hp
	Input.action_press("move_right")
	# Sample mid-strafe: the starter fit can delete a sentry inside two seconds,
	# and a dead target cannot demonstrate that facing tracks a live one.
	await get_tree().create_timer(0.7).timeout
	var still_targeted := is_instance_valid(target) and player.attack_target == target
	var hp_mid: float = target.hp if is_instance_valid(target) else -1.0
	var to_target: Vector3 = (target.global_position - player.global_position) \
		if is_instance_valid(target) else Vector3.FORWARD
	to_target.y = 0.0
	var want_yaw := atan2(-to_target.x, -to_target.z)
	var yaw_err := absf(wrapf(player.rotation.y - want_yaw, -PI, PI))
	var bank: float = player.rotation.z
	var lateral: float = player.velocity.dot(player.global_transform.basis.x)
	await _shot(OS.get_environment("PYXIS_SHOTS"), "i1_strafe_engaged.png")
	Input.action_release("move_right")
	print("[input] STRAFE-FIRE target_kept=%s hp %.0f -> %.0f (must fall)  yaw_err %.2f rad (must be <0.5)  bank %.2f  lateral %.1f" % [
		str(still_targeted), hp_before, hp_mid, yaw_err, bank, lateral])

	# 2b. Overcharge must actually clear a swarm pack, which is the whole point
	#     of the blast: the ring used to be decoration over a fire-rate buff.
	_release_all_moves()
	player.clear_target()
	player.global_position = Vector3(0, 0, 6)
	await get_tree().process_frame
	for i in range(6):
		var probe := SwarmHostile.new()
		probe.difficulty = 1.0
		system_root.add_child(probe)
		var ang := TAU * float(i) / 6.0
		probe.global_position = player.global_position + Vector3(cos(ang), 0, sin(ang)) * (2.0 + i * 0.7)
	await get_tree().create_timer(0.4).timeout
	var before_count := get_tree().get_nodes_in_group("swarm").size()
	player._ability_cd = 0.0
	var fired := player.activate_ability()
	await get_tree().create_timer(0.12).timeout
	await _shot(OS.get_environment("PYXIS_SHOTS"), "i2_overcharge_blast.png")
	await get_tree().create_timer(0.8).timeout
	var after_count := get_tree().get_nodes_in_group("swarm").size()
	print("[input] OVERCHARGE fired=%s swarm %d -> %d (blast radius %.1f, burst %.0f dmg at centre)" % [
		str(fired), before_count, after_count, PlayerShip.OVERCHARGE_RADIUS,
		float(GameState.stats.get("dps", 0.0)) * PlayerShip.OVERCHARGE_BURST_SECONDS])

	# 3. Tab cycles and wraps; Escape clears.
	var seen := []
	for i in range(5):
		var picked: Node3D = player.cycle_target()
		seen.append(picked.name if picked else "none")
	print("[input] CYCLE picked %d distinct of %d hostiles: %s" % [
		_distinct(seen), get_tree().get_nodes_in_group("hostiles").size(), str(seen)])
	player.clear_target()
	print("[input] CANCEL target=", player.attack_target)

	# 4. Device split: a touch on empty space still moves (mobile intact); a
	#    mouse click on empty space must not.
	var rig := get_tree().get_first_node_in_group("camera_rig")
	var empty := Vector2(40, 210)   # far from any entity in this system

	player.global_position = Vector3(0, 0, 6)
	player.has_move_target = false
	rig._tap(empty)
	var touch_moves := player.has_move_target
	player.has_move_target = false
	rig._click(empty)
	var click_moves := player.has_move_target
	print("[input] DEVICE SPLIT touch_on_empty_moves=%s (must be true)  click_on_empty_moves=%s (must be false)" % [
		str(touch_moves), str(click_moves)])

	# THE HOLD HAS A SECOND DOOR. §54's rule, applied: assert the path the
	# PLAYER takes, not the function it wraps. Calling hold_screen.toggle()
	# here would pass with no action declared in project.godot, no key bound
	# and no handler written — it would test that a method toggles a boolean,
	# which was never in doubt. So this builds a real InputEventKey on the
	# real physical keycode and pushes it through the real dispatcher.
	#
	# The third clause is the attract guard: CameraRig keeps receiving events
	# behind the title screen (only SHIP input is disabled there), so without
	# is_playing() the manifest slides up over the menu.
	hold_screen.close_panel()
	await get_tree().process_frame
	var opened := await _press_hold_key()
	var closed := not await _press_hold_key()
	_enter_attract()
	hold_screen.close_panel()
	await get_tree().process_frame
	var attract_ignored := not await _press_hold_key()
	_enter_playing()
	await get_tree().process_frame
	print("[input] THE HOLD HAS A SECOND DOOR i opens=%s, i closes again=%s, refused behind the title=%s -> %s" % [
		str(opened), str(closed), str(attract_ignored),
		"PASS" if opened and closed and attract_ignored else "FAIL"])

	# THE CHART KEY OBEYS THE LOCK. The chart's lock has always lived on the
	# BUTTON -- set_panels_locked flips chart_button.enabled and nothing else --
	# which was sufficient while a Button was the only door. A hotkey is a
	# second door, and one that called chart_panel.open() would reopen the chart
	# while docked or mid-apex fight; disengage_apex's comment says the fight is
	# survivable partly BECAUSE the chart is shut.
	#
	# Asserted in BOTH directions, because "the key never opens the chart" would
	# satisfy the refusal clause perfectly and ship a dead key.
	# set_panels_locked is called directly here rather than through a staged
	# boss fight: it is the same one call docking and _set_boss_active both make,
	# and it is the thing the key has to obey.
	chart_panel.close_panel()
	await get_tree().process_frame
	await _press_key(KEY_C)
	var chart_opened := chart_panel.is_open
	await _press_key(KEY_C)
	var chart_closed := not chart_panel.is_open
	hud.set_panels_locked(true)
	await _press_key(KEY_C)
	var chart_locked_out := not chart_panel.is_open
	hud.set_panels_locked(false)
	await _press_key(KEY_C)
	var chart_clear_again := chart_panel.is_open
	chart_panel.close_panel()
	await get_tree().process_frame
	print("[input] THE CHART KEY OBEYS THE LOCK opens=%s, closes=%s, refused while panels locked=%s, opens again once clear=%s -> %s" % [
		str(chart_opened), str(chart_closed), str(chart_locked_out),
		str(chart_clear_again),
		"PASS" if chart_opened and chart_closed and chart_locked_out
			and chart_clear_again else "FAIL"])

	# THE BEACON KEY CARRIES THE FUNCTION'S REFUSAL. drop_beacon_here already
	# refuses inside the charted volume -- §66's rule, that the chart already
	# remembers every place in it -- so the key must reach that refusal rather
	# than carry a copy of it. Standing at the spawn point, depth is 0 and the
	# rack must not move.
	# BOTH DIRECTIONS, and the refusal alone was not one. The first draft of this
	# leg pressed B at depth 0 and asserted the rack had not moved -- which a
	# missing action, a wrong keycode, a deleted dispatch branch and a typo'd
	# has_method all satisfy perfectly. It measured that a keypress does nothing,
	# which was never in doubt. So the key is made to WORK first, out in the
	# deep, and only then made to refuse.
	player.global_position = Vector3(SystemDB.bounds_of(system_id) + 240.0, 0.0, 0.0)
	await get_tree().process_frame
	var stock_deep := GameState.beacon_stock_left()
	var depth_deep := deep_depth()
	await _press_key(KEY_B)
	var stock_after_drop := GameState.beacon_stock_left()
	var beacon_dropped: bool = stock_after_drop == stock_deep - 1
	var beacon_node: bool = not get_tree().get_nodes_in_group("beacon").is_empty()

	player.global_position = PlayerShip.SPAWN_POINT
	await get_tree().process_frame
	var stock_before := GameState.beacon_stock_left()
	var depth_here := deep_depth()
	await _press_key(KEY_B)
	var beacon_refused: bool = GameState.beacon_stock_left() == stock_before
	print("[input] THE BEACON KEY WORKS AND THEN REFUSES at depth %.0f the rack fell %d->%d and a beacon stands=%s; at depth %.1f it held at %d -> %s" % [
		depth_deep, stock_deep, stock_after_drop, str(beacon_node),
		depth_here, stock_before,
		"PASS" if beacon_dropped and beacon_node and beacon_refused
			and depth_deep > 0.0 and depth_here <= 0.0 else "FAIL"])

	# PAUSE IS ONE KEY, AND IT TAKES TWO NODES TO BE ONE. CameraRig is
	# PROCESS_MODE_INHERIT, so it stops receiving input the instant the tree
	# pauses and can only ever open; PauseMenu is ALWAYS but drops every event
	# behind `if not is_open`, so it can only ever close. Escape is split down
	# the same seam. Either half alone is a key that pauses and cannot unpause,
	# which is why both directions are measured here.
	await _press_key(KEY_P)
	var pause_on: bool = get_tree().paused and pause_menu.is_open
	await _press_key(KEY_P)
	var pause_off: bool = not get_tree().paused and not pause_menu.is_open
	print("[input] PAUSE IS ONE KEY p pauses=%s, p unpauses from the same key=%s -> %s" % [
		str(pause_on), str(pause_off), "PASS" if pause_on and pause_off else "FAIL"])
	get_tree().quit()


func _press_key(code: int) -> void:
	# One press-and-release on a real physical keycode, pushed through Input
	# itself so the whole dispatcher runs -- project.godot's action, the binding,
	# CameraRig's ladder and the wrapper at the end of it. Two frames: Godot
	# buffers input by one, and panel visibility settles on the next.
	#
	# Works while the tree is PAUSED, which the pause key needs: process_frame
	# still emits, and PROCESS_MODE_ALWAYS nodes still receive.
	var down := InputEventKey.new()
	down.physical_keycode = code
	down.pressed = true
	Input.parse_input_event(down)
	await get_tree().process_frame
	var up := InputEventKey.new()
	up.physical_keycode = code
	up.pressed = false
	Input.parse_input_event(up)
	await get_tree().process_frame


func _press_hold_key() -> bool:
	await _press_key(KEY_I)
	return hold_screen.is_open


func _distinct(items: Array) -> int:
	var uniq := {}
	for i in items:
		uniq[i] = true
	return uniq.size()


