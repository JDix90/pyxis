func _rises(name: String, arr: Array) -> String:
	# A band curve that never turns back on itself, walked to the ARRAY's own
	# length so a short table is reported by the size sweep rather than crashing
	# the run here.
	#
	# FROM INDEX 2, not 1, and that is not an off-by-one: GUARD_DIFFICULTY reads
	# [1.0, 0.90, ...] because the Shoals are deliberately GENTLER than charted
	# space — the band whose job is teaching that going out is survivable. Band 1
	# is allowed to dip; nothing after it is.
	var bad := ""
	for b in range(2, arr.size()):
		if float(arr[b]) < float(arr[b - 1]):
			bad += "%s@%d " % [name, b]
	return bad


func _outer_bays(sid: String) -> Array:
	# Every station the generator plans along four radial lanes through the
	# band-5/6 shell, as "cell:x,z,storage" entries. Lanes rather than a square
	# block because the shell starts 40 cells out: a -5..5 window like the world
	# fingerprint's would never reach it.
	var probe := DeepSpace.new()
	probe.generating = false
	add_child(probe)
	probe.configure(SystemDB.get_system(sid), sid)
	var out: Array = []
	for c in range(40, 84):
		for cell in [Vector2i(c, 0), Vector2i(-c, 0), Vector2i(0, c), Vector2i(c, c)]:
			var st: Dictionary = probe.plan_cell(cell.x, cell.y)["station"]
			if st.is_empty():
				continue
			var pos: Vector3 = st["pos"]
			out.append("%d,%d:%.3f,%.3f,%s" % [cell.x, cell.y, pos.x, pos.z,
				"1" if bool(st.get("storage", false)) else "0"])
	probe.queue_free()
	return out


func _run_frontier_test() -> void:
	await get_tree().create_timer(0.3).timeout

	# --- 0. the outer bays did not move --------------------------------------
	for sid in ["pyx01", "pyx02", "pyx03"]:
		var now_list := _outer_bays(String(sid))
		var live := {}
		for e_v in now_list:
			live[String(e_v)] = true
		var before: Array = String(OUTER_BAYS_BEFORE_FRONTIER[sid]).split("|", false)
		var orphaned := ""
		for e_v in before:
			if not live.has(String(e_v)):
				orphaned += "%s " % String(e_v)
		# The subset must be PROPER-or-equal in the growing direction and the
		# recorded side must be non-empty — an empty record is a subset of
		# anything, which is how this assertion would pass while measuring
		# nothing at all.
		var ok: bool = orphaned == "" and before.size() > 0 \
			and now_list.size() >= before.size()
		print("[frontier] NO BAY IS ORPHANED %s %d recorded bays all still stand at the same position and storage, now %d out there -> %s %s" % [
			String(sid), before.size(), now_list.size(),
			"PASS" if ok else "FAIL", orphaned])

	# --- 1. the ladder has seven rungs ---------------------------------------
	# Both sides of each new edge, because an off-by-one in band_of's loop is
	# exactly the defect that reads fine at 3000u and wrong at 2600.
	var edges_ok: bool = DeepSpace.band_of(2599.75) == 4 and DeepSpace.band_of(2600.0) == 5 \
		and DeepSpace.band_of(5199.75) == 5 and DeepSpace.band_of(5200.0) == 6 \
		and DeepSpace.band_of(9000.0) == 6
	var names_ok: bool = DeepSpace.BAND_NAMES.size() == 7 \
		and DeepSpace.BAND_EDGES.size() == 6
	print("[frontier] THE LADDER HAS SEVEN RUNGS 2599.75->%d 2600->%d 5199.75->%d 5200->%d 9000->%d, %d names over %d edges -> %s" % [
		DeepSpace.band_of(2599.75), DeepSpace.band_of(2600.0), DeepSpace.band_of(5199.75),
		DeepSpace.band_of(5200.0), DeepSpace.band_of(9000.0),
		DeepSpace.BAND_NAMES.size(), DeepSpace.BAND_EDGES.size(),
		"PASS" if edges_ok and names_ok else "FAIL"])

	# --- 2. the tables grew together -----------------------------------------
	# THE ANTI-CRASH ASSERTION, and the reason it names every table rather than
	# sampling: a band-indexed array one entry short does not misbehave, it reads
	# out of bounds the first time a player crosses into the band it is missing —
	# 5200u from home, in the one place in the game where dying costs the most.
	#
	# The COUNT is asserted with the set (63's rule), because "every table in this
	# list is the right size" is satisfied perfectly by a list somebody forgot to
	# add their new table to.
	var sized := {
		"STATION_CHANCE": DeepSpace.STATION_CHANCE.size(),
		"PACK_CHANCE": DeepSpace.PACK_CHANCE.size(),
		"PACK_HP": DeepSpace.PACK_HP.size(),
		"PACK_DIFFICULTY": DeepSpace.PACK_DIFFICULTY.size(),
		"PACK_MIN": DeepSpace.PACK_MIN.size(),
		"PACK_MAX": DeepSpace.PACK_MAX.size(),
		"PACK_DROP": DeepSpace.PACK_DROP.size(),
		"PACK_ESCORTS": DeepSpace.PACK_ESCORTS.size(),
		"TRAP_CHANCE": DeepSpace.TRAP_CHANCE.size(),
		"TRAP_EMP": DeepSpace.TRAP_EMP.size(),
		"TRAP_PACK_MIN": DeepSpace.TRAP_PACK_MIN.size(),
		"TRAP_PACK_MAX": DeepSpace.TRAP_PACK_MAX.size(),
		"TRAP_ESCORTS": DeepSpace.TRAP_ESCORTS.size(),
		"GUARD_DIFFICULTY": DeepSpace.GUARD_DIFFICULTY.size(),
		"GUARD_HP_SCALE": DeepSpace.GUARD_HP_SCALE.size(),
		"GUARD_DESIGNATION": DeepSpace.GUARD_DESIGNATION.size(),
		"SEAM_CHANCE": DeepSpace.SEAM_CHANCE.size(),
		"SEAM_UNITS": DeepSpace.SEAM_UNITS.size(),
		"LANDMARKS": DeepSpace.LANDMARKS.size(),
		"FAR_LEASH": DeepSpace.FAR_LEASH.size(),
		"BROADCASTS": DeepSpace.BROADCASTS.size(),
		"DEEP_BANDS": Palette.DEEP_BANDS.size(),
		"BAND_GLYPHS": Palette.BAND_GLYPHS.size(),
		"ALPHA_SPAN_BY_BAND": HUD.RadarLayer.ALPHA_SPAN_BY_BAND.size(),
		"DEEP_RAID_TAPER": DEEP_RAID_TAPER.size(),
	}
	var want := DeepSpace.BAND_NAMES.size()
	var wrong := ""
	for k in sized:
		if int(sized[k]) != want:
			wrong += "%s=%d " % [String(k), int(sized[k])]
	# Every remap set too — a mode whose row stopped one short would send the
	# colour-blind player, and only them, out of bounds.
	for mode_v in Palette.BAND_SETS:
		var row: Array = Palette.BAND_SETS[mode_v]
		if row.size() != want:
			wrong += "BAND_SETS[%d]=%d " % [int(mode_v), row.size()]
	print("[frontier] THE TABLES GREW TOGETHER %d band tables + %d remap sets all %d wide -> %s %s" % [
		sized.size(), Palette.BAND_SETS.size(), want,
		"PASS" if wrong == "" and sized.size() == 25 else "FAIL", wrong])

	# --- 3. the curves still only go one way ---------------------------------
	# The rule is monotonicity, not the numbers: values get retuned and a test
	# that pinned them would be rewritten every time rather than consulted. What
	# may never happen is a band that is SAFER or POORER than the one inside it,
	# which is the whole premise of measuring distance as depth.
	# EACH TABLE IS WALKED TO ITS OWN LENGTH, not to the band count, and that is a
	# defect this harness shipped with for exactly one red-verify. Shortening
	# TRAP_EMP to test the clause above threw "Out of bounds get index 6" HERE and
	# aborted the run — so the assertion whose whole job is diagnosing a short
	# table was followed immediately by the code that dies on one, and nine
	# clauses below never printed. The size sweep above already owns "this table
	# is the wrong length"; this one must survive to report what it owns.
	var mono := ""
	mono += _rises("PACK_HP", DeepSpace.PACK_HP)
	mono += _rises("PACK_DIFF", DeepSpace.PACK_DIFFICULTY)
	mono += _rises("PACK_MAX", DeepSpace.PACK_MAX)
	mono += _rises("ESCORTS", DeepSpace.PACK_ESCORTS)
	mono += _rises("TRAP", DeepSpace.TRAP_CHANCE)
	mono += _rises("EMP", DeepSpace.TRAP_EMP)
	mono += _rises("GUARD", DeepSpace.GUARD_DIFFICULTY)
	mono += _rises("GUARDHP", DeepSpace.GUARD_HP_SCALE)
	mono += _rises("STATION", DeepSpace.STATION_CHANCE)
	mono += _rises("SEAM", DeepSpace.SEAM_CHANCE)
	# And the raid taper is the one curve that runs the OTHER way and must never
	# reach zero — 17's "there is no range at which a full hold is safe".
	var taper_ok := true
	for b in range(1, DEEP_RAID_TAPER.size()):
		if DEEP_RAID_TAPER[b] > DEEP_RAID_TAPER[b - 1] or DEEP_RAID_TAPER[b] <= 0.0:
			taper_ok = false
	print("[frontier] THE CURVES ONLY GO ONE WAY threat rises through band 6, taper falls and stays above zero (%.2f at the edge) -> %s %s" % [
		DEEP_RAID_TAPER[DEEP_RAID_TAPER.size() - 1],
		"PASS" if mono == "" and taper_ok else "FAIL", mono])

	# --- 4. the deep still belongs to the unknowns ---------------------------
	# Pins the decision rather than discovering it: the frontier deliberately does
	# NOT introduce a fourth unknown. The Stillness (unknown_c) is neutral to the
	# surveyor and its neutrality is what keeps the Last Watch's fence open, so
	# hostile packs under its flag would break a shipped station.
	var f5 := deep_space.flag_for_band(5)
	var f6 := deep_space.flag_for_band(6)
	print("[frontier] THE DEEP STILL BELONGS TO THE UNKNOWNS band 5 flies '%s', band 6 flies '%s' -> %s" % [
		f5, f6, "PASS" if f5 == "unknown_b" and f6 == "unknown_b" else "FAIL"])

	# --- 5. the Tally's tell is still the Tally's ----------------------------
	# Both directions, because "the frontier chases further" and "the frontier
	# chases forever" are one number apart and only one of them is the design.
	# A finite leash that grows is a longer chase; a zero leash is the Tally's
	# alone, and a second faction owning it would spend the one thing that makes
	# being followed home mean anything.
	var l3 := DeepSpace.leash_for(3, "unknown_a")
	var l2 := DeepSpace.leash_for(2, "unknown_b")
	var l4 := DeepSpace.leash_for(4, "unknown_b")
	var l5 := DeepSpace.leash_for(5, "unknown_b")
	var l6 := DeepSpace.leash_for(6, "unknown_b")
	var tell_ok: bool = l3 == 0.0 and l2 == DeepSpace.HOSTILE_LEASH \
		and l4 == DeepSpace.HOSTILE_LEASH and l5 > l4 and l6 > l5 \
		and l5 > 0.0 and l6 > 0.0
	# And the Tally keeps it at every band it can appear in.
	var tally_ok: bool = DeepSpace.leash_for(5, "unknown_a") == 0.0
	print("[frontier] THE TALLY'S TELL IS STILL THE TALLY'S leashes b2 %.0f b3 %.0f b4 %.0f b5 %.0f b6 %.0f; the Tally's stays 0 at every band -> %s" % [
		l2, l3, l4, l5, l6, "PASS" if tell_ok and tally_ok else "FAIL"])

	# --- 6. every band has a grade, a chart and a seam -----------------------
	# The ordering guard. BAND_NAMES growing without CommodityDB growing would
	# leave the deepest loot in the game ungradeable, and the failure would be a
	# silent empty string at 5200u rather than an error anywhere near the change.
	var missing := ""
	for b in range(1, DeepSpace.BAND_NAMES.size()):
		if CommodityDB.salvage_for_band(b) == "": missing += "salvage@%d " % b
		if CommodityDB.chart_for_band(b) == "": missing += "chart@%d " % b
		if (CommodityDB.SEAM_YIELDS.get(b, []) as Array).is_empty(): missing += "seam@%d " % b
	print("[frontier] EVERY BAND HAS A GRADE, A CHART AND A SEAM bands 1-%d -> %s %s" % [
		DeepSpace.BAND_NAMES.size() - 1, "PASS" if missing == "" else "FAIL", missing])

	# --- 7. richer outward, all the way out ----------------------------------
	# Computed from the live tables, so a retune of either the ore prices or
	# SEAM_UNITS is checked rather than a transcription of today's numbers.
	var per_seam: Array = []
	var rises := true
	for b in range(0, DeepSpace.BAND_NAMES.size()):
		var row: Array = CommodityDB.SEAM_YIELDS.get(b, [])
		var total := 0.0
		for o_v in row:
			total += float(CommodityDB.get_good(String(o_v)).get("base", 0))
		var mean := total / maxf(float(row.size()), 1.0)
		var value := mean * float(DeepSpace.SEAM_UNITS[b])
		per_seam.append(roundf(value))
		if b > 0 and value <= float(per_seam[b - 1]):
			rises = false
	print("[frontier] RICHER OUTWARD, ALL THE WAY OUT per-seam value by band %s strictly rising -> %s" % [
		str(per_seam), "PASS" if rises else "FAIL"])

	# --- 8. the frontier is not a raise --------------------------------------
	# COLONYTEST's template. The pacing loop is measured at depth 0 and the
	# regrade funnel grades by the band you are standing in, so a frontier grade
	# cannot reach the measured loop — but "cannot" is an argument until the
	# funnel's own input is checked, so band_of(0.0) is asserted here beside the
	# absence of any frontier term.
	var no_term: bool = not PACING_LOOP.has("frontier") and not PACING_LOOP.has("band") \
		and not PACING_PROSPECT.has("frontier") and not PACING_PROSPECT.has("band")
	var depth0: bool = DeepSpace.band_of(0.0) == 0 \
		and CommodityDB.salvage_for_band(0) == "salvage_charted"
	print("[frontier] THE FRONTIER IS NOT A RAISE no frontier term in either pacing profile=%s, the measured loop still grades at band 0 as '%s' -> %s" % [
		str(no_term), CommodityDB.salvage_for_band(0),
		"PASS" if no_term and depth0 else "FAIL"])

	# --- 8b. and the weather did not get richer ------------------------------
	# THE ONE THING THE BAND GROWTH NEARLY RAISED BY ACCIDENT, kept here rather
	# than in RIFTTEST because it is a frontier defect, not a rift defect: Rift's
	# grade clamp used to read BAND_NAMES.size() - 1, so appending two bands moved
	# a band-4 shear from Quiet Salvage (340) to Fathom Salvage (480) — a 41%
	# raise 1400u INSIDE the content this stage adds. Rifts stop at depth_max
	# 1200, so the frontier has nothing to say about what they pay.
	#
	# Asserted as the RULE (a shear pays a grade a rift can actually be found in)
	# rather than as the number 4, so authoring weather further out moves the
	# ceiling deliberately instead of silently.
	var deepest_rift_depth := 0.0
	for sid_v in ["pyx01", "pyx02", "pyx03"]:
		deepest_rift_depth = maxf(deepest_rift_depth,
			SystemDB.rift_depth_max(String(sid_v), RIFT_DEPTH_MAX))
	var deepest_rift_band := DeepSpace.band_of(deepest_rift_depth)
	var ceiling_ok: bool = Rift.GRADE_CEILING <= deepest_rift_band \
		and CommodityDB.salvage_for_band(Rift.GRADE_CEILING) == "salvage_quiet"
	print("[frontier] THE WEATHER DID NOT GET RICHER deepest rift is depth %.0f (band %d); the grade ceiling is band %d = '%s' -> %s" % [
		deepest_rift_depth, deepest_rift_band, Rift.GRADE_CEILING,
		CommodityDB.salvage_for_band(Rift.GRADE_CEILING),
		"PASS" if ceiling_ok else "FAIL"])

	# --- 9. the frontier reads without colour --------------------------------
	# The glyph half of the colour rule, extended: the two new marks must be
	# non-empty, distinct from every other band's, and distinct from every cargo
	# family's — the manual teaches these shapes and one shape may not mean two
	# things.
	var marks := {}
	var clash := ""
	for b in range(1, Palette.BAND_GLYPHS.size()):
		var g := Palette.band_glyph(b)
		if g == "" or marks.has(g):
			clash += "band %d '%s' " % [b, g]
		marks[g] = true
		for fam in Palette.FAMILY_GLYPHS:
			if String(Palette.FAMILY_GLYPHS[fam]) == g:
				clash += "band %d collides with family %s " % [b, String(fam)]
	print("[frontier] THE FRONTIER READS WITHOUT COLOUR %d band marks, distinct and clear of the %d family marks -> %s %s" % [
		marks.size(), Palette.FAMILY_GLYPHS.size(),
		"PASS" if clash == "" and marks.size() == Palette.BAND_GLYPHS.size() - 1 else "FAIL",
		clash])

	# --- 10. the frontier speaks, and its landmarks exist --------------------
	# Every band the generator can place must be buildable and must have
	# something to say. A LANDMARKS entry with no branch in Landmarks.build
	# returns null and the supercell is silently empty — the emptiness the
	# landmark feature exists to fix, reintroduced at the far end of the map.
	var voiceless := ""
	for b in range(1, DeepSpace.BAND_NAMES.size()):
		if String(DeepSpace.broadcast_for(b).get("body", "")) == "":
			voiceless += "broadcast@%d " % b
		var kind := String(DeepSpace.LANDMARKS[b])
		if kind == "":
			voiceless += "landmark@%d " % b
			continue
		var node := Landmarks.build(kind, b)
		if node == null:
			voiceless += "unbuildable '%s'@%d " % [kind, b]
		else:
			node.queue_free()
	# And the register's arc still ends at the Quiet: the frontier is reached,
	# never acknowledged. A commissioned key on a frontier entry would undo the
	# note band 4 exists to land.
	var late_register := ""
	for b in range(4, DeepSpace.BROADCASTS.size()):
		var e: Dictionary = DeepSpace.BROADCASTS[b]
		if e.has("from_commissioned") or e.has("body_commissioned"):
			late_register += "band %d " % b
	print("[frontier] THE FRONTIER SPEAKS AND STANDS every band 1-%d has a voice and a buildable landmark; the register still stops at the Quiet -> %s %s%s" % [
		DeepSpace.BAND_NAMES.size() - 1,
		"PASS" if voiceless == "" and late_register == "" else "FAIL",
		voiceless, late_register])

	# --- 11. every Mk III beats its Mk II, and pays for it -------------------
	# The weapon families could not join the shipped STRICTLY BETTER sweep,
	# because `interval` is the one stat where LOWER is better and that sweep
	# demands every key rise. So the direction is stated per key here rather than
	# assumed, which is also the only way a typo'd interval gets caught at all.
	var mk3 := ["pulse_3", "lance_3", "arc_3", "torp_3",
		"util_repair_3", "util_shield_3", "util_scanner_3"]
	var better := ""
	for id_v in mk3:
		var id := String(id_v)
		var prev := id.trim_suffix("_3") + "_2"
		var a: Dictionary = ModuleDB.get_module(prev)
		var b: Dictionary = ModuleDB.get_module(id)
		if a.is_empty() or b.is_empty():
			better += "%s missing " % id
			continue
		for key in (a["stats"] as Dictionary):
			var lo := float((a["stats"] as Dictionary)[key])
			var hi := float((b["stats"] as Dictionary).get(key, -1.0))
			# interval is a period: shorter is faster, so it must FALL.
			var ok: bool = (hi < lo) if key == "interval" else (hi > lo)
			# chain 0 on a family that does not chain stays 0 rather than rising.
			if key == "chain" and lo == 0.0 and hi == 0.0:
				ok = true
			if not ok:
				better += "%s.%s %.2f->%.2f " % [id, key, lo, hi]
		if int(b["power"]) <= int(a["power"]):
			better += "%s draws no more power " % id
		if int(b["price"]) <= int(a["price"]):
			better += "%s costs no more " % id
	# And the family rule the catalog states about itself: Pulse is the efficient
	# generalist and must never out-damage a Lance of its own tier.
	var pulse_st: Dictionary = ModuleDB.get_module("pulse_3")["stats"]
	var lance_st: Dictionary = ModuleDB.get_module("lance_3")["stats"]
	var pulse_dps := float(pulse_st["damage"]) / float(pulse_st["interval"])
	var lance_dps := float(lance_st["damage"]) / float(lance_st["interval"])
	print("[frontier] EVERY MK III EARNS ITS RUNG %d modules beat their Mk II on every stat, power and price; pulse %.0f dps stays under lance %.0f -> %s %s" % [
		mk3.size(), pulse_dps, lance_dps,
		"PASS" if better == "" and pulse_dps < lance_dps else "FAIL", better])

	# --- 12. the Mk V is a destination --------------------------------------
	# The gate is the whole feature. Without it the reactor row is money-only and
	# the deepest purchase in the game is for sale at the first counter a new
	# pilot ever docks at.
	GameState.reactor_tier = 3
	GameState.salvage = 200000
	var sold_at_chart := GameState.upgrade_reactor()                       # default cap
	var sold_at_deep := GameState.upgrade_reactor(4)                       # a counter that stocks it
	var chart_caps := ""
	for pid_v in SystemDB.port_ids():
		if SystemDB.port_def_by_id(String(pid_v)).has("reactor_cap"):
			chart_caps += "%s " % String(pid_v)
	GameState.reactor_tier = 0
	GameState.salvage = 0
	print("[frontier] THE MK V IS A DESTINATION refused at a default counter=%s, sold at a cap-4 counter=%s, charted defs naming a cap: %s -> %s" % [
		str(not sold_at_chart), str(sold_at_deep), chart_caps if chart_caps != "" else "none",
		"PASS" if not sold_at_chart and sold_at_deep and chart_caps == "" else "FAIL"])

	# --- 13. all-best is still out of reach ---------------------------------
	# 46's invariant, and the one thing a new reactor tier could quietly break.
	# Computed from the LIVE catalog rather than from the numbers in the comment
	# beside REACTOR_TIERS, so a cheap new module cannot close the gap silently.
	var by_slot := {}
	for id_v in ModuleDB.MODULES:
		var m: Dictionary = ModuleDB.get_module(String(id_v))
		var cat := String(m.get("category", ""))
		by_slot[cat] = maxi(int(by_slot.get(cat, 0)), int(m.get("power", 0)))
	# v24 (§94). THE MULTIPLICITIES ARE DERIVED, and both ships are measured.
	# This used to read `weapon * 2 ... utility * 2`, hand-written multipliers
	# that were the shipped hull's slot counts spelled out -- correct until the
	# day a slot was added, at which point the invariant would have kept
	# reporting green about a ship nobody flies. It now counts SLOT_CATEGORY.
	var berth_slots := {}
	for b_v in ModuleDB.BERTHS:
		berth_slots[int((ModuleDB.BERTHS[b_v] as Dictionary)["slot"])] = true
	var greedy := func(include_berths: bool) -> int:
		var total := 0
		for slot_v in ModuleDB.SLOT_CATEGORY:
			if berth_slots.has(int(slot_v)) and not include_berths:
				continue
			total += int(by_slot.get(String(ModuleDB.SLOT_CATEGORY[slot_v]), 0))
		return total
	var all_best: int = greedy.call(false)
	var top_power: int = int(ModuleDB.REACTOR_TIERS[ModuleDB.REACTOR_TIERS.size() - 1]["power"])
	# AND THE BERTHED SHIP, which is the promise berths were sold on: every
	# berth adds LESS power than the best module that could stand in its slot,
	# so the gap widens with every one bought and all-best gets further away
	# rather than closer. Measured as a margin comparison rather than restated
	# as two numbers, so a generous berth cannot creep the cap up to meet the
	# catalog.
	var berthed_best: int = greedy.call(true)
	var berthed_cap: int = top_power + ModuleDB.berth_power(ModuleDB.BERTHS.keys())
	var margin_bare := all_best - top_power
	var margin_full := berthed_best - berthed_cap
	# And the step IS the product: the named fit Mk V exists to make possible must
	# fit it exactly, or the number is arbitrary.
	var named := 0
	for id_v in ["lance_3", "torp_3", "drive_vector_2", "core_aegis", "util_torch"]:
		named += int(ModuleDB.get_module(String(id_v))["power"])
	print("[frontier] ALL-BEST IS STILL OUT OF REACH bare hull draws %d against the top reactor's %d (margin %d); fully berthed draws %d against %d (margin %d, must not shrink); the named Mk V fit draws exactly %d -> %s" % [
		all_best, top_power, margin_bare, berthed_best, berthed_cap, margin_full, named,
		"PASS" if all_best > top_power and margin_full >= margin_bare
			and named == top_power else "FAIL"])

	# --- 14. the frontier's gear is not on the chart -------------------------
	# The inverse of the shipped STOCKED sweep, and the point of the whole stage:
	# every charted outfitter's stock is a set the Mk III line must be absent
	# from. Set-based with the count asserted, so a tier-3 module added later and
	# quietly stocked at home is caught by the same clause.
	var charted_stock := {}
	for pid_v in SystemDB.port_ids():
		for m_v in SystemDB.port_def_by_id(String(pid_v)).get("stock", []):
			charted_stock[String(m_v)] = true
	var tier3 := []
	var on_chart := ""
	for id_v in ModuleDB.MODULES:
		var m: Dictionary = ModuleDB.get_module(String(id_v))
		if int(m.get("tier", 0)) != 3:
			continue
		tier3.append(String(id_v))
		if charted_stock.has(String(id_v)):
			on_chart += "%s " % String(id_v)
	# The deep half is gated until a deep archetype stocks any of it, so this
	# clause is honest in the stage that authors the catalog AND in the stage
	# that authors the counters — rather than being written twice.
	var deep_stock := {}
	for arch_v in DeepPortDB.ARCHETYPES:
		for m_v in (arch_v as Dictionary).get("stock", []):
			deep_stock[String(m_v)] = true
	var deep_sells_any := false
	for id_v in tier3:
		if deep_stock.has(String(id_v)):
			deep_sells_any = true
	var unsold := ""
	if deep_sells_any:
		for id_v in tier3:
			if not deep_stock.has(String(id_v)):
				unsold += "%s " % String(id_v)
	print("[frontier] THE FRONTIER'S GEAR IS NOT ON THE CHART %d tier-3 modules, on charted counters: %s; a deep counter stocks them=%s, unsold out there: %s -> %s" % [
		tier3.size(), on_chart if on_chart != "" else "none", str(deep_sells_any),
		unsold if unsold != "" else "none",
		"PASS" if on_chart == "" and tier3.size() == 10 and unsold == "" else "FAIL"])

	# --- 15. the two new tools actually DO something -------------------------
	# A stat key with a consumer nobody drives is the same defect as a stat key
	# with no consumer at all: it reads correctly on the sheet, moves nothing in
	# play, and the store row is a lie. Both are measured through the REAL code
	# path — a live Derelict's hold and the ship's own activate_ability — rather
	# than by re-deriving the arithmetic here, which would assert the formula
	# against itself.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	GameState.owned.append("util_torch")
	GameState.owned.append("util_haste")

	var wreck := Derelict.new()
	wreck.counts_as_survey = false
	wreck.counts_for_contract = false
	system_root.add_child(wreck)
	wreck.global_position = player.global_position + Vector3(0.0, 0.0, -10.0)
	await get_tree().process_frame
	# PARKED AT THE BREACH POINT, not at the hull: hold_tick's range check
	# measures from breach_point, which sits off the hull's own axis, so a probe
	# sitting on the centre reads as out of range and the tick returns having
	# done nothing. Both samples would then be 0.000 and their ratio meaningless
	# — which is exactly how this assertion first failed.
	player.global_position = wreck.breach_point
	await get_tree().process_frame
	wreck.crack_time = 10.0                 # long, so one tick is well clear of 1.0
	# Bare hull first, then the same tick with the Torch fitted.
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	await get_tree().process_frame
	wreck._progress = 0.0
	wreck._holding = true
	wreck.hold_tick(1.0)
	var bare_progress := wreck._progress
	GameState.equip(ModuleDB.Slot.UTILITY, "util_torch")
	await get_tree().process_frame
	wreck._progress = 0.0
	wreck._holding = true
	wreck.hold_tick(1.0)
	var torch_progress := wreck._progress
	wreck._holding = false
	wreck.queue_free()
	var torch_gain := torch_progress / maxf(bare_progress, 0.0001)
	var want_gain := 1.0 + float(ModuleDB.get_module("util_torch")["stats"]["breach_speed"])
	print("[frontier] THE TORCH CUTS FASTER one second of hold moves a 10s wreck %.3f bare and %.3f lit, a factor of %.2f against the fitted %.2f -> %s" % [
		bare_progress, torch_progress, torch_gain, want_gain,
		"PASS" if is_equal_approx(snappedf(torch_gain, 0.01), snappedf(want_gain, 0.01)) else "FAIL"])

	# The Capacitors, through activate_ability, plus the readout that goes with
	# it: the HUD ring must read FULL the instant the ability fires, which is the
	# defect a hasted timer divided by an unhasted total would have shipped.
	GameState.equip(ModuleDB.Slot.CORE, "core_overcharge")
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	await get_tree().process_frame
	var bare_cd := ModuleDB.ability_cooldown(GameState.stats)
	GameState.equip(ModuleDB.Slot.UTILITY, "util_haste")
	await get_tree().process_frame
	var hasted_cd := ModuleDB.ability_cooldown(GameState.stats)
	player.activate_ability()
	var ring := player.ability_cooldown_fraction()
	var haste := float(ModuleDB.get_module("util_haste")["stats"]["ability_haste"])
	var want_cd := bare_cd * (1.0 - haste)
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	print("[frontier] THE CAPACITORS BRING IT BACK cooldown %.2fs bare -> %.2fs hasted (want %.2f); the ring reads %.2f at the instant it fires -> %s" % [
		bare_cd, hasted_cd, want_cd, ring,
		"PASS" if is_equal_approx(snappedf(hasted_cd, 0.01), snappedf(want_cd, 0.01))
			and hasted_cd < bare_cd and ring > 0.99 else "FAIL"])

	# --- 16. every authored weights row is the width its band will be read at -
	# weighted_index falls back to the UNIFORM pick whenever a row's size does not
	# match the list being picked from, silently and by design — so a row authored
	# one entry short does not error, it switches that system's whole accent off.
	# Adding an archetype changes for_band's output length for every band at or
	# past its min_band, which is exactly when this goes wrong and exactly when
	# nobody is looking at system_db.
	var width_bad := ""
	var rows_checked := 0
	for sid_v in SystemDB.ids():
		for band in range(1, DeepSpace.BAND_NAMES.size()):
			var row: Array = SystemDB.station_weights(String(sid_v), band)
			if row.is_empty():
				continue
			rows_checked += 1
			var want_w: int = DeepPortDB.for_band(band).size()
			if row.size() != want_w:
				width_bad += "%s b%d is %d wide, for_band gives %d " % [
					String(sid_v), band, row.size(), want_w]
	# And the same for the landmark rows, whose list did NOT grow — the pairing is
	# the point: one of these two lists changed width this horizon and the other
	# deliberately did not, and both have to be checked by the same rule.
	for sid_v in SystemDB.ids():
		for band in range(1, DeepSpace.BAND_NAMES.size()):
			var row: Array = SystemDB.landmark_weights(String(sid_v), band)
			if row.is_empty():
				continue
			rows_checked += 1
			if row.size() != DeepSpace.LANDMARK_KINDS.size():
				width_bad += "%s b%d landmark row is %d wide, kinds is %d " % [
					String(sid_v), band, row.size(), DeepSpace.LANDMARK_KINDS.size()]
	# THE NON-VACUITY GUARD IS A RULE, NOT A COUNT. "17 rows" is just today's
	# number and would go stale the first time anybody authors another; what has
	# to be true is that the frontier's two bands are actually WEIGHTED somewhere
	# rather than left to the uniform default, because a sweep over zero rows
	# passes perfectly.
	var frontier_authored := false
	for sid_v in SystemDB.ids():
		if not SystemDB.station_weights(String(sid_v), 5).is_empty() \
				and not SystemDB.station_weights(String(sid_v), 6).is_empty():
			frontier_authored = true
	print("[frontier] EVERY AUTHORED ROW IS THE RIGHT WIDTH %d station and landmark rows across %d systems match the list they weight; bands 5 and 6 are authored=%s -> %s %s" % [
		rows_checked, SystemDB.ids().size(), str(frontier_authored),
		"PASS" if width_bad == "" and rows_checked > 0 and frontier_authored else "FAIL",
		width_bad])

	# --- 17. the deep repair bays stay a mercy -------------------------------
	# A property that held across all five shipped deep bays and was nearly broken
	# by this stage: every one of them is CHEAPER than the charted full price, and
	# the tail from the Reaches outward gets kinder with distance. The first draft
	# of THE BREAKWATER charged 1600 — the only repair in the game above the
	# chart's own 1400, at the band with the highest PACK_HP in the game.
	var dear := ""
	var deep_tail: Array = []
	for arch_v in DeepPortDB.ARCHETYPES:
		var a: Dictionary = arch_v
		var rp := int(a.get("repair_price", PortPanel.REPAIR_FULL_PRICE))
		if rp >= PortPanel.REPAIR_FULL_PRICE:
			dear += "%s %d " % [String(a["id"]), rp]
		if int(a["min_band"]) >= 3:
			deep_tail.append(rp)
	var kinder := true
	for i in range(1, deep_tail.size()):
		if int(deep_tail[i]) > int(deep_tail[i - 1]):
			kinder = false
	print("[frontier] THE DEEP BAYS STAY A MERCY %d archetypes all under the charted %d; the band-3-outward tail %s never rises -> %s %s" % [
		DeepPortDB.ARCHETYPES.size(), PortPanel.REPAIR_FULL_PRICE, str(deep_tail),
		"PASS" if dear == "" and kinder else "FAIL", dear])

	# --- 18. one shape, one counter, at any band you can meet them ----------
	# A port's NAME only reaches the player at DOCK_RANGE 5.0, so the silhouette is
	# the whole of what a marker says before the flight. Two archetypes sharing a
	# `kind` at a band where both can spawn means committing to a long approach to
	# learn which counter you picked — the same argument the landmarks make for
	# having six shapes instead of one shape in six colours.
	var shape_clash := ""
	for band in range(1, DeepSpace.BAND_NAMES.size()):
		var seen_kinds := {}
		for arch_v in DeepPortDB.for_band(band):
			var k := String((arch_v as Dictionary)["kind"])
			if seen_kinds.has(k):
				shape_clash += "band %d: %s and %s are both '%s' " % [
					band, String(seen_kinds[k]), String((arch_v as Dictionary)["id"]), k]
			seen_kinds[k] = String((arch_v as Dictionary)["id"])
	print("[frontier] ONE SHAPE, ONE COUNTER no two archetypes share a silhouette at any band -> %s %s" % [
		"PASS" if shape_clash == "" else "FAIL", shape_clash])

	# --- 19. the fence sells nothing the market hides ------------------------
	# THE DEFECT THIS STAGE WAS ABOUT TO SHIP. trades_at short-circuits on
	# components BEFORE the deep-port exemption, so a component is restricted to
	# its own trade_only_at list however deep the counter is. Give a new port a
	# fence list naming eleven components without naming the port on the eleven
	# goods, and its fence tab sells what its market tab does not list — with the
	# two data sources disagreeing and nothing going red. 11's rule, pointing the
	# other way: declared tradeable must mean actually tradeable.
	var hidden := ""
	for arch_v in DeepPortDB.ARCHETYPES:
		var a: Dictionary = arch_v
		var pid := String(a["id"])
		for g_v in a.get("fence_goods", []):
			var gid := String(g_v)
			if not CommodityDB.trades_at(gid, pid):
				hidden += "%s fences %s but it does not trade there " % [pid, gid]
	print("[frontier] THE FENCE SELLS NOTHING THE MARKET HIDES every fence_goods entry trades at the desk that fences it -> %s %s" % [
		"PASS" if hidden == "" else "FAIL", hidden])

	# --- 20. a grave-field is two wrecks, and they die separately -----------
	# THE INVARIANT STAGE 4 BROKE ON PURPOSE. deep_space.gd said in writing that
	# "a cell holds at most one hulk", and `_cracked` was a flat set of CELLS on
	# the strength of it — so a second hull would have come back already-breached
	# the moment its partner was opened, and its loot would have vanished with it.
	# Identity is (cell, index) now, and this is the check.
	var gf_cell := Vector2i(9001, -9001)
	deep_space.note_hulk_cracked(gf_cell, 0)
	var first_open := deep_space.is_hulk_cracked(gf_cell, 0)
	var second_still_shut := not deep_space.is_hulk_cracked(gf_cell, 1)
	deep_space.note_hulk_cracked(gf_cell, 1)
	var second_open := deep_space.is_hulk_cracked(gf_cell, 1)
	# And the shipped call shape still means what it always meant: no argument is
	# index 0, so every existing caller is untouched by construction.
	var legacy_cell := Vector2i(9002, -9002)
	deep_space.note_hulk_cracked(legacy_cell)
	var legacy_ok := deep_space.is_hulk_cracked(legacy_cell) \
		and deep_space.is_hulk_cracked(legacy_cell, 0)
	print("[frontier] TWO WRECKS DIE SEPARATELY cracking one leaves the other shut=%s, both can open=%s, the no-index call still means index 0=%s -> %s" % [
		str(second_still_shut), str(first_open and second_open), str(legacy_ok),
		"PASS" if second_still_shut and first_open and second_open and legacy_ok else "FAIL"])

	# --- 21. grave-fields are band 6 and pair with a wreck that exists -------
	# Planned rather than spawned, because the property is the GENERATOR's: a
	# second hull may only exist beside a first, only past 5200u, and never
	# carrying its own trap. Swept over real cells rather than asserted of the
	# constants, so the gate is measured where it actually runs.
	var gf_probe := DeepSpace.new()
	gf_probe.generating = false
	add_child(gf_probe)
	gf_probe.configure(SystemDB.get_system("pyx01"), "pyx01")
	var gf_bad := ""
	var gf_found := 0
	var gf_inner := 0
	for c in range(20, 96):
		for cell in [Vector2i(c, 0), Vector2i(0, c), Vector2i(c, c), Vector2i(-c, 0)]:
			var pl: Dictionary = gf_probe.plan_cell(cell.x, cell.y)
			var h2: Dictionary = pl["hulk2"]
			if h2.is_empty():
				continue
			gf_found += 1
			if int(pl["band"]) < 6:
				gf_inner += 1
			if not (h2["trap"] as Dictionary).is_empty():
				gf_bad += "trapped@%d,%d " % [cell.x, cell.y]
			# THE ORPHAN CASE RECORDS AND THEN STOPS. The first draft noted the
			# orphan and fell straight through to the gap arithmetic below, which
			# reads ["pos"] off the hull that is missing — so the assertion
			# ABORTED on the exact defect it was written to report, taking the
			# two clauses after it and the quit() with it. A red-verify found it:
			# the run did not fail, it HUNG, which under a sweep is a timeout
			# rather than a red line. An assertion that crashes on its own
			# subject is worth less than one that is merely wrong.
			if (pl["hulk"] as Dictionary).is_empty():
				gf_bad += "orphan@%d,%d " % [cell.x, cell.y]
				continue
			var gap: float = (h2["pos"] as Vector3).distance_to((pl["hulk"] as Dictionary)["pos"])
			if gap < DeepSpace.GRAVE_GAP_MIN - 0.01 or gap > DeepSpace.GRAVE_GAP_MAX + 0.01:
				gf_bad += "gap %.1f@%d,%d " % [gap, cell.x, cell.y]
	gf_probe.queue_free()
	print("[frontier] A GRAVE-FIELD IS TWO SHIPS THAT DIED TOGETHER %d found, none inside band 6=%s, each beside a real wreck at %.0f-%.0fu and carrying no trap -> %s %s" % [
		gf_found, str(gf_inner == 0), DeepSpace.GRAVE_GAP_MIN, DeepSpace.GRAVE_GAP_MAX,
		"PASS" if gf_bad == "" and gf_found > 0 and gf_inner == 0 else "FAIL", gf_bad])

	# --- 22. the weather reaches further and pays the same ------------------
	# Range is content; grade is economy. Stage 4 ships the first, and this pins
	# the second: no authored rift may reach a band deeper than the grade ceiling
	# can pay for, or a shear starts paying WORSE than the band it is standing in.
	var deepest_rift := 0.0
	for sid_v in SystemDB.ids():
		deepest_rift = maxf(deepest_rift, SystemDB.rift_depth_max(String(sid_v), RIFT_DEPTH_MAX))
	var rift_band := DeepSpace.band_of(deepest_rift)
	var pays := CommodityDB.salvage_for_band(Rift.GRADE_CEILING)
	var stands_in := CommodityDB.salvage_for_band(rift_band)
	var not_worse: bool = CommodityDB.base_price(pays) >= CommodityDB.base_price(stands_in)
	print("[frontier] THE WEATHER REACHES FURTHER AND PAYS THE SAME deepest rift %.0fu is band %d standing in '%s' (%d); the ceiling pays '%s' (%d), never less -> %s" % [
		deepest_rift, rift_band, stands_in, CommodityDB.base_price(stands_in),
		pays, CommodityDB.base_price(pays),
		"PASS" if not_worse and Rift.GRADE_CEILING <= rift_band else "FAIL"])

	get_tree().quit()


# --- storms ------------------------------------------------------------------

func _run_storm_test() -> void:
	# A SUITE OF ITS OWN, not a FRONTIERTEST extension. FRONTIERTEST is a data
	# suite — tables, curves, glyph sets — that runs with generation off and
	# finishes fast. A storm needs live nodes, staged fits and physics frames,
	# which is APEXTEST's shape and APEXTEST's runtime.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(0.4).timeout
	_wave_timer = 1.0e9
	_rift_timer = 1.0e9
	_storm_timer = 1.0e9
	_muster_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	player.invulnerable = true

	var storm := Storm.new()
	system_root.add_child(storm)
	# STAGED AT A REAL BAND-6 DEPTH. The first draft parked it at 900u, where the
	# band clamp fires every frame and steers radially — so the drift test
	# measured the clamp fighting the heading rather than the standoff, and the
	# storm moved perpendicular to the ship it was supposed to be closing on.
	var storm_depth := SystemDB.bounds_of(system_id) + Storm.band_floor() + 600.0
	storm.global_position = Vector3(0, 0, -storm_depth)
	await get_tree().process_frame

	# --- S1. the pull goes through the ship's own channel --------------------
	# Two halves, because either alone is fooled. If the storm wrote
	# global_position or velocity directly, clearing the tether every frame would
	# change nothing and both halves would agree.
	#
	# CLOSURE ON THE CENTRE, not displacement from the park: 40 records that
	# measuring distance-from-start counts an outward shove as success, which is
	# the opposite failure.
	player.global_position = storm.global_position + Vector3(Storm.PULL_RADIUS * 0.5, 0, 0)
	player.has_move_target = false
	player.velocity = Vector3.ZERO
	player.clear_tether()
	var open_a := player.global_position.distance_to(storm.global_position)
	for i in range(180):
		await get_tree().physics_frame
	var closed_a := open_a - player.global_position.distance_to(storm.global_position)

	player.global_position = storm.global_position + Vector3(Storm.PULL_RADIUS * 0.5, 0, 0)
	player.velocity = Vector3.ZERO
	player.clear_tether()
	var open_b := player.global_position.distance_to(storm.global_position)
	for i in range(180):
		player.clear_tether()
		await get_tree().physics_frame
	var closed_b := open_b - player.global_position.distance_to(storm.global_position)
	print("[storm] THE PULL GOES THROUGH THE SHIP'S OWN CHANNEL idle ship closed %.1fu in 3s; with the tether channel cleared every frame it closed %.1fu -> %s" % [
		closed_a, closed_b, "PASS" if closed_a > 2.0 and absf(closed_b) < 0.5 else "FAIL"])

	# --- S1b. two storms cannot build a cage ---------------------------------
	# Deliberately violating MIN_STORM_SEPARATION, because the point is that the
	# separation constant is NOT what keeps this safe. apply_tether's
	# limit_length re-clamps per call, so N storms still cannot exceed the
	# ceiling — and somebody who believes the separation is load-bearing will
	# eventually delete the assertion that actually proves it.
	# STAGED SO THE TWO PULLS REINFORCE, which the first draft got exactly wrong.
	# It put the ship midway between the storms, so their inward UNIT vectors
	# were exactly opposed, cancelled every frame, and the channel measured
	# 0.000 — a number it would also print with no clamp whatsoever. The clause
	# was asserting that two opposed unit vectors sum to zero.
	#
	# It was caught by a red-verify, and the proof it was blind rather than lucky
	# is that S1 above moved from 2.4u to 4.4u in the SAME process: the
	# un-ceilinged drag was live on the very frames this was measuring.
	#
	# Both storms now sit at the same distance from the ship and 60 degrees
	# apart, so the pulls add rather than annihilate and the cap is the binding
	# constraint. Equal distance also removes the order-dependence: apply_tether
	# limit_lengths the ACCUMULATED vector on every call, so with unequal caps
	# the last caller wins and the reading would be about call order rather than
	# about the ceiling.
	var storm_b := Storm.new()
	system_root.add_child(storm_b)
	var cage_r := Storm.PULL_RADIUS * 0.3
	player.global_position = storm.global_position + Vector3(-cage_r, 0, 0)
	storm_b.global_position = player.global_position \
		+ Vector3(cos(deg_to_rad(60.0)), 0.0, sin(deg_to_rad(60.0))) * cage_r
	await get_tree().process_frame
	player.velocity = Vector3.ZERO
	player.clear_tether()
	for i in range(120):
		await get_tree().physics_frame
	var caged: float = (player._tether_vel as Vector3).length()
	var floor_speed := float(ModuleDB.enforce_floors({"max_speed": 0.0, "accel": 0.0,
		"turn_rate": 0.0, "shield_max": 0.0, "weapon_range_bonus": 0.0})["max_speed"])
	# AND THE CHANNEL HAS TO HAVE ACTUALLY FILLED. This is the clause the first
	# draft lacked, and its absence is the whole reason the vacuous version
	# passed: every bound here is satisfied by zero, and zero is exactly what
	# perfect cancellation produces.
	print("[storm] TWO STORMS CANNOT BUILD A CAGE two reinforcing rings drove the drag channel to %.3f u/s (it did fill=%s) against the %.2f ceiling and the %.2f max_speed floor -> %s" % [
		caged, str(caged > 0.05), PlayerShip.TETHER_DRAG_CEILING, floor_speed,
		"PASS" if caged > 0.05 and caged <= PlayerShip.TETHER_DRAG_CEILING + 0.001
			and caged < floor_speed else "FAIL"])
	storm_b.queue_free()
	await get_tree().process_frame

	# --- S2. the weakest legal fit escapes from outside the eye --------------
	# Staged against ModuleDB's FLOORS rather than a named fit, for APEXTEST's
	# stated reason: the floors are what the promise is made of, so a ship that
	# escapes on them means every fit does — and a named fit quietly stops
	# meaning anything the next time the catalog moves.
	var kept := GameState.stats.duplicate(true)
	var weak := GameState.stats.duplicate(true)
	weak["max_speed"] = 1.6
	weak["accel"] = 3.0
	player._apply_fit(weak)
	player.global_position = storm.global_position + Vector3(Storm.EYE_RADIUS + 1.0, 0, 0)
	player.velocity = Vector3.ZERO
	player.clear_tether()
	# Let it latch BEFORE burning — the order the mechanic is actually played in.
	for i in range(40):
		await get_tree().physics_frame
	var gap_open: float = (player._tether_vel as Vector3).length()
	var start_out := player.global_position.distance_to(storm.global_position)
	for i in range(240):
		player.has_move_target = true
		player.move_target = storm.global_position + Vector3(4000, 0, 0)
		await get_tree().physics_frame
	var gained := player.global_position.distance_to(storm.global_position) - start_out
	player.has_move_target = false
	player._apply_fit(kept)
	var latched := gap_open > 0.01
	print("[storm] THE WEAKEST LEGAL FIT ESCAPES FROM OUTSIDE THE EYE 1.6 u/s at the eyewall gained %.1fu against a live pull%s -> %s" % [
		gained, "" if latched else " (NO TETHER EVER LATCHED)",
		"PASS" if gained > 1.0 and latched else "FAIL"])

	# --- S3. the ceiling is the promise, and it is derived -------------------
	# Every number read from the live catalog. A Mk III drive turns this red and
	# makes somebody re-decide the boundary, instead of silently moving it.
	var best_t1 := 0.0
	var best_t2 := 0.0
	for mid_v in ModuleDB.MODULES:
		var m: Dictionary = ModuleDB.get_module(String(mid_v))
		if String(m.get("category", "")) != "drive":
			continue
		var total := float(ModuleDB.BASE["max_speed"]) + float((m["stats"] as Dictionary).get("max_speed", 0.0))
		if int(m.get("tier", 1)) == 1:
			best_t1 = maxf(best_t1, total)
		elif int(m.get("tier", 1)) == 2:
			best_t2 = maxf(best_t2, total)
	var ceiling_ok: bool = Storm.DRAG_MAX < PlayerShip.TETHER_DRAG_CEILING \
		and PlayerShip.TETHER_DRAG_CEILING < floor_speed \
		and Storm.CENTRE_THRESHOLD > best_t1 and Storm.CENTRE_THRESHOLD < best_t2
	print("[storm] THE CEILING IS THE PROMISE drag max %.2f < ceiling %.2f < max_speed floor %.2f; centre threshold %.2f sits between the best tier-1 drive %.2f and the best tier-2 %.2f -> %s" % [
		Storm.DRAG_MAX, PlayerShip.TETHER_DRAG_CEILING, floor_speed,
		Storm.CENTRE_THRESHOLD, best_t1, best_t2, "PASS" if ceiling_ok else "FAIL"])

	# --- S4. nothing in a storm out-hits the chart --------------------------
	# Four-sided and all derived. The chart's hardest gun is read from the
	# authored systems, never restated.
	var chart_alpha := 0.0
	for sid_v in SystemDB.ids():
		var sys: Dictionary = SystemDB.get_system(String(sid_v))
		chart_alpha = maxf(chart_alpha, Hostile.DAMAGE * float(sys.get("difficulty", 1.0)))
	var storm_tick := Storm.EYE_DPS_MAX * Storm.TICK
	var deep_emp := float(DeepSpace.TRAP_EMP[DeepSpace.TRAP_EMP.size() - 1])
	var guard_dps := Hostile.DAMAGE \
		* float(DeepSpace.GUARD_DIFFICULTY[DeepSpace.GUARD_DIFFICULTY.size() - 1]) \
		/ Hostile.FIRE_INTERVAL
	# FLOORED AS WELL AS CAPPED, and the floor is the half this shipped without.
	# All three terms were one-sided `<`, so ZEROING the constants made the clause
	# pass HARDER — a storm that does no damage and casts no EMP would have read
	# as "comfortably under the chart's hardest gun". A red-verify caught it
	# printing `per-tick 0.00, sustained 0.0/s -> PASS`.
	#
	# The rule was never "the storm hits softly"; it is "the storm hits, and
	# softer than the chart". A bound with only one side cannot tell those apart,
	# and this is the third clause this horizon to learn it.
	var outhit_ok: bool = storm_tick < chart_alpha and Storm.EYE_DPS_MAX < guard_dps \
		and Storm.EMP_LEN_MAX < deep_emp \
		and storm_tick > 0.0 and Storm.EYE_DPS_MAX > 0.0 and Storm.EMP_LEN_MAX > 0.0
	print("[storm] NOTHING IN A STORM OUT-HITS THE CHART (and it does hit) per-tick %.2f vs the chart's hardest shot %.1f; sustained %.1f/s vs an Unsounded post's %.1f/s; EMP %.1fs vs a rigged hulk's %.1fs -> %s" % [
		storm_tick, chart_alpha, Storm.EYE_DPS_MAX, guard_dps,
		Storm.EMP_LEN_MAX, deep_emp, "PASS" if outhit_ok else "FAIL"])

	# --- S6. it never closes the last 520u ----------------------------------
	# Two-sided, and the second half IS the non-vacuity: a one-sided version
	# passes perfectly on a storm that never moves at all.
	player.global_position = storm.global_position + Vector3(Storm.WARN_RADIUS - 20.0, 0, 0)
	player.velocity = Vector3.ZERO
	player.clear_tether()
	storm._heading = Vector2(1, 0)          # straight at the ship
	var near_before := storm.global_position.distance_to(player.global_position)
	for i in range(600):
		storm._heading = Vector2(1, 0)
		await get_tree().physics_frame
	var near_after := storm.global_position.distance_to(player.global_position)

	player.global_position = storm.global_position + Vector3(Storm.WARN_RADIUS + 200.0, 0, 0)
	storm._heading = Vector2(1, 0)
	var far_before := storm.global_position.distance_to(player.global_position)
	for i in range(600):
		storm._heading = Vector2(1, 0)
		await get_tree().physics_frame
	var far_after := storm.global_position.distance_to(player.global_position)
	print("[storm] IT NEVER CLOSES THE LAST %.0fu inside the ring it moved %+.1fu (must not close); outside it closed %+.1fu (must) -> %s" % [
		Storm.WARN_RADIUS, near_after - near_before, far_after - far_before,
		"PASS" if near_after - near_before >= -0.5 and far_after - far_before < -0.5 else "FAIL"])

	# --- S7. it holds station while it has you ------------------------------
	# Deliberately redundant with S6 — S6's clamp is at 520, but the escape
	# arithmetic rests on the centre being FIXED, which is this one. 41's
	# backstop idiom: the assertion that matters gets its own line.
	player.global_position = storm.global_position + Vector3(Storm.PULL_RADIUS * 0.5, 0, 0)
	var held_from := storm.global_position
	for i in range(300):
		await get_tree().physics_frame
	var held_move := held_from.distance_to(storm.global_position)
	player.global_position = storm.global_position + Vector3(Storm.WARN_RADIUS * 3.0, 0, 0)
	var free_from := storm.global_position
	for i in range(300):
		await get_tree().physics_frame
	var free_move := free_from.distance_to(storm.global_position)
	print("[storm] IT HOLDS STATION WHILE IT HAS YOU latched it moved %.2fu in 5s, released it moved %.2fu -> %s" % [
		held_move, free_move, "PASS" if held_move < 0.05 and free_move > 1.0 else "FAIL"])

	# --- S12. a docked ship is safe -----------------------------------------
	# 14 makes docking the one safe state, and it must not rest on an early
	# return in another file.
	player.global_position = storm.global_position
	player.clear_tether()
	player.shield = player.shield_max
	player.docked = true
	for i in range(300):
		await get_tree().physics_frame
	var docked_safe: bool = is_equal_approx(player.shield, player.shield_max) \
		and not player.is_emp_stunned() and (player._tether_vel as Vector3).length() < 0.01
	player.docked = false
	print("[storm] A DOCKED SHIP IS SAFE 5s at the centre left shield %.0f/%.0f, stunned=%s, drag %.3f -> %s" % [
		player.shield, player.shield_max, str(player.is_emp_stunned()),
		(player._tether_vel as Vector3).length(), "PASS" if docked_safe else "FAIL"])

	# --- S10. the roll lands where the band is, and the refusals -------------
	var pl2: PlayerShip = get_tree().get_first_node_in_group("player")
	pl2.global_position = Vector3(SystemDB.bounds_of(system_id) + Storm.band_floor() + 100.0, 0, 0)
	pl2.invulnerable = true
	await get_tree().process_frame
	var placed_ok := true
	var too_near := 0
	var made := 0
	for i in range(60):
		live_storms.clear()
		# NOT the probe storm the rest of this suite is standing next to. A blanket
		# free over the group took it out from under S5, S9 and S13, which then
		# dereferenced a freed node — logged as "Invalid access to property on a
		# base object of type 'previously freed'" and failing nothing, because a
		# freed-node read is an error rather than a FAIL.
		for n in get_tree().get_nodes_in_group("storm"):
			if n == storm:
				continue
			(n as Node3D).queue_free()
		var st := spawn_storm()
		if st == null:
			placed_ok = false
			continue
		made += 1
		var d := deep_space.depth_at(st.global_position)
		if d < Storm.band_floor() + Storm.PULL_RADIUS or d > Storm.band_floor() + Storm.DRIFT_DEPTH_SPAN:
			placed_ok = false
		if st.global_position.distance_to(pl2.global_position) < Storm.WARN_RADIUS * 1.5:
			too_near += 1
		st.queue_free()
	live_storms.clear()
	# The identity, not the number: a seventh band moves the weather with it.
	var band_ok: bool = Storm.band_floor() == float(DeepSpace.BAND_EDGES[DeepSpace.BAND_EDGES.size() - 1]) \
		and Storm.band_index() == DeepSpace.BAND_NAMES.size() - 1
	print("[storm] THE ROLL LANDS WHERE THE BAND IS %d/60 placed, all inside [%.0f, %.0f] depth=%s, none within %.0fu of the ship (%d), band floor derived=%s -> %s" % [
		made, Storm.band_floor() + Storm.PULL_RADIUS, Storm.band_floor() + Storm.DRIFT_DEPTH_SPAN,
		str(placed_ok), Storm.WARN_RADIUS * 1.5, too_near, str(band_ok),
		"PASS" if placed_ok and made == 60 and too_near == 0 and band_ok else "FAIL"])

	# And the refusals, each named — including one ALLOWED case, so the gate is
	# proven to be a gate rather than a wall.
	var refusals := {}
	pl2.global_position = Vector3(SystemDB.bounds_of(system_id) + Storm.band_floor() - STORM_LEAD - 10.0, 0, 0)
	await get_tree().process_frame
	refusals["too shallow"] = spawn_storm() == null
	pl2.global_position = Vector3(SystemDB.bounds_of(system_id) + Storm.band_floor() - STORM_LEAD + 10.0, 0, 0)
	await get_tree().process_frame
	var allowed := spawn_storm()
	refusals["allowed just inside the lead"] = allowed != null
	if allowed:
		allowed.queue_free()
	live_storms.clear()
	warping = true
	refusals["warping"] = spawn_storm() == null
	warping = false
	var bad := ""
	for k in refusals:
		if not bool(refusals[k]):
			bad += "%s " % String(k)
	print("[storm] THE GATE IS A GATE %d conditions checked (%s) -> %s %s" % [
		refusals.size(), str(refusals.keys()),
		"PASS" if bad == "" else "FAIL", bad])

		# --- S5. the telegraph reads from further out than the point of no return
	# 21's rule made arithmetic. NOT a comparison of two constants: walk inward
	# from the pull radius evaluating the storm's OWN accessors until the weakest
	# legal fit stops making headway, and use that. A constant comparison would
	# still pass if the curve underneath it changed shape.
	# WALK INWARD AND STOP AT THE FIRST ONE. The first draft assigned on every
	# match and let the loop keep going, so `pin` ended up holding the SMALLEST
	# radius where the floor fit is beaten rather than the largest — it printed
	# 0.5u for a true answer of 33.2u. The clause still passed, which is the
	# point worth recording: a number nobody checks is a number that can be
	# wrong while the verdict beside it is right.
	var pin := 0.0
	var d := Storm.PULL_RADIUS
	while d > 0.0:
		if Storm.threshold_at(d) > floor_speed:
			pin = d
			break
		d -= 0.5
	var warn_secs := (Storm.WARN_RADIUS - Storm.PULL_RADIUS) / floor_speed
	print("[storm] THE TELEGRAPH READS FROM FURTHER OUT THAN THE POINT OF NO RETURN announces at %.0fu, pulls at %.0fu, the weakest legal fit stops making headway at %.1fu — %.0fs of warning at the %.1f floor -> %s" % [
		Storm.WARN_RADIUS, Storm.PULL_RADIUS, pin, warn_secs, floor_speed,
		"PASS" if Storm.WARN_RADIUS > Storm.PULL_RADIUS and Storm.PULL_RADIUS > pin
			and pin > 0.0 else "FAIL"])

	# --- S9. it pays nothing ------------------------------------------------
	# COLONYTEST's NOTHING POINTS AT THEM shape, plus the non-vacuity clause that
	# battery learned the hard way: the whole check passes on a storm that was
	# never entered, so the shield MUST have actually fallen.
	var loot_before := _count_loot_cubes()
	var salv_before := GameState.salvage
	var cargo_before := GameState.cargo_used()
	player.invulnerable = false
	player.shield = player.shield_max
	player.global_position = storm.global_position
	for i in range(420):
		await get_tree().physics_frame
	var hurt := player.shield < player.shield_max
	player.invulnerable = true
	player.shield = player.shield_max
	var leaked := ""
	for g in ["apex", "dockable", "crackable", "hostiles", "mineable", "beacon", "hyper", "signature"]:
		if storm.is_in_group(g):
			leaked += "%s " % g
	var pays_ok: bool = _count_loot_cubes() == loot_before \
		and GameState.salvage == salv_before and GameState.cargo_used() == cargo_before \
		and leaked == "" and storm.is_in_group("storm") \
		and not PACING_LOOP.has("storm") and not PACING_PROSPECT.has("storm")
	print("[storm] IT PAYS NOTHING crates %d->%d, salvage unchanged=%s, hold unchanged=%s, groups leaked: %s; and the eye actually bit (shield fell=%s) -> %s" % [
		loot_before, _count_loot_cubes(), str(GameState.salvage == salv_before),
		str(GameState.cargo_used() == cargo_before), leaked if leaked != "" else "none",
		str(hurt), "PASS" if pays_ok and hurt else "FAIL"])

	# --- S11. the copy says what to do --------------------------------------
	# 58, and 63's warning that a contains-check happily accepts a noun. Read off
	# the SHIPPED strings via Storm.COPY rather than a re-typed copy, asserted
	# over the set with the count, so a sixth line cannot arrive unchecked.
	var copy_bad := ""
	for key in ["pull", "eye", "tag"]:
		if not String(Storm.COPY[key]).contains("BURN OUTWARD"):
			copy_bad += "%s has no verb " % key
	var sink_name := String(CommodityDB.get_good("sink_thermal")["name"]).to_upper()
	var body := String(Storm.COPY["body"])
	if not body.contains("GO AROUND") or not body.contains(sink_name):
		copy_bad += "the broadcast names no answer "
	print("[storm] THE COPY SAYS WHAT TO DO %d authored lines, every prompt names the verb and the broadcast names '%s' -> %s %s" % [
		Storm.COPY.size(), sink_name,
		"PASS" if copy_bad == "" and Storm.COPY.size() == 6 else "FAIL", copy_bad])

	# --- S13. reduced motion shows the end state ----------------------------
	# ACCESSTEST's shape, two-sided. 30: the accommodation is the END STATE
	# immediately, never a slower animation — so with it on there is no particle
	# node at all and nothing turns, and with it off both are true.
	var motion_before: bool = bool(GameState.setting("reduce_motion"))
	GameState.set_setting("reduce_motion", true)
	var calm := Storm.new()
	system_root.add_child(calm)
	calm.global_position = storm.global_position + Vector3(0, 0, 900)
	await get_tree().process_frame
	var calm_parts := 0
	for c in calm.get_children():
		if c is CPUParticles3D:
			calm_parts += 1
	var calm_rot := calm.rotation.y
	for i in range(30):
		await get_tree().process_frame
	var calm_still: bool = is_equal_approx(calm.rotation.y, calm_rot) and calm.visible
	calm.queue_free()

	GameState.set_setting("reduce_motion", false)
	var lively := Storm.new()
	system_root.add_child(lively)
	lively.global_position = storm.global_position + Vector3(0, 0, 1200)
	await get_tree().process_frame
	var lively_parts := 0
	for c in lively.get_children():
		if c is CPUParticles3D:
			lively_parts += 1
	lively.queue_free()
	GameState.set_setting("reduce_motion", motion_before)
	print("[storm] REDUCED MOTION SHOWS THE END STATE on: %d particle nodes, visible and still=%s; off: %d -> %s" % [
		calm_parts, str(calm_still), lively_parts,
		"PASS" if calm_parts == 0 and calm_still and lively_parts > 0 else "FAIL"])

	# --- S8 RUNS LAST, and the ordering is load-bearing. It calls _load_system,
	# which frees system_root and every storm hanging off it — so any assertion
	# after it that still holds a Storm reference is reading a freed node. That
	# is exactly what happened on the first run: S9 and S13 both dereferenced the
	# storm S8 had just destroyed, and the harness logged "Invalid access to
	# property on a base object of type 'previously freed'" without failing a
	# single clause. A test that tears down the world belongs at the end of the
	# test that needs one.
	# --- S8. a storm is session weather -------------------------------------
	# THE BACK DOOR, CHECKED IN THE SOURCE. 53's rule is that anything ambient
	# which LOGS, saves — note_log queues a write, and that is how a convoy's
	# arrival once overwrote a SAVETEST fixture. A storm is ambient and
	# long-lived, so the temptation is real and the check has to be too. Read
	# out of the file the way THE PINNING LIST IS COMPLETE reads main.gd, because
	# there is no runtime signal for "this never happens".
	var storm_src := FileAccess.get_file_as_string("res://scripts/storm.gd")
	# THE CALL FORM, NOT THE WORD. The first draft searched for "note_log" and
	# went red on storm.gd's own header comment promising it never calls it —
	# an assertion defeated by the sentence written to explain it. Matching
	# "GameState.note_log(" cannot be satisfied by prose.
	var logs := storm_src.contains("GameState.note_log(") \
		or storm_src.contains("GameState.note_ledger(")
	var save_leak := storm_src.contains("_queue_save(") or storm_src.contains("save_game(")
	# >= 20, NOT == 20. The clause means "the storm cost no save format change",
	# and it was written the day v20 was current, which quietly made it "no
	# feature may ever bump the save again" -- the next legitimate bump would
	# have turned this red and named the storm, which had nothing to do with it.
	# save_leak above is what actually proves storm.gd writes nothing; the
	# version only has to show it never went BACKWARDS from where storms shipped.
	spawn_storm()
	var before_load := live_storms.size()
	_load_system(system_id)
	await get_tree().process_frame
	var after_load := get_tree().get_nodes_in_group("storm").size()
	print("[storm] A STORM IS SESSION WEATHER %d live before a rebuild, %d nodes after, live list %d; storm.gd logs=%s saves=%s, format still v%d -> %s" % [
		before_load, after_load, live_storms.size(), str(logs), str(save_leak),
		GameState.SAVE_VERSION,
		"PASS" if after_load == 0 and live_storms.is_empty() and not logs and not save_leak
			and GameState.SAVE_VERSION >= 20 and storm_src.length() > 0 else "FAIL"])

	get_tree().quit()
