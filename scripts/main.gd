# --- docking harness --------------------------------------------------------

func _run_dock_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(0.5).timeout

	var port := find_port()
	print("[dock] port found=", port != null, " id=", port.port_id if port else "-")

	# Clear the standing garrison. This harness is about the docking contract,
	# and PYX-03 now fields seven sentries along the approach: they shot the ship
	# down mid-approach, the emergency warp cancelled the move order, and every
	# later assertion then failed for a reason that had nothing to do with
	# docking. The safety and boss-lock steps below spawn their own threats.
	for n in get_tree().get_nodes_in_group("hostiles"):
		(n as Node3D).queue_free()
	await get_tree().process_frame

	# 1. Dock from range: request, let the autopilot close, confirm clamp.
	request_dock(port)
	var waited := 0.0
	while docked_port == null and waited < 20.0:
		await get_tree().create_timer(0.2).timeout
		waited += 0.2
	print("[dock] DOCKED after %.1fs: docked=%s player.docked=%s saved=%s" % [
		waited, str(docked_port != null), str(player.docked), GameState.docked_at])

	# 2. Safety: a pack spawned on top of the port must not scratch the paint.
	player.shield = player.shield_max
	var before := player.shield
	for i in range(6):
		var s := SwarmHostile.new()
		s.difficulty = 1.0
		system_root.add_child(s)
		s.global_position = player.global_position + Vector3(randf_range(-2, 2), 0, randf_range(-2, 2))
	await get_tree().create_timer(9.0).timeout
	print("[dock] SAFETY after 9s with 6 swarm on top: shield %.0f -> %.0f (must be equal)" % [
		before, player.shield])

	# Clear the test pack: left alive they keep shooting after undock, down the
	# player, and a downed player disengages the boss — which would make the
	# lock assertion below fail for the wrong reason.
	for s in get_tree().get_nodes_in_group("swarm"):
		(s as Node3D).queue_free()
	player.shield = player.shield_max
	await get_tree().process_frame

	# 3. Undock returns control and grants the usual grace.
	undock()
	await get_tree().create_timer(0.4).timeout
	print("[dock] UNDOCKED: player.docked=%s protected=%s saved='%s'" % [
		str(player.docked), str(player.is_protected()), GameState.docked_at])

	# 4. Docking is refused while an apex engine is live.
	#
	# v15. STAGED AT THE LAIR, and the rule reads differently from out here. The
	# engine used to sit inside the charted volume a short flight from this port,
	# so "docking is refused mid-fight" was a rule about two things that were
	# genuinely near each other. Now the lair keep-out guarantees no berth exists
	# within the leash, so the only way to be in a fight and ask to dock is to ask
	# about a station 300u away — which is exactly what this does. request_dock
	# checks boss_active BEFORE it checks range, so the refusal is the lock and
	# not the distance.
	GameState.mark_breached("pyx01")
	var engine := _find_apex()
	player.global_position = engine.global_position + Vector3(0, 0, 8.0)
	await get_tree().physics_frame
	_apex_wake_timer = 0.2
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.0).timeout
	request_dock(port)
	await get_tree().create_timer(0.6).timeout
	print("[dock] BOSS LOCK: boss_active=%s docked=%s (must be true / false)" % [
		str(boss_active), str(docked_port != null)])

	# A REBUILD WHILE DOCKED MUST NOT WELD THE SHIP TO THE BERTH.
	#
	# The Port is a SystemRoot child, so _load_system frees it -- and undock()
	# opens with `if docked_port == null: return`, which a FREED reference
	# satisfies. DEPART became a silent no-op and `player.docked` never cleared,
	# which gates all movement: a ship clamped to a berth that no longer exists,
	# with no button in the game that could release it.
	#
	# Two taps from real play: dock, open the pause menu (docking does not lock
	# it), cycle COLOUR VISION. Driven through rebuild_visuals for that reason,
	# rather than by calling _load_system directly -- the door is what makes this
	# reachable, and a test that skipped it would be testing a corridor nobody
	# can walk down.
	disengage_apex(false)
	await get_tree().process_frame
	var lock_player: PlayerShip = get_tree().get_first_node_in_group("player")
	var lock_port := find_port()
	# PUT THE SHIP AT THE BERTH FIRST. The boss step above leaves it ~300u out at
	# the lair, and request_dock only sets a move order -- flown, that is minutes.
	lock_player.teleport_to(lock_port.dock_point + Vector3(0, 0, 2.0))
	await get_tree().physics_frame
	request_dock(lock_port)
	var lock_waited := 0.0
	while docked_port == null and lock_waited < 12.0:
		await get_tree().create_timer(0.2).timeout
		lock_waited += 0.2
	var lock_docked_before: bool = docked_port != null and lock_player.docked
	rebuild_visuals()
	await get_tree().create_timer(0.4).timeout
	var lock_released: bool = docked_port == null and not lock_player.docked
	# And DEPART still works afterwards, which is the thing the player reaches
	# for. Re-dock against the REBUILT port and undock through the real path.
	var lock_port2 := find_port()
	lock_player.teleport_to(lock_port2.dock_point + Vector3(0, 0, 2.0))
	await get_tree().physics_frame
	request_dock(lock_port2)
	lock_waited = 0.0
	while docked_port == null and lock_waited < 12.0:
		await get_tree().create_timer(0.2).timeout
		lock_waited += 0.2
	var lock_redocked: bool = docked_port != null
	undock()
	await get_tree().process_frame
	var lock_departed: bool = docked_port == null and not lock_player.docked
	print("[dock] A REBUILD DOES NOT WELD THE SHIP TO THE BERTH docked before=%s, released by the rebuild=%s, re-docked after=%s, DEPART still works=%s -> %s" % [
		str(lock_docked_before), str(lock_released), str(lock_redocked),
		str(lock_departed),
		"PASS" if lock_docked_before and lock_released and lock_redocked
			and lock_departed else "FAIL"])

	get_tree().quit()


