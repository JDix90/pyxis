		var mine27 := DeepSpace.cell_key(sys27, 3, 0)
		var theirs27 := DeepSpace.cell_key(sys27, 4, 0)
		var counter27 := DeepSpace.cell_key(sys27, 5, 0)
		var junk27 := DeepSpace.cell_key(sys27, 6, 0)
		var uncovered27 := DeepSpace.cell_key(sys27, 7, 0)
		var v27 := {
			"version": 27,
			"salvage": 4000,
			"survey_coverage": {mine27: true, theirs27: true, counter27: true,
				junk27: true},
			# THE RUBBISH PASS. A hand-edited file is input, not truth: a word
			# nobody declared, and a key naming a cell this pilot never worked.
			# The second is the subset invariant, which is the one _load_survey
			# _filed enforces rather than a shape.
			"survey_filed": {mine27: "held", theirs27: "held_other",
				counter27: true, junk27: "nonsense", uncovered27: "held"},
		}
		var f27 := FileAccess.open(GameState.save_path, FileAccess.WRITE)
		f27.store_string(JSON.stringify(v27))
		f27.close()
		var ok27 := GameState.load_game()
		var mine_ok: bool = GameState.is_survey_held(mine27) \
			and not GameState.is_survey_held_by_another(mine27)
		# A v27 FILE CANNOT CARRY THE THIRD WORD -- but a hand-edited one can,
		# and if it does it is legal, because the word is legal. What is being
		# checked here is that the loader reads the VALUE rather than flattening
		# it, which is the defect §96 records this exact function carrying for
		# two versions.
		var theirs_ok: bool = GameState.is_survey_held(theirs27) \
			and GameState.is_survey_held_by_another(theirs27)
		var counter_ok: bool = GameState.is_survey_filed(counter27) \
			and not GameState.is_survey_held(counter27)
		var junk_ok: bool = not GameState.is_survey_filed(junk27)
		var uncovered_ok: bool = not GameState.is_survey_filed(uncovered27)
		print("[savetest] v27->v28 THE THIRD WORD SURVIVES A RELOAD loaded=%s; your own held cell reads held and not another's=%s, a colleague's reads both=%s, a counter filing is still not held=%s; rubbish dropped (unknown word=%s, uncovered cell=%s) -> %s" % [
			str(ok27), str(mine_ok), str(theirs_ok), str(counter_ok),
			str(junk_ok), str(uncovered_ok),
			"PASS" if ok27 and mine_ok and theirs_ok and counter_ok and junk_ok
				and uncovered_ok else "FAIL"])
	elif mode == "future":
		# A SAVE FROM A NEWER BUILD. Refusing to load it was never the hard
		# part — that clause has always been there. What it did NOT do was stop
		# the write: _ready calls reset_to_starter() when load_game returns
		# false, and the debounced save a second later put a starter run on top
		# of a file this build merely could not read. A rollback, a second
		# machine or a beta lane cost the player the pilot, and the only notice
		# was a push_warning, which on a phone is no notice at all.
		#
		# BOTH HALVES ARE ASSERTED, because refusing to load while still being
		# able to write is the bug wearing the fix's clothes — and the file
		# check is done on the BYTES, since a save that reloads to the same
		# values would satisfy anything softer.
		var future_save := {
			"version": GameState.SAVE_VERSION + 1,
			"salvage": 123456,
			"ship_name": "FROM THE FUTURE",
			"run_seed": 202108,
			"tutorial_step": -1,
		}
		var raw_before := JSON.stringify(future_save, "\t")
		var ff := FileAccess.open(GameState.save_path, FileAccess.WRITE)
		ff.store_string(raw_before)
		ff.close()

		GameState.save_enabled = true
		var loaded_future := GameState.load_game()
		var flagged: bool = GameState.newer_save_refused
		var locked: bool = GameState.saving_locked()

		# Exactly what boot does next, and exactly what used to destroy the file.
		GameState.reset_to_starter()
		GameState.add_salvage(50)
		GameState.save_game()
		var raw_after := FileAccess.get_file_as_string(GameState.save_path)
		var intact: bool = raw_after == raw_before

		print("[savetest] v%d A NEWER SAVE IS REFUSED, NOT REWRITTEN loaded=%s (expect false), flagged=%s, saving locked=%s, bytes %d -> %d intact=%s -> %s" % [
			GameState.SAVE_VERSION + 1, str(loaded_future), str(flagged),
			str(locked), raw_before.length(), raw_after.length(), str(intact),
			"PASS" if not loaded_future and flagged and locked and intact
				else "FAIL"])
	elif mode == "partial6":
		# A v6 save written before a later setting existed must still get that
		# setting's default rather than a missing key — the reason load merges
		# key-by-key instead of taking the saved dictionary wholesale.
		var p6 := {
			"version": 6,
			"salvage": 500,
			"owned": ["pulse_1", "drive_cruise", "core_overcharge"],
			"fit": {"0": "pulse_1", "1": "pulse_1", "2": "drive_cruise", "3": "", "4": "core_overcharge"},
			"reactor_tier": 0,
			"settings": {"music_vol": 0.1},      # deliberately missing the rest
			"livery": {"hull": 2},               # deliberately missing accent
		}
		var fp := FileAccess.open(GameState.save_path, FileAccess.WRITE)
		fp.store_string(JSON.stringify(p6))
		fp.close()
		var okp := GameState.load_game()
		var kept := is_equal_approx(float(GameState.setting("music_vol")), 0.1)
		var filled := GameState.settings.has("sfx_vol") and GameState.settings.has("shake") \
			and GameState.settings.has("ui_scale") and GameState.livery.has("accent")
		print("[savetest] partial v6 loaded=", okp, " settings=", GameState.settings,
			" livery=", GameState.livery)
		print("[savetest] partial v6 KEPT music_vol=", kept, " FILLED missing keys=", filled,
			" -> ", "PASS" if kept and filled else "FAIL")
	else:
		var ok := GameState.load_game()
		print("[savetest] loaded=", ok, " salvage=", GameState.salvage,
			" weaponA=", GameState.fit[ModuleDB.Slot.WEAPON_A],
			" system=", GameState.current_system,
			" breached=", GameState.breached,
			" barks=", GameState.barks_seen.size(),
			" cargo=", GameState.cargo,
			" docked='", GameState.docked_at, "'",
			" clock=", GameState.played_seconds,
			" pressures=", GameState.market_pressure.size(),
			" events=", GameState.market_events.size())
		var round_trip := is_equal_approx(float(GameState.setting("music_vol")), 0.35) \
			and not bool(GameState.setting("shake")) \
			and is_equal_approx(float(GameState.setting("ui_scale")), 1.25) \
			and GameState.livery_index("hull") == 3 and GameState.livery_index("accent") == 5
		print("[savetest] v6 ROUND TRIP settings=", GameState.settings,
			" livery=", GameState.livery, " -> ", "PASS" if round_trip else "FAIL")

		# v9 bonded stores. Both key shapes must survive — a chart port id and a
		# deep CELL — and the deep one is validated by RE-DERIVING it from the
		# generator, which is only possible because the expanse is a pure
		# function (17). A key naming a cell with no bay is discarded, so an
		# edited or stale save self-corrects rather than carrying a phantom store.
		var chart_ok := GameState.warehouse_count("anchor", "servo_prewar") == 3 \
			and GameState.warehouse_count("anchor", "lattice_data") == 2
		var deep_key := _first_bay_cell()
		var deep_ok := GameState.warehouse_count(deep_key, "salvage_quiet") == 4
		var bogus_dropped := not GameState.warehouse.has("pyx01:99:99")
		var want_ledger := {"deepest_depth": 611, "distance_flown": 4207,
			"hulks_cracked": 13, "posts_cleared": 5, "chart_data_sold": 82,
			"tolls_paid": 2}
		var led_ok := true
		for k in want_ledger:
			if int(GameState.ledger.get(k, -1)) != int(want_ledger[k]):
				led_ok = false
		var name_ok := GameState.ship_name == "ASTROLABE-SEVEN-OF-THE-L" \
			and GameState.ship_name.length() == GameState.SHIP_NAME_MAX
		print("[savetest] v11 SMUGGLING tier %d xp %d, craftable owned=%s -> %s" % [
			GameState.smuggling, GameState.smuggling_xp,
			str(GameState.owns("mod_survey_array")),
			"PASS" if GameState.smuggling == 2 and GameState.smuggling_xp == 57
				and GameState.owns("mod_survey_array") else "FAIL"])
		# v19. The fourth ladder, asserted on BOTH numbers and against the third's
		# — a load that wrote smuggling's pair into persuasion's fields would
		# satisfy "persuasion is non-zero" perfectly.
		print("[savetest] v19 PERSUASION tier %d xp %d (want 1 / 3, and not smuggling's 2 / 57) -> %s" % [
			GameState.persuasion, GameState.persuasion_xp,
			"PASS" if GameState.persuasion == 1 and GameState.persuasion_xp == 3
				else "FAIL"])
		# v20. Beacons: every coordinate, both systems, and the DERIVED stock —
		# which is the line that catches a loader quietly duplicating or
		# dropping an entry, whatever the entries themselves say.
		var b1: Array = GameState.beacons_in("pyx01")
		var b2: Array = GameState.beacons_in("pyx02")
		var beacons_ok: bool = b1.size() == 2 and b2.size() == 1 \
			and float((b1[0] as Dictionary)["x"]) == 111.0 \
			and float((b1[0] as Dictionary)["z"]) == 222.0 \
			and float((b1[1] as Dictionary)["x"]) == -333.0 \
			and float((b2[0] as Dictionary)["z"]) == -666.0 \
			and GameState.beacon_stock_left() == GameState.BEACON_STOCK - 3
		var c1: Array = GameState.colonies_in("pyx01")
		var c3: Array = GameState.colonies_in("pyx03")
		var colonies_ok: bool = c1.size() == 1 and c3.size() == 1 \
			and String((c1[0] as Dictionary)["key"]) == "pyx01:2" \
			and float((c1[0] as Dictionary)["x"]) == 1777.0 \
			and float((c3[0] as Dictionary)["z"]) == 3111.0 \
			and is_equal_approx(GameState.last_outbound_jump, 1234.5)
		print("[savetest] v20 COLONIES %d + %d founded round-tripped with key, position and the SHARED jump stamp=%s (stamp %.1f) -> %s" % [
			c1.size(), c3.size(), str(colonies_ok), GameState.last_outbound_jump,
			"PASS" if colonies_ok else "FAIL"])
		print("[savetest] v20 BEACONS %d + %d entries round-tripped with every coordinate=%s, derived stock %d (want %d) -> %s" % [
			b1.size(), b2.size(), str(beacons_ok), GameState.beacon_stock_left(),
			GameState.BEACON_STOCK - 3, "PASS" if beacons_ok else "FAIL"])
		# v21: the three coverage sentinels, and a fourth key that must NOT be
		# there — without the negative, a loader that marked everything surveyed
		# would round-trip these three perfectly.
		var cov_ok: bool = GameState.is_survey_worked("pyx01:7:-3") \
			and GameState.is_survey_worked("pyx01:12:5") \
			and GameState.is_survey_worked("pyx02:-4:19") \
			and not GameState.is_survey_worked("pyx02:7:-3") \
			and GameState.survey_coverage.size() == 3
		print("[savetest] v21 COVERAGE 3 cells in 2 systems round-tripped=%s, absent key still absent=%s -> %s" % [
			str(GameState.survey_coverage.size() == 3),
			str(not GameState.is_survey_worked("pyx02:7:-3")),
			"PASS" if cov_ok else "FAIL"])
		# v22: exactly ONE of the three is filed, which is the state that
		# distinguishes a working filed store from one that lost or invented
		# entries -- all-filed and none-filed both round-trip a broken loader.
		var filed_ok: bool = GameState.is_survey_filed("pyx01:12:5") \
			and not GameState.is_survey_filed("pyx01:7:-3") \
			and not GameState.is_survey_filed("pyx02:-4:19") \
			and GameState.unfiled_cells().size() == 2 \
			and GameState.is_structure_seen(GameState.colony_key("pyx01", 0))
		print("[savetest] v22 FILED AND SIGHTED 1 of 3 cells filed=%s, %d unfiled, 1 structure sighted=%s -> %s" % [
			str(GameState.is_survey_filed("pyx01:12:5")),
			GameState.unfiled_cells().size(),
			str(GameState.is_structure_seen(GameState.colony_key("pyx01", 0))),
			"PASS" if filed_ok else "FAIL"])
		# v23: two records at DIFFERENT stages, plus a record never read. The
		# negative is what catches a loader that invents entries, and the two
		# distinct stages catch one that clamps or crosses key with value.
		var logs_ok: bool = GameState.deep_log_stage("pyx01:meridian") == 2 \
			and GameState.deep_log_stage("pyx02:glass") == 1 \
			and GameState.deep_log_stage("pyx03:return") == 0 \
			and GameState.deep_logs.size() == 2
		print("[savetest] v23 DEEP LOGS meridian at %d, glass at %d, unread record at %d, %d entries -> %s" % [
			GameState.deep_log_stage("pyx01:meridian"),
			GameState.deep_log_stage("pyx02:glass"),
			GameState.deep_log_stage("pyx03:return"), GameState.deep_logs.size(),
			"PASS" if logs_ok else "FAIL"])
		print("[savetest] v10 LOGBOOK ledger %s, name '%s' (%d chars, cap %d) -> %s" % [
			str(GameState.ledger), GameState.ship_name, GameState.ship_name.length(),
			GameState.SHIP_NAME_MAX, "PASS" if led_ok and name_ok else "FAIL"])

		# v18 faction matrix, through the real file layer. Two distinct pairs
		# with two distinct values, and the SIZE checked too: a load that
		# invented a third pair, or dropped one, would otherwise pass on the two
		# it happened to keep.
		var fac_player := int(GameState.faction_deltas.get(
			FactionDB.pair_key(FactionDB.SURVEYOR, "grin"), 0))
		var fac_third := int(GameState.faction_deltas.get(
			FactionDB.pair_key("gsa", "bastion"), 0))
		var fac_ok: bool = fac_player == 4 and fac_third == -3 \
			and GameState.faction_deltas.size() == 2
		print("[savetest] v18 FACTION MATRIX %s (surveyor|grin=%d, gsa|bastion=%d) -> %s" % [
			str(GameState.faction_deltas), fac_player, fac_third,
			"PASS" if fac_ok else "FAIL"])

		# v12 captain's log. Compared element by element, never by size: the write
		# leg put LOG_MAX + 2 in, so the surviving ten must be the LAST ten, in
		# order. A size check passes just as happily on a reversed array or on a
		# load that kept the oldest — which is a one-token mistake producing a
		# perfectly plausible-looking log.
		var want_log: Array = []
		for i in range(2, GameState.LOG_MAX + 2):
			want_log.append("LOGBOOK ENTRY %02d" % i)
		var got_log := GameState.log_lines()
		var log_ok := got_log.size() == want_log.size()
		for i in range(want_log.size()):
			if i >= got_log.size() or String(got_log[i]) != String(want_log[i]):
				log_ok = false
		print("[savetest] v12 CAPTAIN'S LOG %d of %d written survive, oldest evicted, order held: %s -> %s" % [
			got_log.size(), GameState.LOG_MAX + 2, str(got_log),
			"PASS" if log_ok else "FAIL"])

		# The logbook is RUN state and the name is not. A new survey starts a new
		# logbook; what you called the ship survives it, like the paint.
		var kept_name := GameState.ship_name
		GameState.reset_to_starter()
		var zeroed := 0
		for k in GameState.DEFAULT_LEDGER:
			if int(GameState.ledger.get(k, -1)) == 0:
				zeroed += 1
		print("[savetest] v10 LEDGER RESET %d of %d counters zeroed, name kept=%s, log cleared=%s -> %s" % [
			zeroed, GameState.DEFAULT_LEDGER.size(),
			str(GameState.ship_name == kept_name),
			str(GameState.log_lines().is_empty()),
			"PASS" if zeroed == GameState.DEFAULT_LEDGER.size()
				and GameState.ship_name == kept_name
				and GameState.log_lines().is_empty() else "FAIL"])

		print("[savetest] v9 BONDED STORES chart=%s deep=%s, bogus cell dropped=%s, keys=%s -> %s" % [
			str(chart_ok), str(deep_ok), str(bogus_dropped),
			str(GameState.warehouse.keys()),
			"PASS" if chart_ok and deep_ok and bogus_dropped else "FAIL"])
	get_tree().quit()


# --- feel and audio correctness ---------------------------------------------

func _run_feel_test() -> void:
	# Guards the frame-rate independence work and the four audio defects fixed
	# alongside it. Everything here is about behaviour that is invisible at 60Hz
	# on a desktop and wrong everywhere else, which is exactly the category that
	# needs a harness rather than an eye.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	var rig: CameraRig = get_tree().get_first_node_in_group("camera_rig")
	await get_tree().create_timer(0.3).timeout

	# --- 1. the smoothing itself ---------------------------------------------
	# The whole point: subdividing a timestep must not change where you land.
	# The old lerp(a, b, k*delta) form fails this by ~8% per step at these rates,
	# which is why the camera felt different on a 120Hz phone.
	var one_step := Smoothing.toward(0.0, 1.0, 9.0, 1.0 / 60.0)
	var two_half := Smoothing.toward(Smoothing.toward(0.0, 1.0, 9.0, 1.0 / 120.0), 1.0, 9.0, 1.0 / 120.0)
	var invariant: float = absf(one_step - two_half)
	print("[feel] STEP INVARIANCE 1x1/60=%.9f vs 2x1/120=%.9f delta=%.9f -> %s" % [
		one_step, two_half, invariant, "PASS" if invariant < 1.0e-6 else "FAIL"])

	# Four subdivisions, to prove it is the exponential and not a coincidence at
	# two. Also covers the vector overload, which shares the factor() call.
	var quarter := Vector3.ZERO
	for i in range(4):
		quarter = Smoothing.toward_vec3(quarter, Vector3(10, 0, 0), 9.0, 1.0 / 240.0)
	var whole := Smoothing.toward_vec3(Vector3.ZERO, Vector3(10, 0, 0), 9.0, 1.0 / 60.0)
	var vec_gap: float = quarter.distance_to(whole)
	print("[feel] VEC3 INVARIANCE 4x1/240 vs 1x1/60 gap=%.9f -> %s" % [
		vec_gap, "PASS" if vec_gap < 1.0e-5 else "FAIL"])

	# A frame long enough to make the old `rate * delta` exceed 1.0 -- the case
	# that used to overshoot and oscillate instead of settling.
	var stalled := Smoothing.toward(0.0, 1.0, 9.0, 2.0)
	var old_form: float = lerpf(0.0, 1.0, 9.0 * 2.0)
	print("[feel] NO OVERSHOOT 2s frame: exp=%.4f (in 0..1) vs old lerp=%.1f -> %s" % [
		stalled, old_form, "PASS" if stalled >= 0.0 and stalled <= 1.0 and old_form > 1.0 else "FAIL"])

	# --- 2. the shake setting covers everything that moves the camera --------
	GameState.set_setting("shake", false)
	rig.shake(0.5)
	rig.punch_zoom(4.0)
	var shake_off: bool = rig.shake_amp() <= 0.0001 and rig.zoom_punch() <= 0.0001
	GameState.set_setting("shake", true)
	rig.shake(0.5)
	rig.punch_zoom(4.0)
	var shake_on: bool = rig.shake_amp() > 0.0 and rig.zoom_punch() > 0.0
	print("[feel] MOTION GATE off:shake+punch silent=%s  on:both fire=%s -> %s" % [
		str(shake_off), str(shake_on), "PASS" if shake_off and shake_on else "FAIL"])

	# --- 3. loop lengths, in frames rather than in bytes ----------------------
	# `data.size() / 2` assumed uncompressed 16-bit frames; the importer writes
	# QOA. Asserting the two disagree is what keeps this honest: if the import
	# mode ever changes back, this line goes red and says so.
	var amb := load("res://audio/ambient.wav") as AudioStreamWAV
	var real_frames := Sfx.frame_count(amb)
	var byte_guess: int = amb.data.size() / 2
	print("[feel] COMPRESSED STREAM frames=%d vs data.size()/2=%d -> %s" % [
		real_frames, byte_guess, "PASS" if real_frames != byte_guess else "FAIL"])

	# Read off the LOOP PLAYER's stream, not out of `_streams`. This used to ask
	# the shared one-shot cache what its loop_end was, which worked only because
	# loop_start was corrupting that cache -- the assertion was reading the bug
	# rather than the feature, and would have gone red on the fix. What it is
	# actually for is the QOA frame-count arithmetic above, and that lives on
	# whichever stream the player is really given.
	Sfx.loop_start("ambient", -40.0)
	var amb_loop := Sfx._loops["ambient"].stream as AudioStreamWAV
	var amb_end: int = amb_loop.loop_end
	# The pristine cache is the other half of the same rule: a one-shot stream
	# must come out of a loop_start no more looping than it went in.
	var one_shot_intact: bool = (Sfx._streams["ambient"] as AudioStreamWAV).loop_mode \
		== AudioStreamWAV.LOOP_DISABLED
	print("[feel] LOOP END ambient loop_end=%d frames=%d, one-shot copy still unlooped=%s -> %s" % [
		amb_end, real_frames, str(one_shot_intact),
		"PASS" if amb_end == real_frames and one_shot_intact else "FAIL"])
	Sfx.loop_stop("ambient", 0.01)

	var calm := load("res://audio/music_calm.wav") as AudioStreamWAV
	var calm_ok: bool = calm.loop_end == Sfx.frame_count(calm) and calm.loop_mode == AudioStreamWAV.LOOP_FORWARD
	print("[feel] MUSIC LOOP calm loop_end=%d frames=%d mode=%d -> %s" % [
		calm.loop_end, Sfx.frame_count(calm), calm.loop_mode, "PASS" if calm_ok else "FAIL"])

	# --- 4. per-object loops obey the effects slider -------------------------
	# Both crack players used to build their own AudioStreamPlayer without a bus,
	# so they played on Master and the EFFECTS slider did nothing to them.
	var wreck := Derelict.new()
	system_root.add_child(wreck)
	await get_tree().process_frame
	var probe := Sfx.attached_loop(self, "crack", -6.0)
	var bus_ok: bool = probe.bus == Sfx.BUS_SFX
	var crack_stream := probe.stream as AudioStreamWAV
	var loops_ok: bool = crack_stream != null and crack_stream.loop_mode == AudioStreamWAV.LOOP_FORWARD
	# The deepest hulks hold for 1.8 + 0.2 * band seconds; the sample is 2.2s, so
	# without looping the audio stopped before the wreck gave way.
	var longest_hold := 1.8 + 0.2 * 4.0
	print("[feel] CRACK BUS bus=%s (must be %s) -> %s" % [
		probe.bus, Sfx.BUS_SFX, "PASS" if bus_ok else "FAIL"])
	print("[feel] CRACK OUTLASTS HOLD sample=%.2fs deepest hold=%.2fs looped=%s -> %s" % [
		crack_stream.get_length() if crack_stream else -1.0, longest_hold, str(loops_ok),
		"PASS" if loops_ok else "FAIL"])
	probe.queue_free()
	wreck.queue_free()

	# --- 5. the blade is audible ---------------------------------------------
	# sweep.wav was generated, imported and loaded on every boot since the first
	# audio pass, and never played once.
	var arm := SweepArm.new()
	system_root.add_child(arm)
	await get_tree().process_frame
	arm.active = true
	await get_tree().process_frame
	var arm_audible: bool = arm.audio_playing()
	arm.active = false
	await get_tree().process_frame
	var arm_silent: bool = not arm.audio_playing()
	print("[feel] SWEEP AUDIBLE active=%s inactive silent=%s -> %s" % [
		str(arm_audible), str(arm_silent), "PASS" if arm_audible and arm_silent else "FAIL"])
	arm.queue_free()

	# --- 6. the shield ghost trails damage, and only downward ----------------
	player.invulnerable = false
	player.shield = player.shield_max
	await get_tree().create_timer(0.2).timeout
	player.take_hit(player.shield_max * 0.4, null)
	await get_tree().process_frame
	await get_tree().process_frame
	var frac_after: float = player.shield_fraction()
	var ghost_after: float = player.shield_ghost_fraction()
	var trails: bool = ghost_after > frac_after + 0.05
	# And it must converge, or it is not a ghost, it is a second bar.
	await get_tree().create_timer(2.0).timeout
	var converged: bool = absf(player.shield_ghost_fraction() - player.shield_fraction()) < 0.02
	print("[feel] SHIELD GHOST after hit ghost=%.2f > fill=%.2f =%s, converges=%s -> %s" % [
		ghost_after, frac_after, str(trails), str(converged),
		"PASS" if trails and converged else "FAIL"])

	# --- 7. teleports land exactly where they were told to ------------------
	# The interpolation reset is invisible headless, but a teleport that does not
	# assign cleanly would show up here first.
	player.teleport_to(Vector3(120.0, 0.0, -40.0))
	var landed: bool = player.global_position.distance_to(Vector3(120.0, 0.0, -40.0)) < 0.001
	player.teleport_to(PlayerShip.SPAWN_POINT)
	var home: bool = player.global_position.distance_to(PlayerShip.SPAWN_POINT) < 0.001
	print("[feel] TELEPORT exact out=%s back=%s -> %s" % [
		str(landed), str(home), "PASS" if landed and home else "FAIL"])

	# --- 8. only fixed-tick movers interpolate -------------------------------
	# Most of Pyxis moves in _process; interpolating those would cost a frame of
	# lag. This asserts the split is what the project.godot comment claims.
	# Asserted on the RESOLVED state, not the declared mode. The first version of
	# this checked physics_interpolation_mode and passed while the rig was
	# actually interpolating: the rig's mode was INHERIT, which resolved to ON
	# from the root, and the engine was warning about the Camera3D every boot.
	# A property that can be INHERIT is not the property worth asserting on.
	var ship_on: bool = player.is_physics_interpolated()
	var rig_off: bool = not rig.is_physics_interpolated()
	var cam_off: bool = not get_viewport().get_camera_3d().is_physics_interpolated()
	var world_off: bool = not system_root.is_physics_interpolated()
	print("[feel] INTERP SPLIT ship=%s rig=%s camera=%s world=%s (want on/off/off/off) -> %s" % [
		str(ship_on), str(not rig_off), str(not cam_off), str(not world_off),
		"PASS" if ship_on and rig_off and cam_off and world_off else "FAIL"])

	get_tree().quit()


# --- controls, micro-interactions and haptics --------------------------------

func _run_ui_test() -> void:
	# Guards the parts of the UI pass that are mechanical rather than aesthetic:
	# that every state of every control is actually distinct, that the paint
	# counter cannot take salvage without delivering paint, and that the two new
	# accessibility settings reach the things they claim to gate.
	await get_tree().create_timer(0.3).timeout

	# --- 1. the pause menu is styled at all ----------------------------------
	# Every action button used to be a bare Button with a font colour and no
	# StyleBox, so the most-opened screen in the game rendered in Godot's default
	# grey while the title screen was the only styled surface in the build.
	pause_menu.open()
	await get_tree().process_frame
	var actions := _collect_buttons(pause_menu)
	var styled := 0
	var distinct := 0
	for b_v in actions:
		var b := b_v as Button
		var n := b.get_theme_stylebox("normal")
		var h := b.get_theme_stylebox("hover")
		var d := b.get_theme_stylebox("disabled")
		if n != null and not (n is StyleBoxEmpty):
			styled += 1
		# Distinct INSTANCES, not just distinct values: the swatch bug was one
		# StyleBox assigned to all four states, so any later edit to one state
		# silently edited the others too.
		if n != h and h != d and n != d:
			distinct += 1
	print("[ui] PAUSE STYLED %d/%d buttons have a normal box, %d/%d have distinct states -> %s" % [
		styled, actions.size(), distinct, actions.size(),
		"PASS" if actions.size() > 0 and styled == actions.size() and distinct == actions.size() else "FAIL"])

	# --- 2. the log reveals rather than appearing ----------------------------
	# Ten lines arriving at once is a wall of text. Asserted as "starts
	# transparent and finishes opaque" rather than by sampling the tween, because
	# the rule is that the entries animate, not that they animate a certain way.
	GameState.note_log("SHOOK DOWN THE HARNESS")
	GameState.note_log("CROSSED INTO THE DRIFT")
	GameState.set_setting("reduce_motion", false)
	pause_menu.show_log()
	await get_tree().process_frame
	var revealing := pause_menu.log_entries()
	var started_hidden := revealing.size() > 0
	for l_v in revealing:
		if (l_v as Control).modulate.a > 0.9:
			started_hidden = false
	await get_tree().create_timer(1.2).timeout
	var ended_visible := true
	for l_v in pause_menu.log_entries():
		if (l_v as Control).modulate.a < 0.99:
			ended_visible = false
	print("[ui] LOG REVEAL %d entries start faded=%s, end opaque=%s -> %s" % [
		revealing.size(), str(started_hidden), str(ended_visible),
		"PASS" if started_hidden and ended_visible else "FAIL"])

	# Reduced motion is the END STATE IMMEDIATELY, not the same animation played
	# faster. An accommodation that still animates is not an accommodation.
	GameState.set_setting("reduce_motion", true)
	pause_menu.show_log()
	await get_tree().process_frame
	var instant := true
	var reduced := pause_menu.log_entries()
	for l_v in reduced:
		if (l_v as Control).modulate.a < 0.99:
			instant = false
	print("[ui] LOG REDUCED MOTION %d entries opaque on frame one=%s -> %s" % [
		reduced.size(), str(instant), "PASS" if instant and reduced.size() > 0 else "FAIL"])
	GameState.set_setting("reduce_motion", false)
	pause_menu.resume()

	# --- 3. the haptic gate --------------------------------------------------
	GameState.set_setting("haptics", false)
	var before := Sfx.haptic_count
	Sfx.haptic("heavy")
	var silent := Sfx.haptic_count == before
	GameState.set_setting("haptics", true)
	Sfx.haptic("heavy")
	var fired := Sfx.haptic_count == before + 1
	print("[ui] HAPTIC GATE off:silent=%s on:fires=%s kind=%s -> %s" % [
		str(silent), str(fired), Sfx.haptic_last, "PASS" if silent and fired else "FAIL"])

	# Reduced motion must also stop the camera, through the shake gate rather
	# than through a second check every effect would have to remember.
	GameState.set_setting("shake", true)
	GameState.set_setting("reduce_motion", true)
	var motion_off := not GameState.shake_enabled()
	GameState.set_setting("reduce_motion", false)
	var motion_on := GameState.shake_enabled()
	print("[ui] REDUCE MOTION subsumes shake: on->%s off->%s -> %s" % [
		str(not motion_off), str(motion_on), "PASS" if motion_off and motion_on else "FAIL"])

	# --- 4. paint is ordered: decide, charge, apply --------------------------
	# The old order spent first and applied second, so any refusal added between
	# the two would take the salvage and leave the hull its old colour.
	GameState.set_livery(0, 0)
	GameState.salvage = 100000
	var rich := GameState.salvage
	port_panel._apply_paint(3, true, PortPanel.PAINT_PRICE)
	var applied: bool = GameState.livery_index("hull") == 3
	var charged: bool = GameState.salvage == rich - PortPanel.PAINT_PRICE
	print("[ui] PAINT APPLIES hull=%d (want 3), salvage %d -> %d -> %s" % [
		GameState.livery_index("hull"), rich, GameState.salvage,
		"PASS" if applied and charged else "FAIL"])

	# Too poor: nothing may change, in either direction.
	GameState.salvage = PortPanel.PAINT_PRICE - 1
	var poor := GameState.salvage
	port_panel._apply_paint(5, true, PortPanel.PAINT_PRICE)
	print("[ui] PAINT REFUSED broke: hull stayed %d (want 3), salvage stayed %d -> %s" % [
		GameState.livery_index("hull"), GameState.salvage,
		"PASS" if GameState.livery_index("hull") == 3 and GameState.salvage == poor else "FAIL"])

	# Repainting the colour already worn is refused before it is charged.
	GameState.salvage = 100000
	var same_before := GameState.salvage
	port_panel._apply_paint(3, true, PortPanel.PAINT_PRICE)
	print("[ui] PAINT NO-OP repaint of worn colour costs nothing: %d -> %d -> %s" % [
		same_before, GameState.salvage,
		"PASS" if GameState.salvage == same_before else "FAIL"])

	# The ordering itself: a refusal that is NOT the already-worn one. An accent
	# index past the end of the table is what _can_wear rejects today, and it
	# stands in for the Commission's locked ninth accent -- the case the old
	# spend-then-apply order would have charged for and then declined to deliver.
	GameState.set_livery(0, 0)
	GameState.salvage = 100000
	var locked_before := GameState.salvage
	var accent_before := GameState.livery_index("accent")
	port_panel._apply_paint(Palette.LIVERY_ACCENTS.size(), false, PortPanel.PAINT_PRICE)
	var unpaid: bool = GameState.salvage == locked_before
	var unworn: bool = GameState.livery_index("accent") == accent_before
	print("[ui] PAINT ORDERED refused accent %d: salvage %d (unchanged=%s), accent %d (unchanged=%s) -> %s" % [
		Palette.LIVERY_ACCENTS.size(), GameState.salvage, str(unpaid),
		GameState.livery_index("accent"), str(unworn),
		"PASS" if unpaid and unworn else "FAIL"])

	# --- 5. swatch states are distinct instances ------------------------------
	var grid := port_panel._swatch_grid("HULL", Palette.LIVERY_HULLS, 0, PortPanel.PAINT_PRICE, true)
	var swatches := _collect_buttons(grid)
	var all_distinct := swatches.size() == Palette.LIVERY_HULLS.size()
	for b_v in swatches:
		var b := b_v as Button
		if b.get_theme_stylebox("normal") == b.get_theme_stylebox("hover"):
			all_distinct = false
	print("[ui] SWATCH STATES %d swatches, hover box differs from normal on all=%s -> %s" % [
		swatches.size(), str(all_distinct), "PASS" if all_distinct else "FAIL"])
	grid.queue_free()

	# --- 6. settings round-trip ----------------------------------------------
	# Both new keys have to survive a save/load, or the accessibility toggles are
	# decorative.
	GameState.set_setting("haptics", false)
	GameState.set_setting("reduce_motion", true)
	var probe := {}
	for k in GameState.DEFAULT_SETTINGS:
		probe[k] = GameState.setting(k)
	GameState.settings = GameState.DEFAULT_SETTINGS.duplicate()
	for k in probe:
		GameState.settings[k] = probe[k]
	var kept: bool = GameState.setting("haptics") == false and GameState.setting("reduce_motion") == true
	print("[ui] SETTINGS ROUND TRIP haptics=%s reduce_motion=%s -> %s" % [
		str(GameState.setting("haptics")), str(GameState.setting("reduce_motion")),
		"PASS" if kept else "FAIL"])

	# --- 7. DEPART is a control, not a seventh tab ---------------------------
	# It used to be the last child of the same HFlowContainer as the services,
	# wearing the same stock-grey chrome and differing only by a teal label --
	# so it read as a tab, which is both easy to miss when you want it and easy
	# to hit when you do not.
	var dock_port: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		dock_port = n as Port
		break
	port_panel.open_for(dock_port)
	await get_tree().process_frame
	var depart_btn := port_panel._tabs["depart"] as Button
	var in_row: bool = depart_btn.get_parent() == port_panel._tab_row
	var depart_box := depart_btn.get_theme_stylebox("normal")
	var depart_styled: bool = depart_box != null and not (depart_box is StyleBoxEmpty)
	print("[ui] DEPART IS A CONTROL in the tab row=%s (want false), has a stylebox=%s -> %s" % [
		str(in_row), str(depart_styled),
		"PASS" if not in_row and depart_styled else "FAIL"])

	# --- 8. two clicks outside the sheet leave -------------------------------
	# Deliberately a DOUBLE press: the world behind the sheet is live and the rig
	# still pans while docked, so one stray click undocking would be worse than
	# the mis-tap this whole change is about.
	_complete_dock(dock_port)
	await get_tree().process_frame
	var was_docked: bool = docked_port != null
	var outside := Vector2(20.0, 20.0)         # top-left; the sheet is the bottom 66%
	var single := InputEventMouseButton.new()
	single.button_index = MOUSE_BUTTON_LEFT
	single.pressed = true
	single.position = outside
	port_panel._unhandled_input(single)
	await get_tree().process_frame
	var survived_single: bool = docked_port != null
	var second := InputEventMouseButton.new()
	second.button_index = MOUSE_BUTTON_LEFT
	second.pressed = true
	second.position = outside
	port_panel._unhandled_input(second)
	await get_tree().process_frame
	print("[ui] DOUBLE CLICK DEPARTS docked=%s, survives one click=%s, gone after two=%s -> %s" % [
		str(was_docked), str(survived_single), str(docked_port == null),
		"PASS" if was_docked and survived_single and docked_port == null else "FAIL"])

	# --- 9. and the sheet can be reached again -------------------------------
	# CameraRig._cancel closes the panel without undocking and request_dock
	# refuses while docked_port is set, so before this the escape ladder was
	# one-way: a player who pressed Escape was clamped to a station with no way
	# back to its counters.
	_complete_dock(dock_port)
	await get_tree().process_frame
	port_panel.close_panel()
	await get_tree().process_frame
	var stranded: bool = docked_port != null and not port_panel.is_open
	dock_port.on_tapped()
	await get_tree().process_frame
	print("[ui] REOPEN AFTER ESCAPE closed while docked=%s, tapping the port reopens=%s -> %s" % [
		str(stranded), str(port_panel.is_open),
		"PASS" if stranded and port_panel.is_open else "FAIL"])

	# --- 10. the stat strip wraps rather than starving -----------------------
	# Six stats were added to summary_lines and the row they live in was an
	# HBoxContainer of EXPAND_FILL cells, which does not overflow where anyone can
	# see it -- it SQUEEZES. The worst fit the catalog can build (an arc and a
	# torpedo for CHAIN and SPLASH, a prospector and an assay rig for CUT, ORE and
	# PULL) reaches fourteen columns, and shaving fourteen labels to 46px each
	# would have shipped as "the console looks a bit tight" rather than as a bug.
	#
	# MEASURED OFF THE LAID-OUT CELLS, not off CELL_MIN_W: asserting the constant
	# against itself is the SHEET FITS trap, and would agree with itself while the
	# container starved the row. Two frames because Godot settles containers over
	# one -- the same wait the hold's layout checks use.
	port_panel.close_panel()
	GameState.reactor_tier = ModuleDB.REACTOR_TIERS.size() - 1
	for wide_id in ["arc_2", "torp_2", "rig_prospector", "util_assay"]:
		if not GameState.owned.has(wide_id):
			GameState.owned.append(wide_id)
	GameState.equip(ModuleDB.Slot.WEAPON_A, "arc_2")
	GameState.equip(ModuleDB.Slot.WEAPON_B, "torp_2")
	GameState.equip(ModuleDB.Slot.UTILITY, "rig_prospector")
	GameState.equip(ModuleDB.Slot.UTILITY_B, "util_assay")
	var widest_cells: int = ModuleDB.summary_lines(GameState.stats).size()
	var strip_ok := true
	var strip_worst := 9999.0
	var strip_over := 0.0
	var strip_where := ""
	var saved_ui_scale: float = UILayout.user_scale
	for probe_size in [Vector2i(720, 1280), Vector2i(414, 736)]:
		for uscale in [0.7, 1.0, 1.6]:
			UILayout.user_scale = uscale
			get_window().size = probe_size
			refit_panel.open()
			await get_tree().process_frame
			await get_tree().process_frame
			# Typed as the base Container on purpose: this asserts the row's
			# BEHAVIOUR, so it must still compile and still fail against the
			# HBoxContainer it replaced rather than erroring on the cast.
			var strip: Container = refit_panel._stat_row
			for cell in strip.get_children():
				var w: float = (cell as Control).size.x
				if w < strip_worst:
					strip_worst = w
					strip_where = "%dx%d@%.1f" % [probe_size.x, probe_size.y, uscale]
				# A cell narrower than the floor it asked for means the row starved
				# it; a row that wraps hands every cell its minimum and grows down.
				if w + 0.5 < RefitPanel.CELL_MIN_W:
					strip_ok = false
			# And the strip must still sit inside the sheet it is drawn in. This is
			# the clause an HBoxContainer fails: it hands every cell its 62px
			# minimum and then runs 868px wide off the side of a 720px phone,
			# rather than wrapping. Tracked separately so the FAIL line says which
			# half broke instead of printing two identical-looking numbers.
			if strip.size.x > refit_panel._sheet.size.x + 0.5:
				strip_ok = false
				strip_over = maxf(strip_over, strip.size.x - refit_panel._sheet.size.x)
			refit_panel.close_panel()
			await get_tree().process_frame
	UILayout.user_scale = saved_ui_scale
	get_window().size = Vector2i(720, 1280)
	await get_tree().process_frame
	print("[ui] THE STAT STRIP WRAPS %d columns at the catalog's widest fit, narrowest cell %.0fpx against a %.0f floor (%s), overflow past the sheet %.0fpx -> %s" % [
		widest_cells, strip_worst, RefitPanel.CELL_MIN_W, strip_where, strip_over,
		"PASS" if strip_ok and widest_cells >= 12 else "FAIL"])

	# --- 11. the delta reaches the player, on both screens --------------------
	# GameState.preview_stats shipped with ZERO callers while refit_panel's own
	# header promised a "stat delta preview", so the arithmetic existed and was
	# simply never drawn. Asserting that the PANEL contains it, rather than that
	# the function returns something, is the difference between the two.
	#
	# util_repair is the case that names the bug: shield_regen is its only stat,
	# so before REGEN existed it moved nothing on either screen and a player was
	# asked to spend 13,500 on an invisible effect.
	GameState.equip(ModuleDB.Slot.UTILITY, "")
	GameState.equip(ModuleDB.Slot.UTILITY_B, "")
	if not GameState.owned.has("util_repair"):
		GameState.owned.append("util_repair")
	var repair_slot := ModuleDB.default_slot("util_repair", GameState.fit)
	var repair_delta := ModuleDB.delta_lines(
		GameState.stats, GameState.preview_stats(repair_slot, "util_repair"))
	refit_panel._slot = ModuleDB.Slot.UTILITY
	refit_panel.open()
	await get_tree().process_frame
	await get_tree().process_frame
	var refit_shows := _panel_text_contains(refit_panel._module_list, "REGEN")
	refit_panel.close_panel()
	await get_tree().process_frame
	_complete_dock(dock_port)
	port_panel._tab = "outfitter"
	port_panel._refresh()
	await get_tree().process_frame
	await get_tree().process_frame
	var store_shows := _panel_text_contains(port_panel._body, "REGEN")
	var store_pwr := _panel_text_contains(port_panel._body, "PWR")
	print("[ui] THE DELTA IS AT THE DECISION util_repair moves %d column(s) %s; refit row draws it=%s, store row draws it=%s with PWR=%s -> %s" % [
		repair_delta.size(), str(repair_delta), str(refit_shows), str(store_shows), str(store_pwr),
		"PASS" if repair_delta.size() > 0 and refit_shows and store_shows and store_pwr else "FAIL"])

	get_tree().quit()


func _collect_buttons(root: Node) -> Array:
	var out: Array = []
	for c in root.get_children():
		if c is Button:
			out.append(c)
		out.append_array(_collect_buttons(c))
	return out


# --- the Grand Commission ----------------------------------------------------

func _run_gsa_test() -> void:
	# The Commission is the first system in the game whose state is PERSISTENT
	# and read by unrelated screens, so most of what follows is about the seams:
	# the load path, the claim ordering, and the copy rule that keeps it from
	# becoming a quest board.
	#
	# Every assertion here pins GameState.commissioned explicitly. GameState boots
	# from the developer's real save, so the moment this flag exists, any harness
	# that reads band text or the accent lock passes or fails depending on whether
	# whoever ran it happened to finish the Commission.
	await get_tree().create_timer(0.3).timeout

	# --- 1. the copy rule, as data -------------------------------------------
	# The structural rule is that a stage DESCRIBES; the moment one instructs,
	# the Commission has become a quest. A rule nothing checks is worth nothing.
	# Checked on the FIRST word, not on vocabulary anywhere in the line. English
	# imperatives lead with their verb -- "Survey the Drift" instructs, while "A
	# first survey packet" uses the same word as a noun and states a fact. A
	# contains-check would ban the noun too, and the rule is about mood.
	var imperative_found := ""
	for st_v in CommissionDB.STAGES:
		var st: Dictionary = st_v
		var words: PackedStringArray = String(st["desc"]).to_lower() \
			.replace(",", " ").replace(".", " ").split(" ", false)
		if words.size() > 0 and CommissionDB.IMPERATIVES.has(words[0]):
			imperative_found = "%s: '%s'" % [String(st["name"]), words[0]]
	print("[gsa] NO IMPERATIVE %d descriptions, none open on a verb (offender: %s) -> %s" % [
		CommissionDB.STAGES.size(), imperative_found if imperative_found != "" else "none",
		"PASS" if imperative_found == "" else "FAIL"])

	# Names state a STATUS rather than a task. Three are past participles; ON
	# FILE is a prepositional phrase, which is the same grammatical move -- what
	# the register says about you -- and is the phrase the finale calls back to.
	# What matters is that none of them is something to go and do.
	var status_names := true
	for st_v in CommissionDB.STAGES:
		var first := String((st_v as Dictionary)["name"]).to_lower().split(" ")[0]
		if CommissionDB.IMPERATIVES.has(first):
			status_names = false
	print("[gsa] STAGE COUNT %d stages (clamps use STAGES.size()), no name is a task=%s -> %s" % [
		CommissionDB.count(), str(status_names),
		"PASS" if CommissionDB.count() == 4 and status_names else "FAIL"])

	# --- 2. the load path clamps ---------------------------------------------
	var probe := "user://gsa_probe.json"
	var real_path := GameState.save_path
	GameState.save_path = probe

	var high := _gsa_fixture({"commission_claimed": 99})
	GameState.load_game()
	var clamped_high := GameState.commission_claimed
	_gsa_fixture({"commission_claimed": -5})
	GameState.load_game()
	var clamped_low := GameState.commission_claimed
	print("[gsa] LOAD CLAMPS 99 -> %d (want %d), -5 -> %d (want 0) -> %s" % [
		clamped_high, CommissionDB.count(), clamped_low,
		"PASS" if clamped_high == CommissionDB.count() and clamped_low == 0 else "FAIL"])

	# --- 3. the accent lock, against the SHIP MATERIAL ------------------------
	# Not against the stored int. player_ship.gd reads
	# Palette.livery_accent(livery_index("accent")) directly and never asks
	# set_livery anything, so the stored value is not what the player sees.
	# posmod wraps, so 8 and 17 are the same attack wearing different numbers.
	var locked_ok := true
	var seen: Array = []
	for bad in [GameState.REGISTRY_ACCENT, 17]:
		_gsa_fixture({"commissioned": false, "livery": {"hull": 0, "accent": bad}})
		GameState.load_game()
		seen.append(GameState.livery_index("accent"))
		if GameState.livery_index("accent") >= GameState.REGISTRY_ACCENT:
			locked_ok = false
	print("[gsa] ACCENT LOCKED AT THE LOAD PATH uncommissioned accents [8, 17] -> %s -> %s" % [
		str(seen), "PASS" if locked_ok else "FAIL"])

	# And an earned one must survive, or the lock has eaten a real reward.
	_gsa_fixture({"commissioned": true, "livery": {"hull": 0, "accent": GameState.REGISTRY_ACCENT}})
	GameState.load_game()
	var kept: bool = GameState.livery_index("accent") == GameState.REGISTRY_ACCENT
	print("[gsa] ACCENT KEPT WHEN EARNED commissioned accent 8 -> %d -> %s" % [
		GameState.livery_index("accent"), "PASS" if kept else "FAIL"])

	# The clamp underneath it: these were the only unbounded ints in load_game.
	_gsa_fixture({"commissioned": true, "livery": {"hull": 999, "accent": 3}})
	GameState.load_game()
	var hull_ok: bool = GameState.livery_index("hull") < Palette.LIVERY_HULLS.size()
	print("[gsa] LIVERY CLAMPS hull 999 -> %d (max %d) -> %s" % [
		GameState.livery_index("hull"), Palette.LIVERY_HULLS.size() - 1,
		"PASS" if hull_ok else "FAIL"])

	GameState.save_path = real_path
	DirAccess.remove_absolute(ProjectSettings.globalize_path(probe))

	# --- 4. claim ordering and re-entrancy -----------------------------------
	GameState.commissioned = false
	GameState.commission_claimed = 0
	GameState.ledger = GameState.DEFAULT_LEDGER.duplicate()
	for k in ["chart_data_sold", "hulks_cracked", "posts_cleared", "deepest_depth"]:
		GameState.ledger[k] = 100000
	GameState.salvage = 0

	# STATE BEFORE MONEY. add_salvage emits salvage_changed, and PortPanel wires
	# that straight back into _refresh() -- so a claim that paid before it
	# incremented would rebuild the sheet reading the pre-claim stage and redraw
	# the button it had just honoured.
	# The box is an Array because GDScript lambdas capture locals BY VALUE: a
	# plain int written inside the closure updates the closure's own copy and the
	# assertion reads the untouched original, which is an assertion that cannot
	# fail. An Array is a reference and survives the capture.
	var box: Array = [-1]
	var once := func(_v: int) -> void:
		if int(box[0]) < 0:
			box[0] = GameState.commission_claimed
	GameState.salvage_changed.connect(once)
	var first := GameState.claim_commission()
	GameState.salvage_changed.disconnect(once)
	print("[gsa] STATE BEFORE MONEY salvage_changed saw claimed=%d (want 1) -> %s" % [
		int(box[0]), "PASS" if int(box[0]) == 1 else "FAIL"])
	print("[gsa] CLAIM PAYS stage '%s' paid %d, salvage now %d -> %s" % [
		String(first.get("name", "")), int(first.get("pays", 0)), GameState.salvage,
		"PASS" if int(first.get("pays", 0)) == GameState.salvage and GameState.salvage > 0 else "FAIL"])

	# CLAIM GUARDS ITSELF: called directly, not through a button, because the
	# harness is exactly the second caller survey_mast.gd's comment warns about.
	var before_second := GameState.salvage
	var stage_before := GameState.commission_claimed
	GameState.claim_commission()
	GameState.claim_commission()
	print("[gsa] CLAIM GUARDS ITSELF three more direct calls from stage %d -> stage %d, salvage %d -> %d -> %s" % [
		stage_before, GameState.commission_claimed, before_second, GameState.salvage,
		"PASS" if GameState.commission_claimed == stage_before + 2 else "FAIL"])

	# CLAIM IS ORDERED: you cannot skip to stage 3 with every threshold met.
	GameState.commission_claimed = 1
	var ordered: bool = GameState.commission_stage() == 1
	print("[gsa] CLAIM IS ORDERED at claimed=1 the next stage is %d (want 1), not the highest met -> %s" % [
		GameState.commission_stage(), "PASS" if ordered else "FAIL"])

	# Thresholds actually gate: an empty ledger claims nothing.
	GameState.commission_claimed = 0
	GameState.ledger = GameState.DEFAULT_LEDGER.duplicate()
	var empty := GameState.claim_commission()
	print("[gsa] THRESHOLDS GATE empty ledger claims nothing (got %s), shortfalls %d -> %s" % [
		"{}" if empty.is_empty() else str(empty),
		CommissionDB.shortfalls(0, GameState.ledger).size(),
		"PASS" if empty.is_empty() else "FAIL"])

	# --- 5. the persistent flag ----------------------------------------------
	GameState.commissioned = false
	GameState.commission_claimed = 0
	for k in ["chart_data_sold", "hulks_cracked", "posts_cleared", "deepest_depth"]:
		GameState.ledger[k] = 100000
	for _i in range(CommissionDB.count()):
		GameState.claim_commission()
	var earned: bool = GameState.commissioned and GameState.commission_complete()
	# RESET WITH RUN: the counter is run state, the flag is not.
	GameState.reset_to_starter()
	var survived: bool = GameState.commissioned and GameState.commission_claimed == 0
	print("[gsa] RESET WITH RUN after 4 claims commissioned=%s; after reset claimed=%d commissioned=%s -> %s" % [
		str(earned), GameState.commission_claimed, str(GameState.commissioned),
		"PASS" if earned and survived else "FAIL"])

	# NOT A TALLY: the Commission is the authority describing you, so the front
	# door carries a registry line, never a progress count.
	GameState.commissioned = true
	var summary := title_screen.title_summary()
	var registry := title_screen.registry_line()
	var clean: bool = not summary.contains("COMMISSION") and not summary.contains("/4") \
		and registry.contains("COMMISSIONED")
	print("[gsa] NOT A TALLY summary '%s' carries no stage count; registry '%s' -> %s" % [
		summary, registry, "PASS" if clean else "FAIL"])

	# --- 6. beacon parity ----------------------------------------------------
	# The clause that matters: broadcast_for(band, false) must be string-identical
	# to what shipped, or the rewrite has quietly edited the uncommissioned text.
	var uncommissioned_intact := true
	for band in range(DeepSpace.BROADCASTS.size()):
		var raw: Dictionary = DeepSpace.BROADCASTS[band]
		var got := DeepSpace.broadcast_for(band, false)
		if band <= 0:
			continue
		if String(got.get("from", "")) != String(raw.get("from", "")) \
				or String(got.get("body", "")) != String(raw.get("body", "")):
			uncommissioned_intact = false
	var bands_answer := true
	for band in [1, 2, 3]:
		var c := DeepSpace.broadcast_for(band, true)
		var u := DeepSpace.broadcast_for(band, false)
		if String(c.get("body", "")) == String(u.get("body", "")):
			bands_answer = false
	# Band 4 stays silent, and that is the note the arc ends on: COMMISSIONED
	# requires reaching THE QUIET, the one band that will never acknowledge it.
	# EVERY BAND PAST THE DRIFT IS SILENT, not just index 4. The literal was
	# written when the Quiet was the last band; the register's arc still ends
	# there, so the frontier's two bands must carry no commissioned variant
	# either — and asserting that over the whole tail is the rule, where "band 4"
	# was only the instance of it that existed at the time.
	var quiet_silent := true
	for band in range(4, DeepSpace.BROADCASTS.size()):
		if String(DeepSpace.broadcast_for(band, true).get("body", "")) \
				!= String(DeepSpace.broadcast_for(band, false).get("body", "")):
			quiet_silent = false
	print("[gsa] BEACON PARITY %d bands, uncommissioned text unchanged=%s, bands 1-3 answer=%s, band 4 silent=%s -> %s" % [
		DeepSpace.BROADCASTS.size(), str(uncommissioned_intact), str(bands_answer), str(quiet_silent),
		"PASS" if DeepSpace.BROADCASTS.size() == DeepSpace.BAND_NAMES.size() and uncommissioned_intact \
			and bands_answer and quiet_silent else "FAIL"])

	# --- 7. every service renders its own body -------------------------------
	# Finding 5: port_panel's `match _tab` catch-all IS the outfitter, so a
	# TAB_LABELS entry without a matching arm renders a plausible-looking second
	# outfitter with no error and no crash. The hole is load-bearing, so it
	# cannot be replaced with a warning -- only checked.
	# Checked by RENDERING each tab and comparing the result to the outfitter's,
	# not by guessing method names -- "contracts" builds through
	# _build_contract_board, so a has_method("_build_contracts") check reports a
	# working screen as missing. What the rule actually says is that every
	# service shows its own body, and the only way to know that is to draw it.
	var port_node: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		port_node = n as Port
		break
	var shadows: Array = []
	if port_node != null:
		port_node.def = SystemDB.port_def_by_id("anchor").duplicate(true)
		port_node.def["services"] = PortPanel.TAB_LABELS.keys()
		port_panel.open_for(port_node)
		await get_tree().process_frame
		# Nodes queued for deletion are SKIPPED. _refresh queue_frees the old body
		# and builds the new one in the same frame, and queue_free is deferred --
		# so a naive child walk reads the previous tab's rows alongside this
		# tab's, every fingerprint comes out unique, and the assertion passes on
		# every possible input. That is the assertion-that-cannot-fail this
		# codebase has a written rule about.
		var fingerprint := func(tab: String) -> String:
			port_panel._tab = tab
			port_panel._refresh()
			var live: Array = []
			for c in port_panel._body.get_children():
				if not c.is_queued_for_deletion():
					live.append(c)
			var out := "%d|" % live.size()
			for c in live:
				if c is Label:
					out += String((c as Label).text).substr(0, 40) + ";"
			return out
		var outfitter: String = await fingerprint.call("outfitter")
		for key_v in PortPanel.TAB_LABELS:
			var key := String(key_v)
			if key == "outfitter":
				continue
			var body: String = await fingerprint.call(key)
			if body == outfitter:
				shadows.append(key)
		port_panel.close_panel()
	print("[gsa] EVERY SERVICE HAS A BUILDER %d labels, rendering as a second outfitter: %s -> %s" % [
		PortPanel.TAB_LABELS.size(), str(shadows) if not shadows.is_empty() else "none",
		"PASS" if port_node != null and shadows.is_empty() else "FAIL"])

	# The Anchor offers it, and does NOT lead with it: services()[0] is the
	# landing tab, so a prepended registry would open every dock on paperwork.
	var anchor := SystemDB.port_def_by_id("anchor")
	var svc: Array = anchor.get("services", [])
	print("[gsa] COMMISSION APPENDED anchor services %s, first=%s -> %s" % [
		str(svc), String(svc[0]) if not svc.is_empty() else "none",
		"PASS" if svc.has("commission") and String(svc[0]) != "commission" else "FAIL"])

	# --- 8. the swatch grid fits the ninth ------------------------------------
	print("[gsa] ACCENT ROW %d accents, grid columns %d -> %s" % [
		Palette.LIVERY_ACCENTS.size(), 9,
		"PASS" if Palette.LIVERY_ACCENTS.size() == 9 else "FAIL"])

	get_tree().quit()


func _gsa_fixture(overrides: Dictionary) -> Dictionary:
	# A minimal valid v13 save with the fields under test overridden. Written
	# rather than hand-edited in memory, because the whole point of these
	# assertions is what happens on the LOAD PATH.
	var data := {
		"version": GameState.SAVE_VERSION,
		"salvage": 0,
		"current_system": SystemDB.START_SYSTEM,
		"livery": {"hull": 0, "accent": 0},
		"commission_claimed": 0,
		"commissioned": false,
	}
	for k in overrides:
		data[k] = overrides[k]
	var f := FileAccess.open(GameState.save_path, FileAccess.WRITE)
	f.store_string(JSON.stringify(data, "\t"))
	f.close()
	return data


# --- accessibility -----------------------------------------------------------

func _run_access_test() -> void:
	# Colour vision and rebinding. The interesting assertions here are the two
	# that check a PROPERTY rather than a value: that mode 0 is byte-identical to
	# the shipped palette, and that every remapped band set is actually
	# distinguishable under the confusion line it was built for. Eyeballing a
	# palette is exactly how a palette that looks fine to the author ships.
	await get_tree().create_timer(0.3).timeout

	# --- 1. the default cannot drift ------------------------------------------
	Palette.vision = Palette.Vision.NORMAL
	var identical := true
	for i in range(Palette.DEEP_BANDS.size()):
		if Palette.band_color(i) != Palette.DEEP_BANDS[i]:
			identical = false
	print("[access] MODE 0 IS THE SHIPPED PALETTE %d bands byte-identical=%s -> %s" % [
		Palette.DEEP_BANDS.size(), str(identical), "PASS" if identical else "FAIL"])

	# --- 2. every mode is actually distinguishable ---------------------------
	# Simulated through the standard Brettel/Vienot dichromat projections, then
	# compared pairwise. The shipped set FAILS this under deuteranopia, which is
	# the entire reason the remaps exist -- so this assertion is checked against
	# the default too, and is expected to be worse there.
	var modes := {
		Palette.Vision.NORMAL: "shipped",
		Palette.Vision.DEUTAN: "deutan",
		Palette.Vision.PROTAN: "protan",
		Palette.Vision.TRITAN: "tritan",
	}
	var worst_default := 999.0
	var all_ok := true
	var report: Array = []
	for mode_v in modes:
		var mode: int = mode_v
		Palette.vision = mode
		# A mode is judged under ITS OWN confusion line: the deutan set only has
		# to survive deuteranopia. Judging every set under every deficiency would
		# be asking one palette to solve three different problems at once.
		var sim := mode if mode != Palette.Vision.NORMAL else Palette.Vision.DEUTAN
		var worst := 999.0
		for a in range(Palette.DEEP_BANDS.size()):
			for b in range(a + 1, Palette.DEEP_BANDS.size()):
				var d := _confusion_distance(Palette.band_color(a), Palette.band_color(b), sim)
				worst = minf(worst, d)
		report.append("%s %.3f" % [String(modes[mode]), worst])
		if mode == Palette.Vision.NORMAL:
			worst_default = worst
		elif worst < 0.20:
			all_ok = false
	Palette.vision = Palette.Vision.NORMAL
	print("[access] BANDS SEPARATE closest pair per mode: %s (want >= 0.20 on each remap) -> %s" % [
		str(report), "PASS" if all_ok else "FAIL"])
	# And the remaps have to be an IMPROVEMENT, not merely different. If the
	# shipped set already separated under deuteranopia there would be no reason
	# for any of this.
	Palette.vision = Palette.Vision.DEUTAN
	var deutan_worst := 999.0
	for a in range(Palette.DEEP_BANDS.size()):
		for b in range(a + 1, Palette.DEEP_BANDS.size()):
			deutan_worst = minf(deutan_worst,
				_confusion_distance(Palette.band_color(a), Palette.band_color(b), Palette.Vision.DEUTAN))
	Palette.vision = Palette.Vision.NORMAL
	print("[access] REMAP IMPROVES deutan %.3f vs shipped %.3f under the same simulation -> %s" % [
		deutan_worst, worst_default, "PASS" if deutan_worst > worst_default else "FAIL"])

	# --- 3. colour is not the only tell --------------------------------------
	# The robust half, and the one that works in every mode including the
	# default: a glyph per band, on the wayfinding label and on every broadcast
	# header. Legible in greyscale and in sunlight, which no palette is.
	var glyphs: Array = []
	var unique := true
	for i in range(1, Palette.BAND_GLYPHS.size()):
		var g := Palette.band_glyph(i)
		if g == "" or glyphs.has(g):
			unique = false
		glyphs.append(g)
	print("[access] BAND GLYPHS %s distinct and non-empty for bands 1-4=%s -> %s" % [
		str(glyphs), str(unique), "PASS" if unique else "FAIL"])

	# The glyph must actually reach the readout, not merely exist.
	hud.set_deep_tag(DeepSpace.band_name(500.0), 500.0)
	await get_tree().process_frame
	var tag := hud.system_tag_text()
	var carried: bool = tag.contains(Palette.band_glyph(DeepSpace.band_of(500.0)))
	print("[access] GLYPH ON THE READOUT '%s' carries band %d's glyph=%s -> %s" % [
		tag, DeepSpace.band_of(500.0), str(carried), "PASS" if carried else "FAIL"])

	# --- 4. the setting survives, clamps, and rebuilds ------------------------
	GameState.set_setting("colorblind", 99)
	var clamped: bool = Palette.vision <= Palette.Vision.TRITAN
	GameState.set_setting("colorblind", int(Palette.Vision.DEUTAN))
	await get_tree().create_timer(0.4).timeout
	# Asserted against a live material, not against the setting: every deep
	# material is baked at construction, so a mode that changes the number
	# without rebuilding the world changes nothing the player can see.
	var mast_tinted := false
	for n in get_tree().get_nodes_in_group("surveyable"):
		if n.has_method("dish_color"):
			mast_tinted = true
	print("[access] MODE CLAMPS 99 -> %d, applied live=%s -> %s" % [
		Palette.vision, str(GameState.setting("colorblind") == int(Palette.Vision.DEUTAN)),
		"PASS" if clamped and GameState.setting("colorblind") == int(Palette.Vision.DEUTAN) else "FAIL"])
	GameState.set_setting("colorblind", 0)

	# --- 5. rebinding -------------------------------------------------------
	GameState.reset_bindings()
	var before := _keys_for("move_up")
	# KEY_Y, not KEY_I: I is toggle_hold's shipped default now, and a probe that
	# rebinds move_up onto another action's real key would be measuring the
	# conflict-stealing loop by accident instead of the rebind it names. Y is
	# unclaimed and carries no plausible future semantic (unlike M for map or
	# C for chart).
	var ok := GameState.rebind("move_up", KEY_Y)
	var after := _keys_for("move_up")
	print("[access] REBIND move_up %s -> %s (accepted=%s) -> %s" % [
		str(before), str(after), str(ok),
		"PASS" if ok and after.has(KEY_Y) and not after.has(KEY_W) else "FAIL"])

	# A key already spoken for is TAKEN from its old owner, never shared. Two
	# actions on one key is not a binding, it is a bug found mid-flight.
	GameState.reset_bindings()
	GameState.rebind("move_up", KEY_J)
	GameState.rebind("move_down", KEY_J)
	var up := _keys_for("move_up")
	var down := _keys_for("move_down")
	var no_overlap: bool = not (up.has(KEY_J) and down.has(KEY_J))
	# And neither action may be left with nothing bound -- an unreachable action
	# is worse than a shared key, because nothing reveals it until it is needed.
	var both_bound: bool = not up.is_empty() and not down.is_empty()
	print("[access] NO SHARED KEY move_up=%s move_down=%s, no overlap=%s, both still bound=%s -> %s" % [
		str(up), str(down), str(no_overlap), str(both_bound),
		"PASS" if no_overlap and both_bound else "FAIL"])

	# EVERY ACTION IS REBINDABLE OR RESERVED, and this is the clause NO SHARED
	# KEY structurally cannot see. That assertion drives rebind() and can only
	# police actions rebind() knows about; an action declared in project.godot
	# and left out of REBINDABLE is invisible to the conflict loop, so it can
	# sit on another action's key forever and every rebinding assertion above
	# stays green. So: assert the INVARIANT -- the InputMap and the list agree,
	# with `cancel` the one authored exception named right here.
	var declared: Array = []
	for a_v in InputMap.get_actions():
		var a := String(a_v)
		if not a.begins_with("ui_"):
			declared.append(a)
	declared.sort()
	var accounted: Array = GameState.REBINDABLE.duplicate()
	accounted.append("cancel")
	accounted.sort()
	print("[access] EVERY ACTION IS REBINDABLE OR RESERVED declared=%s accounted=%s -> %s" % [
		str(declared), str(accounted), "PASS" if declared == accounted else "FAIL"])

	# Cancel is not rebindable, and that is deliberate: it is the way out of
	# every console and of the settings page that would fix a bad binding.
	var cancel_refused: bool = not GameState.rebind("cancel", KEY_K)
	# AND THE OTHER DIRECTION, which is the half that was missing. Keeping
	# `cancel` out of REBINDABLE stops it being moved off Escape; nothing stopped
	# an action being moved ONTO Escape, and the conflict loop could not see the
	# collision because it walks REBINDABLE and `cancel` is not in it. The result
	# was a dead action (CameraRig tests `cancel` first) or, once `pause` existed,
	# an Escape that resumed from any page instead of backing out one step --
	# the manual's numbered ladder falsified from the settings screen.
	GameState.reset_bindings()
	var esc_refused: bool = not GameState.rebind("pause", KEY_ESCAPE)
	var esc_intact: bool = _keys_for("cancel").has(KEY_ESCAPE)
	print("[access] ESCAPE IS RESERVED BOTH WAYS cancel unmovable=%s, pause refused onto escape=%s, escape still cancel's=%s -> %s" % [
		str(cancel_refused), str(esc_refused), str(esc_intact),
		"PASS" if cancel_refused and esc_refused and esc_intact else "FAIL"])

	# A DEFAULT IS A BINDING TOO. The conflict loop used to read the saved
	# overrides dict, which holds only actions the player has already moved -- so
	# on a fresh install every factory binding was invisible to it, and binding
	# move_up to C returned true while leaving `chart` on C as well. Two live
	# actions on one key, from the function written to prevent exactly that.
	# NO SHARED KEY above cannot see it: its first rebind puts move_up INTO the
	# dict, so its second one finds it by the old path.
	GameState.reset_bindings()
	var chart_default := _keys_for("chart")
	var stole_default: bool = GameState.rebind("move_up", KEY_C)
	var chart_after := _keys_for("chart")
	var no_default_overlap: bool = not (_keys_for("move_up").has(KEY_C) and chart_after.has(KEY_C))
	print("[access] A DEFAULT IS A BINDING TOO chart began %s, move_up->C returned %s, chart now %s, no overlap=%s -> %s" % [
		str(chart_default), str(stole_default), str(chart_after), str(no_default_overlap),
		"PASS" if no_default_overlap else "FAIL"])
	GameState.reset_bindings()

	GameState.reset_bindings()
	var restored := _keys_for("move_up")
	print("[access] RESET RESTORES DEFAULTS move_up=%s (want W) -> %s" % [
		str(restored), "PASS" if restored.has(KEY_W) else "FAIL"])

	# --- 6. reduced motion reaches everything --------------------------------
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	GameState.set_setting("shake", true)
	GameState.set_setting("reduce_motion", true)
	rig.shake(0.5)
	rig.punch_zoom(3.0)
	var still: bool = rig.shake_amp() <= 0.0001 and rig.zoom_punch() <= 0.0001
	GameState.set_setting("reduce_motion", false)
	print("[access] REDUCE MOTION stops shake and punch with shake ON: %s -> %s" % [
		str(still), "PASS" if still else "FAIL"])

	get_tree().quit()


func _keys_for(action: String) -> Array:
	var out: Array = []
	if not InputMap.has_action(action):
		return out
	for ev in InputMap.action_get_events(action):
		var k := ev as InputEventKey
		if k != null:
			out.append(k.physical_keycode)
	return out


func _confusion_distance(a: Color, b: Color, mode: int) -> float:
	# Distance between two colours AS A DICHROMAT SEES THEM. Simulating first and
	# comparing second is the whole point: two colours can be far apart in RGB
	# and land on top of each other on a confusion line, which is exactly what
	# happens to this game's amber and bile green.
	var sa := _simulate(a, mode)
	var sb := _simulate(b, mode)
	# Weighted toward perceived luminance, because lightness is the one channel
	# every form of colour blindness keeps -- a pair that differs only in hue is
	# a pair that can vanish.
	var dl := (0.299 * (sa.r - sb.r) + 0.587 * (sa.g - sb.g) + 0.114 * (sa.b - sb.b))
	var dr := sa.r - sb.r
	var dg := sa.g - sb.g
	var db := sa.b - sb.b
	return sqrt(dl * dl * 2.0 + dr * dr + dg * dg + db * db) / 2.0


func _simulate(c: Color, mode: int) -> Color:
	# Brettel/Vienot-style linear projections onto each dichromat's surviving
	# plane. Approximate on purpose -- this is a separation check, not a
	# colour-science pipeline, and the threshold is set well above the noise.
	match mode:
		Palette.Vision.DEUTAN:
			return Color(
				0.625 * c.r + 0.700 * c.g + 0.000 * c.b,
				0.375 * c.r + 0.300 * c.g + 0.000 * c.b,
				0.000 * c.r + 0.300 * c.g + 0.700 * c.b)
		Palette.Vision.PROTAN:
			return Color(
				0.567 * c.r + 0.433 * c.g + 0.000 * c.b,
				0.558 * c.r + 0.442 * c.g + 0.000 * c.b,
				0.000 * c.r + 0.242 * c.g + 0.758 * c.b)
		Palette.Vision.TRITAN:
			return Color(
				0.950 * c.r + 0.050 * c.g + 0.000 * c.b,
				0.000 * c.r + 0.433 * c.g + 0.567 * c.b,
				0.000 * c.r + 0.475 * c.g + 0.525 * c.b)
	return c


# --- streaming cost ----------------------------------------------------------

func _run_stream_test() -> void:
	# MEASURES BEFORE IT JUDGES. The 5x5 cell window is built synchronously on
	# every cell-boundary crossing, and that is either a hitch worth amortising
	# or it is not -- and "it looks like it might be expensive" is not a reason to
	# add a budgeted queue, an escape hatch and a determinism risk to the one
	# system in this game whose purity is load-bearing.
	#
	# The budget is a 60Hz frame: 16.67ms. A build that fits inside one is not a
	# hitch, it is a frame.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	await get_tree().create_timer(0.4).timeout

	var edge := chart_edge()
	# FIRST ENTRY and a STEADY CROSSING are different problems and are measured
	# apart. Arriving in the expanse builds all 25 cells at once; sliding the
	# window one row adds 5. Only the second one happens while the player is
	# flying, and only the second one has nothing on screen to hide behind --
	# first entry already has a warp flash over it.
	var first := 0.0
	var worst := 0.0
	var total := 0.0
	var samples := 0
	# Walk outward across cell boundaries, timing the frame each crossing lands
	# on. Sampled across bands on purpose: PACK_CHANCE, STATION_CHANCE and the
	# rest all climb with depth, so a shallow-only measurement would measure the
	# cheapest cells in the game.
	# Measured PER FRAME, not per crossing, because a hitch is a single long
	# frame -- and with the build amortised, a crossing deliberately spans
	# several. Timing the whole crossing would count the amortisation as if it
	# were the cost, which is exactly backwards.
	#
	# Six frames per step, which is a tenth of a second at 60Hz: the queue has to
	# be empty well inside that or the ship outruns its own scenery.
	var worst_batch := 0
	var peak_backlog := 0
	for step in range(1, 26):
		var out := edge + float(step) * DeepSpace.CELL
		player.teleport_to(Vector3(0.0, 0.0, out))
		for f in range(6):
			peak_backlog = maxi(peak_backlog, deep_space.build_backlog())
			var t0 := Time.get_ticks_usec()
			await get_tree().process_frame
			var ms := float(Time.get_ticks_usec() - t0) / 1000.0
			if step == 1:
				first = maxf(first, ms)    # cold: the whole window at once
			else:
				worst = maxf(worst, ms)    # warm: one row of five
				worst_batch = maxi(worst_batch, deep_space.built_last_frame)
				total += ms
				samples += 1

	var mean := total / maxf(float(samples), 1.0)
	# ONE-TIME, and not a crossing: this is the frame `generating` flips on, which
	# bakes the two MultiMesh star layers and the cold shell as well as building
	# the first window. It predates the amortisation -- the earlier single-frame
	# sample simply was not looking at this frame -- and it happens under the warp
	# arrival sequence, which already holds the screen. Bounded rather than
	# ignored, so a regression that doubles it is still caught.
	print("[stream] FIRST ENTRY one-time expanse init, worst frame %.2fms (under the arrival sequence) -> %s" % [
		first, "PASS" if first < 250.0 else "FAIL"])
	# ASSERTED ON THE RULE, NOT THE STOPWATCH. Wall-clock frame time measures the
	# machine -- the same code came out at 10ms run alone and 23ms inside the full
	# sweep on a loaded box -- so gating on it makes a test that fails for reasons
	# that are not defects.
	#
	# The machine-independent rule is that construction is DEFERRED: a crossing
	# leaves cells registered and undressed, to be drained later. A cheap row may
	# legitimately finish inside one frame's budget, so "the row always splits" is
	# NOT the rule and asserting it fails on cheap rows -- but a backlog that is
	# never non-empty means the queue is a no-op and the hitch is back.
	print("[stream] WORK IS DEFERRED peak backlog %d cells after a crossing, worst frame dressed %d -> %s" % [
		peak_backlog, worst_batch, "PASS" if peak_backlog > 0 else "FAIL"])
	# Timing kept as a reported number with a loose regression bound. It caught
	# the original 44ms spike and would catch its return; it is not tight enough
	# to fail on a busy machine.
	print("[stream] FRAME TIME %d frames, mean %.2fms, worst %.2fms (60Hz = 16.67ms, bound 40) -> %s" % [
		samples, mean, worst, "PASS" if worst < 40.0 else "FAIL"])

	# Amortising is only correct if it finishes. A queue that never drains is not
	# a smoother frame, it is a ship flying through undressed space.
	player.teleport_to(Vector3(0.0, 0.0, edge + 40.0 * DeepSpace.CELL))
	var frames := 0
	while deep_space.build_backlog() > 0 and frames < 60:
		await get_tree().process_frame
		frames += 1
	print("[stream] QUEUE DRAINS backlog empty after %d frames (cap 60) -> %s" % [
		frames, "PASS" if deep_space.build_backlog() == 0 else "FAIL"])

	# And the amortised path must land in exactly the same place the synchronous
	# one does -- or the optimisation has changed the world rather than the
	# schedule. BOTH SIDES START FROM A CLEAN REBUILD: comparing the live state
	# against a fresh stream would compare a window plus its KEEP hysteresis
	# against just the window, and report a difference that is only history.
	var where := player.global_position
	deep_space.rebuild()
	deep_space.stream_now(where)
	var sync_cells := deep_space.content_cell_count()
	var sync_obstacles := Obstacles.count()

	deep_space.rebuild()
	await get_tree().process_frame          # _stream registers the window
	while deep_space.build_backlog() > 0:
		await get_tree().process_frame      # the queue dresses it
	print("[stream] SAME WORLD EITHER WAY synchronous %d cells / %d obstacles, amortised %d / %d -> %s" % [
		sync_cells, sync_obstacles, deep_space.content_cell_count(), Obstacles.count(),
		"PASS" if sync_cells == deep_space.content_cell_count() \
			and sync_obstacles == Obstacles.count() else "FAIL"])

	# The registry has to give everything back. A leak here is an invisible wall
	# left in empty space, and it compounds for the whole session.
	var out_there := Obstacles.count()
	player.teleport_to(PlayerShip.SPAWN_POINT)
	await get_tree().process_frame
	await get_tree().process_frame
	print("[stream] REGISTRY RETURNS %d obstacles out there -> %d at home -> %s" % [
		out_there, Obstacles.count(), "PASS" if Obstacles.count() < out_there else "FAIL"])

	get_tree().quit()


# --- the world's two responses -----------------------------------------------

func _run_manual_test() -> void:
	# The manual is the one screen whose whole job is to be TRUE. Everything here
	# checks a property rather than a wording: the prose is free to change, the
	# derivations and the pause contract are not.
	var manual := manual_screen
	await get_tree().process_frame

	# --- 1. every entry in the contents opens a real page ---------------------
	# The contents list and the router are the same data, but "the same data"
	# only helps if the router actually has a branch for each id -- a typo in
	# _refresh's match falls through to the default and silently shows the
	# contents again, which reads as a dead button.
	var dead := ""
	for entry_v in ManualScreen.PAGES:
		var id := String((entry_v as Dictionary)["id"])
		manual._page = id
		manual._refresh()
		await get_tree().process_frame
		var head := ""
		for c in manual._body.get_children():
			var l := c as Label
			if l != null and l.text != "":
				head = l.text
				break
		# The contents page's own heading is what a fallen-through id renders.
		if head == "" or head == "PILOT'S MANUAL":
			dead = id
	print("[manual] EVERY ENTRY OPENS A PAGE %d entries, none falls through to the contents (%s) -> %s" % [
		ManualScreen.PAGES.size(), dead if dead != "" else "none",
		"PASS" if dead == "" and ManualScreen.PAGES.size() > 0 else "FAIL"])

	# --- 2. it never touches the pause state ---------------------------------
	# THE load-bearing property. It opens over the title screen (running) and
	# over the pause sheet (stopped), so a node that paused on open would freeze
	# the title and one that unpaused on close would resume the game out from
	# under the pause menu. Checked from BOTH states, because a bug that only
	# appears in one of them is exactly what a single-state check misses.
	var pause_drift := ""
	for want_paused in [false, true]:
		get_tree().paused = bool(want_paused)
		manual.open()
		await get_tree().process_frame
		if get_tree().paused != bool(want_paused):
			pause_drift = "open() changed it from %s" % str(want_paused)
		manual.close_panel()
		await get_tree().process_frame
		if get_tree().paused != bool(want_paused):
			pause_drift = "close_panel() changed it from %s" % str(want_paused)
	get_tree().paused = false
	print("[manual] NEVER TOUCHES PAUSE opened and closed from both a running and a stopped tree (%s) -> %s" % [
		pause_drift if pause_drift != "" else "unchanged both ways",
		"PASS" if pause_drift == "" else "FAIL"])

	# --- 3. cancel backs out exactly one step --------------------------------
	# The same ladder rule the rest of the game follows, and the reason
	# pause_menu._unhandled_input carries an explicit guard: _unhandled_input is
	# delivered in TREE order, so the manual's higher CanvasLayer buys it drawing
	# priority and no input priority at all.
	manual.open()
	manual._page = String(ManualScreen.PAGES[0]["id"])
	var esc := InputEventAction.new()
	esc.action = "cancel"
	esc.pressed = true
	manual._unhandled_input(esc)
	var backed_to_contents: bool = manual._page == "contents" and manual.is_open
	manual._unhandled_input(esc)
	var closed: bool = not manual.is_open
	var still_running: bool = not get_tree().paused
	print("[manual] CANCEL BACKS OUT ONE STEP section->contents=%s, contents->closed=%s, game not resumed under it=%s -> %s" % [
		str(backed_to_contents), str(closed), str(still_running),
		"PASS" if backed_to_contents and closed and still_running else "FAIL"])

	# --- 4. the page agrees with the data ------------------------------------
	# HONEST ABOUT ITS REACH: this is a DRIFT detector, not a hardcode detector.
	# It cannot tell a derived 12 from a typed 12 today, because both render the
	# same glyphs -- but the day REACTOR_TIERS or the ore table moves, a typed
	# number stops agreeing and this goes red, which is the failure that actually
	# costs a player something. Assertion 6 below is the one that proves a
	# derivation outright, on the one input that can be changed at runtime.
	manual.open()
	manual._page = "ship"
	manual._refresh()
	await get_tree().process_frame
	var before_text := _manual_text(manual)
	var real_power := ModuleDB.reactor_power(0)
	var mentions_power: bool = before_text.contains(str(real_power))
	# v24: the SHIP'S slot count, not the catalog's. The manual prints what this
	# pilot has, and a berthed pilot has more -- so a check against SLOT_NAMES
	# would demand the manual promise nine slots to a pilot who owns six.
	var mentions_slots: bool = before_text.contains(str(GameState.open_slots().size()))
	manual._page = "deep"
	manual._refresh()
	await get_tree().process_frame
	var deep_text := _manual_text(manual)
	var names_all_bands := true
	for band_name in DeepSpace.BAND_NAMES:
		if not deep_text.contains(String(band_name)):
			names_all_bands = false
	manual._page = "living"
	manual._refresh()
	await get_tree().process_frame
	var living_text := _manual_text(manual)
	var mentions_ore: bool = living_text.contains(str(CommodityDB.ore_ids().size()))
	print("[manual] THE NUMBERS ARE DERIVED reactor %d=%s, %d slots=%s, all %d bands named=%s, %d ores=%s -> %s" % [
		real_power, str(mentions_power), GameState.open_slots().size(), str(mentions_slots),
		DeepSpace.BAND_NAMES.size(), str(names_all_bands),
		CommodityDB.ore_ids().size(), str(mentions_ore),
		"PASS" if mentions_power and mentions_slots and names_all_bands and mentions_ore else "FAIL"])

	# --- 6. the legend recolours with the HUD it explains --------------------
	# The one input here that CAN be changed at runtime, so the one place a
	# derivation can be proved outright rather than inferred. It matters on its
	# own terms too: a player on a colour-vision mode sees a recoloured band on
	# the HUD, and a manual still printing the default palette would be teaching
	# them the wrong colour for the thing in front of them.
	var vision_before := Palette.vision
	manual.open()
	manual._page = "deep"
	manual._refresh()
	await get_tree().process_frame
	var swatches_normal := _manual_swatches(manual)
	Palette.vision = Palette.Vision.DEUTAN
	manual._refresh()
	await get_tree().process_frame
	var swatches_mode := _manual_swatches(manual)
	Palette.vision = vision_before
	var moved := 0
	for i in range(mini(swatches_normal.size(), swatches_mode.size())):
		if Color(swatches_normal[i]) != Color(swatches_mode[i]):
			moved += 1
	manual.close_panel()
	print("[manual] THE LEGEND FOLLOWS THE PALETTE %d swatches, %d recoloured under a colour-vision mode -> %s" % [
		swatches_normal.size(), moved,
		"PASS" if swatches_normal.size() > 0 and moved > 0 else "FAIL"])

	# --- 5. the clamp does its job, in BOTH directions -----------------------
	# NOT written as `panel <= viewport`, and that is the whole point of this
	# assertion existing. STRATEGY §36 records that SHEET FITS is shaped exactly
	# that way and is therefore structurally incapable of failing: the clamp
	# guarantees the value it measures. Written that way here it was worse -- with
	# _clamp_height() deleted outright the sheet COLLAPSED to 32 rows and the
	# check still passed, because a collapsed sheet fits a viewport beautifully.
	#
	# So it states what the clamp is actually for: the scroll viewport must be
	# exactly min(content, available). Too tall fails it, and so does collapsed.
	# MEASURED WITH THE SHEET OPEN, because section 6 above closes it and a
	# closed panel keeps whatever rect it last had. That is what failed here: the
	# 569 rows reported against a 512 window were the DEEP page's height from
	# section 6 at 720x1280, not anything this block laid out — _refresh() on a
	# hidden panel updates the scroll's minimum size (which is why the viewport
	# half of this clause stayed exact) while _panel.size.y goes nowhere.
	#
	# Which half is which: the VIEWPORT equality is the teeth — it fails on a
	# sheet that is too tall AND on one that collapsed, which is the whole reason
	# 36 rejected `panel <= viewport`. The panel-height bound is a sanity
	# readout beside it, and it is only meaningful at all when the thing it
	# measures has been laid out.
	get_window().size = Vector2i(1440, 900)
	GameState.set_setting("ui_scale", 1.6)
	manual.open()
	await get_tree().process_frame
	await get_tree().process_frame
	var worst := 0.0
	var worst_page := ""
	var clamp_wrong := ""
	for entry_v in ManualScreen.PAGES:
		manual._page = String((entry_v as Dictionary)["id"])
		manual._refresh()
		await get_tree().process_frame
		await get_tree().process_frame
		var avail_scroll := maxf(manual._root.size.y - ManualScreen.SHEET_MARGIN,
			ManualScreen.MIN_SHEET)
		var content_h := manual._body.get_combined_minimum_size().y
		var want := minf(content_h, avail_scroll)
		var got := manual._scroll.custom_minimum_size.y
		if absf(got - want) > 1.0:
			clamp_wrong = "%s: viewport %.0f, wanted min(content %.0f, room %.0f)" % [
				manual._page, got, content_h, avail_scroll]
		var h: float = manual._panel.size.y
		if h > worst:
			worst = h
			worst_page = manual._page
	var avail: float = manual._root.size.y
	manual.close_panel()
	print("[manual] THE CLAMP HOLDS worst page '%s' is %.0f rows of %.0f, every page's viewport = min(content, room) (%s) -> %s" % [
		worst_page, worst, avail, clamp_wrong if clamp_wrong != "" else "exact on all pages",
		"PASS" if worst <= avail and clamp_wrong == "" else "FAIL"])

	# THE MANUAL IS TRUE TO THE DEVICE AND TO THE HUD. Two sweeps, one claim:
	# nothing a desktop player can read may name a gesture they cannot make,
	# and every readout and radar tier must be documented somewhere.
	#
	# The device half caught a real one: the ship's VERY FIRST sentence told
	# desktop players to tap a bearing, on a build where mouse-to-touch
	# emulation is deliberately off and tapping does nothing at all. Swept over
	# every bark rather than the one line somebody remembered to check.
	var taps := ""
	if not DisplayServer.is_touchscreen_available():
		for k_v in Barks.LINES:
			if Barks.line_for(String(k_v)).findn("tap") >= 0:
				taps += "%s " % String(k_v)
	# The HUD half: coverage, not copy. TIER_NAMES is the radar's own list, so
	# a tier added without a legend row fails here naming the tier.
	manual.open()
	# _page + _refresh(), the navigation every other assertion in this harness
	# uses. There is no _show_page() -- calling one stalled the whole suite
	# rather than failing loudly, which is its own small lesson about reaching
	# into a console by a name nobody checked.
	manual._page = "hud"
	manual._refresh()
	await get_tree().process_frame
	var undocumented := ""
	# v21: CRS joins the list with the row it names. A readout added to the
	# cockpit without an entry here is undocumented UI, which is the whole thing
	# this sweep exists to refuse -- and the list is hand-written, so it only
	# refuses what somebody remembered to add. Adding the readout and the check
	# in one commit is the only thing that keeps that honest.
	for want_v in ["SALVAGE", "HOLD", "HULL", "HDG", "CRS"] + HUD.RadarLayer.TIER_NAMES:
		if not _panel_text_contains(manual, String(want_v)):
			undocumented += "%s " % String(want_v)
	manual.close_panel()
	print("[manual] THE MANUAL IS TRUE TO THE DEVICE AND TO THE HUD gestures a desktop cannot make: %s; readouts and tiers with no entry: %s -> %s" % [
		taps if taps != "" else "none", undocumented if undocumented != "" else "none",
		"PASS" if taps == "" and undocumented == "" else "FAIL"])

	# AND TRUE TO THE ESCAPE LADDER, which the sweep above does not cover because
	# it checks vocabulary and coverage rather than a count. The FLYING page
	# numbers CameraRig._cancel's rungs in prose, and a rung was added at the top
	# of that function while the page went on saying "1. a console is open" --
	# false about the first thing Escape now does, and green through a full
	# sweep. Counted from the page rather than asserted as a literal, so the next
	# rung added to _cancel fails here instead of shipping a wrong number.
	manual.open()
	manual._page = "flying"
	manual._refresh()
	await get_tree().process_frame
	var ladder := 0
	for i in range(1, 9):
		if _panel_text_contains(manual, "%d.  " % i):
			ladder = i
	# The device decides the length: the contact menu's rung exists only where a
	# right-click can raise one, which is the same question ManualScreen asks.
	var want_rungs := 4 if DisplayServer.is_touchscreen_available() else 5
	var menu_rung := _panel_text_contains(manual, "a contact menu is open")
	var want_menu: bool = not DisplayServer.is_touchscreen_available()
	manual.close_panel()
	print("[manual] THE MANUAL IS TRUE TO THE CANCEL LADDER %d rungs on this device (want %d), names the contact menu=%s (want %s) -> %s" % [
		ladder, want_rungs, str(menu_rung), str(want_menu),
		"PASS" if ladder == want_rungs and menu_rung == want_menu else "FAIL"])
	get_tree().quit()


func _manual_swatches(manual: ManualScreen) -> Array:
	# Every legend chip on the page, in order. ColorRect rather than Label, so it
	# reads the colour the player actually sees rather than the name beside it.
	var out: Array = []
	_swatches_under(manual._body, out)
	return out


func _swatches_under(node: Node, out: Array) -> void:
	for c in node.get_children():
		var r := c as ColorRect
		if r != null:
			out.append(r.color)
		_swatches_under(c, out)


func _manual_text(manual: ManualScreen) -> String:
	# Every Label on the page, flattened. Recursive because _row and _legend both
	# nest their text inside a container.
	return _labels_under(manual._body)


func _labels_under(node: Node) -> String:
	var out := ""
	for c in node.get_children():
		var l := c as Label
		if l != null:
			out += l.text + "\n"
		out += _labels_under(c)
	return out


func _run_env_test() -> void:
	# The lighting model and the landmark pass. Both are about the same claim:
	# that the expanse is designed rather than uniform, and that the two axes the
	# game is about are visible in it.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	# Same two lines PYXIS_MUSICTEST needs and for the same reason: waves keep
	# refilling the system, and arriving in an already-breached system arms the
	# apex -- a live engine is a threat by definition, which is correct and would
	# otherwise pin the lighting to "in a fight" for the whole harness.
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.4).timeout

	var air := get_tree().get_first_node_in_group("atmosphere") as Atmosphere
	print("[env] ATMOSPHERE BOUND one owner for the Environment, present=%s -> %s" % [
		str(air != null), "PASS" if air != null else "FAIL"])

	# --- 1. depth is visible -------------------------------------------------
	var edge := chart_edge()
	var seen: Array = []
	for units in [0.0, 160.0, 440.0, 1100.0]:
		player.teleport_to(Vector3(0.0, 0.0, edge + units + 1.0))
		await get_tree().create_timer(2.2).timeout
		seen.append(snappedf(air.depth_level(), 0.01))
	var rising := true
	for i in range(seen.size() - 1):
		if float(seen[i + 1]) < float(seen[i]) - 0.001:
			rising = false
	print("[env] DEPTH LIGHTING level at [0, 160, 440, 1100]u = %s, monotonic=%s, spans=%s -> %s" % [
		str(seen), str(rising), str(float(seen[0]) < 0.05 and float(seen[3]) > 0.9),
		"PASS" if rising and float(seen[0]) < 0.05 and float(seen[3]) > 0.9 else "FAIL"])

	# The sky must actually change, not just the number. Asserted against the
	# live Environment, because a level that moves while nothing renders
	# differently is a level that is not wired to anything.
	var we := _find_world_env(system_root)
	var deep_glow := we.environment.glow_intensity if we else -1.0
	player.teleport_to(PlayerShip.SPAWN_POINT)
	await get_tree().create_timer(2.5).timeout
	var home_glow := we.environment.glow_intensity if we else -1.0
	print("[env] SKY RESPONDS glow %.3f in THE QUIET vs %.3f at home -> %s" % [
		deep_glow, home_glow, "PASS" if we != null and deep_glow < home_glow else "FAIL"])

	# --- 2. threat is visible, and does not fight depth ----------------------
	# Driven by an ACTUAL HOSTILE, not by calling set_threat. main polls the threat
	# every frame and pushes it at Atmosphere, so a hand-set value is overwritten
	# on the next frame -- the first version of this measured a 0.004 wobble and
	# called it a pass. Spawning the contact also covers the wiring: the poll, the
	# radius test, and the easing.
	# The baseline has to be genuinely calm, and at the spawn point it is not:
	# PYX-01 has sentries standing inside THREAT_RADIUS, so the first version of
	# this measured a glow that was ALREADY lifted and then compared it against
	# itself. Clear the field and let the slow fall finish first.
	for n in get_tree().get_nodes_in_group("hostiles"):
		n.queue_free()
	await get_tree().create_timer(4.0).timeout
	var calm_glow := we.environment.glow_intensity
	var quiet_first: bool = not _threat_near_player()
	var bogey := SwarmHostile.new()
	bogey.difficulty = 0.0
	bogey.hp_scale = 40.0
	system_root.add_child(bogey)
	bogey.global_position = player.global_position + Vector3(0, 0, Music.THREAT_RADIUS * 0.4)
	bogey.dock_at(bogey.global_position)
	await get_tree().create_timer(1.5).timeout
	var hot_glow := we.environment.glow_intensity
	bogey.queue_free()
	await get_tree().create_timer(4.0).timeout
	var cooled := we.environment.glow_intensity
	# A real lift, not a rounding wobble: THREAT_GLOW_LIFT is 30%, so anything
	# under a few percent means the signal never reached the Environment.
	var lifted: bool = hot_glow > calm_glow * 1.05
	print("[env] THREAT LIGHTING calm field=%s, glow %.3f -> %.3f -> %.3f (lifts >5%% then returns) -> %s" % [
		str(quiet_first), calm_glow, hot_glow, cooled,
		"PASS" if quiet_first and lifted and absf(cooled - calm_glow) < 0.02 else "FAIL"])

	# Asymmetric on purpose, and in the same direction as the score's: a threat
	# arrives faster than it leaves, because a fight starts on one frame and ends
	# raggedly over several.
	print("[env] THREAT IS ASYMMETRIC rise %.1f > fall %.1f -> %s" % [
		Atmosphere.THREAT_RISE, Atmosphere.THREAT_FALL,
		"PASS" if Atmosphere.THREAT_RISE > Atmosphere.THREAT_FALL else "FAIL"])

	# --- 3. landmarks are placed, not scattered ------------------------------
	# One per supercell, deterministic, and none in charted space.
	var counts := {}
	var total := 0
	for sx in range(0, 8):
		for sz in range(0, 8):
			var cell := DeepSpace.landmark_cell(system_id, sx, sz)
			# Deterministic: the same supercell must elect the same cell twice.
			if DeepSpace.landmark_cell(system_id, sx, sz) != cell:
				counts["nondeterministic"] = true
			if DeepSpace.supercell_of(cell.x, cell.y) != Vector2i(sx, sz):
				counts["outside"] = true
			var plan := deep_space.plan_cell(cell.x, cell.y)
			var mark: Dictionary = plan.get("landmark", {})
			if not mark.is_empty():
				total += 1
				counts[String(mark["kind"])] = int(counts.get(String(mark["kind"]), 0)) + 1
	print("[env] LANDMARK PLACEMENT %d across 64 supercells, kinds %s, elected cell inside its own supercell=%s -> %s" % [
		total, str(counts), str(not counts.has("outside")),
		"PASS" if total > 0 and not counts.has("outside") and not counts.has("nondeterministic") else "FAIL"])

	# At most one per supercell -- that is the whole reason for the second scale.
	var doubled := false
	for sx in range(0, 6):
		for sz in range(0, 6):
			var found := 0
			for dx in range(DeepSpace.SUPERCELL):
				for dz in range(DeepSpace.SUPERCELL):
					var c := Vector2i(sx * DeepSpace.SUPERCELL + dx, sz * DeepSpace.SUPERCELL + dz)
					if not (deep_space.plan_cell(c.x, c.y).get("landmark", {}) as Dictionary).is_empty():
						found += 1
			if found > 1:
				doubled = true
	print("[env] ONE PER SUPERCELL no supercell carries two=%s -> %s" % [
		str(not doubled), "PASS" if not doubled else "FAIL"])

	# Charted space gets none: a landmark inside the survey volume is a landmark
	# on a map that already has one.
	var in_chart := false
	for c in range(0, 3):
		if not (deep_space.plan_cell(c, c).get("landmark", {}) as Dictionary).is_empty():
			in_chart = true
	print("[env] NONE IN CHARTED SPACE band 0 carries no landmark=%s -> %s" % [
		str(not in_chart), "PASS" if not in_chart else "FAIL"])

	# Each band gets its OWN silhouette. A second tell that is also colour tells
	# you nothing new, which is the same argument as the HUD's band glyphs.
	var kinds := {}
	for band in range(1, DeepSpace.LANDMARKS.size()):
		var built := Landmarks.build(String(DeepSpace.LANDMARKS[band]), band)
		if built != null:
			kinds[String(DeepSpace.LANDMARKS[band])] = built.get_child_count()
			built.queue_free()
	print("[env] BAND SILHOUETTES %s distinct kinds, all build=%s -> %s" % [
		str(kinds), str(kinds.size() == DeepSpace.LANDMARKS.size() - 1),
		"PASS" if kinds.size() == DeepSpace.LANDMARKS.size() - 1 else "FAIL"])

	# --- v19 stage 4: THE LANDMARKS DID NOT TURN -----------------------------
	# The per-system kind pick is gated on row presence and salted on its own
	# stream, so it must consume NOTHING from landmark_at's shared rng — whose
	# only draw is rot_y. Self-deriving rather than pinned: an authored-def
	# probe and a stripped-def probe of the SAME system must agree on every
	# rotation (a kind draw inserted before rot_y shears them apart), and must
	# DISAGREE on at least one kind (or the weights are dead code). No recorded
	# literals, so a re-authored weight row cannot orphan this check.
	#
	# Nothing else in the 57 runs can see this defect: the fingerprint hashes no
	# landmark field, and the checks above ask kinds and election, never
	# rotation. Red-verified by moving the kind roll onto the shared rng before
	# rot_y — every compared rotation shifts.
	var lm_real := DeepSpace.new()
	lm_real.generating = false
	add_child(lm_real)
	lm_real.configure(SystemDB.get_system("pyx02"), "pyx02")
	var lm_def: Dictionary = SystemDB.get_system("pyx02").duplicate(true)
	lm_def.erase("deep")
	var lm_bare := DeepSpace.new()
	lm_bare.generating = false
	add_child(lm_bare)
	lm_bare.configure(lm_def, "pyx02")
	var rot_same := true
	var kind_diffs := 0
	var lm_seen := 0
	for sx in range(-4, 5):
		for sz in range(-4, 5):
			var lc := DeepSpace.landmark_cell("pyx02", sx, sz)
			var lband := DeepSpace.band_of(lm_real.depth_at(
				Vector3(float(lc.x) * DeepSpace.CELL + DeepSpace.CELL * 0.5, 0.0,
					float(lc.y) * DeepSpace.CELL + DeepSpace.CELL * 0.5)))
			var la := lm_real.landmark_at(lc.x, lc.y, lband)
			var lb := lm_bare.landmark_at(lc.x, lc.y, lband)
			if la.is_empty() or lb.is_empty():
				continue
			lm_seen += 1
			if absf(float(la["rot_y"]) - float(lb["rot_y"])) > 0.0001:
				rot_same = false
			if String(la["kind"]) != String(lb["kind"]):
				kind_diffs += 1
	lm_real.free()
	lm_bare.free()
	print("[env] THE LANDMARKS DID NOT TURN %d pyx02 landmarks weighted vs stripped: every rotation identical=%s, kinds differ on %d (0 = weights are dead code) -> %s" % [
		lm_seen, str(rot_same), kind_diffs,
		"PASS" if lm_seen >= 8 and rot_same and kind_diffs > 0 else "FAIL"])

	# THE WORLD DOES NOT SPIN UNDER THE COMPASS. The cartography lattice looks
	# exactly like a compass rose -- eight radial spokes on a ring -- and it
	# used to turn a full revolution every 240 seconds. That was harmless while
	# nothing in the game claimed a fixed north; beside a HDG readout it is the
	# world contradicting the instrument, and a player navigating by the spokes
	# drifts a degree and a half every second with nothing to tell them.
	#
	# Two seconds at the old rate is about three degrees of drift, so the bar
	# here is two orders of magnitude tighter than the bug.
	var lat := get_tree().get_first_node_in_group("lattice") as Node3D
	var spin_before := lat.rotation.y if lat != null else 0.0
	await get_tree().create_timer(2.0).timeout
	var spin_after := lat.rotation.y if lat != null else 0.0
	var spin_drift := absf(spin_after - spin_before)
	print("[env] THE WORLD DOES NOT SPIN UNDER THE COMPASS lattice found=%s, drift over 2s %.5f rad (old rate would be ~0.052) -> %s" % [
		str(lat != null), spin_drift,
		"PASS" if lat != null and spin_drift < 0.001 else "FAIL"])

	get_tree().quit()


func _find_world_env(n: Node) -> WorldEnvironment:
	for c in n.get_children():
		if c is WorldEnvironment:
			return c
		var found := _find_world_env(c)
		if found != null:
			return found
	return null


# --- mining ------------------------------------------------------------------

func _world_fingerprint() -> String:
	# Everything plan_cell produces EXCEPT seams, hashed over a fixed block of
	# cells. This exists to prove one thing: that appending the seam roll did not
	# move a single rock, hulk, nest or station in the game.
	#
	# plan_cell's rolls are one linear RNG sequence, so a draw inserted anywhere
	# but the last line shifts every draw after it and silently reshuffles the
	# whole expanse. The guard/landmark rolls already dodge this by taking their
	# own salted streams; the seam roll must too, and this is what checks it.
	#
	# The constant it is compared against was recorded BEFORE seams existed. A
	# fingerprint taken afterwards would agree with whatever it was given.
	var acc := ""
	for cx in range(-5, 6):
		for cz in range(-5, 6):
			var plan := deep_space.plan_cell(cx, cz)
			acc += "%d,%d|" % [cx, cz]
			for r_v in (plan["rocks"] as Array):
				var r: Dictionary = r_v
				acc += "r%.3f,%.3f,%.3f;" % [r["pos"].x, r["pos"].z, r["scale"].x]
			var h: Dictionary = plan["hulk"]
			if not h.is_empty():
				acc += "h%.3f,%.3f,%.3f,%d;" % [h["pos"].x, h["pos"].z, h["rot_y"], int(h["loot"])]
			var pk: Dictionary = plan["pack"]
			if not pk.is_empty():
				acc += "p%.3f,%.3f,%d;" % [pk["pos"].x, pk["pos"].z, int(pk["count"])]
			var st: Dictionary = plan["station"]
			if not st.is_empty():
				acc += "s%.3f,%.3f,%s;" % [st["pos"].x, st["pos"].z, String(st["archetype"])]
			acc += "\n"
	return str(acc.hash())


# Recorded BEFORE the seam roll existed, by running this harness with only the
# fingerprint line in it. A constant captured afterwards would agree with
# whatever it was given and prove nothing.
const WORLD_FINGERPRINT_BEFORE_SEAMS := "3836096557"


func _clear_faction_matrix() -> void:
	# Between harness sections, NOT reset_to_starter: that rolls a fresh
	# run_seed and tears down cargo, fit and progression to prove a point about
	# diplomacy. Clearing the store is the smallest thing that restores the
	# baseline, and the sparse invariant is what makes it sufficient.
	GameState.faction_deltas = {}
	GameState.faction_version += 1


func _clear_loot_cubes() -> void:
	# free(), not queue_free(): the count on the very next line has to see the
	# cubes gone, and a queued free is still a child when it is read.
	for c in system_root.get_children():
		if c is LootCube:
			c.free()


func _run_faction_test() -> void:
	# HORIZON 4 STAGE 1 — the allegiance layer, which ships with NO new content.
	# Every claim below is about a RULE rather than about a rendering, because
	# stage 1 deliberately changes nothing a player can see: the whole point is
	# that the world after it is bit-identical to the world before it, and the
	# only instrument that can say so is this file.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.3).timeout

	# --- 1. NO INPUT, NO DRIFT ------------------------------------------------
	# The assertion the whole "player actions only" decision rests on. A matrix
	# that can move on a clock is a matrix no harness can defend, so the claim
	# is made in the strongest available form: run real time, tick the world,
	# and require the delta store to still be EMPTY -- which the sparse
	# invariant makes equivalent to "every pair is exactly its baseline".
	GameState.reset_to_starter()
	# reset_to_starter ROLLS A FRESH run_seed from the system clock -- it is the
	# one number in the game that must not be deterministic -- so calling it
	# mid-harness silently un-pins the salt _ready pinned. Nothing below reads a
	# lair, but leaving a harness unpinned is how the next assertion added here
	# inherits a bug it did not cause.
	GameState.run_seed = RUN_SEED_PINNED
	var v_before := GameState.faction_version
	var att_before := GameState.faction_attitude(FactionDB.SURVEYOR, "gsa")
	await get_tree().create_timer(2.0).timeout
	GameState.advance_clock(3600.0)
	await get_tree().create_timer(0.5).timeout
	var no_drift: bool = GameState.faction_deltas.is_empty() \
		and GameState.faction_version == v_before \
		and GameState.faction_attitude(FactionDB.SURVEYOR, "gsa") == att_before
	print("[faction] NO INPUT, NO DRIFT 2.5s live + 1h clock, deltas=%d version moved=%s -> %s" % [
		GameState.faction_deltas.size(), str(GameState.faction_version != v_before),
		"PASS" if no_drift else "FAIL"])

	# --- 2. the baseline IS the shipped world --------------------------------
	# Stage 1's entire safety argument in one line. Every hostile the game
	# spawns today defaults to FERAL, so if FERAL hates the surveyor and nothing
	# else, the targeting rewrite cannot have changed who shoots whom. The
	# second clause is the one that matters: no pair of NPC factions is HOSTILE
	# in a way that any SHIPPED spawner could express, because nothing sets a
	# faction yet.
	var feral_enemies := GameState.enemies_of(FactionDB.FERAL)
	var feral_ok: bool = feral_enemies.size() == 1 \
		and feral_enemies[0] == FactionDB.SURVEYOR
	# WIDENED IN STAGE 2a, and the widening is the point rather than a
	# concession. The original clause was "every live flag is feral", which was
	# the right claim while nothing else flew — but the Cordon now legitimately
	# puts `gsa` pickets in charted space, so that form would fail on correct
	# code forever. The invariant that actually matters survives intact: THE
	# ONLY FLAG IN THE SKY THAT WANTS THE PLAYER DEAD IS STILL FERAL. Adding a
	# faction is allowed; adding a second thing that shoots at you is not, and
	# would be a design decision rather than a side effect.
	var live_flags := {}
	for n_v in get_tree().get_nodes_in_group("combatants"):
		live_flags[String((n_v as Node3D).faction)] = true
	var hostile_flags: Array = []
	for f_v in live_flags:
		var f := String(f_v)
		if not FactionDB.is_faction(f):
			hostile_flags.append("%s(unknown)" % f)
		elif GameState.faction_band(f, FactionDB.SURVEYOR) == FactionDB.Band.HOSTILE:
			hostile_flags.append(f)
	# WIDENED AGAIN IN STAGE 3, and again the widening is the point. The claim
	# was "feral is the only flag that hunts you"; stage 3 handed every ambient
	# machine to its host engine, so feral is no longer in the sky at all. What
	# survives is the property that actually matters, now stated more strongly:
	# EXACTLY ONE FLAG IN CHARTED SPACE WANTS THE PLAYER DEAD, AND IT IS THE
	# SYSTEM'S OWNER. A second would be a design decision, not a side effect.
	var host := SystemDB.faction_of(system_id)
	var one_hunter: bool = hostile_flags.size() == 1 \
		and String(hostile_flags[0]) == host
	# BY BAND, which is what keeps this true after v18's playtest round 4. A
	# provoked machine hunts the player too, but on a per-node grudge with an
	# expiry rather than on its flag — so the claim this line makes is about
	# which FLAG owns the system, and a grudge cannot add one.
	print("[faction] ONE FLAG HUNTS YOU, AND IT OWNS THE SYSTEM %s host=%s, live flags %s, hostile-to-player %s -> %s" % [
		system_id, host, str(live_flags.keys()), str(hostile_flags),
		"PASS" if feral_ok and one_hunter else "FAIL"])

	# --- 3. targeting honours the table --------------------------------------
	# Driven through the real target selector on a real node at every band,
	# not through a reimplementation of it. A sentry is flagged into each band
	# in turn and asked who it would shoot; only HOSTILE may answer "the
	# player". Restored to FERAL afterwards so nothing downstream inherits it.
	var probe_sentry := Hostile.new()
	probe_sentry.difficulty = 1.0
	system_root.add_child(probe_sentry)
	probe_sentry.global_position = player.global_position + Vector3(3.0, 0, 0)
	await get_tree().process_frame
	var band_rows: Array = []
	var band_ok := true
	for row in [["gsa", 0], ["bastion", 0], ["combine", 0], ["feral", 1]]:
		probe_sentry.faction = String(row[0])
		probe_sentry._enemies_version = -1          # force the cache to re-ask
		probe_sentry._target = null
		probe_sentry._aggro = null
		probe_sentry._retarget_t = 0.0
		var picked: Node3D = probe_sentry._combat_target(0.0)
		var shoots := 1 if (picked != null and picked.is_in_group("player")) else 0
		band_rows.append("%s:%s=%d" % [row[0],
			FactionDB.BAND_NAMES[GameState.faction_band(String(row[0]), FactionDB.SURVEYOR)],
			shoots])
		if shoots != int(row[1]):
			band_ok = false
	print("[faction] TARGETING HONOURS THE TABLE %s (1 = would fire on the player) -> %s" % [
		str(band_rows), "PASS" if band_ok else "FAIL"])

	# --- 4. docked is still safe ---------------------------------------------
	# The one rule that outranks the matrix AND aggro. Asserted against a
	# genuinely hostile sentry that has already been shot by the player, which
	# is the case a naive aggro implementation gets wrong.
	probe_sentry.faction = FactionDB.FERAL
	probe_sentry._enemies_version = -1
	probe_sentry.take_damage(1.0, player)           # give it a grudge
	var aggro_holds: bool = probe_sentry._combat_target(0.0) == player
	player.docked = true
	probe_sentry._retarget_t = 0.0
	var while_docked: Node3D = probe_sentry._combat_target(0.0)
	player.docked = false
	# Reported from the value CAPTURED while docked, never re-measured in the
	# print: undocking happens on the line above, so a second call would answer
	# a different question and print "safe" for a sentry that was not.
	print("[faction] DOCKED IS STILL SAFE aggro before dock=%s, target while docked=%s -> %s" % [
		str(aggro_holds), "none" if while_docked == null else String(while_docked.name),
		"PASS" if aggro_holds and while_docked == null else "FAIL"])

	# --- 5. an NPC kill pays nothing, and a player kill still does -----------
	# BOTH DIRECTIONS, in one measurement, because either half alone is a test
	# that passes on broken code: "NPC kills pay nothing" is satisfied by an
	# economy that pays nobody, and "player kills pay" is satisfied by one that
	# pays everybody. The two are measured against the same counters.
	# Counted EXACTLY rather than compared loosely, and counted on the next
	# frame rather than after a settle: SwarmHostile._die spills synchronously,
	# and a cube older than 0.35s starts flying at the player -- so a harness
	# that waits is racing a magnet and measuring collection, not attribution.
	# LOOT_COUNT is read from the class so the expected number cannot drift
	# from the one the game actually uses.
	# A ONE-ELEMENT ARRAY, not an int, and the reason is a GDScript rule that
	# has silently defeated counters like this before: a lambda captures a local
	# by VALUE, so `kills += 1` inside one increments a copy and the outer
	# variable reads 0 forever — an assertion that can only ever say "no kills
	# were credited", which is exactly the answer half this check wants to hear.
	# An Array is captured by reference, so mutating its contents is visible.
	var kills_seen := [0]
	var tally := func(_kind: String) -> void: kills_seen[0] += 1
	hostile_killed.connect(tally)

	var victim_a := SwarmHostile.new()
	system_root.add_child(victim_a)
	victim_a.global_position = player.global_position + Vector3(9.0, 0, 9.0)
	await get_tree().process_frame
	_clear_loot_cubes()
	victim_a.take_damage(99999.0, probe_sentry)     # machine kills machine
	await get_tree().process_frame
	var loot_npc := _count_loot_cubes()
	var kills_npc: int = kills_seen[0]
	_clear_loot_cubes()

	var victim_b := SwarmHostile.new()
	system_root.add_child(victim_b)
	victim_b.global_position = player.global_position + Vector3(9.0, 0, -9.0)
	await get_tree().process_frame
	victim_b.take_damage(99999.0, player)           # the player kills one
	await get_tree().process_frame
	var loot_player := _count_loot_cubes()
	var kills_player: int = kills_seen[0] - kills_npc
	hostile_killed.disconnect(tally)
	_clear_loot_cubes()

	var npc_paid_nothing: bool = loot_npc == 0 and kills_npc == 0
	var player_paid: bool = loot_player == SwarmHostile.LOOT_COUNT and kills_player == 1
	print("[faction] ATTRIBUTION GATES THE PAYOUT npc kill: %d cubes %d credit | player kill: %d cubes (want %d) %d credit -> %s" % [
		loot_npc, kills_npc, loot_player, SwarmHostile.LOOT_COUNT, kills_player,
		"PASS" if npc_paid_nothing and player_paid else "FAIL"])

	if is_instance_valid(probe_sentry):
		probe_sentry.queue_free()

	# --- 6. no caller may guess who is shooting ------------------------------
	# Finding A1 as a STATIC assertion, because the dynamic one cannot see a
	# call site that is never exercised. Both hostile classes declare
	# take_damage with a REQUIRED attacker, so a caller that forgets the
	# argument is a parse error rather than a silent mis-booking -- and this
	# line fails the moment somebody "helpfully" adds a default to make a new
	# call site compile.
	var required_arg := true
	var sig_seen: Array = []
	for path in ["res://scripts/hostile.gd", "res://scripts/swarm_hostile.gd"]:
		var src := FileAccess.get_file_as_string(path)
		var idx := src.find("func take_damage(")
		var sig := src.substr(idx, src.find(")", idx) - idx + 1) if idx >= 0 else "<absent>"
		sig_seen.append(sig)
		if idx < 0 or sig.find("attacker: Node3D)") < 0:
			required_arg = false
	print("[faction] ATTRIBUTION IS EXPLICIT %s -> %s" % [
		str(sig_seen), "PASS" if required_arg else "FAIL"])

	# --- 7. the matrix is bounded --------------------------------------------
	# One act may not flip an alliance. The strongest single shift any stage may
	# author is asserted to be smaller than a band, so standing is an arc rather
	# than a switch -- and the store is asserted to CLAMP rather than to grow,
	# so no amount of repetition can produce an unbounded save.
	_clear_faction_matrix()
	for i in range(200):
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", 5)
	var pushed := int(GameState.faction_deltas.get(
		FactionDB.pair_key(FactionDB.SURVEYOR, "grin"), 0))
	var att_max := GameState.faction_attitude(FactionDB.SURVEYOR, "grin")
	for i in range(400):
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", -5)
	var pulled := int(GameState.faction_deltas.get(
		FactionDB.pair_key(FactionDB.SURVEYOR, "grin"), 0))
	var bounded: bool = pushed == FactionDB.DELTA_SPAN and pulled == -FactionDB.DELTA_SPAN \
		and att_max <= FactionDB.ATTITUDE_MAX \
		and GameState.faction_attitude(FactionDB.SURVEYOR, "grin") >= FactionDB.ATTITUDE_MIN
	print("[faction] DELTAS ARE BOUNDED 200 pushes -> %d (cap %d), 400 pulls -> %d, attitude %d..%d -> %s" % [
		pushed, FactionDB.DELTA_SPAN, pulled, FactionDB.ATTITUDE_MIN, FactionDB.ATTITUDE_MAX,
		"PASS" if bounded else "FAIL"])

	# --- 8. the Authority never fires on the surveyor ------------------------
	# The one authored floor (HORIZON-4 §2), asserted in the form that matters:
	# not "the number is >= -3" but "no amount of STANDING makes a Cordon picket
	# target the player". Driven through the real selector, both directions of
	# the pair, after the worst grudge the mutator allows.
	#
	# THE WORD MOVED, AND SAYING SO IS THE POINT. This comment used to claim "no
	# amount of hostility", and v18's playtest round 4 made that false for one
	# meaning of the word: a picket the player SHOOTS answers, and so do its
	# neighbours. That is aggro, per-node and expiring, and it touches no band —
	# which is exactly why this line still passes and why it must now name the
	# distinction rather than imply the stronger claim. The grudge half is
	# asserted separately (SHOOTING A NEUTRAL BRINGS ITS FRIENDS, and A GRUDGE
	# LAPSES AND LETS GO); this one owns the matrix half, and the probe below is
	# deliberately a machine that has never been shot at.
	_clear_faction_matrix()
	for i in range(200):
		GameState.shift_faction(FactionDB.SURVEYOR, "gsa", -5)
	var cordon := Hostile.new()
	cordon.faction = "gsa"
	system_root.add_child(cordon)
	cordon.global_position = player.global_position + Vector3(2.0, 0, 0)
	await get_tree().process_frame
	cordon._enemies_version = -1
	# NOT THE PLAYER — not "no target at all". Since stage 3 the system is full
	# of gnomon sentries a picket may legitimately be shooting at, and asserting
	# emptiness would fail on correct code while saying nothing about the floor.
	var cordon_target: Node3D = cordon._combat_target(0.0)
	var aims_at_player: bool = cordon_target != null \
		and cordon_target.is_in_group("player")
	var floor_holds: bool = not aims_at_player \
		and GameState.faction_band("gsa", FactionDB.SURVEYOR) != FactionDB.Band.HOSTILE \
		and GameState.faction_band(FactionDB.SURVEYOR, "gsa") != FactionDB.Band.HOSTILE
	print("[faction] THE CORDON NEVER FIRES ON THE SURVEYOR after 200 hostile acts band=%s, picket target=%s -> %s" % [
		FactionDB.BAND_NAMES[GameState.faction_band("gsa", FactionDB.SURVEYOR)],
		"none" if cordon_target == null else ("THE PLAYER" if aims_at_player else "a machine"),
		"PASS" if floor_holds else "FAIL"])
	cordon.queue_free()

	# --- 9. the load path rejects rubbish ------------------------------------
	# The seams_cut/warehouse posture: a hand-edited file arrives as valid state
	# or not at all. Four separate attacks in one fixture -- an unknown faction,
	# a self-pair, a non-canonical key ordering (the same pair under a second
	# name, which is how a symmetric store grows an asymmetry), and an
	# out-of-range value.
	_clear_faction_matrix()
	GameState._load_faction_deltas({
		"grin|surveyor": 3,             # canonical: g < s, kept
		"surveyor|grin": -9,            # SAME PAIR, wrong order: must be dropped
		"nosuch|gsa": 4,                # unknown faction: dropped
		"gsa|gsa": 6,                   # self-pair: dropped
		"bastion|gsa": 9999,            # clamped, not rejected
		"embers|gsa": 0,                # zero is absence: must not be stored
		"malformed": 2,                 # not a pair at all
	})
	var kept_keys: Array = GameState.faction_deltas.keys()
	kept_keys.sort()
	var clamped := int(GameState.faction_deltas.get("bastion|gsa", 0))
	var load_ok: bool = kept_keys.size() == 2 \
		and GameState.faction_deltas.has("grin|surveyor") \
		and int(GameState.faction_deltas["grin|surveyor"]) == 3 \
		and clamped == FactionDB.DELTA_SPAN
	print("[faction] THE MATRIX REJECTS RUBBISH 7 entries in (unknown, self-pair, reversed key, 0, malformed), kept %s clamped=%d -> %s" % [
		str(kept_keys), clamped, "PASS" if load_ok else "FAIL"])

	# --- 10. every faction id round-trips as a save key ----------------------
	# Ids are permanent save keys, so the roster and the baseline have to agree
	# about what exists. Cheap, and it is the check that catches a typo'd id in
	# BASELINE pointing at a faction nobody ever added.
	var unknown_refs: Array = []
	for a_v in FactionDB.BASELINE:
		if not FactionDB.is_faction(String(a_v)):
			unknown_refs.append(String(a_v))
		for b_v in (FactionDB.BASELINE[a_v] as Dictionary):
			if not FactionDB.is_faction(String(b_v)):
				unknown_refs.append("%s->%s" % [a_v, b_v])
	print("[faction] THE ROSTER IS CLOSED %d factions, %d baseline refs to nothing %s -> %s" % [
		FactionDB.ids().size(), unknown_refs.size(), str(unknown_refs),
		"PASS" if unknown_refs.is_empty() else "FAIL"])

	# --- 11. THE CORDON STOPS AT THE MARKER ----------------------------------
	# The band-1 beacon has promised since v13 that "security patrols do not
	# operate beyond this marker", DEEPTEST pins the words, and this is the
	# clause that makes the words true of SHIPS. Checked over the AUTHORED
	# TABLE rather than over built nodes: it fires on the authoring mistake,
	# before a picket exists, which is strictly earlier than a runtime clamp
	# (which would drag the picket home and hide the error) could manage.
	var outside: Array = []
	var route_total := 0
	for sid_v in SystemDB.ids():
		var sid := String(sid_v)
		var edge := SystemDB.bounds_of(sid)
		for route_v in SystemDB.get_system(sid).get("patrols", []):
			route_total += 1
			for p_v in (route_v as Array):
				var p: Vector3 = p_v
				if Vector3(p.x, 0.0, p.z).length() >= edge:
					outside.append("%s %s" % [sid, str(p)])
	print("[faction] THE CORDON STOPS AT THE MARKER %d routes across %d systems, %d waypoints past the edge %s -> %s" % [
		route_total, SystemDB.ids().size(), outside.size(), str(outside),
		"PASS" if outside.is_empty() and route_total > 0 else "FAIL"])

	# --- 11b. THE GARRISON IS WHAT THE TUTORIAL HELD BACK ---------------------
	# DRIVEN THROUGH spawn_sentries(), which is the function the tutorial's
	# finale timer actually calls. Every other Cordon assertion in this suite
	# drives SystemBuilder.build() — and that is exactly why this shipped: a new
	# game builds its system with the garrison held back for the guided run and
	# then restores it IN PLACE five seconds after the finale, rather than
	# reloading (a rebuild there would delete the breach loot the player just
	# earned). Stage 2a added pickets to the hold-back and not to the put-back,
	# so a player who pressed NEW SURVEY had no Cordon at all until they warped
	# out of PYX-01 — the headline feature of the horizon, invisible for the
	# whole first session, on the one path every new player takes.
	#
	# BOTH HALVES IN ONE MEASUREMENT, because either alone passes on broken
	# code: "pickets exist afterwards" is satisfied by a garrison that was never
	# suppressed, and "none while suppressed" is satisfied by a Cordon that
	# never deploys at all. The count has to go 0 -> N *through that call*.
	# COLLECTED FIRST, THEN FREED. Mutating a group while iterating it is the
	# other half of the deferred-free trap, and `gar_d` is a second name rather
	# than a reused `gar_n` because a GDScript loop variable scopes to the whole
	# FUNCTION — two `for gar_n in ...` in one function is a parse error, not a
	# shadow (this suite has paid for that lesson four times).
	var gar_doomed: Array = []
	for gar_n in get_tree().get_nodes_in_group("hostiles"):
		gar_doomed.append(gar_n)
	for gar_d in gar_doomed:
		(gar_d as Node).free()      # immediate: queue_free leaves them in the group
	var gar_s0 := _count_sentries()
	var gar_p0 := _count_pickets()
	spawn_sentries()
	await get_tree().process_frame
	var gar_routes: int = (SystemDB.get_system(system_id).get("patrols", []) as Array).size()
	print("[faction] THE GARRISON IS WHAT THE TUTORIAL HELD BACK before spawn_sentries %d sentries / %d pickets, after %d sentries / %d pickets (%d routes authored) -> %s" % [
		gar_s0, gar_p0, _count_sentries(), _count_pickets(), gar_routes,
		"PASS" if gar_s0 == 0 and gar_p0 == 0 and _count_sentries() > 0
			and gar_routes > 0 and _count_pickets() == gar_routes else "FAIL"])

	# --- 12. PICKETS WALK THEIR BEAT -----------------------------------------
	# Driven through the real node over real frames. This is the assertion that
	# catches the assign-vs-add trap in _process: a picket whose position were
	# assigned from the wander term would be overwritten every frame and sit
	# still forever, which reads on screen as "the Cordon is deployed" and is
	# in fact a garrison of statues.
	var beat := Hostile.new()
	beat.faction = "gsa"
	# A route with NOTHING ON IT. Since stage 3 the southern half of PYX-01 is
	# full of gnomon sentries a gsa picket will quite correctly peel off to
	# fight, and a walking test that measures a firefight measures the wrong
	# thing. The nearest authored post to this loop is ~36u away, comfortably
	# outside PATROL_ENGAGE.
	beat.patrol = [Vector3(10, 0, 20), Vector3(20, 0, 20), Vector3(20, 0, 10)] as Array[Vector3]
	system_root.add_child(beat)
	beat.position = Vector3(10, 0, 20)
	await get_tree().process_frame
	# PATH LENGTH, NOT NET DISPLACEMENT. The route is a LOOP, so a picket that
	# walks it perfectly ends up near where it started — this read 15.0u, 4.2u
	# and 1.8u across runs of identical code purely by where in the loop the
	# clock stopped, which is a coin flip dressed as a measurement. Summing the
	# per-sample distance measures the thing the claim is about: it walked.
	var last_at := beat.global_position
	var walked_u := 0.0
	var visited := 0
	var last_i := beat._patrol_i
	# A TIME BUDGET, NOT A FRAME COUNT. Headless Godot runs frames as fast as it
	# can, so `for i in range(360): await process_frame` is an unknown and
	# machine-dependent amount of SIMULATED time — it measured 8u of a 12u leg
	# on the first run and would have been a flake on any other box. The beat is
	# specified in units per second, so the test has to be specified in seconds:
	# a 12u leg at PATROL_SPEED 3.2 takes 3.75s, so 12s covers three of them.
	var walked := 0.0
	while walked < 12.0:
		await get_tree().create_timer(0.1).timeout
		walked += 0.1
		walked_u += last_at.distance_to(beat.global_position)
		last_at = beat.global_position
		if beat._patrol_i != last_i:
			visited += 1
			last_i = beat._patrol_i
	print("[faction] PICKETS WALK THEIR BEAT covered %.1fu of ground and advanced %d waypoints in %.0fs (legs are ~10-14u at %.1fu/s) -> %s" % [
		walked_u, visited, walked, Hostile.PATROL_SPEED,
		"PASS" if walked_u > 12.0 and visited >= 2 else "FAIL"])
	# FREED, and it was not before. This probe carries a route, so every later
	# line in this suite that counts pickets was counting it -- which is the
	# "inherits state from the one above it" shape the README warns about, and it
	# is what a Cordon-strength check added in round 4 tripped over first.
	if is_instance_valid(beat):
		beat.free()

	# --- 13. THE BEAT IS THE ANCHOR ------------------------------------------
	# The property: engage range is measured from the ROUTE, not from the
	# picket. A picket measuring from itself drifts outward along its own
	# engagements, every individual step looking correct while charted space
	# quietly goes unguarded.
	#
	# THE FIRST VERSION OF THIS CHECK PASSED ON BROKEN CODE, and the reason is
	# worth recording because it is this project's recurring failure: a chain of
	# contacts marching away from the route cannot ratchet anything, because
	# _combat_target returns the NEAREST enemy — the picket locks onto the first
	# one and stays there under both implementations. It measured a world in
	# which the bug cannot express itself.
	#
	# The discriminating case is a contact near the MIDDLE OF A LEG and far from
	# both of its endpoints. Route-measuring never engages it; self-measuring
	# engages the moment the picket walks past. Asserted as a PURE FUNCTION call
	# at a placed position rather than over frames: no timing, no flake, and it
	# names the property directly.
	var anchor := Hostile.new()
	anchor.faction = "gsa"
	# A 40u leg. Its midpoint is 20u from either end.
	anchor.patrol = [Vector3(0, 0, -20), Vector3(0, 0, 20)] as Array[Vector3]
	system_root.add_child(anchor)
	anchor.position = Vector3.ZERO
	await get_tree().process_frame
	anchor._patrol_i = 1                      # walking toward (0, 0, 20)
	anchor._enemies_version = -1

	# Mid-leg bait: 10u from the picket standing at the midpoint, but 22.4u from
	# the waypoint it is walking to — outside PATROL_ENGAGE either way you
	# measure the ROUTE, inside it if you measure the PICKET.
	var mid_bait := SwarmHostile.new()
	system_root.add_child(mid_bait)
	mid_bait.global_position = Vector3(10, 0, 0)
	# Control: a contact genuinely near the waypoint, which must be engaged.
	# Without it "returns false" is satisfied by a function that always refuses.
	var post_bait := SwarmHostile.new()
	system_root.add_child(post_bait)
	post_bait.global_position = Vector3(8, 0, 20)
	await get_tree().process_frame

	var d_pick := anchor.global_position.distance_to(mid_bait.global_position)
	var d_post := Vector3(0, 0, 20).distance_to(mid_bait.global_position)
	var chases_midleg := anchor._worth_leaving_the_beat(mid_bait)
	var chases_at_post := anchor._worth_leaving_the_beat(post_bait)
	print("[faction] THE BEAT IS THE ANCHOR mid-leg contact %.1fu from the picket / %.1fu from its waypoint (engage %.0f): chased=%s | control at the waypoint chased=%s -> %s" % [
		d_pick, d_post, Hostile.PATROL_ENGAGE, str(chases_midleg), str(chases_at_post),
		"PASS" if not chases_midleg and chases_at_post else "FAIL"])
	for n in [anchor, mid_bait, post_bait]:
		if is_instance_valid(n):
			n.queue_free()

	# --- 14. THE PARLEY IS IMMUNE (finding A3) -------------------------------
	# break_parley fires when a raider takes damage from ANYONE, so a picket
	# that peeled onto a pack mid-standoff would answer the demand on the
	# player's behalf and delete the choice the interdiction is built around —
	# permanently, everywhere in charted space. Asserted as a REFUSAL TO
	# ENGAGE rather than as "the standoff survived": the picket must not pick
	# the fight in the first place.
	var guard := Hostile.new()
	guard.faction = "gsa"
	guard.patrol = [Vector3(0, 0, 0), Vector3(4, 0, 0)] as Array[Vector3]
	system_root.add_child(guard)
	guard.position = Vector3.ZERO
	var demanding := SwarmHostile.new()
	demanding.add_to_group("raider")
	demanding.standoff = 30.0
	system_root.add_child(demanding)
	demanding.global_position = Vector3(3, 0, 0)
	await get_tree().process_frame
	guard._enemies_version = -1
	# Force the raider to be a legal target for the flag, so the ONLY thing
	# that can refuse the engagement is the parley clause itself.
	GameState.shift_faction("gsa", "tithe", -12)
	demanding.faction = "tithe"
	guard._enemies_version = -1
	var engages_parleying := guard._worth_leaving_the_beat(demanding)
	demanding.standoff = 0.0
	var engages_after := guard._worth_leaving_the_beat(demanding)
	print("[faction] THE PARLEY IS IMMUNE picket engages during standoff=%s, after it lapses=%s -> %s" % [
		str(engages_parleying), str(engages_after),
		"PASS" if not engages_parleying and engages_after else "FAIL"])
	if is_instance_valid(guard):
		guard.queue_free()
	if is_instance_valid(demanding):
		demanding.queue_free()
	# Same reason as the beat probe above: a routed Hostile left standing is a
	# picket as far as every counter in this file is concerned.
	if is_instance_valid(guard):
		guard.free()

	# --- 15. EVERY AMBIENT HOSTILE HAS AN OWNER ------------------------------
	#     Stage 3's headline: the dead frontier's machines were never masterless.
	#     Swept over what the system actually BUILT, so it fails on a spawner
	#     that was missed rather than on a data table that agrees with itself.
	var unowned: Array = []
	var owned_flags := {}
	for n_v in get_tree().get_nodes_in_group("combatants"):
		var n := n_v as Node3D
		var f := String(n.faction)
		owned_flags[f] = int(owned_flags.get(f, 0)) + 1
		if f == FactionDB.FERAL:
			unowned.append(String(n.name))
	print("[faction] EVERY AMBIENT HOSTILE HAS AN OWNER %s in charted %s, %d still unflagged -> %s" % [
		str(owned_flags), system_id, unowned.size(),
		"PASS" if unowned.is_empty() and not owned_flags.is_empty() else "FAIL"])

	# --- 16. THE DEEP IS STILL UNCLAIMED -------------------------------------
	#     Bands 3-4 belong to the three powers nobody has a word for yet. The
	#     shipped data already says so — GUARD_DESIGNATION[3] is "UNFLAGGED — NO
	#     PATTERN ON FILE" — so a stage-3 spawner reaching out there would make
	#     the designation a lie and spend stage 6's reveal early. Asserted
	#     through the real rule rather than by inspecting a node, because the
	#     rule is what a future band edit would break.
	# RE-AIMED IN STAGE 6, and this is the assertion doing exactly its job.
	# Stages 3-5 held bands 3-4 unflagged so the shipped designations stayed
	# honest; stage 6 hands them to the powers those designations were always
	# describing. The claim is no longer "the deep is empty" but the stronger
	# "the deep belongs to somebody, and not to anybody with a desk" — a host
	# engine reaching past band 2, or a chart faction owning a nest out there,
	# both fail. NOTHING is feral any more, which is the point: `feral` meant
	# "no owner yet", and there is no yet left.
	#
	# NARROWED, NOT WEAKENED, when chartfolk convoys arrived: this claim is
	# about TERRITORY — flag_for_band is who owns the ground, who the nests
	# and guard posts answer to — and territory is still the unknowns' alone.
	# A convoy is TRAFFIC: it holds no ground, springs once per cell per
	# session, walks a 24u beat and leashes away when the player leaves.
	# What would still fail here is ownership — a chart flag coming back from
	# flag_for_band. What no longer contradicts it is a bastion escort
	# WALKING past band 2, because transit was never the thing this line
	# pinned. THE DEEP IS TRAVELLED asserts the traffic; this asserts the
	# ground; the two together are the actual design.
	var claim_rows := ""
	var deep_ok := true
	var chartfolk := ["gsa", "bastion", "combine", "embers", "grin", "league",
		"tithe", "procession"]
	for band in range(5):
		var f := deep_space.flag_for_band(band) if deep_space != null else FactionDB.FERAL
		claim_rows += "b%d:%s " % [band, f]
		if band <= 2:
			if f != SystemDB.faction_of(system_id):
				deep_ok = false
		else:
			# Out here: an unknown, never a host engine, never a chart power,
			# and never unflagged.
			if not f.begins_with("unknown_") or chartfolk.has(f):
				deep_ok = false
	print("[faction] THE DEEP BELONGS TO THE UNKNOWNS %s(bands 0-2 the host, 3-4 an unknown, none feral) -> %s" % [
		claim_rows, "PASS" if deep_ok else "FAIL"])

	# THE TALLY DOES NOT LET GO. One line of code, and the only tell it needs:
	# everything the expanse seeds carries HOSTILE_LEASH so a pack picked up
	# far out does not follow you home. The Tally has no leash.
	var leash_rows := ""
	var leash_ok := true
	if deep_space != null:
		for band in [2, 3, 4]:
			var f2 := deep_space.flag_for_band(band)
			var expect_leash: bool = f2 != "unknown_a"
			leash_rows += "b%d:%s " % [band, "leashed" if expect_leash else "RELENTLESS"]
			if band == 3 and expect_leash:
				leash_ok = false          # the Reaches must be the Tally's
			if band == 2 and not expect_leash:
				leash_ok = false          # nothing inside the Drift is relentless
	print("[faction] THE TALLY DOES NOT LET GO %s-> %s" % [
		leash_rows, "PASS" if leash_ok else "FAIL"])

	# THE HOLLOWING CANNOT KILL YOU. Its fire cannot take the last point of
	# shield, so it strips a ship to a sliver and cannot finish it. Asserted
	# through the REAL clamp against a real player ship, at damage far beyond
	# lethal, REPEATEDLY — the clamp has to hold at the floor, not merely on
	# the first shot.
	#
	# This ship has no hull: `shield` IS its health, and take_hit downs the
	# player at `shield <= 0.0`. The first version of this assertion read a
	# `hull` property that has never existed and crashed the harness, which is
	# how the underlying design error was found — the Hollowing had been
	# written to clamp at the shield remaining, landing exactly on zero.
	var hollow := SwarmHostile.new()
	hollow.faction = "unknown_b"
	system_root.add_child(hollow)
	var mark: PlayerShip = get_tree().get_first_node_in_group("player")
	var shield_left := -1.0
	var survived := false
	if mark != null:
		mark.invulnerable = false
		mark.shield = mark.shield_max
		hollow.global_position = mark.global_position + Vector3(1.5, 0, 0)
		for i in range(10):
			var out: float = SwarmHostile.DAMAGE * 60.0
			if "shield" in mark:
				out = minf(out, maxf(float(mark.shield) - 1.0, 0.0))
			if out > 0.0:
				mark.take_hit(out, hollow)
		shield_left = mark.shield
		survived = mark.shield > 0.0
		mark.shield = mark.shield_max
		mark.invulnerable = true
	# FREED AND WAITED ON. queue_free is deferred, so without the frame this
	# probe is still in `combatants` when AMBIENT COMBAT DEPLETES NOTHING takes
	# its baseline a few lines below — and that check then reads its own litter
	# being cleaned up as the world depleting itself (census 10 -> 9).
	hollow.queue_free()
	await get_tree().process_frame
	print("[faction] THE HOLLOWING CANNOT KILL YOU 10 volleys at 60x damage -> shield %.2f left, still flying=%s -> %s" % [
		shield_left, str(survived),
		"PASS" if survived and shield_left <= 1.01 else "FAIL"])

	# --- 17. AMBIENT COMBAT DEPLETES NOTHING ---------------------------------
	#     THE ASSERTION THIS STAGE EXISTS FOR, and the one that would have caught
	#     the defect the prep pass found by hand: a picket and a sentry are the
	#     same machine, so 120hp against 12.17dps is a mutual kill in 9.9s, and
	#     ambient skirmishing would have emptied charted space of both sides
	#     within half a minute of the player arriving.
	#
	#     ONLY THE PLAYER DEPLETES THE WORLD. Run the system with the player
	#     parked far away and untouchable, long enough for three full
	#     engage/rest cycles, and require the census to be IDENTICAL — not
	#     merely non-zero, which any half-emptied system would satisfy.
	# GENERATION OFF FIRST. The earlier version parked the player at (0,0,400)
	# to keep them out of the fight — which is depth 360, inside the band where
	# the expanse SEEDS NESTS, so the census grew by two while the check was
	# watching for it to shrink (7 -> 9). Every harness that puts a ship
	# outside `bounds` calls this for the same reason.
	set_deep_generation(false)
	await get_tree().process_frame
	var pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	if pilot != null:
		pilot.invulnerable = true
		pilot.teleport_to(Vector3(0, 0, 400))
	_wave_timer = 1.0e9        # no reinforcements: a census that grows hides a loss
	_muster_timer = 1.0e9      # nor a muster, which spawns 32 of them
	_cordon_timer = 1.0e9      # nor a relief walking back onto an empty beat
	await get_tree().create_timer(0.5).timeout
	# Baseline taken AFTER the world has settled into that state, so anything
	# already in flight is counted on both sides of the watch.
	var census_before := get_tree().get_nodes_in_group("combatants").size()
	var watched := 0.0
	var budget := (FactionDB.SKIRMISH_TIME + FactionDB.SKIRMISH_REST) * 3.0
	while watched < budget:
		await get_tree().create_timer(0.25).timeout
		watched += 0.25
	var census_after := get_tree().get_nodes_in_group("combatants").size()
	set_deep_generation(true)
	print("[faction] AMBIENT COMBAT DEPLETES NOTHING %.0fs unattended (3 x %.0fs cycles), census %d -> %d -> %s" % [
		watched, FactionDB.SKIRMISH_TIME + FactionDB.SKIRMISH_REST,
		census_before, census_after,
		"PASS" if census_after == census_before and census_before > 0 else "FAIL"])

	# --- 17b. THE BORDER IS CONTESTED ----------------------------------------
	#     THE OTHER HALF OF 17, and its absence is why the horizon shipped with
	#     no visible faction combat at all. "The census does not drop" is
	#     satisfied perfectly by a world where nobody ever fires — which is
	#     exactly what shipped, and 17 called it a PASS every single run.
	#
	#     An assertion is only worth what it can see: a guarantee that nothing
	#     dies needs a partner that proves something HAPPENS, or the cheapest
	#     way to satisfy it is to break combat entirely.
	#
	#     Measured on two machines placed within weapons range of each other,
	#     one from each side of the border, with the player parked far away and
	#     nothing else nearby to distract either of them. BOTH must lose hull,
	#     and BOTH must still be flying: that pair of clauses is the contested
	#     border and the depletion guarantee in one line, and neither clause
	#     alone can be satisfied by breaking the other.
	set_deep_generation(false)
	var bord_picket := Hostile.new()
	bord_picket.faction = "gsa"
	# A real beat, because a picket is what stands on this border — and one
	# whose waypoints sit inside PATROL_ENGAGE of the sentry, so the "is this
	# worth leaving the beat for" gate says yes rather than the test measuring
	# a machine that correctly declined.
	#
	#     AND IT HAS TO CLOSE. The first version placed the pair 4u apart — inside
	#     weapons range on frame one — and PASSED with the skirmish-clock bug
	#     still in, because acquisition and fire coincided so the clock never had
	#     the chance to burn on the approach. The red-verify is what said so.
	#     That is not the case this is about: a picket walking a beat ACQUIRES a
	#     sentry from across the system and has to travel. The start is ~32u out,
	#     which is 7.8s of approach at PATROL_SPEED against a 6s clock, so under
	#     the old rule the picket broke off BEFORE arriving and was standing down
	#     when it got there. Waypoint 0 sits 4u from the sentry so the
	#     leave-the-beat gate (PATROL_ENGAGE 12, measured from the waypoint) says
	#     yes from the start and the picket is closing rather than declining.
	#
	#     The player is parked at (0,0,400) and invulnerable by the block above,
	#     200u past the sentry — far enough that the gnomon flag picks the
	#     closing picket over it, which is what puts an NPC on the clock at all.
	#
	#     AND IT HAS TO BE ALONE. Staged inside charted space, the pair sat among
	#     PYX-01's four authored sentries and the two pickets the garrison check
	#     just deployed, and BOTH fixtures took fire from machines that were not
	#     the other fixture — so it passed with the clock bug still in, twice, for
	#     two different reasons. Out at radius 200 with generation off there is
	#     nothing else in the sky, so damage on either of these two came from the
	#     other one.
	bord_picket.patrol = [Vector3(0, 0, 196), Vector3(0, 0, 168)] as Array[Vector3]
	system_root.add_child(bord_picket)
	bord_picket.position = Vector3(0, 0, 168)
	var bord_sentry := Hostile.new()
	bord_sentry.faction = "gnomon"
	system_root.add_child(bord_sentry)
	bord_sentry.position = Vector3(0, 0, 200)
	await get_tree().process_frame
	var bord_pmax := bord_picket.max_hp
	var bord_smax := bord_sentry.max_hp
	var bord_t := 0.0
	# Long enough for the 7.8s approach AND a burst on arrival; short enough that
	# a picket that broke off en route (the old rule) is still resting when the
	# window closes.
	while bord_t < 18.0:
		await get_tree().create_timer(0.25).timeout
		bord_t += 0.25
	var bord_alive: bool = is_instance_valid(bord_picket) and is_instance_valid(bord_sentry) \
		and bord_picket.hp > 0.0 and bord_sentry.hp > 0.0
	var bord_traded: bool = bord_alive \
		and bord_picket.hp < bord_pmax and bord_sentry.hp < bord_smax
	print("[faction] THE BORDER IS CONTESTED after %.0fs closing from %.0fu: picket %.0f/%.0f hp, sentry %.0f/%.0f hp, both still flying=%s -> %s" % [
		bord_t, 32.0,
		bord_picket.hp if is_instance_valid(bord_picket) else -1.0, bord_pmax,
		bord_sentry.hp if is_instance_valid(bord_sentry) else -1.0, bord_smax,
		str(bord_alive), "PASS" if bord_traded and bord_alive else "FAIL"])
	if is_instance_valid(bord_picket):
		bord_picket.free()
	if is_instance_valid(bord_sentry):
		bord_sentry.free()
	set_deep_generation(true)

	# --- 18. THE FIGHT ENDS (finding A6) -------------------------------------
	#     The mechanism behind 17, measured directly: a machine engaged on
	#     another machine breaks off before it can finish the job. Asserted as
	#     "it stopped having a target", which is what the break-off actually
	#     does — position, groups and post are untouched by design.
	var red := Hostile.new()
	red.faction = "gnomon"
	system_root.add_child(red)
	red.global_position = Vector3(0, 0, -300)
	var blue := Hostile.new()
	blue.faction = "gsa"
	system_root.add_child(blue)
	blue.global_position = Vector3(3, 0, -300)
	await get_tree().process_frame
	red._enemies_version = -1
	blue._enemies_version = -1
	var engaged_at := 0.0
	var broke_at := -1.0
	var t_fight := 0.0
	while t_fight < FactionDB.SKIRMISH_TIME + 3.0:
		await get_tree().create_timer(0.25).timeout
		t_fight += 0.25
		# "Engaged" means holding an NPC target, not merely holding one: a
		# machine standing down still re-acquires the PLAYER, so `_target ==
		# null` is a state the break-off never actually produces and testing
		# for it measured nothing.
		var on_npc: bool = red._target != null and is_instance_valid(red._target) \
			and not red._target.is_in_group("player")
		if on_npc and engaged_at <= 0.0:
			engaged_at = t_fight
		if engaged_at > 0.0 and not on_npc and broke_at < 0.0:
			broke_at = t_fight
	var both_alive: bool = is_instance_valid(red) and is_instance_valid(blue) \
		and not red.is_dying() and not blue.is_dying()
	print("[faction] THE FIGHT ENDS engaged at %.2fs, broke off at %.2fs (limit %.0fs), both alive=%s -> %s" % [
		engaged_at, broke_at, FactionDB.SKIRMISH_TIME, str(both_alive),
		"PASS" if engaged_at > 0.0 and broke_at > 0.0 and both_alive else "FAIL"])
	for n in [red, blue]:
		if is_instance_valid(n):
			n.queue_free()

	# --- 19. THE MUSTER --------------------------------------------------------
	#     Driven through the REAL event rather than by hand-placing ships: the
	#     claims are about what the event does, and a staged tableau would prove
	#     only that a tableau can be built.
	GameState.reset_to_starter()
	GameState.run_seed = RUN_SEED_PINNED
	_muster_cooldown = 0.0
	_muster_timer = 1.0e9        # no spontaneous second muster mid-measurement
	var salv_before := GameState.salvage
	var log_before := GameState.log_lines().size()

	# WARNING PRECEDES SPAWN. The 45s advisory is the whole reason the event is
	# not an ambush, so "nothing exists yet" is the assertion, not a nicety.
	_warn_muster()
	await get_tree().process_frame
	var early := _muster_census("muster_column") + _muster_census("muster_line")
	var warned: bool = _muster_warn > 0.0 and muster_active()
	print("[faction] WARNING PRECEDES SPAWN advisory live=%s, ships in the sky during the warning=%d -> %s" % [
		str(warned), early, "PASS" if warned and early == 0 else "FAIL"])

	# AND IT BLOCKS AN INTERDICTION. Two klaxons and two spawn systems on one
	# screen is the collision finding A5 names.
	print("[faction] ONE EVENT AT A TIME interdiction eligible during a muster=%s -> %s" % [
		str(interdiction_eligible()),
		"PASS" if not interdiction_eligible() else "FAIL"])

	# Skip the wait rather than sit through it: the advisory's LENGTH is a feel
	# number, and what this suite measures is what happens on either side of it.
	_muster_warn = 0.01
	await get_tree().create_timer(0.4).timeout

	# THE LINE IS THE EDGE. The band-1 beacon has promised since v13 that
	# patrols do not operate past the marker; stage 2a made that an assertion
	# about pickets, and the muster is the one event that could quietly break it
	# by spawning a fleet outside to meet the column.
	var line_depth_worst := -1.0e9
	for node in get_tree().get_nodes_in_group("muster_line"):
		var n := node as Node3D
		if is_instance_valid(n) and deep_space != null:
			line_depth_worst = maxf(line_depth_worst, deep_space.depth_at(n.global_position))
	var column_out := 0
	for node in get_tree().get_nodes_in_group("muster_column"):
		var n2 := node as Node3D
		if is_instance_valid(n2) and deep_space != null \
				and deep_space.depth_at(n2.global_position) > 0.0:
			column_out += 1
	print("[faction] THE LINE IS THE EDGE deepest cordon ship %.1fu past the marker (must be <= 0), %d column ships outside it -> %s" % [
		line_depth_worst, column_out,
		"PASS" if line_depth_worst <= 0.0 and column_out > 0 else "FAIL"])

	# ORDER MATTERS HERE. This runs BEFORE the budget sweep below, because that
	# loop runs until the column is exhausted — and a muster that resolves during
	# it leaves nothing alive to shoot, which made this check report "-1 cubes"
	# and pass or fail on timing rather than on the payout ban.
	# THE MUSTER CARRIES NOTHING. Both halves in one measurement: a column ship
	# killed BY THE PLAYER drops no crate and ticks no contract. Either clause
	# alone passes on broken code — "pays nothing" is satisfied by an economy
	# that pays nobody.
	var muster_kills := [0]
	var muster_tally := func(kind: String) -> void:
		if kind == "muster":
			muster_kills[0] += 1
	hostile_killed.connect(muster_tally)
	var contract_seen := [0]
	var contract_tally := func(_k: String) -> void: contract_seen[0] += 1
	if contracts != null:
		hostile_killed.connect(contract_tally)
	_clear_loot_cubes()
	var victim: Node3D = null
	for node in get_tree().get_nodes_in_group("muster_column"):
		if is_instance_valid(node):
			victim = node as Node3D
			break
	var pilot2: PlayerShip = get_tree().get_first_node_in_group("player")
	var cubes_after := -1
	if victim != null and pilot2 != null:
		victim.take_damage(99999.0, pilot2)
		await get_tree().process_frame
		cubes_after = _count_loot_cubes()
	hostile_killed.disconnect(muster_tally)
	if contracts != null:
		hostile_killed.disconnect(contract_tally)
	var no_contract := not ContractDB.CONTRACTS.keys().any(
		func(k: String) -> bool:
			return String(ContractDB.CONTRACTS[k].get("kind", "")) == "kill_muster")
	print("[faction] THE MUSTER CARRIES NOTHING player-killed a column ship: %d cubes, reported kind counted as muster=%d, any contract wants kill_muster=%s -> %s" % [
		cubes_after, muster_kills[0], str(not no_contract),
		"PASS" if cubes_after == 0 and muster_kills[0] == 1 and no_contract else "FAIL"])

	# THE BUDGET HOLDS. Measured at the PEAK across the whole event, because a
	# wave-fed spawner's worst moment is not its first: run until the column is
	# fully released and watch the live count the whole way.
	var peak := 0
	var watch := 0.0
	while watch < MUSTER_WAVE_GAP * (float(MUSTER_COLUMN) / float(MUSTER_WAVE) + 1.0):
		await get_tree().create_timer(0.25).timeout
		watch += 0.25
		peak = maxi(peak, _muster_census("muster_column") + _muster_census("muster_line"))
		if not _muster_active:
			break
	print("[faction] THE BUDGET HOLDS peak live muster ships %d vs budget %d (column %d + line %d) -> %s" % [
		peak, MUSTER_COLUMN + MUSTER_LINE, MUSTER_COLUMN, MUSTER_LINE,
		"PASS" if peak > 0 and peak <= MUSTER_COLUMN + MUSTER_LINE else "FAIL"])

	# ORDINARY WAVES ARE UNTOUCHED (finding A7). The muster must not overload
	# `boss_active` or the wave gate — that would lock HUD panels for an event
	# the player may be nowhere near, and BOSSTEST's WAVES RESUMED already
	# polices the second pause-source.
	print("[faction] ORDINARY WAVES ARE UNTOUCHED panels locked=%s during a live muster (must be false) -> %s" % [
		str(boss_active), "PASS" if not boss_active else "FAIL"])

	# And it pays no salvage, whatever else it does.
	_close_muster(true)
	await get_tree().create_timer(0.3).timeout
	var still_live := _muster_census("muster_column") + _muster_census("muster_line")
	print("[faction] THE MUSTER PAYS NO SALVAGE salvage %d -> %d, outcome logged=%s, ships still counted after close=%d (must be 0) -> %s" % [
		salv_before, GameState.salvage,
		str(GameState.log_lines().size() > log_before), still_live,
		"PASS" if GameState.salvage == salv_before and still_live == 0 else "FAIL"])
	_muster_cooldown = 0.0
	_muster_timer = 1.0e9

	# --- 19b. THE MUSTER IS A FIGHT ------------------------------------------
	#     THE ASSERTION THAT WAS MISSING, and its absence let the event ship
	#     broken for three stages. Everything section 19 checks is true of a
	#     muster in which not one shot is fired: the warning precedes the spawn,
	#     the line stands inside the marker, the budget holds, nothing is
	#     bankable, the outcome is logged. All PASS. Measured over a whole event,
	#     twice: line 960hp -> 960hp, column 816hp -> 816hp, CLOSED at 23.75s.
	#     The column marched seventy-five units, touched the edge and dissolved,
	#     and every assertion in the suite called that a working set-piece.
	#
	#     TWO CAUSES, both invisible to a check on positions and counts. The
	#     breach test read "inside the marker" while the line stands INSIDE the
	#     marker, so it fired the instant the first ship closed to engage. And
	#     the skirmish clock counted ACQUISITION rather than fire, so both sides
	#     burned their six seconds on contacts eighty units away and were resting
	#     when they finally met.
	#
	#     So this drives the real event to its real end and asserts the thing
	#     that makes it an event: BOTH SIDES LOSE HULL. Deliberately not "the
	#     line wins" — who wins is emergent and is supposed to be — and
	#     deliberately both directions, because a column wiped by an invulnerable
	#     line is a cutscene, not a battle.
	var fig_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	if fig_pilot != null:
		# Out of the way and out of the fight: this measures the Cordon against the
		# column, and a player in the middle of it would be measuring themselves.
		fig_pilot.invulnerable = true
		fig_pilot.teleport_to(Vector3(0, 0, 0))
	_muster_cooldown = 0.0
	_warn_muster()
	_muster_warn = 0.01
	await get_tree().create_timer(0.4).timeout
	var fig_line0 := 0.0
	for node in get_tree().get_nodes_in_group("muster_line"):
		fig_line0 += float(node.hp)
	var fig_col_peak := 0.0
	var fig_line_low := fig_line0
	var fig_col_low := 1.0e9
	var fig_t := 0.0
	# A TIME BUDGET WITH REAL HEADROOM. The measured event resolves at ~43s once
	# both sides can actually shoot; 120 is generous without reaching
	# MUSTER_TIMEOUT, so a run that hits this ceiling means the fight stopped
	# resolving rather than that the budget was tight.
	while fig_t < 120.0:
		await get_tree().create_timer(0.25).timeout
		fig_t += 0.25
		# BREAK BEFORE SAMPLING, NOT AFTER. _close_muster calls depart() on every
		# ship, which removes it from the muster groups immediately — so a sample
		# taken on the closing tick reads 0hp for BOTH sides and satisfies "both
		# lost hull" no matter what happened. The first version of this printed
		# `line 960 -> 0 hp, column peak 816 -> 0 hp -> PASS` on a run that was
		# genuinely a fight, and would have printed exactly the same thing on one
		# that was not. Only live events are sampled.
		if not _muster_active:
			break
		var fig_lh := 0.0
		var fig_ch := 0.0
		for node in get_tree().get_nodes_in_group("muster_line"):
			if is_instance_valid(node):
				fig_lh += float(node.hp)
		for node in get_tree().get_nodes_in_group("muster_column"):
			if is_instance_valid(node):
				fig_ch += float(node.hp)
		fig_col_peak = maxf(fig_col_peak, fig_ch)
		fig_line_low = minf(fig_line_low, fig_lh)
		# Sampled only once the column is fully out, so the low-water mark is a
		# casualty count rather than "the first wave has not spawned yet".
		if _muster_released >= MUSTER_COLUMN:
			fig_col_low = minf(fig_col_low, fig_ch)
		if not _muster_active:
			break
	var fig_line_hurt := fig_line_low < fig_line0
	var fig_col_hurt := fig_col_low < fig_col_peak
	var fig_ended: bool = not _muster_active
	print("[faction] THE MUSTER IS A FIGHT resolved in %.1fs (ended=%s): line %.0f -> %.0f hp, column peak %.0f -> %.0f hp -> %s" % [
		fig_t, str(fig_ended), fig_line0, fig_line_low, fig_col_peak, fig_col_low,
		"PASS" if fig_ended and fig_line_hurt and fig_col_hurt else "FAIL"])
	if fig_pilot != null:
		fig_pilot.invulnerable = false
	_close_muster(true)
	await get_tree().create_timer(0.3).timeout
	_muster_cooldown = 0.0
	_muster_timer = 1.0e9

	# --- 20. STAGE 5: the desks, the gate, and the convoy ----------------------
	_clear_faction_matrix()

	# EVERY DESK HAS AN OWNER, AND THE WATCH HAS NONE. Swept over the authored
	# tables, both of them, because ownership is what the dock line and the
	# fence gate read — an unowned port is silently ungated, which is correct
	# for exactly one address in the game. The exemption is asserted BY NAME:
	# "some port may be unowned" is a rule that cannot fail.
	var unowned_ports: Array = []
	for sid_v in SystemDB.ids():
		for pd_v in SystemDB.ports_of(String(sid_v)):
			var pd: Dictionary = pd_v
			var o := Market.owner_of(pd)
			if o == "" or not FactionDB.is_faction(o):
				unowned_ports.append(String(pd.get("id", "?")))
	for arch_v in DeepPortDB.ARCHETYPES:
		var arch: Dictionary = arch_v
		var od := Market.owner_of(arch)
		if od == "" or not FactionDB.is_faction(od):
			unowned_ports.append(String(arch.get("id", "?")))
	# Stage 5 asserted the Last Watch was the ONE unowned desk. Stage 6 spent
	# that hook: the Stillness owns it, so the list must now be EMPTY, and the
	# Watch's own clause moves to THE WATCH ANSWERS TO SOMETHING below.
	print("[faction] EVERY DESK HAS AN OWNER unowned=%s (must be empty since stage 6) -> %s" % [
		str(unowned_ports),
		"PASS" if unowned_ports.is_empty() else "FAIL"])

	# THE WATCH ANSWERS TO SOMETHING — and its back room stays open. The reveal
	# must not cost the player the deepest fence in the game as a side effect
	# of a name, which is why the Stillness is NEUTRAL to the surveyor.
	# `watch_def`, not `watch` — THE BUDGET HOLDS already owns that name and
	# GDScript scopes to the whole function. Fourth time this horizon.
	var watch_def := DeepPortDB.by_id("deep_watch")
	var watch_owner := Market.owner_of(watch_def)
	print("[faction] THE WATCH ANSWERS TO SOMETHING owner=%s (%s), fence open at baseline=%s -> %s" % [
		watch_owner, FactionDB.display_name(watch_owner),
		str(Market.fence_open(watch_def)),
		"PASS" if watch_owner == "unknown_c" and Market.fence_open(watch_def) else "FAIL"])

	# THE FENCE REMEMBERS, driven through the REAL gate at the real band. And
	# BASELINE FENCES ARE OPEN: PACINGTEST's best-route search sells fenced
	# goods, so a baseline that closed any fence would un-fly the measured
	# route and move the binding MIDTIER for a reason nobody asked for.
	var void_def := SystemDB.port_def_by_id("void")
	var open_baseline := Market.fence_open(void_def)
	for i in range(200):
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", -5)
	var shut_hostile := not Market.fence_open(void_def)
	_clear_faction_matrix()
	var all_open := true
	for sid_v2 in SystemDB.ids():
		for pd_v2 in SystemDB.ports_of(String(sid_v2)):
			if not Market.fence_open(pd_v2):
				all_open = false
	print("[faction] THE FENCE REMEMBERS open at baseline=%s, shut at HOSTILE=%s, every fence open at pinned state=%s -> %s" % [
		str(open_baseline), str(shut_hostile), str(all_open),
		"PASS" if open_baseline and shut_hostile and all_open else "FAIL"])

	# NO PRICE MOVES WITH STANDING — the assertion that turns "gates, never
	# prices" from a promise into a property. Every good at one chart port and
	# one deep archetype, priced at baseline and at both extremes, must match
	# to the credit. This is what keeps STATIONTEST's sellback/outfit guard
	# rail safe by construction instead of by re-proof at every band.
	var price_moved := ""
	var cantina_def := SystemDB.port_def_by_id("cantina")
	var probe_defs := [void_def, cantina_def, DeepPortDB.by_id("deep_haven")]
	# §108 rides this sweep rather than building a second one. The reserve is the
	# first thing standing has ever moved at a market counter, so the same loops
	# that prove no PRICE moved now also prove that what DID move is the shelf,
	# and only ever upward. Two accumulators: anything wrong, and evidence the
	# gate is alive at all.
	var base_prices := {}
	var base_caps := {}
	var cap_wrong := ""
	var cap_rose := ""
	for d_v in probe_defs:
		var d: Dictionary = d_v
		for g_v in CommodityDB.ids():
			var g := String(g_v)
			base_prices["%s|%s" % [d.get("id"), g]] = [
				Market.buy_price(d, String(d.get("id")), g, 1),
				Market.sell_price(d, String(d.get("id")), g, 1)]
			base_caps["%s|%s" % [d.get("id"), g]] = Market.stock_cap(d, g)
	for extreme in [12, -24]:
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", extreme)
		GameState.shift_faction(FactionDB.SURVEYOR, "embers", extreme)
		for d_v2 in probe_defs:
			var d2: Dictionary = d_v2
			for g_v2 in CommodityDB.ids():
				var g2 := String(g_v2)
				var key := "%s|%s" % [d2.get("id"), g2]
				var now := [Market.buy_price(d2, String(d2.get("id")), g2, 1),
					Market.sell_price(d2, String(d2.get("id")), g2, 1)]
				if now != base_prices[key] and price_moved == "":
					price_moved = "%s at shift %d: %s -> %s" % [key, extreme,
						str(base_prices[key]), str(now)]
				var cap_now := Market.stock_cap(d2, g2)
				var cap_was := int(base_caps[key])
				# +12 saturates to ALLIED and may only ADD stock; -24 lands on
				# HOSTILE, where the shelf must read exactly what it read before
				# the reserve existed. A cap that FELL in either direction is a
				# counter closing on a standing, which is the death trap.
				if extreme > 0 and cap_now < cap_was and cap_wrong == "":
					cap_wrong = "%s fell %d -> %d at ALLIED" % [key, cap_was, cap_now]
				if extreme > 0 and cap_now > cap_was and cap_rose == "":
					cap_rose = "%s %d -> %d" % [key, cap_was, cap_now]
				if extreme < 0 and cap_now != cap_was and cap_wrong == "":
					cap_wrong = "%s moved %d -> %d at HOSTILE" % [key, cap_was, cap_now]
	_clear_faction_matrix()
	print("[faction] NO PRICE MOVES WITH STANDING %d goods x 3 desks x 2 extremes, first divergence: %s -> %s" % [
		CommodityDB.ids().size(), "none" if price_moved == "" else price_moved,
		"PASS" if price_moved == "" else "FAIL"])
	# BOTH HALVES. Without the second clause a reserve that silently did nothing
	# would pass this line -- the posture A CONSUMER SELLS NOTHING uses and A
	# COMMISSION IS NOT A WAY IN states outright.
	print("[faction] ONLY THE SHELF MOVES WITH STANDING the reserve is alive (%s) and nothing fell or moved at HOSTILE (%s) -> %s" % [
		cap_rose if cap_rose != "" else "NOTHING ROSE",
		cap_wrong if cap_wrong != "" else "none",
		"PASS" if cap_rose != "" and cap_wrong == "" else "FAIL"])

	# NO COUNTER CLOSES AT HOSTILE. market.gd has claimed since stage 5 that
	# "market, outfitter and repair stay open at every standing" because a port
	# that refused a damaged pilot is a death trap -- and for five stages that
	# was PROSE WITH NO ASSERTION BEHIND IT. §108 adds a second standing gate, so
	# the claim gets teeth in the same commit that complicates it: every counter
	# in the game, charted and deep, driven to HOSTILE.
	var hostile_defs := []
	for pid_hv in SystemDB.port_ids():
		hostile_defs.append(SystemDB.port_def_by_id(String(pid_hv)))
	for aid_hv in DeepPortDB.ids():
		hostile_defs.append(DeepPortDB.by_id(String(aid_hv)))
	var open_caps := {}
	_clear_faction_matrix()
	for d_hv in hostile_defs:
		var dh: Dictionary = d_hv
		for g_hv in CommodityDB.ids():
			open_caps["%s|%s" % [dh.get("id"), String(g_hv)]] = \
				Market.stock_cap(dh, String(g_hv))
	for fid_v in FactionDB.ids():
		GameState.shift_faction(FactionDB.SURVEYOR, String(fid_v), -24)
	var cap_lost := ""
	var reserve_still_open := ""
	var fences_closed := 0
	for d_hv2 in hostile_defs:
		var dh2: Dictionary = d_hv2
		# The one gate that IS allowed to close, counted so this leg cannot pass
		# by never having reached HOSTILE at all.
		if not Market.fence_open(dh2):
			fences_closed += 1
		if Market.reserve_open(dh2) and reserve_still_open == "":
			reserve_still_open = String(dh2.get("id", "?"))
		for g_hv2 in CommodityDB.ids():
			var kh := "%s|%s" % [dh2.get("id"), String(g_hv2)]
			var cap_h := Market.stock_cap(dh2, String(g_hv2))
			var cap_o := int(open_caps[kh])
			if cap_lost != "":
				continue
			# A COUNTER MAY LOSE ITS RESERVE, AND MAY LOSE NOTHING ELSE. Where a
			# faction starts FRIENDLY or better, the open reading already carries
			# the x1.5 and dropping back to the baseline on the way to HOSTILE is
			# the gate working, not a counter closing. Anything else -- and in
			# particular anything that stocked a good and now stocks none -- is
			# the death trap, and is named.
			var lost_reserve: bool = cap_o == int(round(float(cap_h)
				* Market.STOCK_RESERVE_MULT))
			if (cap_h > 0) != (cap_o > 0) or not (cap_h == cap_o or lost_reserve):
				cap_lost = "%s %d -> %d" % [kh, cap_o, cap_h]
	_clear_faction_matrix()
	# Services are static data on the def and cannot vary with standing, so
	# asserting them here would be asserting nothing. What CAN vary is what the
	# two gates return, and that is what this measures: every shelf identical to
	# its open reading, every reserve shut, and the fence -- the one counter a
	# standing may close -- demonstrably closing somewhere.
	print("[faction] NO COUNTER CLOSES AT HOSTILE %d counters driven hostile: %d fences shut (the one gate that may), every reserve shut=%s, first shelf to shrink: %s -> %s" % [
		hostile_defs.size(), fences_closed,
		"yes" if reserve_still_open == "" else "no, " + reserve_still_open,
		cap_lost if cap_lost != "" else "none",
		"PASS" if cap_lost == "" and reserve_still_open == "" and fences_closed > 0
			else "FAIL"])

	# THE CONVOY KEEPS ITS SCHEDULE, AND THE REGISTRY NEVER LEARNS ITS NAME.
	# Purity: the same window answers the same system, always. Coverage: over
	# many windows it visits more than one system, or "moving port" is a lie.
	# And it must never enter SystemDB.port_ids(), which feeds the market-event
	# roll and the rumour loop — the same isolation the deep ports rely on.
	var w_same: bool = procession_system(7) == procession_system(7)
	# `route_seen`, not `visited` — section 12 already owns that name, and
	# GDScript scopes variables to the whole function. The same collision
	# already cost one boot-refusing parse error this horizon (`charted`).
	var route_seen := {}
	for w in range(40):
		route_seen[procession_system(w)] = true
	var registered: bool = SystemDB.port_ids().has("procession")
	print("[faction] THE CONVOY KEEPS ITS SCHEDULE window-stable=%s, %d systems over 40 windows, in the port registry=%s -> %s" % [
		str(w_same), route_seen.keys().size(), str(registered),
		"PASS" if w_same and route_seen.keys().size() >= 2 and not registered else "FAIL"])

	# STANDING IS VISIBLE — against the RENDERED sheet, because preview_stats
	# taught this project that correct numbers can fail to reach a screen. The
	# dock line must show the same band the gate reads, and must CHANGE when
	# the matrix does.
	var cantina_port: Port = null
	for node in get_tree().get_nodes_in_group("dockable"):
		if node is Port and (node as Port).port_id == "cantina":
			cantina_port = node as Port
			break
	var visible_ok := false
	var visible_moves := false
	if cantina_port != null and port_panel != null:
		port_panel.open_for(cantina_port)
		visible_ok = _panel_text_contains(port_panel, "STANDING: NEUTRAL")
		for i in range(200):
			GameState.shift_faction(FactionDB.SURVEYOR, "embers", -5)
		port_panel._refresh()
		visible_moves = _panel_text_contains(port_panel, "STANDING: HOSTILE")
		port_panel.close_panel()
	_clear_faction_matrix()
	print("[faction] STANDING IS VISIBLE dock line at NEUTRAL=%s, follows the matrix to HOSTILE=%s -> %s" % [
		str(visible_ok), str(visible_moves),
		"PASS" if visible_ok and visible_moves else "FAIL"])

	# --- 22. CHARTFOLK CONVOYS: the payout and the hunt ----------------------
	# A CONVOY IS NOT A NEST. Both halves in one measurement, because either
	# alone passes on broken code: "a league kill pays nothing" is satisfied
	# by an economy that pays nobody, and "a tithe kill pays" is satisfied by
	# one that pays for everything. Probe ships driven through the real class
	# and the real _die, the muster section's shape.
	_clear_faction_matrix()
	var conv_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	_clear_loot_cubes()
	var conv_neutral := SwarmHostile.new()
	conv_neutral.faction = "league"
	conv_neutral.add_to_group("deep_convoy")
	system_root.add_child(conv_neutral)
	conv_neutral.global_position = conv_pilot.global_position + Vector3(4, 0, 0)
	await get_tree().process_frame
	conv_neutral.take_damage(99999.0, conv_pilot)
	await get_tree().process_frame
	var conv_neutral_cubes := _count_loot_cubes()
	var conv_delta := int(GameState.faction_deltas.get(
		FactionDB.pair_key(FactionDB.SURVEYOR, "league"), 0))
	_clear_loot_cubes()
	var conv_tithe := SwarmHostile.new()
	conv_tithe.faction = "tithe"
	conv_tithe.add_to_group("deep_convoy")
	system_root.add_child(conv_tithe)
	conv_tithe.global_position = conv_pilot.global_position + Vector3(4, 0, 0)
	await get_tree().process_frame
	conv_tithe.take_damage(99999.0, conv_pilot)
	await get_tree().process_frame
	var conv_tithe_cubes := _count_loot_cubes()
	var conv_tithe_delta := int(GameState.faction_deltas.get(
		FactionDB.pair_key(FactionDB.SURVEYOR, "tithe"), 0))
	_clear_loot_cubes()
	print("[faction] A CONVOY IS NOT A NEST league kill: %d cubes (want 0), standing delta %d (want -1); tithe kill: %d cubes (want %d), standing delta %d (want 0) -> %s" % [
		conv_neutral_cubes, conv_delta, conv_tithe_cubes, SwarmHostile.LOOT_COUNT,
		conv_tithe_delta,
		"PASS" if conv_neutral_cubes == 0 and conv_delta == -1
			and conv_tithe_cubes == SwarmHostile.LOOT_COUNT
			and conv_tithe_delta == 0 else "FAIL"])
	_clear_faction_matrix()

	# THE TALLY HUNTS. The matrix change that makes the Reaches dangerous for
	# everyone, measured on real nodes at weapons range: a Tally pack and a
	# convoy squad must BOTH lose hull — the convoy answers through the aggro
	# path, since its own row still says nothing about the unknowns — and
	# every ship on both sides must still be flying at the end, because the
	# ambient HP floor is what keeps NPC combat from resolving unwatched.
	# Neither clause alone survives broken code: "both lost hull" passes a
	# massacre, "all still flying" passes two crowds ignoring each other.
	var hunt_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	hunt_pilot.invulnerable = true
	hunt_pilot.teleport_to(Vector3(0, 0, -300))
	var hunt_tally := []
	var hunt_convoy := []
	for i_h in range(3):
		var t_h := SwarmHostile.new()
		t_h.faction = "unknown_a"
		system_root.add_child(t_h)
		t_h.global_position = Vector3(200 + i_h * 2, 0, -300)
		hunt_tally.append(t_h)
	var hc_escort := Hostile.new()
	hc_escort.faction = "league"
	system_root.add_child(hc_escort)
	hc_escort.global_position = Vector3(206, 0, -300)
	hunt_convoy.append(hc_escort)
	for i_h2 in range(2):
		var c_h := SwarmHostile.new()
		c_h.faction = "league"
		system_root.add_child(c_h)
		c_h.global_position = Vector3(206 + i_h2 * 2, 0, -302)
		hunt_convoy.append(c_h)
	await get_tree().process_frame
	var hunt_tally_hp0 := 0.0
	var hunt_convoy_hp0 := 0.0
	for t_v in hunt_tally:
		hunt_tally_hp0 += float(t_v.hp)
	for c_v in hunt_convoy:
		hunt_convoy_hp0 += float(c_v.hp)
	var hunt_t := 0.0
	while hunt_t < FactionDB.SKIRMISH_TIME + 6.0:
		await get_tree().create_timer(0.25).timeout
		hunt_t += 0.25
	var hunt_tally_hp := 0.0
	var hunt_convoy_hp := 0.0
	var hunt_all_alive := true
	for t_v2 in hunt_tally:
		if not is_instance_valid(t_v2) or float(t_v2.hp) <= 0.0:
			hunt_all_alive = false
		else:
			hunt_tally_hp += float(t_v2.hp)
	for c_v2 in hunt_convoy:
		if not is_instance_valid(c_v2) or float(c_v2.hp) <= 0.0:
			hunt_all_alive = false
		else:
			hunt_convoy_hp += float(c_v2.hp)
	print("[faction] THE TALLY HUNTS after %.0fs: tally %.0f -> %.0f hp, convoy %.0f -> %.0f hp, every ship still flying=%s -> %s" % [
		hunt_t, hunt_tally_hp0, hunt_tally_hp, hunt_convoy_hp0, hunt_convoy_hp,
		str(hunt_all_alive),
		"PASS" if hunt_tally_hp < hunt_tally_hp0 and hunt_convoy_hp < hunt_convoy_hp0
			and hunt_all_alive else "FAIL"])
	for probe_v in hunt_tally + hunt_convoy:
		if is_instance_valid(probe_v):
			(probe_v as Node).free()
	hunt_pilot.invulnerable = false

	# --- 23. THE FEEDBACK AND THE FILTER -------------------------------------
	# A STANDING SHIFT IS ANNOUNCED, ONCE PER VOLLEY. Standing has moved
	# silently since it shipped: one line into a ten-slot logbook the player
	# has to open a menu to read, and only for kills -- all three POSITIVE
	# movers passed quiet=true and put nothing anywhere. Four clauses in one
	# measurement, because each alone passes on broken code.
	_clear_faction_matrix()
	hud.clear_toast()
	var say_logs := GameState.log_lines().size()
	GameState.shift_faction(FactionDB.SURVEYOR, "league", 1, true)
	await get_tree().create_timer(STANDING_TOAST_SETTLE + 0.5).timeout
	var say_text := hud.toast_text()
	var say_named: bool = say_text.contains(FactionDB.display_name("league")) \
		and say_text.contains(FactionDB.BAND_NAMES[
			GameState.faction_band(FactionDB.SURVEYOR, "league")])
	# A shift between two OTHER factions is not the player's news.
	hud.clear_toast()
	GameState.shift_faction("gsa", "tithe", -1)
	await get_tree().create_timer(STANDING_TOAST_SETTLE + 0.5).timeout
	var say_quiet: bool = hud.toast_text() == ""
	# And a volley is ONE announcement. Six toasts would clobber each other --
	# this label has no queue -- so the player would see a flicker, not a line.
	hud.clear_toast()
	var say_before := hud.toast_count()
	for i_volley in range(6):
		GameState.shift_faction(FactionDB.SURVEYOR, "grin", -1)
	await get_tree().create_timer(STANDING_TOAST_SETTLE + 0.8).timeout
	var say_raised := hud.toast_count() - say_before
	var say_no_log: bool = GameState.log_lines().size() == say_logs
	_clear_faction_matrix()
	print("[faction] A STANDING SHIFT IS ANNOUNCED, ONCE PER VOLLEY '%s' names faction and band=%s, third-party stays silent=%s, six shifts raise %d toast(s) (want 1), logbook untouched=%s -> %s" % [
		say_text, str(say_named), str(say_quiet), say_raised, str(say_no_log),
		"PASS" if say_named and say_quiet and say_raised == 1 and say_no_log else "FAIL"])

	# A FRIENDLY IS NOT A TARGET, BUT A CHOICE. Driven through the REAL
	# selector -- rig._tap on the projected screen point -- because the defect
	# was in tap routing, not in targeting. Four clauses: the enemy locks on
	# one tap, the neutral does not, the neutral locks on a SECOND tap inside
	# the confirm window, and a neutral that has fired on the player is an
	# ordinary target again on one tap. That last clause is what keeps the
	# standing ramp alive.
	_clear_faction_matrix()
	var tap_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	tap_pilot.invulnerable = true
	tap_pilot.teleport_to(Vector3(0, 0, -600))
	var tap_rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	var tap_cam := get_viewport().get_camera_3d()
	var tap_foe := SwarmHostile.new()
	tap_foe.faction = FactionDB.FERAL
	system_root.add_child(tap_foe)
	tap_foe.global_position = Vector3(-6, 0, -600)
	var tap_friend := SwarmHostile.new()
	tap_friend.faction = "league"
	system_root.add_child(tap_friend)
	tap_friend.global_position = Vector3(6, 0, -600)
	await get_tree().process_frame
	await get_tree().process_frame
	tap_pilot.clear_target()
	tap_rig._tap(tap_cam.unproject_position(tap_foe.global_position))
	var tap_foe_locks: bool = tap_pilot.attack_target == tap_foe
	tap_pilot.clear_target()
	tap_rig._tap(tap_cam.unproject_position(tap_friend.global_position))
	var tap_friend_spared: bool = tap_pilot.attack_target != tap_friend
	tap_rig._tap(tap_cam.unproject_position(tap_friend.global_position))
	var tap_confirm_locks: bool = tap_pilot.attack_target == tap_friend
	# Now it is answering, so it is a target like any other.
	tap_pilot.clear_target()
	tap_friend.take_damage(1.0, tap_pilot)
	await get_tree().process_frame
	tap_rig._tap(tap_cam.unproject_position(tap_friend.global_position))
	var tap_answering_locks: bool = tap_pilot.attack_target == tap_friend
	print("[faction] A FRIENDLY IS NOT A TARGET, BUT A CHOICE enemy locks on one tap=%s, neutral spared=%s, neutral locks on the second=%s, one that is shooting back locks at once=%s -> %s" % [
		str(tap_foe_locks), str(tap_friend_spared), str(tap_confirm_locks),
		str(tap_answering_locks),
		"PASS" if tap_foe_locks and tap_friend_spared and tap_confirm_locks
			and tap_answering_locks else "FAIL"])

	# THE FILTER REACHES EVERY CONSUMER. Both directions in one measurement:
	# with only the neutral in range none of the three consumers may see a
	# threat, and with an enemy added all three must. Either half alone passes
	# on broken code ("nothing is ever a target" and "everything always is").
	tap_pilot.clear_target()
	tap_foe.queue_free()
	await get_tree().process_frame
	tap_friend.global_position = tap_pilot.global_position + Vector3(3, 0, 0)
	tap_friend._aggro = null
	tap_friend._target = null
	await get_tree().process_frame
	var f_auto: bool = tap_pilot._nearest_hostile_in_range() == null
	var f_cycle: bool = tap_pilot.cycle_target() == null
	var f_music: bool = not Music._threat_present()
	tap_pilot.clear_target()
	var tap_foe2 := SwarmHostile.new()
	tap_foe2.faction = FactionDB.FERAL
	system_root.add_child(tap_foe2)
	tap_foe2.global_position = tap_pilot.global_position + Vector3(-3, 0, 0)
	await get_tree().process_frame
	var f_auto2: bool = tap_pilot._nearest_hostile_in_range() == tap_foe2
	var f_cycle2: bool = tap_pilot.cycle_target() == tap_foe2
	var f_music2: bool = Music._threat_present()
	tap_pilot.clear_target()
	tap_friend.free()
	tap_foe2.free()
	tap_pilot.invulnerable = false
	_clear_faction_matrix()
	print("[faction] THE FILTER REACHES EVERY CONSUMER neutral alone: auto-target silent=%s cycle silent=%s music calm=%s; enemy added: auto=%s cycle=%s music=%s -> %s" % [
		str(f_auto), str(f_cycle), str(f_music), str(f_auto2), str(f_cycle2),
		str(f_music2),
		"PASS" if f_auto and f_cycle and f_music and f_auto2 and f_cycle2
			and f_music2 else "FAIL"])

	# A HAIL IS EARNED, AND IT FILES ONCE. The only thing a friend out here has
	# to give, and the only durable one: deep content is not persisted, so a
	# station fix would be worthless the moment the player warped, while the
	# apex dossier is saved. Three clauses: a NEUTRAL convoy says nothing, a
	# FRIENDLY one files exactly one reading at the quoted cone, and it never
	# speaks twice.
	_clear_faction_matrix()
	GameState.clear_apex_intel(system_id)
	var hail_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	hail_pilot.teleport_to(Vector3(0, 0, -900))
	var hail_dart := SwarmHostile.new()
	hail_dart.faction = "league"
	hail_dart.add_to_group("deep_convoy")
	hail_dart.set_meta("convoy_id", "harness_hail")
	system_root.add_child(hail_dart)
	hail_dart.global_position = hail_pilot.global_position + Vector3(8, 0, 0)
	await get_tree().process_frame
	var hail_key := Vector2i(4242, 4242)
	deep_space._convoys[hail_key] = {"darts": [hail_dart], "escorts": [],
		"wp": [hail_dart.global_position, hail_dart.global_position]}
	deep_space._convoy_hailed.erase(hail_key)
	deep_space._check_convoy_hails(hail_pilot.global_position)
	var hail_at_neutral := GameState.apex_hints(system_id).size()
	GameState.shift_faction(FactionDB.SURVEYOR, "league", 1)
	deep_space._check_convoy_hails(hail_pilot.global_position)
	var hail_after := GameState.apex_hints(system_id)
	var hail_filed: bool = hail_after.size() == hail_at_neutral + 1
	var hail_cone := 0.0
	if hail_filed:
		hail_cone = float((hail_after[hail_after.size() - 1] as Dictionary).get("err", -1.0))
	deep_space._check_convoy_hails(hail_pilot.global_position)
	var hail_once: bool = GameState.apex_hints(system_id).size() == hail_after.size()
	deep_space._convoys.erase(hail_key)
	hail_dart.free()
	GameState.clear_apex_intel(system_id)
	_clear_faction_matrix()
	print("[faction] A HAIL IS EARNED, AND IT FILES ONCE neutral files %d (want 0), friendly files one=%s at ±%.0f° (want ±%.0f°), never twice=%s -> %s" % [
		hail_at_neutral, str(hail_filed), hail_cone, DeepSpace.CONVOY_HINT_ERROR_DEG,
		str(hail_once),
		"PASS" if hail_at_neutral == 0 and hail_filed
			and is_equal_approx(hail_cone, DeepSpace.CONVOY_HINT_ERROR_DEG)
			and hail_once else "FAIL"])

	# DEFENDING A CONVOY IS EARNED, AND BOUNDED. Four of the seven chartfolk
	# flags had no way UP at all before this — every faction could be lost and
	# only three could be won, so the matrix was a one-way ratchet. Bounded per
	# convoy per session for the reason the nests are: a Tally pack is six to
	# eight ships, and uncapped one encounter would buy ALLIED.
	_clear_faction_matrix()
	var def_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	var def_convoy := SwarmHostile.new()
	def_convoy.faction = "league"
	def_convoy.add_to_group("deep_convoy")
	def_convoy.set_meta("convoy_id", "harness_defend")
	system_root.add_child(def_convoy)
	def_convoy.global_position = def_pilot.global_position + Vector3(14, 0, 0)
	await get_tree().process_frame
	var def_key := FactionDB.pair_key(FactionDB.SURVEYOR, "league")
	var def_attackers: Array = []
	for i_def in range(2):
		var raider := SwarmHostile.new()
		raider.faction = "unknown_a"
		system_root.add_child(raider)
		raider.global_position = def_convoy.global_position + Vector3(0, 0, 2 + i_def)
		def_attackers.append(raider)
	await get_tree().process_frame
	for a_v in def_attackers:
		a_v._target = def_convoy
	def_attackers[0].take_damage(99999.0, def_pilot)
	await get_tree().process_frame
	var def_first := int(GameState.faction_deltas.get(def_key, 0))
	def_attackers[1].take_damage(99999.0, def_pilot)
	await get_tree().process_frame
	var def_second := int(GameState.faction_deltas.get(def_key, 0))
	# And something that was hunting nobody pays nothing.
	var def_idle := SwarmHostile.new()
	def_idle.faction = "unknown_a"
	system_root.add_child(def_idle)
	def_idle.global_position = def_pilot.global_position + Vector3(0, 0, 20)
	await get_tree().process_frame
	def_idle._target = null
	def_idle._aggro = null
	def_idle.take_damage(99999.0, def_pilot)
	await get_tree().process_frame
	var def_idle_delta := int(GameState.faction_deltas.get(def_key, 0))
	if is_instance_valid(def_convoy):
		def_convoy.free()
	_clear_faction_matrix()
	print("[faction] DEFENDING A CONVOY IS EARNED, AND BOUNDED first kill %+d (want +1), second kill %+d (still +1), a kill that was hunting nobody %+d (still +1) -> %s" % [
		def_first, def_second, def_idle_delta,
		"PASS" if def_first == 1 and def_second == 1 and def_idle_delta == 1
			else "FAIL"])

	# COVERING ANYBODY'S SHIP IS EARNED, AND BOUNDED PER FLAG PER VISIT. The
	# favour used to require a `deep_convoy`, which is one of half a dozen kinds
	# of flagged ship out there — so the commonest way a player actually helps
	# somebody (wading into a border skirmish) counted for nothing.
	#
	# FOUR CLAUSES, and the middle two are the ones that make it a mechanic
	# rather than a faucet: a second rescue of the SAME flag this visit pays
	# nothing, a rescue of a DIFFERENT flag still pays, and a muster ship pays
	# nothing at all (HORIZON-4 §8 — a recurring event must not be income, in any
	# currency). Without the third clause a single per-visit latch would look
	# identical to a correct per-faction one.
	_clear_faction_matrix()
	_defended_flags = {}
	var cov_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	var cov_key := FactionDB.pair_key(FactionDB.SURVEYOR, "combine")
	var cov_key2 := FactionDB.pair_key(FactionDB.SURVEYOR, "bastion")

	# A plain flagged picket — NOT in deep_convoy — caught in a fight.
	var cov_deltas := []
	for spec_v in [
		{"flag": "combine", "muster": false, "key": cov_key},
		{"flag": "combine", "muster": false, "key": cov_key},    # same flag again
		{"flag": "bastion", "muster": false, "key": cov_key2},   # different flag
		{"flag": "bastion", "muster": true, "key": cov_key2},    # a muster ship
	]:
		var spec: Dictionary = spec_v
		var saved := Hostile.new()
		saved.faction = String(spec["flag"])
		saved.muster = bool(spec["muster"])
		system_root.add_child(saved)
		saved.global_position = cov_pilot.global_position + Vector3(16, 0, 0)
		var attacker := SwarmHostile.new()
		attacker.faction = "unknown_a"
		system_root.add_child(attacker)
		attacker.global_position = saved.global_position + Vector3(0, 0, 2)
		await get_tree().process_frame
		attacker._target = saved
		attacker.take_damage(99999.0, cov_pilot)
		await get_tree().process_frame
		cov_deltas.append(int(GameState.faction_deltas.get(String(spec["key"]), 0)))
		if is_instance_valid(saved):
			saved.free()
	_clear_faction_matrix()
	_defended_flags = {}
	print("[faction] COVERING ANYBODY IS EARNED, AND BOUNDED PER FLAG picket rescued %+d (want +1), same flag again %+d (still +1), a different flag %+d (want +1), a muster ship %+d (still +1) -> %s" % [
		cov_deltas[0], cov_deltas[1], cov_deltas[2], cov_deltas[3],
		"PASS" if cov_deltas[0] == 1 and cov_deltas[1] == 1 and cov_deltas[2] == 1
			and cov_deltas[3] == 1 else "FAIL"])

	# AND THE TOAST SAYS WHY IT MOVED. Standing that changes with no cause on
	# screen is the A10 complaint one layer up: the player watches a number move
	# and cannot tell which of the last ten seconds did it, so they cannot choose
	# to do it again. Read off the RENDERED toast rather than the format string.
	_clear_faction_matrix()
	_defended_flags = {}
	hud.clear_toast()
	var why_saved := Hostile.new()
	why_saved.faction = "league"
	system_root.add_child(why_saved)
	why_saved.global_position = cov_pilot.global_position + Vector3(16, 0, 0)
	var why_attacker := SwarmHostile.new()
	why_attacker.faction = "unknown_a"
	system_root.add_child(why_attacker)
	why_attacker.global_position = why_saved.global_position + Vector3(0, 0, 2)
	await get_tree().process_frame
	why_attacker._target = why_saved
	why_attacker.take_damage(99999.0, cov_pilot)
	await get_tree().create_timer(STANDING_TOAST_SETTLE + 0.5).timeout
	var why_line := hud.toast_text()
	if is_instance_valid(why_saved):
		why_saved.free()
	_clear_faction_matrix()
	_defended_flags = {}
	print("[faction] A STANDING TOAST SAYS WHAT EARNED IT '%s' names the act=%s, names the flag=%s, names the band it landed in=%s -> %s" % [
		why_line, str(why_line.contains("COVERED")),
		str(why_line.contains(FactionDB.display_name("league"))),
		str(why_line.contains("FRIENDLY")),
		"PASS" if why_line.contains("COVERED")
			and why_line.contains(FactionDB.display_name("league"))
			and why_line.contains("FRIENDLY") else "FAIL"])

	# --- playtest round 4 ----------------------------------------------------

	# A NEUTRAL KILL TICKS NO CONTRACT. §52 closed the picket printer by gating
	# LOOT on `pays` — and report_kill was gated on `player_kill` alone, so a
	# Cordon picket dropped no crates and still advanced `cull_sentries` (1,550
	# for three). The loot half was asserted; the contract half never was.
	#
	# BOTH DIRECTIONS, because "the neutral kind is not kill_sentry" is satisfied
	# perfectly by a build where nothing reports anything at all.
	_clear_faction_matrix()
	_defended_flags = {}
	var kinds_seen: Array[String] = []
	var kind_tally := func(kind: String) -> void: kinds_seen.append(kind)
	hostile_killed.connect(kind_tally)
	var kill_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	var neutral_mark := Hostile.new()
	neutral_mark.faction = "gsa"                 # floored at WARY, never hostile
	system_root.add_child(neutral_mark)
	neutral_mark.global_position = kill_pilot.global_position + Vector3(20, 0, 0)
	var hostile_mark := Hostile.new()
	hostile_mark.faction = FactionDB.FERAL       # baseline HOSTILE to the surveyor
	system_root.add_child(hostile_mark)
	hostile_mark.global_position = kill_pilot.global_position + Vector3(-20, 0, 0)
	await get_tree().process_frame
	neutral_mark.take_damage(99999.0, kill_pilot)
	await get_tree().process_frame
	var neutral_kind := kinds_seen[0] if kinds_seen.size() > 0 else "<none>"
	hostile_mark.take_damage(99999.0, kill_pilot)
	await get_tree().process_frame
	var hostile_kind := kinds_seen[1] if kinds_seen.size() > 1 else "<none>"
	hostile_killed.disconnect(kind_tally)
	var no_contract_wants := not ContractDB.CONTRACTS.keys().any(
		func(k: String) -> bool:
			return String(ContractDB.CONTRACTS[k].get("kind", "")) == "kill_neutral")
	print("[faction] A NEUTRAL KILL TICKS NO CONTRACT gsa reported as '%s' (no contract asks for kill_neutral=%s), feral still reported as '%s' -> %s" % [
		neutral_kind, str(no_contract_wants), hostile_kind,
		"PASS" if neutral_kind == "neutral" and no_contract_wants
			and hostile_kind == "sentry" else "FAIL"])

	# SHOOTING A NEUTRAL BRINGS ITS FRIENDS. Three machines of one flag: one hit,
	# one INSIDE the witness range of it, and one OUTSIDE. The far one is the
	# clause that matters — "the neighbour is angry" is satisfied by a dispatcher
	# that provokes the entire faction regardless of where anybody is standing,
	# which is exactly the radius decision this feature had to make.
	#
	# Read through GameState.hostile_to_player, which is the single dispatcher
	# every consumer asks, rather than off _aggro: a grudge that did not surface
	# there would be invisible to targeting, to the radar and to the music.
	_clear_faction_matrix()
	var wit_pilot: PlayerShip = get_tree().get_first_node_in_group("player")
	# PLACED BEFORE THE FIRST FRAME, EVERY ONE OF THEM, and the first draft of
	# this staging did not — it added the nodes, awaited, and only then set
	# positions. Hostile captures _home on its first _process and station-keeps
	# at `_home + wander` from then on, so the placement was overwritten and all
	# four probes sat on top of each other at the origin. The assertion reported
	# a witness 21u away that was really 0u away and had answered anyway.
	# Positions are arithmetic, so none of this needs a node in the tree first.
	var wit_at := wit_pilot.global_position + Vector3(30, 0, 0)
	var wit_victim := Hostile.new()
	wit_victim.faction = "league"
	system_root.add_child(wit_victim)
	wit_victim.global_position = wit_at
	var wit_near := Hostile.new()
	wit_near.faction = "league"
	system_root.add_child(wit_near)
	wit_near.global_position = wit_at + Vector3(FactionDB.WITNESS_RANGE - 4.0, 0, 0)
	var wit_far := Hostile.new()
	wit_far.faction = "league"
	system_root.add_child(wit_far)
	wit_far.global_position = wit_at + Vector3(FactionDB.WITNESS_RANGE + 6.0, 0, 0)
	# A DIFFERENT FLAG at the same distance as the near one, so "everything
	# nearby answers" cannot pass for "everything of that flag nearby answers".
	var wit_other := Hostile.new()
	wit_other.faction = "combine"
	system_root.add_child(wit_other)
	wit_other.global_position = wit_at + Vector3(0, 0, 3.0)
	await get_tree().process_frame
	# AND THE STAGING IS ASSERTED, not assumed — every leg of this suite that
	# skipped that step has eventually reported a reading from a setup that
	# silently did not take.
	var wit_placed: bool = \
		absf(wit_near.global_position.distance_to(wit_victim.global_position)
			- (FactionDB.WITNESS_RANGE - 4.0)) < 1.0 \
		and absf(wit_far.global_position.distance_to(wit_victim.global_position)
			- (FactionDB.WITNESS_RANGE + 6.0)) < 1.0
	var quiet_before: bool = not GameState.hostile_to_player(wit_near) \
		and not GameState.hostile_to_player(wit_far) \
		and not GameState.hostile_to_player(wit_other)
	# ONE POINT OF CHIP DAMAGE, not a kill. Splash from an OVERCHARGE is the case
	# this exists for, so the trigger cannot be death.
	wit_victim.take_damage(1.0, wit_pilot)
	await get_tree().process_frame
	var wit_hit := GameState.hostile_to_player(wit_victim)
	var wit_close := GameState.hostile_to_player(wit_near)
	var wit_distant := GameState.hostile_to_player(wit_far)
	var wit_stranger := GameState.hostile_to_player(wit_other)
	print("[faction] SHOOTING A NEUTRAL BRINGS ITS FRIENDS staged=%s, all calm first=%s; after 1 point of chip damage the ship hit=%s, its flag at %.0fu=%s, its flag at %.0fu (outside %.0f)=%s, ANOTHER flag at 3u=%s -> %s" % [
		str(wit_placed), str(quiet_before), str(wit_hit),
		FactionDB.WITNESS_RANGE - 4.0, str(wit_close),
		FactionDB.WITNESS_RANGE + 6.0, FactionDB.WITNESS_RANGE,
		str(wit_distant), str(wit_stranger),
		"PASS" if wit_placed and quiet_before and wit_hit and wit_close
			and not wit_distant and not wit_stranger else "FAIL"])

	# A GRUDGE DOES NOT MOVE THE MATRIX. Aggro and standing are separable and
	# this is the line that keeps them separated: chip damage must leave the save
	# bit-identical, while a KILL still books the -1 stage 1 has always taken.
	# Both halves, because "the matrix did not move" alone is satisfied by a
	# build where the standing hit was deleted too.
	_clear_faction_matrix()
	var grudge_key := FactionDB.pair_key(FactionDB.SURVEYOR, "league")
	var chip_mark := Hostile.new()
	chip_mark.faction = "league"
	system_root.add_child(chip_mark)
	chip_mark.global_position = wit_pilot.global_position + Vector3(40, 0, 0)
	await get_tree().process_frame
	chip_mark.take_damage(1.0, wit_pilot)
	await get_tree().process_frame
	var after_chip := int(GameState.faction_deltas.get(grudge_key, 0))
	var empty_after_chip := GameState.faction_deltas.is_empty()
	chip_mark.take_damage(99999.0, wit_pilot)
	await get_tree().process_frame
	var after_kill := int(GameState.faction_deltas.get(grudge_key, 0))
	print("[faction] A GRUDGE DOES NOT MOVE THE MATRIX chip damage -> delta %d (want 0, store empty=%s), the kill after it -> %d (want -1) -> %s" % [
		after_chip, str(empty_after_chip), after_kill,
		"PASS" if after_chip == 0 and empty_after_chip and after_kill == -1
			else "FAIL"])

	# A GRUDGE LAPSES AND LETS GO — finding A6's lesson, applied to the thing
	# that would otherwise reintroduce it. The skirmish clock EXEMPTS the player,
	# so before this an _aggro pointing at the player was never cleared by
	# anything: a picket clipped once stayed hostile until it died or the player
	# docked. Both halves, and the second is the one that fails on a build that
	# zeroes the timer without clearing the pointers.
	_clear_faction_matrix()
	var lapse_mark := Hostile.new()
	lapse_mark.faction = "league"
	system_root.add_child(lapse_mark)
	lapse_mark.global_position = wit_pilot.global_position + Vector3(40, 0, 0)
	await get_tree().process_frame
	lapse_mark.take_damage(1.0, wit_pilot)
	await get_tree().process_frame
	var lapse_during := GameState.hostile_to_player(lapse_mark)
	# Wound forward rather than waited out: GRUDGE_TIME is 30 real seconds and a
	# harness that slept through it would be measuring the sweep's patience.
	lapse_mark._grudge = 0.05
	await get_tree().create_timer(0.4).timeout
	var lapse_after := GameState.hostile_to_player(lapse_mark)
	# NO LONGER THE PLAYER, not "null". _target legitimately holds whatever else
	# this machine's flag hates and happens to be nearby, and demanding an empty
	# pointer would fail on a machine doing exactly what it should — the shape
	# §51 already had to fix on the Cordon floor check, which asserted `== null`
	# and failed on correct code once pickets had sentries to shoot at.
	var pointer_clear: bool = lapse_mark._aggro != wit_pilot \
		and lapse_mark._target != wit_pilot
	var clock_spent: bool = lapse_mark._grudge <= 0.0
	if is_instance_valid(lapse_mark):
		lapse_mark.free()
	print("[faction] A GRUDGE LAPSES AND LETS GO hostile during=%s, after %.0fs=%s, clock spent=%s, neither pointer still on the player=%s -> %s" % [
		str(lapse_during), FactionDB.GRUDGE_TIME, str(lapse_after),
		str(clock_spent), str(pointer_clear),
		"PASS" if lapse_during and not lapse_after and clock_spent
			and pointer_clear else "FAIL"])

	# THE BEAT IS STILL THE ANCHOR UNDER A GRUDGE, and A GRUDGE STOPS AT THE
	# MARKER. Both are pure-function calls at placed positions rather than
	# measurements over frames — §49's lesson twice over: no timing, no flake,
	# and the clause that fails is the one that names the defect.
	#
	# THE GRUDGE MUST WIDEN THE REACH AND NOTHING ELSE. A positive control sits
	# beside each negative one, because "refuses" is satisfied by a function that
	# always refuses and "chases" by one that always chases.
	_clear_faction_matrix()
	# THE ROUTE SITS NEAR THE MARKER, and that is not decoration. The first draft
	# put the beat at the origin and the past-the-marker probe 60u away — so the
	# REACH test refused it and the edge clamp was never consulted at all. Red-
	# verified by deleting the clamp: the assertion stayed green, which is §61's
	# trap exactly (a conjunct that rules out one cause is not one that
	# establishes the intended cause). The waypoint is now inside WITNESS_RANGE
	# of a point PAST the edge, so the clamp is the only thing that can refuse it.
	var edge_r := chart_edge()
	var beat_picket := Hostile.new()
	beat_picket.faction = "gsa"
	# ONE WAYPOINT, so the anchor cannot move underneath the measurement. With
	# two, the picket starts ON waypoint 0, _walk_beat sees it inside
	# PATROL_ARRIVE and advances _patrol_i on the very first frame — so the
	# `waypoint` read a line later named a different point than the one the
	# function was about to measure from, and an 18u probe came out 8u.
	# A one-point route is a legal degenerate beat and exercises the same branch.
	beat_picket.patrol = [Vector3(edge_r - 8.0, 0, 0)]
	system_root.add_child(beat_picket)
	beat_picket.global_position = Vector3(edge_r - 8.0, 0, 0)
	await get_tree().process_frame
	var waypoint: Vector3 = beat_picket.patrol[beat_picket._patrol_i]
	# Between PATROL_ENGAGE (12) and WITNESS_RANGE (25) of the waypoint: ignored
	# without a grudge, chased with one. That gap IS the feature.
	wit_pilot.global_position = waypoint + Vector3(0, 0, 18.0)
	await get_tree().process_frame
	var beat_calm := beat_picket._worth_leaving_the_beat(wit_pilot)
	beat_picket.provoke(wit_pilot)
	var beat_angry := beat_picket._worth_leaving_the_beat(wit_pilot)
	# And past the marker it refuses even while angry — the beacon has promised
	# since v13 that patrols do not operate out there, and until now nothing made
	# that true of a picket in PURSUIT.
	#
	# 5u PAST THE EDGE AND 13u FROM THE WAYPOINT: inside the reach the grudge
	# just widened, so the ONLY thing that can refuse this is the clamp.
	wit_pilot.global_position = Vector3(edge_r + 5.0, 0, 0)
	var edge_reach := waypoint.distance_to(wit_pilot.global_position)
	await get_tree().process_frame
	var beat_over_edge := beat_picket._worth_leaving_the_beat(wit_pilot)
	# The positive control, and it is the SAME GEOMETRY one step inside: 5u on
	# the other side of the marker, still ~13u from the waypoint. If this one did
	# not chase, the clause above would be measuring distance rather than the
	# edge.
	wit_pilot.global_position = Vector3(edge_r - 5.0, 0, 0)
	await get_tree().process_frame
	var beat_inside := beat_picket._worth_leaving_the_beat(wit_pilot)
	if is_instance_valid(beat_picket):
		beat_picket.free()
	wit_pilot.global_position = Vector3(0, 0, 6)
	print("[faction] THE BEAT IS STILL THE ANCHOR UNDER A GRUDGE at 18u from the waypoint (engage %.0f, witness %.0f): unprovoked chased=%s, provoked chased=%s; %.0fu past the marker and only %.1fu from the waypoint, provoked chased=%s, and the same geometry inside the marker chased=%s -> %s" % [
		Hostile.PATROL_ENGAGE, FactionDB.WITNESS_RANGE, str(beat_calm),
		str(beat_angry), 5.0, edge_reach, str(beat_over_edge), str(beat_inside),
		"PASS" if not beat_calm and beat_angry and not beat_over_edge
			and beat_inside and edge_reach < FactionDB.WITNESS_RANGE else "FAIL"])

	for leftover in [wit_victim, wit_near, wit_far, wit_other]:
		if is_instance_valid(leftover):
			leftover.free()

	# THE CORDON RE-FORMS, AND STOPS AT ITS STRENGTH. Two clauses that fail
	# separately: a killed picket comes back, and the relief NEVER takes the
	# Cordon past what the data authored. Either alone is worthless — the first
	# passes on an uncapped printer and the second on a build that never spawns.
	_clear_faction_matrix()
	_cordon_timer = CORDON_REFORM_INTERVAL
	var authored_routes: int = cordon_routes().size()
	for picket_v in get_tree().get_nodes_in_group("hostiles"):
		var doomed := picket_v as Hostile
		if doomed != null and is_instance_valid(doomed) and doomed.has_meta("route_i"):
			doomed.free()
	await get_tree().process_frame
	var cordon_emptied := _count_cordon()
	# Driven through the real tick rather than by calling the builder, so this
	# measures the CADENCE and its guards as well as the spawn.
	for beat_i in range(authored_routes + 3):
		_cordon_timer = 0.0
		_tick_cordon(0.016)
		await get_tree().process_frame
	var cordon_back := _count_cordon()
	var beats_free := unmanned_routes().size()
	print("[faction] THE CORDON RE-FORMS, AND STOPS AT ITS STRENGTH cleared to %d, %d relief ticks later %d of %d authored beats manned (%d still free; %d ticks were surplus and must add nothing) -> %s" % [
		cordon_emptied, authored_routes + 3, cordon_back, authored_routes,
		beats_free, 3,
		"PASS" if cordon_emptied == 0 and cordon_back == authored_routes
			and beats_free == 0 and authored_routes > 0 else "FAIL"])

	# A MUSTER LEAVES ITS SURVIVORS BEHIND. Staged with the Cordon deliberately
	# UNDER strength, because at full strength the rule is vacuous — every beat
	# is manned, nothing is retained, and a build that retained nobody at all
	# would print exactly the same line.
	# STAGED FROM FULL STRENGTH, not from whatever the leg above left. Reading
	# `open_before` off inherited state is how this reported 2 open beats when
	# the re-form was broken and failed for a reason that had nothing to do with
	# retention — the "inherits state from the one above it" shape, in the suite
	# that documents it. Rebuilt here, then exactly one beat is vacated.
	for stale_v in get_tree().get_nodes_in_group("hostiles"):
		var stale := stale_v as Hostile
		if stale != null and is_instance_valid(stale) and stale.has_meta("route_i"):
			stale.free()
	await get_tree().process_frame
	for beat_j in range(authored_routes):
		SystemBuilder.build_picket(system_def, system_root, beat_j)
	await get_tree().process_frame
	var staged_full := unmanned_routes().is_empty()
	var freed := 0
	for picket_v2 in get_tree().get_nodes_in_group("hostiles"):
		var spare := picket_v2 as Hostile
		if spare != null and is_instance_valid(spare) and spare.has_meta("route_i") \
				and freed < 1:
			spare.free()
			freed += 1
	await get_tree().process_frame
	var open_before := unmanned_routes().size()
	# Two line survivors against one open beat: one is kept, one departs. That
	# pair is the cap, and a build that kept both prints it.
	var keepers: Array[Hostile] = []
	for i_keep in range(2):
		var line_ship := Hostile.new()
		line_ship.faction = "gsa"
		line_ship.muster = true
		system_root.add_child(line_ship)
		line_ship.global_position = Vector3(0, 0, -chart_edge() + 3.0)
		line_ship.add_to_group("muster_line")
		keepers.append(line_ship)
	await get_tree().process_frame
	_muster_active = true
	_muster_cooldown = 0.0
	_close_muster(true)
	await get_tree().process_frame
	var kept_ship: Hostile = null
	for k in keepers:
		if is_instance_valid(k) and not k.is_dying():
			kept_ship = k
	var open_after := unmanned_routes().size()
	var kept_has_beat: bool = kept_ship != null and not kept_ship.patrol.is_empty() \
		and kept_ship.has_meta("route_i")
	# THE FLAG, NOT JUST THE GROUP: a retained survivor that kept `muster` would
	# stay exempt from the ambient HP floor for the rest of the session and could
	# be killed to zero by a sentry with nobody watching.
	var kept_is_ordinary: bool = kept_ship != null and not kept_ship.muster \
		and not kept_ship.is_in_group("muster_line")
	print("[faction] A MUSTER LEAVES ITS SURVIVORS BEHIND staged full=%s then %d beat(s) open, 2 line survivors -> %d open after; the keeper walks a route=%s, is no longer a muster ship=%s (the surplus one still departed=%s) -> %s" % [
		str(staged_full), open_before, open_after, str(kept_has_beat),
		str(kept_is_ordinary), str(_muster_census("muster_line") == 0),
		"PASS" if staged_full and open_before == 1 and open_after == 0
			and kept_has_beat and kept_is_ordinary
			and _muster_census("muster_line") == 0 else "FAIL"])
	_muster_active = false
	_muster_cooldown = 0.0

	# A MUSTER DOES NOT SURVIVE A WARP. _load_system cleared the boss, the raid,
	# the rift, the convoy and the wave timer, and never the muster — while
	# _tick_market hosts _tick_muster ABOVE _process's warping guard. Warp with
	# the column half-released and the rest of it spawned into the NEW system at
	# the old system's origin; warp with it fully released and the census read
	# zero, _close_muster(true) fired, and the player collected LINE HELD and a
	# step of Authority standing for leaving.
	#
	# THE STANDING CLAUSE IS THE POINT. "The event ended" is satisfied by the
	# bug — it ended, and it paid.
	_clear_faction_matrix()
	var gsa_key := FactionDB.pair_key(FactionDB.SURVEYOR, "gsa")
	_muster_active = true
	_muster_released = MUSTER_COLUMN
	_muster_point = Vector3(0, 0, -chart_edge())
	_muster_origin = Vector3(0, 0, -chart_edge() - MUSTER_DEPTH)
	_muster_cooldown = 0.0
	_load_system(system_id)
	await get_tree().process_frame
	var warp_cleared: bool = not _muster_active and _muster_released == 0
	var warp_paid := int(GameState.faction_deltas.get(gsa_key, 0))
	var warp_cooldown := _muster_cooldown
	# And nothing of the column came with it.
	var stowaways := _muster_census("muster_column") + _muster_census("muster_line")
	print("[faction] A MUSTER DOES NOT SURVIVE A WARP active cleared=%s, column ships in the new system %d (want 0), Authority standing %+d (want 0 — leaving is not holding), cooldown %.0f (want %.0f) -> %s" % [
		str(warp_cleared), stowaways, warp_paid, warp_cooldown, MUSTER_COOLDOWN,
		"PASS" if warp_cleared and stowaways == 0 and warp_paid == 0
			and warp_cooldown >= MUSTER_COOLDOWN - 1.0 else "FAIL"])

	_clear_faction_matrix()
	await get_tree().create_timer(0.2).timeout
	get_tree().quit()


func _reset_picket_clocks(h: Hostile) -> void:
	# Fixture hygiene between the escort's target assertions, and every line of it
	# is a mechanism asserted elsewhere that would otherwise race this one.
	#
	# THE SKIRMISH CLOCK IS THE ONE THAT BITES: six seconds of fire and a machine
	# BREAKS OFF, nulling _target and resting for twelve. A sub-assertion that ran
	# into that window read "the escort did not take the target" when what
	# happened was "the escort had already fought it and stood down" -- which is
	# how this test reported the opposite result on two consecutive runs.
	#
	# The aggro pointer goes too: whoever last shot the picket outranks the guard
	# scan by design, and _targetable applies no range limit, so a fixture parked
	# 400u away still holds the slot.
	h._skirmish = 0.0
	h._skirmish_rest = 0.0
	h._aggro = null
	h._target = null
	h._retarget_t = 0.0


func _park_hostile(n: Node3D, at: Vector3) -> void:
	# Puts a machine somewhere and makes it STAY there. See the note at the call
	# site: a station-keeping Hostile rewrites its own position from _home every
	# frame, so the position alone is a suggestion.
	n.global_position = at
	if n is Hostile:
		(n as Hostile)._home = at
		(n as Hostile)._home_set = true


func _run_contact_test() -> void:
	# THE FRIENDLY HALF. Two claims, and the first one is older than the second:
	# that a ship which will not fire on you does not LOOK like one that will
	# (STRATEGY §47 predicted the defect and only half-fixed it), and that there
	# is something to do with such a ship besides shoot it.
	#
	# Everything here is asserted against the FUNCTIONS THE PLAYER'S INPUT REACHES
	# -- marker_color, contact_options, contact_menu_eligible, the verbs -- rather
	# than against the rules they wrap. §54's lesson: assert the path the player
	# takes, not the function it wraps.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	# AND THE EVENTS ARE PINNED TOO, which the wave timer alone does not do. A
	# muster landing mid-run calls end_escort -- correctly, since two spawn
	# systems must not argue over one ship -- and the escort assertions below
	# then read "the picket is not covering you" when what happened is that the
	# Cordon was called to the line. It failed about one run in six before this
	# line existed, which is exactly the kind of intermittent green §33's
	# pinning list was written about. The raid cooldown is pinned for the same
	# reason now that spawn_interdiction releases an escort too.
	_muster_cooldown = 1.0e9
	_raid_cooldown = 1.0e9
	_clear_faction_matrix()
	await get_tree().create_timer(0.3).timeout

	# --- 1. THE IFF TABLE ----------------------------------------------------
	# The bug as the player met it: a Cordon picket, which cannot fire on the
	# surveyor at any standing, painted the same red as the thing hunting them.
	var picket := Hostile.new()
	picket.faction = "gsa"
	system_root.add_child(picket)
	picket.global_position = player.global_position + Vector3(6, 0, 0)
	var wild := Hostile.new()
	wild.faction = FactionDB.FERAL
	system_root.add_child(wild)
	wild.global_position = player.global_position + Vector3(-6, 0, 0)
	var trader := SwarmHostile.new()
	trader.faction = "league"
	# Neutral, so nothing acquires it -- until the player's own splash provokes it
	# (§62: any damage provokes), which is exactly what was observed happening to
	# this ship. It has to survive to the trade assertion either way.
	trader.hp_scale = 1000.0
	system_root.add_child(trader)
	trader.global_position = player.global_position + Vector3(0, 0, 6)
	await get_tree().process_frame

	var gsa_tint := FactionDB.tint_of("gsa")
	var league_tint := FactionDB.tint_of("league")
	var table_ok: bool = picket.marker_color() == gsa_tint \
		and wild.marker_color() == Palette.THREAT \
		and trader.marker_color() == league_tint
	print("[contact] THE IFF TABLE gsa picket=%s (want flag), feral=%s (want THREAT), league dart=%s (want flag) -> %s" % [
		"flag" if picket.marker_color() == gsa_tint else str(picket.marker_color()),
		"THREAT" if wild.marker_color() == Palette.THREAT else str(wild.marker_color()),
		"flag" if trader.marker_color() == league_tint else str(trader.marker_color()),
		"PASS" if table_ok else "FAIL"])

	# BOTH DIRECTIONS, because a colour that can only go red is half a fix. The
	# radar re-collects every marker every frame, so there is nothing to
	# invalidate -- the question is only whether the answer moves.
	picket.provoke(player)
	await get_tree().process_frame
	var went_red: bool = picket.marker_color() == Palette.THREAT
	# Released the way a lapsed grudge releases it: the clock AND the pointers.
	picket._grudge = 0.0
	picket._release_grudge()
	await get_tree().process_frame
	var came_back: bool = picket.marker_color() == gsa_tint
	print("[contact] THE FLIP RUNS BOTH WAYS provoked picket -> %s, grudge released -> %s -> %s" % [
		"THREAT" if went_red else "flag", "flag" if came_back else "THREAT",
		"PASS" if went_red and came_back else "FAIL"])

	# The bar is the second surface the group colour reached. A picket worn down
	# by ambient skirmishing showed a red bar over a blue hull.
	await get_tree().process_frame
	var bar_ok: bool = picket._hp_col == picket.marker_color()
	picket.provoke(player)
	await get_tree().process_frame
	await get_tree().process_frame
	var bar_follows: bool = picket._hp_col == Palette.THREAT
	picket._grudge = 0.0
	picket._release_grudge()
	await get_tree().process_frame
	await get_tree().process_frame
	print("[contact] THE BAR FOLLOWS IFF at rest bar==marker=%s, after provoke bar==THREAT=%s -> %s" % [
		str(bar_ok), str(bar_follows), "PASS" if bar_ok and bar_follows else "FAIL"])

	# --- 2. THE DOOR ---------------------------------------------------------
	# Who will talk to you at all. Each refusal below is a different reason, and
	# the muster and standoff ones are protections rather than tidiness: both
	# name conversations that already have their own surface.
	var muster_ship := Hostile.new()
	muster_ship.faction = "gsa"
	muster_ship.muster = true
	system_root.add_child(muster_ship)
	muster_ship.global_position = player.global_position + Vector3(8, 0, 8)
	var held := SwarmHostile.new()
	held.faction = "tithe"
	# Durable for the same reason as `demand` below: a Tithe dart is HOSTILE, the
	# player's mounts fire on their own, and this file writes `standoff` on it
	# after several awaits. 34hp is not a fixture, it is a countdown.
	held.hp_scale = 1000.0
	system_root.add_child(held)
	held.global_position = player.global_position + Vector3(-8, 0, 8)
	held.add_to_group("raider")
	held.standoff = 6.0
	await get_tree().process_frame

	var door := {
		"gsa picket": [picket, true],
		"league convoy escort": [trader, true],
		"feral": [wild, false],
		"muster ship": [muster_ship, false],
		"raider in standoff": [held, false],
		"the apex": [get_tree().get_first_node_in_group("apex"), false],
	}
	var door_ok := true
	var door_report: Array = []
	for name_v in door:
		var pair: Array = door[name_v]
		var want: bool = bool(pair[1])
		var got := contact_menu_eligible(pair[0])
		if got != want:
			door_ok = false
			door_report.append("%s got %s want %s" % [name_v, str(got), str(want)])
	print("[contact] THE DOOR %d cases (%s) -> %s" % [door.size(),
		"all as specified" if door_report.is_empty() else ", ".join(door_report),
		"PASS" if door_ok else "FAIL"])

	# A HOSTILE BAND IS NOT A CONVERSATION, asked through the band rather than
	# through a fixture: the Tithe is HOSTILE at baseline and left-click already
	# engages it.
	if is_instance_valid(held):
		held.standoff = 0.0
		held.remove_from_group("raider")
	await get_tree().process_frame
	var hostile_refused: bool = not contact_menu_eligible(held)
	print("[contact] A HOSTILE BAND IS NOT A CONVERSATION tithe dart out of standoff eligible=%s (want false) -> %s" % [
		str(not hostile_refused), "PASS" if hostile_refused else "FAIL"])

	# --- 3. THE LADDER -------------------------------------------------------
	# Pure over (band, ctx), so the whole reputation ramp is readable here
	# without flying a save into position for each rung.
	var bare := {"has_target": false, "is_convoy": false, "is_route_picket": false,
		"quote": 0, "repair_price": 0, "escort_ready": false, "in_combat": false}
	var rich := {"has_target": true, "is_convoy": true, "is_route_picket": true,
		"quote": 900, "repair_price": 560, "escort_ready": true, "in_combat": false}
	var want_ladder := {
		FactionDB.Band.HOSTILE: [],
		FactionDB.Band.WARY: ["hail_contact", "engage_contact"],
		FactionDB.Band.NEUTRAL: ["hail_contact", "engage_contact"],
		FactionDB.Band.FRIENDLY: ["hail_contact", "hail_bearings", "space_trade",
			"engage_contact"],
		FactionDB.Band.ALLIED: ["hail_contact", "hail_bearings", "space_trade",
			"field_repair", "request_escort", "mark_target_for", "engage_contact"],
	}
	var ladder_ok := true
	var ladder_report: Array = []
	for band_v in want_ladder:
		var band := int(band_v)
		var ctx: Dictionary = bare if band >= FactionDB.Band.NEUTRAL else rich
		var got_verbs: Array = []
		for o_v in HUD.contact_options(band, ctx):
			got_verbs.append(String((o_v as Dictionary)["verb"]))
		var want_verbs: Array = want_ladder[band_v]
		if got_verbs != want_verbs:
			ladder_ok = false
			ladder_report.append("%s got %s" % [FactionDB.BAND_NAMES[band], str(got_verbs)])
	# EVERY SITUATIONAL ROW IS SITUATIONAL. An ALLIED ship with none of the
	# circumstances offers exactly what a NEUTRAL one does, plus its bearings --
	# so the band opens a door and the world decides what is behind it.
	var allied_bare: Array = []
	for o_v in HUD.contact_options(FactionDB.Band.ALLIED, bare):
		allied_bare.append(String((o_v as Dictionary)["verb"]))
	var situational: bool = allied_bare == ["hail_contact", "hail_bearings", "engage_contact"]
	print("[contact] THE LADDER 5 bands (%s); ALLIED with no circumstances = %s -> %s" % [
		"exact" if ladder_report.is_empty() else ", ".join(ladder_report),
		str(allied_bare), "PASS" if ladder_ok and situational else "FAIL"])

	# --- 4. WHAT THE VERBS DO ------------------------------------------------
	GameState.shift_faction(FactionDB.SURVEYOR, "gsa", 4)      # 0 -> +4, ALLIED
	await get_tree().process_frame
	var allied_now: bool = GameState.faction_band("gsa", FactionDB.SURVEYOR) \
		== FactionDB.Band.ALLIED

	engage_contact(picket)
	var engaged: bool = player.attack_target == picket
	# AND THE RETICLE TURNS WHEN THE SHIP ANSWERS, NOT WHEN YOU GIVE THE ORDER --
	# which is the honest claim and the one the code makes. fights_the_player()
	# reads _aggro and _target, and the player's ORDER sets neither; what sets
	# them is the first shot landing. So the answer is what gets asserted, through
	# the real path a player shot takes (take_damage with the player as attacker),
	# rather than by racing the mounts for a frame -- which is what an earlier
	# version of this line did, and it failed about one run in four.
	picket.take_damage(1.0, player)
	await get_tree().process_frame
	var engage_red: bool = picket.marker_color() == Palette.THREAT
	player.clear_target()
	picket._aggro = null
	picket._target = null
	await get_tree().process_frame
	print("[contact] ENGAGE IS AN ORDER standing pinned ALLIED=%s, target set=%s, marker went THREAT=%s -> %s" % [
		str(allied_now), str(engaged), str(engage_red),
		"PASS" if allied_now and engaged and engage_red else "FAIL"])

	# MARK MY TARGET is the existing grudge, pointed somewhere useful: aggro with
	# an expiry, and never a band.
	var deltas_before := GameState.faction_deltas.duplicate(true)
	player.command_attack(wild)
	mark_target_for(picket)
	var marked: bool = picket._aggro == wild and picket._grudge > 0.0
	var mark_quiet: bool = GameState.faction_deltas == deltas_before
	player.clear_target()
	picket._grudge = 0.0
	picket._aggro = null
	print("[contact] MARK MY TARGET ally aggro=%s grudge=%.0fs, standing untouched=%s -> %s" % [
		str(marked), FactionDB.GRUDGE_TIME, str(mark_quiet),
		"PASS" if marked and mark_quiet else "FAIL"])

	# --- 5. THE QUOTE IS THE TRADE -------------------------------------------
	# The two exclusions are the whole assertion. Contraband has a named list of
	# buyers and that list IS the route problem it exists to create; a chart runs
	# the ledger and the commission pipeline on its way out.
	for id in GameState.cargo.keys():
		GameState.unload_cargo(String(id), 99)
	GameState.load_cargo("alloys", 3)
	GameState.load_cargo("contraband", 1)
	GameState.load_cargo("chart_shoal", 1)
	var quote := space_trade_quote()
	var want_total := int(round(float(CommodityDB.base_price("alloys"))
		* CommodityDB.SPACE_TRADE_RATE)) * 3
	var quote_ok: bool = int(quote["total"]) == want_total \
		and (quote["goods"] as Dictionary).has("alloys") \
		and not (quote["goods"] as Dictionary).has("contraband") \
		and not (quote["goods"] as Dictionary).has("chart_shoal")
	print("[contact] THE QUOTE IS THE TRADE alloys x3 + BANNED + a chart -> %d (want %d), goods %s -> %s" % [
		int(quote["total"]), want_total, str((quote["goods"] as Dictionary).keys()),
		"PASS" if quote_ok else "FAIL"])

	# AND IT PAYS EXACTLY THAT, AND NOTHING ELSE MOVES. No trade pressure (there
	# is no port), no smuggling ladder (that feed is the fence's), no standing
	# (payment is not a favour).
	GameState.shift_faction(FactionDB.SURVEYOR, "league", 2)   # 0 -> +2, FRIENDLY
	trader.add_to_group("deep_convoy")
	var salvage_before := GameState.salvage
	var smug_before := GameState.smuggling
	deltas_before = GameState.faction_deltas.duplicate(true)
	space_trade(trader)
	await get_tree().process_frame
	var paid: bool = GameState.salvage - salvage_before == want_total
	var left_aboard: bool = GameState.cargo_count("alloys") == 0 \
		and GameState.cargo_count("contraband") == 1 \
		and GameState.cargo_count("chart_shoal") == 1
	var trade_quiet: bool = GameState.smuggling == smug_before \
		and GameState.faction_deltas == deltas_before
	print("[contact] THE SALE PAYS THE QUOTE +%d salvage (want %d), restricted cargo still aboard=%s, smuggling and standing untouched=%s -> %s" % [
		GameState.salvage - salvage_before, want_total, str(left_aboard), str(trade_quiet),
		"PASS" if paid and left_aboard and trade_quiet else "FAIL"])

	# --- 6. REPAIRS ARE GATED, NEVER PRICED ----------------------------------
	# Market's NO PRICE MOVES WITH STANDING is asserted elsewhere against Market's
	# own functions; this is the same claim about the one price this feature
	# introduces. What ALLIED buys is the option, at the dock's own figure.
	#
	# EVERY HOSTILE FIXTURE GOES FIRST, and the reason is itself an assertion.
	# The feral and the Tithe dart stood within Music.THREAT_RADIUS through
	# everything above, and the repair gate refused every purchase while they did
	# -- correctly, and it took two tries to notice, which is the gate working.
	# The GSA picket standing just as close does NOT refuse them. That is the
	# _threat_near_player fix read from the side: the lighting and the score had
	# drifted from Music's copy of the same scan and were calling a friendly ship
	# a fight, which is the radar's defect one instrument over.
	# MOVING A STATION-KEEPER DOES NOT MOVE IT. Hostile._process ASSIGNS
	# `global_position = _home + beat + wander` every frame for a machine with no
	# patrol, so a fixture shoved aside is back on its post next frame -- the same
	# property that makes an escort offer refuse station-keepers. _home is the
	# real handle, and `wild` is relocated rather than freed because section 7
	# needs a live feral to point the escort at.
	var moved_off := 0
	for n_v in get_tree().get_nodes_in_group("hostiles"):
		var n3 := n_v as Node3D
		if not is_instance_valid(n3) or not GameState.hostile_to_player(n3):
			continue
		moved_off += 1
		if n3 == wild:
			_park_hostile(n3, player.global_position + Vector3(400, 0, 0))
		else:
			n3.queue_free()
	await get_tree().process_frame
	await get_tree().process_frame
	var no_fight: bool = not _threat_near_player()
	print("[contact] A FRIENDLY SHIP IS NOT A FIGHT %d hostiles moved off, a gsa picket left %.0fu away, in combat=%s (want false) -> %s" % [
		moved_off, player.global_position.distance_to(picket.global_position),
		str(not no_fight), "PASS" if no_fight else "FAIL"])
	for id2 in GameState.cargo.keys():
		GameState.unload_cargo(String(id2), 99)
	GameState.salvage = 100000
	player.shield = player.shield_max * 0.4
	var want_price := int(round(0.6 * float(PortPanel.REPAIR_FULL_PRICE)))
	var before_repair := GameState.salvage
	field_repair(picket)
	var spent := before_repair - GameState.salvage
	var healed: bool = is_equal_approx(player.shield, player.shield_max)
	# Same call one band down: refused, and it costs nothing to be refused.
	GameState.shift_faction(FactionDB.SURVEYOR, "gsa", -2)      # +4 -> +2, FRIENDLY
	player.shield = player.shield_max * 0.4
	var friendly_before := GameState.salvage
	field_repair(picket)
	var friendly_refused: bool = GameState.salvage == friendly_before \
		and player.shield < player.shield_max
	print("[contact] REPAIRS ARE GATED, NEVER PRICED ALLIED spent %d (want %d, the dock's own formula) and healed=%s; FRIENDLY refused=%s -> %s" % [
		spent, want_price, str(healed), str(friendly_refused),
		"PASS" if spent == want_price and healed and friendly_refused else "FAIL"])

	# THE PRICE IS BAND-BLIND ACROSS THE BAND ITSELF: +4 and +6 are both ALLIED,
	# and a price that moved between them would be a price consulting standing.
	GameState.shift_faction(FactionDB.SURVEYOR, "gsa", 2)       # +2 -> +4
	player.shield = player.shield_max * 0.4
	var at_four := GameState.salvage
	field_repair(picket)
	var price_four := at_four - GameState.salvage
	GameState.shift_faction(FactionDB.SURVEYOR, "gsa", 2)       # +4 -> +6
	player.shield = player.shield_max * 0.4
	var at_six := GameState.salvage
	field_repair(picket)
	var price_six := at_six - GameState.salvage
	# And never mid-fight: the shared combat oracle refuses, so a full heal can
	# never be bought out of a fight the player is losing. Its own machine rather
	# than one of the fixtures above -- the player's mounts fire on a locked
	# target by themselves, so anything this file has pointed the ship at once
	# may not be alive by the time a later section wants it.
	var menace := Hostile.new()
	menace.faction = FactionDB.FERAL
	system_root.add_child(menace)
	_park_hostile(menace, player.global_position + Vector3(2, 0, 0))
	player.shield = player.shield_max * 0.4
	await get_tree().process_frame
	var in_fight := GameState.salvage
	field_repair(picket)
	var fight_refused: bool = GameState.salvage == in_fight
	menace.queue_free()
	await get_tree().process_frame
	print("[contact] THE PRICE IS BAND-BLIND +4 costs %d, +6 costs %d (want equal); refused with a hostile inside %.0fu=%s -> %s" % [
		price_four, price_six, Music.THREAT_RADIUS, str(fight_refused),
		"PASS" if price_four == price_six and price_four > 0 and fight_refused else "FAIL"])

	# --- 7. THE ESCORT -------------------------------------------------------
	# The one verb that puts a second gun on the board, so it carries the most
	# assertions. The first is that the beat it left is still counted as manned:
	# a picket out walking whose route reported empty would have the cordon tick
	# spawn a relief, and the Cordon would quietly double.
	player.shield = player.shield_max
	GameState.salvage = 100000
	var route_count := cordon_routes().size()
	var beat: Array[Vector3] = [
		player.global_position + Vector3(14, 0, 0),
		player.global_position + Vector3(14, 0, 14),
	]
	picket.patrol = beat
	picket.set_meta("route_i", 0)
	_escort_cd = 0.0
	request_escort(picket)
	await get_tree().process_frame
	var riding: bool = picket.escorting()
	var still_manned: bool = not unmanned_routes().has(0)
	print("[contact] THE ESCORT LEAVES THE BEAT MANNED escorting=%s, route 0 of %d still counted=%s -> %s" % [
		str(riding), route_count, str(still_manned),
		"PASS" if riding and still_manned else "FAIL"])

	# FIGHTS WHAT FIGHTS THE PLAYER, and does not answer a demand that was put to
	# the player: the parley is the player's conversation, for the escort exactly
	# as for a picket on its beat.
	_park_hostile(wild, player.global_position + Vector3(8, 0, 0))
	_reset_picket_clocks(picket)
	await get_tree().create_timer(0.6).timeout
	var answers: bool = picket._target == wild
	_park_hostile(wild, player.global_position + Vector3(400, 0, 0))
	# THE PARLEY EXCLUSION, ISOLATED TO THE ESCORT SCAN. It has to be a flag the
	# PICKET has no quarrel with, or the assertion proves nothing: the GSA is
	# HOSTILE to the Tithe at baseline, so a Tithe raider is picked up by the
	# ordinary enemy scan whatever the escort thinks, and a test using one would
	# report the escort's exclusion broken when it was never consulted. A League
	# sentry is FRIENDLY to the GSA and appears in no enemy list, so the escort
	# scan is the ONLY thing that can select it.
	#
	# ASKED OF _pick_target DIRECTLY, and that is the difference between an
	# assertion and a coin toss. Run against the live world these two questions
	# fought each other: the picket shoots the bystander, the bystander answers
	# the picket, and _aggro -- which outranks the guard scan by design -- ends up
	# holding the very ship the second half is trying to prove is ignored. The
	# rule under test IS this function, so it is called with the clocks pinned and
	# nothing in flight, which answers the same question the same way every run.
	# THE NEIGHBOURHOOD IS CLEARED FIRST, and the reason is the mechanic this
	# whole feature spent a day establishing is deliberate. The guard scan takes
	# the NEAREST ship fighting the player, so the assertion only means what it
	# says if the bystander is the nearest one -- and earlier sections leave a
	# league trader 6u out that the player's own splash has by then provoked
	# (§62: "any damage provokes, including one point of splash"). It read as
	# "the escort ignored the bystander" about one run in six, when what happened
	# was the escort correctly covering a closer ship.
	# EVERY OTHER SHIP, NOT JUST THE ONES THAT ARE HOSTILE RIGHT NOW -- and that
	# distinction is the whole fix. Filtering on hostile_to_player at this instant
	# missed a League trader sitting 6u out that was still NEUTRAL when the loop
	# ran and had been provoked by the time _pick_target was called one frame
	# later, because the player's mounts fire on their own and §62's rule is that
	# any damage provokes. A fixture that asks "who is hostile now" races a world
	# that is still deciding.
	for n_v in get_tree().get_nodes_in_group("hostiles"):
		var n4 := n_v as Node3D
		if is_instance_valid(n4) and n4 != picket:
			_park_hostile(n4, player.global_position + Vector3(400, 0, 0))
	var bystander := Hostile.new()
	bystander.faction = "league"
	system_root.add_child(bystander)
	_park_hostile(bystander, player.global_position + Vector3(7, 0, 0))
	bystander.provoke(player)                   # hostile to the player, to nobody else
	await get_tree().process_frame

	_reset_picket_clocks(picket)
	var picked_open := picket._pick_target(0.0)
	var covered: bool = picked_open == bystander

	bystander.add_to_group("raider")
	bystander.standoff = 9.0
	_reset_picket_clocks(picket)
	var picked_held := picket._pick_target(0.0)
	var left_parley_alone: bool = picked_held != bystander

	bystander.standoff = 0.0
	bystander.queue_free()
	_reset_picket_clocks(picket)
	print("[contact] THE ESCORT ANSWERS FOR YOU took the feral near the player=%s; covered a flag only the player was fighting=%s, then ignored the same ship in standoff=%s (picked %s) -> %s" % [
		str(answers), str(covered), str(left_parley_alone),
		"nothing" if picked_held == null else "it",
		"PASS" if answers and covered and left_parley_alone else "FAIL"])

	# IT CANNOT DEPLETE THE WORLD (§51). Not a new rule -- SKIRMISH_HP_FLOOR
	# already clamps damage from any combatant, so fire support can soften and
	# can never finish. Asserted through the escort because that is the new way
	# for an NPC to be shooting on the player's behalf.
	var quarry := Hostile.new()
	quarry.faction = "gnomon"
	system_root.add_child(quarry)
	quarry.global_position = player.global_position + Vector3(0, 0, 20)
	await get_tree().process_frame
	for _i in range(40):
		quarry.take_damage(50.0, picket)
	var floored: bool = quarry.hp >= quarry.max_hp * FactionDB.SKIRMISH_HP_FLOOR \
		and not quarry.is_dying()
	print("[contact] THE ESCORT CANNOT FINISH ANYTHING 2000 damage from an ally leaves %.0f/%.0f hp (floor %.0f), alive=%s -> %s" % [
		quarry.hp, quarry.max_hp, quarry.max_hp * FactionDB.SKIRMISH_HP_FLOOR,
		str(not quarry.is_dying()), "PASS" if floored else "FAIL"])
	quarry.queue_free()

	# AND IT STOPS AT THE MARKER. The band-1 beacon has promised since v13 that
	# patrols do not operate past the edge; an escort is the first Cordon ship
	# that could ever have been invited across it.
	var home := player.global_position
	player.global_position = Vector3(0, 0, -(chart_edge() + 30.0))
	await get_tree().create_timer(0.4).timeout
	var let_go: bool = not picket.escorting()
	player.global_position = home
	print("[contact] THE ESCORT STOPS AT THE MARKER player %.0fu out (edge %.0f) -> escorting=%s -> %s" % [
		chart_edge() + 30.0, chart_edge(), str(picket.escorting()),
		"PASS" if let_go else "FAIL"])

	# --- 7b. WHAT THE REVIEW FOUND -------------------------------------------
	# Four defects that the feature harness above was green through, because
	# every one of them lives at a seam between the new code and a rule that was
	# already written down somewhere else.

	# THE ESCORT DOES NOT ANSWER THE PLAYER'S PARLEY, ON THE GUN AS WELL AS THE
	# FEET. The guard scan excluded a standoff raider from the day it was
	# written; the ORDINARY enemy scan below it did not, and the GSA is HOSTILE
	# to the Tithe at baseline, so a picket parked 4u off the player had the
	# whole pack inside its 9u ENGAGE_RANGE and one shot called break_parley.
	# Asserted against _pick_target, which is where every consumer -- the gun,
	# the feet and the skirmish clock -- gets its pointer.
	var demand := SwarmHostile.new()
	demand.faction = "tithe"
	# UNKILLABLE FOR THE LENGTH OF THE ASSERTION, and set before add_child because
	# _ready reads it. A Tithe dart is HOSTILE to the surveyor, so the player's
	# mounts acquire and fire on it without being told to, and 34hp does not
	# survive being parked ten units from the ship. When it died mid-assertion the
	# `standoff` write below hit a freed object, the script error killed the
	# coroutine, and the harness never reached quit() -- so the suite did not fail,
	# it HUNG for the full 1500s timeout. A fixture that can be destroyed by the
	# thing it is measuring is not a fixture.
	demand.hp_scale = 1000.0
	system_root.add_child(demand)
	demand.global_position = picket.global_position + Vector3(2, 0, 0)
	demand.add_to_group("raider")
	await get_tree().process_frame
	_reset_picket_clocks(picket)
	var without_standoff := picket._pick_target(0.0)
	var demand_lived := is_instance_valid(demand)
	if demand_lived:
		demand.standoff = 6.0
	_reset_picket_clocks(picket)
	var with_standoff := picket._pick_target(0.0)
	var parley_safe: bool = demand_lived and without_standoff == demand \
		and with_standoff != demand
	print("[contact] NOBODY ELSE ANSWERS YOUR PARLEY a Tithe raider 2u from a GSA picket is taken=%s, the same raider under a standoff is taken=%s (want false) -> %s" % [
		str(without_standoff == demand), str(with_standoff == demand),
		"PASS" if parley_safe else "FAIL"])

	# AND A RAID RELEASES THE ESCORT OUTRIGHT, so the picket is not standing in
	# the middle of a demand it could answer by accident.
	if is_instance_valid(demand):
		demand.standoff = 0.0
		demand.queue_free()
	await get_tree().process_frame
	_escort_cd = 0.0
	request_escort(picket)
	var riding_again: bool = picket.escorting()
	spawn_interdiction()
	var raid_released: bool = not picket.escorting()
	for r_v in get_tree().get_nodes_in_group("raider"):
		if is_instance_valid(r_v):
			(r_v as Node).queue_free()
	_raid_active = false
	_raid_cooldown = 1.0e9
	await get_tree().process_frame
	print("[contact] A RAID TAKES THE ESCORT BACK escorting before=%s, after the klaxon=%s (want false) -> %s" % [
		str(riding_again), str(picket.escorting()),
		"PASS" if riding_again and raid_released else "FAIL"])

	# THE STATION IS INSIDE THE MARKER, NOT JUST THE PLAYER. _tick_escort ends an
	# escort when the PLAYER crosses; a player sitting just inside the line with
	# their nose pointed inward put the station up to ESCORT_FOLLOW past it.
	_escort_cd = 0.0
	request_escort(picket)
	var edge_r := chart_edge()
	# Just inside the line, facing inward, so the station falls outside it.
	player.global_position = Vector3(0, 0, -(edge_r - 1.0))
	player.look_at(Vector3(0, 0, -(edge_r + 40.0)), Vector3.UP)
	await get_tree().process_frame
	var station: Vector3 = picket._escort_station()
	var station_r := Vector2(station.x, station.z).length()
	var station_in: bool = station_r <= edge_r
	player.global_position = home
	print("[contact] THE STATION IS INSIDE THE MARKER TOO station at %.1fu against an edge of %.0f -> %s" % [
		station_r, edge_r, "PASS" if station_in else "FAIL"])

	# A HAIL DOES NOT READ A PROPERTY THE SHIP HAS NOT GOT. `designation` is
	# declared on Hostile and not on SwarmHostile, and Object.get() answers null
	# for a missing one -- which String() renders as "<null>".
	var dart := SwarmHostile.new()
	dart.faction = "league"
	system_root.add_child(dart)
	dart.global_position = player.global_position + Vector3(4, 0, 0)
	dart.add_to_group("deep_convoy")
	await get_tree().process_frame
	var toast_before := hud.toast_text()
	hail_contact(dart)
	await get_tree().process_frame
	var hailed := hud.toast_text()
	var clean_hail: bool = hailed != toast_before and not hailed.contains("<null>") \
		and not hailed.contains("null")
	print("[contact] A HAIL NAMES ONLY WHAT IS THERE dart with no designation -> '%s' -> %s" % [
		hailed, "PASS" if clean_hail else "FAIL"])

	# A FAVOUR IS NOT A VENDETTA. MARK MY TARGET points an ALLY at an NPC, and
	# _release_grudge used to let go of the PLAYER specifically -- every caller
	# before the contact menu passed the player, so the narrower test read as
	# the same sentence. The clock ran out and the pointer did not, which is the
	# unbounded latch that function exists to prevent.
	player.command_attack(dart)
	mark_target_for(picket)
	var pointed: bool = picket._aggro == dart
	picket._grudge = 0.0
	picket._release_grudge()
	var favour_ended: bool = picket._aggro == null
	player.clear_target()
	_reset_picket_clocks(picket)
	dart.queue_free()
	await get_tree().process_frame
	print("[contact] A FAVOUR IS NOT A VENDETTA ally pointed at an NPC=%s, and lets go when the grudge lapses=%s -> %s" % [
		str(pointed), str(favour_ended),
		"PASS" if pointed and favour_ended else "FAIL"])

	# THE ESCORT STANDS CLEAR OF YOUR OWN BLAST. Asserted as a RELATIONSHIP
	# between two constants that live in different classes, rather than as either
	# literal, because the failure was not a wrong number -- it was two right
	# numbers nobody had put beside each other. A station inside
	# OVERCHARGE_RADIUS meant the free starter core turned the player's bodyguard
	# into an enemy on a button press that cannot be declined.
	var clear_of_blast: bool = Hostile.ESCORT_FOLLOW > PlayerShip.OVERCHARGE_RADIUS
	print("[contact] THE ESCORT STANDS CLEAR OF YOUR OWN BLAST station %.1fu against OVERCHARGE_RADIUS %.1fu -> %s" % [
		Hostile.ESCORT_FOLLOW, PlayerShip.OVERCHARGE_RADIUS,
		"PASS" if clear_of_blast else "FAIL"])

	# --- 8. THE MENU CLOSES ITSELF -------------------------------------------
	# Four ways a conversation ends without the player ending it. Each one leaves
	# the plate pointing at something that is no longer what it described.
	_escort_cd = 0.0
	hud.show_contact_menu(picket)
	var opened: bool = hud.contact_menu_open()
	picket.provoke(player)                      # it turns on you mid-sentence
	await get_tree().process_frame
	await get_tree().process_frame
	var closed_on_hostile: bool = not hud.contact_menu_open()
	picket._grudge = 0.0
	picket._release_grudge()
	await get_tree().process_frame

	hud.show_contact_menu(picket)
	var reopened: bool = hud.contact_menu_open()
	GameState.shift_faction(FactionDB.SURVEYOR, "gsa", -6)      # ALLIED -> WARY
	await get_tree().process_frame
	await get_tree().process_frame
	var closed_on_band: bool = not hud.contact_menu_open()

	hud.show_contact_menu(picket)
	var open_again: bool = hud.contact_menu_open()
	picket.queue_free()                         # it dies mid-sentence
	await get_tree().process_frame
	await get_tree().process_frame
	var closed_on_death: bool = not hud.contact_menu_open()
	print("[contact] THE MENU CLOSES ITSELF opened=%s; on turning hostile=%s, on a band change=%s (reopened=%s), on the ship dying=%s (reopened=%s) -> %s" % [
		str(opened), str(closed_on_hostile), str(closed_on_band), str(reopened),
		str(closed_on_death), str(open_again),
		"PASS" if opened and reopened and open_again and closed_on_hostile
			and closed_on_band and closed_on_death else "FAIL"])

	# A MENU IS NOT A CONSOLE, and this is the assertion that keeps it that way.
	# console_open() gates interdiction and muster eligibility, so a plate that
	# registered as a console would hold the world's events off while it stood.
	# Guarded, every one: the player's mounts fire on a locked target without
	# being told to, so a fixture this file aimed at earlier may already be gone.
	for spent_v in [wild, trader, muster_ship, held]:
		if is_instance_valid(spent_v):
			(spent_v as Node).queue_free()
	await get_tree().process_frame
	var quiet_world := SwarmHostile.new()
	quiet_world.faction = "league"
	system_root.add_child(quiet_world)
	quiet_world.global_position = player.global_position + Vector3(5, 0, 0)
	await get_tree().process_frame
	hud.show_contact_menu(quiet_world)
	var menu_up: bool = hud.contact_menu_open()
	var not_a_console: bool = not console_open()
	hud.hide_contact_menu()
	quiet_world.queue_free()
	print("[contact] A MENU IS NOT A CONSOLE menu open=%s, console_open()=%s (want false) -> %s" % [
		str(menu_up), str(console_open()),
		"PASS" if menu_up and not_a_console else "FAIL"])

	_clear_faction_matrix()
	for id3 in GameState.cargo.keys():
		GameState.unload_cargo(String(id3), 99)
	await get_tree().create_timer(0.2).timeout
	get_tree().quit()


func _run_damage_test() -> void:
	# DAMAGE CONTROL. Sections, the diversion trade, and the one console that
	# stops the clock.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	GameState.diverts = {}
	await get_tree().create_timer(0.3).timeout

	# --- 1. the ladder is outside-in, and the core never goes -----------------
	# Asserted as a TABLE rather than at one integrity, because the property is
	# the ORDER: a section that failed before the one outboard of it would be a
	# different ship, and a single sample cannot see order at all.
	var ladder_bad := ""
	var ladder_report := ""
	for spec_v in [
		{"at": 1.00, "want": []},
		{"at": 0.70, "want": ["mount_b"]},
		{"at": 0.50, "want": ["mount_b", "drive"]},
		{"at": 0.30, "want": ["mount_b", "drive", "mount_a"]},
		{"at": 0.05, "want": ["mount_b", "drive", "mount_a", "array"]},
	]:
		var spec: Dictionary = spec_v
		var got := SectionDB.damaged_ids(float(spec["at"]))
		ladder_report += "%d%%:%d " % [int(float(spec["at"]) * 100.0), got.size()]
		if got != (spec["want"] as Array):
			ladder_bad = "at %.0f%% got %s wanted %s" % [
				float(spec["at"]) * 100.0, str(got), str(spec["want"])]
	# AND THE THRESHOLDS THEMSELVES DESCEND. damaged_ids walks SECTIONS in
	# declaration order, so the expected lists above would match whatever the
	# thresholds were as long as the table stayed in the same order -- the check
	# read like an ordering test and was really a declaration-order test.
	# Comparing each fails_at to the one before is the property "outside-in"
	# actually means, and it goes red if anyone reshuffles the table.
	var descending := true
	var prev := 2.0
	for s_v in SectionDB.SECTIONS:
		var at := float((s_v as Dictionary)["fails_at"])
		if at < 0.0:
			continue          # the core, which has no threshold at all
		if at >= prev:
			descending = false
		prev = at
	# The core is the thing doing the routing, so a dead core would mean a panel
	# that goes blank exactly when it is needed. Checked at zero, not at a
	# plausible number: the claim is "never", and never includes destroyed. The
	# is_section half matters: is_damaged also returns false for an id that does
	# not exist, so without it this passes for a typo.
	var core_holds: bool = SectionDB.is_section("core") \
		and not SectionDB.is_damaged("core", 0.0)
	print("[damage] THE LADDER RUNS OUTSIDE-IN %s(%s); thresholds descend=%s; core is a real section and alive at 0%%=%s -> %s" % [
		ladder_report, ladder_bad if ladder_bad != "" else "ordered",
		str(descending), str(core_holds),
		"PASS" if ladder_bad == "" and descending and core_holds else "FAIL"])

	# --- 2. only a broken section may be spent, and only on a working one -----
	# Driven through divert_power, which is where the rule lives. The first
	# version of this mechanic left the test in the panel's `disabled` flag,
	# where no assertion could reach it and a second caller would have skipped
	# it entirely.
	GameState.diverts = {}
	var whole_refused: bool = not GameState.divert_power("mount_a", "drive", 1.0)
	var onto_broken: bool = not GameState.divert_power("mount_b", "drive", 0.50)
	var legal: bool = GameState.divert_power("mount_b", "core", 0.70)
	print("[damage] POWER COMES ONLY FROM A BROKEN SECTION intact source refused=%s, broken target refused=%s, broken->working allowed=%s -> %s" % [
		str(whole_refused), str(onto_broken), str(legal),
		"PASS" if whole_refused and onto_broken and legal else "FAIL"])

	# --- 3. nothing is spent twice -------------------------------------------
	# FOUR ways to double-spend, all closed. The fourth -- two sources into one
	# target -- was missing from both the code and this assertion, and it was the
	# expensive one: at low integrity every non-core section is damaged and the
	# core is the only always-legal target, so four taps multiplied its boost to
	# 1.75^4 and the discharge hit for nine times its rated burst. The panel
	# happened to grey the row, which is the rule living in the rendering again.
	# EACH COLUMN MUST BE REFUSED BY THE RULE IT NAMES, and two of them were not.
	# `onto a dark section` used mount_b as a target at 30%, where mount_b is
	# damaged anyway (fails_at 0.78) -- so the damaged-target rule refused it and
	# the burned-target rule was never reached. `out of a carrier` used the core
	# as a source, which can never be a source at any integrity. Both printed
	# `true` on code with the check they name deleted.
	#
	# Isolating them needs integrity to MOVE, which is exactly what shields do:
	# a section burned at 30% is no longer damaged once regen carries the ship
	# back to 90%, and a section boosted at 50% becomes damaged if the ship falls
	# to 10%. Those are the only states in which the two rules are load-bearing,
	# and they are ordinary play.
	GameState.diverts = {}
	GameState.divert_power("mount_b", "core", 0.30)
	var twice: bool = not GameState.divert_power("mount_b", "array", 0.30)
	# THE BURNED-TARGET COLUMN, ON ITS THIRD ATTEMPT, AND THE SECOND TWO WERE THE
	# SAME MISTAKE AS THE FIRST.
	#
	#   v1: drive -> mount_b @ 0.30. mount_b is damaged at 0.30, so the
	#       damaged-TARGET rule refused it.
	#   v2: drive -> mount_b @ 0.90. 0.78 is the highest threshold in the table,
	#       so at 90% NOTHING is damaged -- including the source. The
	#       damaged-SOURCE rule refused it, five guards before the one named.
	#       The added `not is_damaged(target)` conjunct excluded v1's cause and
	#       said nothing about the new one, so the fix moved the vacuity.
	#
	# The rule is only load-bearing when the source IS damaged and the target is
	# dark but repaired, which needs two different integrities: burn mount_a at
	# 30% (below its 0.40), then attempt at 50%, where the drive is still broken
	# (below 0.58) and mount_a is not. Both conjuncts are asserted so the next
	# reader can see which state this depends on.
	GameState.diverts = {}
	GameState.divert_power("mount_a", "core", 0.30)
	var onto_burned: bool = not GameState.divert_power("drive", "mount_a", 0.50) \
		and SectionDB.is_damaged("drive", 0.50) \
		and not SectionDB.is_damaged("mount_a", 0.50)
	# The core CARRIES power and, being un-failable, is refused as a source by
	# the carrier rule rather than by the damaged-source rule... which cannot
	# distinguish. So stage a carrier that IS damaged: burn into the array while
	# it is healthy, then drop to an integrity where the array itself is broken.
	GameState.diverts = {}
	GameState.divert_power("drive", "array", 0.50)
	var carrier_now_damaged: bool = SectionDB.is_damaged("array", 0.10)
	var from_carrier: bool = not GameState.divert_power("array", "core", 0.10) \
		and carrier_now_damaged
	GameState.diverts = {}
	GameState.divert_power("mount_b", "core", 0.30)
	var stacked: bool = not GameState.divert_power("drive", "core", 0.30)
	print("[damage] NOTHING IS SPENT TWICE same source again=%s, onto a dark-but-repaired section=%s, out of a damaged carrier=%s, second source onto one target=%s (all must be refused) -> %s" % [
		str(twice), str(onto_burned), str(from_carrier), str(stacked),
		"PASS" if twice and onto_burned and from_carrier and stacked else "FAIL"])

	# --- 3b. a system cannot pay itself --------------------------------------
	# Both mounts govern `dps`, so burning one into the other multiplied the same
	# key by 0.50 and then 1.60 -- a net 0.80, a strict LOSS, rendered as
	# OVERCHARGED in gold. It is also the most intuitive move on the sheet, so it
	# had to be refused rather than merely documented. Asserted against the
	# GOVERNS key rather than the pair, so a third weapon mount inherits it.
	GameState.diverts = {}
	var same_system: bool = not GameState.divert_power("mount_b", "mount_a", 0.50)
	var cross_system: bool = GameState.divert_power("mount_b", "drive", 0.70)
	GameState.diverts = {}
	GameState._recompute()
	print("[damage] A SYSTEM CANNOT PAY ITSELF mount->mount refused=%s (0.50x1.60 = a net loss sold as a boost), mount->drive allowed=%s -> %s" % [
		str(same_system), str(cross_system),
		"PASS" if same_system and cross_system else "FAIL"])

	# --- 3c. the shield trade cannot move what damage is derived FROM --------
	# THE DEATH SPIRAL, ASSERTED SHUT. Integrity is shield/shield_max, and an
	# earlier version scaled shield_max for the "shield" system -- so
	# overcharging the array dropped the integrity it is derived from and broke
	# the array one line after powering it, and BURNING the array raised
	# integrity and healed sections as a reward for destroying one. Capacity is
	# now fixed by the fit and the trade moves regeneration only.
	GameState.diverts = {}
	GameState._recompute()
	var cap_before := float(GameState.stats.get("shield_max", 0.0))
	var regen_before := float(GameState.stats.get("shield_regen", 0.0))
	GameState.divert_power("mount_b", "array", 0.70)
	var cap_boost := float(GameState.stats.get("shield_max", 0.0))
	var regen_boost := float(GameState.stats.get("shield_regen", 0.0))
	# THE BURN LEG HAS TO ACTUALLY BURN. The first version sent the array into
	# the DRIVE at 10% integrity, where the drive is damaged too (fails_at 0.58)
	# -- so the trade was refused, nothing happened, and `cap_burn` read the
	# stats left over from the boost above. It measured the boost case twice and
	# called one of them a burn. The core is the only section that is never
	# damaged, so it is the only legal target at an integrity low enough for the
	# array to be a legal source.
	GameState.diverts = {}
	var burn_took: bool = GameState.divert_power("array", "core", 0.10)
	var cap_burn := float(GameState.stats.get("shield_max", 0.0))
	var regen_burn := float(GameState.stats.get("shield_regen", 0.0))
	GameState.diverts = {}
	GameState._recompute()
	print("[damage] THE SHIELD TRADE NEVER MOVES CAPACITY shield_max %.0f -> %.0f boosted, %.0f burned (all must match); regen %.1f -> %.1f boosted, %.1f burned (must rise then fall); burn actually took=%s -> %s" % [
		cap_before, cap_boost, cap_burn, regen_before, regen_boost, regen_burn,
		str(burn_took),
		"PASS" if burn_took and absf(cap_boost - cap_before) < 0.01
			and absf(cap_burn - cap_before) < 0.01
			and regen_boost > regen_before + 0.01
			and regen_burn < regen_before - 0.01 else "FAIL"])

	# --- 3d. a new run does not inherit a burned-out ship --------------------
	# `diverts` is not saved, which was mistaken for it being empty at the start
	# of a run. It is only ever cleared by docking, so ABANDON TO TITLE then NEW
	# SURVEY carried a burned mount into a brand-new ship -- reset_to_starter
	# ends in _recompute(), which folded the stale dictionary straight back in,
	# and the new pilot could not even open the panel to see why (it refuses
	# during the tutorial).
	GameState.diverts = {}
	GameState.divert_power("mount_b", "core", 0.30)
	var carried: bool = not GameState.diverts.is_empty()
	GameState.reset_to_starter()
	var cleared_by_reset: bool = GameState.diverts.is_empty()
	print("[damage] A NEW RUN STARTS WHOLE diverted before reset=%s, empty after reset_to_starter=%s -> %s" % [
		str(carried), str(cleared_by_reset),
		"PASS" if carried and cleared_by_reset else "FAIL"])

	# --- 3e. the catalog's floors survive a diversion ------------------------
	# compute_stats floors max_speed at 1.6 and shield_max at 40, then
	# SectionDB.apply used to multiply straight through them.
	# PlayerShip.TETHER_DRAG_CEILING is sized against that speed floor with the
	# note that being out-runnable by any legal fit is the promise the tether has
	# to keep, so a burned drive must not be able to break it.
	# STAGED AGAINST A NEAR-FLOOR BLOCK, because the starter fit is nowhere near
	# one: burning its drive leaves max_speed at 5.09 against a floor of 1.60, so
	# reading the live ship would print PASS whether the floor was enforced or
	# not, and an assertion that cannot distinguish its two outcomes is not
	# measuring. This drives the exact composition _recompute uses, on a block
	# chosen to fall through the floor without it.
	var floor_probe := {
		"max_speed": 2.0, "accel": 4.0, "turn_rate": 2.0, "shield_max": 45.0,
		"cargo_space": 10.0, "weapon_range_bonus": 0.0,
		"dps": 100.0, "shield_regen": 5.0,
	}
	var unfloored: Dictionary = SectionDB.apply(floor_probe.duplicate(),
		{"drive": "core"})
	var would_sink := float(unfloored["max_speed"])          # 2.0 * 0.55 = 1.10
	var held := float(ModuleDB.enforce_floors(unfloored.duplicate())["max_speed"])
	# And the live pipeline agrees with that composition for the real fit, which
	# is what proves _recompute actually calls it rather than the two functions
	# merely composing correctly in a vacuum.
	GameState.diverts = {}
	GameState._recompute()
	GameState.divert_power("drive", "core", 0.50)
	var live := float(GameState.stats.get("max_speed", 0.0))
	var expected := float(ModuleDB.enforce_floors(SectionDB.apply(
		ModuleDB.compute_stats(GameState.fit), {"drive": "core"}))["max_speed"])
	GameState.diverts = {}
	GameState._recompute()
	print("[damage] A DIVERSION CANNOT BREAK THE CATALOG FLOORS a burn would sink max_speed to %.2f, floored back to %.2f (floor 1.60); live pipeline %.2f == composed %.2f -> %s" % [
		would_sink, held, live, expected,
		"PASS" if would_sink < 1.6 and absf(held - 1.6) < 0.001
			and absf(live - expected) < 0.001 else "FAIL"])

	# --- 4. the trade actually moves the ship's numbers -----------------------
	# Read off GameState.stats, which is what PlayerShip flies on -- not off
	# SectionDB's constants, which would only prove the table agrees with itself.
	GameState.diverts = {}
	GameState._recompute()
	var base_dps := float(GameState.stats.get("dps", 0.0))
	var base_speed := float(GameState.stats.get("max_speed", 0.0))
	GameState.divert_power("mount_b", "drive", 0.70)
	var burn_dps := float(GameState.stats.get("dps", 0.0))
	var boost_speed := float(GameState.stats.get("max_speed", 0.0))
	var cost_paid: bool = burn_dps < base_dps - 0.01
	var boost_landed: bool = boost_speed > base_speed + 0.01
	print("[damage] THE TRADE COSTS AND PAYS dps %.0f -> %.0f (must fall), speed %.2f -> %.2f (must rise) -> %s" % [
		base_dps, burn_dps, base_speed, boost_speed,
		"PASS" if cost_paid and boost_landed else "FAIL"])

	# --- 5. a berth is what buys it back -------------------------------------
	# The whole cost side of the mechanic in one line. Driven through
	# clear_diverts rather than by emptying the dictionary, because the dock is
	# the only caller and it is the return value the dock line reads.
	var undone: bool = GameState.clear_diverts()
	var dps_back: bool = absf(float(GameState.stats.get("dps", 0.0)) - base_dps) < 0.01
	var speed_back: bool = absf(float(GameState.stats.get("max_speed", 0.0)) - base_speed) < 0.01
	var quiet_when_clean: bool = not GameState.clear_diverts()
	print("[damage] A BERTH BUYS IT BACK restored=%s, dps back=%s, speed back=%s, silent on a clean ship=%s -> %s" % [
		str(undone), str(dps_back), str(speed_back), str(quiet_when_clean),
		"PASS" if undone and dps_back and speed_back and quiet_when_clean else "FAIL"])

	# --- 6. the sheet stops the clock, and gives it back ---------------------
	# BOTH HALVES. A panel that paused and could not un-pause is a hang with a
	# tidy explanation, and it is the failure this mechanic is most likely to
	# ship: nothing else in the game except the pause menu touches paused at all.
	var was_paused := get_tree().paused
	damage_screen.open()
	await get_tree().process_frame
	var stopped := get_tree().paused
	var sheet_up := damage_screen.is_open
	# And it counts as a console while it is up, so the raid roll cannot fire
	# behind it in the frames either side of the pause.
	var counts_as_console := console_open()
	damage_screen.close_panel()
	await get_tree().process_frame
	var running := not get_tree().paused
	print("[damage] THE SHEET STOPS THE CLOCK AND GIVES IT BACK before=%s, open -> paused=%s sheet=%s console=%s, closed -> running=%s -> %s" % [
		str(was_paused), str(stopped), str(sheet_up), str(counts_as_console), str(running),
		"PASS" if not was_paused and stopped and sheet_up and counts_as_console
			and running else "FAIL"])

	# --- 7. an overcharged core is worth something at the trigger ------------
	# The core governs the fitted ABILITY rather than a scalar, so it is the one
	# section whose boost cannot be read off a stat the ship flies on. Asserted
	# where it is actually spent.
	# THE BASELINE HALF USED TO COMPARE THE TEST'S OWN DEFAULT TO 1.0. With no
	# diversion the key is ABSENT, so `stats.get("core_boost", 1.0)` returned the
	# literal the assertion then checked against 1.0 -- it could not fail, on any
	# code, ever. Asking whether the key is absent is the question that has two
	# answers.
	#
	# And the burst is computed here the way PlayerShip computes it, so this
	# measures what reaches the trigger rather than a field nothing may read.
	GameState.diverts = {}
	GameState._recompute()
	var key_absent: bool = not GameState.stats.has("core_boost")
	var plain_burst := float(GameState.stats.get("dps", 0.0)) \
		* PlayerShip.OVERCHARGE_BURST_SECONDS \
		* float(GameState.stats.get("core_boost", 1.0))
	# STAGED FROM THE WORST POSSIBLE SOURCE. A mount is the only source that also
	# cuts `dps`, which the discharge is priced in -- so if the burst rises for a
	# mount it rises for everything. Read from a source that costs no damage (the
	# drive) this assertion passes on a core boost of 1.75, which is a net LOSS
	# from a mount; that is exactly the hole it now closes.
	GameState.divert_power("mount_b", "core", 0.70)
	var charged_boost := float(GameState.stats.get("core_boost", 1.0))
	var charged_burst := float(GameState.stats.get("dps", 0.0)) \
		* PlayerShip.OVERCHARGE_BURST_SECONDS * charged_boost
	# AT 0.50, NOT 0.70. The drive only becomes a legal source below its own 0.58
	# threshold, so staged at 0.70 this trade is refused, `_recompute` never runs
	# and the read below returns the PREVIOUS staging's stats -- which is the
	# same stale-read the shield leg was caught doing, reintroduced three lines
	# later. `free_took` is asserted for that reason: staging that silently did
	# not happen is worse than no staging at all.
	GameState.diverts = {}
	var free_took: bool = GameState.divert_power("drive", "core", 0.50)
	var free_burst := float(GameState.stats.get("dps", 0.0)) \
		* PlayerShip.OVERCHARGE_BURST_SECONDS \
		* float(GameState.stats.get("core_boost", 1.0))
	GameState.clear_diverts()
	print("[damage] AN OVERCHARGED CORE HITS HARDER key absent when clean=%s, core_boost -> %.2f; discharge %.0f -> %.0f from a MOUNT (the worst source, must still rise) -> %.0f from the drive (staged=%s) -> %s" % [
		str(key_absent), charged_boost, plain_burst, charged_burst, free_burst,
		str(free_took),
		"PASS" if key_absent and charged_boost > 1.01 and free_took
			and charged_burst > plain_burst + 0.01
			and free_burst > charged_burst + 0.01 else "FAIL"])

	# --- 8. the refit console compares like with like ------------------------
	# UIKit.delta_line renders delta_lines(GameState.stats, preview_stats(...)),
	# so if only one side carries the diversion every module in the list
	# advertises a fabricated gain: with a mount burned, the BEFORE dps was
	# halved and the AFTER was not, so every weapon showed roughly +100% and
	# equipping one re-applied the halving the strip had just promised to undo.
	# Asserted by re-fitting the module ALREADY IN THE SLOT -- the delta of a
	# no-op must be zero in every world, diverted or not, and that is a question
	# with two possible answers.
	GameState.diverts = {}
	GameState._recompute()
	var slot_now := String(GameState.fit.get(ModuleDB.Slot.WEAPON_A, ""))
	var noop_clean := float(GameState.preview_stats(ModuleDB.Slot.WEAPON_A,
		slot_now).get("dps", 0.0)) - float(GameState.stats.get("dps", 0.0))
	GameState.divert_power("mount_b", "drive", 0.70)
	var noop_diverted := float(GameState.preview_stats(ModuleDB.Slot.WEAPON_A,
		slot_now).get("dps", 0.0)) - float(GameState.stats.get("dps", 0.0))
	GameState.diverts = {}
	GameState._recompute()
	print("[damage] A REFIT PREVIEW COMPARES LIKE WITH LIKE re-fitting the equipped module reads %+.1f dps clean, %+.1f with a mount burned (both must be 0.0) -> %s" % [
		noop_clean, noop_diverted,
		"PASS" if absf(noop_clean) < 0.01 and absf(noop_diverted) < 0.01 else "FAIL"])

	# A frame of the sheet, when asked for one. No assertion can tell you whether
	# a panel READS, and this one is a wall of state the player meets while
	# something is shooting at them. Staged at 30% so three of the five sections
	# are out and the trade is actually on offer.
	var shots := OS.get_environment("PYXIS_SHOTS")
	if shots != "":
		GameState.diverts = {}
		GameState._recompute()
		player.shield = player.shield_max * 0.30
		await get_tree().process_frame
		damage_screen.open()
		await get_tree().create_timer(0.4).timeout
		await _shot(shots, "damage_control.png")
		damage_screen.close_panel()

	GameState.diverts = {}
	GameState._recompute()
	await get_tree().create_timer(0.2).timeout
	get_tree().quit()


func _run_hunt_test() -> void:
	# THE HUNT, stage 1: the run salt, and the two-tier gate that turns the apex
	# engine from an optional windfall into the door to the next system.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	if player:
		player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.3).timeout

	# --- 1. the salt is pinned, and it is not zero ---------------------------
	# A harness whose world moves every run measures the dice. Zero is called out
	# separately because it is the value an absent field defaults to, and a run
	# seeded 0 would hide every lair in the same place for every player.
	print("[hunt] SALT IS PINNED run_seed %d == RUN_SEED_PINNED %d, non-zero=%s -> %s" % [
		GameState.run_seed, RUN_SEED_PINNED, str(GameState.run_seed != 0),
		"PASS" if GameState.run_seed == RUN_SEED_PINNED and GameState.run_seed != 0 else "FAIL"])

	# --- 2. charting and opening are DIFFERENT doors -------------------------
	# The whole stage in one assertion: breaching charts, and charting alone does
	# not let you fly. Driven through mark_breached, the real entry point.
	GameState.breached = []
	GameState.lanes_open = []
	var charted_by_breach := GameState.mark_breached("pyx01")
	var charted := GameState.is_system_charted("pyx02")
	var open_after_breach := GameState.is_lane_open("pyx02")
	print("[hunt] BREACH CHARTS, IT DOES NOT OPEN breach charted %s; pyx02 charted=%s lane_open=%s -> %s" % [
		str(charted_by_breach), str(charted), str(open_after_breach),
		"PASS" if charted and not open_after_breach else "FAIL"])

	# --- 3. and travel refuses while the lane is jammed ----------------------
	# Asserted through travel_to rather than the predicate, because the predicate
	# agreeing with itself proves nothing about the door it is supposed to hold.
	var before_sys := system_id
	travel_to("pyx02")
	await get_tree().process_frame
	var refused: bool = system_id == before_sys and not warping
	print("[hunt] JAMMED LANE REFUSES TRAVEL travel_to(pyx02) from %s left us at %s, warping=%s -> %s" % [
		before_sys, system_id, str(warping), "PASS" if refused else "FAIL"])

	# --- 4. the kill opens it ------------------------------------------------
	var opened := GameState.open_lane("pyx01")
	var open_now := GameState.is_lane_open("pyx02")
	print("[hunt] THE KILL OPENS THE LANE open_lane(pyx01) newly opened %s; pyx02 lane_open=%s -> %s" % [
		str(opened), str(open_now),
		"PASS" if open_now and opened.has("pyx02") else "FAIL"])

	# --- 5. the bonus is NOT spent by opening the lane ------------------------
	# open_lane and mark_apex_killed are deliberately separate: the lane opens
	# when the engine dies, the bonus is paid when its wreck is cracked, and that
	# is a second trip. Folding them together would make has_killed_apex true
	# before the wreck was ever breached and the bonus would never pay at all.
	var bonus_still_owed: bool = not GameState.has_killed_apex("pyx01")
	GameState.mark_apex_killed("pyx01")
	var bonus_spent_after: bool = GameState.has_killed_apex("pyx01")
	print("[hunt] OPENING A LANE DOES NOT SPEND THE BONUS owed after the kill=%s, spent after the wreck=%s -> %s" % [
		str(bonus_still_owed), str(bonus_spent_after),
		"PASS" if bonus_still_owed and bonus_spent_after else "FAIL"])

	# --- 6. no returning player loses a lane they already had ----------------
	# A pre-v15 save has no lanes_open key at all, and a straight default would
	# revoke access the old rule granted. Driven through the real loader against
	# a real fixture, on a redirected path so the player's save is never touched.
	var real_path := GameState.save_path
	GameState.save_path = "user://hunt_probe.json"
	var v14 := {
		"version": 14,
		"salvage": 4242,
		"owned": ["pulse_1", "drive_cruise"],
		"fit": {"0": "pulse_1", "2": "drive_cruise"},
		"current_system": "pyx02",
		"breached": ["pyx01"],          # they charted, under the old rule
		"apex_killed": [],              # and never touched the engine
		"tutorial_step": -1,
	}
	var fh := FileAccess.open(GameState.save_path, FileAccess.WRITE)
	fh.store_string(JSON.stringify(v14))
	fh.close()
	var loaded := GameState.load_game()
	var kept: bool = GameState.is_lane_open("pyx02") and GameState.lanes_open.has("pyx01")
	var salt_rolled: bool = GameState.run_seed != 0
	print("[hunt] NO RETURNING PILOT IS STRANDED v14 save breached=[pyx01] loaded=%s -> lanes_open=%s, pyx02 flyable=%s, salt rolled=%s -> %s" % [
		str(loaded), str(GameState.lanes_open), str(GameState.is_lane_open("pyx02")),
		str(salt_rolled), "PASS" if loaded and kept and salt_rolled else "FAIL"])
	GameState.save_path = real_path

	# --- 7. the lairs are where the design says, and they are hidden ---------
	# The bands ARE the difficulty curve of the hunt, so they are asserted rather
	# than trusted: the first engine in the Drift so a pilot with the tutorial
	# fresh can brute-force it, the last in the Quiet so the final one is a
	# expedition. Also proves the derivation is stable — same salt, same lair,
	# every call — because a hint that pointed somewhere the boss was not would
	# be worse than no hint at all.
	# RE-PIN FIRST. Assertion 6 above loads a pre-v15 fixture, and the loader
	# rolls a fresh salt for any save that has none — so by the time control
	# reaches here run_seed is whatever that roll produced, not RUN_SEED_PINNED.
	# Without this the band checks below read a RANDOM lair each run: they passed
	# twice at 317u and 337u and would eventually roll one into the Shoals and
	# fail on perfectly correct code. Stage 4 wrote this lesson down after the
	# core-sample check inherited a tier; this is the same mistake, caught by
	# noticing the reported depth move between two runs that should have been
	# identical.
	GameState.run_seed = RUN_SEED_PINNED
	var lair_bad := ""
	var lair_report := ""
	# Bands from DeepSpace.BAND_EDGES [0,160,440,1100]: 2=THE DRIFT,
	# 3=THE REACHES, 4=THE QUIET. Written out because "band 2" and "the Drift"
	# are the same fact in two vocabularies and this table is where they meet.
	for spec_v in [["pyx01", 2], ["pyx02", 3], ["pyx03", 4]]:
		var lsys := String((spec_v as Array)[0])
		var want_band := int((spec_v as Array)[1])
		var lp := SystemDB.lair_pos(lsys, GameState.run_seed)
		var lp2 := SystemDB.lair_pos(lsys, GameState.run_seed)
		var ld := SystemDB.lair_depth(lsys, GameState.run_seed)
		var got_band := DeepSpace.band_of(ld)
		lair_report += "%s %s@%.0fu " % [lsys, DeepSpace.BAND_NAMES[got_band], ld]
		if lp != lp2:
			lair_bad = "%s is not stable across calls" % lsys
		if got_band != want_band:
			lair_bad = "%s wanted band %d, hides in %d" % [lsys, want_band, got_band]
		# And it must be OUT there. A lair inside the charted volume would be
		# visible from the dock, which is the whole thing this horizon undid.
		if ld <= 0.0:
			lair_bad = "%s is inside charted space" % lsys
	print("[hunt] THE LAIRS HIDE DEEP, AND STAY PUT %s(%s) -> %s" % [
		lair_report, lair_bad if lair_bad != "" else "stable",
		"PASS" if lair_bad == "" else "FAIL"])

	# --- 8. the arena is exactly the engine's reach --------------------------
	# THE PRICE OF A LITERAL. DeepSpace.LAIR_KEEPOUT is written out as 120.0
	# rather than defined as ApexBoss.LEASH_RANGE, because a compile-time const
	# dependency closes a cycle — DeepSpace names ApexBoss, ApexBoss names HUD,
	# HUD names DeepSpace — and Godot answers a cycle in the global class list by
	# declaring EVERY class_name in the project undeclared. Forty parse errors in
	# files nobody touched, and a boot that hangs rather than fails. (Measured,
	# not feared: writing the const that way is what produced them.)
	#
	# So the two numbers agree HERE or they agree nowhere. The keep-out is not a
	# tuning value — it is the leash, restated as world generation: the leash is
	# the radius inside which the game says you are in the fight, so anything
	# inside it that is not the fight is the game contradicting itself.
	var ordered: bool = ApexBoss.WAKE_RANGE < ApexBoss.DETECT_RANGE \
		and ApexBoss.DETECT_RANGE <= ApexBoss.LEASH_RANGE
	var anchored: bool = is_equal_approx(DeepSpace.LAIR_KEEPOUT, ApexBoss.LEASH_RANGE)
	print("[hunt] THE ARENA IS THE ENGINE'S REACH keep-out %.0f vs leash %.0f (anchored=%s), wake %.0f < detect %.0f <= leash %.0f (%s) -> %s" % [
		DeepSpace.LAIR_KEEPOUT, ApexBoss.LEASH_RANGE, str(anchored),
		ApexBoss.WAKE_RANGE, ApexBoss.DETECT_RANGE, ApexBoss.LEASH_RANGE, str(ordered),
		"PASS" if anchored and ordered else "FAIL"])

	# --- 9. the keep-out subtracts, and only where it should -----------------
	# Pure arithmetic over the generator, no flying: plan_cell is what the world
	# WOULD hold and built_plan is what it actually builds, and the only legal
	# difference between them is a station, nest or hulk inside the keep-out.
	#
	# `staged` is what gives this teeth. A keep-out asserted over a patch of space
	# that happened to roll nothing would pass while doing nothing, so the number
	# of things the generator put in the sphere is printed and required to be
	# non-zero — if the salt or the bands ever move the lair somewhere genuinely
	# empty, this says so instead of going quietly green.
	#
	# And the OUTSIDE half is the other half of the claim. A filter that dropped
	# every station in the system would satisfy the inside check perfectly.
	var lair := SystemDB.lair_pos(system_id, GameState.run_seed)
	var lair_cell := DeepSpace.cell_of(lair)
	var staged := 0        # suppressible things the generator put inside the sphere
	var leaked := 0        # ... that the world built anyway
	var outside_moved := 0 # ... and anything the filter touched that it should not have
	for cx in range(lair_cell.x - 3, lair_cell.x + 4):
		for cz in range(lair_cell.y - 3, lair_cell.y + 4):
			var raw := deep_space.plan_cell(cx, cz)
			var built := deep_space.built_plan(cx, cz)
			# All FOUR filtered keys since v18 — this list read
			# ["station", "pack", "hulk"] while built_plan filtered convoy too,
			# so a convoy leaking into the arena had no assertion at all.
			for key_v in ["station", "pack", "hulk", "convoy"]:
				var key := String(key_v)
				var thing: Dictionary = raw[key]
				if thing.is_empty():
					continue
				var inside: bool = (thing["pos"] as Vector3).distance_to(lair) < DeepSpace.LAIR_KEEPOUT
				if inside:
					staged += 1
					if not (built[key] as Dictionary).is_empty():
						leaked += 1
				elif (built[key] as Dictionary).is_empty():
					outside_moved += 1
	print("[hunt] THE KEEP-OUT IS SUBTRACTIVE generator staged %d suppressible things inside %.0fu of the lair, world built %d; %d touched outside it -> %s" % [
		staged, DeepSpace.LAIR_KEEPOUT, leaked, outside_moved,
		"PASS" if staged > 0 and leaked == 0 and outside_moved == 0 else "FAIL"])

	# --- 10. and it never reaches the fingerprint ----------------------------
	# WHY THE FILTER IS NOT IN plan_cell. PYXIS_MINETEST's WORLD FINGERPRINT
	# hashes cells -5..5 — a square reaching ~384u per axis — and pyx01's lair
	# lands at radius 308, squarely inside it. Subtracting the lair's neighbours
	# in plan_cell would move a hash recorded to police the seam roll, and the
	# recorded constant would need re-deriving every time the salt or a depth band
	# changed.
	#
	# The overlap is ASSERTED rather than assumed, because it is the entire reason
	# the design is what it is. If a future band pushed the lair out past the
	# window this assertion would stop meaning anything, and it should say so
	# rather than keep passing.
	var in_window: bool = absi(lair_cell.x) <= 5 and absi(lair_cell.y) <= 5
	var fp_now := _world_fingerprint()
	print("[hunt] THE KEEP-OUT NEVER REACHES THE FINGERPRINT lair in cell %s, inside the hashed window=%s; fingerprint %s vs %s -> %s" % [
		str(lair_cell), str(in_window), fp_now, WORLD_FINGERPRINT_BEFORE_SEAMS,
		"PASS" if in_window and fp_now == WORLD_FINGERPRINT_BEFORE_SEAMS else "FAIL"])

	# --- 11. nothing else lives in the arena ---------------------------------
	# The same claim as 9, made against the WORLD instead of the arithmetic: fly
	# to the lair, let the streamer dress it, and look at what is actually there.
	# Two separate failures this catches that the plan comparison cannot — an
	# obstacle registered without a mesh (_register_cell and _populate_cell
	# filtering differently), and a nest armed from an unfiltered read in _stream.
	var flyer: PlayerShip = get_tree().get_first_node_in_group("player")
	flyer.teleport_to(lair + Vector3(0, 0, 30.0))
	deep_space.stream_now(flyer.global_position)
	await get_tree().process_frame
	await get_tree().process_frame
	var docks := 0
	for n_v in get_tree().get_nodes_in_group("dockable"):
		if (n_v as Node3D).global_position.distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
			docks += 1
	var wrecks := 0
	for n_v in get_tree().get_nodes_in_group("crackable"):
		if (n_v as Node3D).global_position.distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
			wrecks += 1
	var nests := 0
	for p_v in deep_space.armed_nests():
		if (p_v as Vector3).distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
			nests += 1
	# AND IT IS NOT A HOLE. Rocks, seams and the landmark are deliberately left
	# alone: 240u of genuinely empty space would read as a bug in the world rather
	# than a feature of it. Asserted in the same breath as the suppression, so
	# "clear the arena" can never quietly become "delete the arena".
	#
	# COUNTED AGAINST THE GENERATOR, not against zero. The first version of this
	# clause asked for `dressed > 0` and it caught nothing: told to delete every
	# rock and seam in the arena, the world still handed back three seams from the
	# cells the sphere only clips, and the assertion passed on a world with more
	# than half its dressing missing. `> 0` was a property of the geometry — a
	# 120u sphere overlaps cells it does not contain — rather than a property of
	# the rule it claimed to be testing.
	#
	# So it is like against like: what plan_cell stages inside the keep-out, over
	# exactly the cells the streamer made live, versus what the world built.
	# Rocks are counted through the OBSTACLE registry rather than the meshes,
	# because obstacles are the half with no mesh — and "seams still there,
	# rocks gone" is the shape of a hole this would otherwise miss.
	var rocks_staged := 0
	var seams_staged := 0
	for c_v in deep_space.live_cells():
		var c: Vector2i = c_v
		var pl := deep_space.plan_cell(c.x, c.y)
		for r_v in (pl["rocks"] as Array):
			var rp: Vector3 = (r_v as Dictionary)["pos"]
			rp.y = 0.0     # Obstacles.add flattens to the play plane; compare like with like
			if rp.distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
				rocks_staged += 1
		for s_v in (pl.get("seams", []) as Array):
			if ((s_v as Dictionary)["pos"] as Vector3).distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
				seams_staged += 1
	var rocks_live := 0
	for s_v in Obstacles.spheres():
		var sph: Dictionary = s_v
		if String(sph.get("owner", "")).begins_with("deep:") \
				and (sph["pos"] as Vector3).distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
			rocks_live += 1
	var seams_live := 0
	for n_v in get_tree().get_nodes_in_group("mineable"):
		if (n_v as Node3D).global_position.distance_to(lair) < DeepSpace.LAIR_KEEPOUT:
			seams_live += 1
	var dressed_intact: bool = rocks_staged > 0 and rocks_live == rocks_staged \
		and seams_staged > 0 and seams_live == seams_staged
	print("[hunt] NOTHING ELSE LIVES IN THE ARENA within %.0fu of the lair: %d docks, %d wrecks, %d armed nests (all must be 0); still dressed: %d/%d rocks, %d/%d seams -> %s" % [
		DeepSpace.LAIR_KEEPOUT, docks, wrecks, nests,
		rocks_live, rocks_staged, seams_live, seams_staged,
		"PASS" if docks == 0 and wrecks == 0 and nests == 0 and dressed_intact else "FAIL"])

	# --- 12. the leash ends the fight, and only past the leash ---------------
	# BOTH HALVES, because a leash that fired at every distance would satisfy the
	# first half perfectly and make the encounter impossible to have. Driven by
	# flying: the engine is woken by arriving at it and let go of by leaving, and
	# neither state is written by hand anywhere in here.
	_apex_wake_timer = 0.2
	var engine := _find_apex()
	flyer.teleport_to(engine.global_position + Vector3(0, 0, 8.0))
	await get_tree().create_timer(ApexBoss.WAKE_TIME + 1.4).timeout
	var woke := boss_active
	# Well outside WAKE_RANGE, comfortably inside LEASH_RANGE: the gap between
	# the two is what stops the fight flickering on and off at the boundary, so
	# it is the interesting place to stand.
	var mid := (ApexBoss.WAKE_RANGE + ApexBoss.LEASH_RANGE) * 0.5
	flyer.teleport_to(engine.global_position + Vector3(0, 0, mid))
	await get_tree().create_timer(0.5).timeout
	var held := boss_active
	flyer.teleport_to(engine.global_position + Vector3(0, 0, ApexBoss.LEASH_RANGE + 20.0))
	await get_tree().create_timer(0.5).timeout
	var slipped: bool = not boss_active
	print("[hunt] THE LEASH ENDS THE FIGHT woke at 8u=%s, still engaged at %.0fu=%s, broke off at %.0fu=%s -> %s" % [
		str(woke), mid, str(held), ApexBoss.LEASH_RANGE + 20.0, str(slipped),
		"PASS" if woke and held and slipped else "FAIL"])

	# --- 13. the pinning list is complete -------------------------------------
	# THE ASSERTION THIS FILE OWED ITSELF. MINETEST was dispatched, swept, and
	# absent from HARNESS_VARS from the day it shipped -- so 25 assertions ran
	# against the developer's savegame rather than pinned state, which is the
	# precise defect §33 created that list to prevent. It passed on luck.
	#
	# Reading the source is unusual and deliberate: the two lists are the same
	# fact written twice, and only the file can say whether they still agree.
	# Anything the game DISPATCHES on must be something the game PINS on.
	var src := FileAccess.open("res://scripts/main.gd", FileAccess.READ)
	var text := src.get_as_text() if src != null else ""
	if src != null:
		src.close()
	var re := RegEx.new()
	re.compile('OS\\.get_environment\\("(PYXIS_[A-Z0-9_]+)"\\)')
	var dispatched := {}
	for m in re.search_all(text):
		dispatched[m.get_string(1)] = true
	# PYXIS_SHOTS and PYXIS_HARNESS_* are outputs and knobs, not harness modes:
	# they select where a capture writes, never what the game resets to.
	var exempt := {"PYXIS_SHOTS": true}
	var unpinned: Array = []
	for name_v in dispatched:
		var nm := String(name_v)
		if exempt.has(nm) or nm.begins_with("PYXIS_HARNESS"):
			continue
		if not HARNESS_VARS.has(nm):
			unpinned.append(nm)
	unpinned.sort()
	print("[hunt] THE PINNING LIST IS COMPLETE %d dispatched harness vars, %d not in HARNESS_VARS %s -> %s" % [
		dispatched.size(), unpinned.size(), str(unpinned),
		"PASS" if unpinned.is_empty() else "FAIL"])

	# --- v16. THE INTEL DOSSIER ----------------------------------------------
	# Every assertion below drives the real entry points — add_apex_hint, the
	# channel builders, Hunt.estimate — rather than poking apex_intel, because a
	# dossier that only agrees with itself proves nothing about the hunt.
	var isys := "pyx03"          # the deepest band: the most room for a cone to be wrong in
	GameState.apex_killed = []
	GameState.clear_apex_intel(isys)
	var truth: Vector3 = SystemDB.lair_pos(isys, GameState.run_seed)

	# 1. AN EMPTY DOSSIER PROMISES THE BAND AND NOTHING MORE. The estimate with
	#    no hints must still be honest: strength 0, and a radius that covers the
	#    authored annulus rather than a confident point.
	var e_empty: Dictionary = Hunt.estimate(isys)
	var band_arr: Array = ((SystemDB.get_system(isys).get("apex", {}) as Dictionary)
		.get("lair", {}) as Dictionary).get("depth", [0.0, 0.0])
	var band_mid := (float(band_arr[0]) + float(band_arr[1])) * 0.5 \
		+ float(SystemDB.get_system(isys).get("bounds", 40.0))
	print("[hunt] AN EMPTY DOSSIER KNOWS ONLY THE BAND strength=%d (must be 0), radius %.0f ~ band mid %.0f -> %s" % [
		int(e_empty["strength"]), float(e_empty["radius"]), band_mid,
		"PASS" if int(e_empty["strength"]) == 0 \
			and absf(float(e_empty["radius"]) - band_mid) < 1.0 else "FAIL"])

	# 2. EVERY CHANNEL NARROWS IT, AND NONE OF THEM LIES. Hints are filed one at
	#    a time; the radius must never grow, and the true lair must stay inside
	#    the region the dossier claims. A channel whose cone excludes the answer
	#    is worse than no channel — the player pays to be sent the wrong way.
	var radii: Array = []
	var contains_truth := true
	var last_r := 1.0e9
	var monotonic := true
	for spec in [
		[Vector3(0, 0, 0), "rumor", 0.0],                 # the ring tier
		[Vector3(0, 0, 0), "mast", 8.0],
		[Vector3(420, 0, -260), "relic", 12.0],
		[Vector3(-300, 0, 500), "guard", 15.0],
		[Vector3(-120, 0, -640), "watch", 5.0],
		[Vector3(700, 0, 210), "rift", 4.0],
	]:
		var hint: Dictionary = Hunt.ring_hint(isys, GameState.run_seed) if float(spec[2]) <= 0.0 \
			else Hunt.bearing_hint(isys, spec[0] as Vector3, String(spec[1]),
				float(spec[2]), GameState.run_seed)
		GameState.add_apex_hint(isys, hint)
		var e: Dictionary = Hunt.estimate(isys)
		radii.append(int(float(e["radius"])))
		# Hunt.RESIDUAL_FRACTION, not zero -- see the constant: the radius is a
		# heuristic bound from an iterative sampled search, and what must never
		# happen is the search area MATERIALLY widening when intel is bought.
		if float(e["radius"]) > last_r * (1.0 + Hunt.RESIDUAL_FRACTION):
			monotonic = false
		last_r = float(e["radius"])
		if truth.distance_to(e["center"] as Vector3) > float(e["radius"]) + 1.0:
			contains_truth = false
	print("[hunt] INTEL NARROWS AND NEVER LIES radii %s never materially widened=%s; truth inside the claim every step=%s -> %s" % [
		str(radii), str(monotonic), str(contains_truth),
		"PASS" if monotonic and contains_truth and int(radii[radii.size() - 1]) < int(radii[0]) else "FAIL"])

	# 3. AND IT STILL DOES NOT HAND OVER THE ANSWER. Six hints is the richest
	#    dossier the game sells; the ghost must still be honestly wrong. If this
	#    ever reads ~0 the channels have stopped selling intel and started
	#    selling a waypoint.
	var e_full: Dictionary = Hunt.estimate(isys)
	var miss := truth.distance_to(e_full["center"] as Vector3)
	print("[hunt] THE GHOST IS HONESTLY WRONG %d hints, estimate misses the lair by %.0fu (must be > 0) -> %s" % [
		GameState.apex_hint_count(isys), miss, "PASS" if miss > 1.0 else "FAIL"])

	# 4. THE CAP EVICTS THE WIDEST, NOT THE OLDEST. Fill past HINT_CAP with
	#    precise readings and the ±90 ring must be the thing that goes, or a
	#    player who buys the best reading in the game watches it evict itself.
	var wide_before: bool = false
	for h_v in GameState.apex_hints(isys):
		if String((h_v as Dictionary).get("kind", "")) == "ring":
			wide_before = true
	for i in range(6):
		GameState.add_apex_hint(isys, Hunt.bearing_hint(isys,
			Vector3(900.0 + i * 40.0, 0, -300.0 - i * 55.0), "mast", 6.0, GameState.run_seed))
	var wide_after := false
	var worst := 0.0
	for h_v in GameState.apex_hints(isys):
		worst = maxf(worst, GameState.hint_error(h_v as Dictionary))
		if String((h_v as Dictionary).get("kind", "")) == "ring":
			wide_after = true
	print("[hunt] THE CAP EVICTS THE WIDEST %d hints (cap %d), ring present before=%s after=%s, worst error now %.0f -> %s" % [
		GameState.apex_hint_count(isys), GameState.HINT_CAP, str(wide_before), str(wide_after), worst,
		"PASS" if GameState.apex_hint_count(isys) == GameState.HINT_CAP \
			and wide_before and not wide_after and worst < 90.0 else "FAIL"])

	# 5. A RE-READ FROM THE SAME SPOT IS NOT NEW INTEL. Otherwise parking on a
	#    mast and re-triggering it narrows the estimate for free, and precision
	#    stops being something the player buys.
	GameState.clear_apex_intel(isys)
	var first_take := GameState.add_apex_hint(isys, Hunt.bearing_hint(
		isys, Vector3(80, 0, 40), "mast", 8.0, GameState.run_seed))
	var second_take := GameState.add_apex_hint(isys, Hunt.bearing_hint(
		isys, Vector3(80, 0, 40), "mast", 8.0, GameState.run_seed))
	print("[hunt] THE SAME INSTRUMENT TWICE IS ONE READING first=%s second=%s, dossier holds %d -> %s" % [
		str(first_take), str(second_take), GameState.apex_hint_count(isys),
		"PASS" if first_take and not second_take and GameState.apex_hint_count(isys) == 1 else "FAIL"])

	# 6. THE ERROR IS SEEDED, NOT ROLLED. The same reading taken from the same
	#    place must be the same reading forever, or saving and reloading before
	#    a purchase becomes a reroll for a better cone.
	var a1: Dictionary = Hunt.bearing_hint(isys, Vector3(-150, 0, 220), "watch", 5.0, GameState.run_seed)
	var a2: Dictionary = Hunt.bearing_hint(isys, Vector3(-150, 0, 220), "watch", 5.0, GameState.run_seed)
	var b1: Dictionary = Hunt.bearing_hint(isys, Vector3(-151, 0, 220), "watch", 5.0, GameState.run_seed)
	print("[hunt] A READING IS NOT A REROLL same spot twice %.3f vs %.3f (equal), one unit over %.3f (different) -> %s" % [
		float(a1["bearing"]), float(a2["bearing"]), float(b1["bearing"]),
		"PASS" if is_equal_approx(float(a1["bearing"]), float(a2["bearing"])) \
			and not is_equal_approx(float(a1["bearing"]), float(b1["bearing"])) else "FAIL"])

	# 7. AND EVERY CHANNEL'S CONE ACTUALLY CONTAINS THE TRUTH. Per channel, at
	#    its own advertised error: the reading may be wrong by up to what it
	#    quotes, and never by more. Measured from many origins, because a cone
	#    that only holds from the origin it was authored against is luck.
	var honest := true
	var worst_off := 0.0
	for kind_spec in [["mast", 8.0], ["relic", 12.0], ["guard", 15.0], ["watch", 5.0], ["rift", 4.0]]:
		for ai in range(12):
			var ang := TAU * float(ai) / 12.0
			var from := Vector3(cos(ang) * 500.0, 0, sin(ang) * 500.0)
			var h: Dictionary = Hunt.bearing_hint(isys, from, String(kind_spec[0]),
				float(kind_spec[1]), GameState.run_seed)
			var to_truth: Vector3 = truth - from
			var true_deg := fposmod(rad_to_deg(atan2(to_truth.z, to_truth.x)), 360.0)
			var off := absf(wrapf(float(h["bearing"]) - true_deg, -180.0, 180.0))
			worst_off = maxf(worst_off, off - float(kind_spec[1]))
			if off > float(kind_spec[1]) + 0.001:
				honest = false
	print("[hunt] NO CHANNEL EXCEEDS ITS QUOTED ERROR 60 readings across 5 channels, worst overshoot %.4f deg -> %s" % [
		worst_off, "PASS" if honest else "FAIL"])

	# 8. THE KILL CLOSES THE DOSSIER. Intel about a dead engine is clutter that
	#    would keep drawing a survey plot for a hunt that is over.
	GameState.add_apex_hint(isys, Hunt.ring_hint(isys, GameState.run_seed))
	var before_kill := GameState.apex_hint_count(isys)
	GameState.mark_apex_killed(isys)
	var after_kill := GameState.apex_hint_count(isys)
	var refiled := GameState.add_apex_hint(isys, Hunt.ring_hint(isys, GameState.run_seed))
	print("[hunt] THE KILL CLOSES THE DOSSIER %d hints before, %d after, re-filing accepted=%s -> %s" % [
		before_kill, after_kill, str(refiled),
		"PASS" if before_kill > 0 and after_kill == 0 and not refiled else "FAIL"])
	GameState.apex_killed = []

	# 9. THE CHANNEL BATTERY. Every channel driven through the REAL entry point
	#    the game calls, in the system the player is standing in — a dossier
	#    filled by calling add_apex_hint directly proves the container works and
	#    nothing about whether anything in the world ever fills it.
	GameState.clear_apex_intel(system_id)
	var channel_rows := ""
	var channels_ok := true
	for spec in [
		["mast", 8.0, Vector3(300, 0, -120)],
		["relic", 12.0, Vector3(-80, 0, 60)],
		["guard", 15.0, Vector3(-420, 0, 380)],
		["watch", 5.0, Vector3(120, 0, 240)],
		["rift", 4.0, Vector3(-260, 0, -300)],
		["hull", Derelict.INTEL_ERROR_DEG, Vector3(-9, 0, -18)],
		["rumor", 0.0, Vector3.ZERO],
	]:
		var n_before := GameState.apex_hint_count(system_id)
		var took: bool = file_apex_intel(String(spec[0]), spec[2] as Vector3, float(spec[1]))
		var n_after := GameState.apex_hint_count(system_id)
		if not took or n_after != n_before + 1:
			channels_ok = false
		channel_rows += "%s%s " % [String(spec[0]), "+1" if n_after == n_before + 1 else "!!"]
	print("[hunt] EVERY CHANNEL FILES THROUGH ONE DOOR %s-> %d hints -> %s" % [
		channel_rows, GameState.apex_hint_count(system_id),
		"PASS" if channels_ok and GameState.apex_hint_count(system_id) == 7 else "FAIL"])

	# 9b. THE OPENING BEARING IS THE WIDEST. The hull's reading is the one cone
	#     in the game nobody pays for, so it has to be strictly worse than every
	#     cone somebody does. Read from the REAL constants rather than restated
	#     here — a list of numbers copied into an assertion agrees with itself
	#     forever, and the failure this guards is somebody tightening the free
	#     hint to make the opening hunt friendlier and silently undercutting the
	#     Last Watch's 900-salvage reading two systems away.
	#
	#     Three of the five are read from the constant the game actually uses;
	#     `guard` and `relic` are inline literals at their call sites with no
	#     named constant to read, so those two ARE restated here and this check
	#     is only as good as they are. Naming them would close that gap and is
	#     worth doing the next time either file is open.
	var paid_cones := {
		"guard(deep post)": 15.0,
		"relic": 12.0,
		"mast": SurveyMast.MAST_ERROR_DEG,
		"watch(Last Watch)": float(DeepPortDB.by_id("deep_watch").get("hunt_error", 0.0)),
		"rift": Rift.INTEL_ERROR_DEG,
	}
	var undercut := ""
	for k in paid_cones:
		if Derelict.INTEL_ERROR_DEG <= float(paid_cones[k]):
			undercut += "%s(%.0f) " % [k, float(paid_cones[k])]
	print("[hunt] THE OPENING BEARING IS THE WIDEST hull %.0f vs %s -> %s" % [
		Derelict.INTEL_ERROR_DEG, str(paid_cones),
		"PASS" if undercut == "" else "FAIL undercuts " + undercut])

	# 9b-ii. A CONVOY CONE IS THE WIDEST TOO, and it has to be: a hail is a
	#     GIFT, so if it were tighter than anything on the ladder it would make
	#     the paid readings worth less than the free one. Equal to the hull's is
	#     the honest ceiling. DeepSpace cannot name Derelict without adding an
	#     edge to the class graph for one number -- the same reason LAIR_KEEPOUT
	#     restates ApexBoss.LEASH_RANGE -- so the two agree HERE or nowhere.
	var convoy_undercut := ""
	for c_k in paid_cones:
		if DeepSpace.CONVOY_HINT_ERROR_DEG <= float(paid_cones[c_k]):
			convoy_undercut = String(c_k)
	print("[hunt] A CONVOY CONE IS THE WIDEST convoy %.0f vs hull %.0f and every paid cone %s -> %s" % [
		DeepSpace.CONVOY_HINT_ERROR_DEG, Derelict.INTEL_ERROR_DEG, str(paid_cones),
		"PASS" if convoy_undercut == ""
			and DeepSpace.CONVOY_HINT_ERROR_DEG >= Derelict.INTEL_ERROR_DEG
			else "FAIL undercuts " + convoy_undercut])

	# 9c. AND THE HULL ONLY SPEAKS FOR A SURVEY. Both directions, driven through
	#     two REAL derelicts rather than through file_apex_intel — the claim is
	#     about the breach path's guard, and calling the door directly would
	#     prove nothing about who is allowed to knock. A charted hull charts and
	#     files; a deep hulk does neither, for the same reason it never charted:
	#     letting something 400u off the map hand over the opening lead would let
	#     the expanse skip the hunt as well as the spine.
	# Snapshotted, not cleared and abandoned: sections 10-14 run after this one
	# and a harness that quietly empties `breached` on its way past is how the
	# next assertion below inherits a world it did not ask for.
	var breached_snapshot := GameState.breached.duplicate()
	var breach_rows := ""
	var breach_ok := true
	for survey in [true, false]:
		GameState.clear_apex_intel(system_id)
		GameState.breached = []
		var hull := Derelict.new()
		hull.counts_as_survey = survey
		system_root.add_child(hull)
		hull.position = Vector3(0, 0, -26)
		await get_tree().process_frame
		var spins := 0
		while not hull.is_cracked() and spins < 900:
			# Re-pinned EVERY frame, the way _pacing_derelict_yield does it:
			# hold_tick releases the hold and issues a move order the moment the
			# ship drifts out of CRACK_RANGE, so a single teleport before the
			# loop is a hold that quietly stops progressing partway through.
			player.teleport_to(hull.breach_point + Vector3(0, 0, 3.0))
			player.velocity = Vector3.ZERO
			hull.hold_begin()
			hull.hold_tick(get_physics_process_delta_time())
			spins += 1
			await get_tree().physics_frame
		var filed := GameState.apex_hint_count(system_id)
		var hull_charted := GameState.breached.has(system_id)
		breach_rows += "%s: %d hint / charted=%s  " % [
			"charted hull" if survey else "deep hulk", filed, str(hull_charted)]
		if survey and not (filed == 1 and hull_charted):
			breach_ok = false
		if not survey and not (filed == 0 and not hull_charted):
			breach_ok = false
		if is_instance_valid(hull):
			hull.queue_free()
	print("[hunt] THE HULL GIVES A BEARING, AND ONLY FOR A SURVEY %s-> %s" % [
		breach_rows, "PASS" if breach_ok else "FAIL"])

	# 9d. THE HULLS ARE OUTSIDE AND CLEAR. Three properties of the v18
	#     relocation, checked over the AUTHORED table for every system rather
	#     than over the one that happens to be built:
	#
	#       past the marker   depth > 0, or "outside the cordon" is a fiction
	#       in the Shoals     band 1, where PACK_CHANCE is 0.0 and nothing
	#                         procedural spawns on the approach — which is what
	#                         makes a tutorial-fresh pilot's first expedition
	#                         survivable
	#       clear of the lair by more than LAIR_KEEPOUT at the CLOSEST the
	#                         authored bands allow, for ANY bearing. Checked
	#                         against the band minimum rather than against this
	#                         run's rolled lair: the bearings are independent, so
	#                         a seed that happens to separate them proves nothing
	#                         about the seed that does not.
	var hull_rows := ""
	var hulls_ok := true
	for sid_v in SystemDB.ids():
		var sid := String(sid_v)
		var sdef := SystemDB.get_system(sid)
		if (sdef.get("derelict", {}) as Dictionary).is_empty():
			continue
		var hdep := SystemDB.derelict_depth(sid)
		var hband := DeepSpace.band_of(hdep)
		var hr := SystemDB.derelict_pos(sid).length()
		# The nearest the lair can ever be, over every legal bearing: the two
		# are on independent bearings, so the worst case is co-linear and the
		# separation is purely radial.
		var lair_band: Array = ((sdef.get("apex", {}) as Dictionary)
			.get("lair", {}) as Dictionary).get("depth", [0.0, 0.0])
		var lair_min_r := float(sdef.get("bounds", 40.0)) + float(lair_band[0])
		var worst_gap := lair_min_r - hr
		var row_ok: bool = hdep >= DeepSpace.CONTENT_MIN_DEPTH and hband == 1 \
			and worst_gap > DeepSpace.LAIR_KEEPOUT
		if not row_ok:
			hulls_ok = false
		hull_rows += "%s depth %.0f band %d gap>=%.0f%s  " % [
			sid, hdep, hband, worst_gap, "" if row_ok else " !!"]
	print("[hunt] THE HULLS ARE OUTSIDE AND CLEAR %s(min depth %.0f, band must be 1, gap must beat LAIR_KEEPOUT %.0f) -> %s" % [
		hull_rows, DeepSpace.CONTENT_MIN_DEPTH, DeepSpace.LAIR_KEEPOUT,
		"PASS" if hulls_ok else "FAIL"])

	# 9e. ONE HULL CARRIES THE PROGRESSION. With two crackables in PYX-01 the
	#     question "which one charts" stopped being answerable by tree order,
	#     and this is the assertion that keeps exactly one answer. Both clauses
	#     matter: TWO survey hulls would make charting a race, and ZERO would
	#     make the next system unreachable.
	var survey_hulls := 0
	var training_hulls := 0
	for n in get_tree().get_nodes_in_group("crackable"):
		if not (n is Derelict):
			continue
		if (n as Derelict).counts_as_survey:
			survey_hulls += 1
		else:
			training_hulls += 1
	var trainers_flagged := get_tree().get_nodes_in_group("training_hull").size()
	print("[hunt] ONE HULL CARRIES THE PROGRESSION %s: %d survey hull, %d non-survey (%d in the training group) -> %s" % [
		system_id, survey_hulls, training_hulls, trainers_flagged,
		"PASS" if survey_hulls == 1 and training_hulls == trainers_flagged else "FAIL"])
	GameState.clear_apex_intel(system_id)
	GameState.breached = breached_snapshot

	# 10. INTEL BUYS INFORMATION, NOT ADVANTAGE. Filing hints must move no
	#     number the economy or the fight cares about. The hunt is allowed to
	#     cost credits at a desk; it is never allowed to PAY them, heal anything,
	#     or hand over cargo. Measured across every channel at once.
	GameState.clear_apex_intel(system_id)
	var salv_before := GameState.salvage
	var cargo_before := GameState.cargo_used()
	var arch_before := GameState.archeology_xp
	var led_before: int = int(GameState.ledger.get("posts_cleared", 0))
	for spec2 in [["mast", 8.0], ["relic", 12.0], ["guard", 15.0], ["rift", 4.0]]:
		file_apex_intel(String(spec2[0]), Vector3(200, 0, 200), float(spec2[1]))
	var quiet: bool = GameState.salvage == salv_before \
		and is_equal_approx(GameState.cargo_used(), cargo_before) \
		and GameState.archeology_xp == arch_before \
		and int(GameState.ledger.get("posts_cleared", 0)) == led_before
	print("[hunt] INTEL BUYS INFORMATION salvage %d->%d, cargo %.1f->%.1f, arch xp %d->%d, posts %d->%d -> %s" % [
		salv_before, GameState.salvage, cargo_before, GameState.cargo_used(),
		arch_before, GameState.archeology_xp,
		led_before, int(GameState.ledger.get("posts_cleared", 0)),
		"PASS" if quiet else "FAIL"])

	# 11. THE GHOST STAYS OFF THE RADAR UNTIL THE DOSSIER EARNS IT. A confident
	#     arrow pointing at a weak estimate is worse than no arrow: it spends the
	#     player's fuel on the harness's rounding error.
	GameState.clear_apex_intel(system_id)
	var weak: Dictionary = hunt_estimate(system_id)
	var weak_shown: bool = int(weak["strength"]) >= HUD.RadarLayer.HUNT_MIN_STRENGTH \
		and float(weak["radius"]) <= HUD.RadarLayer.HUNT_MAX_RADIUS
	for spec3 in [["mast", 8.0, Vector3(600, 0, -200)], ["watch", 5.0, Vector3(-500, 0, 300)],
			["rift", 4.0, Vector3(200, 0, 700)], ["guard", 15.0, Vector3(-300, 0, -600)]]:
		file_apex_intel(String(spec3[0]), spec3[2] as Vector3, float(spec3[1]))
	var strong: Dictionary = hunt_estimate(system_id)
	var strong_shown: bool = int(strong["strength"]) >= HUD.RadarLayer.HUNT_MIN_STRENGTH \
		and float(strong["radius"]) <= HUD.RadarLayer.HUNT_MAX_RADIUS
	print("[hunt] THE GHOST IS EARNED empty: strength %d radius %.0f shown=%s; four readings: strength %d radius %.0f shown=%s -> %s" % [
		int(weak["strength"]), float(weak["radius"]), str(weak_shown),
		int(strong["strength"]), float(strong["radius"]), str(strong_shown),
		"PASS" if not weak_shown and strong_shown else "FAIL"])

	# 12. AND THE CACHE CANNOT GO STALE. hunt_estimate memoises on
	#     intel_version; a cache that missed an edit would leave the ghost
	#     pointing at the previous dossier's answer, which is the kind of bug
	#     that looks like the estimator being wrong.
	var cached_before: Dictionary = hunt_estimate(system_id)
	file_apex_intel("mast", Vector3(-900, 0, 450), 8.0)
	var cached_after: Dictionary = hunt_estimate(system_id)
	var moved := (cached_before["center"] as Vector3).distance_to(cached_after["center"] as Vector3)
	print("[hunt] THE ESTIMATE CACHE INVALIDATES filing a 5th reading moved the cached estimate %.1fu / radius %.0f -> %.0f / strength %d -> %d -> %s" % [
		moved, float(cached_before["radius"]), float(cached_after["radius"]),
		int(cached_before["strength"]), int(cached_after["strength"]),
		"PASS" if moved > 0.01 or not is_equal_approx(
			float(cached_before["radius"]), float(cached_after["radius"])) else "FAIL"])

	# 13. BUYING INTEL NEVER WIDENS THE SEARCH. Asserted over MANY dossiers
	#     rather than one fixed set, because the failure it guards is a
	#     resolution artifact and those hide behind whichever hints you happened
	#     to pick: a coarse scan under-measures a narrow agreement, so a later,
	#     better-resolved estimate can read as WIDER than an earlier sloppy one.
	#     A player who pays 900 salvage and watches the circle grow has been
	#     told the hunt is broken, whatever the arithmetic says.
	var widened := ""
	var grow_ok := true
	for trial in range(6):
		GameState.clear_apex_intel(system_id)
		var prev_r := 1.0e9
		# A different spread of origins per trial, so this covers cone geometries
		# rather than one lucky arrangement.
		for step in range(5):
			var a := TAU * (float(step) * 0.2 + float(trial) * 0.11)
			var d := 320.0 + float(trial) * 90.0 + float(step) * 45.0
			file_apex_intel("mast", Vector3(cos(a) * d, 0, sin(a) * d),
				[8.0, 5.0, 12.0, 4.0, 15.0][step])
			var r := float(hunt_estimate(system_id)["radius"])
			if r > prev_r * (1.0 + Hunt.RESIDUAL_FRACTION):
				grow_ok = false
				widened += "t%d/h%d %.0f->%.0f " % [trial, step + 1, prev_r, r]
			prev_r = r
	print("[hunt] BUYING INTEL NEVER WIDENS THE SEARCH 6 dossiers x 5 readings, %s -> %s" % [
		"no growth" if widened == "" else "GREW: " + widened, "PASS" if grow_ok else "FAIL"])
	GameState.clear_apex_intel(system_id)

	# 14. THE FREE CHANNELS ARE GATED ON BEING THERE. Driven through the real
	#     node, because the gate is the whole reason a free channel does not
	#     wreck the hunt: a shear that files intel from any distance is a
	#     bearing you collect by flying past, and the ladder of paid readings
	#     stops meaning anything. The far case runs FIRST — the one-shot flag
	#     must not have been spent by a read that should never have happened.
	GameState.clear_apex_intel(system_id)
	var shear := spawn_rift()
	var gate_ok := false
	var far_hints := -1
	var near_hints := -1
	if shear != null:
		player.global_position = shear.global_position \
			+ Vector3(Rift.INTEL_READ_RANGE * 3.0, 0, 0)
		await get_tree().physics_frame
		shear.pulse()
		await get_tree().physics_frame
		far_hints = GameState.apex_hint_count(system_id)
		player.global_position = shear.global_position + Vector3(3, 0, 0)
		await get_tree().physics_frame
		shear.pulse()
		await get_tree().physics_frame
		near_hints = GameState.apex_hint_count(system_id)
		gate_ok = far_hints == 0 and near_hints == 1
		# And only ONCE per shear, or a player parked on a tear narrows the
		# estimate for free every 75 seconds.
		shear.pulse()
		await get_tree().physics_frame
		gate_ok = gate_ok and GameState.apex_hint_count(system_id) == 1
	print("[hunt] A SHEAR ONLY TALKS TO WHOEVER IS THERE pulsed from %.0fu: %d hints; from 3u: %d; pulsed again: %d -> %s" % [
		Rift.INTEL_READ_RANGE * 3.0, far_hints, near_hints,
		GameState.apex_hint_count(system_id), "PASS" if gate_ok else "FAIL"])
	player.global_position = Vector3.ZERO
	GameState.clear_apex_intel(system_id)


	# --- 15. THE WORD, THE DESK AND THE WASH ---------------------------------
	#     Placed LAST on purpose: THE FREE WORD IS FILED drives the real
	#     mark_breached, which fires system_unlocked and files a ring into this
	#     system's dossier. INTEL NARROWS and BUYING INTEL NEVER WIDENS both
	#     build their own dossiers in this same system, so anything that files
	#     behind their backs has to come after them, not before.
	var word_breached: Array[String] = GameState.breached.duplicate()
	var word_lanes: Array[String] = GameState.lanes_open.duplicate()
	GameState.clear_apex_intel(system_id)
	GameState.breached = [] as Array[String]
	GameState.lanes_open = [] as Array[String]
	var word_before := GameState.apex_hints(system_id).size()
	# THE REAL PATH. Calling file_apex_intel directly would prove nothing --
	# what was missing was never the door, it was the CONNECTION to it. The
	# relay spoke this word for seven and a half seconds and then destroyed
	# it, while the chart panel two taps away said "no intel" and shaded all
	# 360 degrees, contradicting the sentence the player was acting on.
	GameState.mark_breached("pyx01")
	await get_tree().process_frame
	var word_hints := GameState.apex_hints(system_id)
	var word_filed: bool = word_hints.size() == word_before + 1
	var word_is_ring := false
	if word_filed:
		word_is_ring = String((word_hints[word_hints.size() - 1] as Dictionary)
			.get("kind", "")) == "ring"
	var word_body := hud.broadcast_text()
	# It must name a SECTOR and must not call it a bearing -- the paid channel
	# means "%03d, plus or minus twenty" by that noun, and spending it on a
	# ninety-degree quarter is what sent a playtester down one straight line.
	var word_says_quarter: bool = word_body.findn("quarter") >= 0
	# The OLD CONSTRUCTION specifically -- "bearing NORTH" -- not the word
	# itself. The new copy says "that is a quarter of the sky, NOT A BEARING",
	# which is the correction, and an assertion that banned the noun outright
	# would have forbidden the sentence doing the teaching.
	var word_avoids_bearing: bool = word_body.findn(
		"bearing %s" % _lair_quadrant(system_id)) < 0
	# Selected explicitly rather than trusting open()'s default: open() reads
	# GameState.current_system and returns EARLY if the sheet is already up, so
	# an assertion that merely opened it would be reading whatever the last
	# section left on screen -- which is how a check like this passes on a
	# panel it never actually refreshed.
	chart_panel.open()
	chart_panel._selected = system_id
	chart_panel._refresh()
	await get_tree().process_frame
	var word_chart_agrees: bool = not _panel_text_contains(chart_panel, "no intel")
	chart_panel.close_panel()
	print("[hunt] THE FREE WORD IS FILED, AND IT NAMES A SECTOR filed=%s as a ring=%s, says quarter=%s, avoids 'bearing'=%s, chart stops saying 'no intel'=%s -> %s" % [
		str(word_filed), str(word_is_ring), str(word_says_quarter),
		str(word_avoids_bearing), str(word_chart_agrees),
		"PASS" if word_filed and word_is_ring and word_says_quarter
			and word_avoids_bearing and word_chart_agrees else "FAIL"])

	# THE WORD IS SOLD ONCE. With the ring on file the ring desk has nothing
	# left to sell -- it never did for the current system, and filing the free
	# broadcast is what made that visible. Both directions: the button is gone
	# with a ring on file and back without one.
	# THE DESK HAS TO EXIST TO BE READ. HUNTTEST travels between systems, and
	# the cantina is a pyx01 port -- an earlier section can leave the harness
	# standing somewhere it was never built. Without this the sweep below reads
	# its own initial values and reports "hidden, and it did not come back",
	# which is what a missing port looks like when nobody asks.
	# AND THE ENGINE HAS TO BE ALIVE. _build_hunt_desk refuses to sell a hunt
	# for a system whose engine is already dead, which is correct -- and which
	# earlier sections of this harness make true. Both preconditions are
	# restored here rather than assumed, and both are reported below, because
	# a desk that never rendered and a row correctly suppressed produce the
	# same silence.
	GameState.apex_killed.erase("pyx01")
	if system_id != "pyx01":
		_load_system("pyx01")
		await get_tree().create_timer(0.4).timeout
	var desk_port: Port = null
	for node_d in get_tree().get_nodes_in_group("dockable"):
		if node_d is Port and String((node_d as Port).port_id) == "cantina":
			desk_port = node_d as Port
			break
	var desk_hidden := true
	var desk_returns := false
	var desk_salvage := GameState.salvage
	if desk_port != null:
		port_panel.open_for(desk_port)
		# THE DESK IS ON THE RUMOURS TAB, and open_for lands on the port's
		# FIRST service. Without this the sweep would read a market list, find
		# no BUY button in either direction, and report the row hidden because
		# it was looking at the wrong page -- an assertion agreeing with itself
		# about a screen it never opened.
		port_panel._tab = "rumors"
		port_panel._refresh()
		await get_tree().process_frame
		desk_hidden = not _panel_text_contains(port_panel, "BUY THE WORD")
		GameState.clear_apex_intel(system_id)
		port_panel._refresh()
		await get_tree().process_frame
		desk_returns = _panel_text_contains(port_panel, "BUY THE WORD")
		port_panel.close_panel()
	print("[hunt] THE WORD IS SOLD ONCE desk found=%s; with a ring on file it offers nothing=%s, without one it offers it again=%s, salvage unmoved=%s -> %s" % [
		str(desk_port != null), str(desk_hidden), str(desk_returns),
		str(GameState.salvage == desk_salvage),
		"PASS" if desk_port != null and desk_hidden and desk_returns
			and GameState.salvage == desk_salvage else "FAIL"])
	GameState.breached = word_breached
	GameState.lanes_open = word_lanes
	GameState.clear_apex_intel(system_id)

	# THE CARRIER WASHES OUT. The lair keep-out strips stations, nests, hulks
	# and convoys, so the arena is QUIETER than the sky around it -- and
	# "nothing here, keep moving" is exactly the wrong instinct. The wash turns
	# that silence into a statement without putting the engine on the map.
	#
	# The fourth clause is the one that matters: NO RADAR MARKER at either
	# sample. The inner sample sits at 100u, inside the 120u wash and outside
	# the 90u detection cutoff, so if anybody ever reimplements this tell as a
	# marker this assertion and THE ENGINE IS NOT ON THE MAP both go red.
	var wash_lair := SystemDB.lair_pos(system_id, GameState.run_seed)
	var wash_engine := _find_apex()
	var wash_rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	player.global_position = wash_lair + Vector3(0, 0, DeepSpace.LAIR_KEEPOUT + 60.0)
	wash_rig.global_position = player.global_position
	await get_tree().create_timer(0.5).timeout
	var wash_far: bool = hud.system_tag_text().contains("SOMETHING IS CLOSE")
	var wash_far_marked: bool = wash_engine != null \
		and not _radar_marker_for(wash_engine).is_empty()
	player.global_position = wash_lair + Vector3(0, 0, DeepSpace.LAIR_KEEPOUT - 20.0)
	wash_rig.global_position = player.global_position
	await get_tree().create_timer(0.5).timeout
	var wash_near: bool = hud.system_tag_text().contains("SOMETHING IS CLOSE")
	var wash_near_marked: bool = wash_engine != null \
		and not _radar_marker_for(wash_engine).is_empty()
	print("[hunt] THE CARRIER WASHES OUT at %.0fu out: wash=%s; at %.0fu in: wash=%s; engine on the radar at either range=%s/%s (both must be false) -> %s" % [
		DeepSpace.LAIR_KEEPOUT + 60.0, str(wash_far),
		DeepSpace.LAIR_KEEPOUT - 20.0, str(wash_near),
		str(wash_far_marked), str(wash_near_marked),
		"PASS" if not wash_far and wash_near and not wash_far_marked
			and not wash_near_marked else "FAIL"])

	# --- the engine answers a filed survey, and says so when it will not -----
	# THE ONE PATH NO HARNESS EVER FLEW. Every other apex check in this file
	# hand-sets `_apex_wake_timer = 0.2` after teleporting to the lair, which
	# starts the poll at its proximity test and skips the question of whether the
	# poll RUNS AT ALL. It did not: the arming test in _load_system asked about
	# the breach, so an unbreached system never polled, and a pilot who found the
	# engine before filing the survey got no wake, no refusal and no line. Thirty
	# apex assertions and not one could see it, because all thirty armed the
	# timer themselves.
	#
	# So this one is driven by FLYING AND WAITING, and touches _apex_wake_timer
	# nowhere. Both directions in one check: the refusal has to speak, and the
	# breach has to wake it where the ship already stands.
	GameState.breached = []
	_load_system("pyx01")
	_wave_timer = 1.0e9
	await get_tree().create_timer(0.5).timeout
	var sleeper_boss := _find_apex()
	var sleeper_ok := sleeper_boss != null
	var sleeper_deg := SystemDB.derelict_bearing_deg("pyx01")
	var sleeper_depth := int(round(SystemDB.derelict_depth("pyx01")))
	if sleeper_ok:
		player.global_position = sleeper_boss.global_position + Vector3(0, 0, 12.0)
		wash_rig.global_position = player.global_position
		# Long enough for APEX_WAKE_DELAY to expire AND for several 1s re-polls,
		# so a poll that fired once and died is not mistaken for one that holds.
		await get_tree().create_timer(APEX_WAKE_DELAY + 4.0).timeout
	var sleeper_slept: bool = sleeper_ok and not boss_active \
		and sleeper_boss.state == ApexBoss.State.DORMANT
	# The refusal is only worth anything if it is READABLE, and the bearing is
	# the whole payload: the player is 300u past the hull they need to breach.
	var sleeper_said: String = hud.broadcast_text()
	var sleeper_spoke: bool = sleeper_said.contains("%03d" % sleeper_deg) \
		and sleeper_said.contains("%du" % sleeper_depth)
	# And now file it, without moving the ship an inch.
	GameState.mark_breached("pyx01")
	if sleeper_ok:
		await get_tree().create_timer(APEX_BREACH_DELAY + ApexBoss.WAKE_TIME + 2.0).timeout
	var sleeper_woke: bool = sleeper_ok and boss_active \
		and sleeper_boss.state != ApexBoss.State.DORMANT
	print("[hunt] A DORMANT ENGINE SAYS WHY unbreached at 12u: slept=%s, said bearing %03d / %du=%s; after the breach, same berth: woke=%s -> %s" % [
		str(sleeper_slept), sleeper_deg, sleeper_depth, str(sleeper_spoke), str(sleeper_woke),
		"PASS" if sleeper_slept and sleeper_spoke and sleeper_woke else "FAIL"])

	get_tree().quit()


func _run_colony_test() -> void:
	# v20 HUNT STAGE 6. The instruments: where they stand, that nothing points
	# at them, that the wardens gate the claim, that a claim outlives both
	# wipes, and that the jump is a foothold rather than a farm.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_rift_timer = 1.0e9
	_muster_timer = 1.0e9
	_cordon_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	GameState.colonies = {}
	await get_tree().create_timer(0.4).timeout

	# --- A. determinism, over many seeds rather than one ---------------------
	# A single-seed check passes on luck. This project has the receipt: a
	# separation assertion "passed twice at 317u and 337u" before anyone swept.
	var seeds := 200
	var counts := {}
	var worst_sep := 1.0e9
	var worst_spread := 1.0e9
	var stable := true
	var floors_ok := true
	for sd in range(seeds):
		for sid_v in SystemDB.ids():
			var sid := String(sid_v)
			var ps := SystemDB.hyper_positions(sid, sd)
			counts[ps.size()] = int(counts.get(ps.size(), 0)) + 1
			var b := SystemDB.bounds_of(sid)
			var dmin := 1.0e9
			var dmax := -1.0e9
			for i in range(ps.size()):
				var d: float = (ps[i] as Vector3).length() - b
				dmin = minf(dmin, d)
				dmax = maxf(dmax, d)
				if d < SystemDB.HYPER_DEPTH_MIN - 0.5 or d > SystemDB.HYPER_DEPTH_MAX + 0.5:
					floors_ok = false
				for j in range(i + 1, ps.size()):
					worst_sep = minf(worst_sep,
						(ps[i] as Vector3).distance_to(ps[j] as Vector3))
			if ps.size() > 1:
				worst_spread = minf(worst_spread, dmax - dmin)
	var twice_a := SystemDB.hyper_positions("pyx02", 7)
	var twice_b := SystemDB.hyper_positions("pyx02", 7)
	stable = str(twice_a) == str(twice_b)
	var counts_ok := true
	for k_v in counts:
		if int(k_v) < SystemDB.HYPER_MIN or int(k_v) > SystemDB.HYPER_MAX:
			counts_ok = false
	print("[colony] THE INSTRUMENTS ARE WHERE THE SALT PUT THEM %d seeds x %d systems, counts %s all in [%d,%d]=%s, same seed twice identical=%s, every depth inside [%.0f,%.0f]=%s -> %s" % [
		seeds, SystemDB.ids().size(), str(counts), SystemDB.HYPER_MIN,
		SystemDB.HYPER_MAX, str(counts_ok), str(stable),
		SystemDB.HYPER_DEPTH_MIN, SystemDB.HYPER_DEPTH_MAX, str(floors_ok),
		"PASS" if counts_ok and stable and floors_ok else "FAIL"])

	# --- B. none near another, and none at one ring --------------------------
	print("[colony] NONE NEAR ANOTHER, AND NONE AT ONE RING worst pairwise gap over %d draws %.0fu vs %.0f; worst depth spread %.0fu (0 = one shared depth roll) -> %s" % [
		seeds * SystemDB.ids().size(), worst_sep, SystemDB.MIN_HYPER_SEPARATION,
		worst_spread,
		"PASS" if worst_sep >= SystemDB.MIN_HYPER_SEPARATION
			and worst_spread > 50.0 else "FAIL"])

	# --- C. outside the arena, from the AUTHORED bands -----------------------
	# Not from this run's rolled positions: the claim is about every seed that
	# could ever be rolled, so it is derived from the two authored ceilings.
	var worst_gap := 1.0e9
	var gap_report := ""
	for sid_v2 in SystemDB.ids():
		var sid2 := String(sid_v2)
		if SystemDB.hyper_family(sid2) == "":
			continue
		var lair: Dictionary = (SystemDB.get_system(sid2).get("apex", {}) as Dictionary).get("lair", {})
		if lair.is_empty():
			continue
		var band: Array = lair.get("depth", [200.0, 300.0])
		var b2 := SystemDB.bounds_of(sid2)
		var lair_ceiling := b2 + float(band[1])
		var hyper_floor := b2 + SystemDB.HYPER_DEPTH_MIN
		var gap := hyper_floor - lair_ceiling
		worst_gap = minf(worst_gap, gap)
		gap_report += "%s %.0f " % [sid2, gap]
	print("[colony] OUTSIDE THE ARENA worst instrument-floor to lair-ceiling gap: %svs LAIR_KEEPOUT %.0f -> %s" % [
		gap_report, DeepSpace.LAIR_KEEPOUT,
		"PASS" if worst_gap >= DeepSpace.LAIR_KEEPOUT else "FAIL"])

	# --- D. nothing points at them -------------------------------------------
	# The discovery pillar, asserted as an EMPTINESS over every scanned group,
	# plus the hunt estimate, plus the radar board itself.
	_load_system("pyx01")
	set_deep_generation(false)
	await get_tree().physics_frame
	var built := get_tree().get_nodes_in_group("hyper").size()
	var leak := ""
	for g in ["apex", "dockable", "crackable", "hostiles", "mineable", "beacon", "signature"]:
		for n_v in get_tree().get_nodes_in_group(g):
			if n_v is HyperStructure:
				leak += "%s " % g
	var pilot := get_tree().get_first_node_in_group("player")
	var spots := SystemDB.hyper_positions("pyx01", GameState.run_seed)
	var board_clean := true
	if not spots.is_empty() and pilot != null:
		# Stand off one and look at the board. The FIRST draft of this clause was
		# `board_clean = board_clean` inside a conditional — a tautology that
		# could not fail, which is precisely the shape this project keeps
		# catching. Markers carry the collected node's instance id, so the real
		# question is answerable: does any marker id belong to a HyperStructure?
		pilot.teleport_to((spots[0] as Vector3) + Vector3(300.0, 0.0, 0.0))
		var rig0 := get_tree().get_first_node_in_group("camera_rig")
		if rig0:
			rig0.global_position = pilot.global_position + Vector3(0, 0, 2)
		await get_tree().create_timer(0.6).timeout
		var hyper_ids := {}
		for h3_v in get_tree().get_nodes_in_group("hyper"):
			hyper_ids[(h3_v as Node).get_instance_id()] = true
		for m_v in hud.radar_markers():
			var m: Dictionary = m_v
			if hyper_ids.has(int(m.get("id", 0))):
				board_clean = false
	print("[colony] NOTHING POINTS AT THEM %d instruments built, leaked into scanned groups: %s, radar clean beside one=%s -> %s" % [
		built, leak if leak != "" else "none", str(board_clean),
		"PASS" if built >= SystemDB.HYPER_MIN and leak == "" and board_clean
			else "FAIL"])

	# --- E. the wardens gate the claim ---------------------------------------
	var inst: HyperStructure = null
	for h_v in get_tree().get_nodes_in_group("hyper"):
		inst = h_v as HyperStructure
		break
	var gate_ok := false
	var freed_ok := false
	var prompt_named := false
	if inst != null and pilot != null:
		pilot.teleport_to(inst.global_position + Vector3(8.0, 0.0, 0.0))
		await get_tree().create_timer(0.4).timeout
		var standing := inst.wardens_standing()
		hud.clear_prompt()
		inst.hold_begin()
		inst.hold_tick(0.5)
		gate_ok = standing > 0 and not inst.is_claimed()
		# THE PROMPT FADES IN over 0.2s, so it cannot be read on the same frame
		# it is set — the alpha-zero trap this session already paid for once in
		# the parley. Wait for the tween before asking what the player can see.
		await get_tree().create_timer(0.4).timeout
		prompt_named = hud.prompt_text().contains(str(standing))
		for w_v in get_tree().get_nodes_in_group("hostiles"):
			if is_instance_valid(w_v) and (w_v as Node).has_meta("warden_key"):
				(w_v as Node).free()
		await get_tree().physics_frame
		inst.hold_begin()
		for i in range(20):
			inst.hold_tick(0.5)
		freed_ok = inst.is_claimed()
	print("[colony] THE WARDENS GATE THE CLAIM held under %d wardens without founding=%s, the prompt names the count=%s, founded once they are down=%s -> %s" % [
		inst.wardens_standing() if inst else -1, str(gate_ok), str(prompt_named),
		str(freed_ok), "PASS" if gate_ok and prompt_named and freed_ok else "FAIL"])

	# --- F. a claim outlives both wipes --------------------------------------
	# The warp, and the one nobody thinks of: rebuild_visuals() routes through
	# _load_system when the player changes a COLOUR setting, and deep_space
	# clears its session sets on every rebuild. Wardens keyed off session state
	# would come back on a colony founded an hour ago.
	var claimed_key := inst.claim_key() if inst else ""
	_load_system("pyx02")
	await get_tree().physics_frame
	_load_system("pyx01")
	await get_tree().physics_frame
	var after_warp := GameState.is_colony_claimed(claimed_key)
	var warp_wardens := 0
	rebuild_visuals()
	await get_tree().physics_frame
	var after_colour := GameState.is_colony_claimed(claimed_key)
	var colour_wardens := 0
	for h2_v in get_tree().get_nodes_in_group("hyper"):
		var h2 := h2_v as HyperStructure
		if h2 != null and h2.claim_key() == claimed_key:
			h2._process(0.016)
			colour_wardens = h2.wardens_standing()
	print("[colony] A CLAIM OUTLIVES A WARP after a warp claimed=%s wardens %d; after a COLOUR rebuild claimed=%s wardens %d -> %s" % [
		str(after_warp), warp_wardens, str(after_colour), colour_wardens,
		"PASS" if after_warp and after_colour and colour_wardens == 0 else "FAIL"])

	# --- G. the refusal set, one flag at a time ------------------------------
	GameState.salvage = 100000
	GameState.last_outbound_jump = -1.0e9
	var base_ok := can_colony_jump(claimed_key)
	boss_active = true
	var no_boss := not can_colony_jump(claimed_key)
	boss_active = false
	warping = true
	var no_warp := not can_colony_jump(claimed_key)
	warping = false
	GameState.salvage = 10
	var no_broke := not can_colony_jump(claimed_key)
	GameState.salvage = 100000
	var no_unclaimed := not can_colony_jump("pyx01:99")
	GameState.last_outbound_jump = GameState.played_seconds
	var no_cooling := not can_colony_jump(claimed_key)
	GameState.last_outbound_jump = -1.0e9
	print("[colony] THE JUMP IS REFUSED base allowed=%s; boss=%s warping=%s broke=%s unclaimed=%s cooling=%s -> %s" % [
		str(base_ok), str(no_boss), str(no_warp), str(no_broke),
		str(no_unclaimed), str(no_cooling),
		"PASS" if base_ok and no_boss and no_warp and no_broke and no_unclaimed
			and no_cooling else "FAIL"])

	# --- H. one clock for all of them ----------------------------------------
	# The defect a single-colony test cannot see: per-colony stamps would let a
	# player found five and be outbound five times as often.
	GameState.colonies = {}
	GameState.claim_colony("pyx01:0", 2000.0, 0.0)
	GameState.claim_colony("pyx01:1", 0.0, 2500.0)
	GameState.salvage = 100000
	GameState.last_outbound_jump = GameState.played_seconds
	var second_refused := not can_colony_jump("pyx01:1")
	GameState.last_outbound_jump = GameState.played_seconds - COLONY_JUMP_COOLDOWN - 1.0
	var later_allowed := can_colony_jump("pyx01:1")
	print("[colony] ONE CLOCK FOR ALL OF THEM jumped to one, a jump to a DIFFERENT colony refused inside the %.0fs cooldown=%s, allowed after it=%s -> %s" % [
		COLONY_JUMP_COOLDOWN, str(second_refused), str(later_allowed),
		"PASS" if second_refused and later_allowed else "FAIL"])

	# --- I. the jump is a foothold, not a farm -------------------------------
	# Derived from live constants, the WARP FARM shape. Recall home is FREE, so
	# a jump halves a ROUND trip: the saved flight is the outbound leg only.
	# The rate that matters is saved-seconds per cooldown-second — above 1.0 the
	# player is gaining more travel time than the clock costs them.
	var speed := float(ModuleDB.BASE.get("max_speed", 5.75))
	# §106, S4. RE-DERIVED AGAINST THE DEEPEST THING A JUMP CAN NOW REACH, and
	# this is the reversal taken in the open rather than slipped past. The line
	# read `HYPER_DEPTH_MAX` alone, which computes the deepest reachable point
	# from a CONSTANT rather than from the world -- so the day the nursery's
	# anchor put a jumpable destination at FarMarks depth, this leg would have
	# gone on printing PASS while the number it prints stopped being true. The
	# beacon cap's own comment (main.gd, BEACON_JUMP_MAX_DEPTH) predicted this
	# exact failure in as many words.
	#
	# The bound MOVES with it, and the argument for moving it is the thing that
	# makes the nursery's anchor different in kind from every other jump: it is
	# HELD, NOT OWNED. A beacon jump is bought once and is a door forever; this
	# one is priced in fights, forever, and closes the day the Tally take the
	# ground back. That is rent, not a farm -- so the guard the bound has to
	# keep is unchanged in spirit (a cooldown that stops mattering) while the
	# distance it is measured over has honestly doubled.
	var deepest := SystemDB.bounds_of("pyx03") \
		+ maxf(SystemDB.HYPER_DEPTH_MAX, FarMarks.DEPTH_MAX)
	var saved := deepest / speed
	var ratio := saved / COLONY_JUMP_COOLDOWN
	# 5.5 rather than 3.0, and the arithmetic is stated so a retune argues with
	# a number instead of a feeling: at 5.5 the clock cannot fall below ~285s
	# without this going red, which pins it TIGHTER to the authored 300 than the
	# old bound pinned it (~245s). The guard got stricter as the reach grew.
	var bound := 5.5
	# THE BOUND IS A GUARD ON THE COOLDOWN, and it is worth saying what it is
	# not. A ratio above 1.0 means the jump saves more flying than it costs in
	# waiting — which is the POINT of an earned foothold, not a defect, and the
	# deep does not regenerate within a session (cells remember being cleared),
	# so more trips to the same neighbourhood pay nothing anyway. What the bound
	# catches is a cooldown that stops mattering: at 3.0 the clock cannot fall
	# below ~245s without this going red, which pins it to within ~20% of the
	# authored 300 and makes "someone tuned it to 30s" impossible to ship.
	var floor_cooldown := saved / bound
	# AND THE DEEPEST REACHABLE POINT IS MEASURED, NOT ASSUMED. The clause that
	# would have caught the silent break if it had existed: whatever the deepest
	# jumpable destination in the game is, this leg must be deriving from it.
	var reach_ok: bool = deepest >= SystemDB.bounds_of("pyx03") + FarMarks.DEPTH_MAX
	print("[colony] A FOOTHOLD, NOT A FARM deepest %.0fu (past the far marks=%s) = %.0fs flown at %.2f u/s, against a %.0fs shared cooldown = %.2f saved-seconds per cooldown-second (bound %.1f, i.e. the cooldown may not fall below %.0fs; the %d fee is %.0f cr/min, a rounding error — the clock is the mechanism) -> %s" % [
		deepest, str(reach_ok), saved, speed, COLONY_JUMP_COOLDOWN, ratio, bound,
		floor_cooldown,
		COLONY_JUMP_FEE, float(COLONY_JUMP_FEE) * 60.0 / COLONY_JUMP_COOLDOWN,
		"PASS" if ratio <= bound and reach_ok else "FAIL"])

	# --- J. and it names no pacing term --------------------------------------
	var named := PACING_LOOP.has("colony") or PACING_LOOP.has("hyper")
	print("[colony] A JUMP IS NOT A RAISE PACING_LOOP names a colony term=%s -> %s" % [
		str(named), "PASS" if not named else "FAIL"])

	# --- K. the monument answers a tap (v22, 88) -----------------------------
	# The claim hold was wired from the day these shipped and a playtest still
	# reported "no way to interact", because the tap -- the verb every player
	# tries first on the biggest object in the game -- did nothing. on_tapped
	# states the terms through the real prompt, and the alpha-zero trap from
	# BEACONTEST applies: the prompt fades in, so it cannot be read on the
	# frame it is set.
	#
	# ITS FIRST MEASUREMENT WAS RED, AND THE TEST WAS THE WRONG HALF. It took
	# whatever `get_nodes_in_group("hyper")` handed back first and demanded the
	# unclaimed wording -- but leg H four screens up claims pyx01:0 and pyx01:1
	# by hand, so "first in the group" is a CLAIMED monument answering the
	# claimed branch perfectly. The code was doing exactly what 88 asked of it.
	# Picking by STATE rather than by tree order fixes it and asserts the real
	# promise, which was always the stronger one: EVERY branch answers, so both
	# are tapped here and both must name themselves and their verb.
	var claimed_mon: HyperStructure = null
	var open_mon: HyperStructure = null
	for h_v2 in get_tree().get_nodes_in_group("hyper"):
		var h3 := h_v2 as HyperStructure
		if h3 == null:
			continue
		if h3.is_claimed():
			if claimed_mon == null:
				claimed_mon = h3
		elif open_mon == null:
			open_mon = h3
	var tap_ok := false
	var tap_text := ""
	var claimed_text := ""
	if open_mon != null and claimed_mon != null and hud != null:
		hud.clear_prompt()
		open_mon.on_tapped()
		await get_tree().create_timer(0.4).timeout
		tap_text = hud.prompt_text()
		hud.clear_prompt()
		claimed_mon.on_tapped()
		await get_tree().create_timer(0.4).timeout
		claimed_text = hud.prompt_text()
		tap_ok = tap_text.contains(open_mon.designation()) \
			and (tap_text.contains("HOLD AT THE BASE") or tap_text.contains("WARDEN")) \
			and claimed_text.contains(claimed_mon.designation()) \
			and claimed_text.contains("JUMP")
	print("[colony] THE MONUMENT ANSWERS A TAP unclaimed says '%s'; claimed says '%s'; both name themselves and their verb -> %s" % [
		tap_text, claimed_text, "PASS" if tap_ok else "FAIL"])

	# --- §112. THE SOUNDED GROUND ---------------------------------------------

	# WORKS ARE GATES, AND THE INVESTMENT IS A SINK. One purchase of each work
	# on a sounded colony: the wallet moves by exactly the price, nothing pays
	# anything back, and no ship stat moves -- measured, §26's whole claim.
	GameState.colonies = {}
	GameState.colony_works = {}
	GameState.skills = {}
	# §126. THE PURSE IS DERIVED FROM THE PRICES, not typed beside them. This
	# read 30,000 against a ladder that totalled 28,000, so the re-pricing to
	# 101,000 would have reddened this leg with "a work refused" -- a pricing
	# change reported as a mechanism failure, which is the worst kind of red
	# because it sends the next reader to the wrong file. A fixture sized off
	# the thing it exercises cannot go stale.
	var works_want := 0
	for wp_v in GameState.COLONY_WORKS:
		works_want += int((GameState.COLONY_WORKS[wp_v] as Dictionary)["price"])
	GameState.salvage = works_want * 2
	GameState.claim_colony("pyx01:7", 2000.0, 0.0)
	var wcell := DeepSpace.cell_of(Vector3(2000.0, 0.0, 0.0))
	GameState.note_survey_worked(DeepSpace.cell_key("pyx01", wcell.x, wcell.y))
	# §116. THE SHIP HAS TO BE THERE NOW, and this leg's premise moved rather
	# than its rule -- §24's discipline: the delivery gate is stated here, in
	# the commit that added it, instead of the loop being quietly patched until
	# it passed again. Every work still costs exactly its price and still moves
	# no stat; one of them now also wants a hold at the colony, so the leg puts
	# the ship there and loads the manifest before it can buy anything.
	var wplayer: PlayerShip = get_tree().get_first_node_in_group("player")
	if wplayer != null:
		wplayer.global_position = Vector3(2000.0, 0.0, 0.0)
	# §127. SUMMED, NOT OVERWRITTEN. This loop assigned each manifest over the
	# last, which was invisible while exactly one work had goods. THE YARD is
	# the second, and it wants alloys too -- so the repeater's twelve would have
	# been clobbered by the yard's twenty, the repeater would have eaten them,
	# and the yard would have refused a hold eight short. A green leg turning
	# red on a data addition it should not care about.
	GameState.cargo = {}
	for wneed_v in GameState.COLONY_WORKS:
		var wneed: Dictionary = (GameState.COLONY_WORKS[wneed_v]
			as Dictionary).get("goods", {})
		for g3_v in wneed:
			var g3 := String(g3_v)
			GameState.cargo[g3] = int(GameState.cargo.get(g3, 0)) + int(wneed[g3_v])
	var stats_before := GameState.stats.duplicate(true)
	var spent_total := 0
	var works_ok := true
	for w_v in GameState.COLONY_WORKS:
		var wid := String(w_v)
		var before_w := GameState.salvage
		if not buy_colony_work("pyx01:7", wid):
			works_ok = false
		spent_total += before_w - GameState.salvage
		if not GameState.has_work("pyx01:7", wid):
			works_ok = false
	var want_total := works_want
	var stats_same := str(stats_before) == str(GameState.stats)
	var re_buy := buy_colony_work("pyx01:7", "relay")
	# AND THE MANIFEST LEFT THE HOLD. A work that took the credits and not the
	# goods would pass every clause above it while the delivery was a fiction.
	var hold_emptied := GameState.cargo.is_empty()
	print("[colony] WORKS ARE A SINK, NOT A STAT %d works cost %d (want %d), the delivered goods left the hold=%s, stats byte-identical=%s, a re-buy refuses=%s -> %s" % [
		GameState.COLONY_WORKS.size(), spent_total, want_total,
		str(hold_emptied), str(stats_same), str(not re_buy),
		"PASS" if works_ok and spent_total == want_total and stats_same
			and hold_emptied and not re_buy else "FAIL"])

	# §126. THE LADDER STANDS. The prereq is a GATE, so it is asserted in both
	# directions -- a gate that always refused would satisfy half of this and be
	# useless, which is NO ORDER WITHOUT THE READ's own posture.
	#
	# 1. WITHOUT THE MAST IT REFUSES, on a fresh colony with a purse that could
	#    pay twice over and a hold carrying the whole manifest, so the only
	#    thing missing is the rung below.
	#
	#    ITS OWN COLONY AND ONLY ITS OWN KEY: `colony_works = {}` here would
	#    clear the works `THE DOCK IS TIME, NOT POWER` is built on eighty lines
	#    below -- the precise defect that leg's own comment records §116
	#    committing, and the reason it now rebuilds its own precondition.
	GameState.colony_works.erase("pyx01:9")
	GameState.claim_colony("pyx01:9", 2400.0, 0.0)
	var lcell := DeepSpace.cell_of(Vector3(2400.0, 0.0, 0.0))
	GameState.note_survey_worked(DeepSpace.cell_key("pyx01", lcell.x, lcell.y))
	var lplayer: PlayerShip = get_tree().get_first_node_in_group("player")
	if lplayer != null:
		lplayer.global_position = Vector3(2400.0, 0.0, 0.0)
	GameState.cargo = {}
	var lwant: Dictionary = (GameState.COLONY_WORKS["repeater"]
		as Dictionary).get("goods", {})
	for lg_v in lwant:
		GameState.cargo[String(lg_v)] = int(lwant[lg_v])
	GameState.salvage = works_want * 2
	var purse_before := GameState.salvage
	var cargo_before := GameState.cargo.duplicate(true)
	var barred := not buy_colony_work("pyx01:9", "repeater")
	# AND THE REFUSAL IS FREE, §110's rule: nothing spent, nothing unloaded.
	# Compared as a whole hold rather than one line of it, so an empty manifest
	# on some future work cannot index past the end of its own keys array.
	var barred_free := GameState.salvage == purse_before \
		and str(cargo_before) == str(GameState.cargo)
	# CAPTURED HERE, not re-asked in the print. The state below this line moves
	# twice, and a figure printed from a later state while claiming to describe
	# this one is §124's whole subject.
	var barred_says := GameState.work_prereq_missing("pyx01:9", "repeater")
	var prereq_named := barred_says == "relay"
	# 2. WITH THE MAST IT PASSES. Same colony, same hold, same purse.
	var mast := buy_colony_work("pyx01:9", "relay")
	var freed := buy_colony_work("pyx01:9", "repeater")
	# 3. AND THE DECLARATION ORDER SATISFIES EVERY PREREQ. This test and the
	#    chart both walk COLONY_WORKS in declaration order, so a work declared
	#    BEFORE the one it requires would fail as a pricing bug here and show a
	#    pilot a rung above its own prerequisite there. Derived, so it holds for
	#    works nobody has written yet.
	var order_ok := true
	var seen_works: Array = []
	for wo_v in GameState.COLONY_WORKS:
		var wo := String(wo_v)
		var wneed_id := String((GameState.COLONY_WORKS[wo] as Dictionary)
			.get("requires", ""))
		if wneed_id != "" and not seen_works.has(wneed_id):
			order_ok = false
		seen_works.append(wo)
	# 4. AND STAGING NEVER UN-BUILDS. A v28 save written before this commit can
	#    hold a repeater with no mast under it -- legal when it was written,
	#    unreachable now. The gate is on RAISING a work and must never become a
	#    validity rule for one already standing, or shipping a prereq would
	#    silently demolish what a pilot already paid for.
	#
	#    ASSERTED ON THE STATE RATHER THAN THROUGH THE LOADER, deliberately: the
	#    loader's filter (`COLONY_WORKS.has(wid)`) keeps any known key and asks
	#    nothing about order, so a round-trip would only re-test that filter. What
	#    is actually at risk is every READER downstream of it, so this builds the
	#    orphan state the loader would produce and asks whether the work still
	#    stands AND still grants.
	#
	#    ASKED OF THE STORE, not of Main: Main's half would refuse this at the
	#    delivery gate (clause 2 just ate the manifest) and pass the assertion
	#    for a reason that has nothing to do with the ladder. GameState's half
	#    checks `has_work` before anything else, so an "already standing" is the
	#    only refusal it can be.
	#
	#    AND IN AN EMPTY SYSTEM, because the grant half of this is system-scoped.
	#    Run in pyx01 it would read true off the repeater `WORKS ARE A SINK`
	#    raised at pyx01:7 -- the clause passing whether or not the orphan
	#    granted anything, which is the same shape as three clauses passing off
	#    the ladder in the delivery leg below. pyx02 has no colony until this
	#    line makes one, so the only thing that can answer is the orphan.
	GameState.claim_colony("pyx02:4", 900.0, 0.0)
	GameState.colony_works["pyx02:4"] = ["repeater"]
	var legacy_kept := GameState.has_work("pyx02:4", "repeater") \
		and GameState.work_stands_in_system("pyx02", "repeater") \
		and not GameState.buy_colony_work("pyx02:4", "repeater")
	print("[colony] THE LADDER STANDS repeater without a mast: refused=%s (free=%s, names '%s'); with one: mast=%s repeater=%s; declaration order safe=%s; a legacy save keeps an orphan rung=%s -> %s" % [
		str(barred), str(barred_free), barred_says,
		str(mast), str(freed), str(order_ok), str(legacy_kept),
		"PASS" if barred and barred_free and prereq_named and mast and freed
			and order_ok and legacy_kept else "FAIL"])

	# §116. THE TRIP IS THE COST, and this is the leg that says the gate is a
	# JOURNEY and not just a manifest. Three refusals, each isolated: the goods
	# aboard but the ship four hundred units off; the ship alongside with an
	# empty hold; and -- the one the whole feature exists for -- the goods
	# aboard while the chart is open from ANOTHER SYSTEM, which is exactly what
	# a menu with no position gate would have allowed.
	#
	# Every refusal is free, this function's own posture, and the wallet is
	# checked to the credit across all three.
	#
	# ON ITS OWN COLONY, AND THAT IS NOT TIDINESS. The first draft ran this on
	# pyx01:7 and cleared `colony_works` to get a clean slate -- which took the
	# DRY DOCK off the colony that THE DOCK IS TIME, NOT POWER measures eighty
	# lines below, and turned a leg that had been green for a horizon red. The
	# sweep caught it, which is the system working; the lesson is cheaper than
	# the sweep. A harness block that resets SHARED state and does not restore
	# it is a defect with a blast radius measured in whatever somebody writes
	# after it. This one claims its own ground, at a position no other leg
	# reads, and touches nothing else.
	var deliver_at := Vector3(2000.0, 0.0, -1500.0)
	var deliver_key := "pyx01:12"
	GameState.claim_colony(deliver_key, deliver_at.x, deliver_at.z)
	var dcell := DeepSpace.cell_of(deliver_at)
	GameState.note_survey_worked(DeepSpace.cell_key("pyx01", dcell.x, dcell.y))
	var deliver_id := ""
	for wd_v in GameState.COLONY_WORKS:
		if not (GameState.COLONY_WORKS[wd_v] as Dictionary).get("goods", {}).is_empty():
			deliver_id = String(wd_v)
			break
	# §126. EVERY OTHER GATE SATISFIED FIRST, or this leg measures the wrong
	# refusal. The delivery work is the repeater and the repeater now REQUIRES a
	# mast, so on a fresh colony all three clauses below would go green off the
	# LADDER while the delivery gate went untested and `bought` failed -- three
	# assertions passing for a reason that has nothing to do with what they are
	# named after. Derived from `requires` rather than naming the relay, so a
	# re-staged ladder does not quietly reintroduce it.
	#
	# And the purse is sized off the price for §126's other reason: a fixture
	# holding a number typed beside the thing it pays for goes stale the first
	# time that thing is re-priced, and reports it as a mechanism failure.
	var deliver_need := String((GameState.COLONY_WORKS.get(deliver_id, {})
		as Dictionary).get("requires", ""))
	GameState.salvage = works_want * 2
	if deliver_need != "":
		GameState.buy_colony_work(deliver_key, deliver_need)
	var manifest: Dictionary = (GameState.COLONY_WORKS.get(deliver_id, {})
		as Dictionary).get("goods", {})
	GameState.cargo = {}
	for g4_v in manifest:
		GameState.cargo[String(g4_v)] = int(manifest[g4_v])
	var wallet_d := GameState.salvage
	if wplayer != null:
		wplayer.global_position = deliver_at + Vector3(400.0, 0.0, 0.0)
	var far_refused := not buy_colony_work(deliver_key, deliver_id)
	if wplayer != null:
		wplayer.global_position = deliver_at
	GameState.cargo = {}
	var empty_refused := not buy_colony_work(deliver_key, deliver_id)
	for g5_v in manifest:
		GameState.cargo[String(g5_v)] = int(manifest[g5_v])
	var sys_was := GameState.current_system
	GameState.current_system = "pyx02"
	var elsewhere_refused := not buy_colony_work(deliver_key, deliver_id)
	GameState.current_system = sys_was
	var met := bool(work_delivery_met(deliver_key, deliver_id))
	var bought := buy_colony_work(deliver_key, deliver_id)
	print("[colony] THE TRIP IS THE COST %s wants %s: refused 400u off=%s, refused with an empty hold=%s, refused from another system with the goods aboard=%s (all free, wallet %d->%d), and lands standing there=%s -> %s" % [
		deliver_id, work_manifest(deliver_id), str(far_refused),
		str(empty_refused), str(elsewhere_refused), wallet_d,
		wallet_d - int((GameState.COLONY_WORKS[deliver_id] as Dictionary)["price"]),
		str(met and bought),
		"PASS" if far_refused and empty_refused and elsewhere_refused and met
			and bought and GameState.salvage == wallet_d - int(
				(GameState.COLONY_WORKS[deliver_id] as Dictionary)["price"])
			else "FAIL"])

	# §116. AND THE TWO LISTS DO NOT OVERLAP. The relay carries the CHARTED
	# markets (its blurb's own word) and the repeater carries the deep's; the
	# defect this commit fixed was one unfiltered loop printing both under the
	# charted heading since §112. Asserted on the partition rather than on the
	# rendering: every event is in exactly one half, and each half is non-empty
	# under a fixture that has both, so a filter that dropped everything would
	# not pass by printing nothing.
	var events_was: Array = GameState.market_events.duplicate(true)
	GameState.market_events = [
		{"kind": "shortage", "port": "anchor", "good": "alloys",
			"name": "THE ANCHOR", "mult": 2.0, "remaining": 200.0},
		{"kind": "glut", "port": "pyx01:9:9", "good": "cores", "deep": true,
			"name": "A SHOAL RELAY", "mult": 0.6, "remaining": 150.0},
	]
	var chart_half := 0
	var deep_half := 0
	for evp_v in GameState.market_events:
		if bool((evp_v as Dictionary).get("deep", false)):
			deep_half += 1
		else:
			chart_half += 1
	var partitioned: bool = chart_half + deep_half == GameState.market_events.size() \
		and chart_half > 0 and deep_half > 0
	GameState.market_events = events_was
	print("[colony] EACH WORK CARRIES ITS OWN WEATHER %d charted + %d deep = %d, neither half empty -> %s" % [
		chart_half, deep_half, chart_half + deep_half,
		"PASS" if partitioned else "FAIL"])

	# SURVEYED GROUND ONLY, and the refusal is free. A colony whose cell no
	# mast ever worked refuses every work, and refuses them for nothing.
	GameState.claim_colony("pyx01:8", -2600.0, 400.0)
	var before_ground := GameState.salvage
	var ground_refused := not buy_colony_work("pyx01:8", "relay")
	print("[colony] SURVEYED GROUND ONLY an unsounded bottom refuses=%s and the refusal cost %d -> %s" % [
		str(ground_refused), before_ground - GameState.salvage,
		"PASS" if ground_refused and GameState.salvage == before_ground else "FAIL"])

	# THE DOCK IS TIME, NOT POWER. The aura reads true alongside the yard and
	# false a hundred units off -- the rule function, not the regen rendering.
	#
	# AND IT BUILDS WHAT IT MEASURES, rather than inheriting it from eighty
	# lines up. It did inherit it, and §116's delivery leg went in between and
	# cleared the store -- so this leg went red for something that was not
	# wrong with the dock. Both sides of that are fixed: the block above no
	# longer touches shared state, and this one no longer depends on distance.
	# A precondition a leg needs is a precondition that leg should state.
	if not GameState.has_work("pyx01:7", "dock"):
		buy_colony_work("pyx01:7", "dock")
	var near_aura := GameState.dock_aura_at(2000.0, 0.0)
	var far_aura := GameState.dock_aura_at(2000.0, 500.0)
	print("[colony] THE DOCK IS TIME, NOT POWER aura alongside=%s, 500u off=%s -> %s" % [
		str(near_aura), str(far_aura),
		"PASS" if near_aura and not far_aura else "FAIL"])

	# §127. THE YARD DEEPENS THE SAME AURA. Four things, and the third is the
	# one an ordering mistake would break silently: a yard colony ALSO has a
	# dock (the prereq), so a multiplier asked in the wrong order would cap every
	# yard in the game at the dock's two and nothing would ever say so.
	#
	# And the fourth is the reason the constant is six rather than a feeling:
	# past the point where regen takes less than SHIELD_CALM_DELAY, the
	# multiplier buys nothing at all, because what is left to wait for is a
	# combat rule. Reported as a measurement, asserted as the LAW that the yard
	# reaches it -- so a regen retune that made six too slow reddens here.
	if not GameState.has_work("pyx01:7", "yard"):
		GameState.cargo = {}
		var ywant: Dictionary = (GameState.COLONY_WORKS["yard"]
			as Dictionary).get("goods", {})
		for yg_v in ywant:
			GameState.cargo[String(yg_v)] = int(ywant[yg_v])
		if wplayer != null:
			wplayer.global_position = Vector3(2000.0, 0.0, 0.0)
		GameState.salvage = works_want * 2
		buy_colony_work("pyx01:7", "yard")
	var yard_mult := GameState.repair_aura_mult_at(2000.0, 0.0)
	var off_mult := GameState.repair_aura_mult_at(2000.0, 500.0)
	# A dock WITHOUT a yard still reads two: pyx01:9 got a relay and a repeater
	# in the ladder leg and no dock at all, so this builds the one it measures.
	if not GameState.has_work("pyx01:9", "dock"):
		GameState.salvage = works_want * 2
		GameState.buy_colony_work("pyx01:9", "dock")
	var dock_only := GameState.repair_aura_mult_at(2400.0, 0.0)
	var regen := float(GameState.stats.get("shield_regen", 6.0))
	var full_at_yard := 100.0 / maxf(regen * GameState.YARD_AURA_MULT, 0.001)
	print("[colony] THE YARD MENDS FASTER THAN THE WAIT alongside=%.1fx, 500u off=%.1fx, a dock with no yard=%.1fx; 100 shield at %.0f/s takes %.1fs against a %.1fs calm delay -> %s" % [
		yard_mult, off_mult, dock_only, regen, full_at_yard,
		PlayerShip.SHIELD_CALM_DELAY,
		"PASS" if is_equal_approx(yard_mult, GameState.YARD_AURA_MULT)
			and is_equal_approx(off_mult, 1.0)
			and is_equal_approx(dock_only, GameState.DOCK_AURA_MULT)
			and full_at_yard < PlayerShip.SHIELD_CALM_DELAY else "FAIL"])

	# §127. THE VAULT SURVIVES ITS OWN LOADER, and it is two findings in one leg
	# because the second is what made the first worth asserting.
	#
	# 1. THE ANNEX BAY HAS BEEN DELETED ON EVERY LOAD SINCE §112.
	#    `_bay_key_is_real` split a key on ":" and demanded THREE parts (a deep
	#    cell); a colony key has TWO, so the loader dropped it and everything a
	#    pilot stowed in an annex vanished. Found by asking whether it was safe
	#    to double that bay.
	# 2. AND THE KEYED CAP MAKES THE LOADER ORDER-CRITICAL. The over-capacity
	#    trimmer now asks `warehouse_space_of`, which asks `has_work` -- so
	#    `colony_works` loaded AFTER `_load_warehouse` would trim a 120-space
	#    vault against 60 and delete sixty space of goods. It is safe only
	#    because load_game populates colonies and works immediately before, and
	#    this asserts that rather than trusting it.
	GameState.warehouse = {}
	GameState.salvage = works_want * 2
	if not GameState.has_work("pyx01:7", "vaults"):
		GameState.buy_colony_work("pyx01:7", "vaults")
	var vault_cap := GameState.warehouse_space_of("pyx01:7")
	var counter_cap := GameState.warehouse_space_of("anchor")
	# A full vault, in the one good the bonded set and the space maths agree on.
	var vault_units := vault_cap / maxi(CommodityDB.space_of("plate_ablative"), 1)
	var saved_bay := {"pyx01:7": {"plate_ablative": vault_units}}
	GameState._load_warehouse(saved_bay)
	var vault_kept := GameState.warehouse_used("pyx01:7")
	# AND A COUNTER IS STILL SIXTY. The amendment is that a cap varies by a WORK,
	# never by a port def, so an unvaulted key reading anything but 60 is the
	# refusal this replaced coming back.
	print("[colony] THE VAULT SURVIVES ITS OWN LOADER vault %d vs counter %d; %d space stowed reloads as %d; an annex key is a real bay=%s -> %s" % [
		vault_cap, counter_cap, vault_cap, vault_kept,
		str(GameState.warehouse.has("pyx01:7")),
		"PASS" if vault_cap == GameState.WAREHOUSE_SPACE_VAULTED
			and counter_cap == GameState.WAREHOUSE_SPACE
			and vault_kept == vault_cap else "FAIL"])
	# AND IT PUTS THE BAY BACK. `THE ANNEX IS BONDED` stows into this very key
	# twenty lines below, and a bay left full at its cap would refuse it -- the
	# blast-radius rule the delivery leg states, owed by the leg that fills a
	# vault to the brim to prove it can.
	GameState.warehouse = {}

	# THE ANNEX IS THE WAREHOUSE'S OWN LAW. Storables in, the bonded set only,
	# and back out -- through store_cargo/withdraw_cargo, so the bay's cap
	# and can_store == no_retail hold here exactly as at a dock.
	GameState.cargo = {}
	GameState.load_cargo("plate_ablative", 3)
	GameState.load_cargo("alloys", 2)
	var put := GameState.store_cargo("pyx01:7", "plate_ablative", 3)
	var bulk_refused := GameState.store_cargo("pyx01:7", "alloys", 2) == 0
	var got_back := GameState.withdraw_cargo("pyx01:7", "plate_ablative", 3)
	print("[colony] THE ANNEX IS BONDED 3 plates in=%d, bulk goods refused=%s, 3 back out=%d -> %s" % [
		put, str(bulk_refused), got_back,
		"PASS" if put == 3 and bulk_refused and got_back == 3 else "FAIL"])

	# THE ANCHOR IS EARNED, AND OBEYS THE CAP. anchor_rows is empty below
	# FILING t3 by the chart's own gate; at t3 a held cell rows up with its
	# depth, and the jump verb keeps the beacon cap -- a 5000u held cell offers
	# no jump. The fee is the beacon's own curve at the anchor's own depth.
	GameState.skills = {}
	GameState.survey_coverage = {}
	GameState.note_survey_worked("pyx01:40:0")
	GameState.note_survey_held("pyx01:40:0")
	var rows_low := anchor_rows("pyx01")
	GameState.skills = {"filing": 999}
	var rows_high := anchor_rows("pyx01")
	var arow: Dictionary = rows_high[0] if not rows_high.is_empty() else {}
	var adepth := float(arow.get("depth", -1.0))
	var afee := beacon_jump_fee(adepth)
	var capped_ok := not can_beacon_jump(9000.0)
	print("[colony] THE ANCHOR IS EARNED rows below the tier=%d, at t3=%d at %du for %d, and 9000u still refuses a jump=%s -> %s" % [
		rows_low.size(), rows_high.size(), int(adepth), afee, str(capped_ok),
		"PASS" if rows_low.is_empty() and rows_high.size() == 1
			and adepth > 0.0 and afee > 0 and capped_ok else "FAIL"])

	GameState.skills = {}
	GameState.survey_coverage = {}
	GameState.colony_works = {}
	GameState.cargo = {}

	GameState.colonies = {}
	get_tree().quit()


func _run_beacon_test() -> void:
	# v20 HUNT STAGE 5. Waypoint beacons: the stock, the chart refusal, the
	# warp round-trip, position-keyed recovery, and the radar tier.
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_rift_timer = 1.0e9
	_apex_wake_timer = -1.0
	set_deep_generation(false)
	GameState.beacons = {}
	await get_tree().create_timer(0.4).timeout

	# 1. THE STOCK IS THE LEDGER, and it is derived. Eight drops succeed, the
	#    ninth is refused, and the stock read back at every step is BEACON_STOCK
	#    minus the entries — asked of the derivation, never of a counter, so a
	#    second bookkeeping cannot exist to disagree with it.
	var stock_walk_ok := true
	for i in range(GameState.BEACON_STOCK):
		if not GameState.drop_beacon("pyx01", 100.0 + float(i) * 40.0, 200.0, 50.0):
			stock_walk_ok = false
		if GameState.beacon_stock_left() != GameState.BEACON_STOCK - i - 1:
			stock_walk_ok = false
	var ninth := GameState.drop_beacon("pyx01", 900.0, 900.0, 50.0)
	print("[beacon] THE STOCK IS THE LEDGER %d drops accepted with the derivation tracking each=%s, one more refused=%s -> %s" % [
		GameState.BEACON_STOCK, str(stock_walk_ok), str(not ninth),
		"PASS" if stock_walk_ok and not ninth else "FAIL"])

	# 1b. A RETUNE NEVER DELETES A BEACON (v22, §87). The stock went 8 -> 3 with
	#     live saves standing more than 3, so the property that matters is
	#     grandfathering: the loader keeps every legacy entry (it bounds against
	#     BEACON_LEGACY_CAP, never the stock), the derived stock clamps at zero
	#     rather than going negative through a toast, dropping is refused until
	#     recovery brings the field under stock, and then works again. The whole
	#     arc, driven through the real loader and the real verbs.
	var legacy := {"pyx01": []}
	for i in 5:
		(legacy["pyx01"] as Array).append({"x": 100.0 + float(i) * 40.0, "z": 300.0})
	GameState._load_beacons(legacy)
	var kept_all := GameState.beacons_in("pyx01").size() == 5
	var clamped := GameState.beacon_stock_left() == 0
	var refused_over := not GameState.drop_beacon("pyx01", 999.0, 999.0, 50.0)
	for i in 3:
		GameState.recover_beacon("pyx01", 100.0 + float(i) * 40.0, 300.0)
	var after_rec := GameState.beacon_stock_left()
	var drop_again := GameState.drop_beacon("pyx01", 999.0, 999.0, 50.0)
	print("[beacon] A RETUNE NEVER DELETES A BEACON 5 legacy entries kept=%s, stock clamps to 0=%s, drop refused=%s; 3 recovered -> stock %d, drop works=%s -> %s" % [
		str(kept_all), str(clamped), str(refused_over), after_rec, str(drop_again),
		"PASS" if kept_all and clamped and refused_over and after_rec == 1
			and drop_again else "FAIL"])
	GameState.beacons = {}

	# 2. THE CHART REFUSES A BEACON. Depth is an argument, so the rule is a
	#    pure call — at depth 0 and inside the chart it refuses with stock in
	#    hand; the same call at depth accepts. Both directions, or "refuses"
	#    is satisfied by a function that always refuses.
	GameState.beacons = {}
	var in_chart := GameState.drop_beacon("pyx01", 5.0, 5.0, 0.0)
	var at_depth := GameState.drop_beacon("pyx01", 5.0, 5.0, 1.0)
	print("[beacon] THE CHART REFUSES A BEACON depth 0 accepted=%s (must not be), depth 1 accepted=%s -> %s" % [
		str(in_chart), str(at_depth),
		"PASS" if not in_chart and at_depth else "FAIL"])

	# 3. A BEACON SURVIVES THE WARP. Drop through the real verb, warp away and
	#    back, and count NODES — the store is asserted by leg 1; this leg is
	#    about the projection, which is what the player actually sees.
	GameState.beacons = {}
	player.teleport_to(Vector3(0, 0, chart_edge() + 60.0))
	await get_tree().physics_frame
	var dropped := drop_beacon_here()
	var here := get_tree().get_nodes_in_group("beacon").size()
	_load_system("pyx02")
	await get_tree().physics_frame
	var away := get_tree().get_nodes_in_group("beacon").size()
	_load_system("pyx01")
	await get_tree().physics_frame
	var back := get_tree().get_nodes_in_group("beacon").size()
	print("[beacon] A BEACON SURVIVES THE WARP dropped=%s, nodes here %d, in the next system %d (its own store: none), home again %d -> %s" % [
		str(dropped), here, away, back,
		"PASS" if dropped and here == 1 and away == 0 and back == 1 else "FAIL"])

	# 4. RECOVERY IS KEYED BY POSITION — the stale-index defect, ruled out by
	#    construction and asserted anyway. Two beacons; recover the FIRST; the
	#    second must still be recoverable at its own position. An index-keyed
	#    store shifts the survivor into slot 0 and the second recovery misses.
	GameState.beacons = {}
	GameState.drop_beacon("pyx01", 300.0, 300.0, 50.0)
	GameState.drop_beacon("pyx01", 500.0, 500.0, 50.0)
	# THE SECOND ONE FIRST, and then look at WHICH entry survived — the
	# discriminating clause. The first draft recovered in storage order and
	# checked only return values, which an implementation that removes the
	# first entry regardless satisfies perfectly: every call returns true,
	# the stock comes home, and the wrong beacon died every time. Red-verify
	# caught it green and the leg was rewritten around the survivor's
	# coordinates, which no remove-something implementation can fake.
	var rec_b := GameState.recover_beacon("pyx01", 500.0, 500.0)
	var left: Array = GameState.beacons_in("pyx01")
	var survivor_is_a: bool = left.size() == 1 \
		and float((left[0] as Dictionary)["x"]) == 300.0 \
		and float((left[0] as Dictionary)["z"]) == 300.0
	var rec_a := GameState.recover_beacon("pyx01", 300.0, 300.0)
	var all_home := GameState.beacon_stock_left() == GameState.BEACON_STOCK
	print("[beacon] RECOVERY IS KEYED BY POSITION recovered the SECOND drop=%s, the survivor is the first (%s), then it too=%s, stock whole=%s -> %s" % [
		str(rec_b), str(survivor_is_a), str(rec_a), str(all_home),
		"PASS" if rec_b and survivor_is_a and rec_a and all_home else "FAIL"])

	# 5. THE BOARD CARRIES IT, AND SHEDS IT FIRST — both directions, observed.
	#    The first draft asserted only "the beacon reaches the board" and FAILED
	#    on a full board: a populated system holds 12+ markers, the cap bit, and
	#    the beacon was evicted first — which is the DESIGN (TIER_BEACON is the
	#    last tier; the one marker whose position the player already knows is
	#    the cheapest to shed) colliding with a one-sided probe. So both halves
	#    are staged: on the full board the beacon is absent while 12 others
	#    stand; with the hostiles freed the board thins and the beacon appears.
	#    Either half alone is satisfiable by a beacon that never reaches the
	#    collection at all — only the PAIR proves collection and eviction.
	GameState.beacons = {}
	_load_system("pyx01")
	set_deep_generation(false)
	await get_tree().physics_frame
	player.teleport_to(Vector3(0, 0, chart_edge() + 60.0))
	await get_tree().physics_frame
	drop_beacon_here()
	# Fly away, and MOVE THE RIG: the radar is an edge-arrow instrument (a
	# marker exists only for what is off screen), and teleport_to moves the
	# ship, not the camera — start_new_game moves the rig by hand for exactly
	# this reason.
	player.teleport_to(Vector3(0, 0, chart_edge() + 400.0))
	var probe_rig := get_tree().get_first_node_in_group("camera_rig")
	if probe_rig:
		probe_rig.global_position = player.global_position + Vector3(0, 0, 2)
	await get_tree().create_timer(0.6).timeout
	var full_count := hud.radar_markers().size()
	var beacon_on_full := false
	for m_v in hud.radar_markers():
		if int((m_v as Dictionary).get("tier", -99)) == hud._radar.TIER_BEACON:
			beacon_on_full = true
	# Thin the board: the garrison and every drifting contact go, the beacon
	# and the fixed sites stay.
	for h_v in get_tree().get_nodes_in_group("hostiles"):
		if is_instance_valid(h_v):
			(h_v as Node).free()
	await get_tree().create_timer(0.4).timeout
	var beacon_on_thin := false
	var thin_count := hud.radar_markers().size()
	for m_v2 in hud.radar_markers():
		if int((m_v2 as Dictionary).get("tier", -99)) == hud._radar.TIER_BEACON:
			beacon_on_thin = true
	# THE RULE, NOT THE INSTANCE. This read `TIER_BEACON == TIER_NAMES.size() - 2`
	# — "the beacon is the last tier" — which was true when written and went red
	# the moment v20 appended TIER_STORM below it. The property it actually
	# protects is that a beacon sheds before every CONTACT, i.e. before every
	# marker whose position the player does not already know, and that is still
	# true.
	#
	# Exactly ONE thing now sheds before it, and the inversion is principled: a
	# storm carries four other telegraphs (a 400u silhouette readable at ~1500u,
	# a broadcast at 520u, the deep-tag suffix and the prompt), so its arrow is
	# the most redundant marker on a full board — while a beacon's arrow is its
	# ONLY channel. Asserted as a set with its contents named, so a third tier
	# appended below the beacon turns this red and makes somebody argue for it.
	var below_beacon: Array = []
	for t in range(hud._radar.TIER_BEACON + 1, hud._radar.TIER_NAMES.size() - 1):
		below_beacon.append(String(hud._radar.TIER_NAMES[t + 1]))
	# ODDITY JOINED, AND THE ARGUMENT IS THE POINT. This clause exists to make
	# somebody justify every tier appended below the beacon rather than let one
	# arrive quietly. §76's signature sites qualify on the same grounds STORM
	# does and then some: a site does not move, does not shoot, and will be in
	# exactly the same place next pass, so it is the cheapest thing on a full
	# board to shed. The beacon still outranks both, which is the property.
	var tier_last: bool = below_beacon == ["STORM", "ODDITY"]
	print("[beacon] THE BOARD CARRIES IT, AND SHEDS IT FIRST full board %d markers with the beacon shed=%s; thinned to %d the beacon stands=%s; the only tier shed before it is %s -> %s" % [
		full_count, str(not beacon_on_full), thin_count, str(beacon_on_thin),
		str(below_beacon),
		"PASS" if full_count >= 12 and not beacon_on_full and beacon_on_thin
			and tier_last else "FAIL"])

	# --- v21: the two verbs -------------------------------------------------

	var sid_b := GameState.current_system
	var bounds_b := SystemDB.bounds_of(sid_b)

	# ROWS ARE A COPY, AND SORTED. beacons_in hands out the live save array;
	# a UI that sorted it in place would be reordering the file. Asserted by
	# sorting the returned rows the other way and checking the store did not
	# move -- and by planting them OUT of order so the sort has work to do.
	GameState.beacons[sid_b] = [
		{"x": bounds_b + 900.0, "z": 0.0},
		{"x": bounds_b + 100.0, "z": 0.0},
		{"x": bounds_b + 400.0, "z": 0.0},
	]
	var before_order := []
	for e_v in GameState.beacons[sid_b]:
		before_order.append(float((e_v as Dictionary)["x"]))
	var rows := GameState.beacon_rows(sid_b)
	rows.reverse()
	var after_order := []
	for e_v in GameState.beacons[sid_b]:
		after_order.append(float((e_v as Dictionary)["x"]))
	var rows2 := GameState.beacon_rows(sid_b)
	var sorted_ok: bool = rows2.size() == 3 \
		and float((rows2[0] as Dictionary)["depth"]) < float((rows2[1] as Dictionary)["depth"]) \
		and float((rows2[1] as Dictionary)["depth"]) < float((rows2[2] as Dictionary)["depth"])
	var labels_ok: bool = String((rows2[0] as Dictionary)["label"]) == "BEACON 1" \
		and String((rows2[2] as Dictionary)["label"]) == "BEACON 3"
	print("[beacon] THE ROWS ARE A COPY, NEAREST FIRST store %s unmoved by a reversed read=%s, depths ascending=%s, labels %s -> %s" % [
		str(before_order), str(before_order == after_order), str(sorted_ok),
		"synthesized" if labels_ok else "wrong",
		"PASS" if before_order == after_order and sorted_ok and labels_ok else "FAIL"])

	# THE JUMP STOPS WHERE THE INSTRUMENTS DO. Both directions, because a cap
	# asserted only from the refused side passes on a verb that refuses
	# everything. The shallow beacon must be offered and the deep one refused,
	# with every OTHER guard held open so the depth is the only variable.
	GameState.salvage = 99999
	GameState.last_outbound_jump = -1.0e9
	var shallow_d := SystemDB.HYPER_DEPTH_MAX - 100.0
	var deep_d := SystemDB.HYPER_DEPTH_MAX + 100.0
	var shallow_ok := can_beacon_jump(shallow_d)
	var deep_ok := can_beacon_jump(deep_d)
	print("[beacon] THE JUMP STOPS WHERE THE INSTRUMENTS DO %.0fu offered=%s, %.0fu offered=%s (cap %.0f) -> %s" % [
		shallow_d, str(shallow_ok), deep_d, str(deep_ok),
		float(BEACON_JUMP_MAX_DEPTH),
		"PASS" if shallow_ok and not deep_ok else "FAIL"])

	# AND THE CAP IS THE ONE THE DERIVATION USES. A FOOTHOLD, NOT A FARM
	# measures the deepest reachable point as bounds_of("pyx03") +
	# HYPER_DEPTH_MAX; a beacon jump that reached further would move that
	# maximum while the assertion went on passing against the old one. Tied
	# here rather than hoped for.
	print("[beacon] AND NO FURTHER THAN THE FOOTHOLD ASSUMES cap %.0f vs HYPER_DEPTH_MAX %.0f -> %s" % [
		float(BEACON_JUMP_MAX_DEPTH), SystemDB.HYPER_DEPTH_MAX,
		"PASS" if is_equal_approx(float(BEACON_JUMP_MAX_DEPTH),
			SystemDB.HYPER_DEPTH_MAX) else "FAIL"])

	# ONE CLOCK FOR ALL OUTBOUND. Founding colonies must not multiply how often
	# you can leave, and neither may dropping beacons. Spending the colony
	# clock has to close the beacon door and vice versa.
	GameState.last_outbound_jump = GameState.played_seconds
	var beacon_after_colony := can_beacon_jump(200.0)
	GameState.last_outbound_jump = -1.0e9
	var beacon_when_cold := can_beacon_jump(200.0)
	print("[beacon] ONE CLOCK FOR ALL OUTBOUND beacon jump with the shared stamp hot=%s, cold=%s -> %s" % [
		str(beacon_after_colony), str(beacon_when_cold),
		"PASS" if not beacon_after_colony and beacon_when_cold else "FAIL"])

	# THE FEE CLIMBS AND IS CAPPED. A flat fee would make the deepest jump the
	# best value in the game; an uncapped one would eventually beat the colony
	# verb, which is the earned one.
	var fee_near := beacon_jump_fee(0.0)
	var fee_far := beacon_jump_fee(BEACON_JUMP_MAX_DEPTH)
	var fee_over := beacon_jump_fee(BEACON_JUMP_MAX_DEPTH * 4.0)
	print("[beacon] THE FEE CLIMBS AND IS CAPPED %d at the edge, %d at the cap, %d past it (colony fee %d) -> %s" % [
		fee_near, fee_far, fee_over, COLONY_JUMP_FEE,
		"PASS" if fee_near < fee_far and fee_far == COLONY_JUMP_FEE
			and fee_over == fee_far else "FAIL"])

	# SAME SYSTEM ONLY, STRUCTURALLY. Not a flag to forget: the store is keyed
	# by system id, so another Pyx's beacons cannot appear in these rows at all.
	GameState.beacons["pyx03"] = [{"x": 4000.0, "z": 0.0}]
	var mine := GameState.beacon_rows(sid_b)
	var theirs := GameState.beacon_rows("pyx03")
	print("[beacon] SAME SYSTEM ONLY, STRUCTURALLY %d rows here, %d there, no leak=%s -> %s" % [
		mine.size(), theirs.size(), str(mine.size() == 3 and theirs.size() == 1),
		"PASS" if mine.size() == 3 and theirs.size() == 1 else "FAIL"])

	# A COURSE IS NOT A MOVE. command_move is shared by twelve callers and none
	# of them plotted anything, so an ordinary tap must not light the CRS row --
	# and must CLEAR a course that was running, which is the stick-breaks-it
	# rule arriving through the same door.
	var pilot_c: PlayerShip = get_tree().get_first_node_in_group("player")
	var course_flags := {}
	if pilot_c != null:
		pilot_c.command_course(Vector3(bounds_b + 400.0, 0.0, 0.0))
		course_flags["after_course"] = pilot_c.course_active()
		pilot_c.command_move(Vector3(bounds_b + 50.0, 0.0, 0.0))
		course_flags["after_move"] = pilot_c.course_active()
		pilot_c.command_course(Vector3(bounds_b + 400.0, 0.0, 0.0))
		pilot_c.has_move_target = false
		course_flags["after_arrival"] = pilot_c.course_active()
	print("[beacon] A COURSE IS NOT A MOVE set=%s, a plain move clears it=%s, losing the move ends it=%s -> %s" % [
		str(course_flags.get("after_course", false)),
		str(not bool(course_flags.get("after_move", true))),
		str(not bool(course_flags.get("after_arrival", true))),
		"PASS" if bool(course_flags.get("after_course", false))
			and not bool(course_flags.get("after_move", true))
			and not bool(course_flags.get("after_arrival", true)) else "FAIL"])

	GameState.beacons = {}
	get_tree().quit()


func _run_mine_test() -> void:
	var player: PlayerShip = get_tree().get_first_node_in_group("player")
	player.invulnerable = true
	_wave_timer = 1.0e9
	_apex_wake_timer = -1.0
	await get_tree().create_timer(0.3).timeout

	# --- 1. the collision guard ----------------------------------------------
	# is_salvage() is literally has("band") and salvage_for_band() returns the
	# FIRST dict-order match, so an ore carrying `band` would shadow a salvage
	# grade -- and spawn_loot's 22% regrade would start minting it out of
	# ordinary combat crates, feeding ARCHEOLOGY off rock.
	var ore := CommodityDB.ore_ids()
	var shadowing := ""
	for id_v in ore:
		var g := CommodityDB.get_good(String(id_v))
		if g.has("band") or g.has("chart_band") or g.has("parent"):
			shadowing = String(id_v)
	var grades_intact := true
	# DERIVED. This was range(0, 5) and the message said "all 5 grades", so the
	# frontier's two grades were never resolved by it — a dropped or duplicated
	# `band` key on either would have left salvage_for_band(6) returning "" with
	# this clause still printing PASS.
	for band in range(0, DeepSpace.BAND_NAMES.size()):
		if not CommodityDB.is_salvage(CommodityDB.salvage_for_band(band)):
			grades_intact = false
	# THE COUNT STAYS A LITERAL, and deriving it was proposed and refused: `ore`
	# IS CommodityDB.ore_ids(), so `ore.size() == ore_ids().size()` is x == x and
	# could never fail. This literal is the clause's only independently authored
	# expectation and its only guard against a good DRIFTING INTO the ore set —
	# the shadowing loop above only looks for band/chart_band/parent, so a bulk
	# good typo'd with `"ore": "metal"` is invisible to everything else here.
	print("[mine] NOT SALVAGE, NOT CHART %d ore goods, none carries band/chart_band/parent (%s), all %d grades still resolve=%s -> %s" % [
		ore.size(), shadowing if shadowing != "" else "none",
		DeepSpace.BAND_NAMES.size(), str(grades_intact),
		"PASS" if ore.size() == 10 and shadowing == "" and grades_intact else "FAIL"])

	# --- 2. ore is not loot ---------------------------------------------------
	var minted := ""
	for i in range(300):
		var cube := spawn_loot(system_root, Vector3(0, 0, 6), "alloys")
		if CommodityDB.is_ore(String(cube.commodity)):
			minted = String(cube.commodity)
		cube.queue_free()
	print("[mine] ORE IS NOT LOOT 300 crates through spawn_loot minted ore: %s -> %s" % [
		minted if minted != "" else "none", "PASS" if minted == "" else "FAIL"])

	# --- 3. one step, and every ore is sellable somewhere ---------------------
	var bad := ""
	# DERIVED, not range(0, 5). Both of this suite's gradient sweeps were written
	# when there were five bands and stopped dead at index 4, so the frontier's
	# two seam rows were never validated by either of them — the ore ceiling
	# stated in commodity_db's own header was broken by 70 credits and nothing
	# said a word.
	for band in range(0, DeepSpace.BAND_NAMES.size()):
		for gid_v in CommodityDB.seam_yields(band):
			var gid := String(gid_v)
			if not CommodityDB.is_ore(gid) or CommodityDB.no_retail(gid) \
					or CommodityDB.base_price(gid) <= 0:
				bad = gid
	print("[mine] SEAM YIELDS ORE, ONE STEP every seam output is ore, retail and priced (offender: %s) -> %s" % [
		bad if bad != "" else "none", "PASS" if bad == "" else "FAIL"])

	# --- 4. richer outward ----------------------------------------------------
	# The gradient IS the anti-farm mechanism, so it is asserted rather than
	# trusted: the expanse resets on a warp, and what makes that safe is that the
	# band you can reach in one warp is the band that pays worst.
	# STARTS AT BAND 0 since stage 4. Band 0 is charted space -- the only band that
	# never resets -- so it must be the poorest of all, or the eleven permanent
	# seams become the best rate in the game rather than a windfall.
	var means: Array = []
	for band in range(0, DeepSpace.BAND_NAMES.size()):
		var total := 0.0
		var table: Array = CommodityDB.seam_yields(band)
		for gid_v in table:
			total += float(CommodityDB.base_price(String(gid_v)))
		means.append(snappedf(total / maxf(float(table.size()), 1.0) * float(DeepSpace.SEAM_UNITS[band]), 1.0))
	var rising := true
	for i in range(means.size() - 1):
		if float(means[i + 1]) <= float(means[i]):
			rising = false
	print("[mine] RICHER OUTWARD mean seam value by band %s, strictly increasing=%s -> %s" % [
		str(means), str(rising), "PASS" if rising else "FAIL"])

	# --- 5. every band offers both categories --------------------------------
	var lopsided := ""
	# The fourth range(0, 5) in this file, and the last: the frontier's seam rows
	# carry a comment claiming "at least one metal and one mineral, the contract
	# every row above holds to" and nothing checked it. They do — but a comment is
	# a claim, and an unchecked claim is how the ore ceiling got broken by 70
	# credits two rows above this one.
	for band in range(0, DeepSpace.BAND_NAMES.size()):
		var kinds := {}
		for gid_v in CommodityDB.seam_yields(band):
			kinds[CommodityDB.ore_class(String(gid_v))] = true
		if not (kinds.has("metal") and kinds.has("mineral")):
			lopsided = "band %d" % band
	print("[mine] BOTH CATEGORIES EVERYWHERE no band is metal-only or mineral-only (%s) -> %s" % [
		lopsided if lopsided != "" else "none", "PASS" if lopsided == "" else "FAIL"])

	# --- 6. the roll is append-only ------------------------------------------
	# plan_cell's rolls are one linear sequence: a draw inserted anywhere but the
	# last line shifts every draw after it and reshuffles the whole expanse.
	var fp := _world_fingerprint()
	print("[mine] WORLD FINGERPRINT %s vs %s recorded before seams existed -> %s" % [
		fp, WORLD_FINGERPRINT_BEFORE_SEAMS,
		"PASS" if fp == WORLD_FINGERPRINT_BEFORE_SEAMS else "FAIL"])

	# --- 6b. v19 stage 4: identity is additive, and the draws did not move ---

	# IDENTITY IS ADDITIVE. The fingerprint above is the ENFORCEMENT; this line
	# is the meaning. It used to read "pyx01 authors no deep block", which was
	# true, enforceable, and the wrong rule: it made the starter system — where
	# the tutorial runs and where the manual's first hour sends you — the one
	# place in the game that could never have a character of its own, in a
	# horizon whose entire premise is that every Pyx should.
	#
	# The real invariant was always narrower. What must not happen is a key that
	# changes the SHARED RNG STREAM in the system the fingerprint hashes;
	# display names, the wash and a signature drawn on its own salted stream are
	# none of those, and none of them is hashed. So the clause now names the
	# forbidden keys instead of forbidding the dictionary, and it reads the list
	# from SystemDB rather than restating it — a second copy here could drift
	# from the one plan_cell actually honours.
	#
	# Red-verify: author a station_weights row on pyx01. This goes red naming
	# the key, and the fingerprint above goes red at BOTH call sites.
	var pyx01_deep := SystemDB.deep_of("pyx01")
	var forbidden := ""
	for k_v in SystemDB.SHARED_STREAM_KEYS:
		if pyx01_deep.has(String(k_v)):
			forbidden = String(k_v)
	print("[mine] IDENTITY IS ADDITIVE pyx01 authors %d deep key(s), none of them shared-stream (%s) -> %s" % [
		pyx01_deep.size(), "clean" if forbidden == "" else "FOUND " + forbidden,
		"PASS" if forbidden == "" else "FAIL"])

	# AND IT AUTHORS SOMETHING. The clause above is a refusal, and a refusal is
	# satisfied perfectly by an empty block — which is exactly the state this
	# section spent two horizons in. If pyx01 stops carrying identity, that is a
	# regression of the thing the horizon was for, not a tidy-up.
	print("[mine] THE STARTER SYSTEM HAS A CHARACTER band_names=%s wash=%s signature=%s -> %s" % [
		str(pyx01_deep.has("band_names")), str(pyx01_deep.has("wash")),
		str(pyx01_deep.has("signature")),
		"PASS" if pyx01_deep.has("band_names") and pyx01_deep.has("wash")
			and pyx01_deep.has("signature") else "FAIL"])

	# THE DRAW COUNT DID NOT MOVE — the sharp one. Two probes plan the same 200
	# pyx02 cells: one with the authored def, one with `deep` stripped. Every
	# shared-stream product (station POSITIONS, rocks, hulk, pack) must be
	# byte-identical — the weighted pick spends the same single randi() the
	# modulo did — while the archetype STRINGS must differ somewhere, or the
	# feature is dead code shipping green. Red-verify: swap the pick's draw to
	# randf(); positions shear apart on the first station cell.
	var real_probe := DeepSpace.new()
	real_probe.generating = false
	add_child(real_probe)
	real_probe.configure(SystemDB.get_system("pyx02"), "pyx02")
	var stripped_def: Dictionary = SystemDB.get_system("pyx02").duplicate(true)
	stripped_def.erase("deep")
	var bare_probe := DeepSpace.new()
	bare_probe.generating = false
	add_child(bare_probe)
	bare_probe.configure(stripped_def, "pyx02")
	var stream_same := true
	var arch_diffs := 0
	# Landmark KINDS are expected to differ -- that is the weights working -- so
	# they are counted like archetypes rather than compared like placements.
	var mark_diffs := 0
	var storage_diffs := 0
	var stream_bad := ""
	for cz_p in range(4, 14):
		for cx_p in range(4, 14):
			var a := real_probe.plan_cell(cx_p, cz_p)
			var b := bare_probe.plan_cell(cx_p, cz_p)
			var sa: Dictionary = a["station"]
			var sb: Dictionary = b["station"]
			if sa.is_empty() != sb.is_empty():
				stream_same = false
				stream_bad = "station presence @(%d,%d)" % [cx_p, cz_p]
			elif not sa.is_empty():
				if (sa["pos"] as Vector3) != (sb["pos"] as Vector3):
					stream_same = false
					if stream_bad == "":
						stream_bad = "station pos @(%d,%d)" % [cx_p, cz_p]
				if String(sa["archetype"]) != String(sb["archetype"]):
					arch_diffs += 1
				# STORAGE MOVED SIDES, and it had to. It was compared as a
				# PLACEMENT, which was right while nothing could scale it -- but
				# deep_storage is one of the three draw-safe density gates now and
				# pyx02 authors it at 1.3-1.4x. Same draw, moved bar: any station
				# whose randf lands between the two thresholds legitimately flips.
				# It is a SELECTION, like the archetype above it, so it is counted
				# rather than forbidden. The POSITION stays strict, because a
				# moved draw is what would shear that.
				if bool(sa["storage"]) != bool(sb["storage"]):
					storage_diffs += 1
			if str(a["rocks"]) != str(b["rocks"]) \
					or str(a["hulk"]) != str(b["hulk"]) \
					or str(a["pack"]) != str(b["pack"]):
				stream_same = false
				if stream_bad == "":
					stream_bad = "rocks/hulk/pack @(%d,%d)" % [cx_p, cz_p]
			# v21. THE SALTED APPENDS, POLICED TOO -- but policed for the right
			# property, which took a red run to get right. `seams` reads nothing
			# a def can change, so it must be byte-identical.
			if str(a["seams"]) != str(b["seams"]):
				stream_same = false
				if stream_bad == "":
					stream_bad = "seams @(%d,%d)" % [cx_p, cz_p]
			# The LANDMARK is the station case again, and the first draft of this
			# clause got it backwards: landmark_at reads landmark_weights to pick
			# its KIND, so a kind that differs between authored and stripped is
			# §65's feature working, not a stream that moved. What must hold is
			# that the PLACEMENT is untouched -- position and rotation come off
			# the salted rng and a weight may not shift them by a millimetre.
			var ma: Dictionary = a["landmark"]
			var mb: Dictionary = b["landmark"]
			if ma.is_empty() != mb.is_empty():
				stream_same = false
				stream_bad = "landmark presence @(%d,%d)" % [cx_p, cz_p]
			elif not ma.is_empty():
				if (ma["pos"] as Vector3) != (mb["pos"] as Vector3) \
						or not is_equal_approx(float(ma["rot_y"]), float(mb["rot_y"])):
					stream_same = false
					stream_bad = "landmark placement @(%d,%d)" % [cx_p, cz_p]
				if String(ma["kind"]) != String(mb["kind"]):
					mark_diffs += 1
	real_probe.free()
	bare_probe.free()
	print("[mine] THE DRAW COUNT DID NOT MOVE 100 pyx02 cells weighted vs stripped: shared stream + placements identical=%s%s, archetypes differ on %d, landmark kinds on %d, bonded bays on %d (0 archetypes = dead code) -> %s" % [
		str(stream_same), "" if stream_bad == "" else " (" + stream_bad + ")",
		arch_diffs, mark_diffs, storage_diffs,
		"PASS" if stream_same and arch_diffs > 0 else "FAIL"])

	# --- 6c. v21: the density gates, and that they are alive ------------------

	# DENSITY IS ALIVE. Only three chance gates can carry a per-Pyx multiplier
	# without changing the draw COUNT, and the assertion above proves the stream
	# did not move — which a multiplier of zero effect also satisfies. This is
	# the other direction: pyx02 authors convoy at 1.5-1.7x across bands 2-6 and
	# pyx03 authors it at 0.5-0.8x, so over enough cells the two must actually
	# differ, and differ in the authored direction. Counted rather than sampled,
	# because a convoy is rare by design and one cell proves nothing.
	var probe_hi := DeepSpace.new()
	probe_hi.generating = false
	add_child(probe_hi)
	probe_hi.configure(SystemDB.get_system("pyx02"), "pyx02")
	var bare02: Dictionary = SystemDB.get_system("pyx02").duplicate(true)
	bare02.erase("deep")
	var probe_bare := DeepSpace.new()
	probe_bare.generating = false
	add_child(probe_bare)
	probe_bare.configure(bare02, "pyx02")
	# THE WINDOW IS WHERE THE CONVOYS ARE, which the first draft of this got
	# wrong and the harness caught: cells 20-44 sit at depth 1800-4000, and
	# CONVOY_MAX_DEPTH is 1000, so both probes returned zero and the comparison
	# was vacuous. A multiplier cannot be shown alive in a band where the thing
	# it scales cannot occur. 197 of these 324 cells sit inside
	# [CONVOY_MIN_DEPTH, CONVOY_MAX_DEPTH], which is bands 2-3, which is where
	# pyx02 authors 1.6x and 1.7x. Widening the sweep adds none of them: that
	# window is bounded by RADIUS, so 0-18 already contains all of it.
	var convoys_hi := 0
	var convoys_bare := 0
	for cz_d in range(0, 18):
		for cx_d in range(0, 18):
			if not (probe_hi.plan_cell(cx_d, cz_d)["convoy"] as Dictionary).is_empty():
				convoys_hi += 1
			if not (probe_bare.plan_cell(cx_d, cz_d)["convoy"] as Dictionary).is_empty():
				convoys_bare += 1
	probe_hi.free()
	probe_bare.free()
	print("[mine] DENSITY IS ALIVE 324 pyx02 cells in the convoy depth window: %d convoys authored vs %d stripped (authored is 1.6-1.7x, so it must be strictly more) -> %s" % [
		convoys_hi, convoys_bare,
		"PASS" if convoys_hi > convoys_bare else "FAIL"])

	# AND IT IS NESTED, NOT RESHUFFLED. Scaling a threshold up can only ADD
	# cells: the roll is the same number, the bar moved. So every cell the
	# stripped probe put a convoy in must still hold one in the authored probe.
	# A multiplier that moved a convoy from one cell to another would be a
	# reshuffle, which is what a changed draw count looks like from the outside.
	var nested := true
	var nest_bad := ""
	var probe_hi2 := DeepSpace.new()
	probe_hi2.generating = false
	add_child(probe_hi2)
	probe_hi2.configure(SystemDB.get_system("pyx02"), "pyx02")
	var probe_bare2 := DeepSpace.new()
	probe_bare2.generating = false
	add_child(probe_bare2)
	probe_bare2.configure(bare02, "pyx02")
	for cz_n in range(0, 18):
		for cx_n in range(0, 18):
			var bare_c: Dictionary = probe_bare2.plan_cell(cx_n, cz_n)["convoy"]
			if bare_c.is_empty():
				continue
			var hi_c: Dictionary = probe_hi2.plan_cell(cx_n, cz_n)["convoy"]
			if hi_c.is_empty() or (hi_c["pos"] as Vector3) != (bare_c["pos"] as Vector3):
				nested = false
				nest_bad = "@(%d,%d)" % [cx_n, cz_n]
	probe_hi2.free()
	probe_bare2.free()
	print("[mine] SCALING A THRESHOLD ONLY MOVES THE BAR every stripped convoy survives the authored multiplier, in place=%s%s -> %s" % [
		str(nested), "" if nest_bad == "" else " (" + nest_bad + ")",
		"PASS" if nested else "FAIL"])

	# IDENTITY IS REAL. The authored weights must be visible in the world, not
	# merely consumed: bin band-3 pyx02 archetypes over a wide sweep and compare
	# each share against the AUTHORED row — never a hardcoded percentage, so
	# re-tuning the row cannot silently retire this. Red-verify: flatten the
	# row to uniform; the COLD FORGE share falls to ~25% against an authored
	# expectation of ~47% and the deviation clause fires.
	var id_probe := DeepSpace.new()
	id_probe.generating = false
	add_child(id_probe)
	id_probe.configure(SystemDB.get_system("pyx02"), "pyx02")
	var band3_row: Array = SystemDB.station_weights("pyx02", 3)
	var band3_kinds: Array = DeepPortDB.for_band(3)
	var counts := {}
	var stations_seen := 0
	for cz_q in range(-24, 25):
		for cx_q in range(-24, 25):
			var plq := id_probe.plan_cell(cx_q, cz_q)
			if int(plq["band"]) != 3:
				continue
			var st: Dictionary = plq["station"]
			if st.is_empty():
				continue
			stations_seen += 1
			var aid := String(st["archetype"])
			counts[aid] = int(counts.get(aid, 0)) + 1
	id_probe.free()
	var row_total := 0.0
	for w_v in band3_row:
		row_total += float(w_v)
	var worst_dev := 0.0
	var share_report := ""
	for i_k in range(band3_kinds.size()):
		var kid := String((band3_kinds[i_k] as Dictionary)["id"])
		var want_share := float(band3_row[i_k]) / row_total if row_total > 0.0 else 0.0
		var got_share := float(int(counts.get(kid, 0))) / float(maxi(stations_seen, 1))
		worst_dev = maxf(worst_dev, absf(got_share - want_share))
		share_report += "%s %.0f/%.0f%% " % [kid, got_share * 100.0, want_share * 100.0]
	# The bound is 10pp against a MEASURED deterministic deviation of 7.8 on
	# today's row — plan_cell is cell-seeded, so this number cannot flake, but a
	# retuned row re-rolls it and a bound the current value passes by 0.2 would
	# turn a legitimate tune into a mystery red. 66 samples at p=0.47 have a
	# binomial sigma of ~6pp; 10 is one comfortable sigma above the measurement.
	print("[mine] IDENTITY IS REAL %d band-3 pyx02 stations: %svs authored, worst deviation %.1fpp vs 10.0 -> %s" % [
		stations_seen, share_report, worst_dev * 100.0,
		"PASS" if stations_seen >= 30 and worst_dev < 0.10 else "FAIL"])

	# --- 7. and seams themselves are deterministic ---------------------------
	var drift := true
	var seen := 0
	for cx in range(4, 14):
		for cz in range(4, 14):
			var a := var_to_str(deep_space.plan_cell(cx, cz)["seams"])
			var b := var_to_str(deep_space.plan_cell(cx, cz)["seams"])
			if a != b:
				drift = false
			seen += (deep_space.plan_cell(cx, cz)["seams"] as Array).size()
	print("[mine] DETERMINISM 100 cells rolled twice, %d seams, identical=%s -> %s" % [
		seen, str(drift), "PASS" if drift and seen > 0 else "FAIL"])

	# --- 8. a seam is reachable ----------------------------------------------
	# The bug this prevents has shipped in this codebase once already
	# (system_builder.gd:288): a hold measured from a big rock's CENTRE puts the
	# stand-off inside its own collision sphere and the thing can never be
	# worked. Seams stand off the sphere, so one range constant is correct at
	# every rock size.
	var unreachable := 0
	var checked := 0
	for cx in range(4, 24):
		for cz in range(4, 24):
			var plan := deep_space.plan_cell(cx, cz)
			var rocks: Array = plan["rocks"]
			for sd_v in (plan["seams"] as Array):
				var sd: Dictionary = sd_v
				var r: Dictionary = rocks[int(sd["rock"])]
				var sc: Vector3 = r["scale"]
				var rock_radius := minf(sc.x, sc.z) * 0.82
				var flat := Vector3(r["pos"].x, 0.0, r["pos"].z)
				checked += 1
				# The ship is pushed to the sphere's surface; the seam must be
				# inside MINE_RANGE of that, not of the rock's middle.
				if (sd["pos"] as Vector3).distance_to(flat) - rock_radius > MineableSeam.MINE_RANGE:
					unreachable += 1
	print("[mine] SEAM IS REACHABLE %d seams checked, %d outside MINE_RANGE %.1f of the rock's surface -> %s" % [
		checked, unreachable, MineableSeam.MINE_RANGE,
		"PASS" if checked > 0 and unreachable == 0 else "FAIL"])

	# --- 9. warp farming pays badly ------------------------------------------
	# _mined is session state, so a warp re-rolls the expanse. The defence is
	# arithmetic, not a save: band 1 is deliberately the poorest band.
	var b1_seams := 0.0
	var b1_value := 0.0
	var cells := 0
	# AND THE FARM CASE IS THE FITTED ONE. Stage 2's Assay Rig adds a flat unit to
	# every cut, so pricing this at the starter fit would measure an exploit
	# nobody running it would be flying -- "an assertion is only worth what it can
	# see" applied to the one number that makes session-state expanse safe. Read
	# off ModuleDB rather than restated, so a richer yield module moves it.
	var best_yield := 0
	for mid_v in ModuleDB.MODULES:
		var mstats: Dictionary = (ModuleDB.MODULES[mid_v] as Dictionary).get("stats", {})
		best_yield = maxi(best_yield, int(float(mstats.get("ore_yield", 0.0))))
	# Band 1 is a thin SHELL, not a region: depth 0..160 past a chart edge of 40
	# is a radius of 40..200, which at CELL 64 is roughly |c| <= 3. Scanning
	# outward from the origin finds none of it, which is how the first version of
	# this assertion measured zero cells and reported a farm rate of nothing.
	for cx in range(-6, 7):
		for cz in range(-6, 7):
			var plan := deep_space.plan_cell(cx, cz)
			if DeepSpace.band_of(deep_space.depth_at(DeepSpace.cell_centre(cx, cz))) != 1:
				continue
			cells += 1
			for sd_v in (plan["seams"] as Array):
				var sd: Dictionary = sd_v
				b1_seams += 1.0
				b1_value += float(CommodityDB.base_price(String(sd["good"]))) \
					* float(int(sd["units"]) + best_yield)
	var per_cell := b1_value / maxf(float(cells), 1.0)
	# One 64u cell at the hull's base speed of 5.75 is 11.1s, so credits/min is
	# per_cell * (60 / 11.1).
	var per_min := per_cell * (60.0 / 11.1)
	print("[mine] WARP FARM band 1 at the best ore_yield (+%d a cut): %d cells, %.2f seams, %.0f credits/cell = %.0f/min vs a ~2000/min combat baseline -> %s" % [
		best_yield, cells, b1_seams, per_cell, per_min,
		"PASS" if cells > 0 and per_min < 600.0 else "FAIL"])

	# --- 10. the pick order ---------------------------------------------------
	# _pick is screen-space with no raycast and plan_cell has no keep-out between
	# rocks and hulks, so the two can land within a tap of each other. A hulk is
	# one-time; a rock is one of many.
	var rig := get_tree().get_first_node_in_group("camera_rig") as CameraRig
	var hulk_probe := Derelict.new()
	system_root.add_child(hulk_probe)
	hulk_probe.global_position = Vector3(300.0, 0.0, 300.0)
	var seam_probe := MineableSeam.new()
	seam_probe.good = "ore_ferrite"
	system_root.add_child(seam_probe)
	await get_tree().process_frame
	# Placed so the two ANCHORS are 0.6 units apart, not the two nodes: the seam
	# lifts its anchor 1.1 up out of the rock silhouette, so offsetting the nodes
	# would put the anchors further apart than intended. 0.6 world units is about
	# 37 screen pixels at the default zoom, comfortably inside PICK_PX 60 -- which
	# is the point. At 2.0 the seam was ~123px away and simply out of reach, so
	# the "contested" tap was never contested and the assertion could not fail.
	# Derived from BEACON_LOCAL rather than read off pick_anchor(). breach_point
	# is refreshed in Derelict._process, and `await process_frame` does not
	# guarantee that a given node's _process has run before the coroutine
	# resumes -- so reading it here returned the value captured at _ready, when
	# the hulk was still at the origin, and put the seam 400 units away. The
	# assertion then reported a contest that never happened.
	var breach := hulk_probe.global_position \
		+ hulk_probe.global_transform.basis * Derelict.BEACON_LOCAL
	seam_probe.global_position = breach + Vector3(0.6, -1.1, 0.0)
	await get_tree().process_frame
	var cam := get_viewport().get_camera_3d()
	# The leash pulls the rig back to the SHIP every frame, so a rig parked over
	# the probes snaps home and unprojects them from 400 units away. Off, the way
	# the capture harnesses do it.
	rig.leash_enabled = false
	rig.global_position = Vector3(300.0, 0.0, 300.0)
	await get_tree().process_frame
	await get_tree().process_frame
	var at := cam.unproject_position(hulk_probe.pick_anchor())
	# Driven through _try_begin_hold, the real entry point, and read off what it
	# actually latched onto. The first version of this called _pick("crackable")
	# and asserted it returned the hulk -- which is true no matter which group
	# _try_begin_hold consults first, so it could not fail.
	rig._hold_target = null
	rig._try_begin_hold(at)
	var latched = rig._hold_target
	var both_in_reach: bool = rig._pick(at, "mineable") == seam_probe
	var gap_px := cam.unproject_position(seam_probe.pick_anchor()).distance_to(at)
	print("[mine] PICK PRECEDENCE anchors %.1fpx apart (PICK_PX %.0f), seam reachable=%s: the hold went to %s -> %s" % [
		gap_px, CameraRig.PICK_PX, str(both_in_reach),
		"the hulk" if latched == hulk_probe else "the seam",
		"PASS" if latched == hulk_probe and both_in_reach else "FAIL"])
	rig._release_hold()
	rig.leash_enabled = true
	seam_probe.queue_free()
	hulk_probe.queue_free()

	# --- 11. all or nothing on a full hold -----------------------------------
	# SurveyMast calls load_cargo and reverts only when it took ZERO -- but
	# load_cargo is PARTIAL, so a mast worked with one space free takes 1 of its
	# 2 units and marks itself surveyed, destroying half the reading. With a
	# five-unit seam that is five times worse.
	GameState.cargo = {}
	var cap := GameState.cargo_capacity()
	GameState.load_cargo("alloys", int(floor(float(cap - 2) / 2.0)))   # leaves 2 space
	var free_before := GameState.cargo_free()
	var full_seam := MineableSeam.new()
	full_seam.good = "ore_tungsten"          # space 2, so 4 units needs 8
	full_seam.units = 4
	system_root.add_child(full_seam)
	await get_tree().process_frame
	full_seam._complete()
	print("[mine] HOLD FULL DEFERS %d space free, a 4x space-2 cut took %d and left the seam workable=%s -> %s" % [
		free_before, free_before - GameState.cargo_free(), str(not full_seam.mined),
		"PASS" if not full_seam.mined and GameState.cargo_free() == free_before else "FAIL"])
	full_seam.queue_free()

	# --- 12. and a cut that fits lands whole ---------------------------------
	GameState.cargo = {}
	var good_seam := MineableSeam.new()
	good_seam.good = "ore_platinum"
	good_seam.units = 5
	good_seam.cell = Vector2i(7, 7)
	good_seam.seam_index = 0
	system_root.add_child(good_seam)
	await get_tree().process_frame
	good_seam._complete()
	print("[mine] CUT LANDS WHOLE %d of 5 PLATINUM in the hold, seam spent=%s, remembered=%s -> %s" % [
		GameState.cargo_count("ore_platinum"), str(good_seam.mined),
		str(deep_space.is_mined(Vector2i(7, 7), 0)),
		"PASS" if GameState.cargo_count("ore_platinum") == 5 and good_seam.mined \
			and deep_space.is_mined(Vector2i(7, 7), 0) else "FAIL"])
	good_seam.queue_free()

	# --- 13. mined stays mined across a rebuild ------------------------------
	var live := 0
	for n in get_tree().get_nodes_in_group("mineable"):
		live += 1
	print("[mine] MINED STAYS MINED cell (7,7) seam 0 recorded=%s, a rebuilt seam there would spawn spent -> %s" % [
		str(deep_space.is_mined(Vector2i(7, 7), 0)),
		"PASS" if deep_space.is_mined(Vector2i(7, 7), 0) else "FAIL"])

	# --- 14. and the session resets, deliberately ----------------------------
	deep_space.rebuild()
	await get_tree().process_frame
	print("[mine] SESSION RESET mined before a rebuild=true, after=%s (deliberate; see 17) -> %s" % [
		str(deep_space.is_mined(Vector2i(7, 7), 0)),
		"PASS" if not deep_space.is_mined(Vector2i(7, 7), 0) else "FAIL"])

	# --- 15. a prospector is not invisible -----------------------------------
	# 17: there is no range at which a full hold is safe. Zero-weight ore would
	# make interdiction inert for a whole playstyle, which is the trap chart data
	# was caught in.
	var zero_weight := ""
	for id_v in ore:
		if CommodityDB.interdiction_weight(String(id_v)) <= 0.0:
			zero_weight = String(id_v)
	GameState.cargo = {}
	GameState.load_cargo("ore_platinum", 30)
	var rich_hold := GameState.hold_value(true)
	print("[mine] PROSPECTOR IS NOT INVISIBLE no zero-weight ore (%s); 30 PLATINUM weighs %d vs RAID_MIN_HOLD %d -> %s" % [
		zero_weight if zero_weight != "" else "none", rich_hold, RAID_MIN_HOLD,
		"PASS" if zero_weight == "" and rich_hold >= RAID_MIN_HOLD else "FAIL"])
	GameState.cargo = {}

	# --- 16. the fit reaches the verb ----------------------------------------
	# Stage 2's whole claim is that fitting changes mining, and a stat nothing
	# reads is a price tag. This repo has shipped exactly that once already --
	# ARCHEOLOGY_PER_BREACH, which TIERS divided by and which nothing ever
	# awarded (see 12) -- so both new keys are DRIVEN through equip() rather than
	# poked into GameState.stats. A harness that assigns the number it is about
	# to read is measuring itself.
	var fit_seam := MineableSeam.new()
	fit_seam.good = "ore_ferrite"
	fit_seam.units = 3
	fit_seam.mine_time = 4.0
	system_root.add_child(fit_seam)
	await get_tree().process_frame
	var bare_secs := fit_seam.mine_seconds()
	var bare_take := fit_seam.cut_units()

	GameState.reactor_tier = ModuleDB.REACTOR_TIERS.size() - 1
	for mid_v in ["util_cutter", "util_assay"]:
		if not GameState.owns(String(mid_v)):
			GameState.owned.append(String(mid_v))
	var wore_it := GameState.equip(ModuleDB.Slot.UTILITY, "util_cutter") \
		and GameState.equip(ModuleDB.Slot.UTILITY_B, "util_assay")
	var fit_secs := fit_seam.mine_seconds()
	var fit_take := fit_seam.cut_units()
	# And the hold must receive exactly what the prompt promised. cut_units() is
	# read by the prompt, the room check, the load and the toast for precisely
	# this reason; `landed == fit_take` is the check that the four agree.
	fit_seam._complete()
	var landed := GameState.cargo_count("ore_ferrite")
	print("[mine] THE FIT REACHES THE VERB fitted=%s: cut %.2fs -> %.2fs, %d units -> %d, hold took %d -> %s" % [
		str(wore_it), bare_secs, fit_secs, bare_take, fit_take, landed,
		"PASS" if wore_it and fit_secs < bare_secs and fit_take > bare_take \
			and landed == fit_take else "FAIL"])
	fit_seam.queue_free()
	GameState.cargo = {}

	# --- 17. mining costs a mount --------------------------------------------
	# The fitting contract says there is always a call to make; mining's call is
	# this one. Three mining modules into two utility slots, so the rig and both
	# tools can never fly together on the hull as shipped -- and the heaviest
	# pair that CAN, over the best drive and the best core, leaves a Mk III
	# without room for the weapon the pacing band is denominated in. A
	# prospector gives up the Lance to be a prospector, and that is the price of
	# the route rather than an oversight.
	#
	# COUNTED OFF open_slots(), NOT OFF THE STATIC TABLE, and that distinction
	# is what this leg went red about. §94 cut three berth slots into
	# SLOT_CATEGORY -- one of them a third utility bay -- so a line counting the
	# TABLE started answering 3, and the claim it was written to guard stopped
	# being checked at all. open_slots() is the accessor whose own comment says
	# "and the assertions that count them"; §94 moved every other one and left
	# this one behind. It is the sibling of ALL-BEST IS STILL OUT OF REACH,
	# which the same commit DID teach to measure both ships.
	#
	# THE BERTH IS THE ESCAPE HATCH, AND IT IS ASSERTED RATHER THAN DISSOLVED.
	# A berthed pilot can mount all three tools: that is what 60,000 credits and
	# a permanent quarter-unit of top speed buy, and §94's whole argument is
	# that a berth is a deliberate build rather than a strict upgrade. So the
	# leg keeps the shipped-hull claim, adds the clause that the third bay is
	# BOUGHT (red the day it becomes free, or the day the berth stops costing
	# mass), and then asks the real question the name promises: even berthed, a
	# Mk III carrying all three tools STILL cannot feed the strike frame. The
	# mount is bought back by the reactor (17b), never by the bay.
	var util_count := func() -> int:
		var n := 0
		for slot_v in GameState.open_slots():
			if String(ModuleDB.SLOT_CATEGORY.get(int(slot_v), "")) == "utility":
				n += 1
		return n
	var berths_before: Array = GameState.berths.duplicate()
	GameState.berths = []
	var util_slots: int = util_count.call()
	GameState.berths = ["berth_utility"]
	var berthed_slots: int = util_count.call()
	GameState.berths = berths_before
	var berth_speed := ModuleDB.berth_mass(["berth_utility"])
	var commit := {
		ModuleDB.Slot.UTILITY: "rig_prospector",
		ModuleDB.Slot.UTILITY_B: "util_assay",
		ModuleDB.Slot.DRIVE: "drive_vector_2",
		ModuleDB.Slot.CORE: "core_aegis",
	}
	# PINNED TO MK III BY INDEX, and the rename is the point. This read
	# `reactor_power(REACTOR_TIERS.size() - 1)` into a variable called `mk3`,
	# which is to say it meant "the top tier" while every word around it said
	# "Mk III" -- the same stale-name defect as _build_apex's comment and §41's
	# SWEEP_RADIUS table, sitting inside an assertion rather than beside one.
	# Adding a fourth tier silently changed what the line measured; it did not
	# lie about it, it just stopped being about Mk III.
	#
	# The claim belongs to Mk III specifically, so it is pinned there. What the
	# top tier does is asserted separately, below.
	const MK3_TIER := 2
	var mk3_power := ModuleDB.reactor_power(MK3_TIER)
	var drawn := ModuleDB.power_draw(commit)
	var spare := mk3_power - drawn
	var lance_power := int(ModuleDB.get_module(PACING_MIDTIER)["power"])
	# THE THIRD TOOL, and the whole point of naming it here: the berthed pilot
	# fits all three, so the question stops being about slots and becomes about
	# power -- which is where the claim was always meant to live.
	var three_tools := drawn + int(ModuleDB.get_module("util_cutter")["power"])
	var berthed_cap := mk3_power + ModuleDB.berth_power(["berth_utility"])
	var berthed_spare := berthed_cap - three_tools
	print("[mine] MINING COSTS A MOUNT 3 mining utilities into %d slots on the hull as shipped (a berth opens a %d-th, for %.2f of top speed, permanently); the commit draws %d of Mk III's %d, leaving %d vs %s's %d; berthed, all three draw %d of %d, leaving %d -> %s" % [
		util_slots, berthed_slots, berth_speed, drawn, mk3_power, spare,
		PACING_MIDTIER, lance_power, three_tools, berthed_cap, berthed_spare,
		"PASS" if util_slots == 2 and berthed_slots == util_slots + 1
			and berth_speed > 0.0 and spare < lance_power
			and berthed_spare < lance_power else "FAIL"])

	# --- 17b. and Mk IV is what buys the mount back --------------------------
	# The other half of the same trade, and the only reason the tier exists. A
	# reactor that merely made numbers bigger would be a raise; this one has a
	# specific thing it undoes, and asserting it here means the day somebody
	# retunes the tier or the commit, the claim in REACTOR_TIERS' comment goes
	# red rather than quietly becoming false.
	#
	# The SLOT limit is untouched by it: three mining utilities still do not fit
	# two slots at any tier, which is checked above and is the constraint the
	# power budget was wrongly blamed for.
	var top_tier := ModuleDB.REACTOR_TIERS.size() - 1
	var top_power := ModuleDB.reactor_power(top_tier)
	var top_spare := top_power - drawn
	var all_best := ModuleDB.power_draw({
		ModuleDB.Slot.WEAPON_A: "lance_2",
		ModuleDB.Slot.WEAPON_B: "torp_2",
		ModuleDB.Slot.DRIVE: "drive_vector_2",
		ModuleDB.Slot.UTILITY: "util_scanner_2",
		ModuleDB.Slot.UTILITY_B: "util_shield_2",
		ModuleDB.Slot.CORE: "core_aegis",
	})
	print("[mine] THE TOP REACTOR BUYS THE MOUNT BACK %s carries the commit's %d with %d spare vs %s's %d; all-best %d still will not fit -> %s" % [
		String(ModuleDB.REACTOR_TIERS[top_tier]["name"]), drawn, top_spare,
		PACING_MIDTIER, lance_power, all_best,
		"PASS" if top_spare >= lance_power and all_best > top_power else "FAIL"])

	# --- 18. and the mast defers the same way --------------------------------
	# 11's companion, and it lives in THIS harness deliberately: MineableSeam was
	# written all-or-nothing against a bug that was live in SurveyMast the whole
	# time, and its comment says so by name. A fix with no assertion beside it is
	# a fix that comes back.
	#
	# The FULL hold was always handled -- the mast reverted when load_cargo took
	# zero. The NEARLY full hold was not: one space free took 1 of a 2-unit
	# reading and toasted "SURVEY LOGGED x1", destroying half of it silently. So
	# one space free is the case set up here, not a full hold, which would pass
	# against the old code and prove nothing.
	GameState.cargo = {}
	var mast_cap := GameState.cargo_capacity()
	GameState.load_cargo("ore_phosphor", mast_cap - 1)   # space 1, so exactly 1 free
	var mast_free := GameState.cargo_free()
	var mast := SurveyMast.new()
	mast.band = 2                                        # CHT-D: space 1, YIELD_UNITS 2
	system_root.add_child(mast)
	await get_tree().process_frame
	mast._complete()
	var chart_d := CommodityDB.chart_for_band(2)
	print("[mine] THE MAST DEFERS TOO %d space free vs a %d-unit reading: took %d, mast still workable=%s -> %s" % [
		mast_free, SurveyMast.YIELD_UNITS, GameState.cargo_count(chart_d),
		str(not mast.surveyed),
		"PASS" if not mast.surveyed and GameState.cargo_count(chart_d) == 0 \
			and GameState.cargo_free() == mast_free else "FAIL"])
	mast.queue_free()
	GameState.cargo = {}

	# --- 19. the charted eleven are a windfall, not an income ----------------
	# Charted seams CANNOT press the pacing ceiling: PACING_LOOP carries no seam
	# term and MINING IS A ROUTE, NOT A RAISE asserts it stays that way. So
	# PACINGTEST is structurally blind to them, and something else has to bound
	# them or eleven permanent rocks are new content nothing watches at all --
	# which is the trap this repo keeps rediscovering. They are a one-time
	# windfall, so they are measured against the windfall the game already has.
	var authored := 0
	for sid_v in SystemDB.ids():
		authored += (SystemDB.get_system(String(sid_v)).get("asteroids", []) as Array).size()
	var band0: Array = CommodityDB.seam_yields(0)
	var b0_mean := 0.0
	for gid_v in band0:
		b0_mean += float(CommodityDB.base_price(String(gid_v)))
	b0_mean /= maxf(float(band0.size()), 1.0)
	var charted_total := b0_mean * float(DeepSpace.SEAM_UNITS[0]) * float(authored)
	# Three derelicts in the whole game; PACINGTEST measures one at ~5,200.
	var derelict_budget := 5200.0 * 3.0
	var share := charted_total / derelict_budget
	# 15%, not 25%. The design value is 9%, and a bound loose enough to tolerate
	# a DOUBLING of charted yield would sit there green through exactly the change
	# it exists to catch. This one goes red if band 0's units or prices double.
	print("[mine] CHARTED SEAMS ARE A WINDFALL %d authored seams worth %.0f, %.0f%% of the %.0f derelict budget vs 15%% -> %s" % [
		authored, charted_total, share * 100.0, derelict_budget,
		"PASS" if authored > 0 and share <= 0.15 else "FAIL"])

	# --- 20. two stores, and which one is the design -------------------------
	# DRIVEN through _complete() on both kinds, never by calling the two stores
	# directly. The thing under test is the ROUTING in _record_cut, and the first
	# version of this poked each store instead -- which proved only that a
	# Dictionary remembers things, and stayed green with the routing deleted. It
	# was caught by the red pass, which is the entire argument for the red pass.
	GameState.seams_cut = {}
	GameState.cargo = {}
	var ckey := GameState.seam_key(SystemDB.START_SYSTEM, 0)
	var charted_probe := MineableSeam.new()
	charted_probe.good = "ore_silicate"
	charted_probe.units = 2
	charted_probe.band = 0
	charted_probe.charted_key = ckey
	system_root.add_child(charted_probe)
	var expanse_probe := MineableSeam.new()
	expanse_probe.good = "ore_ferrite"
	expanse_probe.units = 3
	expanse_probe.band = 1
	expanse_probe.cell = Vector2i(9, 9)
	expanse_probe.seam_index = 0
	system_root.add_child(expanse_probe)
	await get_tree().process_frame
	charted_probe._complete()
	expanse_probe._complete()
	var both_cut: bool = GameState.is_seam_cut(ckey) \
		and deep_space.is_mined(Vector2i(9, 9), 0)
	deep_space.rebuild()
	await get_tree().process_frame
	print("[mine] CHARTED PERSISTS, EXPANSE RESETS both recorded on cut=%s; after a rebuild charted=%s expanse=%s -> %s" % [
		str(both_cut), str(GameState.is_seam_cut(ckey)),
		str(deep_space.is_mined(Vector2i(9, 9), 0)),
		"PASS" if both_cut and GameState.is_seam_cut(ckey) \
			and not deep_space.is_mined(Vector2i(9, 9), 0) else "FAIL"])
	charted_probe.queue_free()
	expanse_probe.queue_free()
	GameState.cargo = {}

	# --- 21. the feed is the CUT, never the SALE -----------------------------
	# A sale is a dock visit, which a smuggler makes anyway; if selling ore paid,
	# a trade run would level a mining skill and 19's clock warning lands. Driven
	# through PortPanel._sell, the real counter, rather than asserted about it.
	GameState.mining = 0
	GameState.mining_xp = 0
	GameState.cargo = {}
	GameState.load_cargo("ore_ferrite", 6)
	var anchor: Port = null
	for n in get_tree().get_nodes_in_group("dockable"):
		if (n as Port).port_id == "anchor":
			anchor = n as Port
	var sold := 0
	if anchor:
		player.global_position = anchor.dock_point
		_complete_dock(anchor)
		await get_tree().create_timer(0.5).timeout
		sold = GameState.cargo_count("ore_ferrite")
		port_panel._sell("ore_ferrite", sold)
		await get_tree().process_frame
	var xp_after_sale := GameState.mining_xp
	# And the same ore, cut instead of sold, must pay.
	GameState.cargo = {}
	var paid_seam := MineableSeam.new()
	paid_seam.good = "ore_ferrite"
	paid_seam.units = 3
	paid_seam.band = 2
	system_root.add_child(paid_seam)
	await get_tree().process_frame
	paid_seam._complete()
	print("[mine] MINING PAYS ON SEAMS, NOT SALES sold %d ore -> %d xp, then cut one band-2 seam -> %d xp -> %s" % [
		sold, xp_after_sale, GameState.mining_xp,
		"PASS" if sold > 0 and xp_after_sale == 0 and GameState.mining_xp == 2 else "FAIL"])
	paid_seam.queue_free()
	if anchor:
		port_panel.close_panel()
		undock()
		await get_tree().create_timer(0.3).timeout

	# --- 22. the tiers buy information, a choice and access — never credits --
	# util_assay already owns the yield axis. A tier that moved a number with a
	# price on it would be a second earner under a loop at 97% of its ceiling.
	var priced_move := ""
	for band_v in range(0, 5):
		var probe_cut := MineableSeam.new()
		probe_cut.band = int(band_v)
		probe_cut.units = DeepSpace.SEAM_UNITS[int(band_v)]
		system_root.add_child(probe_cut)
		GameState.mining = 0
		var at_t0 := probe_cut.cut_units()
		GameState.mining = GameState.MINING_TIERS.size() - 1
		var at_top := probe_cut.cut_units()
		if at_t0 != at_top:
			priced_move = "band %d yields %d at tier 0 and %d at the cap" % [
				int(band_v), at_t0, at_top]
		probe_cut.queue_free()
	print("[mine] TIERS BUY NO CREDITS a seam yields the same at tier 0 and at the cap (%s) -> %s" % [
		priced_move if priced_move != "" else "every band identical",
		"PASS" if priced_move == "" else "FAIL"])

	# --- 23. a sample can never beat staying ---------------------------------
	# sample_units() derives from cut_units(), so the Assay Rig moves both. Read
	# with the rig FITTED as well as bare, because deriving it from the raw table
	# instead is the mistake this is written against.
	GameState.cargo = {}
	# Pinned, because 22 above leaves the ladder at its cap and this assertion
	# must not inherit it -- an assertion that reads state a previous one happened
	# to leave behind is measuring the order of the file.
	GameState.mining = 0
	var sample_bad := ""
	for rig_on in [false, true]:
		GameState.reactor_tier = ModuleDB.REACTOR_TIERS.size() - 1
		if not GameState.owns("util_assay"):
			GameState.owned.append("util_assay")
		GameState.equip(ModuleDB.Slot.UTILITY_B, "util_assay" if rig_on else "")
		for band_v in range(0, 5):
			var s := MineableSeam.new()
			s.band = int(band_v)
			s.units = DeepSpace.SEAM_UNITS[int(band_v)]
			system_root.add_child(s)
			if s.sample_units() >= s.cut_units():
				sample_bad = "band %d: sample %d vs cut %d (rig=%s)" % [
					int(band_v), s.sample_units(), s.cut_units(), str(rig_on)]
			s.queue_free()
	GameState.equip(ModuleDB.Slot.UTILITY_B, "")
	print("[mine] CORE SAMPLE CANNOT OUT-YIELD A CUT every band, rig on and off (%s) -> %s" % [
		sample_bad if sample_bad != "" else "none", "PASS" if sample_bad == "" else "FAIL"])

	# --- 24. t3 is ACCESS, and a locked seam is visible ----------------------
	var deep_seam := MineableSeam.new()
	deep_seam.band = 4
	deep_seam.units = DeepSpace.SEAM_UNITS[4]
	system_root.add_child(deep_seam)
	await get_tree().process_frame
	deep_seam.global_position = player.global_position + Vector3(0, 0, 2.0)
	GameState.mining = 0
	deep_seam.hold_begin()
	var refused: bool = not deep_seam._holding
	var still_listed: bool = deep_seam.is_in_group("mineable")
	GameState.mining = GameState.MINING_DEEP_TIER
	deep_seam.hold_begin()
	var allowed: bool = deep_seam._holding
	deep_seam.hold_release()
	print("[mine] T3 OPENS THE QUIET band-4 hold refused at tier 0=%s, allowed at tier %d=%s, visible while locked=%s -> %s" % [
		str(refused), GameState.MINING_DEEP_TIER, str(allowed), str(still_listed),
		"PASS" if refused and allowed and still_listed else "FAIL"])
	deep_seam.queue_free()

	# --- 25. t1 is INFORMATION, read off the marker --------------------------
	var tint_seam := MineableSeam.new()
	tint_seam.good = "ore_iridium"
	system_root.add_child(tint_seam)
	await get_tree().process_frame
	GameState.mining = 0
	var grey: Color = tint_seam.marker_color()
	GameState.mining = GameState.MINING_READ_TIER
	var tinted: Color = tint_seam.marker_color()
	print("[mine] T1 READS THE ORE marker %s at tier 0, %s at tier %d (ore is %s) -> %s" % [
		str(grey), str(tinted), GameState.MINING_READ_TIER,
		str(CommodityDB.color_of("ore_iridium")),
		"PASS" if grey == Palette.HULL and tinted == CommodityDB.color_of("ore_iridium") \
			and grey != tinted else "FAIL"])
	tint_seam.queue_free()
	GameState.mining = 0
	GameState.mining_xp = 0
	GameState.cargo = {}

	# --- 26. the cut stops making noise once the cut is over -----------------
	# The sound the player complained about is mineable_seam's COMPLETION
	# one-shot, and there is no mining loop anywhere to have leaked -- so this
	# does not check teardown on the fifteen other ways out of a hold. It checks
	# the rule the bug actually broke: a fire-and-forget sound ends by itself.
	#
	# The Derelict is the reproduction, not scenery. `crack` is the one name used
	# both as an object loop and as a one-shot, and Derelict takes its crack loop
	# in _ready -- so merely existing was enough to turn every later cut endless.
	# Without one in the tree this section passes on a world where the bug is
	# still there.
	#
	# Nothing else may make a sound between the cut and the read: the pool is 20
	# deep and round-robin, so 20 stray one-shots would recycle the stuck player
	# and hand back a green light. Section 21 docks and sells; this is why 26
	# stands on its own at the end rather than borrowing that ship.
	var noisy_hulk := Derelict.new()
	system_root.add_child(noisy_hulk)
	await get_tree().process_frame

	var quiet_seam := MineableSeam.new()
	quiet_seam.good = "ore_iron"
	system_root.add_child(quiet_seam)
	await get_tree().process_frame
	quiet_seam.global_position = player.global_position + Vector3(0, 0, 2.0)
	await get_tree().physics_frame

	# Silence FIRST, and it is not tidiness. The sections above cut a lot of rock,
	# and read straight after the cut this counted six sounds still ringing from
	# them -- so "something is playing" would have been true whether or not THIS
	# cut made a noise, and the before/after pair would have proved nothing.
	# crack.wav is 2.2s and the cut plays it at 0.75 pitch, so ~2.93s of audio.
	await get_tree().create_timer(4.0).timeout
	var sounding_before := Sfx.playing_count("crack")
	quiet_seam._complete()
	var sounding_at_cut := Sfx.playing_count("crack")
	await get_tree().create_timer(4.0).timeout
	var sounding_after := Sfx.playing_count("crack")
	var cache_clean: bool = (Sfx._streams["crack"] as AudioStreamWAV).loop_mode \
		== AudioStreamWAV.LOOP_DISABLED
	print("[mine] THE CUT FALLS SILENT %d sounding before, %d at the cut, %d after 4.0s (sample 2.20s at 0.75), one-shot stream unlooped=%s -> %s" % [
		sounding_before, sounding_at_cut, sounding_after, str(cache_clean),
		"PASS" if sounding_before == 0 and sounding_at_cut > 0 \
			and sounding_after == 0 and cache_clean else "FAIL"])
	quiet_seam.queue_free()
	noisy_hulk.queue_free()
	GameState.cargo = {}

	# --- playtest round 5 ----------------------------------------------------

	# A MINING TIER SAYS SO. This call discarded mark_mining's bool for four
	# stages, so mining was the only ladder in the game that levelled in silence
	# -- archeology, smuggling and persuasion all toast theirs. A playtester
	# sitting at mining 1 reported archeology as the only skill that progressed.
	#
	# BOTH HALVES, and the second is the one that stops this passing on a build
	# that toasts the skill line after EVERY cut: a cut that does not tier must
	# still print the haul, or the player loses the readout they cut for.
	GameState.mining = 0
	# THREE SHORT OF THE RUNG, computed from the ladder rather than typed. The
	# first draft of this named a constant 15 under a comment claiming it was
	# derived -- which is the "comments are claims" failure this project keeps
	# catching, authored into a check written to catch that class of thing.
	# Re-tune MINING_TIERS and the probe follows it.
	GameState.mining_xp = GameState.MINING_TIERS[1] - 3
	GameState.cargo = {}
	hud.clear_toast()
	var tier_seam := MineableSeam.new()
	tier_seam.good = "ore_ferrite"
	tier_seam.units = 3
	tier_seam.band = 4          # 4 xp: crosses 18 from 15
	system_root.add_child(tier_seam)
	await get_tree().process_frame
	tier_seam._complete()
	await get_tree().process_frame
	var tier_toast := hud.toast_text()
	var tiered_to := GameState.mining
	tier_seam.queue_free()
	# The negative control: a cut well short of the next rung.
	GameState.mining_xp = 0
	GameState.mining = 0
	GameState.cargo = {}
	hud.clear_toast()
	var plain_seam := MineableSeam.new()
	plain_seam.good = "ore_ferrite"
	plain_seam.units = 3
	plain_seam.band = 1
	system_root.add_child(plain_seam)
	await get_tree().process_frame
	plain_seam._complete()
	await get_tree().process_frame
	var haul_toast := hud.toast_text()
	plain_seam.queue_free()
	GameState.cargo = {}
	GameState.mining = 0
	GameState.mining_xp = 0
	print("[mine] A MINING TIER SAYS SO crossing a rung -> tier %d and the toast reads '%s'; a cut that does not tier still reads '%s' -> %s" % [
		tiered_to, tier_toast, haul_toast,
		"PASS" if tiered_to == 1 and tier_toast.contains("MINING 1")
			and not haul_toast.contains("MINING") and haul_toast != "" else "FAIL"])

	# THE DEEP PERK ARRIVES BEFORE THE LADDER ENDS. MINING_DEEP_TIER was 3, which
	# IS MINING_TIERS' max index -- so band-4 access, the only 4-xp rung on the
	# board, unlocked exactly when there was nothing left to earn with it, and the
	# tuning note that prices this ladder in "sessions of working the Quiet"
	# described a rate no live ladder could reach.
	#
	# Asserted as the RULE over the whole perk table rather than on the one
	# constant that was wrong: every tier a perk is hung on must be reachable,
	# and the top of the ladder must still buy something. A future reshuffle that
	# parked any perk on the last rung fails this, not just this one.
	var perk_tiers := {
		"read": GameState.MINING_READ_TIER,
		"deep": GameState.MINING_DEEP_TIER,
		"sample": GameState.MINING_SAMPLE_TIER,
	}
	var max_tier: int = GameState.MINING_TIERS.size() - 1
	var stranded := ""
	var top_buys := ""
	for k in perk_tiers:
		if int(perk_tiers[k]) >= max_tier and String(k) != "sample":
			stranded += "%s " % String(k)
		if int(perk_tiers[k]) == max_tier:
			top_buys = String(k)
	var access_usable: bool = GameState.MINING_DEEP_TIER < max_tier
	print("[mine] THE DEEP PERK ARRIVES BEFORE THE LADDER ENDS perks %s against max tier %d: band-4 access at %d is usable=%s, the top rung still buys '%s', stranded: %s -> %s" % [
		str(perk_tiers), max_tier, GameState.MINING_DEEP_TIER,
		str(access_usable), top_buys, stranded if stranded != "" else "none",
		"PASS" if access_usable and top_buys != "" and stranded == "" else "FAIL"])

	get_tree().quit()


# --- the frontier (bands 5 and 6) --------------------------------------------

# THE OUTER BAYS, RECORDED BEFORE THE BANDS GREW. A deep bay is the one thing
# past the chart that IS saved, keyed by cell, so it is the one thing the
# frontier could destroy: a bay whose station moved is a stored key pointing at
# empty space.
#
# WHAT THIS IS NOT IS AN EQUALITY. The first version of this constant was a hash
# of the whole bay list and it went red on the first run, correctly, because the
# bay list is SUPPOSED to change — the station roll is `randf() < STATION_CHANCE
# [band]`, and a band-4 cell re-planned as band 5 rolls the same number against
# 0.115 instead of 0.095. Cells that had no station acquire one. Measured: 23 ->
# 25, 22 -> 29, 21 -> 24.
#
# The argument written here first ("the bay-relevant draws come first and their
# COUNT does not move") was true and did not say enough. The draw count does not
# move, so nothing SHIFTS; but the first draw's OUTCOME moves, so things are
# ADDED. Equality was the wrong property and the probe caught it — which is the
# whole reason the recording is taken from the previous commit rather than from
# the reasoning.
#
# So the property that actually protects a save is a SUBSET: every station that
# existed under the five-band tables still exists, at the same position, with the
# same storage flag. New neighbours are the feature. It holds because
# STATION_CHANCE is non-decreasing across bands (asserted separately), so
# `r < 0.095` implies `r < 0.115`, and every draw after the branch is taken is
# the same draw against the same seed.
#
# The archetype is deliberately NOT in this record. It is a shopfront, and stage
# 3 changes it on purpose: adding a band-5 archetype widens `for_band`'s list and
# moves the modulo. The bay stays; what is standing on it gets a new sign.
#
# Recorded by running the same lanes on 27ce3ee with the five-band tables in
# place, in a throwaway worktree, because a recording taken afterwards would
# agree with whatever it was given (the WORLD_FINGERPRINT_BEFORE_SEAMS lesson).
