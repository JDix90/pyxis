extends Node
# Autoloaded as `Sfx`. Pooled one-shots plus dedicated loop players.
# All streams are generated by tools/gen_sfx.py.

const POOL_SIZE := 20
const STREAK_WINDOW := 0.45
const STREAK_MAX := 14

# Buses are built in code rather than shipped as a default_bus_layout.tres, for
# the same reason meshes are kitbashed and sounds are synthesized: the project
# should be reproducible from source with no binary resources to keep in sync.
#   Master
#   +- SFX        everything one-shot, plus the ambient drone
#   +- Music      the combat layer
#      +- MusicCalm   the calm layer, with a low-pass for the per-system tint
const BUS_SFX := "SFX"
const BUS_MUSIC := "Music"
const BUS_MUSIC_CALM := "MusicCalm"

var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _loops := {}

var _streak := 0
var _streak_time := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	ensure_buses()
	for name in ["tap", "fire", "hit", "explode", "pickup", "count", "crack", "breach",
			"vortex", "ambient", "equip", "alarm", "warp", "klaxon",
			"boss_wake", "sweep", "plate", "weld", "phase", "dock"]:
		var path := "res://audio/%s.wav" % name
		if ResourceLoader.exists(path):
			_streams[name] = load(path)

	for i in range(POOL_SIZE):
		var p := AudioStreamPlayer.new()
		p.process_mode = Node.PROCESS_MODE_ALWAYS
		p.bus = BUS_SFX
		add_child(p)
		_pool.append(p)


func ensure_buses() -> void:
	_ensure_bus(BUS_SFX, "Master")
	_ensure_bus(BUS_MUSIC, "Master")
	var calm := _ensure_bus(BUS_MUSIC_CALM, BUS_MUSIC)
	if AudioServer.get_bus_effect_count(calm) == 0:
		# Wide open by default; Music.set_system_tint() closes it per system.
		var lp := AudioEffectLowPassFilter.new()
		lp.cutoff_hz = 20500.0
		AudioServer.add_bus_effect(calm, lp)


func _ensure_bus(bus_name: String, send_to: String) -> int:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx >= 0:
		return idx
	idx = AudioServer.bus_count
	AudioServer.add_bus(idx)
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, send_to)
	return idx


func set_bus_volume(bus_name: String, linear: float) -> void:
	# 0..1 in, decibels out, with 0 meaning actually silent rather than -80dB.
	var idx := AudioServer.get_bus_index(bus_name)
	if idx < 0:
		return
	var v := clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.001)))


func set_muted(v: bool) -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), v)


func is_muted() -> bool:
	return AudioServer.is_bus_mute(AudioServer.get_bus_index("Master"))


func play(name: String, volume_db := 0.0, pitch := 1.0, pitch_jitter := 0.06) -> void:
	if not _streams.has(name):
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = _streams[name]
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch + randf_range(-pitch_jitter, pitch_jitter))
	p.play()


func play_streak(name: String, volume_db := 0.0, step := 0.055) -> void:
	# Consecutive hits within the window climb in pitch — the classic
	# "collecting a pile of things" satisfaction curve.
	var now := Time.get_ticks_msec() / 1000.0
	if now - _streak_time > STREAK_WINDOW:
		_streak = 0
	_streak_time = now
	_streak = mini(_streak + 1, STREAK_MAX)
	play(name, volume_db, 1.0 + step * _streak, 0.02)


func loop_start(name: String, volume_db := -6.0) -> void:
	if not _streams.has(name) or _loops.has(name):
		return
	var stream: AudioStream = _streams[name]
	if stream is AudioStreamWAV:
		(stream as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		(stream as AudioStreamWAV).loop_end = (stream as AudioStreamWAV).data.size() / 2
	var p := AudioStreamPlayer.new()
	p.process_mode = Node.PROCESS_MODE_ALWAYS
	p.stream = stream
	p.volume_db = volume_db
	p.bus = BUS_SFX
	add_child(p)
	p.play()
	_loops[name] = p


func loop_stop(name: String, fade := 0.4) -> void:
	if not _loops.has(name):
		return
	var p: AudioStreamPlayer = _loops[name]
	_loops.erase(name)
	var tw := create_tween()
	tw.tween_property(p, "volume_db", -40.0, fade)
	tw.tween_callback(p.queue_free)


func is_looping(name: String) -> bool:
	return _loops.has(name)
