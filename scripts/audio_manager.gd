extends Node
# Autoloaded as `Sfx`. Pooled one-shots plus dedicated loop players.
# All streams are generated by tools/gen_sfx.py.

const POOL_SIZE := 20
const STREAK_WINDOW := 0.45
const STREAK_MAX := 14

# Buses are built in code rather than shipped as a default_bus_layout.tres, for
# the same reason meshes are kitbashed and sounds are synthesized: the project
# should be reproducible from source with no binary resources to keep in sync.
#   Master
#   +- SFX        everything one-shot, plus the ambient drone
#   +- Music      the combat layer
#      +- MusicCalm   the calm layer, with a low-pass for the per-system tint
const BUS_SFX := "SFX"
const BUS_MUSIC := "Music"
const BUS_MUSIC_CALM := "MusicCalm"

var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _loops := {}
var _looped := {}

var _streak := 0
var _streak_time := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	ensure_buses()
	for name in ["tap", "fire", "hit", "explode", "pickup", "count", "crack", "breach",
			"vortex", "ambient", "equip", "alarm", "warp", "klaxon",
			"boss_wake", "sweep", "plate", "weld", "phase", "dock"]:
		var path := "res://audio/%s.wav" % name
		if ResourceLoader.exists(path):
			_streams[name] = load(path)

	for i in range(POOL_SIZE):
		var p := AudioStreamPlayer.new()
		p.process_mode = Node.PROCESS_MODE_ALWAYS
		p.bus = BUS_SFX
		add_child(p)
		_pool.append(p)


func ensure_buses() -> void:
	_ensure_bus(BUS_SFX, "Master")
	_ensure_bus(BUS_MUSIC, "Master")
	var calm := _ensure_bus(BUS_MUSIC_CALM, BUS_MUSIC)
	if AudioServer.get_bus_effect_count(calm) == 0:
		# Wide open by default; Music.set_system_tint() closes it per system.
		var lp := AudioEffectLowPassFilter.new()
		lp.cutoff_hz = 20500.0
		AudioServer.add_bus_effect(calm, lp)


func _ensure_bus(bus_name: String, send_to: String) -> int:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx >= 0:
		return idx
	idx = AudioServer.bus_count
	AudioServer.add_bus(idx)
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, send_to)
	return idx


func set_bus_volume(bus_name: String, linear: float) -> void:
	# 0..1 in, decibels out, with 0 meaning actually silent rather than -80dB.
	var idx := AudioServer.get_bus_index(bus_name)
	if idx < 0:
		return
	var v := clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.001)))


# --- haptics -----------------------------------------------------------------
# Lives on Sfx because a haptic is a sound you feel: every call site already
# reaches for this autoload to acknowledge the same moment, and pairing them here
# means a new effect gets both or neither rather than remembering one.
#
# Gated at this single entry point for the reason CameraRig.shake() is -- roughly
# a dozen callers, and any one of them could otherwise forget the setting exists.
const HAPTIC_MS := {"light": 10, "medium": 25, "heavy": 60}

# Incremented before the platform call, so a headless harness can assert the gate
# without a device. Vibration is otherwise entirely unobservable in a test.
var haptic_count := 0
var haptic_last := ""


func haptic(kind := "light") -> void:
	if not GameState.haptics_enabled():
		return
	haptic_count += 1
	haptic_last = kind
	Input.vibrate_handheld(int(HAPTIC_MS.get(kind, 10)))


func set_muted(v: bool) -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), v)


func is_muted() -> bool:
	return AudioServer.is_bus_mute(AudioServer.get_bus_index("Master"))


# v22 (89). COMBAT SOUND HAS A DISTANCE NOW. The pool below is flat -- every
# caller everywhere in the streamed window played at authored volume, so a
# swarm fighting a picket three hundred units away was as loud as one on the
# hull, forever, and a battle the player could not even see became a noise
# complaint. Two numbers: inside FULL_RANGE nothing changes; past CULL_RANGE
# the sound does not exist; between them a linear dB roll-off.
#
# The WORLD calls play_at with a position; the COCKPIT (UI, pickups, the
# player's own ship) keeps play(), because feedback for your own actions is
# not diegetic and must never fade.
const SFX_FULL_RANGE := 40.0
const SFX_CULL_RANGE := 120.0
const SFX_FALLOFF_DB := 22.0


static func attenuation_for(dist: float) -> float:
	# Pure, so the harness can hold the curve without listening: 0 inside full
	# range, linear to -SFX_FALLOFF_DB at the cull edge. The CULL itself is the
	# caller's test (dist > SFX_CULL_RANGE) -- a function that returned a magic
	# "silent" number would be a sentinel wearing a float's clothes.
	var t := clampf((dist - SFX_FULL_RANGE) / (SFX_CULL_RANGE - SFX_FULL_RANGE), 0.0, 1.0)
	return -SFX_FALLOFF_DB * t


func play_at(pos: Vector3, name: String, volume_db := 0.0, pitch := 1.0,
		pitch_jitter := 0.06) -> void:
	var listener: Node3D = get_tree().get_first_node_in_group("player")
	if listener == null:
		play(name, volume_db, pitch, pitch_jitter)
		return
	var d := pos.distance_to(listener.global_position)
	if d > SFX_CULL_RANGE:
		return
	play(name, volume_db + attenuation_for(d), pitch, pitch_jitter)


func play(name: String, volume_db := 0.0, pitch := 1.0, pitch_jitter := 0.06) -> void:
	if not _streams.has(name):
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = _streams[name]
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch + randf_range(-pitch_jitter, pitch_jitter))
	p.play()


func play_streak(name: String, volume_db := 0.0, step := 0.055) -> void:
	# Consecutive hits within the window climb in pitch — the classic
	# "collecting a pile of things" satisfaction curve.
	var now := Time.get_ticks_msec() / 1000.0
	if now - _streak_time > STREAK_WINDOW:
		_streak = 0
	_streak_time = now
	_streak = mini(_streak + 1, STREAK_MAX)
	play(name, volume_db, 1.0 + step * _streak, 0.02)


static func frame_count(stream: AudioStreamWAV) -> int:
	# `data.size() / 2` was the old arithmetic here and in music.gd, on the stated
	# assumption of 16-bit mono at two bytes per frame. The importer sets
	# compress/mode=2 (QOA), so `data` holds compressed bytes and that number came
	# out roughly 3x short -- every loop restarted about a third of the way in.
	# Length in seconds is format-agnostic, so this stays correct if the import
	# mode ever changes again.
	return int(round(stream.get_length() * stream.mix_rate))


static func loopify(stream: AudioStream) -> AudioStream:
	# Idempotent: the whole file, front to back, forever. MUTATES what it is given
	# and hands the same object back, which is why nothing may pass it a stream
	# out of `_streams` -- see _looped_stream. Music does pass it a bare load(),
	# and that is fine: no music layer is ever played as a one-shot.
	if stream is AudioStreamWAV:
		var w := stream as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = frame_count(w)
	return stream


func _looped_stream(name: String) -> AudioStream:
	# A looping COPY, memoised per name, and the copy is the whole point.
	#
	# `_streams[name]` is one resource shared by every player of that sound --
	# load() hands back Godot's cached instance -- so loopifying it in place did
	# not make "this player" loop, it made the SOUND loop, for the rest of the
	# session, including for the fire-and-forget pool.
	#
	# It shipped as a mining bug, because "crack" is the one name used both ways:
	# Derelict takes a crack loop on SPAWN, so entering any system with a hulk in
	# it was enough, and mineable_seam's completion one-shot then played a stream
	# that had quietly become endless. The pool has no stop(), so the only thing
	# that ever silenced it was `_next` wrapping 20 sounds later and stealing the
	# player back -- which is exactly what a swarm turning up does.
	#
	# One copy shared by every looping player is still correct: playback position
	# lives in the player's AudioStreamPlayback, not in the resource, which is
	# already how the pool shares one stream across 20 players.
	if not _streams.has(name):
		return null
	if not _looped.has(name):
		_looped[name] = loopify(_streams[name].duplicate())
	return _looped[name]


func attached_loop(owner: Node, name: String, volume_db := -6.0) -> AudioStreamPlayer:
	# For loops that belong to one object rather than to the mix -- the crack
	# players on derelicts and apex wrecks. Both used to build their own
	# AudioStreamPlayer inline and neither set `bus`, so they played on Master and
	# the EFFECTS slider silently did not apply to them. A factory is the only
	# version of this that a third caller cannot get wrong.
	var p := AudioStreamPlayer.new()
	p.bus = BUS_SFX
	p.volume_db = volume_db
	if _streams.has(name):
		# Looped because the hold it scores outruns the sample: crack.wav is 2.2s
		# and a Reaches hulk takes 2.6s, so the deepest wrecks used to fall silent
		# just before they gave way.
		p.stream = _looped_stream(name)
	owner.add_child(p)
	return p


func loop_start(name: String, volume_db := -6.0) -> void:
	if not _streams.has(name) or _loops.has(name):
		return
	var stream: AudioStream = _looped_stream(name)
	var p := AudioStreamPlayer.new()
	p.process_mode = Node.PROCESS_MODE_ALWAYS
	p.stream = stream
	p.volume_db = volume_db
	p.bus = BUS_SFX
	add_child(p)
	p.play()
	_loops[name] = p


func loop_stop(name: String, fade := 0.4) -> void:
	if not _loops.has(name):
		return
	var p: AudioStreamPlayer = _loops[name]
	_loops.erase(name)
	var tw := create_tween()
	tw.tween_property(p, "volume_db", -40.0, fade)
	tw.tween_callback(p.queue_free)


func is_looping(name: String) -> bool:
	return _loops.has(name)


func playing_count(name: String) -> int:
	# How many pooled one-shots of this sound are still sounding.
	#
	# Exists so a harness can ask the question the player actually asks -- "is
	# that noise still going?" -- rather than reaching into `_pool` itself. It
	# counts the fire-and-forget pool only: object-owned loops from
	# attached_loop() belong to their node and end when it does, and the named
	# loops in `_loops` have is_looping() for the same purpose.
	if not _streams.has(name):
		return 0
	var one_shot: AudioStream = _streams[name]
	var n := 0
	for p in _pool:
		if p.playing and p.stream == one_shot:
			n += 1
	return n
