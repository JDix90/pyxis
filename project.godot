; Engine configuration file.
config_version=5

[application]

config/name="Pyxis"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Sfx="*res://scripts/audio_manager.gd"
GameState="*res://scripts/game_state.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
; Desktop launch size only — phones ignore these entirely and use the device
; resolution against the 720x1280 design space above.
window/size/window_width_override=1100
window/size/window_height_override=800
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; Off on purpose: desktop and mobile need different primary-button semantics.
; A tap on empty space should move (mobile has no other way to move); a mouse
; click on empty space should do nothing, because a missed click on a small
; target used to fling the ship across the system.
pointing/emulate_touch_from_mouse=false

